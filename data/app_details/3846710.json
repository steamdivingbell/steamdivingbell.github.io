0x338.jpg?t=1772548274"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846710/c837a2fbde547e62b09d211f94b6c2bf51b9a073/ss_c837a2fbde547e62b09d211f94b6c2bf51b9a073.1920x1080.jpg?t=1772548274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846710/c837a2fbde547e62b09d211f94b6c2bf51b9a073/ss_c837a2fbde547e62b09d211f94b6c2bf51b9a073.600x338.jpg?t=1772548274"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846710/b21f95a397cd317aa5bdf23a7b5b1fe6914f88e1/ss_b21f95a397cd317aa5bdf23a7b5b1fe6914f88e1.1920x1080.jpg?t=1772548274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846710/b21f95a397cd317aa5bdf23a7b5b1fe6914f88e1/ss_b21f95a397cd317aa5bdf23a7b5b1fe6914f88e1.600x338.jpg?t=1772548274"}],"short_description":"The Wake is a Lovecraftian Fishing Adventure where you explore a forgotten island chain. Catch strange fish with customizable gear and learn to wield eldritch magic. Fend off abyssal beasts with powerful weapons, all while sailing the dark waters of an open world.\u00a0","steam_appid":3846710,"support_info":{"email":"hello@playground-pigeon.com","url":"https://www.playground-pigeon.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.playground-pigeon.com/"}