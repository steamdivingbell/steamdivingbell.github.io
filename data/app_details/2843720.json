m_assets/steam/apps/2843720/extras/Wishlist_1.png?t=1744209116\" /><strong><i>No seagulls were hurt during this production.</i></strong> </p>","developers":["Nine Lives Game Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2843720/header.jpg?t=1744209116","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257067746,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257067746/movie480.mp4?t=1739481760","max":"http://video.akamai.steamstatic.com/store_trailers/257067746/movie_max.mp4?t=1739481760"},"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257067746/a3681c0231873e8f550a14f61148cf36a6181895/movie_600x337.jpg?t=1739481760","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257067746/movie480_vp9.webm?t=1739481760","max":"http://video.akamai.steamstatic.com/store_trailers/257067746/movie_max_vp9.webm?t=1739481760"}},{"highlight":true,"id":257044252,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257044252/movie480.mp4?t=1723202500","max":"http://video.akamai.steamstatic.com/store_trailers/257044252/movie_max.mp4?t=1723202500"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257044252/movie.293x165.jpg?t=1723202500","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257044252/movie480_vp9.webm?t=1723202500","max":"http://video.akamai.steamstatic.com/store_trailers/257044252/movie_max_vp9.webm?t=1723202500"}}],"name":"Seagulls: Crappy Situation","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 or later<br></li><li><strong>Processor:</strong> 2.6 GHz Quad Core or similar<br></li><li><