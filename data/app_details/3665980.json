 Although working alone is challenging, the developer is committed to continuously improving the game based on player feedback. Thank you all for your support!</p>","developers":["\u4e01\u5c0f\u5e06\u72ec\u7acb\u6e38\u620f\u5f00\u53d1"],"fullgame":{"appid":"3461620","name":"Luminous Rhapsody: Bathed in Shifting Dimensions meets Chromatic Overexposure"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3665980/4c92b7b192596b6da53df44d997733d7c78d6ca7/header.jpg?t=1745539757","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257125217,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257125217/movie480.mp4?t=1745539753","max":"http://video.akamai.steamstatic.com/store_trailers/257125217/movie_max.mp4?t=1745539753"},"name":"CG1","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257125217/ae3ce33793c930e3c764243709d738c4251b1bac/movie_600x337.jpg?t=1745539753","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257125217/movie480_vp9.webm?t=1745539753","max":"http://video.akamai.steamstatic.com/store_trailers/257125217/movie_max_vp9.webm?t=1745539753"}},{"highlight":true,"id":257125219,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257125219/movie480.mp4?t=1745539756","max":"http://video.akamai.steamstatic.com/store_trailers/257125219/movie_max.mp4?t=1745539756"},"name":"CG2","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257125219/b3b8a3d282e701582a284ba5e3e16c33f4a2ebcc/movie_600x337.jpg?t=1745539756","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257125219/movie480_vp9.webm?t=1745539756","max":"http://video.akamai.steamstatic.com/store_trailers/257125219/movie_max_vp9.webm?t=174553975