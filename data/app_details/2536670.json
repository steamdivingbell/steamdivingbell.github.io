0.jpg?t=1772658615","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2536670/222753b886c7e41f4162c185d22833694cf78f93/ss_222753b886c7e41f4162c185d22833694cf78f93.600x338.jpg?t=1772658615"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2536670/dce47cd196a5518e31e67bf33de88ee815cf72b0/ss_dce47cd196a5518e31e67bf33de88ee815cf72b0.1920x1080.jpg?t=1772658615","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2536670/dce47cd196a5518e31e67bf33de88ee815cf72b0/ss_dce47cd196a5518e31e67bf33de88ee815cf72b0.600x338.jpg?t=1772658615"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2536670/4cb72911199ea8a84036249c6a13be6612562f92/ss_4cb72911199ea8a84036249c6a13be6612562f92.1920x1080.jpg?t=1772658615","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2536670/4cb72911199ea8a84036249c6a13be6612562f92/ss_4cb72911199ea8a84036249c6a13be6612562f92.600x338.jpg?t=1772658615"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2536670/8f1181c024ed1dd154d93e3a578b7d5917334a25/ss_8f1181c024ed1dd154d93e3a578b7d5917334a25.1920x1080.jpg?t=1772658615","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2536670/8f1181c024ed1dd154d93e3a578b7d5917334a25/ss_8f1181c024ed1dd154d93e3a578b7d5917334a25.600x338.jpg?t=1772658615"}],"short_description":"Project Vesperi is a branching narrative sci-fi game where you play as Doctor Evelyn Roth, sent to investigate a potential sign of life on Venus. When an intruder threatens the only habitable station on the planet, your choices will shape the fate of those around you\u2014and humanity itself.","steam_appid":2536670,"support_info":{"email":"contact@lastpraetorianinteractive.com","url":"https://www.vesperigame.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.vesperigame.com"}