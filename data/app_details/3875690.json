_paragraph\" >Totally Legit Wheeler Dealer mixes humor, hustling, and a love for sketchy car deals into one wild package. A little sanding, a little spray paint, and boom\u2014it\u2019s good enough to sell.</p>","developers":["Sombrero Labs"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3875690/816e3d8fcb2a322d052b0cc49e061dc20c566ee7/header.jpg?t=1773908359","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3875690/1015134773/c5500da0517f0e0862fda9d1033308443bf92bd9/1765550324/dash_av1.mpd?t=1765552415","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3875690/1015134773/c5500da0517f0e0862fda9d1033308443bf92bd9/1765550324/dash_h264.mpd?t=1765552415","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3875690/1015134773/c5500da0517f0e0862fda9d1033308443bf92bd9/1765550324/hls_264_master.m3u8?t=1765552415","id":257168593,"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257168593/2f827b2e7d844426ce4e83f378073dc7ddcc9d3e/movie_600x337.jpg?t=1765552415"}],"name":"Totally Legit Wheeler Seller","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 64bit<br></li><li><strong>Processor:</strong>  AMD Ryzen 5 1st gen / Intel Core i5 7th gen<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> AMD Ra