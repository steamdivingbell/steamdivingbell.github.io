66c6c20d0d3fb3b4c607e29e35ebe57fa0b4/ss_794866c6c20d0d3fb3b4c607e29e35ebe57fa0b4.600x338.jpg?t=1773908359"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3875690/23b4db2b9cd4dd27dd451349c2745ac768abf13e/ss_23b4db2b9cd4dd27dd451349c2745ac768abf13e.1920x1080.jpg?t=1773908359","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3875690/23b4db2b9cd4dd27dd451349c2745ac768abf13e/ss_23b4db2b9cd4dd27dd451349c2745ac768abf13e.600x338.jpg?t=1773908359"}],"short_description":"Run your own shady car lot! Buy cheap, patch it up and flip for profit. Haggle prices, roll back the mileage and become the king of sketchy deals. If you\u2019ve ever dreamed of selling a rust bucket for a grand, this is your moment.","steam_appid":3875690,"support_info":{"email":"support@sombrerolabs.pl","url":""},"supported_languages":"English, Polish","type":"game","website":null}