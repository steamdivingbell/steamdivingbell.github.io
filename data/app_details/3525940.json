940/c8278335bf96d505be7cfb6dfe90acf7c2d36ead/ss_c8278335bf96d505be7cfb6dfe90acf7c2d36ead.600x338.jpg?t=1765814855"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3525940/d7e1c92a5844bd5c066037d0888b9fad25587a64/ss_d7e1c92a5844bd5c066037d0888b9fad25587a64.1920x1080.jpg?t=1765814855","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3525940/d7e1c92a5844bd5c066037d0888b9fad25587a64/ss_d7e1c92a5844bd5c066037d0888b9fad25587a64.600x338.jpg?t=1765814855"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3525940/f7a51d4bdd41d32662e8362243f0d85bbac14639/ss_f7a51d4bdd41d32662e8362243f0d85bbac14639.1920x1080.jpg?t=1765814855","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3525940/f7a51d4bdd41d32662e8362243f0d85bbac14639/ss_f7a51d4bdd41d32662e8362243f0d85bbac14639.600x338.jpg?t=1765814855"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3525940/d4f22b01a2d5814942032822c3a61c969cdf8c13/ss_d4f22b01a2d5814942032822c3a61c969cdf8c13.1920x1080.jpg?t=1765814855","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3525940/d4f22b01a2d5814942032822c3a61c969cdf8c13/ss_d4f22b01a2d5814942032822c3a61c969cdf8c13.600x338.jpg?t=1765814855"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3525940/2746d04fe4e9bcadc4d162cf3d44b4b96ef1c265/ss_2746d04fe4e9bcadc4d162cf3d44b4b96ef1c265.1920x1080.jpg?t=1765814855","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3525940/2746d04fe4e9bcadc4d162cf3d44b4b96ef1c265/ss_2746d04fe4e9bcadc4d162cf3d44b4b96ef1c265.600x338.jpg?t=1765814855"}],"short_description":"You built this bunker to bury your secrets. After murdering four people and failing to take your own life, you wake up trapped in your own creation with no memory. Solve mechanical puzzles, repair the facility, and uncover the terrifying truth of why you did it.","steam_appid":3525940,"support_info":{"email":"info@kookystudios.com","url":"https://www.kookystudios.com/contact"},"supported_languages":"English<strong>*</strong>, German, Portuguese - Brazil, Russian, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.kookystudios.com"}