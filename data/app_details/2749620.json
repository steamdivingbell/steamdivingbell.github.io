m_assets/steam/apps/2749620/extras/9e6fd545488beba415c7165af2acb26e.poster.avif?t=1772317336\" width=600 height=138 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749620/extras/9e6fd545488beba415c7165af2acb26e.webm?t=1772317336\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749620/extras/9e6fd545488beba415c7165af2acb26e.mp4?t=1772317336\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Hopwander is a small adventure about exploring the unknown, helping others, and discovering what lies beyond the next island in the sky.</p>","developers":["Wildrot Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749620/4284b696ef7c0a97b11771c7fa2cba8558c30e31/header.jpg?t=1772317336","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2749620/660933/e6f4a09fe1c69dc800b9944538b43d2ca2e1899e/1750896656/dash_av1.mpd?t=1772317219","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2749620/660933/e6f4a09fe1c69dc800b9944538b43d2ca2e1899e/1750896656/dash_h264.mpd?t=1772317219","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2749620/660933/e6f4a09fe1c69dc800b9944538b43d2ca2e1899e/1750896656/hls_264_master.m3u8?t=1772317219","id":257000159,"name":"Hopwander Teaser Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257000159/d9e61e45d5843f851c01bc6b489308e12965bf09/movie_600x337.jpg?t=1772317219"}],"name":"Hopwander","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</stro