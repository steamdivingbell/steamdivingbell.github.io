0/598910de5245b289bab6e69bc7311110e06ec5b4/ss_598910de5245b289bab6e69bc7311110e06ec5b4.1920x1080.jpg?t=1763458420","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3944240/598910de5245b289bab6e69bc7311110e06ec5b4/ss_598910de5245b289bab6e69bc7311110e06ec5b4.600x338.jpg?t=1763458420"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3944240/ba8f5a431876da449c3b40df5140d2448d6ff667/ss_ba8f5a431876da449c3b40df5140d2448d6ff667.1920x1080.jpg?t=1763458420","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3944240/ba8f5a431876da449c3b40df5140d2448d6ff667/ss_ba8f5a431876da449c3b40df5140d2448d6ff667.600x338.jpg?t=1763458420"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3944240/92ebcdf554fb364d9782fd8d3b5d6a7f4d480c94/ss_92ebcdf554fb364d9782fd8d3b5d6a7f4d480c94.1920x1080.jpg?t=1763458420","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3944240/92ebcdf554fb364d9782fd8d3b5d6a7f4d480c94/ss_92ebcdf554fb364d9782fd8d3b5d6a7f4d480c94.600x338.jpg?t=1763458420"}],"short_description":"Dust &amp; Dice is a mix of a roguelike deck builder and a Wild West-style dice game. Build your deck and roll the dice to determine your fate. Use strategic cards and poker-inspired dice combinations to survive challenging turn-based duels.","steam_appid":3944240,"support_info":{"email":"pricondemand@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}