tatic.com/store_item_assets/steam/apps/2918310/eacb3ada444194452873e36c4aaf466a9f0e3956/ss_eacb3ada444194452873e36c4aaf466a9f0e3956.600x338.jpg?t=1752033921"}],"short_description":"Kiss and decapitate your friends in a Co-Op horror game about collecting cursed objects to feed to a deity called Mama, lest she hunger for you. Work together, and betray each other... Anything to keep Mama happy.","steam_appid":2918310,"support_info":{"email":"isthisamug@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://mamassleepingangels.com/"}