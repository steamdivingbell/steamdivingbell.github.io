a56c8053dc2d90a862e282ee3ea6447f02cf75/ss_74a56c8053dc2d90a862e282ee3ea6447f02cf75.600x338.jpg?t=1758239854"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3813810/c32d00dfc7e67e4b9bfefa53166f8051bae39595/ss_c32d00dfc7e67e4b9bfefa53166f8051bae39595.1920x1080.jpg?t=1758239854","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3813810/c32d00dfc7e67e4b9bfefa53166f8051bae39595/ss_c32d00dfc7e67e4b9bfefa53166f8051bae39595.600x338.jpg?t=1758239854"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3813810/188826ebef804d3f4d32b5eebefc6df5b5a06707/ss_188826ebef804d3f4d32b5eebefc6df5b5a06707.1920x1080.jpg?t=1758239854","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3813810/188826ebef804d3f4d32b5eebefc6df5b5a06707/ss_188826ebef804d3f4d32b5eebefc6df5b5a06707.600x338.jpg?t=1758239854"}],"short_description":"PengPong is a survival roguelike shooter in a vintage cartoon world. Use a hockey stick to deflect pucks and weapons, stop swarms, and test your luck. Spend chips for safe upgrades or risk it at the roulette. New builds and quirky synergies challenge survival every run.","steam_appid":3813810,"support_info":{"email":"help@sandyfloor.com","url":"https://discord.gg/UfaJtyXT3v"},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese, Korean","type":"game","website":"https://store.steampowered.com/app/2766910/PengPong/"}