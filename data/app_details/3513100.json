ords</h2><p class=\"bb_paragraph\">Or take out your enemies the old fashioned way. Wield a sword, axe, hammer, and more, to smash them to pieces.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3513100/extras/Sword_Action.gif?t=1742864138\" /></p>","developers":["Destreon Games"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3513100/header.jpg?t=1742864138","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257100346,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257100346/movie480.mp4?t=1742860765","max":"http://video.akamai.steamstatic.com/store_trailers/257100346/movie_max.mp4?t=1742860765"},"name":"Knight's In A Different Spacetime - Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257100346/841d73b9b6e2543bc96e2690a344663d915bd238/movie_600x337.jpg?t=1742860765","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257100346/movie480_vp9.webm?t=1742860765","max":"http://video.akamai.steamstatic.com/store_trailers/257100346/movie_max_vp9.webm?t=1742860765"}}],"name":"Knights In A Different SpaceTime","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel i3 8th gen or AMD Ryzen 2200g<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 750 Ti or AMD Radeon R7 260X<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 5 GB available space<br></li><li><strong>Sound Card:</strong> Integrated</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 11<br></li><li><strong>Processor:</strong> In