steamstatic.com/store_item_assets/steam/apps/2052710/ss_01a86a46c0c6e46789b84ebf4370cce53c2ae5ab.600x338.jpg?t=1762873261"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2052710/56277b00f760f0b1c927976156ae989d2b0351d8/ss_56277b00f760f0b1c927976156ae989d2b0351d8.1920x1080.jpg?t=1762873261","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2052710/56277b00f760f0b1c927976156ae989d2b0351d8/ss_56277b00f760f0b1c927976156ae989d2b0351d8.600x338.jpg?t=1762873261"}],"short_description":"Hello Again is a time-looping adventure about mystical ruins, ancient secrets, and goofy weirdos. Play as a hapless ferret shipwrecked on a strange island, stuck inside a strange time loop. Explore forgotten ruins. Befriend silly strangers. Solve time-bound puzzles. Repeat for the rest of eternity.","steam_appid":2052710,"support_info":{"email":"soupislandgames@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://soupisland.com"}