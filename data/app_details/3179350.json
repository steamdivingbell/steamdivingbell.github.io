ssets/steam/apps/3179350/c5fb25cd455dc54638eea41a6eee68d6fa8d1029/ss_c5fb25cd455dc54638eea41a6eee68d6fa8d1029.600x338.jpg?t=1759419978"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3179350/92a25661031bad76574e9470dcb55b09578a592a/ss_92a25661031bad76574e9470dcb55b09578a592a.1920x1080.jpg?t=1759419978","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3179350/92a25661031bad76574e9470dcb55b09578a592a/ss_92a25661031bad76574e9470dcb55b09578a592a.600x338.jpg?t=1759419978"}],"short_description":"Explore and survive the harsh American wilderness in the Long Drive North. Drive and repair your trusty old RV, scavenge for parts, hunt and cook to survive; all alone or with up to 4 players in co-op. No zombies or monsters await \u2013 just an immersive driving-exploration-survival experience.","steam_appid":3179350,"support_info":{"email":"support@excalibur-games.com","url":"https://Excalibur-games.com"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Traditional Chinese, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":null}