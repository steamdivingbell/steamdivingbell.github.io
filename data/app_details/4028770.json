_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4028770/859a66fb7720e1ec817fbbcef85a3fd02bd53fe1/ss_859a66fb7720e1ec817fbbcef85a3fd02bd53fe1.600x338.jpg?t=1761427143"}],"short_description":"OBVERSE is an immersive first-person action, problem-solving, and exploration game set in a vast underground research facility. Outsmart hostile machines, find creative solutions to every obstacle, and uncover the truth behind a secret experiment that could threaten reality itself.","steam_appid":4028770,"support_info":{"email":"spin.protocol.supp@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Spanish - Spain<strong>*</strong>, Spanish - Latin America<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}