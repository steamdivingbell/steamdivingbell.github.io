1029b172.webm?t=1762191746\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2407530/extras/b761730be41be4542cabdf611029b172.mp4?t=1762191746\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Key Gameplay Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >An interactive <strong>package system</strong> \u2014 pack, label, and track your deliveries manually</p></li><li><p class=\"bb_paragraph\" >A dynamic <strong>reputation and review system</strong> that shapes your public image</p></li><li><p class=\"bb_paragraph\" >A fully simulated <strong>economy</strong>, including fluctuating prices and changing demand</p></li></ul><p class=\"bb_paragraph\" >Will you become a legitimate entrepreneur \u2014 or the shadow mogul of the digital underworld?<br><strong>Welcome to MONEY GLITCH.</strong></p>","developers":["RadGames"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2407530/1a6f2669bd84f2a632cc2eb616b34a40805deb29/header.jpg?t=1762191746","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Money Glitch","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel: Core i3, 4. Generation or higher<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 4000<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["RadGames"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia fantasiosa","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"12","rating_generated":"1","req