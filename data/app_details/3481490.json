_assets/steam/apps/3481490/519928c8de744fb7e83dc78df754c78ffaeef1e7/ss_519928c8de744fb7e83dc78df754c78ffaeef1e7.600x338.jpg?t=1772131067"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3481490/3bd64699f3789ec70cbf3b9944d62090cdcc183a/ss_3bd64699f3789ec70cbf3b9944d62090cdcc183a.1920x1080.jpg?t=1772131067","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3481490/3bd64699f3789ec70cbf3b9944d62090cdcc183a/ss_3bd64699f3789ec70cbf3b9944d62090cdcc183a.600x338.jpg?t=1772131067"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3481490/48f298c3cebece7a2d52407ac3a8a5d5814c1a97/ss_48f298c3cebece7a2d52407ac3a8a5d5814c1a97.1920x1080.jpg?t=1772131067","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3481490/48f298c3cebece7a2d52407ac3a8a5d5814c1a97/ss_48f298c3cebece7a2d52407ac3a8a5d5814c1a97.600x338.jpg?t=1772131067"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3481490/2199fd556b3f63fa8519edcbf45c7e01f4c8ea42/ss_2199fd556b3f63fa8519edcbf45c7e01f4c8ea42.1920x1080.jpg?t=1772131067","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3481490/2199fd556b3f63fa8519edcbf45c7e01f4c8ea42/ss_2199fd556b3f63fa8519edcbf45c7e01f4c8ea42.600x338.jpg?t=1772131067"}],"short_description":"In local multiplayer Grab Your Friends, one player in VR controls the claw of a claw machine, while friends on their phones run, hide, and cause chaos inside using special hats. Short, exciting rounds\u2014perfect for any game night.","steam_appid":3481490,"support_info":{"email":"support@softspotgames.de","url":""},"supported_languages":"English","type":"game","website":null}