tier creators with a shared vision for &quot;Chronoscript: The Endless End&quot; have brought their talents in sound production and character design into the game, fully joining forces with the team.</p>","developers":["DeskWorks Inc."],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4018380/b8a6df73eecd70519836e259843c7d952db10b29/header.jpg?t=1774517265","is_free":false,"legal_notice":"\u00a9SHUEISHA/SHUEISHA GAMES, Developed by DeskWorks","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4018380/1141717310/2148b32b19e29a237c95bd5ca528034ea1ce180f/1757586777/dash_av1.mpd?t=1758749154","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4018380/1141717310/2148b32b19e29a237c95bd5ca528034ea1ce180f/1757586777/dash_h264.mpd?t=1758749154","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4018380/1141717310/2148b32b19e29a237c95bd5ca528034ea1ce180f/1757586777/hls_264_master.m3u8?t=1758749154","id":257196149,"name":"Announce Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257196149/ced678d6bc7f6f2f4b76e12c02e44a732a3a6455/movie_600x337.jpg?t=1758749154"}],"name":"Chronoscript: The Endless End","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 11<br></li><li><strong>Processor:</strong> Dual Core 2.8 GHz<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> 4 GB VRAM<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 16 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 11 or later<br></li><li><strong>Processor:</strong>  Quad Core 2.8 GHz<br></li><li