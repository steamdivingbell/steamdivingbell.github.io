ai.steamstatic.com/store_item_assets/steam/apps/3294500/extras/1c4a8b344ff3798b99f0c9cc562d9c27.mp4?t=1757355531\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>It's a long, lonely walk, but there's no guarantee you'll be alone...</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294500/extras/fc2452a25d33c27beb1a4880d65d7192.poster.avif?t=1757355531\" width=480 height=320 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294500/extras/fc2452a25d33c27beb1a4880d65d7192.webm?t=1757355531\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294500/extras/fc2452a25d33c27beb1a4880d65d7192.mp4?t=1757355531\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Search side areas in the environment to find the mysterious apple piles, and maybe you'll stumble across a few secrets...</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294500/extras/994bcd72f42b5692eb9f9da06988b7f8.poster.avif?t=1757355531\" width=480 height=320 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294500/extras/994bcd72f42b5692eb9f9da06988b7f8.webm?t=1757355531\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294500/extras/994bcd72f42b5692eb9f9da06988b7f8.mp4?t=1757355531\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294500/extras/1a8437