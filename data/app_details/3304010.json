.akamai.steamstatic.com/store_item_assets/steam/apps/3304010/4015d96a1a4c653680f96724c826df7e962f7f04/ss_4015d96a1a4c653680f96724c826df7e962f7f04.600x338.jpg?t=1773082439"}],"short_description":"Blackblade Revenant is an action RPG set in a forsaken kingdom where Eastern dynasty meets dark sci-fi. Rise from the dead as the chosen Revenant, wield multiple forms and master brutally fast-paced deflection combat on your quest to defeat the Immortal King of Annam.","steam_appid":3304010,"support_info":{"email":"contact@pictagor.com","url":"https://discord.gg/ZrwVYM2f"},"supported_languages":"English, Spanish - Spain, Japanese, Portuguese - Brazil, Simplified Chinese","type":"game","website":"https://blackblade.pictagor.com/"}