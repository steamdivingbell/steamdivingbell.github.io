209"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4058260/c2a53079402ed0dce6d6d36c6e53aafb5ac3bc6d/ss_c2a53079402ed0dce6d6d36c6e53aafb5ac3bc6d.1920x1080.jpg?t=1769002209","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4058260/c2a53079402ed0dce6d6d36c6e53aafb5ac3bc6d/ss_c2a53079402ed0dce6d6d36c6e53aafb5ac3bc6d.600x338.jpg?t=1769002209"}],"short_description":"Block States is a first-person speedrunning game built around pure movement. No enemies. No combat. Just momentum, precision jumps, and Steam-connected leaderboards where every millisecond counts.","steam_appid":4058260,"support_info":{"email":"stihilus.studio@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://www.lomz.net/"}