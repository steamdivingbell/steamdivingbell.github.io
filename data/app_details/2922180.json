47"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2922180/ss_43b5a1078d90bac8a2807118a177faa8fe26e10e.1920x1080.jpg?t=1745097147","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2922180/ss_43b5a1078d90bac8a2807118a177faa8fe26e10e.600x338.jpg?t=1745097147"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2922180/ss_df1a56b9011b04e17dcc8da57a41c1d76232a6af.1920x1080.jpg?t=1745097147","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2922180/ss_df1a56b9011b04e17dcc8da57a41c1d76232a6af.600x338.jpg?t=1745097147"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2922180/ss_53c17aaacb50f106fbd770ff3dbef0ee612f56bf.1920x1080.jpg?t=1745097147","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2922180/ss_53c17aaacb50f106fbd770ff3dbef0ee612f56bf.600x338.jpg?t=1745097147"}],"short_description":"At sunset, darkness swallowed everything. Bonds of Yachiyo is a Japanese horror tale of two best friends getting separated in a strange version of their own world. Escape from evil spirits, explore and solve puzzles as you try to unravel the truth and reunite the two friends!","steam_appid":2922180,"support_info":{"email":"","url":"https://saikeystudios.com"},"supported_languages":"English, Japanese<strong>*</strong>, Simplified Chinese, Traditional Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://saikeystudios.com"}