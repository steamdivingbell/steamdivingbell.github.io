4563ecf421.1920x1080.jpg?t=1764856711","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859230/51739a678ce13999e723af85755eb84563ecf421/ss_51739a678ce13999e723af85755eb84563ecf421.600x338.jpg?t=1764856711"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859230/433016a8a029d7f35b46ec00cf3b4ca84d484484/ss_433016a8a029d7f35b46ec00cf3b4ca84d484484.1920x1080.jpg?t=1764856711","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859230/433016a8a029d7f35b46ec00cf3b4ca84d484484/ss_433016a8a029d7f35b46ec00cf3b4ca84d484484.600x338.jpg?t=1764856711"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859230/107b6c8c3771663a29ce8329f274e1da4fc78793/ss_107b6c8c3771663a29ce8329f274e1da4fc78793.1920x1080.jpg?t=1764856711","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859230/107b6c8c3771663a29ce8329f274e1da4fc78793/ss_107b6c8c3771663a29ce8329f274e1da4fc78793.600x338.jpg?t=1764856711"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859230/1b7776024081f14bf644738f3b7912c6308bb2a8/ss_1b7776024081f14bf644738f3b7912c6308bb2a8.1920x1080.jpg?t=1764856711","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859230/1b7776024081f14bf644738f3b7912c6308bb2a8/ss_1b7776024081f14bf644738f3b7912c6308bb2a8.600x338.jpg?t=1764856711"}],"short_description":"A narrative-heavy, comic-infused\u00a0survival visual novel &amp; puzzle game where you are a licensed body collector navigating\u00a0a dystopian world of moral dilemmas and resource management; where belief, rebellion, or control will prevail through your choices.\u00a0","steam_appid":3859230,"support_info":{"email":"exignorantia@gmail.com","url":"exignorantia.com"},"supported_languages":"English<strong>*</strong>, Portuguese - Brazil<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://exignorantia.com"}