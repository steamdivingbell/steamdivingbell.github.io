munity/public/images/apps/1167630/857650aed060ae01e5155e4dc0323aabe6bc0557.jpg"},{"icon":"dad8af637bd0e97ace4b52b5dc5686f4fbd60793.jpg","localized_name":"McFly","name":"McFly","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/1167630/dad8af637bd0e97ace4b52b5dc5686f4fbd60793.jpg"}],"total":27},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/1167630?t=1776678144","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/page_bg_raw.jpg?t=1776678144","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/84cdc9c69746daeee59a56b5269596ebbdb014fb/capsule_231x87_alt_assets_5.jpg?t=1776678144","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/84cdc9c69746daeee59a56b5269596ebbdb014fb/capsule_184x69_alt_assets_5.jpg?t=1776678144","categories":[{"description":"Single-player","id":2},{"description":"Multi-player","id":1},{"description":"PvP","id":49},{"description":"Online PvP","id":36},{"description":"Co-op","id":9},{"description":"Online Co-op","id":38},{"description":"Steam Achievements","id":22},{"description":"Full controller support","id":28},{"description":"Steam Workshop","id":30},{"description":"Steam Cloud","id":23},{"description":"Includes level editor","id":17},{"description":"Remote Play on Tablet","id":42},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"controller_support":"full","detailed_description":"<p class=\"bb_paragraph\" >Plan and execute the perfect heist in a fully destructible world. In Teardown, anything can be broken, moved, or turned into a shortcut. Take your time and use creative problem-solving, brute force, and everything around you to create an efficient path through the level.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Run, jump, drive, slingshot. Do whatever you need to collect targets, avoid robots, or steal whatever your clients ask for, alone or together with friends in multiplayer. And whatever you do\u2026 don\u2019t get caught.</p><p class=\"bb_paragraph\" ><strong>Features</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Fully destructible voxel environments</p></li><li><p class=\"bb_paragraph\" >Realistic physics, fire, smoke, water, debris, and vehicles</p></li><li><p class=\"bb_paragraph\" >Multiplayer chaos - up to 12 people</p></li><li><p class=\"bb_paragraph\" >Huge arsenal of tools and explosives</p></li><li><p class=\"bb_paragraph\" >Story-driven campaign with 40 missions, fun in single player, a blast in multiplayer.</p></li><li><p class=\"bb_paragraph\" >Sandbox mode for unlimited resources and destruction, alone or together with friends</p></li><li><p class=\"bb_paragraph\" >Thousands of community made mods to enjoy!</p></li></ul><h2 class=\"bb_tag\" ><strong>Campaign</strong></h2><p class=\"bb_paragraph\" >After accepting a shady offer in hopes of saving your demolition business, you\u2019re pulled into a murky soup of revenge, betrayal, and insurance fraud. You soon find yourself stealing cars, demolishing buildings, blowing up safes, avoiding trigger-happy robots and more.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Upgrade your expanding arsenal of tools by searching for hidden valuables scattered around the environment.</p><p class=\"bb_paragraph\" > <br> <br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/c92ad85caf320da2b2acc5b44570ae07.poster.avif?t=1776678144\" width=1170 height=390 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/c92ad85caf320da2b2acc5b44570ae07.webm?t=1776678144\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/c92ad85caf320da2b2acc5b44570ae07.mp4?t=1776678144\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Modding</strong></h2><p class=\"bb_paragraph\" >Use the same editor the developers use to create custom maps, tools, vehicles, and game modes. Complete with built-in mod support, Lua scripting, and Steam Workshop integration. Teardown includes detailed example mods you can learn from or build upon, making it easy for aspiring modders to get started. Or just dive in and enjoy the wide range of community-created mods.</p><p class=\"bb_paragraph\" > <br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/78d786c21b2afe4f3fe8418429ddf537.poster.avif?t=1776678144\" width=1170 height=390 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/78d786c21b2afe4f3fe8418429ddf537.webm?t=1776678144\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/78d786c21b2afe4f3fe8418429ddf537.mp4?t=1776678144\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Multiplayer</strong></h2><p class=\"bb_paragraph\" >Up to 12 people can play together in an online multiplayer session. Set up a private session for you and your friends or join a public lobby. You can play the campaign, have fun in sandbox mode, or play mods created by the community.</p><p class=\"bb_paragraph\" > <br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/3de06c3fc67f06f141e96469a21f3182.poster.avif?t=1776678144\" width=1170 height=390 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/3de06c3fc67f06f141e96469a21f3182.webm?t=1776678144\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/3de06c3fc67f06f141e96469a21f3182.mp4?t=1776678144\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Sandbox</strong></h2><p class=\"bb_paragraph\" >Create chaos in sandbox mode with unlimited resources and total freedom. Experiment, destroy, spawn objects, and play by your own rules.</p><p class=\"bb_paragraph\" > <br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/ee3b14459b4b5c561e0deff664a89985.poster.avif?t=1776678144\" width=1170 height=390 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/ee3b14459b4b5c561e0deff664a89985.webm?t=1776678144\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/extras/ee3b14459b4b5c561e0deff664a89985.mp4?t=1776678144\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Art Vandals</strong></h2><p class=\"bb_paragraph\" >A free mini campaign expansion for Teardown featuring five new heist missions set in the quiet village of Till\u00e4ggaryd. Introducing new tools like the Paperboy Gun and Jackhammer. Created as a mod, Art Vandals also serves as an introduction to Teardown\u2019s powerful modding systems.<br><br> </p>","developers":["Tuxedo Labs"],"dlc":[2657100,2657070,2657060,2657050,2657080],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1167630/0e7e93896986a74b8a0394318e92e8f2789abd5d/header_alt_assets_5.jpg?t=1776678144","is_free":false,"legal_notice":"Copyright 2020-2026 Tuxedo Labs AB","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong>