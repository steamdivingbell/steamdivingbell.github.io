338.jpg?t=1751632559"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3586660/416f113bd0c02735e77568098770576f9a8cb131/ss_416f113bd0c02735e77568098770576f9a8cb131.1920x1080.jpg?t=1751632559","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3586660/416f113bd0c02735e77568098770576f9a8cb131/ss_416f113bd0c02735e77568098770576f9a8cb131.600x338.jpg?t=1751632559"}],"short_description":"Spell words, pick perks, score points, and survive until the end. Every round is different. How far can you make it?","steam_appid":3586660,"support_info":{"email":"mcbacon+wordplay@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}