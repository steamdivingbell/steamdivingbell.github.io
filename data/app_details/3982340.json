\u200b</p>","developers":["No\u00ebl Widmer"],"genres":[{"description":"Indie","id":"23"},{"description":"Racing","id":"9"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982340/46b3f88a7f024df1cda1da57741612f318117259/header.jpg?t=1768955043","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Forca Recurva","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10 / 11<br></li><li><strong>Processor:</strong> Intel Core i5-2400, AMD FX-4100<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 650 Ti or AMD Radeon HD 7770<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 23 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Network:</strong> Broadband Internet connection</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["No\u00ebl Widmer"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982340/b89a2097928e8527628139a7c344e67f79746399/ss_b89a2097928e8527628139a7c344e67f79746399.1920x1080.jpg?t=1768955043","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982340/b89a2097928e8527628139a7c344e67f79746399/ss_b89a2097928e8527628139a7c344e67f79746399.600x338.jpg?t=1768955043"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982340/e70f58876c3d778391885483392284b03ebb3ff7/ss_e70f58876c3d7783