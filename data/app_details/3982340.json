s/3982340/6a5daf4d006ae1dcf8ffcc99bc746c887ea9b722/ss_6a5daf4d006ae1dcf8ffcc99bc746c887ea9b722.1920x1080.jpg?t=1768955043","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982340/6a5daf4d006ae1dcf8ffcc99bc746c887ea9b722/ss_6a5daf4d006ae1dcf8ffcc99bc746c887ea9b722.600x338.jpg?t=1768955043"}],"short_description":"A racing game where every mistake becomes an opponent.","steam_appid":3982340,"support_info":{"email":"contact@noelwidmer.com","url":""},"supported_languages":"English<strong>*</strong>, French<strong>*</strong>, Italian<strong>*</strong>, German<strong>*</strong>, Spanish - Spain<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}