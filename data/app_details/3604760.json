x1080.jpg?t=1773239220","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/c5fc117309e824c7150efacaf043c13dbd571dbd/ss_c5fc117309e824c7150efacaf043c13dbd571dbd.600x338.jpg?t=1773239220"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/4db8ff41c3092ec2c30675f721ba20c0f753b54b/ss_4db8ff41c3092ec2c30675f721ba20c0f753b54b.1920x1080.jpg?t=1773239220","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/4db8ff41c3092ec2c30675f721ba20c0f753b54b/ss_4db8ff41c3092ec2c30675f721ba20c0f753b54b.600x338.jpg?t=1773239220"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/fc2af4bc506dc19411328dcc17b02398c467d6f9/ss_fc2af4bc506dc19411328dcc17b02398c467d6f9.1920x1080.jpg?t=1773239220","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/fc2af4bc506dc19411328dcc17b02398c467d6f9/ss_fc2af4bc506dc19411328dcc17b02398c467d6f9.600x338.jpg?t=1773239220"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/32410922db3c69e01b3c2a1ca70c1290b8473f4e/ss_32410922db3c69e01b3c2a1ca70c1290b8473f4e.1920x1080.jpg?t=1773239220","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/32410922db3c69e01b3c2a1ca70c1290b8473f4e/ss_32410922db3c69e01b3c2a1ca70c1290b8473f4e.600x338.jpg?t=1773239220"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/d43dc5ea12b304df0eae073ecd4fec92ec0d0a29/ss_d43dc5ea12b304df0eae073ecd4fec92ec0d0a29.1920x1080.jpg?t=1773239220","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/d43dc5ea12b304df0eae073ecd4fec92ec0d0a29/ss_d43dc5ea12b304df0eae073ecd4fec92ec0d0a29.600x338.jpg?t=1773239220"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/b012271660cd33ceb22e32bca8636bbc16552d6e/ss_b012271660cd33ceb22e32bca8636bbc16552d6e.1920x1080.jpg?t=1773239220","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3604760/b012271660cd33ceb22e32bca8636bbc16552d6e/ss_b012271660cd33ceb22e32bca8636bbc16552d6e.600x338.jpg?t=1773239220"}],"short_description":"Trade Empire is a medieval trade strategy simulation game. Create your merchant, start trading in your chosen city, and use diplomatic moves to take control of trade across the entire map and eliminate your rivals.","steam_appid":3604760,"support_info":{"email":"valengatestudio@gmail.com","url":"http://www.valengate.com"},"supported_languages":"English, Turkish","type":"game","website":null}