il":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2184080/ss_d186be837b61b9936800b07ee9d3db788e36c6a0.600x338.jpg?t=1764870604"}],"short_description":"A time loop metroidbrainia where time is your best resource and secrets are your only upgrades. You're the last of the Weavers, a remnant of a ruined society trapped in a glitching time loop. Explore what remains. Uncover the mystery. Perfect the loop.","steam_appid":2184080,"support_info":{"email":"info@moonlightkids.co","url":"https://bugs.akuparagames.com/"},"supported_languages":"English, French, German, Spanish - Spain, Portuguese - Brazil, Simplified Chinese","type":"game","website":"https://www.moonlightkids.co/"}