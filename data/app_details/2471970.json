m_assets/steam/apps/2471970/extras/14da5f912f7aae37afa606ba2febf522.mp4?t=1757335565\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >You can walk around and see from a first-person point of view your planet and your creations.</p><h2 class=\"bb_tag\" >CIVILIZATIONS</h2><br><strong><u>This feature is still not available in Early Access, it will come in a major update soon!</u></strong><br><br><p class=\"bb_paragraph\" >When your creatures reach sufficient intelligence they will organize themselves into tribes and later flourish into civilizations. Manage and help them in the battle for technology to conquer the planet.</p>","developers":["Sotenbox"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2471970/2ab5d49405baa35c3c7862f987c276f890719faf/header.jpg?t=1757335565","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 22.04 LTS<br></li><li><strong>Processor:</strong> 2.8 GHz Dual Core or equivalent<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 1050 / AMD Radeon RX 560<br></li><li><strong>Storage:</strong> 200 MB available space</li></ul>"},"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2471970/577290/a2d45b786bb2bb6e404c561994828159d8ff00de/1750922557/dash_av1.mpd?t=1741788732","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2471970/577290/a2d45b786bb2bb6e404c561994828159d8ff00de/1750922557/dash_h264.mpd?t=1741788732","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2471970/577290/a2d45b786bb2bb6e404c561994828159d8ff00de/1750922557/hls_264_master.m3u8?t=1741788732","id":256952356,"mp4":{"480":"https://video.akamai.steamstat