re_item_assets/steam/apps/4007500/479c83eabbae2ab2181ade1b7b235a387d6cdc1b/ss_479c83eabbae2ab2181ade1b7b235a387d6cdc1b.600x338.jpg?t=1762104872"}],"short_description":"TerrApocalipse is a space action strategy with RPG elements placed in our solar system, which was attacked by a powerful enemy. Soon the vast void between planets will be filled with conflict, the outcome of which will be determined by your actions.","steam_appid":4007500,"support_info":{"email":"contact@terrapocalipse.com","url":"http://terrapocalipse.com/"},"supported_languages":"English<strong>*</strong>, Polish<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://terrapocalipse.com/"}