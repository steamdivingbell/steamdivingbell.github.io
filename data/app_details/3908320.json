908320/extras/7157f5e92152f0d1fead7481ba5c0f0f.poster.avif?t=1774288424\" width=590 height=330 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/extras/7157f5e92152f0d1fead7481ba5c0f0f.webm?t=1774288424\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/extras/7157f5e92152f0d1fead7481ba5c0f0f.mp4?t=1774288424\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>","developers":["Michael Richard Lannon"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/e4011548774d2c3898d15587e2840cfbf681e6f3/header.jpg?t=1774288424","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3908320/1418120832/aa5c96ebed1dc3fd8350cf377ba99d90c8f5338f/1753805182/dash_av1.mpd?t=1772112957","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3908320/1418120832/aa5c96ebed1dc3fd8350cf377ba99d90c8f5338f/1753805182/dash_h264.mpd?t=1772112957","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3908320/1418120832/aa5c96ebed1dc3fd8350cf377ba99d90c8f5338f/1753805182/hls_264_master.m3u8?t=1772112957","id":257175388,"name":"Official","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257175388/921781c1e2a2570a2f56059b4e4482a0bc6ff952/movie_600x337.jpg?t=1772112957"},{"dash_av1":"https://video.akamai.steamstatic.com/stor