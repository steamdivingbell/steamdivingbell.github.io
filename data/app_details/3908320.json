 is more GPU dependant than CPU. The more VRAM, the better.</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Michael Richard Lannon"],"ratings":{"dejus":{"banned":"0","descriptors":"Drogas il\u00edcitas\nViol\u00eancia\nTemas sens\u00edveis","rating":"18","rating_generated":"1","required_age":"18","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Drogen\nHorror\nSexuelle Andeutungen","rating":"18","rating_generated":"1","required_age":"18","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Coming soon"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/efe0a101252d9739840ad2174099330f15de9d64/ss_efe0a101252d9739840ad2174099330f15de9d64.1920x1080.jpg?t=1774288424","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/efe0a101252d9739840ad2174099330f15de9d64/ss_efe0a101252d9739840ad2174099330f15de9d64.600x338.jpg?t=1774288424"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/b545cc9f8f681d16e6b2794a981af2176d43e349/ss_b545cc9f8f681d16e6b2794a981af2176d43e349.1920x1080.jpg?t=1774288424","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/b545cc9f8f681d16e6b2794a981af2176d43e349/ss_b545cc9f8f681d16e6b2794a981af2176d43e349.600x338.jpg?t=1774288424"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/0d1fe57d536d3ab47b5da392cd9ead48a116ce3d/ss_0d1fe57d536d3ab47b5da392cd9ead48a116ce3d.1920x1080.jpg?t=1774288424","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/0d1fe57d536d3ab47b5da392cd9ead48a116ce3d/ss_0d1fe57d536d3ab47b5da392cd9ead48a116ce3d.600x338.jpg?t=1774288424"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/6e0c9c304c3bb591f0e9b4b6b7bbb02ad85838a1/ss_6e0c9c304c3bb591