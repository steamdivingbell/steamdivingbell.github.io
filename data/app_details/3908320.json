1080.jpg?t=1768499427","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/ba9d89408fc7e67d880c99727f0739a2e4fdcbd6/ss_ba9d89408fc7e67d880c99727f0739a2e4fdcbd6.600x338.jpg?t=1768499427"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/c850f4044b8c3c80ae34d8b232d40bdea12626d5/ss_c850f4044b8c3c80ae34d8b232d40bdea12626d5.1920x1080.jpg?t=1768499427","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/c850f4044b8c3c80ae34d8b232d40bdea12626d5/ss_c850f4044b8c3c80ae34d8b232d40bdea12626d5.600x338.jpg?t=1768499427"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/93329089ecfaf4771a77a98356477be4ce039cab/ss_93329089ecfaf4771a77a98356477be4ce039cab.1920x1080.jpg?t=1768499427","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/93329089ecfaf4771a77a98356477be4ce039cab/ss_93329089ecfaf4771a77a98356477be4ce039cab.600x338.jpg?t=1768499427"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/2cc4c004b83009521e19b94431f2524305fc187a/ss_2cc4c004b83009521e19b94431f2524305fc187a.1920x1080.jpg?t=1768499427","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/2cc4c004b83009521e19b94431f2524305fc187a/ss_2cc4c004b83009521e19b94431f2524305fc187a.600x338.jpg?t=1768499427"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/39cdef79ea05831e76c316d42eaae621304797d8/ss_39cdef79ea05831e76c316d42eaae621304797d8.1920x1080.jpg?t=1768499427","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908320/39cdef79ea05831e76c316d42eaae621304797d8/ss_39cdef79ea05831e76c316d42eaae621304797d8.600x338.jpg?t=1768499427"}],"short_description":"15 playable prisoners are trapped in a deadly game of murder and deception. Investigate or create twisted cases, clash in ruthless trials, and expose lies with lethal wordplay. Roles shift, alliances fracture, and one mole works against the group. Can you adapt before you're punished?","steam_appid":3908320,"support_info":{"email":"evilous@protonmail.com","url":""},"supported_languages":"English<strong>*</strong>, Japanese, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America, French, German, Korean, Polish, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":null}