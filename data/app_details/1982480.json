yle</p></li><li><p class=\"bb_paragraph\" >Save Greenins, who will bring you upgrades and increase the maximum capacity of rechargeable items.</p></li><li><p class=\"bb_paragraph\" >Upgrade your level to get stronger and be able to use new skills.</p></li><li><p class=\"bb_paragraph\" >Greenins at your base can bring you new weapons and skills, using collected orbs.</p></li><li><p class=\"bb_paragraph\" >Play co-op or alone.</p></li><li><p class=\"bb_paragraph\" >Play Player vs Player</p></li></ul>","developers":["TGM"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1982480/header.jpg?t=1767832952","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1982480/397083877/4950254a88cdeda48d14022bdf67b7bed6b3bb31/1767397433/dash_av1.mpd?t=1767819515","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1982480/397083877/4950254a88cdeda48d14022bdf67b7bed6b3bb31/1767397433/dash_h264.mpd?t=1767819515","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1982480/397083877/4950254a88cdeda48d14022bdf67b7bed6b3bb31/1767397433/hls_264_master.m3u8?t=1767819515","id":257258474,"name":"Release Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257258474/bef58baac937f733d86381b192e667cd183ecca6/movie_600x337.jpg?t=1767819515"}],"name":"Kingdoms And Slaves","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_