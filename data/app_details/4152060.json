8dab02.poster.avif?t=1768184503\" width=750 height=176 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4152060/extras/3fd9ac5b8c38f1bc2f867515448dab02.webm?t=1768184503\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4152060/extras/3fd9ac5b8c38f1bc2f867515448dab02.mp4?t=1768184503\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Use the gold to purchase reinforcements from the shop. Here you will find 10 new pieces to master (16 total)</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4152060/extras/f507c3f6a30b0112f6d96dba1aadc3fa.poster.avif?t=1768184503\" width=750 height=176 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4152060/extras/f507c3f6a30b0112f6d96dba1aadc3fa.webm?t=1768184503\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4152060/extras/f507c3f6a30b0112f6d96dba1aadc3fa.mp4?t=1768184503\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Just to name a few: Artillery cannot move, but can capture unguarded pieces from anywhere on the board.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4152060/extras/4074ed5c3635e7fd862d65101e06b4c6.poster.avif?t=1768184503\" width=750 height=176 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4152060/extras/4074ed5c3635e7fd862d65101e06b4c6.webm?t=1768184503\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_ass