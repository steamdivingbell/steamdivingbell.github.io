, and questions. Share your awesome wins, suggest innovative features, or point out bugs. </p><p class=\"bb_paragraph\">We always listen to the community on Discord, X, Facebook, ETC.</p>","developers":["Eggtart Inc"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2093800/header.jpg?t=1739426369","is_free":false,"legal_notice":"\u00a92024 Eggtart Inc All Rights Reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257097197,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257097197/movie480.mp4?t=1739406759","max":"http://video.akamai.steamstatic.com/store_trailers/257097197/movie_max.mp4?t=1739406759"},"name":"METAL SUITS: Counter-attack Promo A","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257097197/04aace47096e8b6606eb303d8309d7edd927e241/movie_600x337.jpg?t=1739406759","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257097197/movie480_vp9.webm?t=1739406759","max":"http://video.akamai.steamstatic.com/store_trailers/257097197/movie_max_vp9.webm?t=1739406759"}},{"highlight":true,"id":257097786,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257097786/movie480.mp4?t=1739406775","max":"http://video.akamai.steamstatic.com/store_trailers/257097786/movie_max.mp4?t=1739406775"},"name":"METAL SUITS: Counter-attack EN","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257097786/97dd3fc7a8808e7cdf0e3d889a858d4c8bd4ccfd/movie_600x337.jpg?t=1739406775","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257097786/movie480_v