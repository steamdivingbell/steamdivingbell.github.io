 class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370180/extras/8f7ca963b1614c48f107ea30e3c77fa9.avif?t=1772093888\" width=800 height=59 /></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >A visual novel featuring numerous illustrations</p></li><li><p class=\"bb_paragraph\" >Point-and-click investigations</p></li><li><p class=\"bb_paragraph\" >Parameters that change based on choices, leading to multiple endings</p></li><li><p class=\"bb_paragraph\" >Character interactions</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370180/extras/2dc08f1d0afe60c02dc6184e5ac96e4c.avif?t=1772093888\" width=1560 height=878 /></span></p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["YOKUNIKU"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370180/0ac0ea4a282f763681c26f43863e7c69397b51ed/header.jpg?t=1772093888","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3370180/1694884401/b58d6f0b4a657c3cfeb4e75355be90227adf8c10/1771588043/dash_av1.mpd?t=1771588612","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3370180/1694884401/b58d6f0b4a657c3cfeb4e75355be90227adf8c10/1771588043/dash_h264.mpd?t=1771588612","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3370180/1694884401/b58d6f0b4a657c3cfeb4e75355be90227adf8c10/1771588043/hls_264_master.m3u8?t=1771588612","id":257291060,"name":"PV","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257291060/e6dcd32c4b28c30475793fa2303896d83855b604/movie_600x337.jpg?t=1771588612"}],"name":