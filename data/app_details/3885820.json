ed.akamai.steamstatic.com/store_item_assets/steam/apps/3885820/110b2d8b1dcd87eaf15ad6db13c89fdc02eb4f08/ss_110b2d8b1dcd87eaf15ad6db13c89fdc02eb4f08.1920x1080.jpg?t=1773722487","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885820/110b2d8b1dcd87eaf15ad6db13c89fdc02eb4f08/ss_110b2d8b1dcd87eaf15ad6db13c89fdc02eb4f08.600x338.jpg?t=1773722487"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885820/b58b0e6bcf2894c4511c8bdfd5bb8b57a09981d6/ss_b58b0e6bcf2894c4511c8bdfd5bb8b57a09981d6.1920x1080.jpg?t=1773722487","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885820/b58b0e6bcf2894c4511c8bdfd5bb8b57a09981d6/ss_b58b0e6bcf2894c4511c8bdfd5bb8b57a09981d6.600x338.jpg?t=1773722487"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885820/08083b64eda738e45c8b3dc7abff557cb2c2d177/ss_08083b64eda738e45c8b3dc7abff557cb2c2d177.1920x1080.jpg?t=1773722487","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885820/08083b64eda738e45c8b3dc7abff557cb2c2d177/ss_08083b64eda738e45c8b3dc7abff557cb2c2d177.600x338.jpg?t=1773722487"}],"short_description":"The Spirit Weaver is a narrative-driven visual novel where you use the power of Tarot to guide lost spirits through their grief, and maybe figure out your own. Explore a mystical spirit realm, help its denizens, and restore balance in a bittersweet story of love, loss, and empathy.","steam_appid":3885820,"support_info":{"email":"contact@gamechangerstudio.net","url":"https://gamechangerstudio.net/"},"supported_languages":"English, Indonesian","type":"game","website":"https://gamechangerstudio.net/"}