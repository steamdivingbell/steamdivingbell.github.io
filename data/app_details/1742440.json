mai.steamstatic.com/store_item_assets/steam/apps/1742440/caf869e399d2d318dc34d429485a730d6518129c/ss_caf869e399d2d318dc34d429485a730d6518129c.1920x1080.jpg?t=1770315625","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1742440/caf869e399d2d318dc34d429485a730d6518129c/ss_caf869e399d2d318dc34d429485a730d6518129c.600x338.jpg?t=1770315625"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1742440/8f05084393db8db9cdf57b4e7e67de2a76ead9a1/ss_8f05084393db8db9cdf57b4e7e67de2a76ead9a1.1920x1080.jpg?t=1770315625","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1742440/8f05084393db8db9cdf57b4e7e67de2a76ead9a1/ss_8f05084393db8db9cdf57b4e7e67de2a76ead9a1.600x338.jpg?t=1770315625"}],"short_description":"COP BASTARD is a classic first-person shooter set in early 90s Japan, offering non-stop action inspired by action movies. Play as a dirty detective, mowing down endless waves of Yakuza with no puzzles, perks, or upgrades \u2014 just corridors, enemies, and the power to spit right in their faces","steam_appid":1742440,"support_info":{"email":"targim.games@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}