":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2818130/a7fca2cc221f8f9e17756e52f68f954a53b5be6b/ss_a7fca2cc221f8f9e17756e52f68f954a53b5be6b.1920x1080.jpg?t=1765129279","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2818130/a7fca2cc221f8f9e17756e52f68f954a53b5be6b/ss_a7fca2cc221f8f9e17756e52f68f954a53b5be6b.600x338.jpg?t=1765129279"}],"short_description":"Silver Bullet is a gothic arcade shooter: blast your way through spooky stages and macabre mini games as Van Helsing, to rescue your pet puppies who were dognapped by Reggie the Vampire!","steam_appid":2818130,"support_info":{"email":"1ccgamesinfo@gmail.com","url":"https://www.1ccgames.com"},"supported_languages":"English","type":"game","website":"https://www.1ccgames.com/p/silver-bullet.html"}