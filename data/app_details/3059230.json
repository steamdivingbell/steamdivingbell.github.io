m_assets/steam/apps/3059230/extras/816bd8b1a15a8c3d29cfdd4d6241aacd.webm?t=1757122648\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3059230/extras/816bd8b1a15a8c3d29cfdd4d6241aacd.mp4?t=1757122648\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Whether you team up or fight Free-For-All, cast Elixirs or rely on your fast mobile spells, compete with your friends to see who is blasted away in the chaos, and who reigns supreme in  the Ragdoll Rumble!</p>","developers":["Midnight Horizon"],"dlc":[3134700],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3059230/header.jpg?t=1757122648","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3059230/731778/10897b594df01ce2d5063b6041876d4e2f701ff5/1750970822/dash_av1.mpd?t=1726315529","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3059230/731778/10897b594df01ce2d5063b6041876d4e2f701ff5/1750970822/dash_h264.mpd?t=1726315529","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3059230/731778/10897b594df01ce2d5063b6041876d4e2f701ff5/1750970822/hls_264_master.m3u8?t=1726315529","id":257041146,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257041146/movie.293x165.jpg?t=1726315529"}],"name":"Ragdoll Rumble","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit proces