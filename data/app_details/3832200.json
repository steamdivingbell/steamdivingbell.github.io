m_assets/steam/apps/3832200/f802ac8b144c30fca6c909b9fe38ad387c92522d/ss_f802ac8b144c30fca6c909b9fe38ad387c92522d.600x338.jpg?t=1771829143"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3832200/a292af232d9011619d4c578867dd7967a29cf142/ss_a292af232d9011619d4c578867dd7967a29cf142.1920x1080.jpg?t=1771829143","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3832200/a292af232d9011619d4c578867dd7967a29cf142/ss_a292af232d9011619d4c578867dd7967a29cf142.600x338.jpg?t=1771829143"}],"short_description":"Save the Forest is a tactics roguelite where you recruit, upgrade and fight your way through focused, highly varied runs. Choose and combine from over 25 units and 100+ skills to defeat the evil spreading through the forest.","steam_appid":3832200,"support_info":{"email":"save.1000.forests@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}