?t=1772328320\" width=1560 height=613 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Little Snake Studio"],"dlc":[3822560],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3704230/8cbd325d39ae2b79f9380264d21623ce0890eeab/header_alt_assets_0.jpg?t=1772328320","is_free":true,"legal_notice":"Streamers are welcome! Feel free to stream, record, and share gameplay of Broken Fate. Please tag the game title when posting so others can find it. However, uploading raw gameplay without sound (no commentary, no music, no audio) is not permitted.","linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 10.13 High Sierra<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core M<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> Integrated graphics<br></li><li><strong>Storage:</strong> 500 MB available space<br></li><li><strong>Sound Card:</strong> Standard onboard sound</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3704230/1594613111/8367e4cb2d80b521cd40d3733e624fb082a4c017/1764728039/dash_av1.mpd?t=1764730999","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3704230/1594613111/8367e4cb2d80b521cd40d3733e624fb082a4c017/1764728039/dash_h264.mpd?t=1764730999","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3704230/1594613111/8367e4cb2d80b521cd40d3733e624fb082a4c017/1764728039/hls_264_master.m3u8?t=1764730999","id":257183924,"name":"Broken Fate Trailer (Cinematic)","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2