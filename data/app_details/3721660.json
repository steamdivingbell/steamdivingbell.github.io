sic online flash games. Simple, relaxing, and designed to be enjoyed in a single cozy evening. I hope it brings you a bit of calm and delight, just like it did for me while creating it.</p>","developers":["Jobblesack Games Inc."],"genres":[{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3721660/f021df3cda2ea9a7ed7da388d192432a14180546/header.jpg?t=1751308391","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257163216,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257163216/movie480.mp4?t=1751308388","max":"http://video.akamai.steamstatic.com/store_trailers/257163216/movie_max.mp4?t=1751308388"},"name":"Cozy Crunch | Official Trailer | A Relaxing Indie Cat Adventure","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257163216/382821e9b0cfcf732219c9a11f5619ec22d8f348/movie_600x337.jpg?t=1751308388","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257163216/movie480_vp9.webm?t=1751308388","max":"http://video.akamai.steamstatic.com/store_trailers/257163216/movie_max_vp9.webm?t=1751308388"}}],"name":"Cozy Crunch","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Jobblesack Games Inc."],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Q3 2025"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3721660/1c0069a60a314be9d149903ac8188279c5ac5374/ss_1c0069a60a314be9d149903ac8188279c5ac5374.1920x1080.jpg?t=1751308391","path_thumbn