store_item_assets/steam/apps/3445890/extras/92a72184ca379871c9fc82c0186d0cf2.poster.avif?t=1757188401\" width=616 height=346 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3445890/extras/92a72184ca379871c9fc82c0186d0cf2.webm?t=1757188401\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3445890/extras/92a72184ca379871c9fc82c0186d0cf2.mp4?t=1757188401\" type=\"video/mp4\"></video></span></p>","developers":["Mina P\u00eacheux"],"genres":[{"description":"Casual","id":"4"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3445890/header.jpg?t=1757188401","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10.12<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core<br></li><li><strong>Memory:</strong> 2 MB RAM<br></li><li><strong>Graphics:</strong> Integrated graphics with full Vulkan 1.0 support<br></li><li><strong>Storage:</strong> 200 MB available space</li></ul>"},"movies":[{"highlight":true,"id":257091928,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257091928/movie480.mp4?t=1746804340","max":"http://video.akamai.steamstatic.com/store_trailers/257091928/movie_max.mp4?t=1746804340"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257091928/cd07f3d63780368fe784d8f080e68dee1283637b/movie_600x337.jpg?t=1746804340","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257091928/movie480_vp9.webm?t=1746804340","max":"http://video.akamai.steamstatic.com/store_trailers/257091928/movie_max_vp9.webm?t=1746804340"}}],"name":"Light 'Em","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i7-9750H<br></li><li><strong>Memory:</strong> 2 G