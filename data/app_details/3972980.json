/store_item_assets/steam/apps/3972980/da946fb8d64c9c1d5339e89e28a8aca5d2bb6036/ss_da946fb8d64c9c1d5339e89e28a8aca5d2bb6036.600x338.jpg?t=1769086766"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3972980/a6603b94f32cc3e5753b31056773137edd1d53ed/ss_a6603b94f32cc3e5753b31056773137edd1d53ed.1920x1080.jpg?t=1769086766","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3972980/a6603b94f32cc3e5753b31056773137edd1d53ed/ss_a6603b94f32cc3e5753b31056773137edd1d53ed.600x338.jpg?t=1769086766"}],"short_description":"You have been exiled to The Mirk - an unforgiving swampland where every step can be your last. You must constantly make choices: what paths to take, which tree to shelter under, what beasts to engage or avoid, what items to bring into the darkness of dungeons, and what to leave behind.","steam_appid":3972980,"support_info":{"email":"mattias@edympixels.com","url":"https://edympixels.com/"},"supported_languages":"English","type":"game","website":"https://edympixels.com/"}