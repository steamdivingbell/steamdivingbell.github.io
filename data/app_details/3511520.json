eam/apps/3511520/ss_4dd6e470dcbd4af4bf12d2b9fec928cbe3e84bbb.600x338.jpg?t=1743531428"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_2f49ef2e27208ed61c2da0a7c35ac3e23d14226a.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_2f49ef2e27208ed61c2da0a7c35ac3e23d14226a.600x338.jpg?t=1743531428"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_773c1a8322a4fac9cbcc053a9f74c3eeb66879f2.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_773c1a8322a4fac9cbcc053a9f74c3eeb66879f2.600x338.jpg?t=1743531428"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/72a2cc7342f6bf731511ba959184dd84c5758d67/ss_72a2cc7342f6bf731511ba959184dd84c5758d67.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/72a2cc7342f6bf731511ba959184dd84c5758d67/ss_72a2cc7342f6bf731511ba959184dd84c5758d67.600x338.jpg?t=1743531428"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_109d68fae59aceef6e391896aea943ab5b435e76.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_109d68fae59aceef6e391896aea943ab5b435e76.600x338.jpg?t=1743531428"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_d3beb1cab5613fbf5ea2411b1abd4134eb5aa006.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_d3beb1cab5613fbf5ea2411b1abd4134eb5aa006.600x338.jpg?t=1743531428"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_1f729bfad85e2f4e8b71256b036dcd1a9ad79dbc.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_1f729bfad85e2f4e8b71256b036dcd1a9ad79dbc.600x338.jpg?t=1743531428"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_264a41ef2454e0d5c43d12b547cf43b802730fd6.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_264a41ef2454e0d5c43d12b547cf43b802730fd6.600x338.jpg?t=1743531428"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_d2c6bde8930d469bd7e56d39a94c77d8c60497a6.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_d2c6bde8930d469bd7e56d39a94c77d8c60497a6.600x338.jpg?t=1743531428"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_6e7290bae12ec2849f69c78a62e8786090b96601.1920x1080.jpg?t=1743531428","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3511520/ss_6e7290bae12ec2849f69c78a62e8786090b96601.600x338.jpg?t=1743531428"}],"short_description":"The Artifactory is a chaotic couch co-op party game set in a whimsical fantasy lootbox factory! Craft potions, forge weapons, and experiment and find new recipes. Upgrade factories, fix broken machines, survive moving platforms, lava, and more! Play solo or with up to 4 players!","steam_appid":3511520,"support_info":{"email":"games@berriesand.co","url":""},"supported_languages":"English, French, Italian, German, Hungarian, Simplified Chinese, Japanese","type":"game","website":"https://theartifactorygame.com/"}