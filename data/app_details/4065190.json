65190/86b477aa9d338e56fe5e5d4df044017aabdba31c/ss_86b477aa9d338e56fe5e5d4df044017aabdba31c.600x338.jpg?t=1759903706"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4065190/79f9d41552a63c5d4638d9aa3c0b9d14034f0034/ss_79f9d41552a63c5d4638d9aa3c0b9d14034f0034.1920x1080.jpg?t=1759903706","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4065190/79f9d41552a63c5d4638d9aa3c0b9d14034f0034/ss_79f9d41552a63c5d4638d9aa3c0b9d14034f0034.600x338.jpg?t=1759903706"}],"short_description":"The expansion pack 2 of 'Esports Godfather' brings 5 new heroes with different styles!","steam_appid":4065190,"support_info":{"email":"1787325680@qq.com","url":""},"supported_languages":"English, Simplified Chinese, German, Korean","type":"dlc","website":null}