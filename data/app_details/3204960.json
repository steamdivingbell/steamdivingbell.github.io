=1744722048"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3204960/1d8ef80a4cfdc3199d1269845f3e65b49de310e5/ss_1d8ef80a4cfdc3199d1269845f3e65b49de310e5.1920x1080.jpg?t=1744722048","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3204960/1d8ef80a4cfdc3199d1269845f3e65b49de310e5/ss_1d8ef80a4cfdc3199d1269845f3e65b49de310e5.600x338.jpg?t=1744722048"}],"short_description":"In the vengeance business, you leave no loose ends. Four characters scour the city, searching for their mentor's murderer in a brutal ballet of bullets. Stylish neo-noir top-down shooter with one-hit-one-kill mechanics.","steam_appid":3204960,"support_info":{"email":"press@wolcen-studio.com","url":"https://www.bulletnoir.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}