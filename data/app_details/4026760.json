eam/apps/4026760/a81c61cb093d77a4e3b26f87f01a8bbb4ba794d0/ss_a81c61cb093d77a4e3b26f87f01a8bbb4ba794d0.1920x1080.jpg?t=1762522104","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/a81c61cb093d77a4e3b26f87f01a8bbb4ba794d0/ss_a81c61cb093d77a4e3b26f87f01a8bbb4ba794d0.600x338.jpg?t=1762522104"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/ef1dff4aee349d434077c08365f95a1ce9884f34/ss_ef1dff4aee349d434077c08365f95a1ce9884f34.1920x1080.jpg?t=1762522104","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/ef1dff4aee349d434077c08365f95a1ce9884f34/ss_ef1dff4aee349d434077c08365f95a1ce9884f34.600x338.jpg?t=1762522104"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/fd90c091b33e63addff8b667ec255e433097f778/ss_fd90c091b33e63addff8b667ec255e433097f778.1920x1080.jpg?t=1762522104","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/fd90c091b33e63addff8b667ec255e433097f778/ss_fd90c091b33e63addff8b667ec255e433097f778.600x338.jpg?t=1762522104"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/6dd7d1f502b13ea5b6c234a66a2156352f05dc03/ss_6dd7d1f502b13ea5b6c234a66a2156352f05dc03.1920x1080.jpg?t=1762522104","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/6dd7d1f502b13ea5b6c234a66a2156352f05dc03/ss_6dd7d1f502b13ea5b6c234a66a2156352f05dc03.600x338.jpg?t=1762522104"}],"short_description":"Catch giant fish from the top of your car, upgrade your equipment and uncover the mystery behind the legendary \u201eHeart Drive\u201c. Embark on a journey of action, friendship and letting go, in this fast-paced driving spin on the fishing genre.","steam_appid":4026760,"support_info":{"email":"jonas.pfeiffer@outlook.de","url":""},"supported_languages":"English<strong>*</strong>, German<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}