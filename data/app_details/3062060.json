class=\"bb_tag\"><strong>Time to Clean!</strong></h2><p class=\"bb_paragraph\">Maintain a spotless kitchen and dining area to ensure top hygiene ratings. A clean restaurant means better reviews and more satisfied customers! </p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3062060/extras/53a43cd772d3986fdd2061cf93016058a624c514__1_.gif?t=1745243265\" /> </p><h2 class=\"bb_tag\">Add to Your Whishlist:</h2><p class=\"bb_paragraph\">To support us during the development process, please add our game to your wishlist and join our Discord!</p>","developers":["Red Axe Games"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3062060/header.jpg?t=1745243265","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257096328,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257096328/movie480.mp4?t=1739181545","max":"http://video.akamai.steamstatic.com/store_trailers/257096328/movie_max.mp4?t=1739181545"},"name":"Drive Thru Simulator - Prologue Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257096328/b297f16868f5acebd1565936f3b75220c847f97d/movie_600x337.jpg?t=1739181545","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257096328/movie480_vp9.webm?t=1739181545","max":"http://video.akamai.steamstatic.com/store_trailers/257096328/movie_max_vp9.webm?t=1739181545"}},{"highlight":true,"id":257060486,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257060486/movie480.mp4?t=1727721267","max":"http://video.akamai.steamstatic.com/store_trailers/257060486/movie_max.mp4?t=1727721267"},"name":"Drive Thru - Cinematic Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_asset