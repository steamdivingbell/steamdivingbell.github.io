bfb844f1b3ea05d0d3138824d3db62b128c33499/ss_bfb844f1b3ea05d0d3138824d3db62b128c33499.600x338.jpg?t=1773311901"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/bf8753585998aec5a331bcc6494bc155587c814a/ss_bf8753585998aec5a331bcc6494bc155587c814a.1920x1080.jpg?t=1773311901","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/bf8753585998aec5a331bcc6494bc155587c814a/ss_bf8753585998aec5a331bcc6494bc155587c814a.600x338.jpg?t=1773311901"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/0f1473b931c226a36bc552b25a71193ce8e3b170/ss_0f1473b931c226a36bc552b25a71193ce8e3b170.1920x1080.jpg?t=1773311901","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/0f1473b931c226a36bc552b25a71193ce8e3b170/ss_0f1473b931c226a36bc552b25a71193ce8e3b170.600x338.jpg?t=1773311901"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/776b11053f45935a88cd8370b58e19b1bafd4e7a/ss_776b11053f45935a88cd8370b58e19b1bafd4e7a.1920x1080.jpg?t=1773311901","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/776b11053f45935a88cd8370b58e19b1bafd4e7a/ss_776b11053f45935a88cd8370b58e19b1bafd4e7a.600x338.jpg?t=1773311901"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/24ece7c171260e1c156c99f52317bd97d3771203/ss_24ece7c171260e1c156c99f52317bd97d3771203.1920x1080.jpg?t=1773311901","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/24ece7c171260e1c156c99f52317bd97d3771203/ss_24ece7c171260e1c156c99f52317bd97d3771203.600x338.jpg?t=1773311901"}],"short_description":"Geritmia is an incremental roguelite where you explore procedurally generated worlds, gather resources, and grow stronger while being hunted by Paradoximus, Eater of the Worlds.","steam_appid":3634730,"support_