e31e5bc97ca78740f2d2136b7/ss_744421ac4ff2004e31e5bc97ca78740f2d2136b7.600x338.jpg?t=1768716842"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/e6a90e5164823c1d2e1fa6af8389559d074494bd/ss_e6a90e5164823c1d2e1fa6af8389559d074494bd.1920x1080.jpg?t=1768716842","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/e6a90e5164823c1d2e1fa6af8389559d074494bd/ss_e6a90e5164823c1d2e1fa6af8389559d074494bd.600x338.jpg?t=1768716842"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/e93b12defd94b78d3787a67d9fc0cd9181751a59/ss_e93b12defd94b78d3787a67d9fc0cd9181751a59.1920x1080.jpg?t=1768716842","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/e93b12defd94b78d3787a67d9fc0cd9181751a59/ss_e93b12defd94b78d3787a67d9fc0cd9181751a59.600x338.jpg?t=1768716842"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/37278522796bedb4b0e2850b5918109295b1613c/ss_37278522796bedb4b0e2850b5918109295b1613c.1920x1080.jpg?t=1768716842","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/37278522796bedb4b0e2850b5918109295b1613c/ss_37278522796bedb4b0e2850b5918109295b1613c.600x338.jpg?t=1768716842"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/4edbbc79b81412e3798b733dcea740521ea463cc/ss_4edbbc79b81412e3798b733dcea740521ea463cc.1920x1080.jpg?t=1768716842","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634730/4edbbc79b81412e3798b733dcea740521ea463cc/ss_4edbbc79b81412e3798b733dcea740521ea463cc.600x338.jpg?t=1768716842"}],"short_description":"Geritmia is an incremental roguelite where you explore procedurally generated worlds, gather resources, and grow stronger while being hunted by Paradoximus, Eater of the Worlds.","steam_appid":3634730,"support_info":{"email":