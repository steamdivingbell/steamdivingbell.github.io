_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3917600/f1000a68b7259439f215726a56bfe1208dce42ad/ss_f1000a68b7259439f215726a56bfe1208dce42ad.1920x1080.jpg?t=1755246004","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3917600/f1000a68b7259439f215726a56bfe1208dce42ad/ss_f1000a68b7259439f215726a56bfe1208dce42ad.600x338.jpg?t=1755246004"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3917600/05e1bffcacd16c1b5aa59b9edbffe496d873f8ff/ss_05e1bffcacd16c1b5aa59b9edbffe496d873f8ff.1920x1080.jpg?t=1755246004","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3917600/05e1bffcacd16c1b5aa59b9edbffe496d873f8ff/ss_05e1bffcacd16c1b5aa59b9edbffe496d873f8ff.600x338.jpg?t=1755246004"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3917600/caaafabfd319a7cfce33923fac63f3c7e9b33449/ss_caaafabfd319a7cfce33923fac63f3c7e9b33449.1920x1080.jpg?t=1755246004","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3917600/caaafabfd319a7cfce33923fac63f3c7e9b33449/ss_caaafabfd319a7cfce33923fac63f3c7e9b33449.600x338.jpg?t=1755246004"}],"short_description":"Tempered Hue is a third-person grim-cozy game about running a blacksmith shop. Craft unique tools and items, sell your wares, and explore local caverns to gather crafting materials. Navigate treacherous caverns with your trusty grappler alone or with friends in this blacksmith slice of life sim.","steam_appid":3917600,"support_info":{"email":"support@zugalu.com","url":"https://zugalu.com/"},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Traditional Chinese, Turkish","type":"game","website":"https://zugalu.com/our-games/tempered-hue/"}