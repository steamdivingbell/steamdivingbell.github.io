steam/apps/4024470/7bd990db7161816a353f83bae63a1ba5a750523b/ss_7bd990db7161816a353f83bae63a1ba5a750523b.1920x1080.jpg?t=1769032356","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4024470/7bd990db7161816a353f83bae63a1ba5a750523b/ss_7bd990db7161816a353f83bae63a1ba5a750523b.600x338.jpg?t=1769032356"}],"short_description":"Iskabon is a roguelike deckbuilder set at the turn of the millennium, where a mysterious Y2K Bug has taken over your computer. Upgrade your deck, build your hand, and trigger powerful synergies to win big\u2014and maybe take back control. Also, it's raining outside.","steam_appid":4024470,"support_info":{"email":"Interactive.poi@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}