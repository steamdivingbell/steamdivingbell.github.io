13f43bce958de3f35/ss_c5bed0a195f3625298a639613f43bce958de3f35.1920x1080.jpg?t=1757769155","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3376500/c5bed0a195f3625298a639613f43bce958de3f35/ss_c5bed0a195f3625298a639613f43bce958de3f35.600x338.jpg?t=1757769155"}],"short_description":"Little Chef: Cozy Cooking is a physics-based cooking game that puts a lot of heart into discovery and exploration. You can interact with pretty much anything and either create pure chaos or try your luck at unlocking all ~300 recipes to become a master chef!","steam_appid":3376500,"support_info":{"email":"support@littlechefgame.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://littlechefgame.com"}