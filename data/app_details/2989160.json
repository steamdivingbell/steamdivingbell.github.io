b0c0953e25a2.1920x1080.jpg?t=1766024693","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_d1b9fbeb94a7d2e3511d7b42c217b0c0953e25a2.600x338.jpg?t=1766024693"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/e15cafba79204b1a6c71a5e7d76fe42b6ec8df99/ss_e15cafba79204b1a6c71a5e7d76fe42b6ec8df99.1920x1080.jpg?t=1766024693","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/e15cafba79204b1a6c71a5e7d76fe42b6ec8df99/ss_e15cafba79204b1a6c71a5e7d76fe42b6ec8df99.600x338.jpg?t=1766024693"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_6b0fde216e3b14666097c5c197ad532ce267763a.1920x1080.jpg?t=1766024693","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_6b0fde216e3b14666097c5c197ad532ce267763a.600x338.jpg?t=1766024693"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_3c25f5abcc052000c47195da325b5af79b8f58e0.1920x1080.jpg?t=1766024693","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_3c25f5abcc052000c47195da325b5af79b8f58e0.600x338.jpg?t=1766024693"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_9e3f3ed17cf8b9dd03b09fdefe5cfb20dac06e94.1920x1080.jpg?t=1766024693","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_9e3f3ed17cf8b9dd03b09fdefe5cfb20dac06e94.600x338.jpg?t=1766024693"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_f665ae63be41af20ab8ef0c4c71a7c21afa75bce.1920x1080.jpg?t=1766024693","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_f665ae63be41af20ab8ef0c4c71a7c21afa75bce.600x338.jpg?t=1766024693"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_133fea9f7881298c7a0476cdbb903da95c51e941.1920x1080.jpg?t=1766024693","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2989160/ss_133fea9f7881298c7a0476cdbb903da95c51e941.600x338.jpg?t=1766024693"}],"short_description":"Run and jump as fast as you can in this crazy adventure to beat your best score through futuristic platform levels and colorful pixelart, based on speed and strategy development to maximize your score. The competitive speedrun made accessible for everyone, whether it\u2019s speed lovers or chill players!","steam_appid":2989160,"support_info":{"email":"","url":"https://kdt1.webnode.fr"},"supported_languages":"English, French","type":"game","website":"https://kdt1.webnode.fr/"}