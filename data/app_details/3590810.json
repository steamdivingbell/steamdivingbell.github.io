s/steam/apps/3590810/eb73915c4d80f3427c9cc838fb072b9b460c76c9/ss_eb73915c4d80f3427c9cc838fb072b9b460c76c9.600x338.jpg?t=1745076410"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3590810/300fe3d7fee9d6cb1217dd23e134f3270ff16d01/ss_300fe3d7fee9d6cb1217dd23e134f3270ff16d01.1920x1080.jpg?t=1745076410","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3590810/300fe3d7fee9d6cb1217dd23e134f3270ff16d01/ss_300fe3d7fee9d6cb1217dd23e134f3270ff16d01.600x338.jpg?t=1745076410"}],"short_description":"The deckbuilding roguelike with tile-based energy. Strategically position powerful magic sigils, use tile adjacency to create overpowered combos, and seal away the Astral Titans to save the universe from calamity!","steam_appid":3590810,"support_info":{"email":"moonsigilatlas@gmail.com","url":""},"supported_languages":"English","type":"demo","website":null}