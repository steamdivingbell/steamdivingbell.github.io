steamstatic.com/store_item_assets/steam/apps/3570000/54e8d3f1212e76e7cb2ede4498e421e36c5044c7/ss_54e8d3f1212e76e7cb2ede4498e421e36c5044c7.600x338.jpg?t=1749474674"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570000/c749869f29493a859afd81b2e4d169b71c43f98e/ss_c749869f29493a859afd81b2e4d169b71c43f98e.1920x1080.jpg?t=1749474674","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570000/c749869f29493a859afd81b2e4d169b71c43f98e/ss_c749869f29493a859afd81b2e4d169b71c43f98e.600x338.jpg?t=1749474674"}],"short_description":"Cosmic horror experience with liminal elements - you'll wander in an abandoned amusement park, walk along empty tunnels and crawl through narrow corridors. Join a ride and step into the dark. Explore eerie remains of a world that shouldn't exist. Find clues and discover the truth.","steam_appid":3570000,"support_info":{"email":"i.madunic@rsitech.dev","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}