mstatic.com/store_item_assets/steam/apps/3541100/d481e0992c4082d7dee449b4db264b0fc0bd3a16/ss_d481e0992c4082d7dee449b4db264b0fc0bd3a16.600x338.jpg?t=1771770965"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/8072707b090398f7042268ff2f04adbe313f773f/ss_8072707b090398f7042268ff2f04adbe313f773f.1920x1080.jpg?t=1771770965","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/8072707b090398f7042268ff2f04adbe313f773f/ss_8072707b090398f7042268ff2f04adbe313f773f.600x338.jpg?t=1771770965"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/0bc906fa017531584555a7b0e93e89d1886230ee/ss_0bc906fa017531584555a7b0e93e89d1886230ee.1920x1080.jpg?t=1771770965","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/0bc906fa017531584555a7b0e93e89d1886230ee/ss_0bc906fa017531584555a7b0e93e89d1886230ee.600x338.jpg?t=1771770965"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/a77d843f38bba55d47d5d2a139f71301e1b00ae7/ss_a77d843f38bba55d47d5d2a139f71301e1b00ae7.1920x1080.jpg?t=1771770965","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/a77d843f38bba55d47d5d2a139f71301e1b00ae7/ss_a77d843f38bba55d47d5d2a139f71301e1b00ae7.600x338.jpg?t=1771770965"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/9902348db7172dfbe5eaf79cd2a93b9fb01d6701/ss_9902348db7172dfbe5eaf79cd2a93b9fb01d6701.1920x1080.jpg?t=1771770965","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/9902348db7172dfbe5eaf79cd2a93b9fb01d6701/ss_9902348db7172dfbe5eaf79cd2a93b9fb01d6701.600x338.jpg?t=1771770965"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541100/ss_c7d37ebff4e24ddd473596c58bd237d7d06e9853.1920x1080.jpg?t=1771770965","path_thumbnail