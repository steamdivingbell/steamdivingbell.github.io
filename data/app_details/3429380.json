.jpg?t=1773938718"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3429380/c4e22d6969cf1e9f501ad4b84074a10d0bd9d4df/ss_c4e22d6969cf1e9f501ad4b84074a10d0bd9d4df.1920x1080.jpg?t=1773938718","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3429380/c4e22d6969cf1e9f501ad4b84074a10d0bd9d4df/ss_c4e22d6969cf1e9f501ad4b84074a10d0bd9d4df.600x338.jpg?t=1773938718"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3429380/44df2ae17da4418dc123a4a35d5bc60a598d22bc/ss_44df2ae17da4418dc123a4a35d5bc60a598d22bc.1920x1080.jpg?t=1773938718","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3429380/44df2ae17da4418dc123a4a35d5bc60a598d22bc/ss_44df2ae17da4418dc123a4a35d5bc60a598d22bc.600x338.jpg?t=1773938718"}],"short_description":"Buy the broken. Arm the damned. Send them to die.A dark roguelike where mercenaries fight, bleed, and fall for your gain.","steam_appid":3429380,"support_info":{"email":"observerofsin@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}