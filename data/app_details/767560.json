ed loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/767560/extras/2b0a8034ad7f66e5108e3739784e0c87.poster.avif?t=1769431269\" width=600 height=320 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/767560/extras/2b0a8034ad7f66e5108e3739784e0c87.webm?t=1769431269\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/767560/extras/2b0a8034ad7f66e5108e3739784e0c87.mp4?t=1769431269\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">Good hunting, Commander!</p><p class=\"bb_paragraph\" >Note: War Robots requires a stable internet connection for the best gameplay experience.</p>","developers":["MY.GAMES"],"genres":[{"description":"Action","id":"1"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/767560/bd75187ba4ad9a4fc25b6ef55f45542a0be5334f/header.jpg?t=1769431269","is_free":true,"legal_notice":"\u00a9 2025 MY.GAMES HOLDINGS LTD. All rights reserved. All trademarks are the property of their respective owners.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/767560/1269233789/c69b885a87f7033d1269ec2b95d44e27ddd7caba/1765203899/dash_av1.mpd?t=1765205990","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/767560/1269233789/c69b885a87f7033d1269ec2b95d44e27ddd7caba/1765203899/dash_h264.mpd?t=1765205990","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/767560/1269233789/c69b885a87f7033d1269ec2b95d44e27ddd7caba/1765203899/hls_264_m