shared.akamai.steamstatic.com/store_item_assets/steam/apps/2876290/extras/72e7cf7534a9d63c3508837156e66c2c.webm?t=1769764925\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2876290/extras/72e7cf7534a9d63c3508837156e66c2c.mp4?t=1769764925\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Explore hidden pathways and uncover secrets tucked away in the environment.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" > INTERACT WITH THE WORLD</h2><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2876290/extras/f453435ee0055c5f7ce7ff453fe71507.poster.avif?t=1769764925\" width=1170 height=366 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2876290/extras/f453435ee0055c5f7ce7ff453fe71507.webm?t=1769764925\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2876290/extras/f453435ee0055c5f7ce7ff453fe71507.mp4?t=1769764925\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" >As you venture through the world, discover and interact with your surroundings to reveal what lies beneath the surface.</p><p class=\"bb_paragraph\" ></p>","developers":["ReDimension"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2876290/c0dc0c4059841141ee35e60c4a836ba1892baab4/header.jpg?t=1769764925","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2876290/1951956418/2578173b641236f51db38aab5826e9316647b3ee/1758625081/dash_av1.mpd?t=1758626403","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/287