1fade0dd55b62e454972054e826c9958130d2ec/ss_c1fade0dd55b62e454972054e826c9958130d2ec.600x338.jpg?t=1759248387"}],"short_description":"Solve Problems. Make Music. Feel Nourished. Cadence is a minimalist puzzle game about solving circuits to create music. This is not a rhythm game, but a zen music sandbox that rewards curiosity and problem solving.","steam_appid":362800,"support_info":{"email":"support@madewithmonsterlove.com","url":"https://discord.gg/kp9W9Qr"},"supported_languages":"English","type":"game","website":null}