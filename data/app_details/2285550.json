ort_description":"Doloc Town is a cozy pixel-art farming simulation set in a post-apocalyptic world. Build your dream farm from scratch and explore this mysterious wasteland. Harvest, plant, build, and uncover the untold stories of this forgotten land!","steam_appid":2285550,"support_info":{"email":"qa@logoi.net","url":""},"supported_languages":"English, Simplified Chinese","type":"game","website":null}