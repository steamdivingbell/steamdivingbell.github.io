_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/a6e884a57d486b5930a1a599caad1e4761790741/ss_a6e884a57d486b5930a1a599caad1e4761790741.600x338.jpg?t=1773347412"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/f29e31614358411670e8b7a79540e9bf0de60872/ss_f29e31614358411670e8b7a79540e9bf0de60872.1920x1080.jpg?t=1773347412","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/f29e31614358411670e8b7a79540e9bf0de60872/ss_f29e31614358411670e8b7a79540e9bf0de60872.600x338.jpg?t=1773347412"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/01b7bece27f77fc9b8a8686e9bcf09a4cf9a5f0f/ss_01b7bece27f77fc9b8a8686e9bcf09a4cf9a5f0f.1920x1080.jpg?t=1773347412","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/01b7bece27f77fc9b8a8686e9bcf09a4cf9a5f0f/ss_01b7bece27f77fc9b8a8686e9bcf09a4cf9a5f0f.600x338.jpg?t=1773347412"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/b99ca12f0f120c60181d19815b222fd9ae0921ae/ss_b99ca12f0f120c60181d19815b222fd9ae0921ae.1920x1080.jpg?t=1773347412","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/b99ca12f0f120c60181d19815b222fd9ae0921ae/ss_b99ca12f0f120c60181d19815b222fd9ae0921ae.600x338.jpg?t=1773347412"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/69c9737046d4965c13614546818905ef1425333a/ss_69c9737046d4965c13614546818905ef1425333a.1920x1080.jpg?t=1773347412","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/69c9737046d4965c13614546818905ef1425333a/ss_69c9737046d4965c13614546818905ef1425333a.600x338.jpg?t=1773347412"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566480/a722ef8cfde1115511d4d32df43e421e59e1d8c5/ss_a722