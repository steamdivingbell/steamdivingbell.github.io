miliar faces and names. I've carried over the lessons I learned through the release of my first game, so whether you're new to the A:H universe or a Virtual-slaying Veteran, I hope you'll enjoy this one as well!</p><p class=\"bb_paragraph\" >- Sto</p>","developers":["Stove Powered Games"],"dlc":[3337300],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3068670/header.jpg?t=1763586094","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 1.1 GHz Processor<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3068670/431746634/53bf07fe261f3682adc9b45f2b72bed8b48271b3/1763585284/dash_av1.mpd?t=1763586051","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3068670/431746634/53bf07fe261f3682adc9b45f2b72bed8b48271b3/1763585284/dash_h264.mpd?t=1763586051","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3068670/431746634/53bf07fe261f3682adc9b45f2b72bed8b48271b3/1763585284/hls_264_master.m3u8?t=1763586051","id":257048588,"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257048588/739d5c0ce50e5a2140ca5dcdab50ee45e7fdc18a/movie_600x337.jpg?t=1763586051"}],"name":"Anode Heart: Layer Null","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Anode Heart: Layer Null - $15.99 USD","packageid":1090488,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":1599}],"title":"Buy Anode Heart: Layer Null"}],"packages":[1090