//shared.akamai.steamstatic.com/store_item_assets/steam/apps/3006090/ae9b99a50f1796bdb244de62260d8fff4ee8a0b0/ss_ae9b99a50f1796bdb244de62260d8fff4ee8a0b0.600x338.jpg?t=1762179761"}],"short_description":"A meteor carrying an unknown virus shattered the world\u2019s order. In a desperate bid to stop the catastrophe, humanity assembled its top scientists\u2014and those willing to become test subjects. Can the fate of the world be reversed, or is this merely a final struggle before the end?","steam_appid":3006090,"support_info":{"email":"dr.design503@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Simplified Chinese, Traditional Chinese, Portuguese - Portugal, Korean, Russian, Ukrainian, Polish","type":"game","website":null}