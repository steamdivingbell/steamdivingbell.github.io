ttps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950790/b93a03de80a831027f0577fc6c82a22d006880ca/ss_b93a03de80a831027f0577fc6c82a22d006880ca.1920x1080.jpg?t=1772894569","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950790/b93a03de80a831027f0577fc6c82a22d006880ca/ss_b93a03de80a831027f0577fc6c82a22d006880ca.600x338.jpg?t=1772894569"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950790/b65b5d8ed37e82471b51e836d495d04e1b0a1ad6/ss_b65b5d8ed37e82471b51e836d495d04e1b0a1ad6.1920x1080.jpg?t=1772894569","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950790/b65b5d8ed37e82471b51e836d495d04e1b0a1ad6/ss_b65b5d8ed37e82471b51e836d495d04e1b0a1ad6.600x338.jpg?t=1772894569"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950790/f52a85e43a79b31689cf76809e41326ce4009959/ss_f52a85e43a79b31689cf76809e41326ce4009959.1920x1080.jpg?t=1772894569","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950790/f52a85e43a79b31689cf76809e41326ce4009959/ss_f52a85e43a79b31689cf76809e41326ce4009959.600x338.jpg?t=1772894569"}],"short_description":"IRON NEST is a brutal dieselpunk heavy-artillery game where you dominate the battlefield through a colossal war machine. Take map measurements based on the received coordinates, strain the hydraulics, and gunlay the cannons to unleash devastating blows \u27f9 Will you obey High Command, Operator?","steam_appid":2950790,"support_info":{"email":"info@ironnestgame.com","url":""},"supported_languages":"English<strong>*</strong>, Spanish - Spain<strong>*</strong>, Russian<strong>*</strong>, Simplified Chinese<strong>*</strong>, Polish<strong>*</strong>, Italian<strong>*</strong>, French<strong>*</strong>, German<strong>*</strong>, Czech<strong>*</strong>, Dutch<strong>*</strong>, Hungarian<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Portug