/apps/3096320/b2f9bf3572588be2fa5905884646a5ee58c33acc/ss_b2f9bf3572588be2fa5905884646a5ee58c33acc.600x338.jpg?t=1773105325"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3096320/349850ab8251dde475c989c0692824b3e364ca15/ss_349850ab8251dde475c989c0692824b3e364ca15.1920x1080.jpg?t=1773105325","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3096320/349850ab8251dde475c989c0692824b3e364ca15/ss_349850ab8251dde475c989c0692824b3e364ca15.600x338.jpg?t=1773105325"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3096320/0cc778d46867a3b45205fb68c8429107b0b6498a/ss_0cc778d46867a3b45205fb68c8429107b0b6498a.1920x1080.jpg?t=1773105325","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3096320/0cc778d46867a3b45205fb68c8429107b0b6498a/ss_0cc778d46867a3b45205fb68c8429107b0b6498a.600x338.jpg?t=1773105325"}],"short_description":"A post apocalyptic turn-based strategy game. Permanent death is a primary mechanic, with unique events being unlocked depending on how you play the game. Your choices matter, and affect the lives of your party members. Death and Tactics is a game where your individual adventure is truly unique!","steam_appid":3096320,"support_info":{"email":"deathandtactics@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}