/3525890/93f7e069c280202db7baec3ec5ac31d2a64f8f49/ss_93f7e069c280202db7baec3ec5ac31d2a64f8f49.600x338.jpg?t=1770648435"}],"short_description":"Future Vibe Check is a musical automation game where your factories don\u2019t just produce goods\u2014they make music. Summoned by Infinity, you must rebuild reality. The call of endless optimization will be sublimated into sound. Automate the Vibe. Defend the Vibe. Become the Vibe.","steam_appid":3525890,"support_info":{"email":"support@akuparagames.com","url":"https://bugs.akuparagames.com/"},"supported_languages":"English","type":"game","website":"https://www.futurevibecheck.com/"}