roller support</p></li><li><p class=\"bb_paragraph\" >Enhanced textures, lighting effects, and view distance</p></li><li><p class=\"bb_paragraph\" >Community-driven fixes and improved  stability</p></li></ul>","developers":["SparklingBit","Funatics","Nukklear"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3906660/6ff3c78886e50143c1c80812188dd6748b855d3b/header.jpg?t=1763043038","is_free":false,"legal_notice":"\u00a92025 THQ NORDIC AB. Sacred 2 Remaster is developed by Jumpgate AB and SparklingBit, and published by THQ Nordic\u2122 GmbH. Sacred\u2122, THQ\u2122 and THQ Nordic\u2122 are trademarks of THQ Nordic\u2122 AB, Sweden. All related other marks, trademarks, logos, and copyrights are the exclusive property of their respective owners. All rights reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3906660/648371787/86626e8133e38685407d8bc6a90fa8c55ef54e4b/1762943349/dash_av1.mpd?t=1763043036","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3906660/648371787/86626e8133e38685407d8bc6a90fa8c55ef54e4b/1762943349/dash_h264.mpd?t=1763043036","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3906660/648371787/86626e8133e38685407d8bc6a90fa8c55ef54e4b/1762943349/hls_264_master.m3u8?t=1763043036","id":257229981,"name":"Sacred 2 Remaster Launch Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257229981/3cc4662a93d614365e6d62ed53f2e6e953397770/movie_600x337.jpg?t=1763043036"},{"dash_a