_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499700/f3eae2bd86d66ec6fbe3ace98ca5c152297f7fc7/ss_f3eae2bd86d66ec6fbe3ace98ca5c152297f7fc7.600x338.jpg?t=1744912019"}],"short_description":"Santherya Uprising is a deck-building game where tactics, timing, and upgrades play a crucial role. Cards cost fatigue instead of mana, the higher the cost, the later that character will play its next turn. Recruit heroes, build up their decks, and empower them with the magic of powerful orbs.","steam_appid":3499700,"support_info":{"email":"support@santherya.com","url":""},"supported_languages":"English<strong>*</strong>, Italian<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.santherya.com/"}