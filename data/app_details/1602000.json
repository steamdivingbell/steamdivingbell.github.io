eam/apps/1602000/e6557c2975bacc111713d1eabba6bf347bee45ad/ss_e6557c2975bacc111713d1eabba6bf347bee45ad.1920x1080.jpg?t=1758702555","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1602000/e6557c2975bacc111713d1eabba6bf347bee45ad/ss_e6557c2975bacc111713d1eabba6bf347bee45ad.600x338.jpg?t=1758702555"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1602000/d1e3c0b6156ffb3110a9d5db5241e25b4c4604c9/ss_d1e3c0b6156ffb3110a9d5db5241e25b4c4604c9.1920x1080.jpg?t=1758702555","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1602000/d1e3c0b6156ffb3110a9d5db5241e25b4c4604c9/ss_d1e3c0b6156ffb3110a9d5db5241e25b4c4604c9.600x338.jpg?t=1758702555"}],"short_description":"Creativity meets chaos in Hotel Architect, an endlessly replayable hotel construction and tycoon management game. Design and build grand hotels across the globe, juggle the elaborate demands of disorderly guests, manage a variety of staff types, and impress critics in order to earn a 5 star rating.","steam_appid":1602000,"support_info":{"email":"support@wiredproductions.com","url":"https://wiredproductions.com/contact/"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Korean, Portuguese - Brazil, Russian, Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://hotelarchitectgame.com/"}