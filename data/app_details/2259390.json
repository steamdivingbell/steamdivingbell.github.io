ea774e429d6997b73f6efdc4314.600x338.jpg?t=1752893215"},{"id":19,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2259390/e5ea61d031133025df2b7d10db09476f9a03fb1a/ss_e5ea61d031133025df2b7d10db09476f9a03fb1a.1920x1080.jpg?t=1752893215","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2259390/e5ea61d031133025df2b7d10db09476f9a03fb1a/ss_e5ea61d031133025df2b7d10db09476f9a03fb1a.600x338.jpg?t=1752893215"}],"short_description":"A fast paced, super stylised, roguelite, twin stick shooter. Nine levels of hand painted, procedurally generated, punchy and punky mayhem in a uniquely stunning attitude filled world.","steam_appid":2259390,"support_info":{"email":"support@nineroundsrapid.com","url":"www.nineroundsrapid.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://www.nineroundsrapid.com"}