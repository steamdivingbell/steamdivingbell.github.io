/fb95852598d2cd8775d99a62cbc9dec2c90b75c3/ss_fb95852598d2cd8775d99a62cbc9dec2c90b75c3.600x338.jpg?t=1772792924"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3354230/ba02860a66f4151b5a0ee3001c917811360b18be/ss_ba02860a66f4151b5a0ee3001c917811360b18be.1920x1080.jpg?t=1772792924","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3354230/ba02860a66f4151b5a0ee3001c917811360b18be/ss_ba02860a66f4151b5a0ee3001c917811360b18be.600x338.jpg?t=1772792924"}],"short_description":"AVROPOLIS is a VR action-adventure historical fantasy game with puzzle elements. Explore ancient, mystery-filled atmospheric environments using a physics-based controller that allows different play-styles. Prepare for a once-in-a-lifetime adventure full of discovery and action!","steam_appid":3354230,"support_info":{"email":"giardinamarco@proton.me","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}