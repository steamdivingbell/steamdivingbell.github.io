port development please wishlist the game to help us reach more audience. A discord server will be online soon for further development updates.</u></i></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3607330/extras/0abe0bddaccfdf946bca79f773db7145.poster.avif?t=1773597346\" width=472 height=74 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3607330/extras/0abe0bddaccfdf946bca79f773db7145.webm?t=1773597346\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3607330/extras/0abe0bddaccfdf946bca79f773db7145.mp4?t=1773597346\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Studio Baron Rouge"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3607330/13f450802cf8113b9d3c836d0add4c9248a8a100/header.jpg?t=1773597346","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3607330/1392298606/7a25792ab5ea958d6a0220e45eb3d9028719ee55/1760053037/dash_av1.mpd?t=1761023920","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3607330/1392298606/7a25792ab5ea958d6a0220e45eb3d9028719ee55/1760053037/dash_h264.mpd?t=1761023920","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3607330/1392298606/7a25792ab5