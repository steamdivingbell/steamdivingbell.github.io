mg_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3464020/extras/2a74cf888963a01d477427517aae74fa.avif?t=1754555661\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3464020/extras_big/2a74cf888963a01d477427517aae74fa.avif?t=1754555661 width=800 height=450 /></span></p><p class=\"bb_paragraph\" >Free release of works for commercial use</p><p class=\"bb_paragraph\" >Do you want to publish your game achievements? The software provides a work export function, and the exported packages have strong cross platform compatibility. You can easily deploy the game to multiple platforms for publishing and create revenue with creativity!</p><p class=\"bb_paragraph\" >*The program is on beta version. Some functions are to be further improved.</p>","developers":["Schelling Point"],"genres":[{"description":"Design & Illustration","id":"53"},{"description":"Utilities","id":"57"},{"description":"Video Production","id":"58"},{"description":"Game Development","id":"60"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3464020/b22c83e39408f5adab9957b74d13619e1e1372c5/header.jpg?t=1754555661","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> </li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> </li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3464020/27937086/97d64a22458c71f3cdff36326e2cda73895a05ea/1750338578/dash_av1.mpd?t=1750339796","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3464020/27937086/97d64a22458c71f3cdff36326e2cda73895a05ea/1750338578/dash_h264.mpd?t=1750339796","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3464020/27937086/97d64a22458c71f3cdff36326e2cda73895a05ea/1750338578/hls_264_master.m3u8?t=1750339796","id":257149369,"name