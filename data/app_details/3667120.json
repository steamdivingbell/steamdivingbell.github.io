.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/0e6b8688731165954c879c3640e155287a00ebe2/ss_0e6b8688731165954c879c3640e155287a00ebe2.600x338.jpg?t=1767359685"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/fb0381748b84d4c2d77a9e7768c4b802ca7f1485/ss_fb0381748b84d4c2d77a9e7768c4b802ca7f1485.1920x1080.jpg?t=1767359685","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/fb0381748b84d4c2d77a9e7768c4b802ca7f1485/ss_fb0381748b84d4c2d77a9e7768c4b802ca7f1485.600x338.jpg?t=1767359685"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/15491df1a10406458f38839fc8f2d961f6899544/ss_15491df1a10406458f38839fc8f2d961f6899544.1920x1080.jpg?t=1767359685","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/15491df1a10406458f38839fc8f2d961f6899544/ss_15491df1a10406458f38839fc8f2d961f6899544.600x338.jpg?t=1767359685"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/dfe5f637ce5899860e8205eb7c6d87264e05c9db/ss_dfe5f637ce5899860e8205eb7c6d87264e05c9db.1920x1080.jpg?t=1767359685","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/dfe5f637ce5899860e8205eb7c6d87264e05c9db/ss_dfe5f637ce5899860e8205eb7c6d87264e05c9db.600x338.jpg?t=1767359685"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/c0ee7219178de6cbc918c444f2669ad782698e7e/ss_c0ee7219178de6cbc918c444f2669ad782698e7e.1920x1080.jpg?t=1767359685","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3667120/c0ee7219178de6cbc918c444f2669ad782698e7e/ss_c0ee7219178de6cbc918c444f2669ad782698e7e.600x338.jpg?t=1767359685"}],"short_description":"A weaponless psychological thriller. Become trapped in the dark simulation within Gabriel\u2019s mind after surviving a deadly plane crash. Run, hide, and piece together your memories to wake from this dystopian nightmare before Protocol 66 is activated.","steam_appid":3667120,"support_info":{"email":"info@nebulanovagames.com","url":"https://nebulanovagames.com/"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Arabic, Simplified Chinese, Portuguese - Brazil, Danish, Indonesian, Dutch, Finnish, Traditional Chinese, Japanese, Korean, Spanish - Latin America, Polish, Portuguese - Portugal, Russian, Thai, Turkish, Ukrainian, Greek, Swedish, Bangla, Hindi, Catalan<br><strong>*</strong>languages with full audio support","type":"game","website":"https://nebulanovagames.com/"}