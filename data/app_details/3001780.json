/3001780/ss_96dbab8fd463aed7c28828780cd33f7e78d51914.600x338.jpg?t=1742206458"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3001780/ss_7bcb448449ed958f6541eec4c1a59070da093add.1920x1080.jpg?t=1742206458","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3001780/ss_7bcb448449ed958f6541eec4c1a59070da093add.600x338.jpg?t=1742206458"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3001780/ss_ba5db25dabdc22732d590b80bb99a26171c711c4.1920x1080.jpg?t=1742206458","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3001780/ss_ba5db25dabdc22732d590b80bb99a26171c711c4.600x338.jpg?t=1742206458"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3001780/ss_a6ef4a830c8ade2b624d96c6883e492aac153db4.1920x1080.jpg?t=1742206458","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3001780/ss_a6ef4a830c8ade2b624d96c6883e492aac153db4.600x338.jpg?t=1742206458"}],"short_description":"This is a platform jumping game, you can obtain different abilities by transforming between solid, liquid, and steam three forms, thus crossing obstacles and solving puzzles. The workshop allows you design and share their own created maps with the players all around the world.","steam_appid":3001780,"support_info":{"email":"DawningGame@qq.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese, Indonesian, Thai, Portuguese - Portugal, Spanish - Spain","type":"game","website":"https://www.taptap.cn/app/247785"}