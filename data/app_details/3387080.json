static.com/store_item_assets/steam/apps/3387080/ss_fa82d8f29b47e8a4616d78f2d70748415c32447b.1920x1080.jpg?t=1742815102","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3387080/ss_fa82d8f29b47e8a4616d78f2d70748415c32447b.600x338.jpg?t=1742815102"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3387080/ss_607b50e93210e8d2ea47728e60db0420784df206.1920x1080.jpg?t=1742815102","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3387080/ss_607b50e93210e8d2ea47728e60db0420784df206.600x338.jpg?t=1742815102"}],"short_description":"Build a vertical city in a world of a tower. Lead the dwellers to gather resources from the sky and build upwards. Make vertical transport and climbs up. Explore the creatures and sceneries in higher skies.","steam_appid":3387080,"support_info":{"email":"stargategamesinc@gmail.com","url":""},"supported_languages":"English, Simplified Chinese","type":"demo","website":null}