":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845650/fb4f0b73f25e16c5c0e46e974989ec2b201c617f/ss_fb4f0b73f25e16c5c0e46e974989ec2b201c617f.600x338.jpg?t=1758789940"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845650/a6c55eb41ef6892117f11cd684e7628509730df1/ss_a6c55eb41ef6892117f11cd684e7628509730df1.1920x1080.jpg?t=1758789940","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845650/a6c55eb41ef6892117f11cd684e7628509730df1/ss_a6c55eb41ef6892117f11cd684e7628509730df1.600x338.jpg?t=1758789940"}],"short_description":"Pick your hero and team up with other players to fight back the creeping evil in Majjam, a poetic multiplayer adventure where music is magic. Explore a dynamic environment responding to melody, defeat evil with your magical instrument, and jam in real time with friends to restore what was lost.","steam_appid":3845650,"support_info":{"email":"contact@opusmajor.io","url":"https://www.majjam.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.majjam.com/"}