mstatic.com/store_item_assets/steam/apps/3986350/extras/1f123ec0b13f1b6c061f3d25b89f06af.mp4?t=1760888057\" type=\"video/mp4\"></video></span></p>","developers":["Shero"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3986350/1ae43763ff524e293d5ceee202633483778ec15e/header.jpg?t=1760888057","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Frogshot","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 / 11 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3-2100 / AMD FX-4100 or better<br></li><li><strong>Memory:</strong> 512 MB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 650 / HD 7770 or better<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 300 MB available space<br></li><li><strong>Sound Card:</strong> any<br></li><li><strong>Additional Notes:</strong> Should run on potato (low end pc)</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 / 11 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i5-2500 / AMD Ryzen 3 1200 or better<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 750 Ti / GTX 950 or better<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 500 MB available space<br></li><li><strong>Sound Card:</strong> any</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Shero"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Coming soon"},"required_age":0,"screenshots":[{