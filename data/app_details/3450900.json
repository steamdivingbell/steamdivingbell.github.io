_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/7c05f492b674f347c14037d846b0f765caa7d403/ss_7c05f492b674f347c14037d846b0f765caa7d403.1920x1080.jpg?t=1758065115","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/7c05f492b674f347c14037d846b0f765caa7d403/ss_7c05f492b674f347c14037d846b0f765caa7d403.600x338.jpg?t=1758065115"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/92f67a787626058a2486bd12de1394ee26020453/ss_92f67a787626058a2486bd12de1394ee26020453.1920x1080.jpg?t=1758065115","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/92f67a787626058a2486bd12de1394ee26020453/ss_92f67a787626058a2486bd12de1394ee26020453.600x338.jpg?t=1758065115"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/729b84544d5550e470c2e424e1d4b41ab6127483/ss_729b84544d5550e470c2e424e1d4b41ab6127483.1920x1080.jpg?t=1758065115","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/729b84544d5550e470c2e424e1d4b41ab6127483/ss_729b84544d5550e470c2e424e1d4b41ab6127483.600x338.jpg?t=1758065115"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/186c8e9a5fb4cbf952c09e051b03dfc89d784126/ss_186c8e9a5fb4cbf952c09e051b03dfc89d784126.1920x1080.jpg?t=1758065115","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/186c8e9a5fb4cbf952c09e051b03dfc89d784126/ss_186c8e9a5fb4cbf952c09e051b03dfc89d784126.600x338.jpg?t=1758065115"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/f541d79b182fd893e09a844ccaf68879764ae798/ss_f541d79b182fd893e09a844ccaf68879764ae798.1920x1080.jpg?t=1758065115","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/f541d79b182fd893e09a844ccaf68879764ae798/ss_f541d79b182