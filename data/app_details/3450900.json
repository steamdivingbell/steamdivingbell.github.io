assets/steam/apps/3450900/186c8e9a5fb4cbf952c09e051b03dfc89d784126/ss_186c8e9a5fb4cbf952c09e051b03dfc89d784126.1920x1080.jpg?t=1768750103","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/186c8e9a5fb4cbf952c09e051b03dfc89d784126/ss_186c8e9a5fb4cbf952c09e051b03dfc89d784126.600x338.jpg?t=1768750103"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/e2cad9e0a25be046bffbe47db81868866b3fb82c/ss_e2cad9e0a25be046bffbe47db81868866b3fb82c.1920x1080.jpg?t=1768750103","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/e2cad9e0a25be046bffbe47db81868866b3fb82c/ss_e2cad9e0a25be046bffbe47db81868866b3fb82c.600x338.jpg?t=1768750103"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/6f3e56744ee08fcae8b2151dab3340f80537815e/ss_6f3e56744ee08fcae8b2151dab3340f80537815e.1920x1080.jpg?t=1768750103","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3450900/6f3e56744ee08fcae8b2151dab3340f80537815e/ss_6f3e56744ee08fcae8b2151dab3340f80537815e.600x338.jpg?t=1768750103"}],"short_description":"In a world crawling with colossal beings, a boy named Nero sets out on a journey to find the missing girl, Snoa. Use a variety of movement abilities and the surrounding environment to push forward, and at times confront overwhelming horrors, in this cinematic puzzle-platformer, DOSMIC.","steam_appid":3450900,"support_info":{"email":"contact@blackcheeze.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Russian, Swedish, Spanish - Latin America, Japanese, Simplified Chinese, Traditional Chinese, Portuguese - Brazil, Polish, Korean","type":"game","website":"https://www.blackcheeze.com/"}