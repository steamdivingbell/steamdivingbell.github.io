=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3435110/extras/62906de1d388ee67b978fbd2582d8a34.poster.avif?t=1773919845\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3435110/extras/62906de1d388ee67b978fbd2582d8a34.webm?t=1773919845\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3435110/extras/62906de1d388ee67b978fbd2582d8a34.mp4?t=1773919845\" type=\"video/mp4\"></video></span></p>","developers":["YOLO35GAMES"],"genres":[{"description":"Adventure","id":"25"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3435110/fbfae0170344fafc7b288a89fad74e5f9665fdc1/header.jpg?t=1773919845","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 11 (Big Sur) or later<br></li><li><strong>Processor:</strong> Any Intel or Apple Silicon processor<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3435110/561660542/cdf199991feda2e50b46ec62b320773252fcc9c0/1770156107/dash_av1.mpd?t=1770157335","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3435110/561660542/cdf199991feda2e50b46ec62b320773252fcc9c0/1770156107/dash_h264.mpd?t=1770157335","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3435110/561660542/cdf199991feda2e50b46ec62b320773252fcc9c0/1770156107/hls_264_master.m3u8?t=1770157335","id":257094113,"name":"Announcement Trailer","thumbnail":"https