?t=1764096717\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020020/extras/dbcd500ad340814bcdaf19841ac50727.poster.avif?t=1764096717\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020020/extras/dbcd500ad340814bcdaf19841ac50727.webm?t=1764096717\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p>","achievements":{"total":0},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/4020020?t=1764096717","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020020/e186a7be6b9b8cd384b653097c4461fe100bc12c/page_bg_raw.jpg?t=1764096717","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020020/2b0716c27c464d5f555240e5ad597a557143fb7e/capsule_231x87.jpg?t=1764096717","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020020/2b0716c27c464d5f555240e5ad597a557143fb7e/capsule_184x69.jpg?t=1764096717","categories":[{"description":"Single-player","id":2},{"description":"Full controller support","id":28},{"description":"Stereo Sound","id":69},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[5],"notes":"Presence of blood in some scenes, constant allusions to death and murder, presence of monsters, and mild body horror. Non-graphic death of the main character upon losing the game."},"controller_support":"full","demos":[{"appid":4026940,"description":""},{"appid":4026940,"description":""}],"detailed_description":"<p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/