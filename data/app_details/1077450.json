://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1077450/ss_1716c2bd08ac46aa0055f034e7ef39cce2971e5c.1920x1080.jpg?t=1693940978","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1077450/ss_1716c2bd08ac46aa0055f034e7ef39cce2971e5c.600x338.jpg?t=1693940978"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1077450/ss_a8dc5be143a119755b33f87d9dd44a61021ffdea.1920x1080.jpg?t=1693940978","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1077450/ss_a8dc5be143a119755b33f87d9dd44a61021ffdea.600x338.jpg?t=1693940978"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1077450/ss_e4d389a497574ddd7f1236ad543b2f2874e736f6.1920x1080.jpg?t=1693940978","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1077450/ss_e4d389a497574ddd7f1236ad543b2f2874e736f6.600x338.jpg?t=1693940978"}],"short_description":"Your best friend wants to cheer you up, so he tries his best to make a dungeon for you to explore. Explore his wholesome, weird-as-heck, scrappy rogue-lite oozing with charm and humor for 1-2 Players.","steam_appid":1077450,"support_info":{"email":"","url":"https://discord.gg/wally"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Portugal, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America, Traditional Chinese","type":"game","website":null}