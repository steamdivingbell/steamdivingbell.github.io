030/ss_88e278a919fd4bc1f576d6a398d9c5a86844ab9d.600x338.jpg?t=1757927077"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3265030/ss_38ac17211059010f696419cceb03c920f0191889.1920x1080.jpg?t=1757927077","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3265030/ss_38ac17211059010f696419cceb03c920f0191889.600x338.jpg?t=1757927077"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3265030/ss_cd10cd6fd0d6cdf582b8e1616751b8b5743f6012.1920x1080.jpg?t=1757927077","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3265030/ss_cd10cd6fd0d6cdf582b8e1616751b8b5743f6012.600x338.jpg?t=1757927077"}],"short_description":"Guide Jim on a heartfelt journey to find peace and balance amidst life's struggles. In Path to Serenity, a cozy walking simulator, explore levels with interactive and soothing elements, accompanied by calming sounds. Walk alongside Jim as he begins a new path towards calm and serenity.","steam_appid":3265030,"support_info":{"email":"silviusoare@luduspaxstudios.uk","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://luduspaxstudios.uk/index.php/home/path-to-serenity-press-release/"}