com/store_item_assets/steam/apps/1989070/27a02af6c0c458e15e13121d99800685390051e3/ss_27a02af6c0c458e15e13121d99800685390051e3.1920x1080.jpg?t=1745317904","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1989070/27a02af6c0c458e15e13121d99800685390051e3/ss_27a02af6c0c458e15e13121d99800685390051e3.600x338.jpg?t=1745317904"}],"short_description":"An ecosystem City Builder in a unique world. Build your settlement, manage your workers and optimize your resources. Analyzing your environment, spreading new plants, and harvesting them are key to prosperity.","steam_appid":1989070,"support_info":{"email":"support@goblinzstudio.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Polish, Russian, Japanese, Korean, Portuguese - Brazil, Simplified Chinese","type":"game","website":"https://goblinzstudio.com/game/synergy/"}