4dc3f519a6f3a08b9577be0cef7fe891d598/ss_2fec4dc3f519a6f3a08b9577be0cef7fe891d598.600x338.jpg?t=1751597105"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3557690/738367ead80cc4498fc4874102e4b98c706350e7/ss_738367ead80cc4498fc4874102e4b98c706350e7.1920x1080.jpg?t=1751597105","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3557690/738367ead80cc4498fc4874102e4b98c706350e7/ss_738367ead80cc4498fc4874102e4b98c706350e7.600x338.jpg?t=1751597105"}],"short_description":"This is an idle-style casual game that appears at the bottom of your screen. In the game, you\u2019ll hire adorable animals to work at the company you\u2019ve founded. You be the boss and make sure they don\u2019t slack off. The earnings can be used to renovate or expand your cozy office.","steam_appid":3557690,"support_info":{"email":"jkdesigns@163.com","url":""},"supported_languages":"English, Simplified Chinese, Japanese, Korean, Traditional Chinese","type":"game","website":null}