indenburg</i> and be captivated by one of the most impressive chapters in aviation history. A must for history and technology enthusiasts!</p><p class=\"bb_paragraph\"><strong>Now available on Steam!</strong></p><p class=\"bb_paragraph\"><strong>Please note:</strong> This DLC requires our VR platform <i>TimeLab</i>, also available on Steam.</p>","developers":["VR-Dynamix"],"fullgame":{"appid":"1490900","name":"TimeLab"},"genres":[{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1491210/52d1f58971dd0fbc2ecce8a44e2940f3190c85ca/header.jpg?t=1742828006","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257117659,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257117659/movie480.mp4?t=1742828003","max":"http://video.akamai.steamstatic.com/store_trailers/257117659/movie_max.mp4?t=1742828003"},"name":"LZ129_Trailer_001","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257117659/a16f623289ee03caf5f9217dbfa89910338b472c/movie_600x337.jpg?t=1742828003","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257117659/movie480_vp9.webm?t=1742828003","max":"http://video.akamai.steamstatic.com/store_trailers/257117659/movie_max_vp9.webm?t=1742828003"}}],"name":"TimeLab: LZ 129 Hindenburg","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":