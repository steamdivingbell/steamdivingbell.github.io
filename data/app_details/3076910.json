pps/3076910/2a9ca8649da5f6a95490a919a64d9618a31fed03/ss_2a9ca8649da5f6a95490a919a64d9618a31fed03.1920x1080.jpg?t=1769489032","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3076910/2a9ca8649da5f6a95490a919a64d9618a31fed03/ss_2a9ca8649da5f6a95490a919a64d9618a31fed03.600x338.jpg?t=1769489032"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3076910/c8519101328f11f8063d2feebe70921ed2f9b17a/ss_c8519101328f11f8063d2feebe70921ed2f9b17a.1920x1080.jpg?t=1769489032","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3076910/c8519101328f11f8063d2feebe70921ed2f9b17a/ss_c8519101328f11f8063d2feebe70921ed2f9b17a.600x338.jpg?t=1769489032"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3076910/a92ff1cb89271b4d4f054b6628279cd44db4ce69/ss_a92ff1cb89271b4d4f054b6628279cd44db4ce69.1920x1080.jpg?t=1769489032","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3076910/a92ff1cb89271b4d4f054b6628279cd44db4ce69/ss_a92ff1cb89271b4d4f054b6628279cd44db4ce69.600x338.jpg?t=1769489032"}],"short_description":"UNDERGROUNDED is a puzzle adventure game that takes you through nostalgic landscapes of America's past. Help a young man travel through an underground maze looking for a lost ring, using the mysterious power of... retro games.","steam_appid":3076910,"support_info":{"email":"support_undergrounded@gamestudio.co.jp","url":""},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese","type":"game","website":null}