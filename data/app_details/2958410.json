play muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2958410/extras/c096a9f8b15b8bfcc5c496da4e2ed164.poster.avif?t=1773279186\" width=780 height=316 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2958410/extras/c096a9f8b15b8bfcc5c496da4e2ed164.webm?t=1773279186\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2958410/extras/c096a9f8b15b8bfcc5c496da4e2ed164.mp4?t=1773279186\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Gear, Lots of Gear:</strong> Equip your survivor using a vast number of upgradeable, customizable items, including clothing for survival, armor for protection, and a broad range of weapons. From the most primitive improvised clubs and flimsy bows to futuristic weapons created at the end of the 21st century, use everything you have in order to survive in this brutal world.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2958410/extras/97afc23cbb28bc0f52a6c9fa8a9b17d0.poster.avif?t=1773279186\" width=780 height=316 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2958410/extras/97afc23cbb28bc0f52a6c9fa8a9b17d0.webm?t=1773279186\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2958410/extras/97afc23cbb28bc0f52a6c9fa8a9b17d0.mp4?t=1773279186\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>VAS Infection Mechanics:</strong> Just because the Newborn are immune, doesn't mean regular humans are. A dynamic infection system means the disease will spread among survivors and it's up to you to manage their symptoms and look for a cure. Use rapid testing kits to identify those infected, then make hard choices when it comes to saving their lives.</p></li><li><p class=\"bb_paragraph\" ><strong>Dystopian Storyline:</strong> Dynamic sandbox gameplay is framed by a dark, dystopian storyline. Advance the fight against AXIOM and figure out the origin of VAS in bespoke quests which can be completed on your own or with your friends as allies, facing a hostile world side by side.</p></li></ul>","developers":["Dodigamestudios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2958410/76f50be43f6448021f615dd7b62c3f9ca97fcdda/header.jpg?t=1773279186","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2958410/775551/7bad5510ce9f2d828c10f8eb5193b9c81c1d9eaf/1750954170/dash_av1.mpd?t=1773277310","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2958410/775551/7bad5510ce9f2d828c10f8eb5193b9c81c1d9eaf/1750954170/dash_h264.mpd?t=1773277310","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2958410/775551/7bad5510ce9f2d828c10f8eb5193b9c81c1d9eaf/1750954170/hls_264_master.m3u8?t=1773277310","id":257067417,"name":"Steam Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257067417/1e540bcd992d3797434aba6d518186b29cab8d13/movie_600x337.jpg?t=1773277310"}],"name":"Rise of The Newborns","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a