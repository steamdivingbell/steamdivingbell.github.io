ras/3e2fbb5310e7116ddf619ab53ce130ba.avif?t=1771949790\" width=625 height=120 /></span></p><p class=\"bb_paragraph\" > Interact with real figures from history, decode secret messages, and uncover stories hidden by censorship. The narrative is inspired by a resistance so unique, UNESCO recognizes it as world heritage.</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2720940/extras/3382ce5fde1fa6076181baca4a73b348.poster.avif?t=1771949790\" width=616 height=308 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2720940/extras/3382ce5fde1fa6076181baca4a73b348.webm?t=1771949790\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2720940/extras/3382ce5fde1fa6076181baca4a73b348.mp4?t=1771949790\" type=\"video/mp4\"></video></span></p>","developers":["FLUXO GAMES"],"genres":[{"description":"Adventure","id":"25"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2720940/55358cf1cd878fe78ec27f04fb0dd60ebb655e99/header.jpg?t=1771949790","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2720940/1808222559/6dbb4e59541d98aa5bdba3e62932600170569166/1771927106/dash_av1.mpd?t=1771949788","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2720940/1808222559/6dbb4e59541d98aa5bdba3e62932600170569166/1771927106/dash_h264.mpd?t=1771949788","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2720940/1808222559/6dbb4e59541d98aa5bdba3e62932600170569166/1771927106/hls_264_master.m3u8?t=1771949788","id":257293558,"name":"Release Trailer (EU LOGO) English","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/ap