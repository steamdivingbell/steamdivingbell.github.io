nerated exploration areas</strong>: larger areas around camp to explore with greater risks and rewards.</p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["truckbot"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976010/24004d09e1fca23162ced3a974c74d1c739f4484/header.jpg?t=1757248362","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires an Apple processor<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core M</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires an Apple processor<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core M</li></ul>"},"movies":[{"highlight":true,"id":257186648,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257186648/movie480.mp4?t=1757187937","max":"http://video.akamai.steamstatic.com/store_trailers/257186648/movie_max.mp4?t=1757187937"},"name":"Survival Tech: Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257186648/4a8891e376fd03a757f349f4ac5f667fcb320448/movie_600x337.jpg?t=1757187937","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257186648/movie480_vp9.webm?t=1757187937","max":"http://video.akamai.steamstatic.com/store_trailers/257186648/movie_max_vp9.webm?t=1757187937"}}],"name":"Survival Tech","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 11</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 11</li></ul>"},"platforms":{"linux":false,"mac":true,"windows":true},"publishers":["truckbot"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors