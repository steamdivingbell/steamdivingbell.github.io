"bb_paragraph\" >Grab your racket and call your friends for the greatest adventure in the world of tennis!</p>","developers":["GRD Lab"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Sports","id":"18"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3406330/bb1d4849737a6ab96b100a9b73356ca29962deb2/header.jpg?t=1767997170","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3406330/619251564/f2afa73ec1defcf67b32321608851046c6f81617/1762565760/dash_av1.mpd?t=1762570303","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3406330/619251564/f2afa73ec1defcf67b32321608851046c6f81617/1762565760/dash_h264.mpd?t=1762570303","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3406330/619251564/f2afa73ec1defcf67b32321608851046c6f81617/1762565760/hls_264_master.m3u8?t=1762570303","id":257228437,"name":"Quacol\u00e9 Tennis - Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257228437/978dd10c81795a8c90eef46db45b9fdb69edcf3e/movie_600x337.jpg?t=1762570303"}],"name":"Quacol\u00e9 Tennis","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (32-Bit)<br></li><li><strong>Processor:</strong> Dual Core 2.4Ghz<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>DirectX:</strong> Version 9.0c<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (64-Bit)<br></li><li><strong>Processor:</strong> Dual Core 3.0Ghz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"w