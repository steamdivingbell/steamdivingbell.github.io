27590/da8e1e9c848d2224141e0ca32dcfa72a8dda00f0/ss_da8e1e9c848d2224141e0ca32dcfa72a8dda00f0.600x338.jpg?t=1771605814"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3327590/ss_5fffe102f3f0334caa00358a47357c5f1c775883.1920x1080.jpg?t=1771605814","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3327590/ss_5fffe102f3f0334caa00358a47357c5f1c775883.600x338.jpg?t=1771605814"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3327590/8241f49d8f88d52e5985024f2d7f1a74b486cc9f/ss_8241f49d8f88d52e5985024f2d7f1a74b486cc9f.1920x1080.jpg?t=1771605814","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3327590/8241f49d8f88d52e5985024f2d7f1a74b486cc9f/ss_8241f49d8f88d52e5985024f2d7f1a74b486cc9f.600x338.jpg?t=1771605814"}],"short_description":"The Confinement is a game that puts your skills to the test. Master precise movements, strategic dashes, and challenging courses. Face more than 30 intense levels, improve your times, and compete for positions in a competitive global ranking. Perfect for players seeking speed and precision.","steam_appid":3327590,"support_info":{"email":"contact@qubyteinteractive.com","url":"https://www.qubyteinteractive.com/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Polish, Portuguese - Brazil, Russian","type":"game","website":null}