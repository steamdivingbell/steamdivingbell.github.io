3410c8d18cd6ffb16af80033163df8fbbed3e/ss_c983410c8d18cd6ffb16af80033163df8fbbed3e.1920x1080.jpg?t=1747582648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3529110/c983410c8d18cd6ffb16af80033163df8fbbed3e/ss_c983410c8d18cd6ffb16af80033163df8fbbed3e.600x338.jpg?t=1747582648"}],"short_description":"Bushcraft Survival\u00a0is an open-world, procedural survival game where you are pitted against the brutalities of nature. It features rogue-lite elements, with permanent skill tree progression. Use your tools and your knowledge to survive in Canada's unforgiving northern climate!","steam_appid":3529110,"support_info":{"email":"m.jared.burt@gmail.com","url":"https://michaeljared.ca/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://michaeljared.ca/"}