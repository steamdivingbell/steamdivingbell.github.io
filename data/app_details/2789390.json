ai.steamstatic.com/store_item_assets/steam/apps/2789390/0ada1bb6b7c31b0991f27a1edcc609904677f69e/ss_0ada1bb6b7c31b0991f27a1edcc609904677f69e.1920x1080.jpg?t=1772542603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/0ada1bb6b7c31b0991f27a1edcc609904677f69e/ss_0ada1bb6b7c31b0991f27a1edcc609904677f69e.600x338.jpg?t=1772542603"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/97848a0ac57324973b190aabf761b6c55aa2d373/ss_97848a0ac57324973b190aabf761b6c55aa2d373.1920x1080.jpg?t=1772542603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/97848a0ac57324973b190aabf761b6c55aa2d373/ss_97848a0ac57324973b190aabf761b6c55aa2d373.600x338.jpg?t=1772542603"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/6ea11332707ec3bce7c9c60b62807a6e84f8cc26/ss_6ea11332707ec3bce7c9c60b62807a6e84f8cc26.1920x1080.jpg?t=1772542603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/6ea11332707ec3bce7c9c60b62807a6e84f8cc26/ss_6ea11332707ec3bce7c9c60b62807a6e84f8cc26.600x338.jpg?t=1772542603"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/c1d19beface67e6b8d6f4acfbabf24c99570bdea/ss_c1d19beface67e6b8d6f4acfbabf24c99570bdea.1920x1080.jpg?t=1772542603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/c1d19beface67e6b8d6f4acfbabf24c99570bdea/ss_c1d19beface67e6b8d6f4acfbabf24c99570bdea.600x338.jpg?t=1772542603"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/6f322540c5c31564bb2dcbe698ab2064cab713b2/ss_6f322540c5c31564bb2dcbe698ab2064cab713b2.1920x1080.jpg?t=1772542603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/6f322540c5c31564bb2dcbe698ab2064cab713b2/ss_6f322540c5c31564bb2dcbe698ab2064cab713b2.600x338.jpg?t=1772542603"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/a91c4813074e479bd1da5223af929ed0ed39f7cf/ss_a91c4813074e479bd1da5223af929ed0ed39f7cf.1920x1080.jpg?t=1772542603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/a91c4813074e479bd1da5223af929ed0ed39f7cf/ss_a91c4813074e479bd1da5223af929ed0ed39f7cf.600x338.jpg?t=1772542603"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/48030fcf3bbe77991ad705e76ad504c3d9904bb1/ss_48030fcf3bbe77991ad705e76ad504c3d9904bb1.1920x1080.jpg?t=1772542603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/48030fcf3bbe77991ad705e76ad504c3d9904bb1/ss_48030fcf3bbe77991ad705e76ad504c3d9904bb1.600x338.jpg?t=1772542603"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/221aae74dd8942ec74be610a05b9f53482037741/ss_221aae74dd8942ec74be610a05b9f53482037741.1920x1080.jpg?t=1772542603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/221aae74dd8942ec74be610a05b9f53482037741/ss_221aae74dd8942ec74be610a05b9f53482037741.600x338.jpg?t=1772542603"}],"short_description":"Greetings, fellow humans. Prove you are a one-pod wonder and tilt the future of YOUR galaxy in OUR favor! Grab a friend (or fly solo) and join our brick-breaking riot. Explore 33 levels, fight 3 bosses and ignore the glitch crystals.","steam_appid":2789390,"support_info":{"email":"contact@deadbugprojects.com","url":"https://www.deadbugprojects.com"},"supported_languages":"English","type":"game","website":"https://www.paddlenoid.com/"}