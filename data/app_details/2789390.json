.600x338.jpg?t=1763983584"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/48030fcf3bbe77991ad705e76ad504c3d9904bb1/ss_48030fcf3bbe77991ad705e76ad504c3d9904bb1.1920x1080.jpg?t=1763983584","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/48030fcf3bbe77991ad705e76ad504c3d9904bb1/ss_48030fcf3bbe77991ad705e76ad504c3d9904bb1.600x338.jpg?t=1763983584"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/221aae74dd8942ec74be610a05b9f53482037741/ss_221aae74dd8942ec74be610a05b9f53482037741.1920x1080.jpg?t=1763983584","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2789390/221aae74dd8942ec74be610a05b9f53482037741/ss_221aae74dd8942ec74be610a05b9f53482037741.600x338.jpg?t=1763983584"}],"short_description":"Paddlenoid is a fun brick breaker game you can play with a friend. There\u2019s nothing out of the ordinary and absolutely no reason to suspect a deeper purpose. Just have a good time and remember to ignore the crystals!","steam_appid":2789390,"support_info":{"email":"contact@deadbugprojects.com","url":"https://www.deadbugprojects.com"},"supported_languages":"English","type":"game","website":"https://www.paddlenoid.com/"}