70080/extras/8b16098c58409f1841c1326be7291a2f.poster.avif?t=1774606296\" width=780 height=390 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3970080/extras/8b16098c58409f1841c1326be7291a2f.webm?t=1774606296\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3970080/extras/8b16098c58409f1841c1326be7291a2f.mp4?t=1774606296\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Let\u2019s go\u2014make those zombies regret crawling out of their graves!</p><p class=\"bb_paragraph\" ></p>","developers":["KungFolio"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3970080/8eae9dcb76a2d0d59110d8effc3e7c74e8603e87/header.jpg?t=1774606296","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3970080/1212041664/b803080af467394166dcd2ec95e29c7992613a92/1769830383/dash_av1.mpd?t=1769831173","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3970080/1212041664/b803080af467394166dcd2ec95e29c7992613a92/1769830383/dash_h264.mpd?t=1769831173","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3970080/1212041664/b803080af467394166dcd2ec95e29c7992613a92/1769830383/hls_264_master.m3u8?t=1769831173","id":257190180,"name":"Demo","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257190180/5f1edc46f4899a1