li><p class=\"bb_paragraph\">Hone your skills against the AI and then compete online or against a friend locally</p></li></ul><p class=\"bb_paragraph\">\u00a0</p><p class=\"bb_paragraph\">Speedball is the continuation of the iconic Bitmap Brothers series, first released in 1988.</p>","developers":["Rebellion"],"drm_notice":"Denuvo Anti-tamper","genres":[{"description":"Action","id":"1"},{"description":"Sports","id":"18"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1795190/270cc463d07854c4fbfa88e87c744214d027e8cb/header.jpg?t=1740746386","is_free":false,"legal_notice":"Speedball\u2122 (and \u00ae in certain territories), Copyright \u00a9 1988, 2024 Rebellion.  All rights reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257069377,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257069377/movie480.mp4?t=1730292265","max":"http://video.akamai.steamstatic.com/store_trailers/257069377/movie_max.mp4?t=1730292265"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257069377/f4f86ec1c17b3924a063302b83ae7a01f9919730/movie_600x337.jpg?t=1730292265","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257069377/movie480_vp9.webm?t=1730292265","max":"http://video.akamai.steamstatic.com/store_trailers/257069377/movie_max_vp9.webm?t=1730292265"}}],"name":"Speedball","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":""