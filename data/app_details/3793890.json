_ul\"><li><p class=\"bb_paragraph\" >Aesthetic:</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3793890/extras/0f71750b44801b53930234dbd150e5b3.poster.avif?t=1768320028\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3793890/extras/0f71750b44801b53930234dbd150e5b3.webm?t=1768320028\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3793890/extras/0f71750b44801b53930234dbd150e5b3.mp4?t=1768320028\" type=\"video/mp4\"></video></span> </p></li></ul><p class=\"bb_paragraph\" ><i>Spend your days in a remote village far from the city.</i> </p><p class=\"bb_paragraph\" ></p>","achievements":{"highlighted":[{"name":"GOOOAL","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3793890/d7b9cdc43a76d722e02275ada0bfe439cac91857.jpg"},{"name":"Babuleh","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3793890/ee8a350084b934d664d7a7495730c567e48e26a7.jpg"},{"name":"Don't stay silent","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3793890/d5f89982bff0a5165da27e370ea5c7ad4e087c84.jpg"},{"name":"Ghosts of the Past","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3793890/b845d8907e670d14bbed6d6dd1946ae59b31d2bf.jpg"}],"total":4},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3793890?t=1768320028","background_raw":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3793890?t=1768320028","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3793890/7e2c415f187782a607d90bfbed629ead5bcaaca0/capsule_231x87.jpg?t=1768320028","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3793890/7e2c415f187782a607d90bfbed6