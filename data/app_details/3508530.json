m/apps/3508530/7c4fa4764fe20a8b36b26989a24eaea06e83affc/ss_7c4fa4764fe20a8b36b26989a24eaea06e83affc.1920x1080.jpg?t=1759753168","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3508530/7c4fa4764fe20a8b36b26989a24eaea06e83affc/ss_7c4fa4764fe20a8b36b26989a24eaea06e83affc.600x338.jpg?t=1759753168"}],"short_description":"A space delivery guy accidentally became your god. Now he's stealing your art and panicking when things go slow. Keep your settlement running and your shady overlord calm in this resource management chaos.","steam_appid":3508530,"support_info":{"email":"studiomonoblok@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://www.monoblokstudio.com"}