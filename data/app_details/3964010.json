/steam/apps/3964010/5643efe6eaafe63e1502f9d320e12f938d7ce8b1/ss_5643efe6eaafe63e1502f9d320e12f938d7ce8b1.1920x1080.jpg?t=1771341083","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3964010/5643efe6eaafe63e1502f9d320e12f938d7ce8b1/ss_5643efe6eaafe63e1502f9d320e12f938d7ce8b1.600x338.jpg?t=1771341083"}],"short_description":"Brutal and punishing survival horror based on fast, repeatable runs. Find keys, unlock routes and escape in under a minute or die trying. Will you be the top performer of Dr Vale's twisted evaluation? Be fast, die lots, but always remember... Mr HappyFunFace is watching.","steam_appid":3964010,"support_info":{"email":"support@bigredeight.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}