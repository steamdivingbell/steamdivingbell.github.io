path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4098180/fa79c98c21db09b0a6bb934445bdf696a535c508/ss_fa79c98c21db09b0a6bb934445bdf696a535c508.1920x1080.jpg?t=1773067515","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4098180/fa79c98c21db09b0a6bb934445bdf696a535c508/ss_fa79c98c21db09b0a6bb934445bdf696a535c508.600x338.jpg?t=1773067515"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4098180/3c8dc234618097824b25664e3fb402b276599be6/ss_3c8dc234618097824b25664e3fb402b276599be6.1920x1080.jpg?t=1773067515","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4098180/3c8dc234618097824b25664e3fb402b276599be6/ss_3c8dc234618097824b25664e3fb402b276599be6.600x338.jpg?t=1773067515"}],"short_description":"My Fantasy Room is a relaxing game about building the fantasy room you've always dreamed of. Realize your design with a huge selection of furniture, appliances, decor, and accessories. Let your creativity flow!","steam_appid":4098180,"support_info":{"email":"ludreumstudio@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Simplified Chinese, Korean, Russian, Japanese, Polish, Portuguese - Portugal, Thai, Turkish, Swedish","type":"game","website":null}