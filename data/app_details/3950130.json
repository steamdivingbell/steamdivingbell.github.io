e1749a8dddbd.1920x1080.jpg?t=1768785734","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950130/39e553b80999e90037d5c1afdb60e1749a8dddbd/ss_39e553b80999e90037d5c1afdb60e1749a8dddbd.600x338.jpg?t=1768785734"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950130/f52275c79a171955d3512d30c8b15b90989fa9ef/ss_f52275c79a171955d3512d30c8b15b90989fa9ef.1920x1080.jpg?t=1768785734","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950130/f52275c79a171955d3512d30c8b15b90989fa9ef/ss_f52275c79a171955d3512d30c8b15b90989fa9ef.600x338.jpg?t=1768785734"}],"short_description":"A new (unpaid) work from home opportunity has opened up in Los Zorangeles! Become the police department\u2019s new Database Detective and help the Minor Crimes Division solve small misdemeanors through the power of SQL queries.","steam_appid":3950130,"support_info":{"email":"thomasdhsu@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}