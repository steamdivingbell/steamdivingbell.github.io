ai.steamstatic.com/store_item_assets/steam/apps/2960760/e80491ca3397f6d8e38c6d5a5b74f13a0d869425/ss_e80491ca3397f6d8e38c6d5a5b74f13a0d869425.600x338.jpg?t=1773084828"}],"short_description":"A real-time roguelite tower defense game about extracting the riches of the forest. Lure creatures to your emitter and mow them down with towers and spells. Build freely, shape your maze, and choose spells that transform how you play.","steam_appid":2960760,"support_info":{"email":"martin_grysbaek@hotmail.com","url":""},"supported_languages":"English<strong>*</strong>, French<strong>*</strong>, German<strong>*</strong>, Japanese<strong>*</strong>, Korean<strong>*</strong>, Polish<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Russian<strong>*</strong>, Simplified Chinese<strong>*</strong>, Spanish - Latin America<strong>*</strong>, Traditional Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}