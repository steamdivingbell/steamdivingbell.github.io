c40c51b1f1071d65d5e6b925aaba1a5e3/ss_a65cf23c40c51b1f1071d65d5e6b925aaba1a5e3.1920x1080.jpg?t=1770760959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/a65cf23c40c51b1f1071d65d5e6b925aaba1a5e3/ss_a65cf23c40c51b1f1071d65d5e6b925aaba1a5e3.600x338.jpg?t=1770760959"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/ss_62f18baa615ffe319f394843ef0a5a8774cd57bb.1920x1080.jpg?t=1770760959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/ss_62f18baa615ffe319f394843ef0a5a8774cd57bb.600x338.jpg?t=1770760959"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/f7de42da6f32428cc15fda4069ce69a89aae3373/ss_f7de42da6f32428cc15fda4069ce69a89aae3373.1920x1080.jpg?t=1770760959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/f7de42da6f32428cc15fda4069ce69a89aae3373/ss_f7de42da6f32428cc15fda4069ce69a89aae3373.600x338.jpg?t=1770760959"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/8a2664883e32a7593e52214c30437bd27b21000e/ss_8a2664883e32a7593e52214c30437bd27b21000e.1920x1080.jpg?t=1770760959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/8a2664883e32a7593e52214c30437bd27b21000e/ss_8a2664883e32a7593e52214c30437bd27b21000e.600x338.jpg?t=1770760959"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/de30a580addbedd4227ce644133adf0f12f9d64c/ss_de30a580addbedd4227ce644133adf0f12f9d64c.1920x1080.jpg?t=1770760959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/de30a580addbedd4227ce644133adf0f12f9d64c/ss_de30a580addbedd4227ce644133adf0f12f9d64c.600x338.jpg?t=1770760959"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/ss_20facc589056a3868fbd38c2352cc507e73a64f1.1920x1080.jpg?t=1770760959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/ss_20facc589056a3868fbd38c2352cc507e73a64f1.600x338.jpg?t=1770760959"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/bd488a8d09400e85bd788a57059759a69bd7665e/ss_bd488a8d09400e85bd788a57059759a69bd7665e.1920x1080.jpg?t=1770760959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1648360/bd488a8d09400e85bd788a57059759a69bd7665e/ss_bd488a8d09400e85bd788a57059759a69bd7665e.600x338.jpg?t=1770760959"}],"short_description":"Luminary is a solo or 3 player co-op Openworld Action RPG that creates a balanced, accessible experience for everyone. Using a unique world and character progression system, explore vast hand-crafted lands together, uncover hidden treasures, level up your town, and push back the darkness with light.","steam_appid":1648360,"support_info":{"email":"","url":"https://discord.gg/NNrurAT5um"},"supported_languages":"English<strong>*</strong>, Simplified Chinese, Russian<br><strong>*</strong>languages with full audio support","type":"game","website":null}