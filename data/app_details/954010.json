010/ss_12ed358c820b9d8d646054d14103f28e8b46897b.1920x1080.jpg?t=1776234142","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/954010/ss_12ed358c820b9d8d646054d14103f28e8b46897b.600x338.jpg?t=1776234142"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/954010/ss_467786d93ae8c8692b0cf953062440e0356900a0.1920x1080.jpg?t=1776234142","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/954010/ss_467786d93ae8c8692b0cf953062440e0356900a0.600x338.jpg?t=1776234142"}],"short_description":"Definitely Sneaky But Not Sneaky is a fast-paced action game featuring tight controls and slow-motion combat. Unlock items, customize your gear, and take out your enemies one by one! Co-op included.","steam_appid":954010,"support_info":{"email":"boxedworks@gmail.com","url":"https://www.reddit.com/r/boxedworksGames/"},"supported_languages":"English","type":"game","website":null}