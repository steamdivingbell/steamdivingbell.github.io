/0ab6341e08024a745836dcdd12a303255fbeadad/ss_0ab6341e08024a745836dcdd12a303255fbeadad.1920x1080.jpg?t=1756128023","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/0ab6341e08024a745836dcdd12a303255fbeadad/ss_0ab6341e08024a745836dcdd12a303255fbeadad.600x338.jpg?t=1756128023"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/58657e02a9f8031ba32847b088a73cc1b80c09f2/ss_58657e02a9f8031ba32847b088a73cc1b80c09f2.1920x1080.jpg?t=1756128023","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/58657e02a9f8031ba32847b088a73cc1b80c09f2/ss_58657e02a9f8031ba32847b088a73cc1b80c09f2.600x338.jpg?t=1756128023"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/4b0d6f09eee97b02ecc8695bfdc74a991b8fc5bf/ss_4b0d6f09eee97b02ecc8695bfdc74a991b8fc5bf.1920x1080.jpg?t=1756128023","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/4b0d6f09eee97b02ecc8695bfdc74a991b8fc5bf/ss_4b0d6f09eee97b02ecc8695bfdc74a991b8fc5bf.600x338.jpg?t=1756128023"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/2ffb3a0b0ffe2d498e6fb4598cb6ec62c540d771/ss_2ffb3a0b0ffe2d498e6fb4598cb6ec62c540d771.1920x1080.jpg?t=1756128023","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/2ffb3a0b0ffe2d498e6fb4598cb6ec62c540d771/ss_2ffb3a0b0ffe2d498e6fb4598cb6ec62c540d771.600x338.jpg?t=1756128023"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/1d7e75fe95c65580b51a4721b799e9357e41080c/ss_1d7e75fe95c65580b51a4721b799e9357e41080c.1920x1080.jpg?t=1756128023","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3954420/1d7e75fe95c65580b51a4721b799e9357e41080c/ss_1d7e75fe95c65580b51a4721b799e9357e41080c.600x338.jpg?t=1756128023"}],"short_description":"Enter the secluded forest village of Bleaklight Falls and join Meelu in his fight to save his home from the encroaching monsters of the Dreadblight. Bolster the Tower Defenses, form bonds with your fellow villagers, and discover the mysteries of the Bleaklight in this engaging Action RPG!","steam_appid":3954420,"support_info":{"email":"bleaklightfalls@gmail.com","url":""},"supported_languages":"English, Simplified Chinese","type":"demo","website":null}