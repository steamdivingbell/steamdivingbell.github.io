ps/3457630/extras/e3ad061963032556819906e4163b0017.mp4?t=1759809246\" type=\"video/mp4\"></video></span><p class=\"bb_paragraph\" >Harness your enemies weaknesses or just overpower them split your armies between melee and ranged or even baits.</p><h2 class=\"bb_tag\" ><strong>Choose your buildings and Dwarves wisely</strong>\u00a0</h2><p class=\"bb_paragraph\" >Choose which units to keep and upgrade the clearer your vision the faster it will become true.</p><h2 class=\"bb_tag\" ></h2>","developers":["Alaabale"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3457630/157055536570fd2f04dc2e0a1a80f0346bd629ca/header.jpg?t=1759809246","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3457630/812268498/d662aec8134cd456c5df1ec7dffd8d3c28e78b98/1759367539/dash_av1.mpd?t=1759439643","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3457630/812268498/d662aec8134cd456c5df1ec7dffd8d3c28e78b98/1759367539/dash_h264.mpd?t=1759439643","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3457630/812268498/d662aec8134cd456c5df1ec7dffd8d3c28e78b98/1759367539/hls_264_master.m3u8?t=1759439643","id":257210433,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257210433/movie480.mp4?t=1759439643","max":"https://video.akamai.steamstatic.com/store_trailers/257210433/movie_max.mp4?t=1759439643"},"name":"Announcement","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257210433/bfcf248a0e6356