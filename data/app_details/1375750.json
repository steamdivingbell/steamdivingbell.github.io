m/store_item_assets/steam/apps/1375750/7e1ecf996dbdbd01faaa6aa8965dc69ce64a08a1/ss_7e1ecf996dbdbd01faaa6aa8965dc69ce64a08a1.1920x1080.jpg?t=1758030869","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1375750/7e1ecf996dbdbd01faaa6aa8965dc69ce64a08a1/ss_7e1ecf996dbdbd01faaa6aa8965dc69ce64a08a1.600x338.jpg?t=1758030869"}],"short_description":"Embark on an explorative RPG hack-and-slash adventure where you attempt to re-establish a haven for the lost dwarven civilization. Journey across varied lands, help those in need, gather resources and fight off goblins and monsters as you slowly rebuild a home for your people.\u00a0","steam_appid":1375750,"support_info":{"email":"contact@gameclaw.io","url":"https://gameclaw.io"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://gameclaw.io"}