</strong> as a core design pillar.\u00a0</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Ganiroo"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132310/13ddde96597d174174c457184c2a76d9d51b79a1/header.jpg?t=1767536877","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Caveshifter","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 or later<br></li><li><strong>Processor:</strong> Core 2 Duo<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> Any, integrated should work fine<br></li><li><strong>Storage:</strong> 1 GB available space<br></li><li><strong>Sound Card:</strong> Yes<br></li><li><strong>Additional Notes:</strong> Subject to change</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Ganiroo"],"ratings":{"dejus":{"descriptors":"Viol\u00eancia","rating":"14","required_age":"14","use_age_gate":"true"},"steam_germany":{"banned":"0","descriptors":"Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132310/e79cec07bf2f97d2df2d77f7d79b3a3a46aa1281/ss_e79cec07bf2f97d2df2d77f7d79b3a3a46aa1281.1920x1080.jpg?t=1767536877","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132310/e79cec07bf2f97d2df2d77f7d79b3a3a46aa1281/ss_e79cec07bf2f97d2df2d77f7d79b3a3a46aa1281.600x338.jpg?t=1767536877"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132310/c320750861dc295804bafcab8b1fa9c807ed0121/ss_c3207