8f83475585573f6643e8cb090e8041ec0a2e/ss_fb308f83475585573f6643e8cb090e8041ec0a2e.1920x1080.jpg?t=1766718076","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2001860/fb308f83475585573f6643e8cb090e8041ec0a2e/ss_fb308f83475585573f6643e8cb090e8041ec0a2e.600x338.jpg?t=1766718076"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2001860/c663f3e95b7798ebc9a2a4f59b66a745c40d61c2/ss_c663f3e95b7798ebc9a2a4f59b66a745c40d61c2.1920x1080.jpg?t=1766718076","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2001860/c663f3e95b7798ebc9a2a4f59b66a745c40d61c2/ss_c663f3e95b7798ebc9a2a4f59b66a745c40d61c2.600x338.jpg?t=1766718076"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2001860/bfdb68f9990049510d5dc78a905c2bf996a76e07/ss_bfdb68f9990049510d5dc78a905c2bf996a76e07.1920x1080.jpg?t=1766718076","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2001860/bfdb68f9990049510d5dc78a905c2bf996a76e07/ss_bfdb68f9990049510d5dc78a905c2bf996a76e07.600x338.jpg?t=1766718076"}],"short_description":"Fishbait is a casual 2\u20134 player card game where one wrong draw sends you straight to the fisherman\u2019s hook. Hidden \u201cBait\u201d cards lurk in the deck, creating a Russian-roulette twist. Push your luck and use clever plays to force your friends into danger and be the last fish swimming!","steam_appid":2001860,"support_info":{"email":"info@yomulabs.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}