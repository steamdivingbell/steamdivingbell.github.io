mai.steamstatic.com/store_item_assets/steam/apps/3600940/caaf6ae4243005d154b4aa733fe49e4cddb26a4d/ss_caaf6ae4243005d154b4aa733fe49e4cddb26a4d.600x338.jpg?t=1758508898"}],"short_description":"This is a medium-high difficulty platform jumping Meta game, and unlike its predecessors in those categories, The biggest feature of this game is that when you fall at high speed, you will bottom out and bounce back. Experience the joy of going up and down.","steam_appid":3600940,"support_info":{"email":"","url":"https://space.bilibili.com/385283571?spm_id_from=333.1007.0.0"},"supported_languages":"English, Simplified Chinese","type":"game","website":null}