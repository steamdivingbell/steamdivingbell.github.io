/908770/ss_94d9983623ebea5a2d50e078e6e3299d170ac004.600x338.jpg?t=1769967904"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/908770/ss_a25e3121c67d81b36b7d7246d7e94d50ea852bb1.1920x1080.jpg?t=1769967904","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/908770/ss_a25e3121c67d81b36b7d7246d7e94d50ea852bb1.600x338.jpg?t=1769967904"}],"short_description":"Global Conflagration is a real-time strategy game inspired by the classics featuring modern controls and streamlined mechanics. Build lots of tanks, infantry, helicopters and aircraft to destroy the enemy base.","steam_appid":908770,"support_info":{"email":"globalconflagrationteam@gmail.com","url":"https://www.reddit.com/r/GlobalConflagration/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.indiedb.com/games/global-conflagration"}