y size!</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Get ready to pilot this hulking mech, protect mankind, and dispense justice in the name of liberty!</p>","developers":["Passion Republic Games"],"fullgame":{"appid":"1546400","name":"GigaBash"},"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3516760/b04cc7bb3e69fd5b9fb0c75bd0ec60b2d99e21af/header.jpg?t=1748574316","is_free":true,"legal_notice":"\u00a9 2019-2025 Passionrepublic Games All Rights Reserved. GigaBash is a registered trademark of Passionrepublic Games Sdn Bhd in Malaysia and other countries.","linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257128693,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257128693/movie480.mp4?t=1748572389","max":"http://video.akamai.steamstatic.com/store_trailers/257128693/movie_max.mp4?t=1748572389"},"name":"GigaBash - MechaJURAS Free DLC: Official Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257128693/786730817d11b2afa1a2ab9edaae4282dc3c14bf/movie_600x337.jpg?t=1748572389","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257128693/movie480_vp9.webm?t=1748572389","max":"http://video.akamai.steamstatic.com/store_trailers/257128693/movie_max_vp9.webm?t=1748572389"}}],"name":"GigaBash - MechaJURAS Free DLC","package_groups":[],"pc_requirements":[],"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Passion Republic Games"],"ratings":{"dejus":{"descriptors":"Viol\u00eancia","rating":"10","required_age":"10","use_age_gate":"true"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"6","rating_generated":"1","required_age":"6","use_age_gate":"0"}},"release_date":{"coming_soon":false,"date":"29 May, 2025"},"required_age":0,"screenshots":[{"