e you gain and the variety of tools at your disposal, you'll gain access to diverse and unique locations such as skateparks, playgrounds, or military training grounds.</p><p class=\"bb_paragraph\" ></p>","developers":["\u25b2 Pyramid Games"],"fullgame":{"appid":"3164790","name":"Overgrown Cleaner"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4094290/05714c99f10a0bfde4598bb1ba5efea4ebdf813a/header.jpg?t=1760108321","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4094290/1882172666/53c614d17f6a249b3da3e997e910ff60f685220d/1760037805/dash_av1.mpd?t=1760108319","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4094290/1882172666/53c614d17f6a249b3da3e997e910ff60f685220d/1760037805/dash_h264.mpd?t=1760108319","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4094290/1882172666/53c614d17f6a249b3da3e997e910ff60f685220d/1760037805/hls_264_master.m3u8?t=1760108319","id":257215099,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257215099/movie480.mp4?t=1760108319","max":"https://video.akamai.steamstatic.com/store_trailers/257215099/movie_max.mp4?t=1760108319"},"name":"Trailer 1","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257215099/94651bc22323487d7af78657790ad1a2d2158e9c/movie_600x337.jpg?t=1760108319","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257215099/movie480.webm?t=1760108319","max":"https://video.akamai.steamstatic.com/store_trailers/257215099/movie_max.webm?t=1760108319"}}],"name":"Overgrown Cleaner Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 or 11<br></li><li><strong>Processor:</strong> Intel Core i5<br></li><l