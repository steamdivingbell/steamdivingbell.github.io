g","id":62}],"content_descriptors":{"ids":[],"notes":null},"detailed_description":"<h1>\u6e38\u620f\u5185\u5bb9\u5168\u65b0\u5347\u7ea7\uff01\uff01</h1><p><p class=\"bb_paragraph\" >\u5927\u5bb6\u597d\u5440\uff0c\u4e3b\u5305\u7ec8\u4e8e\u5b8c\u6210\u4e86\u6cd5\u8003\u548c\u8003\u7814\uff0c\u53ef\u4ee5\u731b\u731b\u505a\u6e38\u620f\u4e86\uff01\u8fd9\u4e00\u6b21\u7684\u5927\u4fee\u5df2\u7ecf\u786e\u5b9a\u4e86CG\u3001\u80cc\u666f\u56fe\u548c\u9884\u7b97\uff0c\u6700\u91cd\u8981\u7684\u662f\u91cd\u65b0\u67b6\u6784\u4e86\u4e00\u5957\u8003\u7814\u8bbe\u5b9a\u5185\u5bb9\uff01</p><p class=\"bb_paragraph\" >\u65b0\u8bbe\u5b9a\u53d1\u751f\u5728\u67b6\u7a7a\u7684\u5c9b\u5c7f\u2014\u2014\u505a\u9898\u5bb6\u4e4b\u5c9b\u4e0a\uff0c\u8be5\u5c9b\u5c7f\u80fd\u591f\u5b9e\u73b0\u9636\u7ea7\u8dc3\u8fc1\u7684\u552f\u4e00\u65b9\u5f0f\u662f\u901a\u8fc7\u8003\u7814\uff0c\u6765\u5230\u6b64\u5c9b\u7684\u672c\u79d1\u751f\u4eec\uff0c\u53ea\u8981\u80fd\u591f\u901a\u8fc7\u8003\u7814\uff0c\u5c31\u53ef\u4ee5\u5750\u4eab\u8363\u534e\u5bcc\u8d35\uff0c\u4e3b\u89d2\u5e03\u90dd\u5728\u4e00\u6b21\u9001\u5916\u5356\u7684\u8fc7\u7a0b\u4e2d\u5f97\u77e5\u6d88\u606f\uff0c\u8e0f\u4e0a\u4e86\u901a\u5f80\u5c0f\u5c9b\u7684\u6e38\u8f6e\uff0c\u5728\u5c9b\u4e0a\uff0c\u5e03\u90dd\u4e0e\u4e24\u540d\u5c11\u5973\u76f8\u9047\uff0c\u5728\u8003\u7814\u5012\u8ba1\u65f660\u5929\u7684\u65f6\u95f4\u91cc\u7ec4\u6210\u4e0a\u5cb8\u5c0f\u7ec4\uff01</p><p class=\"bb_paragraph\" >\u672c\u6b21\u6e38\u620f\u5c06\u706b\u529b\u5168\u5f00\u5c55\u5f00\u5236\u4f5c\uff0c\u5e0c\u671b\u80fd\u591f\u57282026\u5e74\u6691\u5047\u4e4b\u524d\u7ed9\u5230\u5927\u5bb6\uff01</p></p><br><h1>About the Game</h1><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u56e0\u4e3a\u9ad8\u4e2d\u6570\u5b66\u592a\u70c2\u9009\u62e9\u6587\u79d1\u542c\u8bf4\u8003\u516c\u5c31\u4e1a\u7a33\u5b9a\u9009\u62e9\u6cd5\u5b66\u4f46\u56e0\u4e3a\u6210\u7ee9\u592a\u5dee\u53ea\u80fd\u5c31\u8bfb\u7406\u5de5\u79d1\u