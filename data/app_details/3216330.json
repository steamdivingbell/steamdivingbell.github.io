emes with their own puzzles</p><p class=\"bb_paragraph\" >\u00a0- Escape before it\u2019s too late</p><p class=\"bb_paragraph\" >\u00a0- Immersive audio design</p><p class=\"bb_paragraph\" >\u00a0- Online co-op</p><p class=\"bb_paragraph\" ></p>","developers":["SKONEC Entertainment","YOUCANSTAR"],"genres":[{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216330/header.jpg?t=1737697230","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3216330/762447/c348f14dc890c660b7874b7585c8c5eb8c5adacf/1750881831/dash_av1.mpd?t=1736475412","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3216330/762447/c348f14dc890c660b7874b7585c8c5eb8c5adacf/1750881831/dash_h264.mpd?t=1736475412","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3216330/762447/c348f14dc890c660b7874b7585c8c5eb8c5adacf/1750881831/hls_264_master.m3u8?t=1736475412","id":257059340,"name":"Launch Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257059340/cbd8c3de8c6ba3d2618db2d78a726bdc10aae6e5/movie_600x337.jpg?t=1736475412"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3216330/792332/58da1454d8898c02d0c80e44173c3f88567a0420/1750881834/dash_av1.mpd?t=1732841423","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3216330/792332/58da1454d8898c02d0c80e44173c3f88567a0420/1750881834/dash_h264.mpd?t=1732841423","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3216330/792332/58da1454d8898c02d0c80e44173c3f88567a0420/1750881834/hls_264_mast