/steam/apps/3963300/f430793ed5ee950ddca8ce0c4fb662a720d453a4/ss_f430793ed5ee950ddca8ce0c4fb662a720d453a4.600x338.jpg?t=1768099100"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963300/36196ceda3b14b32a790a5c8e358e3befb339895/ss_36196ceda3b14b32a790a5c8e358e3befb339895.1920x1080.jpg?t=1768099100","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963300/36196ceda3b14b32a790a5c8e358e3befb339895/ss_36196ceda3b14b32a790a5c8e358e3befb339895.600x338.jpg?t=1768099100"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963300/c223d5dd44f118646b122aa8a17ec36999de8420/ss_c223d5dd44f118646b122aa8a17ec36999de8420.1920x1080.jpg?t=1768099100","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963300/c223d5dd44f118646b122aa8a17ec36999de8420/ss_c223d5dd44f118646b122aa8a17ec36999de8420.600x338.jpg?t=1768099100"}],"short_description":"As a mafia-hired repo man, you break into debtors\u2019 homes where people would rather blow up their own apartment than pay a single cent. Grab the loot, dodge traps, and escape before the place turns into a war zone\u2014preferably with a crew of friends, as in this line of work chaos is business as usual.","steam_appid":3963300,"support_info":{"email":"patologgyia@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Arabic, Bulgarian, Traditional Chinese, Simplified Chinese, Czech, Danish, Finnish, Greek, Spanish - Latin America, Dutch, Indonesian, Japanese, Korean, Norwegian, Polish<strong>*</strong>, Portuguese - Portugal, Portuguese - Brazil, Russian, Romanian, Swedish, Thai, Turkish, Vietnamese, Hungarian<br><strong>*</strong>languages with full audio support","type":"game","website":null}