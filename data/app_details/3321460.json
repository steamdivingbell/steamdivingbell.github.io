338.jpg?t=1773663216"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321460/5de52275c30401e6b166b2194e75bb5b994ca357/ss_5de52275c30401e6b166b2194e75bb5b994ca357.1920x1080.jpg?t=1773663216","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321460/5de52275c30401e6b166b2194e75bb5b994ca357/ss_5de52275c30401e6b166b2194e75bb5b994ca357.600x338.jpg?t=1773663216"}],"short_description":"Crimson Desert is an open-world action-adventure set on the continent of Pywel. Join Kliff on his journey to rebuild the Greymane faction and to save the land from a looming threat. From vast wilderness and cities to ruins and the mysterious Abyss, forge your path through battles and discovery.","steam_appid":3321460,"support_info":{"email":"","url":"https://crimsondesert.pearlabyss.com"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean<strong>*</strong>, Polish, Russian, Simplified Chinese<strong>*</strong>, Spanish - Latin America, Traditional Chinese, Portuguese - Brazil, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":"https://crimsondesert.pearlabyss.com"}