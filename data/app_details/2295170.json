.1920x1080.jpg?t=1767383268","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/b7981d1bd3376b4f34ef5b6a0864ccc1d3d90b58/ss_b7981d1bd3376b4f34ef5b6a0864ccc1d3d90b58.600x338.jpg?t=1767383268"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/87d14f0b841cec3fb98d108206289039bd866f53/ss_87d14f0b841cec3fb98d108206289039bd866f53.1920x1080.jpg?t=1767383268","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/87d14f0b841cec3fb98d108206289039bd866f53/ss_87d14f0b841cec3fb98d108206289039bd866f53.600x338.jpg?t=1767383268"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/2396ea725c9f12f34fb2f3d92c176fc21960ec4a/ss_2396ea725c9f12f34fb2f3d92c176fc21960ec4a.1920x1080.jpg?t=1767383268","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/2396ea725c9f12f34fb2f3d92c176fc21960ec4a/ss_2396ea725c9f12f34fb2f3d92c176fc21960ec4a.600x338.jpg?t=1767383268"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/2989e87674a19e70318a22c31c858adfbb97a9c2/ss_2989e87674a19e70318a22c31c858adfbb97a9c2.1920x1080.jpg?t=1767383268","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/2989e87674a19e70318a22c31c858adfbb97a9c2/ss_2989e87674a19e70318a22c31c858adfbb97a9c2.600x338.jpg?t=1767383268"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/ad767537a4c0f4db1ee3613b1ea645061e8e41dc/ss_ad767537a4c0f4db1ee3613b1ea645061e8e41dc.1920x1080.jpg?t=1767383268","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/ad767537a4c0f4db1ee3613b1ea645061e8e41dc/ss_ad767537a4c0f4db1ee3613b1ea645061e8e41dc.600x338.jpg?t=1767383268"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2295170/176122d05