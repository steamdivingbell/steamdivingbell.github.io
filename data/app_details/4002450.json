pg?t=1768216883"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4002450/4dce20ff5e835d9c8a2abdccbe40aa549c89ee54/ss_4dce20ff5e835d9c8a2abdccbe40aa549c89ee54.1920x1080.jpg?t=1768216883","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4002450/4dce20ff5e835d9c8a2abdccbe40aa549c89ee54/ss_4dce20ff5e835d9c8a2abdccbe40aa549c89ee54.600x338.jpg?t=1768216883"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4002450/030daa9a051954c55081126986ae761d97412ba2/ss_030daa9a051954c55081126986ae761d97412ba2.1920x1080.jpg?t=1768216883","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4002450/030daa9a051954c55081126986ae761d97412ba2/ss_030daa9a051954c55081126986ae761d97412ba2.600x338.jpg?t=1768216883"}],"short_description":"Become a true pizzaiolo and bring joy to a small Italian village in Italian Pizza Simulator! Help bring back Grandma\u2019s decrepit pizzeria to its former glory, surrounded by the sun-kissed hills of Tuscany, and serve colorful customers from all over the world!","steam_appid":4002450,"support_info":{"email":"pr@games-i.com","url":"https://games-i.com"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Traditional Chinese, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":"https://games-i.com/"}