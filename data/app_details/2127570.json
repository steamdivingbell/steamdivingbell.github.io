0/f580fa6c98629602e949aaa52fac876aff450f48/ss_f580fa6c98629602e949aaa52fac876aff450f48.600x338.jpg?t=1771262932"}],"short_description":"Raise a garden... from the dead! Greenhearth Necromancer is a cozy, witchy, semi-idle game about caring for living and undead plants alike. Grow cute plants in your balcony garden, cast spells, and brew potions, enjoying the chill idle gameplay and ambience throughout your day.","steam_appid":2127570,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English","type":"game","website":"https://silverstringmedia.com/"}