/36a7c41734005fc43cfa9e59c6ab5bfe7bf579e8/ss_36a7c41734005fc43cfa9e59c6ab5bfe7bf579e8.600x338.jpg?t=1762633359"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/220d78bb6449270ecbb958d0b4e7d88f843f06b9/ss_220d78bb6449270ecbb958d0b4e7d88f843f06b9.1920x1080.jpg?t=1762633359","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/220d78bb6449270ecbb958d0b4e7d88f843f06b9/ss_220d78bb6449270ecbb958d0b4e7d88f843f06b9.600x338.jpg?t=1762633359"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/4dde77bd5e0cea06363226c827dc639eeb88b8c7/ss_4dde77bd5e0cea06363226c827dc639eeb88b8c7.1920x1080.jpg?t=1762633359","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/4dde77bd5e0cea06363226c827dc639eeb88b8c7/ss_4dde77bd5e0cea06363226c827dc639eeb88b8c7.600x338.jpg?t=1762633359"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/3bf3e70007d750871eb0ec286bc5aee4350cf863/ss_3bf3e70007d750871eb0ec286bc5aee4350cf863.1920x1080.jpg?t=1762633359","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/3bf3e70007d750871eb0ec286bc5aee4350cf863/ss_3bf3e70007d750871eb0ec286bc5aee4350cf863.600x338.jpg?t=1762633359"}],"short_description":"Cozy-but-hectic restaurant simulator where you play as the waiter in a fast paced and cute dragon restaurant! Set tables, attend hungry dragons, ask plates to the kitchen, serve correct meals and clean up. After each day, customize the layout of the restaurant and learn new abilities to improve.","steam_appid":4148630,"support_info":{"email":"menutstudios@gmail.com","url":""},"supported_languages":"English, French, Spanish - Spain, German, Japanese, Portuguese - Brazil, Russian, Simplified Chinese","type":"game","website":null}