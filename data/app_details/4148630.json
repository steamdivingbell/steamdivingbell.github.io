/e13b17dfbec23db9cd78bec81f93040f534becfe/ss_e13b17dfbec23db9cd78bec81f93040f534becfe.1920x1080.jpg?t=1773503329","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/e13b17dfbec23db9cd78bec81f93040f534becfe/ss_e13b17dfbec23db9cd78bec81f93040f534becfe.600x338.jpg?t=1773503329"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/e1521dd69d0135b4f0fae0f2def43ac9330eefb6/ss_e1521dd69d0135b4f0fae0f2def43ac9330eefb6.1920x1080.jpg?t=1773503329","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/e1521dd69d0135b4f0fae0f2def43ac9330eefb6/ss_e1521dd69d0135b4f0fae0f2def43ac9330eefb6.600x338.jpg?t=1773503329"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/4dde77bd5e0cea06363226c827dc639eeb88b8c7/ss_4dde77bd5e0cea06363226c827dc639eeb88b8c7.1920x1080.jpg?t=1773503329","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4148630/4dde77bd5e0cea06363226c827dc639eeb88b8c7/ss_4dde77bd5e0cea06363226c827dc639eeb88b8c7.600x338.jpg?t=1773503329"}],"short_description":"Cute but chaotic restaurant simulator where you play as a dragon waiter in a fast-paced dining rush. Set tables, serve hungry dragons, deliver the right dishes, and keep the place clean! After each day, customize the layout of the restaurant and learn new abilities to improve.","steam_appid":4148630,"support_info":{"email":"menutstudios@gmail.com","url":""},"supported_languages":"English, French, Spanish - Spain, German, Japanese, Portuguese - Brazil, Russian, Simplified Chinese","type":"game","website":null}