o take better care of yourself while you are at your PC.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Kinychanchan"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4044170/2490ede5aade819bc0a2777016d455ee20c8e9e0/header.jpg?t=1774477979","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4044170/2039668907/98de04b4d529f8d30aadd8e20f1804c812cda28c/1768846961/dash_av1.mpd?t=1768847214","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4044170/2039668907/98de04b4d529f8d30aadd8e20f1804c812cda28c/1768846961/dash_h264.mpd?t=1768847214","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4044170/2039668907/98de04b4d529f8d30aadd8e20f1804c812cda28c/1768846961/hls_264_master.m3u8?t=1768847214","id":257268159,"name":"Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257268159/e87b06b1a07da888069715d67f03008111d87bbe/movie_600x337.jpg?t=1768847214"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4044170/82990188/08d20e407b7bbd823ead4c00cd8de9f14efe2235/1768506734/dash_av1.mpd?t=1768507100","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4044170/82990188/08d20e407b7bbd823ead4c00cd8de9f14efe2235/1768506734/dash_h264.mpd?t=1768507100","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4044170/82990188/08d20e407b7bbd823ead4c00cd8de9f14efe2235/1768506734/hls_264_master.m3u8?t=1768507100","id":257265516,"name":"Official Release Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257265516/0f7469535ceed8931fa82d1c441610f3741f8e4d/movie_600x337.jpg?t=1768507100"}],"name":"Deskworm","package_g