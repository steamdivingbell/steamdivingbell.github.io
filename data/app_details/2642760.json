e_item_assets/steam/apps/2642760/8d4af42989977b0c6b144030c5af790ab280788b/ss_8d4af42989977b0c6b144030c5af790ab280788b.600x338.jpg?t=1759391678"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2642760/7fde4bbed1e45584dd333fc9036e303deba8df18/ss_7fde4bbed1e45584dd333fc9036e303deba8df18.1920x1080.jpg?t=1759391678","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2642760/7fde4bbed1e45584dd333fc9036e303deba8df18/ss_7fde4bbed1e45584dd333fc9036e303deba8df18.600x338.jpg?t=1759391678"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2642760/1432b3bef3d100fba2d5a1c5f9d8fcd45323bba3/ss_1432b3bef3d100fba2d5a1c5f9d8fcd45323bba3.1920x1080.jpg?t=1759391678","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2642760/1432b3bef3d100fba2d5a1c5f9d8fcd45323bba3/ss_1432b3bef3d100fba2d5a1c5f9d8fcd45323bba3.600x338.jpg?t=1759391678"}],"short_description":"Step into a quiet, abandoned Ukrainian village, left empty after the Calamity. In this short, meditative, and melancholic journey, you\u2019ll rekindle the hearths of deserted homes, restoring warmth and hope to the families who once lived here.","steam_appid":2642760,"support_info":{"email":"karatturmenko@gmail.com","url":"https://discord.gg/enuwVrXSG3"},"supported_languages":"English, Ukrainian, German, Polish, Portuguese - Brazil, French, Spanish - Spain, Japanese, Portuguese - Portugal, Spanish - Latin America","type":"game","website":null}