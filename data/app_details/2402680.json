static.com/store_item_assets/steam/apps/2402680/cd52c1aa25679b814125e45317d12339988b7198/ss_cd52c1aa25679b814125e45317d12339988b7198.1920x1080.jpg?t=1749212717","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2402680/cd52c1aa25679b814125e45317d12339988b7198/ss_cd52c1aa25679b814125e45317d12339988b7198.600x338.jpg?t=1749212717"}],"short_description":"A 1-8 player fantasy RPG set in a handcrafted pixel world. Build your hero across 8 races and 6 classes. Explore ancient lands, master elemental combat, forge relationships, and shape a stronghold to call home. Fight for the fate of Dimraeth\u2014together or alone.","steam_appid":2402680,"support_info":{"email":"Joseph@mudtek.dev","url":"http://www.mudtek.dev"},"supported_languages":"English<strong>*</strong>, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"http://www.mudtek.dev"}