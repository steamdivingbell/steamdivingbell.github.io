?t=1762176583"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3785710/b8ee7d01d75b60c55e152db6261527bb29e8907b/ss_b8ee7d01d75b60c55e152db6261527bb29e8907b.1920x1080.jpg?t=1762176583","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3785710/b8ee7d01d75b60c55e152db6261527bb29e8907b/ss_b8ee7d01d75b60c55e152db6261527bb29e8907b.600x338.jpg?t=1762176583"}],"short_description":"Under a snowy overpass, people gather around warm lights. In this cozy management simulation game, run your own POJANGMACHA and serve Korean street foods like roasted sweet potatoes and fish pastries. Handle quirky events and grow your tiny stall into a street food success!","steam_appid":3785710,"support_info":{"email":"AnomalyGuys@Gmail.com","url":""},"supported_languages":"English, Korean, French, German, Spanish - Spain, Russian, Japanese, Simplified Chinese, Traditional Chinese, Italian","type":"game","website":null}