"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/03b9c1e2e0645b6fec4d6906010aed46d1da2c1d/ss_03b9c1e2e0645b6fec4d6906010aed46d1da2c1d.600x338.jpg?t=1769298927"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/ss_fb14d0c5e1938a06fb2f5b1a62d155674a5855bc.1920x1080.jpg?t=1769298927","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/ss_fb14d0c5e1938a06fb2f5b1a62d155674a5855bc.600x338.jpg?t=1769298927"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/ss_03e275cbfe84337602ad78c3ba2688bdb4dff3fd.1920x1080.jpg?t=1769298927","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/ss_03e275cbfe84337602ad78c3ba2688bdb4dff3fd.600x338.jpg?t=1769298927"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/0c857706f893789d900d288da85eab2f64ba47ff/ss_0c857706f893789d900d288da85eab2f64ba47ff.1920x1080.jpg?t=1769298927","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/0c857706f893789d900d288da85eab2f64ba47ff/ss_0c857706f893789d900d288da85eab2f64ba47ff.600x338.jpg?t=1769298927"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/c3073e5c2112b4800f238a41f7a6504d43427fa1/ss_c3073e5c2112b4800f238a41f7a6504d43427fa1.1920x1080.jpg?t=1769298927","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1001860/c3073e5c2112b4800f238a41f7a6504d43427fa1/ss_c3073e5c2112b4800f238a41f7a6504d43427fa1.600x338.jpg?t=1769298927"}],"short_description":"Casual Desktop Game is a fanmade revival of the old Desktop Destroyer game featuring community content. Relieve stress by smashing your desktop or unleashing battles between various entities. Create mods for the workshop and share them with the community.","steam_appid":1001860,"support_info":{"email":"","url":"https://www.casual-desktop-game.com/"},"supported_languages":"English","type":"game","website":"https://www.casual-desktop-game.com/"}