2/ss_e21c583336013058f7a6fb76431379fb09c70872.600x338.jpg?t=1757604015"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/b7e64b0a67b5d781cf224938748a4d24fe93f09b/ss_b7e64b0a67b5d781cf224938748a4d24fe93f09b.1920x1080.jpg?t=1757604015","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/b7e64b0a67b5d781cf224938748a4d24fe93f09b/ss_b7e64b0a67b5d781cf224938748a4d24fe93f09b.600x338.jpg?t=1757604015"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/88ef05ece3aa11c7ed4f0572c4324a43e6931c8c/ss_88ef05ece3aa11c7ed4f0572c4324a43e6931c8c.1920x1080.jpg?t=1757604015","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/88ef05ece3aa11c7ed4f0572c4324a43e6931c8c/ss_88ef05ece3aa11c7ed4f0572c4324a43e6931c8c.600x338.jpg?t=1757604015"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/4d8a0759f4e6fa8b263726eec0b92664b6804771/ss_4d8a0759f4e6fa8b263726eec0b92664b6804771.1920x1080.jpg?t=1757604015","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/4d8a0759f4e6fa8b263726eec0b92664b6804771/ss_4d8a0759f4e6fa8b263726eec0b92664b6804771.600x338.jpg?t=1757604015"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/eeafa5ed870ee11d8859f782268984aa7fee3f9e/ss_eeafa5ed870ee11d8859f782268984aa7fee3f9e.1920x1080.jpg?t=1757604015","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/eeafa5ed870ee11d8859f782268984aa7fee3f9e/ss_eeafa5ed870ee11d8859f782268984aa7fee3f9e.600x338.jpg?t=1757604015"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499560/6e9ed60b577b682259093ccf625fd814a968a74e/ss_6e9ed60b577b682259093ccf625fd814a968a74e.1920x1080.jpg?t=1757604015","path_thumbnail":"https://shared.akamai.steamstatic.com/sto