mstatic.com/store_item_assets/steam/apps/2216290/ss_9218d69e1fec71833791e8cff92dac47a654db6a.600x338.jpg?t=1771428214"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2216290/ss_6ff72635a28915e9c2379b3c58ac3c18b2e4d342.1920x1080.jpg?t=1771428214","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2216290/ss_6ff72635a28915e9c2379b3c58ac3c18b2e4d342.600x338.jpg?t=1771428214"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2216290/ss_25ec93e5c5e8fa8d1834e07b017c52c5cd853611.1920x1080.jpg?t=1771428214","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2216290/ss_25ec93e5c5e8fa8d1834e07b017c52c5cd853611.600x338.jpg?t=1771428214"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2216290/ss_c5243468052ff5f1f2203a08bc379812e2c6c10f.1920x1080.jpg?t=1771428214","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2216290/ss_c5243468052ff5f1f2203a08bc379812e2c6c10f.600x338.jpg?t=1771428214"}],"short_description":"Kitchen Confidence is a restaurant management game, with a pinch of humour. The player will get to manage different kinds of kitchens, and to open the restaurant of their dreams.","steam_appid":2216290,"support_info":{"email":"info@150beanies.fi","url":"https://www.150beanies.fi/"},"supported_languages":"English","type":"game","website":"https://www.150beanies.fi/"}