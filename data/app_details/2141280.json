/apps/2141280/ss_bd84d36c6277984ee36688656054dc264d116d2c.1920x1080.jpg?t=1757092261","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141280/ss_bd84d36c6277984ee36688656054dc264d116d2c.600x338.jpg?t=1757092261"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141280/ss_5af3c5603355bff5f155f0ad7c15fe95af4d77e5.1920x1080.jpg?t=1757092261","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141280/ss_5af3c5603355bff5f155f0ad7c15fe95af4d77e5.600x338.jpg?t=1757092261"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141280/ss_95efb045ea296ea7dd814d9ca6ed8b54d1f6c271.1920x1080.jpg?t=1757092261","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141280/ss_95efb045ea296ea7dd814d9ca6ed8b54d1f6c271.600x338.jpg?t=1757092261"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141280/0baeafa7fafa217438c453aada47d6fef6df3760/ss_0baeafa7fafa217438c453aada47d6fef6df3760.1920x1080.jpg?t=1757092261","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141280/0baeafa7fafa217438c453aada47d6fef6df3760/ss_0baeafa7fafa217438c453aada47d6fef6df3760.600x338.jpg?t=1757092261"}],"short_description":"Cook and command teams of living food in this narrative creature battler. GladiEATers blends seven chef stories in top-down JRPG adventures and roguelike gauntlets, featuring 6v6 battles, spicy cooking minigames and online multiplayer.","steam_appid":2141280,"support_info":{"email":"Support@MilkBubblesGames.com","url":""},"supported_languages":"English, French, Spanish - Spain, Italian, German, Greek, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese","type":"game","website":"https://www.gladieaters.net/"}