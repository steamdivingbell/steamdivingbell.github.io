.steamstatic.com/store_item_assets/steam/apps/3506150/4ecb964837b88433ef3217a102523c4fd81fb10d/ss_4ecb964837b88433ef3217a102523c4fd81fb10d.600x338.jpg?t=1760060775"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3506150/81d09aa80afc5869b677103ce9308927759f629f/ss_81d09aa80afc5869b677103ce9308927759f629f.1920x1080.jpg?t=1760060775","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3506150/81d09aa80afc5869b677103ce9308927759f629f/ss_81d09aa80afc5869b677103ce9308927759f629f.600x338.jpg?t=1760060775"}],"short_description":"SinglePlayer Roguelike meets Auto-Battler Card game! Manage a crew of pirates to fight through endless auto-battles while collecting powerful relics, managing cursed loot, upgrading the ship and casting spells.","steam_appid":3506150,"support_info":{"email":"AlexandreBelanger515@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}