apps/2158690/335116e9a9414762608fabb567100df62cd5f83f/ss_335116e9a9414762608fabb567100df62cd5f83f.1920x1080.jpg?t=1752866512","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2158690/335116e9a9414762608fabb567100df62cd5f83f/ss_335116e9a9414762608fabb567100df62cd5f83f.600x338.jpg?t=1752866512"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2158690/b7191a09b29b2c0fb2c0bfb8fee40bf3f546663f/ss_b7191a09b29b2c0fb2c0bfb8fee40bf3f546663f.1920x1080.jpg?t=1752866512","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2158690/b7191a09b29b2c0fb2c0bfb8fee40bf3f546663f/ss_b7191a09b29b2c0fb2c0bfb8fee40bf3f546663f.600x338.jpg?t=1752866512"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2158690/9165588513d784e8d4e1cf9b5925d30222775b89/ss_9165588513d784e8d4e1cf9b5925d30222775b89.1920x1080.jpg?t=1752866512","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2158690/9165588513d784e8d4e1cf9b5925d30222775b89/ss_9165588513d784e8d4e1cf9b5925d30222775b89.600x338.jpg?t=1752866512"}],"short_description":"Embark on a Metroidvanian journey across a mysterious alien world where every ability unlocks new secrets and every corner hides danger or discovery. Fight enemies and bosses across multiple biomes, collect items and skills on your quest, and upgrade yourself and even the outpost itself.","steam_appid":2158690,"support_info":{"email":"studiovelagames@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://studiovelagames.com"}