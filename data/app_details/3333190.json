ets/steam/apps/3333190/c2fe5d88e441b7ebb433b22a30b27bfdebb0f7fa/ss_c2fe5d88e441b7ebb433b22a30b27bfdebb0f7fa.600x338.jpg?t=1753276494"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3333190/a85c0cd8fe0855ef5440376e290e341e75ab5f1e/ss_a85c0cd8fe0855ef5440376e290e341e75ab5f1e.1920x1080.jpg?t=1753276494","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3333190/a85c0cd8fe0855ef5440376e290e341e75ab5f1e/ss_a85c0cd8fe0855ef5440376e290e341e75ab5f1e.600x338.jpg?t=1753276494"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3333190/fedbea02732a6e27dd91c4d2f0c833a343f809b3/ss_fedbea02732a6e27dd91c4d2f0c833a343f809b3.1920x1080.jpg?t=1753276494","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3333190/fedbea02732a6e27dd91c4d2f0c833a343f809b3/ss_fedbea02732a6e27dd91c4d2f0c833a343f809b3.600x338.jpg?t=1753276494"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3333190/63cb32b68f7f4bd5edabb2bdc5fdf5e00b023c72/ss_63cb32b68f7f4bd5edabb2bdc5fdf5e00b023c72.1920x1080.jpg?t=1753276494","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3333190/63cb32b68f7f4bd5edabb2bdc5fdf5e00b023c72/ss_63cb32b68f7f4bd5edabb2bdc5fdf5e00b023c72.600x338.jpg?t=1753276494"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3333190/9fc5459708b6e7c4bd17ffbb1fcb4fabef97b9b7/ss_9fc5459708b6e7c4bd17ffbb1fcb4fabef97b9b7.1920x1080.jpg?t=1753276494","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3333190/9fc5459708b6e7c4bd17ffbb1fcb4fabef97b9b7/ss_9fc5459708b6e7c4bd17ffbb1fcb4fabef97b9b7.600x338.jpg?t=1753276494"}],"short_description":"Live a trucker\u2019s life in the first trucking sim RPG. Explore villages, cities and wilderness in a fully customizable truck. Get on-foot to eat, sleep, and help people along the way. Your goal: to bring back prosperity in your region. Drive, grow, and inspire!","steam_appid":3333190,"support_info":{"email":"support@moviegames.pl","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Simplified Chinese, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Ukrainian<br><strong>*</strong>languages with full audio support","type":"game","website":null}