wing MP will get the rules, but to master the hardest difficulty, you\u2019ll need the real strategic genius.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>What are you waiting for? To the trough, ready, go!</strong></h2>","developers":["Simplicity Games"],"dlc":[4132050],"genres":[{"description":"Adventure","id":"25"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2999060/header.jpg?t=1770975395","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 10.15 or newer<br></li><li><strong>Processor:</strong> Dual Core 2.4 GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> 2 GB memory (dedicated VRAM or shared RAM), OpenGL 3.0+ support<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2999060/2132010327/346ec6dd69596c3769918d751a957207d9f36f6b/1761217335/dash_av1.mpd?t=1761218792","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2999060/2132010327/346ec6dd69596c3769918d751a957207d9f36f6b/1761217335/dash_h264.mpd?t=1761218792","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2999060/2132010327/346ec6dd69596c3769918d751a957207d9f36f6b/1761217335/hls_264_master.m3u8?t=1761218792","id":257215513,"name":"Release","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257215513/162e961c04c8796885a4c77c28506a7a04e7447b/movie_600x337.jpg?t=1761218792"},{"dash_av1":"https://video.akamai.steamstatic.com/store_traile