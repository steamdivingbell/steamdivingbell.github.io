f5535469d844f5b918b6106b73d6b50f01cec8/ss_eef5535469d844f5b918b6106b73d6b50f01cec8.1920x1080.jpg?t=1773908868","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728900/eef5535469d844f5b918b6106b73d6b50f01cec8/ss_eef5535469d844f5b918b6106b73d6b50f01cec8.600x338.jpg?t=1773908868"}],"short_description":"\u201cThey say nobility doesn\u2019t work\u201d \u2013 I beg to differ. Especially when your peasants are slacking, the estate is crumbling, and the Swedes are ready to invade. Become a true Sarmatian lord in this humor-packed game set in 17th-century Poland!","steam_appid":3728900,"support_info":{"email":"support@sombrerolabs.pl","url":""},"supported_languages":"English, Polish","type":"game","website":null}