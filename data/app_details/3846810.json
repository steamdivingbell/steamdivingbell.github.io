video/mp4\"></video></span></p><h2 class=\"bb_tag\" >What you will find in the full version</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >New mechanics, puzzles, and environments.</p></li><li><p class=\"bb_paragraph\" >You will uncover the whole truth behind this story.</p></li></ul><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >And remember... <strong>Keep Playing ASCESIS</strong>.</p>","developers":["Rocks Entertainment"],"fullgame":{"appid":"3846670","name":"Project: ASCESIS"},"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846810/5b37a47390c188bdce0d7739d428945d91278574/header.jpg?t=1762113313","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3846810/1357993388/f0ee25c509544d865875b8722fdd1219548ac8fb/1753197460/dash_av1.mpd?t=1762112583","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3846810/1357993388/f0ee25c509544d865875b8722fdd1219548ac8fb/1753197460/dash_h264.mpd?t=1762112583","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3846810/1357993388/f0ee25c509544d865875b8722fdd1219548ac8fb/1753197460/hls_264_master.m3u8?t=1762112583","id":257172404,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257172404/movie480.mp4?t=1762112583","max":"https://video.akamai.steamstatic.com/store_trailers/257172404/movie_max.mp4?t=1762112583"},"name":"Project: ASCESIS - Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257172404/fb6a4053a4427dfb17baa38dad42a8b861737