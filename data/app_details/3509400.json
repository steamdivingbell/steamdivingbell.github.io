80c01e22919d4778b7eda6eb6/ss_d147e6c5a7d070580c01e22919d4778b7eda6eb6.600x338.jpg?t=1772741035"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3509400/820ffc69800bdac9c91e45c619b9f7c212b2f68c/ss_820ffc69800bdac9c91e45c619b9f7c212b2f68c.1920x1080.jpg?t=1772741035","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3509400/820ffc69800bdac9c91e45c619b9f7c212b2f68c/ss_820ffc69800bdac9c91e45c619b9f7c212b2f68c.600x338.jpg?t=1772741035"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3509400/417235b5b3c92d288c008254689684599e1b7933/ss_417235b5b3c92d288c008254689684599e1b7933.1920x1080.jpg?t=1772741035","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3509400/417235b5b3c92d288c008254689684599e1b7933/ss_417235b5b3c92d288c008254689684599e1b7933.600x338.jpg?t=1772741035"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3509400/0348b4ce43462d186a7ade5a5cb40c51cebbb1c1/ss_0348b4ce43462d186a7ade5a5cb40c51cebbb1c1.1920x1080.jpg?t=1772741035","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3509400/0348b4ce43462d186a7ade5a5cb40c51cebbb1c1/ss_0348b4ce43462d186a7ade5a5cb40c51cebbb1c1.600x338.jpg?t=1772741035"}],"short_description":"You know the feeling of struggling to get out of bed? In A Heavy Morning, you will play as a young girl battling with her own mind. Your only objective? Get out of bed and get to work on time.","steam_appid":3509400,"support_info":{"email":"sarah@brightgambit.com","url":""},"supported_languages":"English","type":"game","website":null}