ai.steamstatic.com/store_item_assets/steam/apps/3330540/8fea494e0a2103dcf39cc4fc2aecc58dc3faf979/ss_8fea494e0a2103dcf39cc4fc2aecc58dc3faf979.1920x1080.jpg?t=1742834038","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330540/8fea494e0a2103dcf39cc4fc2aecc58dc3faf979/ss_8fea494e0a2103dcf39cc4fc2aecc58dc3faf979.600x338.jpg?t=1742834038"},{"id":20,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330540/c8659ef67a06a13ba482b00f0e60e5c516a6b9c7/ss_c8659ef67a06a13ba482b00f0e60e5c516a6b9c7.1920x1080.jpg?t=1742834038","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330540/c8659ef67a06a13ba482b00f0e60e5c516a6b9c7/ss_c8659ef67a06a13ba482b00f0e60e5c516a6b9c7.600x338.jpg?t=1742834038"}],"short_description":"Parry and thrust your way into a 2.5D action platformer with a unique style-based combat system. As you explore hidden passageways and duel strange creatures, you will need all of your swashbuckling panache to survive.","steam_appid":3330540,"support_info":{"email":"info@scruffydoggames.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German<strong>*</strong>, Spanish - Spain<strong>*</strong>, Arabic<strong>*</strong>, Japanese, Korean, Portuguese - Brazil, Portuguese - Portugal, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}