x338.jpg?t=1749389598"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170640/8ed2b9af2a82dce6b531a9667c23ba06105239b9/ss_8ed2b9af2a82dce6b531a9667c23ba06105239b9.1920x1080.jpg?t=1749389598","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170640/8ed2b9af2a82dce6b531a9667c23ba06105239b9/ss_8ed2b9af2a82dce6b531a9667c23ba06105239b9.600x338.jpg?t=1749389598"}],"short_description":"Get out from the orphanage in this 1-6 player online co-op survival horror game. Solve mysterious puzzles and evade terrifying cultists to survive the Child Eater's coming.","steam_appid":3170640,"support_info":{"email":"master@cultofthechildeater.com","url":"cultofthechildeater.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://cultofthechildeater.com/"}