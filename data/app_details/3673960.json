e_item_assets/steam/apps/3673960/201d5adb6a8ffc62138133af4ef9a5864b9ea6f9/ss_201d5adb6a8ffc62138133af4ef9a5864b9ea6f9.1920x1080.jpg?t=1768324039","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/201d5adb6a8ffc62138133af4ef9a5864b9ea6f9/ss_201d5adb6a8ffc62138133af4ef9a5864b9ea6f9.600x338.jpg?t=1768324039"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/1e6dcb0d6fb25e7915d329cbb3cd7f3959c77e7e/ss_1e6dcb0d6fb25e7915d329cbb3cd7f3959c77e7e.1920x1080.jpg?t=1768324039","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/1e6dcb0d6fb25e7915d329cbb3cd7f3959c77e7e/ss_1e6dcb0d6fb25e7915d329cbb3cd7f3959c77e7e.600x338.jpg?t=1768324039"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/8f4c6d86f67ef4a2ee2ee6e592f827925b9634df/ss_8f4c6d86f67ef4a2ee2ee6e592f827925b9634df.1920x1080.jpg?t=1768324039","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/8f4c6d86f67ef4a2ee2ee6e592f827925b9634df/ss_8f4c6d86f67ef4a2ee2ee6e592f827925b9634df.600x338.jpg?t=1768324039"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/73b3dd9cc931e9a73299e813a91d851774572efc/ss_73b3dd9cc931e9a73299e813a91d851774572efc.1920x1080.jpg?t=1768324039","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/73b3dd9cc931e9a73299e813a91d851774572efc/ss_73b3dd9cc931e9a73299e813a91d851774572efc.600x338.jpg?t=1768324039"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/54b59eae05d62317183b6d1c7760f34c60089dd8/ss_54b59eae05d62317183b6d1c7760f34c60089dd8.1920x1080.jpg?t=1768324039","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673960/54b59eae05d62317183b6d1c7760f34c60089dd8/ss_54b59eae05d62317183b6d1c7760f34c60089dd8.600x338.jpg?t=1768324039"}],"short_description":"Fall into a chill survival adventure, where your fire remembers 10,000 years of survival skills and the stars dance at night to show you how each craft is made. Harvest, craft, hunt and gather your stores for the harsh winter ahead, while exploring a strange land \u2013 with the help of a talking fire","steam_appid":3673960,"support_info":{"email":"admin@littlebuffalostudios.com","url":"https://discord.gg/NCYtbeavJH"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Portuguese - Brazil, Simplified Chinese, Spanish - Latin America","type":"game","website":"https://www.kickstarter.com/projects/littlebuffalostudios/akiiwan-chill-survival-game-with-a-talking-camp-fire/"}