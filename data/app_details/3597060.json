item_assets/steam/apps/3597060/80d93449fd6a24f0ffbb5184f4ff2372a79c0026/ss_80d93449fd6a24f0ffbb5184f4ff2372a79c0026.1920x1080.jpg?t=1747256228","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3597060/80d93449fd6a24f0ffbb5184f4ff2372a79c0026/ss_80d93449fd6a24f0ffbb5184f4ff2372a79c0026.600x338.jpg?t=1747256228"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3597060/02d61146f9531a52c9cb5b84f2c250e53b534a10/ss_02d61146f9531a52c9cb5b84f2c250e53b534a10.1920x1080.jpg?t=1747256228","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3597060/02d61146f9531a52c9cb5b84f2c250e53b534a10/ss_02d61146f9531a52c9cb5b84f2c250e53b534a10.600x338.jpg?t=1747256228"}],"short_description":"Throw, chop, and climb your way up in this physics-based platformer! Unlock new weapons as you explore stunning, untamed landscapes. Master the axe. Conquer the climb. Are you up to the challenge?","steam_appid":3597060,"support_info":{"email":"thisiskodachi@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}