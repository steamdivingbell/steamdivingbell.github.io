2915469aed6.1920x1080.jpg?t=1773780272","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3883580/b2c5d3f8ab33a7c09928dde1d14952915469aed6/ss_b2c5d3f8ab33a7c09928dde1d14952915469aed6.600x338.jpg?t=1773780272"}],"short_description":"Card Conquest is a Tower Defense game with Deckbuilding and Roguelite elements. Combine spells, towers and units to create a deck and defeat your enemies. Spend your resources wisely and find balance between offense and defense. Gather powerful relics that will enhance your cards.","steam_appid":3883580,"support_info":{"email":"wond3rweiss@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Polish<strong>*</strong>, Russian<strong>*</strong>, Simplified Chinese<strong>*</strong>, German<strong>*</strong>, Spanish - Spain<strong>*</strong>, Japanese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}