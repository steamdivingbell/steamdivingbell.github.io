/3806140/extras/517fa98d84be012f4b5392db731a1dd0.webm?t=1756326306\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3806140/extras/517fa98d84be012f4b5392db731a1dd0.mp4?t=1756326306\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Character Customization\u00a0</strong></p><p class=\"bb_paragraph\" >Customize your warrior\u2019s equipment with swords, axes, daggers, armor sets and more. Add enhancements to your weapons for extra stats and most importantly fancy effects. Distribute stat points across Strength, Agility and Magic Power to shape your hero's combat style. Unlock and upgrade active and passive skills to give your fighter the combat advantage he desperately needs.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3806140/extras/2115a8aa6a672f223d38c0179a6184b7.poster.avif?t=1756326306\" width=606 height=166 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3806140/extras/2115a8aa6a672f223d38c0179a6184b7.webm?t=1756326306\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3806140/extras/2115a8aa6a672f223d38c0179a6184b7.mp4?t=1756326306\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Other Important Features of the game\u00a0</strong></p><p class=\"bb_paragraph\" >While your character does the hustling, you can, in real life, do some of the following:</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Sip coffee</p></li><li><p class=\"bb_paragraph\" >Pet your dog</p></li><li><p class=\"bb_paragraph\" >Do spreadsheets</p></li><li><p class=\"bb_paragraph\" >Write emails</p></li><li><p class=\"bb_paragraph\" >Order pizza</p></li><li><p class=\"bb_parag