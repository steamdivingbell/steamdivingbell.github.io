70/d42999d305c58f317a223ae2a4e10b488c24d0fe/ss_d42999d305c58f317a223ae2a4e10b488c24d0fe.600x338.jpg?t=1773414368"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/d4686e45c5f506498b15b0792ec937f9669ceedf/ss_d4686e45c5f506498b15b0792ec937f9669ceedf.1920x1080.jpg?t=1773414368","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/d4686e45c5f506498b15b0792ec937f9669ceedf/ss_d4686e45c5f506498b15b0792ec937f9669ceedf.600x338.jpg?t=1773414368"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/86ef05ad7a17ff10165b2df3448c0f76d1d595b1/ss_86ef05ad7a17ff10165b2df3448c0f76d1d595b1.1920x1080.jpg?t=1773414368","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/86ef05ad7a17ff10165b2df3448c0f76d1d595b1/ss_86ef05ad7a17ff10165b2df3448c0f76d1d595b1.600x338.jpg?t=1773414368"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/bcaf3a0744b9b2f7641bacf13af289e5e3318dd8/ss_bcaf3a0744b9b2f7641bacf13af289e5e3318dd8.1920x1080.jpg?t=1773414368","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/bcaf3a0744b9b2f7641bacf13af289e5e3318dd8/ss_bcaf3a0744b9b2f7641bacf13af289e5e3318dd8.600x338.jpg?t=1773414368"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/6d9aa48b95f308f8d255597e578ad9102282375c/ss_6d9aa48b95f308f8d255597e578ad9102282375c.1920x1080.jpg?t=1773414368","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/6d9aa48b95f308f8d255597e578ad9102282375c/ss_6d9aa48b95f308f8d255597e578ad9102282375c.600x338.jpg?t=1773414368"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/6f9ddcf65103277acd598d35f8bfa67c746cd445/ss_6f9ddcf65103277acd598d35f8bfa67c746cd445.1920x1080.jpg?t=1773414368","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/6f9ddcf65103277acd598d35f8bfa67c746cd445/ss_6f9ddcf65103277acd598d35f8bfa67c746cd445.600x338.jpg?t=1773414368"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/fd26ae761cb022e954e762fd2b85e00d8cc81eb4/ss_fd26ae761cb022e954e762fd2b85e00d8cc81eb4.1920x1080.jpg?t=1773414368","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845070/fd26ae761cb022e954e762fd2b85e00d8cc81eb4/ss_fd26ae761cb022e954e762fd2b85e00d8cc81eb4.600x338.jpg?t=1773414368"}],"short_description":"A terrible syndicate has infiltrated society, explore cases, listen to what the citizens have to say, and use that information to route out the good from the evil in this roguelike deduction game. Can you uncover the head of the syndicate? Or will you be duped like the rest?","steam_appid":3845070,"support_info":{"email":"gildedrunegameshelp@gmail.com","url":"https://www.gildedrunegames.com"},"supported_languages":"English<strong>*</strong>, French, Japanese<br><strong>*</strong>languages with full audio support","type":"game","website":null}