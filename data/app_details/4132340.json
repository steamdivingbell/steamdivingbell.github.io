mai.steamstatic.com/store_item_assets/steam/apps/4132340/f9e27fde51f2d3f141bdc5085f749e0c03833f7b/ss_f9e27fde51f2d3f141bdc5085f749e0c03833f7b.600x338.jpg?t=1762354388"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/c4670b65e2341a2a9f913a8468a0f648d779fbef/ss_c4670b65e2341a2a9f913a8468a0f648d779fbef.1920x1080.jpg?t=1762354388","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/c4670b65e2341a2a9f913a8468a0f648d779fbef/ss_c4670b65e2341a2a9f913a8468a0f648d779fbef.600x338.jpg?t=1762354388"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/63e51455cb0de8e237fd88148cbd778f7851fd56/ss_63e51455cb0de8e237fd88148cbd778f7851fd56.1920x1080.jpg?t=1762354388","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/63e51455cb0de8e237fd88148cbd778f7851fd56/ss_63e51455cb0de8e237fd88148cbd778f7851fd56.600x338.jpg?t=1762354388"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/c9d064b861e3de3ed0ed6483b22eca8d5b6018b2/ss_c9d064b861e3de3ed0ed6483b22eca8d5b6018b2.1920x1080.jpg?t=1762354388","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/c9d064b861e3de3ed0ed6483b22eca8d5b6018b2/ss_c9d064b861e3de3ed0ed6483b22eca8d5b6018b2.600x338.jpg?t=1762354388"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/ee7a3376875ffdbaa4f9410ae699f92d9c568b66/ss_ee7a3376875ffdbaa4f9410ae699f92d9c568b66.1920x1080.jpg?t=1762354388","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/ee7a3376875ffdbaa4f9410ae699f92d9c568b66/ss_ee7a3376875ffdbaa4f9410ae699f92d9c568b66.600x338.jpg?t=1762354388"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4132340/59c5a6b52aa329873fde58252e066a2402418e70/ss_59c5a6b52aa329873fde58252e066a24024