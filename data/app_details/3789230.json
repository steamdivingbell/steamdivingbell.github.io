teamstatic.com/store_item_assets/steam/apps/3789230/c81c0185df41351e508d5fa628254464cb601a3d/ss_c81c0185df41351e508d5fa628254464cb601a3d.600x338.jpg?t=1749238821"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3789230/0ed0dd982a98cabb292ad64124204941edaa230f/ss_0ed0dd982a98cabb292ad64124204941edaa230f.1920x1080.jpg?t=1749238821","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3789230/0ed0dd982a98cabb292ad64124204941edaa230f/ss_0ed0dd982a98cabb292ad64124204941edaa230f.600x338.jpg?t=1749238821"}],"short_description":"A unique survival adventure, animated in a 1930s rubber hose style! Fight to survive: capture creatures, farm, mine, and craft everything you need\u2014from gear and vehicles to your base. Explore lands and underwater depths with their shipwrecks, amidst dangers and wonders.","steam_appid":3789230,"support_info":{"email":"traviteamgames@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Simplified Chinese, Korean, Japanese, Portuguese - Brazil, Russian","type":"game","website":null}