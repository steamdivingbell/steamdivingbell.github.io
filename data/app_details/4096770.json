shared.akamai.steamstatic.com/store_item_assets/steam/apps/4096770/extras/c460a6b2f6fda3061c8f944a9b3ae243.webm?t=1761503123\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4096770/extras/c460a6b2f6fda3061c8f944a9b3ae243.mp4?t=1761503123\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Pick your favorite bubble color, change your name, and top it all off with a silly hat. Stand out in the lagoon and make your bubble your own \u2013 whether you want to look cool, goofy, or absolutely bubblelicious.</p>","developers":["Acodeon Development"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4096770/56cb604121f9a7de9192f863315b4c5fa6c50d4b/header.jpg?t=1761503123","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Bubble Wars","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7<br></li><li><strong>Processor:</strong> Intel Core i3 or AMD Ryzen 3<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 750 or AMD Radeon RX 550<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5 or AMD Ryzen 5<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 1650 or AMD Radeon RX 570<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":[" Acodeon"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"