/06d58f26a43017b64db1d729e8205c5afaecdd84/ss_06d58f26a43017b64db1d729e8205c5afaecdd84.1920x1080.jpg?t=1765194198","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3931220/06d58f26a43017b64db1d729e8205c5afaecdd84/ss_06d58f26a43017b64db1d729e8205c5afaecdd84.600x338.jpg?t=1765194198"}],"short_description":"Time and Space Legacy is a top-view puzzle game where you design and build your own space stations. Manage scarce resources, lay out buildings accordingly, and use advanced time-traveling technologies to save the future of humankind !","steam_appid":3931220,"support_info":{"email":"maximeetsgames@gmail.com","url":""},"supported_languages":"English, French","type":"game","website":null}