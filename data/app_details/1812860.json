rc=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1812860/extras/Steam_Video_Turnbased_Gif_02.gif?t=1750405566\" /></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">Navigate the battlefield by rolling dice and use them to control your knights in combat</p></li><li><p class=\"bb_paragraph\">Combine dice to unleash your characters\u2019 powerful abilities and decimate your foes</p></li><li><p class=\"bb_paragraph\">Reroll specific dice to be the master of your own fate</p></li><li><p class=\"bb_paragraph\">Adapt to the roll of the dice to optimise your turn and achieve victory<br></p><p class=\"bb_paragraph\"></p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1812860/extras/Steam_DiscordBanner.png?t=1750405566\" /></p></li></ul>","developers":["Chromatic Ink"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1812860/402c8e0fb372c53d694589d346e0f7bdc94ff9bc/header.jpg?t=1750405566","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257052686,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257052686/movie480.mp4?t=1731425740","max":"http://video.akamai.steamstatic.com/store_trailers/257052686/movie_max.mp4?t=1731425740"},"name":"Dice Gambit Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257052686/105313add2b7b20aed90517e18b2608e1d8bdc2b/movie_600x337.jpg?t=1731425740","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257052686/movie480_vp9.webm?t=1731425740","max":"http://video.akamai.steamstatic.com/store_trailers/257052686/movie_max_vp9.webm?t=1731425740"}},{"highlight":true,"id":257053812,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/25705381