com/store_item_assets/steam/apps/3603960/4af311bc8bbf4996844132242c1e890afaa64d51/ss_4af311bc8bbf4996844132242c1e890afaa64d51.600x338.jpg?t=1764647439"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3603960/ae2d4f52156c0aba029c92e92ab99c666e4ebcfd/ss_ae2d4f52156c0aba029c92e92ab99c666e4ebcfd.1920x1080.jpg?t=1764647439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3603960/ae2d4f52156c0aba029c92e92ab99c666e4ebcfd/ss_ae2d4f52156c0aba029c92e92ab99c666e4ebcfd.600x338.jpg?t=1764647439"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3603960/e83df724d8bdef6c9067ffb7009a0d24c179d452/ss_e83df724d8bdef6c9067ffb7009a0d24c179d452.1920x1080.jpg?t=1764647439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3603960/e83df724d8bdef6c9067ffb7009a0d24c179d452/ss_e83df724d8bdef6c9067ffb7009a0d24c179d452.600x338.jpg?t=1764647439"}],"short_description":"Sunyata CCG is a fast-paced collectible card game set in a magical future where humanity teeters on the edge of survival. Players command magical beasts, shape their castle\u2019s powers, and battle for control each turn through flavorful card abilities.","steam_appid":3603960,"support_info":{"email":"sunyata@nagarjunagames.com","url":"http://nagarjunagames.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://sunyataccg.com"}