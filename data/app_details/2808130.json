_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["SillyMan Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2808130/b0c29f67a1824baef66d18f9761d79e57389b9b1/header_alt_assets_1.jpg?t=1762219814","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2808130/31210156/55b22d34a76be8603bb315876c29c7d43aee5ffa/1761614959/dash_av1.mpd?t=1761619151","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2808130/31210156/55b22d34a76be8603bb315876c29c7d43aee5ffa/1761614959/dash_h264.mpd?t=1761619151","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2808130/31210156/55b22d34a76be8603bb315876c29c7d43aee5ffa/1761614959/hls_264_master.m3u8?t=1761619151","id":257223428,"name":"Caden's Climb Climboween Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257223428/4a01efd3923434750849a85a9693bbab819a2a5f/movie_600x337.jpg?t=1761619151"}],"name":"Caden's Climb","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel or AMD Dual Core CPU<br></li><li><strong>Memory:</strong> 512 MB RAM</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit proce