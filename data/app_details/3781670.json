ts/steam/apps/3781670/61ccff79a541d58dbf4fe251814705baebe286dd/ss_61ccff79a541d58dbf4fe251814705baebe286dd.1920x1080.jpg?t=1759581239","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781670/61ccff79a541d58dbf4fe251814705baebe286dd/ss_61ccff79a541d58dbf4fe251814705baebe286dd.600x338.jpg?t=1759581239"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781670/21171260a290f139e94da0fa625c66a46bb1d676/ss_21171260a290f139e94da0fa625c66a46bb1d676.1920x1080.jpg?t=1759581239","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781670/21171260a290f139e94da0fa625c66a46bb1d676/ss_21171260a290f139e94da0fa625c66a46bb1d676.600x338.jpg?t=1759581239"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781670/fc08e47654bbc7abdecc629fb2624d1c3ff2fcd1/ss_fc08e47654bbc7abdecc629fb2624d1c3ff2fcd1.1920x1080.jpg?t=1759581239","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781670/fc08e47654bbc7abdecc629fb2624d1c3ff2fcd1/ss_fc08e47654bbc7abdecc629fb2624d1c3ff2fcd1.600x338.jpg?t=1759581239"}],"short_description":"4 Thieves vs. 1 Guardian! A medieval heist game! Play as a thief, disguise yourself among the crowd, and steal the treasure, or take on the role of the guardian and hunt down the thieves! Everyone has a unique role and strategy. Find the right approach and lead your team to victory!","steam_appid":3781670,"support_info":{"email":"dointogethergames@gmail.com","url":"https://www.dointogethergames.com/"},"supported_languages":"English<strong>*</strong>, Turkish<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":null}