0950/extras/steam_lorencash_final.gif?t=1742827080\" /></p><p class=\"bb_paragraph\">  </p><h2 class=\"bb_tag\"></h2><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">  </p>","developers":["Lillexstudios"],"fullgame":{"appid":"3525840","name":"Complex 629"},"genres":[{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3590950/2f827351ba012ce445463b07f69d427a9fc6f08f/header.jpg?t=1742827080","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257117293,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257117293/movie480.mp4?t=1742826953","max":"http://video.akamai.steamstatic.com/store_trailers/257117293/movie_max.mp4?t=1742826953"},"name":"Complex 629 Demo","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257117293/e8e89ce6ffb9712097c3eb997e070bf0f7100bd3/movie_600x337.jpg?t=1742826953","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257117293/movie480_vp9.webm?t=1742826953","max":"http://video.akamai.steamstatic.com/store_trailers/257117293/movie_max_vp9.webm?t=1742826953"}}],"name":"Complex 629 Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core 2 Duo 2.8Ghz or equivalent<br></li><li><strong>Memory:</strong> 512 MB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 660<br></li><li><strong>Storage:</strong> 700 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel i3<br></li><li><strong>Memory:</strong> 512 MB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 1660<br></li><li><strong>Storage:</strong> 700 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":tr