tore_item_assets/steam/apps/3984830/extras/d114bcc5b39e48c47baef56953e2f310.avif?t=1758185005\" width=1560 height=824 /></span></p>","developers":["ColorfulCloud71"],"fullgame":{"appid":"3941760","name":"WindowGarden"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984830/3a0a4c0b9b5c0850522ffd7c3b6e38492f5c6593/header.jpg?t=1758185005","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257190493,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257190493/movie480.mp4?t=1758185003","max":"http://video.akamai.steamstatic.com/store_trailers/257190493/movie_max.mp4?t=1758185003"},"name":"Public082901","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257190493/35e83bba73f0d4c45e897f181fa01a8b7dec65a9/movie_600x337.jpg?t=1758185003","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257190493/movie480_vp9.webm?t=1758185003","max":"http://video.akamai.steamstatic.com/store_trailers/257190493/movie_max_vp9.webm?t=1758185003"}}],"name":"WindowGarden Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> WIndows 10<br></li><li><strong>Processor:</strong> Intel i3-7100<br></li><li><strong>Graphics:</strong> Integrated graphics<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> WIndows 10<br></li><li><strong>Processor:</strong> Intel Core i5-12400 <br></li><li><strong>Graphics:</strong> GeForce RTX 2060<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["ColorfulCloud71"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"10","ra