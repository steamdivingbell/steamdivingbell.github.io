520614"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/d3a3a234ab482b4829c483d8322c9e2d00bdfe3c/ss_d3a3a234ab482b4829c483d8322c9e2d00bdfe3c.1920x1080.jpg?t=1757520614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/d3a3a234ab482b4829c483d8322c9e2d00bdfe3c/ss_d3a3a234ab482b4829c483d8322c9e2d00bdfe3c.600x338.jpg?t=1757520614"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/43919f3ef3105d66aeb104428292ef343303e786/ss_43919f3ef3105d66aeb104428292ef343303e786.1920x1080.jpg?t=1757520614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/43919f3ef3105d66aeb104428292ef343303e786/ss_43919f3ef3105d66aeb104428292ef343303e786.600x338.jpg?t=1757520614"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/9dcb753047db1dc0ff755a3658d35d01bacb7162/ss_9dcb753047db1dc0ff755a3658d35d01bacb7162.1920x1080.jpg?t=1757520614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/9dcb753047db1dc0ff755a3658d35d01bacb7162/ss_9dcb753047db1dc0ff755a3658d35d01bacb7162.600x338.jpg?t=1757520614"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/4d30bb8f9b4afe5a0a4e258da7a2859ffb6c7e77/ss_4d30bb8f9b4afe5a0a4e258da7a2859ffb6c7e77.1920x1080.jpg?t=1757520614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/4d30bb8f9b4afe5a0a4e258da7a2859ffb6c7e77/ss_4d30bb8f9b4afe5a0a4e258da7a2859ffb6c7e77.600x338.jpg?t=1757520614"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/ab696361dd03be2982b16e1efaaa42717bede8a6/ss_ab696361dd03be2982b16e1efaaa42717bede8a6.1920x1080.jpg?t=1757520614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/ab696361dd03be2982b16e1efaaa42717bede8a6/ss_ab696361dd03be2982b16e1efaaa42717bede8a6.600x338.jpg?t=1757520614"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/6ac256f585e3d92dc4d3965af181a303c1726aff/ss_6ac256f585e3d92dc4d3965af181a303c1726aff.1920x1080.jpg?t=1757520614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005930/6ac256f585e3d92dc4d3965af181a303c1726aff/ss_6ac256f585e3d92dc4d3965af181a303c1726aff.600x338.jpg?t=1757520614"}],"short_description":"BatteryNote is a multi-ending sci-fi adventure visual novel game. You can recharge three robots with limited lifespans, bringing them back to life. Interact with them through conversations or experiment by applying high voltage. How they spend their final moments is entirely up to you.","steam_appid":3005930,"support_info":{"email":"","url":"https://www.72studio.tokyo/"},"supported_languages":"Japanese, English, Simplified Chinese, Traditional Chinese","type":"game","website":null}