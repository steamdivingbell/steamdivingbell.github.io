m_assets/steam/apps/4027740/extras/fd2ecd1b2eef3583734dde4890d7a821.poster.avif?t=1768448795\" width=544 height=306 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/fd2ecd1b2eef3583734dde4890d7a821.webm?t=1768448795\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/fd2ecd1b2eef3583734dde4890d7a821.mp4?t=1768448795\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/0aef053957743027c604ff23fe15f23e.poster.avif?t=1768448795\" width=544 height=306 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/0aef053957743027c604ff23fe15f23e.webm?t=1768448795\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/0aef053957743027c604ff23fe15f23e.mp4?t=1768448795\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Level content:</p><p class=\"bb_paragraph\" >The game contains multiple fictional historical combat missions. Helps you familiarize and understand game operations and core gameplay in the early stages.</p><p class=\"bb_paragraph\" >In addition, it also includes three different difficulty levels of endless modes, where enemies will attack wave after wave, and you can see how long you can lead this giant ship to persist.</p><p class=\"bb_paragraph\" >Featured gameplay:</p><p class=\"bb_paragraph\" >After each wave of enemies is cleared, a random gain reward will appear, which helps to complete battles more efficiently in subsequent waves.</p><p class=\"bb_paragraph\" >In addition to enhancing the work efficiency of ground personnel, the participation and assistance of new models of fighter jets such as J35 and KJ600 can also be obtained.</p>","developers":["Mithril_055"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/e890e2cd4fdcd2e32958c4f3ef20700ee27cc4c4/header.jpg?t=1768448795","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4027740/1299114153/5ec4adf35175987d579e7c6647f21d38fa3bc1bd/1768404390/dash_av1.mpd?t=1768406180","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4027740/1299114153/5ec4adf35175987d579e7c6647f21d38fa3bc1bd/1768404390/dash_h264.mpd?t=1768406180","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4027740/1299114153/5ec4adf35175987d579e7c6647f21d38fa3bc1bd/1768404390/hls_264_master.m3u8?t=1768406180","id":257236485,"name":"FuJianStrike-gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257236485/2b054d996f43a53046a918dfddb6d043713872ff/movie_600x337.jpg?t=1768406180"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4027740/1134144368/0d5618c483894989688c360b090df4569ba3fcc8/1768403631/dash_av1.mpd?t=1768406181","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4027740/1134144368/0d5618c483894989688c360b090df4569ba3fcc8/1768403631/dash_h264.mpd?t=1768406181","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4027740/1134144368/0d5618c483894989688c360b090df4569ba3fcc8/1768403631/hls_264_master.m3u8?t=1768406181","id":257196593,"name":"\u51fa\u51fb!\u798f\u5efa\u8230-\u73a9\u6cd5\u5c55\u793a","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257196593/f73952e95d9398d3e056c43d611a7b0324ccf610/movie_600x337.jpg?t=1768406181"}],"name":"FuJianStrike","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> windows 10<br></