m_assets/steam/apps/4027740/extras/fd2ecd1b2eef3583734dde4890d7a821.poster.avif?t=1772955377\" width=544 height=306 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/fd2ecd1b2eef3583734dde4890d7a821.webm?t=1772955377\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/fd2ecd1b2eef3583734dde4890d7a821.mp4?t=1772955377\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/0aef053957743027c604ff23fe15f23e.poster.avif?t=1772955377\" width=544 height=306 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/0aef053957743027c604ff23fe15f23e.webm?t=1772955377\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/extras/0aef053957743027c604ff23fe15f23e.mp4?t=1772955377\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Level content:</p><p class=\"bb_paragraph\" >The game contains multiple fictional historical combat missions. Helps you familiarize and understand game operations and core gameplay in the early stages.</p><p class=\"bb_paragraph\" >In addition, it also includes three different difficulty levels of endless modes, where enemies will attack wave after wave, and you can see how long you can lead this giant ship to persist.</p><p class=\"bb_paragraph\" >Featured gameplay:</p><p class=\"bb_paragraph\" >After each wave of enemies is cleared, a random gain reward will appear, which helps to complete battles more efficiently in subsequent waves.</p><p class=\"bb_paragraph\" >In addition to enhancing the work efficiency of ground personnel, the participation and assistance of new models of fighter jets such as J35 and KJ600 can also be obtained.</p>","developers":["Mithril_055"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4027740/e9f2830558efb200adede1bda8bb7fd4d818eb10/header.jpg?t=1772955377","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4027740/1698229695/d1ec7d6dec6040c583104ad1e8c4334a03a2f059/1772954873/dash_av1.mpd?t=1772955376","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4027740/1698229695/d1ec7d6dec6040c583104ad1e8c4334a03a2f059/1772954873/dash_h264.mpd?t=1772955376","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4027740/1698229695/d1ec7d6dec6040c583104ad1e8c4334a03a2f059/1772954873/hls_264_master.m3u8?t=1772955376","id":257299695,"name":"FujianStrike-GamePlay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257299695/1a300aa156f9da065a109d7d7b37be7e4a068187/movie_600x337.jpg?t=1772955376"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4027740/58649233/ead0d33be85ce584a62de617ffc5ace476117212/1772952918/dash_av1.mpd?t=1772953423","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4027740/58649233/ead0d33be85ce584a62de617ffc5ace476117212/1772952918/dash_h264.mpd?t=1772953423","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4027740/58649233/ead0d33be85ce584a62de617ffc5ace476117212/1772952918/hls_264_master.m3u8?t=1772953423","id":257196593,"name":"\u51fa\u51fb!\u798f\u5efa\u8230-\u73a9\u6cd5\u5c55\u793a","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257196593/a7030a591c0d10a8a97021b6297f27a71c4f13ce/movie_600x337.jpg?t=1772953423"}],"name":"FuJianStrike","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> windows 10<br></li><li