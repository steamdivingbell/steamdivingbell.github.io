8971d89f1e028bbb67fdf3c/ss_ebe498cdae00eef9b8971d89f1e028bbb67fdf3c.600x338.jpg?t=1764670006"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1989720/4f19868bf5a404a023f540558ef21a479f86b160/ss_4f19868bf5a404a023f540558ef21a479f86b160.1920x1080.jpg?t=1764670006","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1989720/4f19868bf5a404a023f540558ef21a479f86b160/ss_4f19868bf5a404a023f540558ef21a479f86b160.600x338.jpg?t=1764670006"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1989720/3d432d348f2417a5bfb68e5fab1730d8cd8a6f9c/ss_3d432d348f2417a5bfb68e5fab1730d8cd8a6f9c.1920x1080.jpg?t=1764670006","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1989720/3d432d348f2417a5bfb68e5fab1730d8cd8a6f9c/ss_3d432d348f2417a5bfb68e5fab1730d8cd8a6f9c.600x338.jpg?t=1764670006"}],"short_description":"Be a stone Golem and try to save Nature with the help of an adorable Fox! Reconnect ancient sources of energy in environmental puzzles. Discover secrets from a lost civilization and save animals on an emotional quest in a cozy, colorful world.","steam_appid":1989720,"support_info":{"email":"support@mindscape.com","url":"https://www.mindscape.com"},"supported_languages":"English, French, German, Spanish - Spain, Portuguese - Portugal, Italian, Korean, Polish, Simplified Chinese, Traditional Chinese, Japanese","type":"game","website":"https://www.mindscape.com/unpetrified"}