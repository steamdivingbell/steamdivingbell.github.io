mmercials to brainwash the Gods. Boost the sales of specific dishes and massively increase your profits. For example, you can double the price of all vegetables\u2014then trick the Gods into buying them in bulk, raking in huge earnings.</p>","developers":["GARRY"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3746950/2416fa65581cc46a70bd69bb31e5d24f75c18151/header.jpg?t=1767821235","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Happy cook friends","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 or 11 64bit<br></li><li><strong>Processor:</strong>  Intel\u00ae Core\u2122 i5-6xxx, AMD FX\u2122-6300<br></li><li><strong>Memory:</strong> 8  MB RAM<br></li><li><strong>Graphics:</strong> NVIDIA\u00ae GeForce\u00ae GTX 750 or AMD Radeon\u2122 R7 265<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["GARRY"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia fantasiosa","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"6","rating_generated":"1","required_age":"6","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3746950/c85663ca0143cd5adb2011db0fa80277c47cb5da/ss_c85663ca0143cd5adb2011db0fa80277c47cb5da.1920x1080.jpg?t=1767821235","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3746950/c85663ca0143cd5adb2011db0fa80277c47cb5da/ss_c85663ca0143cd5adb2011db0fa80277c47cb5da.600x338.jpg?t=1767821235"},{"id"