b_paragraph\" >In this game, we\u2019ve aimed to treat history with the utmost respect, recreating:</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>The daily life of Vikings</strong>, their training, and their equipment.</p></li><li><p class=\"bb_paragraph\" ><strong>The unique features of Anglo-Saxon kingdoms</strong>, including the titles of thanes, historical rulers, and much more.</p></li></ul>","developers":["Hamsters Gaming"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996650/50718aadb2accb000280136d8335ac64d0646625/header.jpg?t=1771321414","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2996650/840991/58ada22a43ea916e19798c0937639f76a534cf0b/1750956429/dash_av1.mpd?t=1740647165","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2996650/840991/58ada22a43ea916e19798c0937639f76a534cf0b/1750956429/dash_h264.mpd?t=1740647165","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2996650/840991/58ada22a43ea916e19798c0937639f76a534cf0b/1750956429/hls_264_master.m3u8?t=1740647165","id":257107730,"name":"3","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257107730/b89ffa9d4485ab2205dedf8e41e407cc6979553d/movie_600x337.jpg?t=1740647165"}],"name":"True Vikings","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>