static.com/store_item_assets/steam/apps/2996650/9914bec1f05135613c1be2a7630dcc4af6b6451c/ss_9914bec1f05135613c1be2a7630dcc4af6b6451c.600x338.jpg?t=1771321414"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996650/00589cc7702f16953f3fb0faa2fb028a3b236297/ss_00589cc7702f16953f3fb0faa2fb028a3b236297.1920x1080.jpg?t=1771321414","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996650/00589cc7702f16953f3fb0faa2fb028a3b236297/ss_00589cc7702f16953f3fb0faa2fb028a3b236297.600x338.jpg?t=1771321414"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996650/f907b6344d3536f96fb39318697098a8130f4263/ss_f907b6344d3536f96fb39318697098a8130f4263.1920x1080.jpg?t=1771321414","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996650/f907b6344d3536f96fb39318697098a8130f4263/ss_f907b6344d3536f96fb39318697098a8130f4263.600x338.jpg?t=1771321414"}],"short_description":"Choose your own path: become a powerful jarl or a legendary king, or perhaps switch sides and follow the path of a knight, reliving the story of the Duke of Normandy.","steam_appid":2996650,"support_info":{"email":"rasshodivse@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Bulgarian, Portuguese - Brazil, Hungarian, Vietnamese, Greek, Danish, Indonesian, Spanish - Latin America, Traditional Chinese, Simplified Chinese, Korean, Dutch, Norwegian, Polish, Portuguese - Portugal, Romanian, Russian, Thai, Turkish, Ukrainian, Finnish, Czech, Swedish, Japanese","type":"game","website":null}