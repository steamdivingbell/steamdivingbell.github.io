x1080.jpg?t=1756827971","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/bc5fec5ba984bee9565d378aaf09a0bd1ba9c2be/ss_bc5fec5ba984bee9565d378aaf09a0bd1ba9c2be.600x338.jpg?t=1756827971"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/8e5aa0d8b0b6dbb20dc3a6552f03fb53dda3b2f4/ss_8e5aa0d8b0b6dbb20dc3a6552f03fb53dda3b2f4.1920x1080.jpg?t=1756827971","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/8e5aa0d8b0b6dbb20dc3a6552f03fb53dda3b2f4/ss_8e5aa0d8b0b6dbb20dc3a6552f03fb53dda3b2f4.600x338.jpg?t=1756827971"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/7d4e3729ffc77af34e064d82bf026949b6e46eea/ss_7d4e3729ffc77af34e064d82bf026949b6e46eea.1920x1080.jpg?t=1756827971","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/7d4e3729ffc77af34e064d82bf026949b6e46eea/ss_7d4e3729ffc77af34e064d82bf026949b6e46eea.600x338.jpg?t=1756827971"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/4b95c188c94c89666832a80fceda527eb1e1f724/ss_4b95c188c94c89666832a80fceda527eb1e1f724.1920x1080.jpg?t=1756827971","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/4b95c188c94c89666832a80fceda527eb1e1f724/ss_4b95c188c94c89666832a80fceda527eb1e1f724.600x338.jpg?t=1756827971"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/0fdadbf33a66148453f86a1351eb50ad8a428ef1/ss_0fdadbf33a66148453f86a1351eb50ad8a428ef1.1920x1080.jpg?t=1756827971","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/0fdadbf33a66148453f86a1351eb50ad8a428ef1/ss_0fdadbf33a66148453f86a1351eb50ad8a428ef1.600x338.jpg?t=1756827971"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841770/dded74cd71d84f5e977