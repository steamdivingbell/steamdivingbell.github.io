3583f7e6b65da20e27734f2f4fccc0/ss_a31b688d9b3583f7e6b65da20e27734f2f4fccc0.1920x1080.jpg?t=1773949461","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4084400/a31b688d9b3583f7e6b65da20e27734f2f4fccc0/ss_a31b688d9b3583f7e6b65da20e27734f2f4fccc0.600x338.jpg?t=1773949461"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4084400/cc8042bcd49279b97aafc57d7f623933383e3f39/ss_cc8042bcd49279b97aafc57d7f623933383e3f39.1920x1080.jpg?t=1773949461","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4084400/cc8042bcd49279b97aafc57d7f623933383e3f39/ss_cc8042bcd49279b97aafc57d7f623933383e3f39.600x338.jpg?t=1773949461"}],"short_description":"How many times are you willing to die for revenge? Rise from the ashes to uncover a divine conspiracy in this Roguelite Strategy RPG inspired by the classics. Lead an ever-growing team on a continent-spanning quest, fight tactical turn-based battles, and synergize your skills for decisive victory.","steam_appid":4084400,"support_info":{"email":"info@zerosungames.com","url":""},"supported_languages":"English","type":"game","website":"https://www.zerosungames.com/astral-throne-ii"}