76534/ss_566b70ec5fd36e64992effd565c0407b23676534.600x338.jpg?t=1772526193"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3400030/9f34f9e3905475b607ecc70a41e6711048e60034/ss_9f34f9e3905475b607ecc70a41e6711048e60034.1920x1080.jpg?t=1772526193","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3400030/9f34f9e3905475b607ecc70a41e6711048e60034/ss_9f34f9e3905475b607ecc70a41e6711048e60034.600x338.jpg?t=1772526193"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3400030/a9288b217d5b1a9b60cc66c82d6bf30ee2c88a44/ss_a9288b217d5b1a9b60cc66c82d6bf30ee2c88a44.1920x1080.jpg?t=1772526193","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3400030/a9288b217d5b1a9b60cc66c82d6bf30ee2c88a44/ss_a9288b217d5b1a9b60cc66c82d6bf30ee2c88a44.600x338.jpg?t=1772526193"}],"short_description":"&quot;Match! The 12 CZ Wars&quot; is a roguelike strategy game blending match-3 and buff-building. Partner with 12 Zodiac Maidens to repel ancient primordial beasts. Navigate random events, battles, and upgrades. Carefully choose paths, manage resources, and empower your Maidens to secure victory.","steam_appid":3400030,"support_info":{"email":"2825411077@qq.com","url":"https://space.bilibili.com/9283519"},"supported_languages":"English, Japanese, Simplified Chinese<strong>*</strong>, Traditional Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}