400030/b4b5632e18dc41dd362fda3cd06f625ae19b319c/ss_b4b5632e18dc41dd362fda3cd06f625ae19b319c.1920x1080.jpg?t=1761556396","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3400030/b4b5632e18dc41dd362fda3cd06f625ae19b319c/ss_b4b5632e18dc41dd362fda3cd06f625ae19b319c.600x338.jpg?t=1761556396"}],"short_description":"&quot;Match! The 12 CZ Wars&quot; is a roguelike strategy game blending match-3 and buff-building. Partner with 12 Zodiac Maidens to repel ancient primordial beasts. Navigate random events, battles, and upgrades. Carefully choose paths, manage resources, and empower your Maidens to secure victory.","steam_appid":3400030,"support_info":{"email":"2825411077@qq.com","url":"https://space.bilibili.com/9283519"},"supported_languages":"English, Japanese, Simplified Chinese<strong>*</strong>, Traditional Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}