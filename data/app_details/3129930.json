akamai.steamstatic.com/store_item_assets/steam/apps/3129930/194d0cdeb831cfa2b391379571134333839c87a9/ss_194d0cdeb831cfa2b391379571134333839c87a9.1920x1080.jpg?t=1764585243","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3129930/194d0cdeb831cfa2b391379571134333839c87a9/ss_194d0cdeb831cfa2b391379571134333839c87a9.600x338.jpg?t=1764585243"}],"short_description":"Nonentity Galaxy is a strategy game featuring starship combat, roguelike gameplay, and dark humor. You will play as a corporate investigator dealing with various factions and figures, upholding company interests while scraping together a chance to survive\u2026 or perhaps, a shred of dignity.","steam_appid":3129930,"support_info":{"email":"support@2pgames.net","url":""},"supported_languages":"Simplified Chinese, English, Japanese","type":"game","website":null}