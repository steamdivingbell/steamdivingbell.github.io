item_assets/steam/apps/3129930/194d0cdeb831cfa2b391379571134333839c87a9/ss_194d0cdeb831cfa2b391379571134333839c87a9.1920x1080.jpg?t=1766649466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3129930/194d0cdeb831cfa2b391379571134333839c87a9/ss_194d0cdeb831cfa2b391379571134333839c87a9.600x338.jpg?t=1766649466"}],"short_description":"Nonentity Galaxy is a corporate field-agent space strategy roguelite. Run contracts with your fleet, choose your way through battles and encounters, salvage &amp; recycle, and swap modules to snowball your build. Retreat to cut losses\u2014fees and deductions are part of the job.","steam_appid":3129930,"support_info":{"email":"support@2pgames.net","url":""},"supported_languages":"Simplified Chinese, English, Japanese","type":"game","website":null}