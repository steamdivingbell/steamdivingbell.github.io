.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812210/extras/67b4337cf458551ce81922f534be597f.poster.avif?t=1771165888\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812210/extras/67b4337cf458551ce81922f534be597f.webm?t=1771165888\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812210/extras/67b4337cf458551ce81922f534be597f.mp4?t=1771165888\" type=\"video/mp4\"></video></span></p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Firebirds Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812210/31702e16d526ee16a952a9b95a88010b83e75ba0/header.jpg?t=1771165888","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3812210/365126750/d6fc7eece3d964ffd133dbfd7c9da9fc52875a04/1768861102/dash_av1.mpd?t=1768861812","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3812210/365126750/d6fc7eece3d964ffd133dbfd7c9da9fc52875a04/1768861102/dash_h264.mpd?t=1768861812","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3812210/365126750/d6fc7eece3d964ffd133dbfd7c9da9fc52875a04/1768861102/hls_264_master.m3u8?t=1768861812","id":257268210,"name":"Firebird Gamep