/steam/apps/3062610/2f002807a1f93902a7cac01e278a519650b06e15/ss_2f002807a1f93902a7cac01e278a519650b06e15.1920x1080.jpg?t=1759595536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3062610/2f002807a1f93902a7cac01e278a519650b06e15/ss_2f002807a1f93902a7cac01e278a519650b06e15.600x338.jpg?t=1759595536"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3062610/625f47c285751ec400577f632a1a06691b1b602d/ss_625f47c285751ec400577f632a1a06691b1b602d.1920x1080.jpg?t=1759595536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3062610/625f47c285751ec400577f632a1a06691b1b602d/ss_625f47c285751ec400577f632a1a06691b1b602d.600x338.jpg?t=1759595536"}],"short_description":"Put your forensic skills to work in She's Leaving, a terrifying first-person survival horror thriller where the line between hunter and hunted is razor thin. Investigate, survive, and escape before the darkness consumes you.","steam_appid":3062610,"support_info":{"email":"sam@bluehatstudio.co.uk","url":"https://www.bluehatstudio.co.uk/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.bluehatstudio.co.uk/"}