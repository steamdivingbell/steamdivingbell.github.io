scription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Quiet as a Stone - $4.99 USD","packageid":275633,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":499}],"title":"Buy Quiet as a Stone"}],"packages":[275633],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel i3<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia 750<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Additional Notes:</strong> Current gaming PC or laptop highly recommended.</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel i7<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia 980ti<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Additional Notes:</strong> Current gaming PC or laptop highly recommended.</li></ul>"},"platforms":{"linux":false,"mac":true,"windows":true},"price_overview":{"currency":"USD","discount_percent":0,"final":499,"final_formatted":"$4.99 USD","initial":499,"initial_formatted":""},"publishers":["Distant Lantern Studios Ltd"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"igrs":{"banned":"0","descriptors":"","rating":"3","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":false,"date":"20 Nov, 2018"},"required_age":0,"reviews":"\u201cThe work you\u2019re celebrating and documenting here feels as much yours as the creators, and these shots of vanished worlds acquire a poignance no save file would match.\u201d<br>Kotaku UK<br><br>\u201cGames like Quiet as a Stone remind me of how beautiful and genuinely cool is it to be so engrossed with an artificial space. I\u2019ve gone from level to level until I\u2019ve found the perfect arrangement of ruins, zooming in close to admire them before framing them with my camera with the perfect combination of distance, light, and color. It helped me to see the beauty in small things: the errant blade of grass that slid into view, a serendipitously-shaped rock heap, the flickering heat of a fire slithering through mist. And it was all right at my fingertips.\u201d<br>Kotaku US<br><br>\u201cThe zen gardening of this microscopic tree plopper is on another level.\u201d<br>Rock Paper Shotgun<br>","screenshots":[{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/872060/ss_bd59f79eb12c9891cda2a217bbda9e4d6cc204c3.1920x1080.jpg?t=1764422522","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/872060/ss_bd59f79eb12c9891cda2a217bbda9e4d6cc204c3.600x338.jpg?t=1764422522"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/872060/ss_5ecf6f25798873e19a2aa33fe94fc49aa8d46381.1920x1080.jpg?t=1764422522","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/872060/ss_5ecf6f25798873e19a2aa33fe94fc49aa8d46381.600x338.jpg?t=1764422522"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/872060/ss_da4dba2fbe4793be8bd3c51fb25e141b2e022a17.1920x1080.jpg?t=1764422522","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/872060/ss_da4dba2fbe4793be8bd3c51fb25e141b2e022a17.600x338.jpg?t=1764422522"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/872060/ss_20c77f01343aebf3647e15f147a