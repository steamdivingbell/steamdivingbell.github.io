mstatic.com/store_item_assets/steam/apps/3816720/cb6fe0ba651ad7e4f6f2f524d03f4e2fac8dec39/ss_cb6fe0ba651ad7e4f6f2f524d03f4e2fac8dec39.600x338.jpg?t=1766135052"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816720/e36754adb3cf0f6c8b21b2bcd1d7a54afefef5a8/ss_e36754adb3cf0f6c8b21b2bcd1d7a54afefef5a8.1920x1080.jpg?t=1766135052","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816720/e36754adb3cf0f6c8b21b2bcd1d7a54afefef5a8/ss_e36754adb3cf0f6c8b21b2bcd1d7a54afefef5a8.600x338.jpg?t=1766135052"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816720/cf749e75b44221fe754961cf8c87ccd47a4a228e/ss_cf749e75b44221fe754961cf8c87ccd47a4a228e.1920x1080.jpg?t=1766135052","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816720/cf749e75b44221fe754961cf8c87ccd47a4a228e/ss_cf749e75b44221fe754961cf8c87ccd47a4a228e.600x338.jpg?t=1766135052"}],"short_description":"One day, A girl accidentally gets involved with the 'KEA (Korean Exorcist Association)' and the evil organization 'Lunacide'... Will be able to stop Lunacide's plot and be reborn as a proper exorcist?","steam_appid":3816720,"support_info":{"email":"teamdada0525@gmail.com","url":""},"supported_languages":"English, Japanese, Korean","type":"game","website":null}