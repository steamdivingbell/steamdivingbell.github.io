 run provides a new challenge with new strategies to explore!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">\u00a0 \u00a0<span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3303870/extras/8a00d8e06270447c44d0e412cc5f4737.poster.avif?t=1763918087\" width=696 height=392 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3303870/extras/8a00d8e06270447c44d0e412cc5f4737.webm?t=1763918087\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3303870/extras/8a00d8e06270447c44d0e412cc5f4737.mp4?t=1763918087\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>","developers":["KRNK Studios"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3303870/1369a5dabca275155a3b5ce1c9f9fb4ce8b2f04f/header.jpg?t=1763918087","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3303870/276786320/892482b60b020ed77f46c9d48bf556cd172fd751/1763916988/dash_av1.mpd?t=1763918085","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3303870/276786320/892482b60b020ed77f46c9d48bf556cd172fd751/1763916988/dash_h264.mpd?t=1763918085","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3303870/276786320/892482b60b020ed77f46c9d48bf556cd172fd751/1763916988/hls_264_master.m3u8?t=1763918085","id":257236626,"name":"Gameplay Trailer","thumbn