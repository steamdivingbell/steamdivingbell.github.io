ai.steamstatic.com/store_item_assets/steam/apps/2141520/82d119a7fa22b0774c9b90366a3d10df5a13b7ca/ss_82d119a7fa22b0774c9b90366a3d10df5a13b7ca.600x338.jpg?t=1768516879"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/fa8cf0ca9d8aae87876146cf3ae6a9724db1610a/ss_fa8cf0ca9d8aae87876146cf3ae6a9724db1610a.1920x1080.jpg?t=1768516879","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/fa8cf0ca9d8aae87876146cf3ae6a9724db1610a/ss_fa8cf0ca9d8aae87876146cf3ae6a9724db1610a.600x338.jpg?t=1768516879"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/5bdddb9d04ab2495e356262f412b7612fe1291e4/ss_5bdddb9d04ab2495e356262f412b7612fe1291e4.1920x1080.jpg?t=1768516879","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/5bdddb9d04ab2495e356262f412b7612fe1291e4/ss_5bdddb9d04ab2495e356262f412b7612fe1291e4.600x338.jpg?t=1768516879"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/771b1ddd6cc0d5c8293c8a98e6d6b9637b1a04b3/ss_771b1ddd6cc0d5c8293c8a98e6d6b9637b1a04b3.1920x1080.jpg?t=1768516879","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/771b1ddd6cc0d5c8293c8a98e6d6b9637b1a04b3/ss_771b1ddd6cc0d5c8293c8a98e6d6b9637b1a04b3.600x338.jpg?t=1768516879"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/9da9ae79f7b7174564495447996b2cb4f2bd28f7/ss_9da9ae79f7b7174564495447996b2cb4f2bd28f7.1920x1080.jpg?t=1768516879","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/9da9ae79f7b7174564495447996b2cb4f2bd28f7/ss_9da9ae79f7b7174564495447996b2cb4f2bd28f7.600x338.jpg?t=1768516879"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/72357bbf3848c9c14e4dc8f4769a2e7f5fc19a99/ss_72357bbf3848c9c14e4dc8f4769a2e7f5fc19a99.1920x1080.jpg?t=1768516879","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2141520/72357bbf3848c9c14e4dc8f4769a2e7f5fc19a99/ss_72357bbf3848c9c14e4dc8f4769a2e7f5fc19a99.600x338.jpg?t=1768516879"}],"short_description":"Purge the billionaires' robot army with your Merc squad! Fast-paced twin-stick action, frantic horde survival, tactical squad-building &amp; tons of loot! Exploit game-breaking synergies to beat the M.E.G.A. Corp. bosses in ever-changing operations. Lock, load, and loot, Commander!","steam_appid":2141520,"support_info":{"email":"","url":"https://discord.gg/8tCfF5MSEc"},"supported_languages":"English<strong>*</strong>, German, Simplified Chinese, Traditional Chinese, French, Italian, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Turkish, Ukrainian<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.survivormercs.com"}