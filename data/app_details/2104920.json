d<br>Comuesp<br>","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/8b43572e3719c3033fd4dd91658de04d286242ff/ss_8b43572e3719c3033fd4dd91658de04d286242ff.1920x1080.jpg?t=1767299069","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/8b43572e3719c3033fd4dd91658de04d286242ff/ss_8b43572e3719c3033fd4dd91658de04d286242ff.600x338.jpg?t=1767299069"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/c3237531c893a02222541d94ac7a78c93a5b1924/ss_c3237531c893a02222541d94ac7a78c93a5b1924.1920x1080.jpg?t=1767299069","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/c3237531c893a02222541d94ac7a78c93a5b1924/ss_c3237531c893a02222541d94ac7a78c93a5b1924.600x338.jpg?t=1767299069"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/23f068eee2211076f0e076a4113762016a521920/ss_23f068eee2211076f0e076a4113762016a521920.1920x1080.jpg?t=1767299069","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/23f068eee2211076f0e076a4113762016a521920/ss_23f068eee2211076f0e076a4113762016a521920.600x338.jpg?t=1767299069"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/854e6c9866001fb600d8996aacbe0e6adee846ac/ss_854e6c9866001fb600d8996aacbe0e6adee846ac.1920x1080.jpg?t=1767299069","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/854e6c9866001fb600d8996aacbe0e6adee846ac/ss_854e6c9866001fb600d8996aacbe0e6adee846ac.600x338.jpg?t=1767299069"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/1693f88ff9471c0dbd685887a70ea8bc47f5dd5d/ss_1693f88ff9471c0dbd685887a70ea8bc47f5dd5d.1920x1080.jpg?t=1767299069","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2104920/1693f88ff