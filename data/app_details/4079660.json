9660/extras/66211d9ac9e338093fa4c9bd3e00c68a.mp4?t=1768998667\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Make your own fit for the situation!</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Each run has <i>different items</i> you can find and purchase!</p></li><li><p class=\"bb_paragraph\" ><i>Customize your character stats</i> however you want with armor and tools!</p></li><li><p class=\"bb_paragraph\" >Make <i>strong characters!</i></p></li><li><p class=\"bb_paragraph\" >Make <i>nimble and fast characters!</i></p></li><li><p class=\"bb_paragraph\" >Make <i>overpowered characters</i> that exploit the entire game!</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079660/extras/062539cedc44c181e170bd2e8138c6f0.webp?t=1768998667\" width=626 height=50 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079660/extras/c6fe6e3de5ca5df4442f6fa721ca5c36.poster.avif?t=1768998667\" width=616 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079660/extras/c6fe6e3de5ca5df4442f6fa721ca5c36.webm?t=1768998667\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079660/extras/c6fe6e3de5ca5df4442f6fa721ca5c36.mp4?t=1768998667\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>You are not the only one on a quest for gems!</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Fight off many different enemies that want your gems!</p></li><li><p class=\"bb_paragraph\" >Find and fight unique bosses in the world for big rewards!</p></li><li><p class=\"bb_paragraph\" >Enemies vary in difficulty!</p></li></ul><p class=\"bb_parag