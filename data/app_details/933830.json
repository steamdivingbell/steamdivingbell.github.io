.<br></li><li>Expand your fleet and build an empire of harbors.<br></li><li>Level up Ships and harbors to strengthen your power.<br></li><li>Ships and harbors can be customized to suit your play style.</li></ul>","developers":["Korion Interactive"],"dlc":[1497260],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/933830/header.jpg?t=1759750042","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> tba</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> tba</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/933830/252712/eec2a5b1448f18e0e40cf32f3e985614340e08b1/1751165860/dash_av1.mpd?t=1573733516","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/933830/252712/eec2a5b1448f18e0e40cf32f3e985614340e08b1/1751165860/dash_h264.mpd?t=1573733516","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/933830/252712/eec2a5b1448f18e0e40cf32f3e985614340e08b1/1751165860/hls_264_master.m3u8?t=1573733516","id":256767248,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/256767248/movie480.mp4?t=1573733516","max":"https://video.akamai.steamstatic.com/store_trailers/256767248/movie_max.mp4?t=1573733516"},"name":"EA Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256767248/movie.293x165.jpg?t=1573733516","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/256767248/movie480.webm?t=1573733516","max":"https://video.akamai.steamstatic.com/store_trailers/256767248/movie_max.webm?t=1573733516"}}],"name":"Of Ships & Scoundrels","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"b