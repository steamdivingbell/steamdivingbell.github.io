i.steamstatic.com/store_item_assets/steam/apps/3955070/e02f2f2046411e3833e8d6c97498b7695817d754/ss_e02f2f2046411e3833e8d6c97498b7695817d754.600x338.jpg?t=1761241721"}],"short_description":"Use natural resources in your environment to cast epic elemental spells! In this turn-based strategy game, every stone, tree and flame is yours to control. Discover new spell cards and outwit cunning enemies!","steam_appid":3955070,"support_info":{"email":"catilians@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":null}