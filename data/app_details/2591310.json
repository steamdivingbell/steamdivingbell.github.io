ltiplayer</strong> for <strong>up to 4 players</strong>.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Whether you're a competitive player or a lifelong fan, it\u2019s time to bring your skills to the digital court.</p>","developers":["DS SOFT"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Sports","id":"18"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2591310/4e85d52fc3cb6acaac03c264c88f757fef01a226/header.jpg?t=1756914800","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 20.04, Ubuntu 18.04, and CentOS 7<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 20.04, Ubuntu 18.04, and CentOS 7<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mojave 10.14+<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mojave 10.14+<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>"},"movies":[{"highlight":true,"id":257163599,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257163599/movie480.mp4?t=1751539028","max":"http://video.akamai.steamstatic.com/store_trailers/257163599/movie_max.mp4?t=1751539028"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257163599/a3a0a9da19cde113d6e8f2e215df0ed3beeb736d/movie_600x337.jpg?t=1751539028","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257163599/movie480_vp9.webm?t=1751539028","max":"http://video.akamai.steamstatic.com/store_trailers/257163599/movie_max_vp9.webm?t=1751539028"}},{"highlight":true,"id":2