11/ss_d44e46bcae0d643336dfa539484df0035f43d411.600x338.jpg?t=1774187239"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3655610/a1a0328d5df8404535a474a3cd99660bbb939a98/ss_a1a0328d5df8404535a474a3cd99660bbb939a98.1920x1080.jpg?t=1774187239","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3655610/a1a0328d5df8404535a474a3cd99660bbb939a98/ss_a1a0328d5df8404535a474a3cd99660bbb939a98.600x338.jpg?t=1774187239"}],"short_description":"Drop, stack, and merge colorful pan dulce into bigger, tastier treats in this cozy puzzle adventure! With charming visuals and simple gameplay, it\u2019s a sweet celebration of Mexican baking, perfect for quick sessions and high score chases.","steam_appid":3655610,"support_info":{"email":"","url":"https://fayer.dev"},"supported_languages":"English, Spanish - Latin America, Japanese, Portuguese - Brazil","type":"game","website":null}