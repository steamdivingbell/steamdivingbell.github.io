rkt, um nicht nur k\u00fcnstlerisch, sondern auch kommerziell erfolgreich zu sein.</p></li></ul>","developers":["SchnoxCore"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4110460/439cd628f87b6f1d42d6143e8f2b2f2a0cbb4724/header.jpg?t=1761902385","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4110460/1578983692/ac94dcfafc8dcccd91fe27b08913c9e02af9af87/1760973017/dash_av1.mpd?t=1761893754","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4110460/1578983692/ac94dcfafc8dcccd91fe27b08913c9e02af9af87/1760973017/dash_h264.mpd?t=1761893754","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4110460/1578983692/ac94dcfafc8dcccd91fe27b08913c9e02af9af87/1760973017/hls_264_master.m3u8?t=1761893754","id":257217758,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257217758/movie480.mp4?t=1761893754","max":"https://video.akamai.steamstatic.com/store_trailers/257217758/movie_max.mp4?t=1761893754"},"name":"Movie Business","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257217758/eb93526fc0aa5a12cc0c2b4b92fc2fb4e5a7fe23/movie_600x337.jpg?t=1761893754","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257217758/movie480.webm?t=1761893754","max":"https://video.akamai.steamstatic.com/store_trailers/257217758/movie_max.webm?t=1761893754"}}],"name":"Movie Business - Die Welt der Filme","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> Dual-Core-Prozessor mit 2.0 GHz oder mehr<br></li><li><strong>Memory:</strong> 4  GB RAM<br></li><li><strong>Graphics:</strong> Integrierte Grafikkarte - DirectX 11 oder OpenGL 3.3