"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2942500/extras/82307eb94cbf5641b29bf46beee2438c.poster.avif?t=1771952457\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2942500/extras/82307eb94cbf5641b29bf46beee2438c.webm?t=1771952457\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2942500/extras/82307eb94cbf5641b29bf46beee2438c.mp4?t=1771952457\" type=\"video/mp4\"></video></span></p>","developers":["Tofu Soup"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2942500/7985a246b2078bd291980ada9f88601f3eb9295c/header.jpg?t=1771952457","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2942500/903913987/3c681b3f4a3f9a9c904aa6eb19c427630a8f12cb/1771945030/dash_av1.mpd?t=1771952456","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2942500/903913987/3c681b3f4a3f9a9c904aa6eb19c427630a8f12cb/1771945030/dash_h264.mpd?t=1771952456","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2942500/903913987/3c681b3f4a3f9a9c904aa6eb19c427630a8f12cb/1771945030/hls_264_master.m3u8?t=1771952456","id":257293678,"name":"HellDropTrailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257293678/b942d12f843fc0b4202e0d75e10c9de203cfc65c/movie_600x337.jpg?t=1771952456"}],"name":"HELLDROP","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7/8/10 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3-2100 or AMD A8-5600K<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><st