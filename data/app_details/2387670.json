mai.steamstatic.com/store_item_assets/steam/apps/2387670/ss_a31dbee5d986bb29faae8d910c769716ec092b1e.1920x1080.jpg?t=1765958772","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2387670/ss_a31dbee5d986bb29faae8d910c769716ec092b1e.600x338.jpg?t=1765958772"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2387670/ss_d801500d19e689db1cc197247d728b5efba50621.1920x1080.jpg?t=1765958772","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2387670/ss_d801500d19e689db1cc197247d728b5efba50621.600x338.jpg?t=1765958772"}],"short_description":"Survive in a post-apocalyptic world. Form a community, scavenge resources, build facilities, and defend yourself against a lawless world while joining a father's desperate journey to save his sick daughter.","steam_appid":2387670,"support_info":{"email":"Revelation_Games_LLC","url":"https://www.facebook.com/asonewesurvive"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://wesurvive-game.com/"}