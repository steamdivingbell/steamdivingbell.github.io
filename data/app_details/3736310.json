73505005\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Team up with a friend and dive into thrilling underwater battles in the deep sea. Coordinate, complement each other\u2019s weaknesses, and write your own legendary story beneath the waves!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3736310/extras/ea336ca243a0699b7ed9b7ca98e7ac68.poster.avif?t=1773505005\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3736310/extras/ea336ca243a0699b7ed9b7ca98e7ac68.webm?t=1773505005\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3736310/extras/ea336ca243a0699b7ed9b7ca98e7ac68.mp4?t=1773505005\" type=\"video/mp4\"></video></span></p>","developers":["Woodpecker"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3736310/bd92bda56e6f1c6c5d9f277d85285930e8c7e685/header.jpg?t=1773505005","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3736310/20890175/5052c68f225d6e5fcdafe56fde11e021e9ed758f/1761928837/dash_av1.mpd?t=1768376198","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3736310/20890175/5052c68f225d6e5fcdafe56fde11e021e9ed758f/1761928837/dash_h264.mpd?t=1768376198","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3736310/20890175/5052c68