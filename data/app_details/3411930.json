teamstatic.com/store_item_assets/steam/apps/3411930/97cb0ad5b083f900a5131a3ed6f7d1656873e16a/ss_97cb0ad5b083f900a5131a3ed6f7d1656873e16a.600x338.jpg?t=1743582731"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411930/7ac6a8db844d2e3409ec70e17609591b99fccc5b/ss_7ac6a8db844d2e3409ec70e17609591b99fccc5b.1920x1080.jpg?t=1743582731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411930/7ac6a8db844d2e3409ec70e17609591b99fccc5b/ss_7ac6a8db844d2e3409ec70e17609591b99fccc5b.600x338.jpg?t=1743582731"}],"short_description":"SIN CARDS is a horror deckbuilder where every card brings you closer to salvation or damnation. Face terrifying demons, uncover dark lore, and survive a world of permadeath where every choice could be your last.","steam_appid":3411930,"support_info":{"email":"lightsmit5@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}