iption":"Well Keeper is a Bullet Hell Shoot `Em Up where you move by flapping. Battle waves of enemies, upgrade unique and unexpected abilities and become immensely powerful.","steam_appid":3994590,"support_info":{"email":"corporatepotato.help@gmail.com","url":""},"supported_languages":"English, Japanese, Korean, Simplified Chinese, Traditional Chinese","type":"demo","website":"https://www.corporatepotato.com/"}