69650/extras/373c1788dc6343daaa2b507aa5b74227.webm?t=1770238779\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3269650/extras/373c1788dc6343daaa2b507aa5b74227.mp4?t=1770238779\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Choose from a variety of random upgrades and power-ups as you gain experience. Shape your playstyle with unique abilities and powerful boosts each time you level up.</p><h2 class=\"bb_tag\" ><strong>Dynamic Combat</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3269650/extras/b768654b092d1ed1a80e75d442a0d302.poster.avif?t=1770238779\" width=800 height=242 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3269650/extras/b768654b092d1ed1a80e75d442a0d302.webm?t=1770238779\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3269650/extras/b768654b092d1ed1a80e75d442a0d302.mp4?t=1770238779\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Combine melee and ranged attacks, and unleash abilities tied to your gear for fast-paced, action-packed combat. And when you feel ready, challenge the powerful bosses that lurk under the island for the ultimate test of your skills.</p><h2 class=\"bb_tag\" ><strong>Survive Together in Co-op</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3269650/extras/abad64a89107608831e8c072f7df84d1.avif?t=1770238779\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3269650/extras_big/abad64a89107608831e8c072f7df84d1.avif?t=1770238779 width=800 height=230 /></span></p><p class=\"bb_paragraph\" >Team up with friends. Share resources, strategize together, and gear up to face even tougher waves of enemies.</p><p class=\"bb_paragraph\" ></p>","developers":["BehaUlas"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3269650/6dc56f385468ec7739e30905bd05820b0e2171f6/header.jpg?t=1770238779","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3269650/772642/9e4c597b300f9191fff174e6e9f5e9d6f92e769c/1750886336/dash_av1.mpd?t=1729051106","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3269650/772642/9e4c597b300f9191fff174e6e9f5e9d6f92e769c/1750886336/dash_h264.mpd?t=1729051106","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3269650/772642/9e4c597b300f9191fff174e6e9f5e9d6f92e769c/1750886336/hls_264_master.m3u8?t=1729051106","id":257065644,"name":"Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257065644/0330d38b91743d376f713a54025c99c9c687c1d9/movie_600x337.jpg?t=1729051106"}],"name":"Isle of the Night: Pirate Survivors","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Isle of the Night - $2.99 USD","packageid":1158495,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":299}],"title":"Buy Isle of the Night: Pirate Survivors"}],"packages":[1158495],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7<br></li><li><strong>Processor:</strong> Dual Core 2.4Ghz<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> GeForce 8800 GT / AMD HD 6