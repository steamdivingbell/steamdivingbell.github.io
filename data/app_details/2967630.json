cc0356094deb147dbfb4.1920x1080.jpg?t=1748948099","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_068510b20eecf71b901acc0356094deb147dbfb4.600x338.jpg?t=1748948099"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_8fab28fabd29eefc086d724c8da80ae07bb21261.1920x1080.jpg?t=1748948099","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_8fab28fabd29eefc086d724c8da80ae07bb21261.600x338.jpg?t=1748948099"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_1d24bef991fd1feb01dd8741a9c90bfec939af96.1920x1080.jpg?t=1748948099","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_1d24bef991fd1feb01dd8741a9c90bfec939af96.600x338.jpg?t=1748948099"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_4a53570eb0e8f0605e8bb0841bae359d94733482.1920x1080.jpg?t=1748948099","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_4a53570eb0e8f0605e8bb0841bae359d94733482.600x338.jpg?t=1748948099"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_7085fbdf11865ae51ba3715f95b7744c19315750.1920x1080.jpg?t=1748948099","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967630/ss_7085fbdf11865ae51ba3715f95b7744c19315750.600x338.jpg?t=1748948099"}],"short_description":"A pointy-clicky corporate thriller that'll make you laugh, think, and probably quit your job. Just remember the company motto: There is NOTHING sinister happening at Biggleboss Inc.","steam_appid":2967630,"support_info":{"email":"","url":"http://www.bunkworks.net"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}