8.1920x1080.jpg?t=1764522518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059210/24bf76cef1807216b86b872ecb9304968ca22b38/ss_24bf76cef1807216b86b872ecb9304968ca22b38.600x338.jpg?t=1764522518"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059210/3325b654246ab761132983c2b9e92e7cccb495ef/ss_3325b654246ab761132983c2b9e92e7cccb495ef.1920x1080.jpg?t=1764522518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059210/3325b654246ab761132983c2b9e92e7cccb495ef/ss_3325b654246ab761132983c2b9e92e7cccb495ef.600x338.jpg?t=1764522518"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059210/f9c99c90c4e4bae69a888d2d14cac64c19a71207/ss_f9c99c90c4e4bae69a888d2d14cac64c19a71207.1920x1080.jpg?t=1764522518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059210/f9c99c90c4e4bae69a888d2d14cac64c19a71207/ss_f9c99c90c4e4bae69a888d2d14cac64c19a71207.600x338.jpg?t=1764522518"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059210/80ce991f13f7bd187095c77c7a450bf0ba467373/ss_80ce991f13f7bd187095c77c7a450bf0ba467373.1920x1080.jpg?t=1764522518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059210/80ce991f13f7bd187095c77c7a450bf0ba467373/ss_80ce991f13f7bd187095c77c7a450bf0ba467373.600x338.jpg?t=1764522518"}],"short_description":"Dive into memories of a serial killer in this deeply disturbing future world, where people are just toys to the rich. Experience a vibrant yet gritty comic book style, and a twisted tree of choices. How deep will you go before you lose yourself?","steam_appid":4059210,"support_info":{"email":"sethodale@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}