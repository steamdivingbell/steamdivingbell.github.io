e2f74dd5c675a3fc4d/ss_85340bef4a72e752d7931be2f74dd5c675a3fc4d.1920x1080.jpg?t=1773407703","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3766600/85340bef4a72e752d7931be2f74dd5c675a3fc4d/ss_85340bef4a72e752d7931be2f74dd5c675a3fc4d.600x338.jpg?t=1773407703"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3766600/64a67e5e55d91e0464164a9b4ec5c33a0f88786b/ss_64a67e5e55d91e0464164a9b4ec5c33a0f88786b.1920x1080.jpg?t=1773407703","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3766600/64a67e5e55d91e0464164a9b4ec5c33a0f88786b/ss_64a67e5e55d91e0464164a9b4ec5c33a0f88786b.600x338.jpg?t=1773407703"}],"short_description":"In a world haunted by echoes of ancient magic, young Lioren discovers a connection to reality-warping anomalies: Himself. Join him on a dangerous journey to discover the secrets of his connection to a rapidly destabilizing realm in a classic, story-driven JRPG - and decide the fate of the world!","steam_appid":3766600,"support_info":{"email":"","url":""},"supported_languages":"English","type":"game","website":null}