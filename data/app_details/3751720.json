13d914db.1920x1080.jpg?t=1751293809","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3751720/64edc595d7678d285beb1851a729f0e413d914db/ss_64edc595d7678d285beb1851a729f0e413d914db.600x338.jpg?t=1751293809"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3751720/97c7038de3ac260ff9cbb5c58754b169a0909e3b/ss_97c7038de3ac260ff9cbb5c58754b169a0909e3b.1920x1080.jpg?t=1751293809","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3751720/97c7038de3ac260ff9cbb5c58754b169a0909e3b/ss_97c7038de3ac260ff9cbb5c58754b169a0909e3b.600x338.jpg?t=1751293809"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3751720/e3dc8dabee3c8bfe022bfbafeb96d10d4670f985/ss_e3dc8dabee3c8bfe022bfbafeb96d10d4670f985.1920x1080.jpg?t=1751293809","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3751720/e3dc8dabee3c8bfe022bfbafeb96d10d4670f985/ss_e3dc8dabee3c8bfe022bfbafeb96d10d4670f985.600x338.jpg?t=1751293809"}],"short_description":"Dungeon Directive is a strategic guild management simulator and auto battler where you lead from the safety of your guild. Recruit heroes, design your guildhall, and send adventuring parties into auto-battler dungeon runs\u2014where survival is never guaranteed.","steam_appid":3751720,"support_info":{"email":"DungeonDirective@gmail.com","url":"https://dungeondirective.wixsite.com/dungeon-directive"},"supported_languages":"English, French, Spanish - Spain, Japanese, Traditional Chinese, Russian","type":"game","website":null}