ai.steamstatic.com/store_item_assets/steam/apps/3393190/c50fbd05d50a74755c6e9c84f6e81afdedc29c1a/ss_c50fbd05d50a74755c6e9c84f6e81afdedc29c1a.600x338.jpg?t=1760465174"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/168d2089bebcfec7a7dff829228bb1903a4222fc/ss_168d2089bebcfec7a7dff829228bb1903a4222fc.1920x1080.jpg?t=1760465174","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/168d2089bebcfec7a7dff829228bb1903a4222fc/ss_168d2089bebcfec7a7dff829228bb1903a4222fc.600x338.jpg?t=1760465174"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/f3650bfe9020dcc66a334f749c1630883f4c97cb/ss_f3650bfe9020dcc66a334f749c1630883f4c97cb.1920x1080.jpg?t=1760465174","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/f3650bfe9020dcc66a334f749c1630883f4c97cb/ss_f3650bfe9020dcc66a334f749c1630883f4c97cb.600x338.jpg?t=1760465174"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/390f69f918dc27fa34e3863b62a2dc259d4c1602/ss_390f69f918dc27fa34e3863b62a2dc259d4c1602.1920x1080.jpg?t=1760465174","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/390f69f918dc27fa34e3863b62a2dc259d4c1602/ss_390f69f918dc27fa34e3863b62a2dc259d4c1602.600x338.jpg?t=1760465174"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/3d112db71ff1800b39b18eeb6f0b31f59f217d7d/ss_3d112db71ff1800b39b18eeb6f0b31f59f217d7d.1920x1080.jpg?t=1760465174","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/3d112db71ff1800b39b18eeb6f0b31f59f217d7d/ss_3d112db71ff1800b39b18eeb6f0b31f59f217d7d.600x338.jpg?t=1760465174"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393190/514554c12df55902f3c2780dc801ee0b3c9c02c3/ss_514554c12df55902f3c2780dc801ee0b3c9