rsion. There are no functional limitations, but there are some areas that cannot be reached.</p><p class=\"bb_paragraph\">It will end at the beginning of the story and you will not be able to proceed further.</p><p class=\"bb_paragraph\"></p>","developers":["Muramasa Fudo"],"fullgame":{"appid":"3533360","name":"Filiy Eclipse"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3642680/e0dda89031faa97cc1b7495d23fc46688c7845d4/header.jpg?t=1748053807","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257127778,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127778/movie480.mp4?t=1748053802","max":"http://video.akamai.steamstatic.com/store_trailers/257127778/movie_max.mp4?t=1748053802"},"name":"Filiy_Eclipse02","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257127778/049f50eab998e7a87efcae20b5de44fc1f7eb843/movie_600x337.jpg?t=1748053802","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127778/movie480_vp9.webm?t=1748053802","max":"http://video.akamai.steamstatic.com/store_trailers/257127778/movie_max_vp9.webm?t=1748053802"}},{"highlight":true,"id":257124769,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257124769/movie480.mp4?t=1748053805","max":"http://video.akamai.steamstatic.com/store_trailers/257124769/movie_max.mp4?t=1748053805"},"name":"Filiy Eclipse01","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257124769/91877b3e054554ff6b7eb926409e73df67391b6d/movie_600x337.jpg?t=1748053805","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257124769/movie480_vp9.webm?t=1748053805","max":"http://video.akamai.steamstatic.com/store_trailers/257124769/movie_max_vp9.webm?t=1748053805"}}],"name":"Filiy Eclipse Demo","pac