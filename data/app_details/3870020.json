84879919b2b580/ss_ed38c8888f945db3cf66d3720a84879919b2b580.1920x1080.jpg?t=1757388859","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3870020/ed38c8888f945db3cf66d3720a84879919b2b580/ss_ed38c8888f945db3cf66d3720a84879919b2b580.600x338.jpg?t=1757388859"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3870020/ae93493b38b936e6f83ce31884e6847a393380f1/ss_ae93493b38b936e6f83ce31884e6847a393380f1.1920x1080.jpg?t=1757388859","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3870020/ae93493b38b936e6f83ce31884e6847a393380f1/ss_ae93493b38b936e6f83ce31884e6847a393380f1.600x338.jpg?t=1757388859"}],"short_description":"The mirror calls to you. Down the endless corridor, aged walls and flickering lights cross paths. As your footsteps echo with every step, why do you find yourself frozen before the mirror? Then again, maybe it's not a mirror at all.","steam_appid":3870020,"support_info":{"email":"lunanodthecreators@gmail.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Russian, Japanese, Simplified Chinese, Portuguese - Brazil, Polish, Korean","type":"game","website":null}