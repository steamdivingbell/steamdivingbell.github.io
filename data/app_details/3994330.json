ed.akamai.steamstatic.com/store_item_assets/steam/apps/3994330/a17a5576c79de7ff151d533c1c5276be00d05c67/ss_a17a5576c79de7ff151d533c1c5276be00d05c67.600x338.jpg?t=1769074530"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3994330/b2ffef83fa15dfa2aecdbabf62feec1b90ec7b1d/ss_b2ffef83fa15dfa2aecdbabf62feec1b90ec7b1d.1920x1080.jpg?t=1769074530","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3994330/b2ffef83fa15dfa2aecdbabf62feec1b90ec7b1d/ss_b2ffef83fa15dfa2aecdbabf62feec1b90ec7b1d.600x338.jpg?t=1769074530"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3994330/bd6df3cecea51355f97f1b414cbd4c0586814c05/ss_bd6df3cecea51355f97f1b414cbd4c0586814c05.1920x1080.jpg?t=1769074530","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3994330/bd6df3cecea51355f97f1b414cbd4c0586814c05/ss_bd6df3cecea51355f97f1b414cbd4c0586814c05.600x338.jpg?t=1769074530"}],"short_description":"Rampage through a sprawling cityscape, smashing buildings, tossing cars, and leaving a trail of destruction. But it\u2019s not that simple - the military is coming for you! Helicopters swarm, tanks roll in, and ground forces fight back with everything they've got.","steam_appid":3994330,"support_info":{"email":"support@takeitstudio.com","url":"https://takeitstudio.com/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Traditional Chinese, Simplified Chinese, Danish, Dutch, Japanese, Korean, Polish, Portuguese - Portugal, Portuguese - Brazil, Turkish","type":"game","website":"https://takeitstudio.com/"}