cfb9073dbb9725535359497f8d764a039b.1920x1080.jpg?t=1772523206","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_65f16fcfb9073dbb9725535359497f8d764a039b.600x338.jpg?t=1772523206"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_ff0526a8587359bd09438d80a91d81cd82da581f.1920x1080.jpg?t=1772523206","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_ff0526a8587359bd09438d80a91d81cd82da581f.600x338.jpg?t=1772523206"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_99d134c5b4b5f8a163a28791b2b065c712fbcf9e.1920x1080.jpg?t=1772523206","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_99d134c5b4b5f8a163a28791b2b065c712fbcf9e.600x338.jpg?t=1772523206"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_dcaa6313493f7acfe2a9c511828acd7f240c0db8.1920x1080.jpg?t=1772523206","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_dcaa6313493f7acfe2a9c511828acd7f240c0db8.600x338.jpg?t=1772523206"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_296d1ea018ebdfd2f71039457db5c6b68cfe5044.1920x1080.jpg?t=1772523206","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_296d1ea018ebdfd2f71039457db5c6b68cfe5044.600x338.jpg?t=1772523206"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_98b0245d17b0d1fd65940b43589e53f7ce660ba2.1920x1080.jpg?t=1772523206","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_98b0245d17b0d1fd65940b43589e53f7ce660ba2.600x338.jpg?t=1772523206"},{"id":17,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_37af96415c894350926d57b4f576b764cb0e3523.1920x1080.jpg?t=1772523206","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2488290/ss_37af96415c894350926d57b4f576b764cb0e3523.600x338.jpg?t=1772523206"}],"short_description":"The legendary beat \u2019em up series from Jaleco returns. Master trained fighters take on a rising evil with raw strength and refined technique. Built around easy-to-use auto-combos, the game lets skilled players weave powerful strings for exhilarating combat. Let your fists burn with fury once more.","steam_appid":2488290,"support_info":{"email":"game@city-connection.co.jp","url":""},"supported_languages":"English","type":"game","website":"https://city-connection.co.jp/rushingbeatx/"}