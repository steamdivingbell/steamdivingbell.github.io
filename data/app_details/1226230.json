230/extras/d1f8a5d6e961daec5e9e477bd60f5d92.webm?t=1581660477\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1226230/extras/d1f8a5d6e961daec5e9e477bd60f5d92.mp4?t=1581660477\" type=\"video/mp4\"></video></span><br><br><ul class=\"bb_ul\"><li> Special Endings</li></ul>There's Easy, Normal and Hard difficulties! Of the 4 playable characters, each have their own special playable level when you beat the game on Easy or Normal. Beating the game on Hard will grant you a different ending!<br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1226230/extras/e305f09f6bfeebb67c3257e915f27aae.avif?t=1581660477\" width=480 height=270 /></span><br><br><ul class=\"bb_ul\"><li> The Beast in Me</li></ul>Halfway through each level, you find a Witch who will turn you into a powerful Beast, giving you full health and speed to help you Escape From The Grim!<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1226230/extras/e7025579baa8bd21667f0d0a7051836d.poster.avif?t=1581660477\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1226230/extras/e7025579baa8bd21667f0d0a7051836d.webm?t=1581660477\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1226230/extras/e7025579baa8bd21667f0d0a7051836d.mp4?t=1581660477\" type=\"video/mp4\"></video></span>","developers":["NG Smith"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1226230/header.jpg?t=1581660477","is_free":false,"legal_notice":"\u00a92020 NG Smith","linux_requirements":[],"mac_requirements