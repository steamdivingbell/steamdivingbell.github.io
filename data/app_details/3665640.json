tore_item_assets/steam/apps/3665640/b5e1db1485eea8ae7cbc10fb04af611f90a66b1b/ss_b5e1db1485eea8ae7cbc10fb04af611f90a66b1b.600x338.jpg?t=1763627139"}],"short_description":"A difficult game where you click pachinko balls and get paid when they reach the top of the level. Buy upgrades to earn even more money and get enough to complete the objectives before time runs out. Each run gives you more upgrade options so you can get really rich and earn a quadrillion dollars.","steam_appid":3665640,"support_info":{"email":"steamsupport@bergeronimo.com","url":""},"supported_languages":"English","type":"game","website":null}