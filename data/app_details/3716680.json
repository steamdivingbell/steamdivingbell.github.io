tore_item_assets/steam/apps/3716680/361045f43800ad73acf4728e439dbefea552143e/ss_361045f43800ad73acf4728e439dbefea552143e.600x338.jpg?t=1746815306"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3716680/2108d3aa4972dba10b5648d55914a7003836c0e4/ss_2108d3aa4972dba10b5648d55914a7003836c0e4.1920x1080.jpg?t=1746815306","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3716680/2108d3aa4972dba10b5648d55914a7003836c0e4/ss_2108d3aa4972dba10b5648d55914a7003836c0e4.600x338.jpg?t=1746815306"}],"short_description":"Sizzle &amp; Stack is a fast-paced restaurant management card game where you stack ingredients, cook dishes, explore recipes, and serve hungry customers. Upgrade your kitchen and master strategic cooking in a unique blend of card play and time management!","steam_appid":3716680,"support_info":{"email":"alper@arvisgames.com","url":""},"supported_languages":"English","type":"demo","website":null}