_paragraph\" >Choose which <strong>primary monitor</strong> displays the island.</p><p class=\"bb_paragraph\" >Enable <strong>auto-start</strong> with Windows to have Ghostly ready at boot.</p><p class=\"bb_paragraph\" ></p>","developers":["Holy Panda"],"genres":[{"description":"Utilities","id":"57"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3502190/header.jpg?t=1752952324","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3502190/1203164524/1a8bf258a24fc5c9873aa8a566d58592d6d5a1c4/1752689925/dash_av1.mpd?t=1752690579","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3502190/1203164524/1a8bf258a24fc5c9873aa8a566d58592d6d5a1c4/1752689925/dash_h264.mpd?t=1752690579","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3502190/1203164524/1a8bf258a24fc5c9873aa8a566d58592d6d5a1c4/1752689925/hls_264_master.m3u8?t=1752690579","id":257169865,"name":"Ghostly Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257169865/ef0150290c8307bd021ab6e15adad240bd12e70c/movie_600x337.jpg?t=1752690579"}],"name":"Ghostly","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Ghostly - <span class=\"discount_original_price\">$7.99</span> $6.39 USD","packageid":1236645,"percent_savings":0,"percent_savings_text":"-20% ","price_in_cents_with_discount":639}],"title":"Buy Ghostly"}],"packages":[1236645],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 11<br></li><li><strong>Processor:</strong> 1.66 GHz Intel i5 or equivalent<br></li><li><strong>Memory:</strong> 1024 MB RAM<br></li><li><strong>Graphics:</strong> HD Graph