2092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3217900/0cb9789e8eed3debbc277bad26f9dcf32e257a27/ss_0cb9789e8eed3debbc277bad26f9dcf32e257a27.600x338.jpg?t=1771462092"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3217900/4436bd3b1764f2bbd120587ac47262bd37dfd0aa/ss_4436bd3b1764f2bbd120587ac47262bd37dfd0aa.1920x1080.jpg?t=1771462092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3217900/4436bd3b1764f2bbd120587ac47262bd37dfd0aa/ss_4436bd3b1764f2bbd120587ac47262bd37dfd0aa.600x338.jpg?t=1771462092"}],"short_description":"Step into the arena in this fast-paced arcade shooter where staying on beat matters just as much as taking out your enemies. Fight across themed maps, seize control of the dance pad, and hold the rhythm while everyone else tries to blast you off it.","steam_appid":3217900,"support_info":{"email":"slothkingau@gmail.com","url":"https://slothking.au"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":"https://slothking.au"}