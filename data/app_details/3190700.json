43f9f9bbee1f7a9f95dfa3029ba5.600x338.jpg?t=1772197334"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190700/12f90225991313c8be7ab92e3c275a651ede9fae/ss_12f90225991313c8be7ab92e3c275a651ede9fae.1920x1080.jpg?t=1772197334","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190700/12f90225991313c8be7ab92e3c275a651ede9fae/ss_12f90225991313c8be7ab92e3c275a651ede9fae.600x338.jpg?t=1772197334"}],"short_description":"Midnight Looters is a 1-4 player co-op horror game where you and your friends explore mysterious forests to find valuable treasures. Face supernatural dangers, collect items, and upgrade your gear to survive the haunted woods.","steam_appid":3190700,"support_info":{"email":"ecowebtasarimm@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://midnightlooters.com"}