id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3336670/876aea415d1896a459e41913656de894ce4e3309/ss_876aea415d1896a459e41913656de894ce4e3309.1920x1080.jpg?t=1766939298","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3336670/876aea415d1896a459e41913656de894ce4e3309/ss_876aea415d1896a459e41913656de894ce4e3309.600x338.jpg?t=1766939298"}],"short_description":"A boy bargained his memories for the ability to imagine. Now, his hometown of Tempo is a nostalgic blur between reality and imagination. A voice called Intrusion guides him as he uncovers fragments of a past he traded away\u2014before his identity fades completely.","steam_appid":3336670,"support_info":{"email":"l1fuchsia@gmail.com","url":"https://noidnoidnoid.github.io/3D-Portfolio/"},"supported_languages":"English<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Japanese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}