=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Build ships to carry your resources from your mining operation, to the factories, and finally arriving at the cities for profit. All in classic transportation tycoon style.</p>","developers":["SuperChicken Productions LLC"],"fullgame":{"appid":"3433600","name":"Space Sim Tycoon"},"genres":[{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4061290/12d2470cafe7d1ae40b3e7d5b387a1176fa333ff/header.jpg?t=1759006012","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4061290/1849619958/5e2c6a4521f74e3add6d22ef023566794f33a988/1758745360/dash_av1.mpd?t=1758873871","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4061290/1849619958/5e2c6a4521f74e3add6d22ef023566794f33a988/1758745360/dash_h264.mpd?t=1758873871","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4061290/1849619958/5e2c6a4521f74e3add6d22ef023566794f33a988/1758745360/hls_264_master.m3u8?t=1758873871","id":257205659,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257205659/movie480.mp4?t=1758873871","max":"https://video.akamai.steamstatic.com/store_trailers/257205659/movie_max.mp4?t=1758873871"},"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257205659/ce42d9562787c1da547f6d943161f789ddbe2cd2/movie_600x337.jpg?t=1758873871","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257205659/movie480_vp9.webm?t=1758873871","max":"https://video.akamai.steamsta