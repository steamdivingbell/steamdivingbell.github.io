ai.steamstatic.com/store_item_assets/steam/apps/3820950/extras/242414c24777e88112ecbbcbff9554c0.avif?t=1767767294\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820950/extras_big/242414c24777e88112ecbbcbff9554c0.avif?t=1767767294 width=800 height=448 /></span></p>","developers":["Sef"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820950/1f5eab81cc5e99e47c1bd82ac91cb66416690c9d/header.jpg?t=1767767294","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3820950/2075454019/a3c4ca28065873269fddccd5f300acc714d0cb2d/1750364457/dash_av1.mpd?t=1754049882","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3820950/2075454019/a3c4ca28065873269fddccd5f300acc714d0cb2d/1750364457/dash_h264.mpd?t=1754049882","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3820950/2075454019/a3c4ca28065873269fddccd5f300acc714d0cb2d/1750364457/hls_264_master.m3u8?t=1754049882","id":257157064,"name":"Trailer 1","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257157064/eaa4a2a507cae8bcdc6af3b071ee046da60be9b9/movie_600x337.jpg?t=1754049882"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3820950/1171936803/15ebcfeb7a1491a0950ae3ff9a92d0912010b5a9/1754042930/dash_av1.mpd?t=1754049879","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3820950/1171936803/15ebcfeb7a1491a0950ae3ff9a92d0912010b5a9/1754042930/dash_h264.mpd?t=1754049879","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3820950/1171936803/15ebcfeb7a1491a0950ae3ff9a92d0912010b5a9/1754042930/hls_264_master.m3u8?t=1754049879","