extras/3ec96c4caee5c861692f7835a1acc4aa.mp4?t=1758684401\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Take the least amount of time possible!</h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >For the &quot;not quite normal people&quot; crowd, Arm Around! has a built-in online leader board system which keeps track of every record on every chapter. Best your friend's time to show off or even get to the top of the world-wide leader board to earn a well deserved (and very exclusive) achievement.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3072400/extras/8233e568f1c311c53c319ea5e0cd9a4f.poster.avif?t=1758684401\" width=620 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3072400/extras/8233e568f1c311c53c319ea5e0cd9a4f.webm?t=1758684401\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3072400/extras/8233e568f1c311c53c319ea5e0cd9a4f.mp4?t=1758684401\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Long live the arm!</p>","developers":["RAM CANDY"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3072400/header.jpg?t=1758684401","is_free":false,"legal_notice":"\u00a9 2024 \u00b7 RAM Candy SpA \u00b7 All rights reserved","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av