762938945"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3403570/9a7ebe3b0d1dc15434d786f83c39481655965337/ss_9a7ebe3b0d1dc15434d786f83c39481655965337.1920x1080.jpg?t=1762938945","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3403570/9a7ebe3b0d1dc15434d786f83c39481655965337/ss_9a7ebe3b0d1dc15434d786f83c39481655965337.600x338.jpg?t=1762938945"}],"short_description":"Become the ultimate Guild Master in a pixel art world! Manage your guild, craft epic gear, uncover a vast bestiary, and recruiting a diverse team of adventurers and workers. Prepare your heroes for battle and unravel the mystery surrounding your missing king!","steam_appid":3403570,"support_info":{"email":"contact@twintacosgames.com","url":"https://twintacosgames.com/contact-us/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://twintacosgames.com/"}