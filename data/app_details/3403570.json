m_assets/steam/apps/3403570/94fdfc10c3ab141b94eb2c599fab0440e6a09dd5/ss_94fdfc10c3ab141b94eb2c599fab0440e6a09dd5.600x338.jpg?t=1745386831"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3403570/a6dddb3686493c40a568836006e4f817a8e29d65/ss_a6dddb3686493c40a568836006e4f817a8e29d65.1920x1080.jpg?t=1745386831","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3403570/a6dddb3686493c40a568836006e4f817a8e29d65/ss_a6dddb3686493c40a568836006e4f817a8e29d65.600x338.jpg?t=1745386831"}],"short_description":"Become the ultimate Guild Master in a pixel art world! Manage your guild, craft epic gear, uncover a vast bestiary, and recruiting a diverse team of adventurers and workers. Prepare your heroes for battle and unravel the mystery surrounding your missing king!","steam_appid":3403570,"support_info":{"email":"contact@twintacosgames.com","url":"https://twintacosgames.com/contact-us/"},"supported_languages":"English","type":"game","website":"https://twintacosgames.com/"}