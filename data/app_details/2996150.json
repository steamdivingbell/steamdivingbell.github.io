27c31c6190105f93cb54a28a53b5798/ss_cf796711627c31c6190105f93cb54a28a53b5798.1920x1080.jpg?t=1760934171","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996150/cf796711627c31c6190105f93cb54a28a53b5798/ss_cf796711627c31c6190105f93cb54a28a53b5798.600x338.jpg?t=1760934171"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996150/ss_32e90ff351f7f05f371b861a2e194c78359b6848.1920x1080.jpg?t=1760934171","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996150/ss_32e90ff351f7f05f371b861a2e194c78359b6848.600x338.jpg?t=1760934171"}],"short_description":"&quot;Zodiac Mountain&quot; is a roguelike deckbuilder following the journey of a Panda as they adventure to become a Chinese Zodiac. Utilise dual hands of Yin &amp; Yang, encounter fierce mythical characters, outskill your enemies in battle, and climb Zodiac Mountain.","steam_appid":2996150,"support_info":{"email":"info@zodiacmountain.com","url":"https://www.zodiacmountain.com"},"supported_languages":"English<strong>*</strong>, Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.zodiacmountain.com"}