9092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3695590/331f07968093992e5b1fa80b7dd1ee45911aa77d/ss_331f07968093992e5b1fa80b7dd1ee45911aa77d.600x338.jpg?t=1746049092"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3695590/38625993c5dc2540b14fafedd190880ccd1f7eab/ss_38625993c5dc2540b14fafedd190880ccd1f7eab.1920x1080.jpg?t=1746049092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3695590/38625993c5dc2540b14fafedd190880ccd1f7eab/ss_38625993c5dc2540b14fafedd190880ccd1f7eab.600x338.jpg?t=1746049092"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3695590/fea4c74fa056c0f16e0fa26312c52df43092ba22/ss_fea4c74fa056c0f16e0fa26312c52df43092ba22.1920x1080.jpg?t=1746049092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3695590/fea4c74fa056c0f16e0fa26312c52df43092ba22/ss_fea4c74fa056c0f16e0fa26312c52df43092ba22.600x338.jpg?t=1746049092"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3695590/00f9171a7015cd82dcd47466a119f70ee5393f3d/ss_00f9171a7015cd82dcd47466a119f70ee5393f3d.1920x1080.jpg?t=1746049092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3695590/00f9171a7015cd82dcd47466a119f70ee5393f3d/ss_00f9171a7015cd82dcd47466a119f70ee5393f3d.600x338.jpg?t=1746049092"}],"short_description":"Disappeared is horror game, whose central aspect is exploration and stealth progression. You are Axel, camping with your wife, Deb, in a forest. She suddenly disappears. You need to make sense of what happened and find a way to save her, while being attacked and chased by powerful beings.","steam_appid":3695590,"support_info":{"email":"dogspartygames@gmail.com","url":""},"supported_languages":"English, Portuguese - Brazil","type":"demo","website":null}