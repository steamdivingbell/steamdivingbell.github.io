cb53f76a9211d9712b7286.1920x1080.jpg?t=1756586577","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3653480/d994ce1a1fe3c736d7cb53f76a9211d9712b7286/ss_d994ce1a1fe3c736d7cb53f76a9211d9712b7286.600x338.jpg?t=1756586577"}],"short_description":"Action Incremental. Survive against Time while your life energy progressively drains away. Dodge attacks, collect resources and power up your progression through an expansive skill tree, upgrading your stats and unlocking powerful abilities. How long can you last when death is one heartbeat away?","steam_appid":3653480,"support_info":{"email":"logos.monteolimpo@gmail.com","url":""},"supported_languages":"English, Italian, Japanese, Korean, Simplified Chinese, Traditional Chinese, Russian, Spanish - Spain","type":"game","website":null}