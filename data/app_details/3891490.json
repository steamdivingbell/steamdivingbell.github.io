static.com/store_item_assets/steam/apps/3891490/102a643625e8650343e1b80e3b54101e99bf02da/ss_102a643625e8650343e1b80e3b54101e99bf02da.600x338.jpg?t=1760530280"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3891490/41f85d7d3e732c831c80e74f9b427b99fe1c4cc2/ss_41f85d7d3e732c831c80e74f9b427b99fe1c4cc2.1920x1080.jpg?t=1760530280","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3891490/41f85d7d3e732c831c80e74f9b427b99fe1c4cc2/ss_41f85d7d3e732c831c80e74f9b427b99fe1c4cc2.600x338.jpg?t=1760530280"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3891490/0bcea6827cc42ccbb12af0436bc3d2452965abd3/ss_0bcea6827cc42ccbb12af0436bc3d2452965abd3.1920x1080.jpg?t=1760530280","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3891490/0bcea6827cc42ccbb12af0436bc3d2452965abd3/ss_0bcea6827cc42ccbb12af0436bc3d2452965abd3.600x338.jpg?t=1760530280"}],"short_description":"Snowfall City is hosting a legendary snowblaster tournament, and you\u2019re set to compete! Enter a light, wintery open-world RPG with a cheerful atmosphere, level-up talents through snow-slinging trials, recruit companions, outplay tricky rivals, and rise from rookie to seasonal champion!","steam_appid":3891490,"support_info":{"email":"contact@olipa.games","url":"https://olipa.games/contact.html"},"supported_languages":"English","type":"game","website":null}