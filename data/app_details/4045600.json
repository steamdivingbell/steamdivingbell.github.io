ac8259b3ab36982/ss_c3439ac65effe7dcc5299cdfeac8259b3ab36982.1920x1080.jpg?t=1773780508","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/c3439ac65effe7dcc5299cdfeac8259b3ab36982/ss_c3439ac65effe7dcc5299cdfeac8259b3ab36982.600x338.jpg?t=1773780508"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/0d6d5c6d1fa2a11fcce41424508037b67572a078/ss_0d6d5c6d1fa2a11fcce41424508037b67572a078.1920x1080.jpg?t=1773780508","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/0d6d5c6d1fa2a11fcce41424508037b67572a078/ss_0d6d5c6d1fa2a11fcce41424508037b67572a078.600x338.jpg?t=1773780508"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/b8007fc78e4a216da485b3935b9aa24089747236/ss_b8007fc78e4a216da485b3935b9aa24089747236.1920x1080.jpg?t=1773780508","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/b8007fc78e4a216da485b3935b9aa24089747236/ss_b8007fc78e4a216da485b3935b9aa24089747236.600x338.jpg?t=1773780508"}],"short_description":"Paris, 1888. In this detective visual novel inspired by Ace Attorney and Golden Idol, play as a matchmaker-detective striving to keep her marriage agency open. Meet colourful characters, uncover their secrets, and spread love throughout the city!","steam_appid":4045600,"support_info":{"email":"1888studioagence@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, French<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://impress.games/press-kit/1888-studio/lagence-the-hearts-of-paris"}