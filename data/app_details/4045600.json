60082477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/a50add7f8d9f880cbf287e0c38fdfb3805f0093c/ss_a50add7f8d9f880cbf287e0c38fdfb3805f0093c.600x338.jpg?t=1760082477"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/5c35f566d1ad947cf57ab13ffd1c0323fe5138b8/ss_5c35f566d1ad947cf57ab13ffd1c0323fe5138b8.1920x1080.jpg?t=1760082477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/5c35f566d1ad947cf57ab13ffd1c0323fe5138b8/ss_5c35f566d1ad947cf57ab13ffd1c0323fe5138b8.600x338.jpg?t=1760082477"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/490295fde12484e7b59914cf2327d390e71703be/ss_490295fde12484e7b59914cf2327d390e71703be.1920x1080.jpg?t=1760082477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/490295fde12484e7b59914cf2327d390e71703be/ss_490295fde12484e7b59914cf2327d390e71703be.600x338.jpg?t=1760082477"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/4f3794730e521e203c03ada9f22236d8b2e962db/ss_4f3794730e521e203c03ada9f22236d8b2e962db.1920x1080.jpg?t=1760082477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045600/4f3794730e521e203c03ada9f22236d8b2e962db/ss_4f3794730e521e203c03ada9f22236d8b2e962db.600x338.jpg?t=1760082477"}],"short_description":"Paris, 1888. Play as a matchmaker torn between romantic unions and marriages of convenience. Investigate your clients, uncover their secrets, and build your reputation in the city of Love!","steam_appid":4045600,"support_info":{"email":"1888studioagence@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, French<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}