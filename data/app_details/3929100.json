red.akamai.steamstatic.com/store_item_assets/steam/apps/3929100/19868681490263ae830e14c1e1b89f68aa365a70/ss_19868681490263ae830e14c1e1b89f68aa365a70.1920x1080.jpg?t=1772333370","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929100/19868681490263ae830e14c1e1b89f68aa365a70/ss_19868681490263ae830e14c1e1b89f68aa365a70.600x338.jpg?t=1772333370"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929100/7a98e996cecc265900ceb73c524a27fca15e3e66/ss_7a98e996cecc265900ceb73c524a27fca15e3e66.1920x1080.jpg?t=1772333370","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929100/7a98e996cecc265900ceb73c524a27fca15e3e66/ss_7a98e996cecc265900ceb73c524a27fca15e3e66.600x338.jpg?t=1772333370"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929100/2030cc18e7d09251d63389d45bc4a8ee30d36485/ss_2030cc18e7d09251d63389d45bc4a8ee30d36485.1920x1080.jpg?t=1772333370","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929100/2030cc18e7d09251d63389d45bc4a8ee30d36485/ss_2030cc18e7d09251d63389d45bc4a8ee30d36485.600x338.jpg?t=1772333370"}],"short_description":"A first person adventure platformer, focused on exploration with time based mechanics and puzzle elements. Enter the ruins of the Kingdom of Pharygia. Swiftly traverse its dillapidated, intricate infrastructure to delve further into the depths of iniquity, in order to cast light on hidden truths.","steam_appid":3929100,"support_info":{"email":"damascusteamgames@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}