\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3938290/extras/d9c11e9288a0048beee4abf267ee993b.poster.avif?t=1766893117\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3938290/extras/d9c11e9288a0048beee4abf267ee993b.webm?t=1766893117\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3938290/extras/d9c11e9288a0048beee4abf267ee993b.mp4?t=1766893117\" type=\"video/mp4\"></video></span><br>\u00a0</p>","developers":["Andoryu Learu"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3938290/120cdd0074f887adec72d104dd4e7d676b55b397/header.jpg?t=1766893117","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS Sierra 10.12 or higher (64-bit).<br></li><li><strong>Processor:</strong> Intel Core i3 (1.8 GHz or higher) or Apple M1.<br></li><li><strong>Memory:</strong> 6 GB RAM<br></li><li><strong>Graphics:</strong> HD Graphics 4000 / Apple M1 GPU  <br></li><li><strong>Storage:</strong> 8 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS Ventura 13.0 or higher (64-bit).<br></li><li><strong>Processor:</strong> Intel Core i5/i7 (3.0 GHz or higher) / Apple M1 Pro/Max.<br></li><li><strong>Memory:</strong> 16 MB RAM<br></li><li><strong>Graphics:</strong> AMD Radeon Pro 5500M / Apple M2 GPU <br></li><li><strong>Storage:</strong> 8 MB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstat