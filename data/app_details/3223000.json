steam/apps/3223000/9d39ac979b8eb6a4aa34312c0adffd1ba868c30e/ss_9d39ac979b8eb6a4aa34312c0adffd1ba868c30e.600x338.jpg?t=1764862686"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3223000/cdb9ed555ec2c2bf40d73302a85b62e1fb5603d9/ss_cdb9ed555ec2c2bf40d73302a85b62e1fb5603d9.1920x1080.jpg?t=1764862686","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3223000/cdb9ed555ec2c2bf40d73302a85b62e1fb5603d9/ss_cdb9ed555ec2c2bf40d73302a85b62e1fb5603d9.600x338.jpg?t=1764862686"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3223000/efca54b50fb976155703538ed22fcc1a1bc3a6f3/ss_efca54b50fb976155703538ed22fcc1a1bc3a6f3.1920x1080.jpg?t=1764862686","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3223000/efca54b50fb976155703538ed22fcc1a1bc3a6f3/ss_efca54b50fb976155703538ed22fcc1a1bc3a6f3.600x338.jpg?t=1764862686"}],"short_description":"Wreck, clean, and claim your victory! Roombattle is a 2-6 player hilarious party game where you control an adorable vacuum cleaner equipped with sharp objects and balloons. Customize your vacuum cleaner, fight your friends in chaotic battles and compete in tons of crazy minigames.","steam_appid":3223000,"support_info":{"email":"hello@dustgames.es","url":"https://dustgames.es/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Catalan, Japanese, Korean, Polish, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Spanish - Latin America, Traditional Chinese","type":"game","website":"https://dustgames.es/"}