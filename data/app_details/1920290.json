steam/apps/1920290/398b6177906fad82f0019e8e0e2459098886073f/ss_398b6177906fad82f0019e8e0e2459098886073f.1920x1080.jpg?t=1755866768","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/398b6177906fad82f0019e8e0e2459098886073f/ss_398b6177906fad82f0019e8e0e2459098886073f.600x338.jpg?t=1755866768"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/b5f804fac7282ed127c037f1f284027828f46cdf/ss_b5f804fac7282ed127c037f1f284027828f46cdf.1920x1080.jpg?t=1755866768","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/b5f804fac7282ed127c037f1f284027828f46cdf/ss_b5f804fac7282ed127c037f1f284027828f46cdf.600x338.jpg?t=1755866768"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/e527c321ffc49098c45c50bc0f240a84641639cd/ss_e527c321ffc49098c45c50bc0f240a84641639cd.1920x1080.jpg?t=1755866768","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/e527c321ffc49098c45c50bc0f240a84641639cd/ss_e527c321ffc49098c45c50bc0f240a84641639cd.600x338.jpg?t=1755866768"}],"short_description":"BARKOUR is a fast-paced stealth-action platformer where you play as Agent T.H.U.N.D.E.R. - a tail-wagging canine with a knack for parkour, gadgets and barking at villains. Join a secret organization to stop evil schemes in a world full of charming absurdity.","steam_appid":1920290,"support_info":{"email":"varsav@varsav.com","url":"http://varsav.com/"},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Simplified Chinese, Traditional Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://barkourgame.com"}