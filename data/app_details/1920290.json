fabcfef61.webm?t=1771600793\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/b147b1c6b16d5c1e24e9d0cfabcfef61.mp4?t=1771600793\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/909ee839bb74b31df6632bb4d4859a3e.avif?t=1771600793\" width=817 height=116 /></span>In this fast-paced stealth-action platformer, you\u2019ll combine stealth, barkour (dog-parkour), and gadgets to complete your missions.</p><p class=\"bb_paragraph\" >Whether you sneak through shadows, go in all guns blazing or bounce off rooftops - BARKOUR gives you the freedom to play your way. And if you want to do nothing but play with the emote system\u2026 well, who are we to stop you?</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/848e46c169771078f05bd8b7a3a4374c.poster.avif?t=1771600793\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/848e46c169771078f05bd8b7a3a4374c.webm?t=1771600793\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/848e46c169771078f05bd8b7a3a4374c.mp4?t=1771600793\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/5a2b450cbd47ea828fa0cdce891c7393.avif?t=1771600793\" width=817 height=116 /></span>From the mysterious forests of lush greenhouses to the darkest corners of the castle dungeons, your missions will take place in various stunning locations. Use all the tools you have to explore them.</p><p class=\"bb_paragraph\" >You decided to sniff around? Then you\u2019ll find lots of hidden paths, additional challenges and Easter eggs. Remember, secrets wait for you around every corner.</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/3be86f0ba510e8a3e9de58ccb67119ff.poster.avif?t=1771600793\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/3be86f0ba510e8a3e9de58ccb67119ff.webm?t=1771600793\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/3be86f0ba510e8a3e9de58ccb67119ff.mp4?t=1771600793\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/extras/1c36e26967122a64d6428edde68fbde0.avif?t=1771600793\" width=817 height=116 /></span>BARKOUR is a spy comedy that tells a story of a Dog Agent with one goal in his silly mind - defeat the villains and save the world. That\u2019s two goals\u2026 and to complete this mission he\u2019ll need YOUR help.\u00a0 </p><p class=\"bb_paragraph\" >Agent T.H.U.N.D.E.R. happily wags his tail, awaiting your company. Now, let\u2019s get down to business and save the world together!</p><p class=\"bb_paragraph\" ></p>","developers":["VARSAV Game Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1920290/ea8fe896b8bb9367b45f6413e3986f05c1a359f5/header.jpg?t=1771600793","is_free":false,"legal_notice":"\u00ae2026 VARSAV GAME STUDIOS S.A., THE VARSAV GAME S