9d0d28afa84c6106e640d76d95bb972fa.600x338.jpg?t=1745414518"},{"id":25,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2478560/1b5735e76420ba7529465e16d2a3a08ac64d7810/ss_1b5735e76420ba7529465e16d2a3a08ac64d7810.1920x1080.jpg?t=1745414518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2478560/1b5735e76420ba7529465e16d2a3a08ac64d7810/ss_1b5735e76420ba7529465e16d2a3a08ac64d7810.600x338.jpg?t=1745414518"}],"short_description":"RopeBot gives you unparalleled control over dynamic, realistic ropes in this physics-based 3D platformer. Create, lengthen, throw, and deactivate ropes at will to overcome challenges and solve puzzles. How will you untangle this adventure?","steam_appid":2478560,"support_info":{"email":"scott.ewing62@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}