ers.</strong></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>MATURE NARRATIVE:</strong> a deeply human drama with a touch of otherworldly fantasy</p></li><li><p class=\"bb_paragraph\" ><strong>ANIMATED SEX SCENES:</strong> a multitude of fully animated scenes with beautiful graphics</p></li><li><p class=\"bb_paragraph\" ><strong>THRILLING ROMANCE:</strong> compelling &amp; twisted love affairs that tug at the heart-strings</p><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["SparkHG"],"genres":[{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3770250/3abe2b47d10a7a663c83de6b08e727b4112d2c36/header.jpg?t=1766085096","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3770250/10797547/543a71fc5b73d1f2a893c8cabd74cc1070c930bd/1760002314/dash_av1.mpd?t=1760003096","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3770250/10797547/543a71fc5b73d1f2a893c8cabd74cc1070c930bd/1760002314/dash_h264.mpd?t=1760003096","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3770250/10797547/543a71fc5b73d1f2a893c8cabd74cc1070c930bd/1760002314/hls_264_master.m3u8?t=1760003096","id":257214742,"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257214742/c10ddf0cf5ce57412672ef1dafa93b0f739ac996/movie_600x337.jpg?t=1760003096"}],"name":"Game of Hearts","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Game of Hearts - $9.99 USD","packageid":1326569,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":999}],"title":"Buy Game of He