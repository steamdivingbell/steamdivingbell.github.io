bc72c747a4f467c01216122843a3995036785/ss_498bc72c747a4f467c01216122843a3995036785.600x338.jpg?t=1752926757"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2435870/8b8f201cbbb3b2634016e1c8212121b150930edf/ss_8b8f201cbbb3b2634016e1c8212121b150930edf.1920x1080.jpg?t=1752926757","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2435870/8b8f201cbbb3b2634016e1c8212121b150930edf/ss_8b8f201cbbb3b2634016e1c8212121b150930edf.600x338.jpg?t=1752926757"}],"short_description":"BLOOD RUSH is a fast paced, skill based FPS, mixed with roguelites elements. Upgrade yourself, buy unique guns, drain miracles from relics and destroy anyone or anything standing on your way!","steam_appid":2435870,"support_info":{"email":"bloodrush@maxestla.com","url":""},"supported_languages":"English, French, Russian, Italian","type":"game","website":"https://www.maxestla.com/blood-rush/"}