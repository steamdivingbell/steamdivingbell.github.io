om/store_item_assets/steam/apps/3585280/601f4882c1837bf50ea21f87fc5c5128dd1d588b/ss_601f4882c1837bf50ea21f87fc5c5128dd1d588b.600x338.jpg?t=1764533781"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3585280/248c9f97644cdbc648ff3966caa2e89364d6cab5/ss_248c9f97644cdbc648ff3966caa2e89364d6cab5.1920x1080.jpg?t=1764533781","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3585280/248c9f97644cdbc648ff3966caa2e89364d6cab5/ss_248c9f97644cdbc648ff3966caa2e89364d6cab5.600x338.jpg?t=1764533781"}],"short_description":"Fight against mythical creatures, protect legendary castles, and defend the marvelous Golden planet from demonic forces in this mini open-world fantasy adventure.","steam_appid":3585280,"support_info":{"email":"","url":"https://www.goldanniyatech.com/en/support.html"},"supported_languages":"English","type":"game","website":"https://www.goldanniyatech.com/"}