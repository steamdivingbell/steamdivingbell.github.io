as/ee5aab5cabe8031e1a19b20721c857f0.poster.avif?t=1765239608\" width=900 height=520 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839300/extras/ee5aab5cabe8031e1a19b20721c857f0.webm?t=1765239608\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839300/extras/ee5aab5cabe8031e1a19b20721c857f0.mp4?t=1765239608\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Utilize a clever array of powerful Dog Tags to modify how your dogs and their Traits function. Find interesting synergies and unique combos to aid you in all of your merging endeavors. And always remember your ultimate goal: BIGGER!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Studio Folly","Toot Games","Foot"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839300/91cc94ff158dd2fcd69c726752705aec6340098d/header.jpg?t=1765239608","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 11 (Big Sur) or later<br></li><li><strong>Processor:</strong> Any Intel or Apple Silicon processor<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3839300/1713185880/e7da1481ddf0e4e2acee0ef2efd5f227968400c9/1765238927/dash_av1.mpd?t=1765239544","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3839300/1713185880/e7da1481ddf0e4e2acee0ef2efd5f227968400c9/1765238927/dash_h264.mpd?t=1765239544","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3839300/1713185880/e7da1481ddf0e4e2acee0ef2efd5f227968400c9/1765238927/hls_264_master.m3u8?t=176523954