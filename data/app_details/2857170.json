pps/2857170/extras/9d60bf4ea9a9bc500f7c4c22acd0072c.mp4?t=1761437402\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Face evil, create a revolution, overthrow the system, eat tons of tacos, have fun, and become a LEGEND. Never forget that.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2857170/extras/8b7d4f2959eb00583c6aeda7e233a314.poster.avif?t=1761437402\" width=618 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2857170/extras/8b7d4f2959eb00583c6aeda7e233a314.webm?t=1761437402\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2857170/extras/8b7d4f2959eb00583c6aeda7e233a314.mp4?t=1761437402\" type=\"video/mp4\"></video></span></p>","developers":["Escalera Games"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2857170/2de8baf2aa190edd4b355b51833335173fc8617b/header.jpg?t=1761437402","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2857170/1635309961/c7baa54a2e6c1a9238ba115476a8c7edcd60e24e/1750948039/dash_av1.mpd?t=1748542059","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2857170/1635309961/c7baa54a2e6c1a9238ba115476a8c7edcd60e24e/1750948039/dash_h264.mpd?t=1748542059","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2857170/1635309961/c7baa54a2e6c1a9238ba115476a8c7edcd60e24e/1750948039/hls_264_master.m3u8?t=1748542059","id":257056340,"name":"The chubby Hero","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257056340/2973fe36e9b0f65ffd4a43ca5dca559037cc34