mai.steamstatic.com/store_trailers/1762850/485791/b8cf2c8f971ef524133dfe2fc1d6d61024fb6b75/1751028374/dash_h264.mpd?t=1698115971","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1762850/485791/b8cf2c8f971ef524133dfe2fc1d6d61024fb6b75/1751028374/hls_264_master.m3u8?t=1698115971","id":256899829,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/256899829/movie480.mp4?t=1698115971","max":"https://video.akamai.steamstatic.com/store_trailers/256899829/movie_max.mp4?t=1698115971"},"name":"Main Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256899829/movie.293x165.jpg?t=1698115971","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/256899829/movie480_vp9.webm?t=1698115971","max":"https://video.akamai.steamstatic.com/store_trailers/256899829/movie_max_vp9.webm?t=1698115971"}}],"name":"Loggerhead","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS *:</strong> Windows 7 - 64 bit<br></li><li><strong>Processor:</strong> Requires a 64-bit processor and operating system<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Intel i5 or AMD equivalent (AMD FX 8500+ Series)<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Additional Notes:</strong> Should run okay on most PC's as long as its better than a potato</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 - 64 bit<br></li><li><strong>Processor:</strong> Requires a 64-bit processor and operating system<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Intel i7 or AMD equivalent (AMD FX 9500+ Series)<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>"},"platforms":{"l