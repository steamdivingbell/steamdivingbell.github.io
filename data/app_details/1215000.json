ebb16e7cdf71.1920x1080.jpg?t=1680958968","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1215000/ss_a3dca6f07d189347e7728eab21fcebb16e7cdf71.600x338.jpg?t=1680958968"},{"id":22,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1215000/ss_caf501ac5053ff4a618630c2b7ac7286c02b2083.1920x1080.jpg?t=1680958968","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1215000/ss_caf501ac5053ff4a618630c2b7ac7286c02b2083.600x338.jpg?t=1680958968"},{"id":23,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1215000/ss_b3fb00964a340ec13a460e87cef2f7ce7990b411.1920x1080.jpg?t=1680958968","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1215000/ss_b3fb00964a340ec13a460e87cef2f7ce7990b411.600x338.jpg?t=1680958968"}],"short_description":"Swing, Soar, Die, Repeat! STRAYLIGHT uses a revolutionary movement mechanic to fling you through beautiful and deadly cosmic playgrounds. Designed from the ground up for comfortable VR movement, STRAYLIGHT is a new kind of platforming experience!","steam_appid":1215000,"support_info":{"email":"teamstraylight@gmail.com","url":"https://www.drbloc.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.drbloc.com/"}