761164634"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2305210/ss_9a9bfbfaaa6cb247e37c81a3440372ff347fb424.1920x1080.jpg?t=1761164634","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2305210/ss_9a9bfbfaaa6cb247e37c81a3440372ff347fb424.600x338.jpg?t=1761164634"}],"short_description":"Create an automated system that terraforms a planet with an army of drones. Build bases, set up a weather monitoring system, prepare to survive different types of storms, and take control of the climate and biomes!","steam_appid":2305210,"support_info":{"email":"weatherfused@gmail.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese","type":"game","website":"https://www.skyformer.com"}