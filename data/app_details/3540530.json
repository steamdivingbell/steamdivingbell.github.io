 sound design</strong> \u2013 Whispers behind your back, echoes of footsteps, and haunting noises pull you deeper into the atmosphere.</p></li><li><p class=\"bb_paragraph\" ><strong>Photorealistic graphics</strong> \u2013 Powered by Unreal Engine 5.4, the horror feels closer than ever before</p></li></ul>","developers":["ASK_GAMES"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3540530/header.jpg?t=1761802737","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3540530/861563/7e3b476fb0fc0652b8516b83a5aef7001f963026/1750859262/dash_av1.mpd?t=1743500663","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3540530/861563/7e3b476fb0fc0652b8516b83a5aef7001f963026/1750859262/dash_h264.mpd?t=1743500663","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3540530/861563/7e3b476fb0fc0652b8516b83a5aef7001f963026/1750859262/hls_264_master.m3u8?t=1743500663","id":257120887,"name":"Lost Child Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257120887/3d71a2180491a6421f415c882508e58f652a4966/movie_600x337.jpg?t=1743500663"}],"name":"Lost Child","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Lost Child - $4.99 USD","packageid":1249683,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount