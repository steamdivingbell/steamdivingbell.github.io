18"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_5fa2173e4c386d0f212efff9b368aff6a206ff09.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_5fa2173e4c386d0f212efff9b368aff6a206ff09.600x338.jpg?t=1766055218"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_424c24040548b2c8ee3e41f8b35710f711b59b3c.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_424c24040548b2c8ee3e41f8b35710f711b59b3c.600x338.jpg?t=1766055218"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_07461adc588cc765708cec07f0cf85e8f9a6332a.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_07461adc588cc765708cec07f0cf85e8f9a6332a.600x338.jpg?t=1766055218"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_3c47cf07923d70da11148d91a8060eb99ead366c.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_3c47cf07923d70da11148d91a8060eb99ead366c.600x338.jpg?t=1766055218"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_a94e4d09620b75d26421b0831ff3688822006d0f.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_a94e4d09620b75d26421b0831ff3688822006d0f.600x338.jpg?t=1766055218"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_e83eccaee2e70a5f200449f8827b3915002e56dd.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_e83eccaee2e70a5f200449f8827b3915002e56dd.600x338.jpg?t=1766055218"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_0b1b6ee6ddc959ec07df1f72cd4578874131d887.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_0b1b6ee6ddc959ec07df1f72cd4578874131d887.600x338.jpg?t=1766055218"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_cb4fe496d1be6dd56cd42345ad5f810852df02bd.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_cb4fe496d1be6dd56cd42345ad5f810852df02bd.600x338.jpg?t=1766055218"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_a6de770beb68b6250fbd03b3631976193fcc0b34.1920x1080.jpg?t=1766055218","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/ss_a6de770beb68b6250fbd03b3631976193fcc0b34.600x338.jpg?t=1766055218"}],"short_description":"Hardcore open-world survival where preparation is everything. Scavenge, craft, fortify during the day. When night falls, the infected hunt in numbers. Play solo or with friends in a brutal post-apocalyptic sandbox where survival is earned through smart decisions. How many Nights will you survive?","steam_appid":541300,"support_info":{"email":"support@survivethenights.net","url":"https://www.survivethenights.net"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Arabic, Dutch, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America, Swedish, Turkish, Ukrainian, Czech, Thai<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.survivethenights.net"}