0/579df212cf3e63548af12e442942479e6ba0ce61/ss_579df212cf3e63548af12e442942479e6ba0ce61.600x338.jpg?t=1770105944"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290590/cdc2dc5ce853986e317ee81240155d5b267d0969/ss_cdc2dc5ce853986e317ee81240155d5b267d0969.1920x1080.jpg?t=1770105944","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290590/cdc2dc5ce853986e317ee81240155d5b267d0969/ss_cdc2dc5ce853986e317ee81240155d5b267d0969.600x338.jpg?t=1770105944"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290590/ss_09e8a2c3304401847b315746cf88aa7d7d38ce72.1920x1080.jpg?t=1770105944","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290590/ss_09e8a2c3304401847b315746cf88aa7d7d38ce72.600x338.jpg?t=1770105944"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290590/400bf2a3352db17aba8937c4fb93cfd96c111a1a/ss_400bf2a3352db17aba8937c4fb93cfd96c111a1a.1920x1080.jpg?t=1770105944","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290590/400bf2a3352db17aba8937c4fb93cfd96c111a1a/ss_400bf2a3352db17aba8937c4fb93cfd96c111a1a.600x338.jpg?t=1770105944"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290590/ss_5d56d78cbbbcbf73bcc7f81f77e1b0d34397fc6b.1920x1080.jpg?t=1770105944","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290590/ss_5d56d78cbbbcbf73bcc7f81f77e1b0d34397fc6b.600x338.jpg?t=1770105944"}],"short_description":"This is a roguelite, fictional, martial arts, and punk card-building game. You will play the role of an infiltrator, entering the Qin capital, Xianyang, which is besieged by the rebels, and build your own deck within 72 hours, complete your mission, and uncover the secrets of the city.","steam_appid":3290590,"support_info":{"email":"Steamcotactuse@outlook.com","url":""}