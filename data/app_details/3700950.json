7c/ss_d58265c7aeb555fd839f904c65b9906c9a65027c.1920x1080.jpg?t=1773770943","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700950/d58265c7aeb555fd839f904c65b9906c9a65027c/ss_d58265c7aeb555fd839f904c65b9906c9a65027c.600x338.jpg?t=1773770943"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700950/e1f3a6346ddd78d457bde1f4cb99b48bf9cf810a/ss_e1f3a6346ddd78d457bde1f4cb99b48bf9cf810a.1920x1080.jpg?t=1773770943","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700950/e1f3a6346ddd78d457bde1f4cb99b48bf9cf810a/ss_e1f3a6346ddd78d457bde1f4cb99b48bf9cf810a.600x338.jpg?t=1773770943"}],"short_description":"Step into a neon-lit 1980s disco! Under the Disco Lights lets you manage the bar, serve drinks, read customers, and uncover secrets - all in first-person. Featuring stylized visuals, reactive characters, and a fully original 1980s-inspired soundtrack that keeps the night alive.","steam_appid":3700950,"support_info":{"email":"info@brightika.com","url":"https://brightika.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://brightika.com/"}