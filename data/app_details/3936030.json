"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3936030/fd67efe6fd71209b2618aae02350f05bab492aab/ss_fd67efe6fd71209b2618aae02350f05bab492aab.1920x1080.jpg?t=1757352628","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3936030/fd67efe6fd71209b2618aae02350f05bab492aab/ss_fd67efe6fd71209b2618aae02350f05bab492aab.600x338.jpg?t=1757352628"}],"short_description":"Discover S\u00e3o Miguel like never before with Visit Azores, the immersive VR travel experience that brings the breathtaking beauty of the Azores straight to your Headset. Step into 360\u00b0 3D videos and explore stunning landscapes\u2014volcanic lakes, waterfalls, tea plantations, coastal cliffs, and more.","steam_appid":3936030,"support_info":{"email":"npsoftware@gmail.com","url":"https://www.npsoftware.at"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://npsoftware.at/index.php/portfolio/visit-azores/"}