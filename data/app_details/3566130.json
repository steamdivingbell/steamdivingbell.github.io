/3566130/2d505ab8cfe10e840ef1ffe9f670129da6e2694e/ss_2d505ab8cfe10e840ef1ffe9f670129da6e2694e.1920x1080.jpg?t=1770107455","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566130/2d505ab8cfe10e840ef1ffe9f670129da6e2694e/ss_2d505ab8cfe10e840ef1ffe9f670129da6e2694e.600x338.jpg?t=1770107455"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566130/9cb4c7296fbd29627084984651722528bd79f3a1/ss_9cb4c7296fbd29627084984651722528bd79f3a1.1920x1080.jpg?t=1770107455","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566130/9cb4c7296fbd29627084984651722528bd79f3a1/ss_9cb4c7296fbd29627084984651722528bd79f3a1.600x338.jpg?t=1770107455"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566130/d82324b95b25520e06082986b402df0c8bebf8d6/ss_d82324b95b25520e06082986b402df0c8bebf8d6.1920x1080.jpg?t=1770107455","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566130/d82324b95b25520e06082986b402df0c8bebf8d6/ss_d82324b95b25520e06082986b402df0c8bebf8d6.600x338.jpg?t=1770107455"}],"short_description":"Dungeon Holdem is the poker dungeon crawler deckbuilder. Forge your path as a warrior or wizard, unlocking powerful abilities to boost your hands. Master combos, stack hands, upgrade your deck, and slay monsters in this epic poker RPG.","steam_appid":3566130,"support_info":{"email":"contact@destined.com","url":"dungeonholdem.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}