c717f75415c623cdff485ef0ce30916523da/ss_277dc717f75415c623cdff485ef0ce30916523da.600x338.jpg?t=1772238230"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2325290/ae9eaf9b189a7e0500e993f38ca1333ed86784cd/ss_ae9eaf9b189a7e0500e993f38ca1333ed86784cd.1920x1080.jpg?t=1772238230","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2325290/ae9eaf9b189a7e0500e993f38ca1333ed86784cd/ss_ae9eaf9b189a7e0500e993f38ca1333ed86784cd.600x338.jpg?t=1772238230"}],"short_description":"A breathtaking open-world adventure awaits! Explore magical realms, restore lost light, and form wordless bonds with players worldwide. Complete quests and solve puzzles in seasonal events that celebrate kindness, discovery, and heartfelt connection.","steam_appid":2325290,"support_info":{"email":"","url":"https://thatgamecompany.helpshift.com/"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America, Traditional Chinese, Vietnamese, Indonesian, Spanish - Spain, Portuguese - Portugal, Thai<br><strong>*</strong>languages with full audio support","type":"game","website":"https://thatgamecompany.com/"}