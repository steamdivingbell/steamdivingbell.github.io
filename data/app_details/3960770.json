om/store_item_assets/steam/apps/3960770/b0824853daf448ce86ca46515117bd85d063a763/ss_b0824853daf448ce86ca46515117bd85d063a763.600x338.jpg?t=1758308153"}],"short_description":"While your ship battles enemies on autopilot, your mission is to keep upgrading it with strategic cards. In this experience that values brains over reflexes, the right upgrades are the key to victory!","steam_appid":3960770,"support_info":{"email":"IBELFStuidos@outlook.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Portuguese - Portugal, Turkish","type":"game","website":null}