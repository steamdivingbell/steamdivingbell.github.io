steam/apps/3900160/e0d1555f544dcba781f622d147a1badb7aa38806/ss_e0d1555f544dcba781f622d147a1badb7aa38806.600x338.jpg?t=1758026729"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3900160/a6ccddae08e76d325e9f41c1000fd15c3a674ff6/ss_a6ccddae08e76d325e9f41c1000fd15c3a674ff6.1920x1080.jpg?t=1758026729","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3900160/a6ccddae08e76d325e9f41c1000fd15c3a674ff6/ss_a6ccddae08e76d325e9f41c1000fd15c3a674ff6.600x338.jpg?t=1758026729"}],"short_description":"An adventure RPG about life, death, rebirth, and robots, from the team that brought you vivid/stasis.","steam_appid":3900160,"support_info":{"email":"cherylstelli@hajimeli.net","url":"https://hajimeli.net"},"supported_languages":"English","type":"game","website":"https://hajimeli.net/misdecayed"}