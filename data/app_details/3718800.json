re_item_assets/steam/apps/3718800/781318ec4256b6c12d893bd0bfde0de12edd4a44/ss_781318ec4256b6c12d893bd0bfde0de12edd4a44.600x338.jpg?t=1759866946"}],"short_description":"A roguelike deckbuilder meets auto-battler where every fight is a puzzle. Build mechanisms, counter enemies and unleash your perfect combo!","steam_appid":3718800,"support_info":{"email":"dev@arvisgames.com","url":""},"supported_languages":"English","type":"game","website":null}