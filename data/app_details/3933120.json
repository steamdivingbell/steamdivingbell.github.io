16d7981692e9f/ss_e0039c60ef1edd4c983309675a216d7981692e9f.1920x1080.jpg?t=1759253157","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933120/e0039c60ef1edd4c983309675a216d7981692e9f/ss_e0039c60ef1edd4c983309675a216d7981692e9f.600x338.jpg?t=1759253157"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933120/44a6d78487abe802c32fd34ac478d0d113584fee/ss_44a6d78487abe802c32fd34ac478d0d113584fee.1920x1080.jpg?t=1759253157","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933120/44a6d78487abe802c32fd34ac478d0d113584fee/ss_44a6d78487abe802c32fd34ac478d0d113584fee.600x338.jpg?t=1759253157"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933120/3398475ae886918f215a51dfce08efd473ed51e0/ss_3398475ae886918f215a51dfce08efd473ed51e0.1920x1080.jpg?t=1759253157","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933120/3398475ae886918f215a51dfce08efd473ed51e0/ss_3398475ae886918f215a51dfce08efd473ed51e0.600x338.jpg?t=1759253157"}],"short_description":"CiniCross is a roguelike puzzle game set in a dark fantasy universe. Solve increasingly difficult nonogram puzzles, choose your path through a tree-like dungeon, and adapt your strategy using artifacts and items with unique effects. Each room is a new puzzle, each boss a challenge to overcome.","steam_appid":3933120,"support_info":{"email":"hydrobates.studio@gmail.com","url":""},"supported_languages":"English, French","type":"game","website":null}