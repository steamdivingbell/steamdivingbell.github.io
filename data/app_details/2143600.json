 wiping out humanity.","steam_appid":2143600,"support_info":{"email":"tomcap96+HairyPenguin@live.co.uk","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.hairypenguin.com/"}