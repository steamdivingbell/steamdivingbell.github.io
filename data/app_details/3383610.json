 class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Explore </strong>the seasons of the Afterlife in your own way in a world inspired by classic metroidvanias</p></li><li><p class=\"bb_paragraph\" ><strong>Learn </strong>the possibilities of the grappling hook and unlock areas <i>gated not by items, but by knowledge.</i></p></li><li><p class=\"bb_paragraph\" ><strong>Meet </strong>a colorful cast of characters and help them through their journeys.</p></li><li><p class=\"bb_paragraph\" ><strong>Find </strong>collectible lost souls hidden in every corner.</p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["moraguma"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383610/header.jpg?t=1747345807","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 16.04 LTS<br></li><li><strong>Processor:</strong> Intel Quad Core<br></li><li><strong>Graphics:</strong> Intel Integrated Card<br></li><li><strong>Storage:</strong> 500 MB available space<br></li><li><strong>Sound Card:</strong> Intel Integrated Card</li></ul>"},"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3383610/167903564/b76eeaaf9d6fdc2e27f1af2903a8e02dd0d87c51/1750846667/dash_av1.mpd?t=1747345805","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3383610/167903564/b76eeaaf9d6fdc2e27f1af2903a8e02dd0d87c51/1750846667/dash_h264.mpd?t=1747345805","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3383610/167903564/b76eeaaf9d6fdc2e27f1af2903a8e02dd0d87c51/1750846667/hls_264_master.m3u8?t=1747345805","id":257140351,"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257140351/43c3a007e387a5780e2738e81951cb09d72b249e/movie_600x337.jpg?t=1747345805"}],"name":"Soulchain","package_group