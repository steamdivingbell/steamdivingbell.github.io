teamstatic.com/store_item_assets/steam/apps/3647070/078ec460231abe1be4e49e679001b92acb8bb63c/ss_078ec460231abe1be4e49e679001b92acb8bb63c.600x338.jpg?t=1771964310"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3647070/4142d8fc026f95afb9478fb552ce86ee568dfcb1/ss_4142d8fc026f95afb9478fb552ce86ee568dfcb1.1920x1080.jpg?t=1771964310","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3647070/4142d8fc026f95afb9478fb552ce86ee568dfcb1/ss_4142d8fc026f95afb9478fb552ce86ee568dfcb1.600x338.jpg?t=1771964310"}],"short_description":"Control a crew of outcasts and try to repair the disabled mining tower. Many tried before, many failed. Surely this is a good idea. A sci-fi dungeon crawling game with handmade visuals, real time combat and unique exploration options.","steam_appid":3647070,"support_info":{"email":"methoda1@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}