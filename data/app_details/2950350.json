h_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950350/9f22778e2f95747dbcfea298a20cf71e38e6a8f6/ss_9f22778e2f95747dbcfea298a20cf71e38e6a8f6.600x338.jpg?t=1769413357"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950350/81f928c4bcb3c30d0c28b3872bd9580763786fb5/ss_81f928c4bcb3c30d0c28b3872bd9580763786fb5.1920x1080.jpg?t=1769413357","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2950350/81f928c4bcb3c30d0c28b3872bd9580763786fb5/ss_81f928c4bcb3c30d0c28b3872bd9580763786fb5.600x338.jpg?t=1769413357"}],"short_description":"I Will Purify You (I.P.U.) is a 2D pixel side-scroll action game where you play as James, an exorcist of the Hunter Union. Battle countless Anomalies and purify powerful, alluring female bosses to restore peace to a world consumed by chaos.","steam_appid":2950350,"support_info":{"email":"steam@cheeseburgerstudio.com","url":""},"supported_languages":"English, Japanese<strong>*</strong>, Simplified Chinese, Traditional Chinese, Korean, Spanish - Spain<br><strong>*</strong>languages with full audio support","type":"game","website":null}