fd42ddfd4fba32fa4a31.1920x1080.jpg?t=1773817086","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552590/86a12610f4f2b0dde73ffd42ddfd4fba32fa4a31/ss_86a12610f4f2b0dde73ffd42ddfd4fba32fa4a31.600x338.jpg?t=1773817086"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552590/7a959f32446d00e9237618e1dcd44b593d09ea0c/ss_7a959f32446d00e9237618e1dcd44b593d09ea0c.1920x1080.jpg?t=1773817086","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552590/7a959f32446d00e9237618e1dcd44b593d09ea0c/ss_7a959f32446d00e9237618e1dcd44b593d09ea0c.600x338.jpg?t=1773817086"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552590/9addcf95c79780bd0515ae4f93494fd4f7dbb7ce/ss_9addcf95c79780bd0515ae4f93494fd4f7dbb7ce.1920x1080.jpg?t=1773817086","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552590/9addcf95c79780bd0515ae4f93494fd4f7dbb7ce/ss_9addcf95c79780bd0515ae4f93494fd4f7dbb7ce.600x338.jpg?t=1773817086"}],"short_description":"Manage a cozy subway bakery in an underground animal city - run by a &quot;retired&quot; gangster you're secretly investigating. Serve cute locals, expand the bakery, prepare for festivals, meet strange visitors and explore the subway after hours for fun stories and special rewards!","steam_appid":3552590,"support_info":{"email":"kushygamestudio@gmail.com","url":"animalbakery.cn"},"supported_languages":"English, Japanese, Simplified Chinese","type":"game","website":"http://animalbakery.cn"}