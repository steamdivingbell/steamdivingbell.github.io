05f0d6f3/ss_d815973a72002abadafb7b4a4b0b766705f0d6f3.1920x1080.jpg?t=1758836972","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023520/d815973a72002abadafb7b4a4b0b766705f0d6f3/ss_d815973a72002abadafb7b4a4b0b766705f0d6f3.600x338.jpg?t=1758836972"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023520/36c1e83f3b2026583202d2254763fb7afdb3515e/ss_36c1e83f3b2026583202d2254763fb7afdb3515e.1920x1080.jpg?t=1758836972","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023520/36c1e83f3b2026583202d2254763fb7afdb3515e/ss_36c1e83f3b2026583202d2254763fb7afdb3515e.600x338.jpg?t=1758836972"}],"short_description":"Explore the dungeons Below the Crown, in this love letter to Roguelikes, Dungeon Crawlers, and Chess. Prepare for strategy, game-changing spells, psychological tests, and challenges from your fellow players.","steam_appid":4023520,"support_info":{"email":"btc-support@misfitsattic.com","url":""},"supported_languages":"English","type":"demo","website":null}