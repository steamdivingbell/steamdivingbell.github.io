=\"bb_tag\" >The World of Celestial Lumina invites you to embark upon this quest. Bring back the light, or die trying.</h2><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Wishlist Celestial Lumina and join the ascent.</strong></h2>","developers":["Juan Centeno"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963060/febe3ba3e9e8094cf3e4c48ee1572c07677101d7/header.jpg?t=1773898762","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3963060/1589179373/96069cd96e3394dae913713851f3ca3b6204cd77/1767751725/dash_av1.mpd?t=1773898760","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3963060/1589179373/96069cd96e3394dae913713851f3ca3b6204cd77/1767751725/dash_h264.mpd?t=1773898760","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3963060/1589179373/96069cd96e3394dae913713851f3ca3b6204cd77/1767751725/hls_264_master.m3u8?t=1773898760","id":257260848,"name":"Celestial Lumina - Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257260848/55acdf1dd16209eb5272d679c8a1a4f51154d356/movie_600x337.jpg?t=1773898760"}],"name":"Celestial Lumina","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> HD Graphics 5500<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 25 GB available space<br></li><li><strong>Sound Card:</strong> Realtek High Definition Audio</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Micr