em_assets/steam/apps/3968810/f5fe6510c2b29183bbb2d8a1036bf59532b5465b/ss_f5fe6510c2b29183bbb2d8a1036bf59532b5465b.1920x1080.jpg?t=1758295416","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3968810/f5fe6510c2b29183bbb2d8a1036bf59532b5465b/ss_f5fe6510c2b29183bbb2d8a1036bf59532b5465b.600x338.jpg?t=1758295416"}],"short_description":"Old Ninja: Underworld is a 2D pixel-art Metroidvania action game where an aging ninja explores a chaotic underground world. Battle through a bizarre mix of enemies with no apparent connection, strengthen your ninja, and challenge the boss lurking deep below.","steam_appid":3968810,"support_info":{"email":"my.waterfall.studio@gmail.com","url":""},"supported_languages":"Japanese, English","type":"game","website":null}