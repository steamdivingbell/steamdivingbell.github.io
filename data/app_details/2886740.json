apps/2886740/extras/e7b7a175bcb27877a615fe033ba02092.avif?t=1759082383\" width=1127 height=294 /></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >UNCOVER THE PAST</h2><p class=\"bb_paragraph\" >Immerse yourself in a story inspired by classic pulp fantasy, equal parts mature and unhinged,  telling a personal tale atop a brewing intrigue and an ancient tragedy.</p><p class=\"bb_paragraph\" >Rich and dense prose packs a sci-fi RPG epic into a blitzing FPS campaign.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2886740/extras/eb0046b506d55af900488285a2b5a899.avif?t=1759082383\" width=1127 height=294 /></span></p>","developers":["chimp"],"genres":[{"description":"Action","id":"1"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2886740/header.jpg?t=1759082383","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2886740/1739002285/a39a367b2fd6b8815ff6317aeccf70c557bb7047/1755865753/dash_av1.mpd?t=1755870319","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2886740/1739002285/a39a367b2fd6b8815ff6317aeccf70c557bb7047/1755865753/dash_h264.mpd?t=1755870319","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2886740/1739002285/a39a367b2fd6b8815ff6317aeccf70c557bb7047/1755865753/hls_264_master.m3u8?t=1755870319","id":257186917,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257186917/movie480.mp4?t=1755870319","max":"https://video.akamai.steamstatic.com/store_trailers/25