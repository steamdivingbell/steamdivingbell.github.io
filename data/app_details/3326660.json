lass=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3326660/extras/freetalk.gif?t=1744942187\" /></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><strong>\u25cfThe girl's lines will be fully voiced!</strong> (Japanese only)</p><h2 class=\"bb_tag\"><strong>\uff1cCharacter Design\uff1e</strong></h2><p class=\"bb_paragraph\">Hiro Kiyohara</p><h2 class=\"bb_tag\"><strong>\uff1cCast\uff1e</strong></h2><p class=\"bb_paragraph\">Aoi Hinata</p>","developers":["MUTAN","storynote"],"genres":[{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3326660/header.jpg?t=1744942187","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257078812,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257078812/movie480.mp4?t=1733568218","max":"http://video.akamai.steamstatic.com/store_trailers/257078812/movie_max.mp4?t=1733568218"},"name":"241203_multiple_PV1_120sec_EN_\u7ffb\u8a33","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257078812/3c350146343147b6045df16d27c27fae17c899d8/movie_600x337.jpg?t=1733568218","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257078812/movie480_vp9.webm?t=1733568218","max":"http://video.akamai.steamstatic.com/store_trailers/257078812/movie_max_vp9.webm?t=1733568218"}},{"highlight":true,"id":257125525,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257125525/movie480.mp4?t=1744942019","max":"http://video.akamai.steamstatic.com/store_trailers/257125525/movie_max.mp4?t=1744942019"},"name":"PV02_EN","thumbnail":"https://