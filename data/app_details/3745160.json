deo class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3745160/extras/88a614960071954193995454807afe18.poster.avif?t=1768491290\" width=600 height=246 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3745160/extras/88a614960071954193995454807afe18.webm?t=1768491290\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3745160/extras/88a614960071954193995454807afe18.mp4?t=1768491290\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >As your park grows, you\u2019ll be able to train staff, build a high-efficiency team, and keep things under control\u2014at least until the next dino decides to test the fences.</p>","developers":["Lemonova Games"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3745160/d92f5bc8a3232ddfa87a1459b1477457b7738452/header.jpg?t=1768491290","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 14.4.1<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core i3<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> ATI Radeon HD 5670, 512 MB<br></li><li><strong>Storage:</strong> 8 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3745160/1800382992/c313e69d8207148003712860a31767ce3c9690dc/1768472083/dash_av1.mpd?t=1768473915","dash_h264":"https://video.akamai