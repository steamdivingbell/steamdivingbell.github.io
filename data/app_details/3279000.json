s_d16207282d5bd966067e2fbd062fcb648728d9f0.600x338.jpg?t=1771770144"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279000/82e93a3f40589f159e907feb529660b9766d145f/ss_82e93a3f40589f159e907feb529660b9766d145f.1920x1080.jpg?t=1771770144","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279000/82e93a3f40589f159e907feb529660b9766d145f/ss_82e93a3f40589f159e907feb529660b9766d145f.600x338.jpg?t=1771770144"}],"short_description":"Welcome to BYTEWORLD, the ultimate sandbox experience that aims to bring streamers and viewers together like never before!","steam_appid":3279000,"support_info":{"email":"helpdustries@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}