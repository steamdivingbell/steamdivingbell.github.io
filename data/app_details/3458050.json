m/apps/3458050/1b5867fe45e939579221a51aafd3d6e2183b34e0/ss_1b5867fe45e939579221a51aafd3d6e2183b34e0.1920x1080.jpg?t=1743178597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3458050/1b5867fe45e939579221a51aafd3d6e2183b34e0/ss_1b5867fe45e939579221a51aafd3d6e2183b34e0.600x338.jpg?t=1743178597"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3458050/99117c37d8299ca7cc9efb666e38516100dba907/ss_99117c37d8299ca7cc9efb666e38516100dba907.1920x1080.jpg?t=1743178597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3458050/99117c37d8299ca7cc9efb666e38516100dba907/ss_99117c37d8299ca7cc9efb666e38516100dba907.600x338.jpg?t=1743178597"}],"short_description":"Join a co-op team of 4 friends in a first person shooter that sends Pan Galactic Postal Service letter carriers into the locked-down streets of the future! Fight mutated alien horrors as you and your fellow essential workers deliver baubles to hard-to-find destinations! Hey, at least it's a job!","steam_appid":3458050,"support_info":{"email":"","url":"https://discord.gg/YRYdtwWN"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}