m/apps/3994610/18931453098f9983fef4ce85434d1e428cbc30fd/ss_18931453098f9983fef4ce85434d1e428cbc30fd.600x338.jpg?t=1774821803"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3994610/d2ab50dcd54f7d7edb4b300665d98f0597586d4f/ss_d2ab50dcd54f7d7edb4b300665d98f0597586d4f.1920x1080.jpg?t=1774821803","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3994610/d2ab50dcd54f7d7edb4b300665d98f0597586d4f/ss_d2ab50dcd54f7d7edb4b300665d98f0597586d4f.600x338.jpg?t=1774821803"}],"short_description":"Ready to become a mad scientist? Synthesize, evolve, and command an army of unique creatures in your own lab. Manage your laboratory, master genetic essences, and dominate the battle arena in this deep creature collection simulator!","steam_appid":3994610,"support_info":{"email":"info@round3studios.com","url":"https://monsterlabsimulator.com/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Simplified Chinese, Portuguese - Brazil, Traditional Chinese, Japanese, Korean, Polish, Portuguese - Portugal, Russian, Turkish, Ukrainian, Dutch, Arabic, Spanish - Latin America, Czech","type":"game","website":"https://monsterlabsimulator.com"}