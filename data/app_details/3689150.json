com/store_item_assets/steam/apps/3689150/3684c7fa780fab087cd505f53923597c2131d3b4/ss_3684c7fa780fab087cd505f53923597c2131d3b4.1920x1080.jpg?t=1760690478","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3689150/3684c7fa780fab087cd505f53923597c2131d3b4/ss_3684c7fa780fab087cd505f53923597c2131d3b4.600x338.jpg?t=1760690478"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3689150/bea3ff928282c1fdc0527d7430086b251000ebe4/ss_bea3ff928282c1fdc0527d7430086b251000ebe4.1920x1080.jpg?t=1760690478","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3689150/bea3ff928282c1fdc0527d7430086b251000ebe4/ss_bea3ff928282c1fdc0527d7430086b251000ebe4.600x338.jpg?t=1760690478"}],"short_description":"A fast, physics-driven platformer inspired by genre classics, with a sticky twist. Grapple, swing, and launch through pipe networks, pulley belts, and electric hazards as a newly created gooey science experiment. Collect the L, A, and B and reach the beacon! Build and share levels on Steam Workshop.","steam_appid":3689150,"support_info":{"email":"contact@ogpixelgames.com","url":"www.ogpixelgames.com"},"supported_languages":"English","type":"game","website":null}