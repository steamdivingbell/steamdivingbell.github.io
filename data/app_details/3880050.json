14"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3880050/47eed3f0c6aa58d30d06ba23384e5b9c2d495279/ss_47eed3f0c6aa58d30d06ba23384e5b9c2d495279.1920x1080.jpg?t=1757333614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3880050/47eed3f0c6aa58d30d06ba23384e5b9c2d495279/ss_47eed3f0c6aa58d30d06ba23384e5b9c2d495279.600x338.jpg?t=1757333614"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3880050/515faf86face7c8d6e0d9ee7611cf4ac6f3fbbde/ss_515faf86face7c8d6e0d9ee7611cf4ac6f3fbbde.1920x1080.jpg?t=1757333614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3880050/515faf86face7c8d6e0d9ee7611cf4ac6f3fbbde/ss_515faf86face7c8d6e0d9ee7611cf4ac6f3fbbde.600x338.jpg?t=1757333614"}],"short_description":"Amanita is an introspective journey into your mind where the path seems to be only one, and it does not seem to be easy. Let yourself be guided by surreal characters in your thoughts, clash with your memories with sword blows, wander in your memory, play cards with your fears.","steam_appid":3880050,"support_info":{"email":"gibberi.games@gmail.com","url":""},"supported_languages":"English, Italian, Spanish - Spain","type":"game","website":null}