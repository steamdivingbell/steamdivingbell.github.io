ecurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Intruder - <span class=\"discount_original_price\">$19.99</span> $9.99 USD","packageid":121336,"percent_savings":0,"percent_savings_text":"-50% ","price_in_cents_with_discount":999}],"title":"Buy Intruder"}],"packages":[121336],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS *:</strong> Windows 7 or Newer<br></li><li><strong>Processor:</strong> 64-bit, 2 GHz or Faster<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD 3000<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 3 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS *:</strong> Windows 7 or Newer<br></li><li><strong>Processor:</strong> 64-bit, 3 GHz or Faster<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Geforce GTX 750<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 3 GB available space</li></ul>"},"platforms":{"linux":false,"mac":true,"windows":true},"price_overview":{"currency":"USD","discount_percent":50,"final":999,"final_formatted":"$9.99 USD","initial":1999,"initial_formatted":"$19.99"},"publishers":["Superboss Games"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"igrs":{"banned":"0","descriptors":"Interaksi Daring\nKekerasan","rating":"18","rating_generated":"1","required_age":"18","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Drastische Gewalt","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"recommendations":{"total":5337},"release_date":{"coming_soon":false,"date":"1 Mar, 2019"},"required_age":0,"reviews":"\u201cThere is a pivot point in most tactical multiplayer games, a moment where plans crumble and everything goes wrong, and--if everyone is friendly-- it makes the game ten times better. Swat 4 had it. Rainbow Six had it. And Intruder has it. Hell, Intruder quantifies it.\u201d<br>Rock, Paper, Shotgun<br><br>\u201cFactor in full friendly fire and you'll see that Superboss Games have created something rare \u2013 a shooter where you really have to think before pulling the trigger.\u201d<br>PC Gamer<br><br>\u201cIntruder is tense. It might be the scariest first person shooter I\u2019ve ever played. It\u2019s a game about learning fieldcraft, a certain way of doing things. That\u2019s why I think it\u2019s one of the best multiplayer shooters I\u2019ve played.\u201d<br>Playboy<br>","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_69422a52e60b2e9c1b3011fc84989c2c1cc1d8f5.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_69422a52e60b2e9c1b3011fc84989c2c1cc1d8f5.600x338.jpg?t=1773939698"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_3279778a737b988fd990d084731edf4357bf65c7.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_3279778a737b988fd990d084731edf4357bf65c7.600x338.jpg?t=1773939698"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_3786082ff4df537870d1016562d92f37273164c1.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_3786082ff4df537870d1016562d92f37273164c1.600x338.jpg?t=1773939698"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_2c7afb2af306adc0f7de4a4e4c46da8388b63bdc.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_2c7afb2af306adc0f7de4a4e4c46da8388b63bdc.600x338.jpg?t=1773939698"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_0e2795ecfb515eccba0947cb8aa209b43c417658.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_0e2795ecfb515eccba0947cb8aa209b43c417658.600x338.jpg?t=1773939698"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_c76e97b32403832a7be42544d09a9162532a7773.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_c76e97b32403832a7be42544d09a9162532a7773.600x338.jpg?t=1773939698"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_31e0941d888a9f230b60f71a8bb2d19c886ed615.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_31e0941d888a9f230b60f71a8bb2d19c886ed615.600x338.jpg?t=1773939698"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_e8be8eb9262d17bcdb581e26b07de3d3b1169cfb.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_e8be8eb9262d17bcdb581e26b07de3d3b1169cfb.600x338.jpg?t=1773939698"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_55753856870545457ab2693286470faebf2ecb8d.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_55753856870545457ab2693286470faebf2ecb8d.600x338.jpg?t=1773939698"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_539d0a07663f8d646976c3a2169f2ff68167753f.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_539d0a07663f8d646976c3a2169f2ff68167753f.600x338.jpg?t=1773939698"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_e4df25fc905049edb65ef4c1a3b454c7eb987feb.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_e4df25fc905049edb65ef4c1a3b454c7eb987feb.600x338.jpg?t=1773939698"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_44e1b11a82be97f133dbe44dad9418fa178fa6b4.1920x1080.jpg?t=1773939698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/518150/ss_44e1b11a82be97f133dbe44dad9418fa178fa6b4.600x338.jpg?t=1773939698"}],"short_description":"The ultimate spy-vs-guards simulator. Carefully sneak your way to the objective as Intruders or use the wide variety of tactical gadgets to trap your opponents as Guards. Intruder allows for stealth, teamwork, and environmental interactions never before seen in a multiplayer game.","steam_appid":518150,"support_info":{"email":"support@superbossgames.com","url":"http://superbossgames.helprace.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://intruderfps.com/"}