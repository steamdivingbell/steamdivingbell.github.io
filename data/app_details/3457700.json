bb_paragraph\" ></p>","developers":["Hedgehog Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3457700/34a2eba6ed49791ff4f01b5472bd3d1e20b18b2b/header.jpg?t=1758459414","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3457700/616742458/cf3f64b5eccf5e3add82fe6de969c2e41da9e1b3/1755916028/dash_av1.mpd?t=1755916717","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3457700/616742458/cf3f64b5eccf5e3add82fe6de969c2e41da9e1b3/1755916028/dash_h264.mpd?t=1755916717","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3457700/616742458/cf3f64b5eccf5e3add82fe6de969c2e41da9e1b3/1755916028/hls_264_master.m3u8?t=1755916717","id":257134807,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257134807/movie480.mp4?t=1755916717","max":"https://video.akamai.steamstatic.com/store_trailers/257134807/movie_max.mp4?t=1755916717"},"name":"Dungeon! Order of the Raven Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257134807/964f65a1e21726bd2fc87a8a318426a211a0061b/movie_600x337.jpg?t=1755916717","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257134807/movie480_vp9.webm?t=1755916717","max":"https://video.akamai.steamstatic.com/store_trailers/257134807/movie_max_vp9.webm?t=1755916717"}}],"name":"DUNGEON!: Order of the Raven","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10<br></li><li><strong>Processor:</strong> Intel Core i5-8400<br></li><li><strong>Memory:</strong> 16 MB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 560<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 2