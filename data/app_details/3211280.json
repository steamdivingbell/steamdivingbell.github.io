 league!</p>","developers":["Developer Dob"],"dlc":[3490380],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Sports","id":"18"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3211280/8a6996e7070ca4e68cfabe1ef8d166ce6826f4b1/header.jpg?t=1760547039","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3211280/828298/5cee8ac69b2bf0f45426c2ee74a5561ed4dbd665/1750881352/dash_av1.mpd?t=1742929850","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3211280/828298/5cee8ac69b2bf0f45426c2ee74a5561ed4dbd665/1750881352/dash_h264.mpd?t=1742929850","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3211280/828298/5cee8ac69b2bf0f45426c2ee74a5561ed4dbd665/1750881352/hls_264_master.m3u8?t=1742929850","id":257097954,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257097954/movie480.mp4?t=1742929850","max":"https://video.akamai.steamstatic.com/store_trailers/257097954/movie_max.mp4?t=1742929850"},"name":"Short Reel","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257097954/46b00fb2afeab17e8a1fa42ae1749a98366fd1cb/movie_600x337.jpg?t=1742929850","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257097954/movie480_vp9.webm?t=1742929850","max":"https://video.akamai.steamstatic.com/store_trailers/257097954/movie_max_vp9.webm?t=1742929850"}},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3211280/828718/63976c0a1d96af158761c932f8bc104a58005a00/1750881352/dash_av1.mpd?t=1739522495","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3211280/828718/63976c0a1d96af158761c932f8bc104a58005a00/1750881352/dash_h264.mpd?t=1739522495","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3211280/828718/63976c0a1d96af158761c932f8bc104a58005a00/1750881352/hls_264_master.m