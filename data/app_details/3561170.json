ong><i>Disclaimer: Explore the galaxy in the Early Access version of Leaks in Space. Check out our Public Roadmap above, we'll keep working on the game and update the roadmap as development progresses.</i></strong></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >  </p>","developers":["Frostech Game Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3561170/72050eb2c79c12482d997dabd44f93a1d1c49002/header.jpg?t=1759422793","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3561170/2062473544/658f6e74c22e21eba17af6af0143946339741135/1759421970/dash_av1.mpd?t=1759422791","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3561170/2062473544/658f6e74c22e21eba17af6af0143946339741135/1759421970/dash_h264.mpd?t=1759422791","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3561170/2062473544/658f6e74c22e21eba17af6af0143946339741135/1759421970/hls_264_master.m3u8?t=1759422791","id":257210911,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257210911/movie480.mp4?t=1759422791","max":"https://video.akamai.steamstatic.com/store_trailers/257210911/movie_max.mp4?t=1759422791"},"name":"Leaks In Space Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257210911/9ed958ca1f38ae236c3c911ed17cb90836e6efb4/movie_600x337.jpg?t=1759422791","webm":{"480":"https://video.akamai.steamstat