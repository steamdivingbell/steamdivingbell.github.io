.jpg?t=1771833097"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005700/9b28f29fbe8ec4de75725bcae0e6e3da6a401d58/ss_9b28f29fbe8ec4de75725bcae0e6e3da6a401d58.1920x1080.jpg?t=1771833097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005700/9b28f29fbe8ec4de75725bcae0e6e3da6a401d58/ss_9b28f29fbe8ec4de75725bcae0e6e3da6a401d58.600x338.jpg?t=1771833097"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005700/87bd452b0658385a1c7846fdbe55836b0d720ad3/ss_87bd452b0658385a1c7846fdbe55836b0d720ad3.1920x1080.jpg?t=1771833097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005700/87bd452b0658385a1c7846fdbe55836b0d720ad3/ss_87bd452b0658385a1c7846fdbe55836b0d720ad3.600x338.jpg?t=1771833097"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005700/5b575782658f7219de984bb4d83d9fc6e804f821/ss_5b575782658f7219de984bb4d83d9fc6e804f821.1920x1080.jpg?t=1771833097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005700/5b575782658f7219de984bb4d83d9fc6e804f821/ss_5b575782658f7219de984bb4d83d9fc6e804f821.600x338.jpg?t=1771833097"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005700/6c0c609475a01c17f165cee0af55df20d2223ea9/ss_6c0c609475a01c17f165cee0af55df20d2223ea9.1920x1080.jpg?t=1771833097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3005700/6c0c609475a01c17f165cee0af55df20d2223ea9/ss_6c0c609475a01c17f165cee0af55df20d2223ea9.600x338.jpg?t=1771833097"}],"short_description":"Take on the role of a lighthouse keeper on a remote island. Maintain the machinery, use the radio and the map to guide ships into the harbor. Survive and uncover the mysteries of Farpoint Island in a horror experience inspired by Voices of the Void and No One Lives Under the Lighthouse.","steam_appid":3005700,"support_info":{"email":"Mar.davidoff@gmail.com","url":""},"supported_languages":"English, Russian, French, Italian, German, Spanish - Spain, Simplified Chinese, Korean, Japanese","type":"game","website":null}