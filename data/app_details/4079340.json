_45b7af133c7d17b143046ff2f51f6b48b43ddcd1.600x338.jpg?t=1765568843"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/0d89c3b821d0ac9bf8b20f0001768bb10c8b186a/ss_0d89c3b821d0ac9bf8b20f0001768bb10c8b186a.1920x1080.jpg?t=1765568843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/0d89c3b821d0ac9bf8b20f0001768bb10c8b186a/ss_0d89c3b821d0ac9bf8b20f0001768bb10c8b186a.600x338.jpg?t=1765568843"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/7d8511ded808ecc03b8820d0943a3a5a44800e17/ss_7d8511ded808ecc03b8820d0943a3a5a44800e17.1920x1080.jpg?t=1765568843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/7d8511ded808ecc03b8820d0943a3a5a44800e17/ss_7d8511ded808ecc03b8820d0943a3a5a44800e17.600x338.jpg?t=1765568843"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/d18d159b55690b582ba20a882e329944ab5d325f/ss_d18d159b55690b582ba20a882e329944ab5d325f.1920x1080.jpg?t=1765568843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/d18d159b55690b582ba20a882e329944ab5d325f/ss_d18d159b55690b582ba20a882e329944ab5d325f.600x338.jpg?t=1765568843"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/8c8db334be4f87c61d3f1cee179e938a38c49f4a/ss_8c8db334be4f87c61d3f1cee179e938a38c49f4a.1920x1080.jpg?t=1765568843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/8c8db334be4f87c61d3f1cee179e938a38c49f4a/ss_8c8db334be4f87c61d3f1cee179e938a38c49f4a.600x338.jpg?t=1765568843"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/ce8586cc48e436e440dd45177c7e246f1e2087fd/ss_ce8586cc48e436e440dd45177c7e246f1e2087fd.1920x1080.jpg?t=1765568843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/ce8586cc48e436e440dd45177c7e246f1e2087fd/ss_ce8586cc48e436e440dd45177c7e246f1e2087fd.600x338.jpg?t=1765568843"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/c131048df5d64eb18ce8cb1c8c7f8e2fefc6eacc/ss_c131048df5d64eb18ce8cb1c8c7f8e2fefc6eacc.1920x1080.jpg?t=1765568843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4079340/c131048df5d64eb18ce8cb1c8c7f8e2fefc6eacc/ss_c131048df5d64eb18ce8cb1c8c7f8e2fefc6eacc.600x338.jpg?t=1765568843"}],"short_description":"Psychological single-player first-person horror. Explore dark environments, fight with melee and guns, and solve puzzles in this retro 2000s-inspired nightmare where the truth is more terrifying than the monsters.","steam_appid":4079340,"support_info":{"email":"press@mystivedev.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.mystivedev.com"}