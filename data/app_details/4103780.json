338.jpg?t=1760978239"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4103780/8d68316b8dad3851e6816fe411fbc5a715513a69/ss_8d68316b8dad3851e6816fe411fbc5a715513a69.1920x1080.jpg?t=1760978239","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4103780/8d68316b8dad3851e6816fe411fbc5a715513a69/ss_8d68316b8dad3851e6816fe411fbc5a715513a69.600x338.jpg?t=1760978239"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4103780/510005672f052149baf2b1dac73ba4fe15f4ab0f/ss_510005672f052149baf2b1dac73ba4fe15f4ab0f.1920x1080.jpg?t=1760978239","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4103780/510005672f052149baf2b1dac73ba4fe15f4ab0f/ss_510005672f052149baf2b1dac73ba4fe15f4ab0f.600x338.jpg?t=1760978239"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4103780/62976a541fbcd68925ec275375679e12e418175a/ss_62976a541fbcd68925ec275375679e12e418175a.1920x1080.jpg?t=1760978239","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4103780/62976a541fbcd68925ec275375679e12e418175a/ss_62976a541fbcd68925ec275375679e12e418175a.600x338.jpg?t=1760978239"}],"short_description":"Battle Stones is a single-player turn-based strategy deckbuilding roguelike. Place stones on a board and leverage their combo rules and special effects. Expand your deck and even merge stones to create more powerful moves. Will you master the art of the stones and win all your battles ?","steam_appid":4103780,"support_info":{"email":"","url":"https://radiantsloth.com/contact"},"supported_languages":"English, French","type":"game","website":"https://radiantsloth.com/"}