d.akamai.steamstatic.com/store_item_assets/steam/apps/4037460/extras/60f70ef9aba627b76cd525fb7774e6a9.avif?t=1764687867\" width=721 height=506 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">Teamwork, Timing, and Pancakes.</p>","developers":["Noble","Qyvex"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4037460/e01754d2e936decbc0a48b51dec80462af36f761/header.jpg?t=1764687867","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4037460/50441868/21f360180a81aee99979bd1ae68f7e1fa60b51db/1757981346/dash_av1.mpd?t=1759244454","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4037460/50441868/21f360180a81aee99979bd1ae68f7e1fa60b51db/1757981346/dash_h264.mpd?t=1759244454","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4037460/50441868/21f360180a81aee99979bd1ae68f7e1fa60b51db/1757981346/hls_264_master.m3u8?t=1759244454","id":257198397,"name":"Greg moved..","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257198397/7a9d3a3db1c970ee9609daa3cf43f77a89468559/movie_600x337.jpg?t=1759244454"}],"name":"Planets and Pancakes","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10<br></li><li><strong>Processor:</strong> 3GHz 4-Core or similar<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 1060 or Radeon RX 580<br></li><li><strong>Storage:</strong> 15 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 11<br></li><li><strong>Processor:</strong> 3.5GHz 6-Core or similar<br></li><li><strong>Memory:</strong> 16 GB RAM<br></