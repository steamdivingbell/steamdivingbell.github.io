ic.com/store_item_assets/steam/apps/4078920/413f2bab8eb0911acd12fb134e7458d1fd69253f/ss_413f2bab8eb0911acd12fb134e7458d1fd69253f.600x338.jpg?t=1760724494"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078920/4e2fd33640d4658654aa1aa891b7cbcc48b27959/ss_4e2fd33640d4658654aa1aa891b7cbcc48b27959.1920x1080.jpg?t=1760724494","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078920/4e2fd33640d4658654aa1aa891b7cbcc48b27959/ss_4e2fd33640d4658654aa1aa891b7cbcc48b27959.600x338.jpg?t=1760724494"}],"short_description":"A challenging auto-battling, Roguelite, dungeon crawl. Plan your path. Make tough choices. Survive the descent.","steam_appid":4078920,"support_info":{"email":"games@kudos-systems.org.uk","url":""},"supported_languages":"English","type":"game","website":null}