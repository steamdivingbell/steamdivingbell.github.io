ai.steamstatic.com/store_item_assets/steam/apps/3792510/62839ac325b44a5e61def5f3baf5728d869496e9/ss_62839ac325b44a5e61def5f3baf5728d869496e9.600x338.jpg?t=1761749401"}],"short_description":"EL COCO is a 3D action roguelike game that immerses you in a world of dreams, broken memories and nightmares incarnate. Descend into the Uncertain, a place as strange as it is dangerous, and fight to recover what you lost... if you can trust your guide.","steam_appid":3792510,"support_info":{"email":"soporte@recotech.es","url":"www.recotech.es"},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain<strong>*</strong>, Portuguese - Brazil<br><strong>*</strong>languages with full audio support","type":"game","website":"https://recotech.es/"}