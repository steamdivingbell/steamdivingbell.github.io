ai.steamstatic.com/store_item_assets/steam/apps/3879350/79b6506efc33960b97bf90bae39351451fbd7e88/ss_79b6506efc33960b97bf90bae39351451fbd7e88.1920x1080.jpg?t=1759326241","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879350/79b6506efc33960b97bf90bae39351451fbd7e88/ss_79b6506efc33960b97bf90bae39351451fbd7e88.600x338.jpg?t=1759326241"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879350/673a28ca5632bd9bf34bc1189f6418a1dfd0dfeb/ss_673a28ca5632bd9bf34bc1189f6418a1dfd0dfeb.1920x1080.jpg?t=1759326241","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879350/673a28ca5632bd9bf34bc1189f6418a1dfd0dfeb/ss_673a28ca5632bd9bf34bc1189f6418a1dfd0dfeb.600x338.jpg?t=1759326241"}],"short_description":"Pilot your hovercraft across a wild, untamed world in Hover Rancher\u2014a point-and-click adventure packed with action minigames like aerial dogfights and snowboarding! Explore, collect, and deploy troops as you build your ranching empire from the skies.","steam_appid":3879350,"support_info":{"email":"drunkyetilimited@gmail.com","url":"https://www.facebook.com/profile.php?id=61575305636101&amp;sk=about_privacy_and_legal_info"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}