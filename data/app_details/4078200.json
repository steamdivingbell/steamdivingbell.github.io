33","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/01b4f28f031717a5aeb3f546bb1e84804fe45257/ss_01b4f28f031717a5aeb3f546bb1e84804fe45257.600x338.jpg?t=1767469533"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/cd22e2c0272bb0209ea754b612395138421a3867/ss_cd22e2c0272bb0209ea754b612395138421a3867.1920x1080.jpg?t=1767469533","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/cd22e2c0272bb0209ea754b612395138421a3867/ss_cd22e2c0272bb0209ea754b612395138421a3867.600x338.jpg?t=1767469533"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/909c3978771bc7d5246602637ac22da6eda3c485/ss_909c3978771bc7d5246602637ac22da6eda3c485.1920x1080.jpg?t=1767469533","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/909c3978771bc7d5246602637ac22da6eda3c485/ss_909c3978771bc7d5246602637ac22da6eda3c485.600x338.jpg?t=1767469533"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/67ff0479983747c09e70ae6cefa1ac99724fed60/ss_67ff0479983747c09e70ae6cefa1ac99724fed60.1920x1080.jpg?t=1767469533","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/67ff0479983747c09e70ae6cefa1ac99724fed60/ss_67ff0479983747c09e70ae6cefa1ac99724fed60.600x338.jpg?t=1767469533"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/460918c3ae74861c61c2bae4d2d9ad1ea3a5088a/ss_460918c3ae74861c61c2bae4d2d9ad1ea3a5088a.1920x1080.jpg?t=1767469533","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/460918c3ae74861c61c2bae4d2d9ad1ea3a5088a/ss_460918c3ae74861c61c2bae4d2d9ad1ea3a5088a.600x338.jpg?t=1767469533"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/bb0688d8529841dfd23127f5fe786818c6e8744e/ss_bb0688d8529841dfd23127f5fe786818c6e8744e.1920x1080.jpg?t=1767469533","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078200/bb0688d8529841dfd23127f5fe786818c6e8744e/ss_bb0688d8529841dfd23127f5fe786818c6e8744e.600x338.jpg?t=1767469533"}],"short_description":"Dwarves hunger for gold, and no mountain shall stand in their way! So growls the Great Maw! Build great forges and war machines designed to obliterate stone. Gather an abundance of riches and ancient artifacts, to upgrade your dwarves and devour all the mountains whole!","steam_appid":4078200,"support_info":{"email":"greenwizardgames@proton.me","url":"https://discord.gg/SAP2zQvzvv"},"supported_languages":"English","type":"game","website":null}