s/steam/apps/3286460/9d14b672941df8240da3f6053d0bc82bf650fdda/ss_9d14b672941df8240da3f6053d0bc82bf650fdda.1920x1080.jpg?t=1743008746","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286460/9d14b672941df8240da3f6053d0bc82bf650fdda/ss_9d14b672941df8240da3f6053d0bc82bf650fdda.600x338.jpg?t=1743008746"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286460/ff42a7c9ef0348d5781ab180b7d5a678bcc1d6ed/ss_ff42a7c9ef0348d5781ab180b7d5a678bcc1d6ed.1920x1080.jpg?t=1743008746","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286460/ff42a7c9ef0348d5781ab180b7d5a678bcc1d6ed/ss_ff42a7c9ef0348d5781ab180b7d5a678bcc1d6ed.600x338.jpg?t=1743008746"}],"short_description":"Two Sides: Voyage to the Mainland is a management game where you play as a divine being who guides his people using his incredible powers. Will they be cute, overly benevolent people, or a people who live from day to day with no respect for anything?","steam_appid":3286460,"support_info":{"email":"contact@thunder-games.com","url":""},"supported_languages":"French, English","type":"game","website":null}