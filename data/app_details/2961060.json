ets/steam/apps/2961060/extras/89e6aaae18e07011fe40d955aa2b50ae.webm?t=1772833781\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2961060/extras/89e6aaae18e07011fe40d955aa2b50ae.mp4?t=1772833781\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Other things in the game</h2><p class=\"bb_paragraph\" >You can also ride horses, get drunk on fermented fruit, build ladders to get over city walls, and chop just about everything including flowers and talking robots from the future.</p>","developers":["Luke Wenke"],"dlc":[3081010,4221720],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Free To Play","id":"37"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2961060/833d13e701210445358bccd638b2ada473c13e07/header.jpg?t=1772833781","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 12 Monterey<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core M<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Storage:</strong> 400 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2961060/1043922631/f7c847be17bc8d181a23e6358fd293cfecd05e16/1765082659/dash_av1.mpd?t=1765086351","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2961060/1043922631/f7c847be17bc8d181a23e6358fd293cfecd05e16/1765082659/dash_h264.mpd?t=1765086351","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2961060/1043922631/f7c847be17bc8d181a23e6358fd29