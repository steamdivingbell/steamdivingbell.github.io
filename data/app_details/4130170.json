ets/steam/apps/4130170/dcea5156aad9f983c3a65e6ff0cb0db77c746f9e/ss_dcea5156aad9f983c3a65e6ff0cb0db77c746f9e.600x338.jpg?t=1762810825"}],"short_description":"Orava is a point and click style 2.5D adventure puzzle game controlled by keyboard about a squirrel who wants to find their nut. Explore the mysterious forest, pick up items, solve puzzles and ask strange characters whether or not they have seen your precious nut. A charming, hand-painted adventure.","steam_appid":4130170,"support_info":{"email":"orava.helpline@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}