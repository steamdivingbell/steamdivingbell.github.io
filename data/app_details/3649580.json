</p></li><li><p class=\"bb_paragraph\">10 powerful starting heroes, each with his own unique skills to help you fight</p></li><li><p class=\"bb_paragraph\"><strong>More than 100 buildings</strong>, bringing overall improvement</p></li><li><p class=\"bb_paragraph\"><strong>More than 80 enemies</strong>, can you resist the oppressive disaster</p></li></ul><h2 class=\"bb_tag\"><strong>BREAK THE CURSE</strong></h2><p class=\"bb_paragraph\">Civilization is frozen at this moment, the mysterious old man, the entanglement of different schools, the alienated enemies... The truth of the world is waiting for you to solve!</p>","developers":["LyraStudio"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3649580/69680c0829e54d360de1bb08d51ea9f0e3b66386/header.jpg?t=1745285452","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"FrostBound","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 960</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce RTX 1060</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["LyraStudio"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"2025"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3649580/5d5cfef9c3964e936a6e52252bdddf6e7e9a1bbe/ss_5d5cfef9c3964e936a6e52252bdddf6e7e9a1bbe.1920x1080.jpg?t=1745285452","path_thumbnail