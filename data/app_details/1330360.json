869376bbca13facb92de23ded47/ss_f8f334fb59a05869376bbca13facb92de23ded47.600x338.jpg?t=1756452590"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_f22a2554faf675ccc53d0d08d4a53774c770bb01.1920x1080.jpg?t=1756452590","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_f22a2554faf675ccc53d0d08d4a53774c770bb01.600x338.jpg?t=1756452590"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_981268b50b9c39921571c7668bec98cbec9baccc.1920x1080.jpg?t=1756452590","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_981268b50b9c39921571c7668bec98cbec9baccc.600x338.jpg?t=1756452590"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_f570fd408b0cc07b091139497c370e9a5ee6ce78.1920x1080.jpg?t=1756452590","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_f570fd408b0cc07b091139497c370e9a5ee6ce78.600x338.jpg?t=1756452590"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_d577d85f1fe808d711f54c9fe18819e97ca08928.1920x1080.jpg?t=1756452590","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_d577d85f1fe808d711f54c9fe18819e97ca08928.600x338.jpg?t=1756452590"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_ed1d17762ff11b505c177f1b423a6cf4259c1dbc.1920x1080.jpg?t=1756452590","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_ed1d17762ff11b505c177f1b423a6cf4259c1dbc.600x338.jpg?t=1756452590"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_10a27ac6353663f1e736eed61dbf3c1815e1a9bd.1920x1080.jpg?t=1756452590","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_10a27ac6353663f1e736eed61dbf3c1815e1a9bd.600x338.jpg?t=1756452590"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_be0bc1f93bf3a4cb797ad781c8160be63f999bc9.1920x1080.jpg?t=1756452590","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1330360/ss_be0bc1f93bf3a4cb797ad781c8160be63f999bc9.600x338.jpg?t=1756452590"}],"short_description":"Inspired by the god games of old, Fata Deum lets you mold settlements and townsfolk in your image. Will you raise the settlements to splendor, or spur them on to violent debauchery and demons? Watch as a living world grows under your whims.","steam_appid":1330360,"support_info":{"email":"info@42bits-entertainment.com","url":"https://www.fata-deum.com"},"supported_languages":"English, German, French, Italian, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Traditional Chinese","type":"game","website":"https://fata-deum.com"}