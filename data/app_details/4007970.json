rsion, you can play the early part of Story Mode.</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Gallery Tour Mode</strong> <br>Freely challenge the boss at your own pace. </p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong><i>...Are you ready to face your past?</i></strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>\ud83c\udf19</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Soundtrack: BGMemon</p>","developers":["MazurkaDev"],"fullgame":{"appid":"3960990","name":"Gallery of Night Order"},"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4007970/4f35e034731c15c2aeb98f8c4f7a2cb28186f9e0/header.jpg?t=1757982156","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257193497,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257193497/movie480.mp4?t=1757982151","max":"http://video.akamai.steamstatic.com/store_trailers/257193497/movie_max.mp4?t=1757982151"},"name":"Demo Gameplay en","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257193497/e0494aaf71a20e2b984a3012a130ba126548b9ea/movie_600x337.jpg?t=1757982151","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257193497/movie480_vp9.webm?t=1757982151","max":"http://video.akamai.steamstatic.com/store_trailers/257193497/movie_max_vp9.webm?t=1757982151"}}],"name":"Gallery of Night Order Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64