tem_assets/steam/apps/3317000/e835a3f64f88d2bca79dd20e35033e7437c3e73b/ss_e835a3f64f88d2bca79dd20e35033e7437c3e73b.1920x1080.jpg?t=1773502669","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3317000/e835a3f64f88d2bca79dd20e35033e7437c3e73b/ss_e835a3f64f88d2bca79dd20e35033e7437c3e73b.600x338.jpg?t=1773502669"}],"short_description":"An anime hack and slash fighting game. Seek vengeance, strike down your foes. Cut them down and set your heart free.","steam_appid":3317000,"support_info":{"email":"owencmyk@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://bladeswiki.owencmyk.xyz/"}