 class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Pjoy Games"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3938800/1a6db854cd3023a91349567d8a7eebba9f644ee6/header.jpg?t=1772608067","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Pleasure Room - Haunted Apartment","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7/8/8.1/10 (64-bit)<br></li><li><strong>Processor:</strong>  Intel Core 2 Duo or equivalent<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> DirectX 9/OpenGL 4.1 capable GPU<br></li><li><strong>DirectX:</strong> Version 9.0c<br></li><li><strong>Storage:</strong> 1 GB available space<br></li><li><strong>Sound Card:</strong> DirectX-compatible sound card<br></li><li><strong>VR Support:</strong> None</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3 or better<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong>  Dedicated GPU with 1 GB VRAM (NVIDIA GeForce GT 730 / AMD equivalent or better)<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space<br></li><li><strong>Sound Card:</strong> DirectX-compatible sound card<br></li><li><strong>VR Support:</strong> None</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Siluman Soft"],"ratings":{"dejus":{"banned":"0","descriptors":"Nudez\nLinguagem impr\u00f3pria\nMedo","rating":"18","rating_generated":"1","required_age":"18","use_age_gate":"0"},"steam_germany":{"banned":"1","descriptors":"Sexuelle Inhalte\nAlkohol / Tabak\nSchimpfw\u00f6rte","rating":"BANNED","r