_assets/steam/apps/3376120/df062c17cf080e255da2bdd83ae35ec76850bd68/ss_df062c17cf080e255da2bdd83ae35ec76850bd68.600x338.jpg?t=1750768895"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3376120/4d562280ae34635600c303831a1bad977ee0fc4e/ss_4d562280ae34635600c303831a1bad977ee0fc4e.1920x1080.jpg?t=1750768895","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3376120/4d562280ae34635600c303831a1bad977ee0fc4e/ss_4d562280ae34635600c303831a1bad977ee0fc4e.600x338.jpg?t=1750768895"}],"short_description":"Let\u2019s save the world through dreaming\u2014together!&quot;Awaking Beauty Demo&quot; is a two-character roguelite action game that blends sci-fi and fantasy. You\u2019ll play as selected high school girls piloting dream-diving mechas to rescue those trapped in the dream world.","steam_appid":3376120,"support_info":{"email":"yohcanstudio@gmail.com","url":"https://linktr.ee/yohcanstudio"},"supported_languages":"English, Traditional Chinese, Spanish - Spain, Japanese, Simplified Chinese, Korean","type":"demo","website":null}