m_assets/steam/apps/3958810/31825c987e2060bfc1f37632ed97d7910ccebd0d/ss_31825c987e2060bfc1f37632ed97d7910ccebd0d.600x338.jpg?t=1758333440"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3958810/3a060ee631745d0faf023e16b8b84d30421159c3/ss_3a060ee631745d0faf023e16b8b84d30421159c3.1920x1080.jpg?t=1758333440","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3958810/3a060ee631745d0faf023e16b8b84d30421159c3/ss_3a060ee631745d0faf023e16b8b84d30421159c3.600x338.jpg?t=1758333440"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3958810/bb926d9368caaf90285f59ca026dcf5aa83c03f5/ss_bb926d9368caaf90285f59ca026dcf5aa83c03f5.1920x1080.jpg?t=1758333440","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3958810/bb926d9368caaf90285f59ca026dcf5aa83c03f5/ss_bb926d9368caaf90285f59ca026dcf5aa83c03f5.600x338.jpg?t=1758333440"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3958810/0f903f100f94466d11ba1b9669461b700a366d55/ss_0f903f100f94466d11ba1b9669461b700a366d55.1920x1080.jpg?t=1758333440","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3958810/0f903f100f94466d11ba1b9669461b700a366d55/ss_0f903f100f94466d11ba1b9669461b700a366d55.600x338.jpg?t=1758333440"}],"short_description":"Nebula Cleanup Crew is a short top down action roguelite shooter with a focus on hot and cold weaponry. Rescue your crew members as you blast enemies and bosses away with super heated and chilled weapons \u2014 freeze foes, overheat them and unleash powerful supertemp special attacks!","steam_appid":3958810,"support_info":{"email":"jordan@jazzcatgames.dev","url":"https://www.jazzcatgames.dev/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":null}