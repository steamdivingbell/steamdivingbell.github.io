d":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/a67ec23632b09a8ee2091feefc1371598fc21928/ss_a67ec23632b09a8ee2091feefc1371598fc21928.1920x1080.jpg?t=1757861145","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/a67ec23632b09a8ee2091feefc1371598fc21928/ss_a67ec23632b09a8ee2091feefc1371598fc21928.600x338.jpg?t=1757861145"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/eacf83b4221f76338c5d54246f3c9c2b627aebe3/ss_eacf83b4221f76338c5d54246f3c9c2b627aebe3.1920x1080.jpg?t=1757861145","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/eacf83b4221f76338c5d54246f3c9c2b627aebe3/ss_eacf83b4221f76338c5d54246f3c9c2b627aebe3.600x338.jpg?t=1757861145"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/752904b10e19db3af1d4ce62db2b9b47885c7311/ss_752904b10e19db3af1d4ce62db2b9b47885c7311.1920x1080.jpg?t=1757861145","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/752904b10e19db3af1d4ce62db2b9b47885c7311/ss_752904b10e19db3af1d4ce62db2b9b47885c7311.600x338.jpg?t=1757861145"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/e6204a66f09e4431e9a8f460802cbba66849d7fc/ss_e6204a66f09e4431e9a8f460802cbba66849d7fc.1920x1080.jpg?t=1757861145","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/e6204a66f09e4431e9a8f460802cbba66849d7fc/ss_e6204a66f09e4431e9a8f460802cbba66849d7fc.600x338.jpg?t=1757861145"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/fda2c40f8a5d17a5d791f36c5dff597492c1cb7a/ss_fda2c40f8a5d17a5d791f36c5dff597492c1cb7a.1920x1080.jpg?t=1757861145","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4011100/fda2c40f8a5d17a5d791f36c5dff597492c1cb7a/ss_fda2c40f8a5d17a5d791f36c5dff597492c1cb7a.600x338.jpg?t=1757861145"}],"short_description":"Kingdomino is a charming 1-4 player cosy strategy award winning game. You are a royal seeking new lands in which to expand your kingdom. You must explore all the lands, to spot the best plots, while competing with other lords to acquire them first. Can you conquer the Kingdom?","steam_appid":4011100,"support_info":{"email":"support@meeplecorp.com","url":"www.meeplecorp.com/kingdomino"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Polish, Russian, Simplified Chinese","type":"demo","website":"https://meeplecorp.com/kingdomino/"}