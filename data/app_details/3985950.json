d.akamai.steamstatic.com/store_item_assets/steam/apps/3985950/edcdbece50c05d80056ed00a1266e057235c5084/ss_edcdbece50c05d80056ed00a1266e057235c5084.1920x1080.jpg?t=1764665322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3985950/edcdbece50c05d80056ed00a1266e057235c5084/ss_edcdbece50c05d80056ed00a1266e057235c5084.600x338.jpg?t=1764665322"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3985950/2b0164f7bc3b80d742f6cb68c10cd8da2c1380c4/ss_2b0164f7bc3b80d742f6cb68c10cd8da2c1380c4.1920x1080.jpg?t=1764665322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3985950/2b0164f7bc3b80d742f6cb68c10cd8da2c1380c4/ss_2b0164f7bc3b80d742f6cb68c10cd8da2c1380c4.600x338.jpg?t=1764665322"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3985950/fb4fe16ff951246ae176e4335a77cb9b482b8ee1/ss_fb4fe16ff951246ae176e4335a77cb9b482b8ee1.1920x1080.jpg?t=1764665322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3985950/fb4fe16ff951246ae176e4335a77cb9b482b8ee1/ss_fb4fe16ff951246ae176e4335a77cb9b482b8ee1.600x338.jpg?t=1764665322"}],"short_description":"[UE5 Looter-Shooter] In this top-down Roguelite shooter, you\u2019re not saving the world\u2014you\u2019re just hitting your KPIs. Face massive, physics-driven zombie hordes with Divine Tech and legendary firearms. Craft OP builds to blast the undead into oblivion. Clock in, cash out, and die trying!","steam_appid":3985950,"support_info":{"email":"support@2pgames.net","url":""},"supported_languages":"Simplified Chinese, English, Japanese, Traditional Chinese","type":"game","website":null}