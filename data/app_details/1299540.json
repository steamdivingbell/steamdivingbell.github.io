540/ss_3aa504180365dc5918c633d1a3533c1f00731847.600x338.jpg?t=1775221043"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1299540/ss_5c73ea6d270e9ac58010488f1b947bf97d0d62b4.1920x1080.jpg?t=1775221043","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1299540/ss_5c73ea6d270e9ac58010488f1b947bf97d0d62b4.600x338.jpg?t=1775221043"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1299540/ss_c596436a0fd198c2609630677869831772ef7642.1920x1080.jpg?t=1775221043","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1299540/ss_c596436a0fd198c2609630677869831772ef7642.600x338.jpg?t=1775221043"}],"short_description":"Tactical card battles and narrative RPG exploration in a world of monsters and anomalies. As one of the last remnants of humanity, trapped in the Zone, it's your turn to become a Stalker and walk where others fear to tread.","steam_appid":1299540,"support_info":{"email":"dev@illuminated.games","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://illuminated.games/"}