2fe38.1920x1080.jpg?t=1760063499","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4058000/73aedc616c5f080212edcc45553d1a135722fe38/ss_73aedc616c5f080212edcc45553d1a135722fe38.600x338.jpg?t=1760063499"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4058000/0600b129c8c87cb9742b343bcaace26c0d823b62/ss_0600b129c8c87cb9742b343bcaace26c0d823b62.1920x1080.jpg?t=1760063499","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4058000/0600b129c8c87cb9742b343bcaace26c0d823b62/ss_0600b129c8c87cb9742b343bcaace26c0d823b62.600x338.jpg?t=1760063499"}],"short_description":"Weave acrobatics into combat in this fast-paced 3D action platformer! Play as Mildew, the frog-girl as she collects ingredients to fight off the corporation that repossessed the swamps she calls home. Symbiote emphasizes momentum, high-speed combat and movement expression.","steam_appid":4058000,"support_info":{"email":"trickstergamesllc@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}