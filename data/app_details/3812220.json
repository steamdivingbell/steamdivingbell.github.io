tatic.com/store_item_assets/steam/apps/3812220/39a6abcad70186d7fbdcc0d57b621895d0b58085/ss_39a6abcad70186d7fbdcc0d57b621895d0b58085.1920x1080.jpg?t=1756823133","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812220/39a6abcad70186d7fbdcc0d57b621895d0b58085/ss_39a6abcad70186d7fbdcc0d57b621895d0b58085.600x338.jpg?t=1756823133"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812220/a8304e24a0701360252a2fb3c71e6c4ca68aabce/ss_a8304e24a0701360252a2fb3c71e6c4ca68aabce.1920x1080.jpg?t=1756823133","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812220/a8304e24a0701360252a2fb3c71e6c4ca68aabce/ss_a8304e24a0701360252a2fb3c71e6c4ca68aabce.600x338.jpg?t=1756823133"}],"short_description":"A fast-paced, grid-based, card-flipping tactical CCG for up to 4 players! Archetypes and team Dynamics bring powerful abilities to move, defend, swap, or reorient cards. Capture the board and flip your way to victory!","steam_appid":3812220,"support_info":{"email":"support@AggressiveCombustion.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://aggressivecombustion.com/"}