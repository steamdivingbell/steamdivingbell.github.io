an use to craft the specific cards you need.</p>","developers":["Aggressive Combustion"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812220/8128876b26d1013c4d3e1b228846b55a85af2399/header.jpg?t=1756823133","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3812220/1988286106/71bc34f31bb4e2bb69bb6892359c0247992b0f26/1754884645/dash_av1.mpd?t=1756823129","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3812220/1988286106/71bc34f31bb4e2bb69bb6892359c0247992b0f26/1754884645/dash_h264.mpd?t=1756823129","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3812220/1988286106/71bc34f31bb4e2bb69bb6892359c0247992b0f26/1754884645/hls_264_master.m3u8?t=1756823129","id":257177018,"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257177018/3ca4faa5a45aaafa9049ab17642badd8637d582b/movie_600x337.jpg?t=1756823129"}],"name":"Versalis","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Aggressive Combustion"],"ratings":{"dejus":{"banned":"0","descriptors":"Conte\u00fado sexual\nLinguagem impr\u00f3pria\nViol\u00eancia","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Sexuelle Andeutungen\nGewalt\nAlkohol / Tabak","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"2026"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812220/b5b19bf5c0edb5bd026ecbb