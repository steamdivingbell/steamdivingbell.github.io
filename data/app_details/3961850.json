ts/steam/apps/3961850/20b96651d76efe9eaa258d62992d285b1a7b492b/ss_20b96651d76efe9eaa258d62992d285b1a7b492b.600x338.jpg?t=1769157306"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3961850/5e963868bc754227a90bbb9a1314e773c0eb74e7/ss_5e963868bc754227a90bbb9a1314e773c0eb74e7.1920x1080.jpg?t=1769157306","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3961850/5e963868bc754227a90bbb9a1314e773c0eb74e7/ss_5e963868bc754227a90bbb9a1314e773c0eb74e7.600x338.jpg?t=1769157306"}],"short_description":"A cooperative space horror about raiding derelict ships: breach compartments, grab the loot, and make it back to your own vessel before the oxygen runs out \u2014 or before something lurking in the dark gets to you.","steam_appid":3961850,"support_info":{"email":"omletick30@gmail.com","url":""},"supported_languages":"English, Russian, French, Italian, German, Spanish - Spain, Traditional Chinese, Simplified Chinese, Japanese","type":"game","website":null}