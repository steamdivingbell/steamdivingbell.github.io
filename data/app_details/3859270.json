d":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859270/507f1c37a6a2db1d55ac3f4d317df67745ad1c1e/ss_507f1c37a6a2db1d55ac3f4d317df67745ad1c1e.1920x1080.jpg?t=1758815270","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859270/507f1c37a6a2db1d55ac3f4d317df67745ad1c1e/ss_507f1c37a6a2db1d55ac3f4d317df67745ad1c1e.600x338.jpg?t=1758815270"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859270/8fa0b68c00b156c317475cff2a000e1425c77c79/ss_8fa0b68c00b156c317475cff2a000e1425c77c79.1920x1080.jpg?t=1758815270","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859270/8fa0b68c00b156c317475cff2a000e1425c77c79/ss_8fa0b68c00b156c317475cff2a000e1425c77c79.600x338.jpg?t=1758815270"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859270/405c524d24a5cec5000038f15029d9e56dc8efbd/ss_405c524d24a5cec5000038f15029d9e56dc8efbd.1920x1080.jpg?t=1758815270","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3859270/405c524d24a5cec5000038f15029d9e56dc8efbd/ss_405c524d24a5cec5000038f15029d9e56dc8efbd.600x338.jpg?t=1758815270"}],"short_description":"Mycubium is a first-person 3D puzzle platformer where you grow bridges using mushrooms in a minimalist cubic world. Explore and solve spatial puzzles across shifting landscapes filled with secrets, platforming challenges, and evolving mechanics. Build your path as the day fades to night.","steam_appid":3859270,"support_info":{"email":"synhapticgames@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}