atic.com/store_item_assets/steam/apps/3444730/ss_1249b312d6f30d5fdc696566f8ee535d72b0c54a.600x338.jpg?t=1740601669"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444730/2af68eae93990fa1b9b8b47dc4f1657426381f58/ss_2af68eae93990fa1b9b8b47dc4f1657426381f58.1920x1080.jpg?t=1740601669","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444730/2af68eae93990fa1b9b8b47dc4f1657426381f58/ss_2af68eae93990fa1b9b8b47dc4f1657426381f58.600x338.jpg?t=1740601669"}],"short_description":"With your friends, play as extravagant detectives in this wacky Point &amp; Click game to solve the mystery behind multiple crimes. Will you manage to gather the clues that only you can find and share them with your team to accuse the right suspect?","steam_appid":3444730,"support_info":{"email":"","url":"http://madgik-yarn-studio.com"},"supported_languages":"English, French","type":"demo","website":"http://www.madgik-yarn-studio.com"}