store_item_assets/steam/apps/4040800/d8d7a0a48d4d922342ab6d95b5621dd4e3f26f4f/ss_d8d7a0a48d4d922342ab6d95b5621dd4e3f26f4f.600x338.jpg?t=1774775783"}],"short_description":"Secret of Dawnstone is an action adventure set in an Alpine open world - featuring changing seasons, folklore-inspired monsters, and enemies that stay dead. Inspired by classics like Zelda, Secret of Mana, and Gothic II.","steam_appid":4040800,"support_info":{"email":"support@secretofdawnstone.com","url":"https://secretofdawnstone.com/contact"},"supported_languages":"English, German, Japanese","type":"game","website":"https://secretofdawnstone.com"}