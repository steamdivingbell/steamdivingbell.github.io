36c917f57690e42867cd3/ss_5438a17348e38dc41fd36c917f57690e42867cd3.600x338.jpg?t=1771047675"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2324550/e2e20b70e53181bf43c07852277041a75944304b/ss_e2e20b70e53181bf43c07852277041a75944304b.1920x1080.jpg?t=1771047675","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2324550/e2e20b70e53181bf43c07852277041a75944304b/ss_e2e20b70e53181bf43c07852277041a75944304b.600x338.jpg?t=1771047675"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2324550/6297f2d14ad35e79163c234c127afb9e4e8e9df9/ss_6297f2d14ad35e79163c234c127afb9e4e8e9df9.1920x1080.jpg?t=1771047675","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2324550/6297f2d14ad35e79163c234c127afb9e4e8e9df9/ss_6297f2d14ad35e79163c234c127afb9e4e8e9df9.600x338.jpg?t=1771047675"}],"short_description":"Slay giant robots and loot their parts to build your own unique, shareable boss battles! Arm yourself with swords, tesla orbs, and potato cannons to capture colossal robos. Customize abilities, style with accessories, and upgrade their attacks to unleash your ultimate boss for the world to fight!","steam_appid":2324550,"support_info":{"email":"robofrenzy@yummyyummytummy.com","url":"https://yummyyummytummy.com/contact-us/"},"supported_languages":"English, Simplified Chinese, Traditional Chinese","type":"game","website":"https://www.robofrenzy.com"}