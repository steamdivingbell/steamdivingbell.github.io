ic.com/store_item_assets/steam/apps/4043340/9e7e64efa3474f326a54b7ca5dcf2af5500f94b9/ss_9e7e64efa3474f326a54b7ca5dcf2af5500f94b9.1920x1080.jpg?t=1758647321","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043340/9e7e64efa3474f326a54b7ca5dcf2af5500f94b9/ss_9e7e64efa3474f326a54b7ca5dcf2af5500f94b9.600x338.jpg?t=1758647321"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043340/2d4c26b86a3e81e5995cf3ef123ed09fe8476b51/ss_2d4c26b86a3e81e5995cf3ef123ed09fe8476b51.1920x1080.jpg?t=1758647321","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043340/2d4c26b86a3e81e5995cf3ef123ed09fe8476b51/ss_2d4c26b86a3e81e5995cf3ef123ed09fe8476b51.600x338.jpg?t=1758647321"}],"short_description":"Try the first chapter of this brutal physics-based balancing game! There's only one rule in this game: Keep the Balance. Everything else is a comical and frustrating war between you and gravity. Take good care of your keyboard. Up to 8 players!","steam_appid":4043340,"support_info":{"email":"ardaaslan@overloadgames.net","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Polish, Portuguese - Portugal, Russian, Simplified Chinese, Traditional Chinese, Turkish, Korean","type":"demo","website":null}