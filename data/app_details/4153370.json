agraph\" ><strong>Survival Horror Progression</strong><br>As you advance, monsters evolve. The further you go, the harder it is to survive.</p><p class=\"bb_paragraph\" ><strong>Minimal UI, Maximum Immersion</strong><br>No distractions\u2014just you, the shadows, and the fear stalking you.</p>","developers":["cnsgames"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4153370/612fb14d4385e6d0d7f6fc215b3ca385520c83da/header.jpg?t=1762388377","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4153370/1328914136/877e611738ade69b320d767f2fe52fbf301de443/1762001382/dash_av1.mpd?t=1762388376","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4153370/1328914136/877e611738ade69b320d767f2fe52fbf301de443/1762001382/dash_h264.mpd?t=1762388376","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4153370/1328914136/877e611738ade69b320d767f2fe52fbf301de443/1762001382/hls_264_master.m3u8?t=1762388376","id":257225484,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257225484/movie480.mp4?t=1762388376","max":"https://video.akamai.steamstatic.com/store_trailers/257225484/movie_max.mp4?t=1762388376"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257225484/2b246720a35ad17538aa0feaa85f7104827cc10c/movie_600x337.jpg?t=1762388376","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257225484/movie480.webm?t=1762388376","max":"https://video.akamai.steamstatic.com/store_trailers/257225484/movie