ai.steamstatic.com/store_item_assets/steam/apps/2471680/66cfd738657d27f1fe48a8966dc2d6c77c718a40/ss_66cfd738657d27f1fe48a8966dc2d6c77c718a40.600x338.jpg?t=1771491417"}],"short_description":"Risimon is an adventure &amp; monster-taming game combining an off-the-wall tone with a retro, yet restyled, aesthetic. Experience a hilarious journey across the Issou region. Catch Risimon, train them and fight to prove to yourself that you are NOT a loser!","steam_appid":2471680,"support_info":{"email":"risimon.organisation@gmail.com &amp; 1637523348@qq.com","url":""},"supported_languages":"French, English, Simplified Chinese, Traditional Chinese","type":"game","website":null}