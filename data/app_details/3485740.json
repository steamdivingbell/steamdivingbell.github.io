hared.akamai.steamstatic.com/store_item_assets/steam/apps/3485740/683ccbf9b3b99c01ced112f3c4cc5f0f609794f0/ss_683ccbf9b3b99c01ced112f3c4cc5f0f609794f0.600x338.jpg?t=1769050833"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3485740/b065eca76022824215d553d58e5723670bb16ec7/ss_b065eca76022824215d553d58e5723670bb16ec7.1920x1080.jpg?t=1769050833","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3485740/b065eca76022824215d553d58e5723670bb16ec7/ss_b065eca76022824215d553d58e5723670bb16ec7.600x338.jpg?t=1769050833"}],"short_description":"A modern, digital take on the classic Chinese abstract-strategy game Luzhanqi. Deploy your army, outmaneuver your opponent, and capture their flag in this turn-based war game. The battlefield waits for no one!","steam_appid":3485740,"support_info":{"email":"luzhanqigame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}