4a6c24ba04a09dfb707fea0.1920x1080.jpg?t=1772225392","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3047820/15028b6a0bb913a094a6c24ba04a09dfb707fea0/ss_15028b6a0bb913a094a6c24ba04a09dfb707fea0.600x338.jpg?t=1772225392"}],"short_description":"Expect blasts of green zombie goo painting the screen in this top-down shooter packed with crazy guns that blow the heads off some\u2026 freaky zombies. Your mission is simple: graffiti the whole city before these mutants dog-pile you","steam_appid":3047820,"support_info":{"email":"suporte@fogogames.com.br","url":"https://www.fogogames.com.br/"},"supported_languages":"English, Portuguese - Brazil, Japanese, Korean, Simplified Chinese, Traditional Chinese, French, German, Spanish - Spain, Russian, Spanish - Latin America","type":"game","website":"http://www.fogogames.com.br/"}