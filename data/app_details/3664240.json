493b6/ss_24559480f3ee564605ca3077437efdb88d0493b6.1920x1080.jpg?t=1772364288","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3664240/24559480f3ee564605ca3077437efdb88d0493b6/ss_24559480f3ee564605ca3077437efdb88d0493b6.600x338.jpg?t=1772364288"}],"short_description":"In Asgard, deepen your bonds with the fascinating characters who visit \u201cNorn's Dine\u201d and release their unique episodes! The large volume of character episodes includes erotic scenes newly drawn by the illustrator in charge of designing them!","steam_appid":3664240,"support_info":{"email":"hichicgames01@gmail.com","url":"https://www.hichicgames.com/"},"supported_languages":"English, Traditional Chinese, Japanese","type":"game","website":"https://www.hichicgames.com/"}