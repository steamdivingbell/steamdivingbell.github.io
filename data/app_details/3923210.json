.steamstatic.com/store_item_assets/steam/apps/3923210/aaf0515b0b07d1f1eb83a9ee33881641fc75614d/ss_aaf0515b0b07d1f1eb83a9ee33881641fc75614d.1920x1080.jpg?t=1770048678","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3923210/aaf0515b0b07d1f1eb83a9ee33881641fc75614d/ss_aaf0515b0b07d1f1eb83a9ee33881641fc75614d.600x338.jpg?t=1770048678"}],"short_description":"Terminal Descent is a terminal-based mining incremental game. Upgrade drills, automate operations, smelt metals, and descend deeper. ASCII graphics with active/idle hybrid gameplay in your terminal.","steam_appid":3923210,"support_info":{"email":"icaro4bio@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}