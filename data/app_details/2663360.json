atic.com/store_item_assets/steam/apps/2663360/4c3f1654262e240daddbd1be39ae8ba3f35e12fb/ss_4c3f1654262e240daddbd1be39ae8ba3f35e12fb.600x338.jpg?t=1771733630"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2663360/9465af991f1e55db4ef563138a03e5b99d62f41d/ss_9465af991f1e55db4ef563138a03e5b99d62f41d.1920x1080.jpg?t=1771733630","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2663360/9465af991f1e55db4ef563138a03e5b99d62f41d/ss_9465af991f1e55db4ef563138a03e5b99d62f41d.600x338.jpg?t=1771733630"}],"short_description":"A puzzle-horror experience - navigate a huge mid-90s internet and use a variety of programs on your work computer to take down your pharmaceutical company without getting caught.","steam_appid":2663360,"support_info":{"email":"team@patchbaygames.com","url":"https://www.patchbaygames.com/home#contact"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.patchbaygames.com/"}