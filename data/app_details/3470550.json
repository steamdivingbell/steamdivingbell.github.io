/store_item_assets/steam/apps/3470550/40496134f3676977ad235f422b6d83414a97c145/ss_40496134f3676977ad235f422b6d83414a97c145.600x338.jpg?t=1758778343"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3470550/22cbb0e50360ffa3313751881e5d32ab7378fc57/ss_22cbb0e50360ffa3313751881e5d32ab7378fc57.1920x1080.jpg?t=1758778343","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3470550/22cbb0e50360ffa3313751881e5d32ab7378fc57/ss_22cbb0e50360ffa3313751881e5d32ab7378fc57.600x338.jpg?t=1758778343"}],"short_description":"A &quot;collage-and-guess&quot; multiplayer game for up to 6 players. Enjoy collaging ordinary items into outside-the-box &quot;masterpieces,&quot; guess each other's creations, and unleash your wild imagination around the campfire. Here, everyone is an artist!","steam_appid":3470550,"support_info":{"email":"contact@perfectdaystudio.com","url":"https://www.perfectdaystudio.com/"},"supported_languages":"Simplified Chinese, English, Traditional Chinese","type":"game","website":null}