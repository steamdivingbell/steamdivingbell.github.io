272383","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3676100/8eb9a0267fccec50fe0e36015321e91809fd71e0/ss_8eb9a0267fccec50fe0e36015321e91809fd71e0.600x338.jpg?t=1756272383"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3676100/e7a8bb50d314fb4b8c632fd38d1a577cdece5abc/ss_e7a8bb50d314fb4b8c632fd38d1a577cdece5abc.1920x1080.jpg?t=1756272383","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3676100/e7a8bb50d314fb4b8c632fd38d1a577cdece5abc/ss_e7a8bb50d314fb4b8c632fd38d1a577cdece5abc.600x338.jpg?t=1756272383"}],"short_description":"Life 2047: Escape Simulator is an atmospheric puzzle game set in a cyberpunk dystopia. The line is your path to freedom. Hack the system, evade surveillance, uncover hidden truths, and escape the loop where every day repeats. Are you a glitch \u2014 or salvation?","steam_appid":3676100,"support_info":{"email":"info@brightika.com","url":"https://brightika.com/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Traditional Chinese, Simplified Chinese, Korean, Portuguese - Portugal, Russian, Turkish, Japanese","type":"game","website":null}