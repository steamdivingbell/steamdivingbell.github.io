 muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3098920/extras/8b543337ed39c8f9e93af13bd38bc740.poster.avif?t=1771016281\" width=600 height=194 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3098920/extras/8b543337ed39c8f9e93af13bd38bc740.webm?t=1771016281\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3098920/extras/8b543337ed39c8f9e93af13bd38bc740.mp4?t=1771016281\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Take Care of Your Home!</strong></p><p class=\"bb_paragraph\" >Add extra furniture, buy pots, plant valerian and catnip. Water the plants, then prepare potions for your cat. Purchase additional workshop equipment to unlock more components for the laser mechanism.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Travel and destroy!</p>","developers":["HowDeerYou"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3098920/header.jpg?t=1771016281","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3098920/743961/3c95240ce63f34882f953211a971dabe7cc36b1f/1750974671/dash_av1.mpd?t=1743711724","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3098920/743961/3c95240ce63f34882f953211a971dabe7cc36b1f/1750974671/dash_h264.mpd?t=1743711724","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/30