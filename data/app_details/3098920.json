:[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"detailed_description":"<p class=\"bb_paragraph\">Wouldn't everyone want to have a giant laser battle cat to overcome life's challenges with a devastating beam?</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3098920/extras/gif1.gif?t=1744988542\" /></p><p class=\"bb_paragraph\"><strong>Collect Kittens!</strong></p><p class=\"bb_paragraph\">The game offers 5 kittens, each with different stats and appearances. Unlock them by completing levels and give them names. Feed them radioactive milk to make them bigger and stronger.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3098920/extras/gif2.gif?t=1744988542\" /></p><p class=\"bb_paragraph\"><strong>Conquer Five Continents!</strong></p><p class=\"bb_paragraph\">Your cat is equipped with a vest\u2014build a laser mechanism on it. Generate power, store it in batteries, and fire away. Use rotating and sliding parts to reach all enemies. Defeat European pigeons, African snakes, and Australian spiders.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3098920/extras/gif3.gif?t=1744988542\" /></p><p class=\"bb_paragraph\"><strong>Take Care of Your Home!</strong></p><p class=\"bb_paragraph\">Add extra furniture, buy pots, plant valerian and catnip. Water the plants, then prepare potions for your cat. Purchase additional workshop equipment to unlock more components for the laser mechanism.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Travel and destroy!</p>","developers":["HowDeerYou"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3098920/header.jpg?t=1744988542","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257048335,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257048335/movie480.mp4?t=1743711724","max":"http://video.akamai.steamstatic.com/store_trailers/257048335/movie_max.mp4?t=1743711724"},"name":"Laser Battle Cats","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257048335/7eb14f03c54369581b08a89f130e2c06b5f9c2bd/movie_600x337.jpg?t=1743711724","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257048335/movie480_vp9.webm?t=1743711724","max":"http://video.akamai.steamstatic.com/store_trailers/257048335/movie_max_vp9.webm?t=1743711724"}}],"name":"Laser Battle Cats - travel & destroy!","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"LaserBattleCats - <span class=\"discount_original_price\">$2.99</span> $2.54 USD","packageid":1100758,"percent_savings":0,"percent_savings_text":"-15% ","price_in_cents_with_discount":254}],"title":"Buy Laser Battle Cats - travel & destroy!"}],"packages":[1100758],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</