steam/apps/1830160/extras/a8ef0b2a94280da1260484b1b60d4cdf.mp4?t=1768564853\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Experience tactical combat based on realistic situations that require problem solving.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/dacbffd8cb4e4577ffc9440c04b4b4ef.poster.avif?t=1768564853\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/dacbffd8cb4e4577ffc9440c04b4b4ef.webm?t=1768564853\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/dacbffd8cb4e4577ffc9440c04b4b4ef.mp4?t=1768564853\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Enjoy the unique art style combination of retro pixel graphics and futuristic lighting effects.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/65a07f9852ba1231831ef9aed95ab03d.poster.avif?t=1768564853\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/65a07f9852ba1231831ef9aed95ab03d.webm?t=1768564853\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/65a07f9852ba1231831ef9aed95ab03d.mp4?t=1768564853\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Synopsis</h2><p class=\"bb_paragraph\" >You were a legendary agent who fell into a coma after an unexpected accident. Fortunately, you regained consciousness due to the efforts of the doctors. In the process, the trauma left you without most of your memories. All that is left are your shooting and aiming skills.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >There are still many tasks left that only a legendary agent can solve. Reclaim your memory and skills by completing countless missions!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/f8ce50c44dce8b4dd3c0f1b1f94a9b6d.poster.avif?t=1768564853\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/f8ce50c44dce8b4dd3c0f1b1f94a9b6d.webm?t=1768564853\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/extras/f8ce50c44dce8b4dd3c0f1b1f94a9b6d.mp4?t=1768564853\" type=\"video/mp4\"></video></span></p>","developers":["Nevertheless Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830160/0c34bc0acb5e64f05fbad0bdbf5dd6deaa7cba5e/header.jpg?t=1768564853","is_free":false,"legal_notice":"Reloader: Alpha \u00a9 2022 Nevertheless Studio. All rights reserved. Distributed by PsychoFlux Entertainment.","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1830160/1088536349/7471af1117331b9b1ac0b252bf53e08122e1d0c1/1768564420/dash_av1.mpd?t=1768564853","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1830160/1088536349/7471af1117331b9b1ac0b252bf53e08122e1d0c1/1768564420/dash_h264.mpd?t=1768564853","highlight":true,"hls_h264":"https://video.akamai.steam