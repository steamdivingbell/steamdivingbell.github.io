://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581940/0414e6a543baeec8af760e9314aeff9f591e2d09/ss_0414e6a543baeec8af760e9314aeff9f591e2d09.600x338.jpg?t=1748865195"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581940/48f6b388fac37bb5d8c092260b1bca5e5090f7fd/ss_48f6b388fac37bb5d8c092260b1bca5e5090f7fd.1920x1080.jpg?t=1748865195","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581940/48f6b388fac37bb5d8c092260b1bca5e5090f7fd/ss_48f6b388fac37bb5d8c092260b1bca5e5090f7fd.600x338.jpg?t=1748865195"}],"short_description":"Warning: Deja View is not for the faint of heart. NO ZOOM, no shortcuts\u2014just 16 surreal, hand-drawn levels with 40 devilishly hidden differences in each. It\u2019s tough by design. If you crave a serious challenge and love spotting the impossible, welcome. If not, consider yourself warned.","steam_appid":3581940,"support_info":{"email":"info@gemcraftgames.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}