ets/steam/apps/3514670/extras/CarChaos.gif?t=1753705428\" /></div></p><h2 class=\"bb_tag\">Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">Private and public lobbies with up to 8 players.</p></li><li><p class=\"bb_paragraph\">A variety of minigames and cosmetics to unlock.</p></li><li><p class=\"bb_paragraph\">Game mode selection to change up how minigames are played.</p></li><li><p class=\"bb_paragraph\">Collect interesting powerups to  tip the scales of each game.</p></li><li><p class=\"bb_paragraph\">Bots to fill out lobbies.</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><h2 class=\"bb_tag\"> </h2>","developers":["Karnage Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3514670/7da6f8c2e5dea7ccbf3c8adbcf247a1ce787fcdb/header.jpg?t=1753705428","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257122066,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257122066/movie480.mp4?t=1750531549","max":"http://video.akamai.steamstatic.com/store_trailers/257122066/movie_max.mp4?t=1750531549"},"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257122066/aeca36738651f1969446753c625e0f234b26a30b/movie_600x337.jpg?t=1750531549","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257122066/movie480_vp9.webm?t=1750531549","max":"http://video.akamai.steamstatic.com/store_trailers/257122066/movie_max_vp9.webm?t=1750531549"}}],"name":"Super Serious Golf","package_groups":[],"pc_requir