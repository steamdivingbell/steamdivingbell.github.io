rong> from a stacked 20+ cast!</p></li><li><p class=\"bb_paragraph\" >Narrative by the creator of <i>Hatoful Boyfriend</i>!</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2419240/extras/6023eee5a0f4f283784a861fcebea784.avif?t=1756960012\" width=620 height=152 /></span></p>","developers":["Big Brane Studios, Inc."],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2419240/header.jpg?t=1756960012","is_free":false,"legal_notice":"Copyright Big Brane Studios, Inc.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":256952654,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/256952654/movie480.mp4?t=1686842881","max":"http://video.akamai.steamstatic.com/store_trailers/256952654/movie_max.mp4?t=1686842881"},"name":"Sushi Ben - First Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256952654/movie.293x165.jpg?t=1686842881","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/256952654/movie480_vp9.webm?t=1686842881","max":"http://video.akamai.steamstatic.com/store_trailers/256952654/movie_max_vp9.webm?t=1686842881"}}],"name":"Sushi Ben","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> i5-4590 (or equivalent)<br></li><li><strong>Memory:</strong> 5 GB RAM<br><