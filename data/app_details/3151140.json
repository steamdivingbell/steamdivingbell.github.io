40/09b18dad4ebec368a2f8d80042bb00990639c5ab/ss_09b18dad4ebec368a2f8d80042bb00990639c5ab.600x338.jpg?t=1768229850"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3151140/4198aa2ebf5ba3ff8b91e1afefdd9b08ff2cd46f/ss_4198aa2ebf5ba3ff8b91e1afefdd9b08ff2cd46f.1920x1080.jpg?t=1768229850","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3151140/4198aa2ebf5ba3ff8b91e1afefdd9b08ff2cd46f/ss_4198aa2ebf5ba3ff8b91e1afefdd9b08ff2cd46f.600x338.jpg?t=1768229850"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3151140/16bffa886ba5abbcdcb9538ad4adb858b0351b20/ss_16bffa886ba5abbcdcb9538ad4adb858b0351b20.1920x1080.jpg?t=1768229850","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3151140/16bffa886ba5abbcdcb9538ad4adb858b0351b20/ss_16bffa886ba5abbcdcb9538ad4adb858b0351b20.600x338.jpg?t=1768229850"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3151140/672a51ab766511b75507a64e30cb6b8c7a3b94df/ss_672a51ab766511b75507a64e30cb6b8c7a3b94df.1920x1080.jpg?t=1768229850","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3151140/672a51ab766511b75507a64e30cb6b8c7a3b94df/ss_672a51ab766511b75507a64e30cb6b8c7a3b94df.600x338.jpg?t=1768229850"}],"short_description":"Blast rogue toys with wacky weapons in this fast-paced Roguelite FPS! Mix &amp; match toy parts to assemble your Shelf Hero, discover powerful perk combos, and explore a giant House. Play solo or with friends in 3-player co-op!","steam_appid":3151140,"support_info":{"email":"info@gameforge.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}