th_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3758290/753da75a78577414b088755c25c025de7df2b890/ss_753da75a78577414b088755c25c025de7df2b890.600x338.jpg?t=1749593366"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3758290/696c9cbc911253630cf0cb66361cb62317ec7e84/ss_696c9cbc911253630cf0cb66361cb62317ec7e84.1920x1080.jpg?t=1749593366","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3758290/696c9cbc911253630cf0cb66361cb62317ec7e84/ss_696c9cbc911253630cf0cb66361cb62317ec7e84.600x338.jpg?t=1749593366"}],"short_description":"Put on your thermos bags and head outside with your friends. You will have to deliver food to the aliens and make sure that the last company on Earth does not close down.","steam_appid":3758290,"support_info":{"email":"strelitziareg@gmail.com","url":""},"supported_languages":"English","type":"demo","website":null}