es/apps/3466310/0910b1fcec99334b4798b34265473796bbe09b86.jpg"}],"total":16},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3466310?t=1757339011","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3466310/page_bg_raw.jpg?t=1757339011","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3466310/10d75039d6f3ba962172b7ac22a763c6f10d42db/capsule_231x87.jpg?t=1757339011","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3466310/10d75039d6f3ba962172b7ac22a763c6f10d42db/capsule_184x69.jpg?t=1757339011","categories":[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Full controller support","id":28},{"description":"Custom Volume Controls","id":68},{"description":"Playable without Timed Input","id":74},{"description":"Stereo Sound","id":69},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"controller_support":"full","demos":[{"appid":3475270,"description":""}],"detailed_description":"<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3466310/extras/daac9f5969ee0309fcd9d2509d4887d3.avif?t=1757339011\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3466310/extras_big/daac9f5969ee0309fcd9d2509d4887d3.avif?t=1757339011 width=800 height=258 /></span></p><p class=\"bb_paragraph\" ><strong>PathUp!</strong> is an adventure-packed game where you face a challenging climb. Overcome obstacles, combine different mechanics, and prove that you can conquer the summit!</p><p class=\"bb_paragraph\" ><strong>Can you reach your goal?</strong></p><p class=\"bb_paragraph\" >In <strong>PathUp!</strong>, you embark on an unforgettable journey to climb to the top. Along the way, you\u2019ll face narrow paths, steep inclines, and sharp turns that demand quick decisions and skill.</p><p class=\"bb_paragraph\" >Throughout the game, you\u2019ll need to master a set of unique mechanics:</p><p class=\"bb_paragraph\" >\ud83d\ude80 <strong>Boost</strong> \u2013 Speed bursts to overcome difficult sections.<br>\ud83e\udd98 <strong>Jump / Double Jump</strong> \u2013 Use powerful jumps to clear obstacles. Time your second jump during the brief glowing pulse to succeed!<br>\u2b05\ufe0f\u27a1\ufe0f <strong>Impulse Left / Impulse Right</strong> \u2013 Make precise adjustments mid-air or on the ground.</p><p class=\"bb_paragraph\" >But be careful \u2014 one mistake can send you tumbling back! The path is tough, and every second counts. Your skill, reflexes, and timing will determine how far you go.</p><p class=\"bb_paragraph\" >\ud83d\udcbe Don\u2019t worry \u2014 the game includes multiple <strong>checkpoints</strong>, so if you fall, you can try again from a safe spot without starting over.</p><p class=\"bb_paragraph\" >\ud83d\ude97\ud83d\udca8 <strong>Check out the GIFs below</strong> to see these mechanics in action!</p><p class=\"bb_paragraph\" >\u2714\ufe0f <strong>Checkpoint</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3466310/extras/4c2b873855a3ee908d020e726af5dccd.poster.avif?t=1757339011\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3466310/extras/4c2b873855a3ee908d020e726af5dccd.webm?t=1757339011\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3466310/extras/4c2b873855a3ee908d020e726af5dccd.mp4?t=1757339011\" type=\"video/mp4\"></video></span>\u2714\ufe0f <strong>Jump</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_it