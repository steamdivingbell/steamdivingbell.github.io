lass=\"bb_paragraph\">Sanity system that adds to the tension.</p></li><li><p class=\"bb_paragraph\">Different endings depending on your choices.</p></li><li><p class=\"bb_paragraph\">Movement system similar to early Goldsrc titles and developer console.</p></li><li><p class=\"bb_paragraph\">Connections to analytical psychology.</p></li></ul>","developers":["TPX500"],"fullgame":{"appid":"3611760","name":"Hypnostasis"},"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3825440/ca7198be42f58f0bbb9ca67ea543765de9725774/header.jpg?t=1753285503","is_free":true,"legal_notice":"\u00a9 2025 TPX500 All Rights Reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257171856,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257171856/movie480.mp4?t=1753107266","max":"http://video.akamai.steamstatic.com/store_trailers/257171856/movie_max.mp4?t=1753107266"},"name":"Wishlist (Cinematic Ver.)","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257171856/992c1b53ab3ffa41468624c29f23031e5dbcafcf/movie_600x337.jpg?t=1753107266","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257171856/movie480_vp9.webm?t=1753107266","max":"http://video.akamai.steamstatic.com/store_trailers/257171856/movie_max_vp9.webm?t=1753107266"}},{"highlight":true,"id":257171854,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257171854/movie480.mp4?t=1753107269","max":"http://video.akamai.steamstatic.com/store_trailers/257171854/movie_max.mp4?t=1753107269"},"name":"Wishlist (Short Ver.)","thumbnail":"https://shared.a