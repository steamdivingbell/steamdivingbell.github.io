decs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2786550/extras/b44ed23e623fda4c4911f5b7b646e0b9.mp4?t=1761942158\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong><i>Community-First Streamer-First game</i></strong></h2><p class=\"bb_paragraph\" >CURE stands out by putting creators and communities first, allowing your stream audience to participate in and influence the game.</p><p class=\"bb_paragraph\" >This unique hybrid of simulation and action gameplay, combined with deep Twitch and Discord integration, offers a truly one-of-a-kind experience.</p><h2 class=\"bb_tag\" ><strong><i>Key Features</i></strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Fast-Paced Patient Care:</strong> Diagnose and treat patients with weird symptoms in a chaotic, first-person environment. Will you put them in normal care or quarantine? The choice is yours, and the clock is ticking.</p></li><li><p class=\"bb_paragraph\" ><strong>Strategic Management:</strong> Amidst the chaos, you'll need to manage your hospital effectively. Set up new equipment, manage critical inventory, and build up your hospital.</p></li><li><p class=\"bb_paragraph\" ><strong>Co-Op Fun:</strong> Play with up to four friends in a fight for survival, where teamwork is essential to keeping your patients - and yourselves - alive.</p></li><li><p class=\"bb_paragraph\" ><strong>Twitch &amp; Discord Integration:</strong> Our Shoutout Engine connects your live stream to the game. Your audience can participate as patient NPCs during live sessions.</p></li><li><p class=\"bb_paragraph\" ><strong>Hybrid Gameplay:</strong> Experience a unique blend of first-person action and simulation management. Fend off attacks, while meticulously cleaning beds and ordering supplies.</p></li><li><p class=\"bb_paragraph\" ><strong>Progression &amp; Unlocks:\u00a0</strong>Unlock new medicine, diagnostic tools, weapons, and story insights as you manage more nights and save more lives.</p></li></ul>","developers":["Sentinel Games"],"genres":[{"description":"Action","id":"1"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2786550/f201e9080e96b61a135593cfb3ae435002655ef7/header.jpg?t=1761942158","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 12</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2786550/609362035/0262a2b0855673611a27c1130d63aad1111316d3/1761584483/dash_av1.mpd?t=1761838261","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2786550/609362035/0262a2b0855673611a27c1130d63aad1111316d3/1761584483/dash_h264.mpd?t=1761838261","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2786550/609362035/0262a2b0855673611a27c1130d63aad1111316d3/1761584483/hls_264_master.m3u8?t=1761838261","id":257223242,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257223242/movie480.mp4?t=1761838261","max":"https://video.akamai.steamstatic.com/store_trailers/257223242/movie_max.mp4?t=1761838261"},"name":"First Reveal Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257223242/3f9e6a05a69e0717402c0480b20420d888c0cc90/movie_600x337.jpg?t=1761838261","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257223242/movie480.webm?t=1761838261","max":"https://video.akamai.steamstatic.com/store_trailers/257223242/movie_max.webm?t=1761838261"}},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2786550/172184565/df239be69351633711b4f40b716542f81d5c879d/1761592309/dash_av1.mpd?t=1761838263","dash_h264":"ht