p><p class=\"bb_paragraph\">So each character will have multiple sets of professional appearances,</p><p class=\"bb_paragraph\">Please forgive the time cost.</p><p class=\"bb_paragraph\">Thank you for your support.</p><p class=\"bb_paragraph\"></p>","developers":["Oct.Works"],"fullgame":{"appid":"3406890","name":"Touhou: Divine Land -Majesty in Game-"},"genres":[{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3407110/cf6c0415f21023f6067080c400549f90ee2894b3/header.jpg?t=1744816695","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257122791,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257122791/movie480.mp4?t=1744009932","max":"http://video.akamai.steamstatic.com/store_trailers/257122791/movie_max.mp4?t=1744009932"},"name":"demo pv 2 ","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257122791/5449394a64ccbbb547f46c9d614c5af7a06b6448/movie_600x337.jpg?t=1744009932","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257122791/movie480_vp9.webm?t=1744009932","max":"http://video.akamai.steamstatic.com/store_trailers/257122791/movie_max_vp9.webm?t=1744009932"}}],"name":"Touhou: Divine Land -Majesty in Game- Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows10<br></li><li><strong>Processor:</strong> Intel\u00ae Pentium\u00ae 4 2.0 GHz or higher processor<br></li><li><strong>Graphics:</strong> Support 1280 x 720 or higher</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Oct.Works"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"10","rating_generated":"1","required_age":"10","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0