aragraph\" ><strong>20+ Hours of Content</strong> (estimated): A full RPG adventure with puzzles, dungeons, and memorable encounters.<br><br>This is not a tale of heroes or destiny. <i>Nyx: Legacy</i> is a story of survival of two sisters holding on to each other even when their world falls apart.</p></li></ul>","developers":["Dreamon Interactive"],"genres":[{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4016050/22b0e1647a5308c2a2ad6b4541c7d16b90c2e96d/header.jpg?t=1769628732","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4016050/1040594877/8a292afafc0e34429e97c24cece8378b06cce082/1764804246/dash_av1.mpd?t=1764805305","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4016050/1040594877/8a292afafc0e34429e97c24cece8378b06cce082/1764804246/dash_h264.mpd?t=1764805305","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4016050/1040594877/8a292afafc0e34429e97c24cece8378b06cce082/1764804246/hls_264_master.m3u8?t=1764805305","id":257243280,"name":"Feature reveal","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257243280/0ab005c43a5c8fd90ec47b2188dc75bb37249dc0/movie_600x337.jpg?t=1764805305"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4016050/266072919/80510a4a86dd2ddd59ac64a3e09ab5a21a34bc6d/1762387775/dash_av1.mpd?t=1762388410","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4016050/266072919/80510a4a86dd2ddd59ac64a3e09ab5a21a34bc6d/1762387775/dash_h264.mpd?t=1762388410","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4016050/266072919/80510a4a86dd2ddd59ac64a3e09ab5a21a34bc6d/1762387775/hls_264_master.m3u8?t=1762388410","id":257227400,"name":"Nyx Legacy \u2013 Official Demo Trailer","thumbnail":"https://shared.akamai.steamstatic.com