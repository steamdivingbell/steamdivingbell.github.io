apps/3635450/extras/Desc_Gif3.gif?t=1745240502\" /></p><p class=\"bb_paragraph\">The more upgrades you get, the faster you kill slimes &gt; The faster you kill slimes, the more you level up &gt; The more you level up the more upgrades you get. It's a vicious cycle that eventually leads to total mayhem! </p><p class=\"bb_paragraph\">just be careful not to die in the process...</p>","developers":["Pentafloat"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3635450/9c601b42f9cb3c8f185a0c20d8178b7a93310b58/header.jpg?t=1745240502","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257120715,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257120715/movie480.mp4?t=1745240500","max":"http://video.akamai.steamstatic.com/store_trailers/257120715/movie_max.mp4?t=1745240500"},"name":"Gameplay trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257120715/60a28570a2ef2ab297dd188e46cab408cca91248/movie_600x337.jpg?t=1745240500","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257120715/movie480_vp9.webm?t=1745240500","max":"http://video.akamai.steamstatic.com/store_trailers/257120715/movie_max_vp9.webm?t=1745240500"}}],"name":"Mini Gears: Mayhem","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 or later<br></li><li><strong>Processor:</strong> Intel i5-7200U @ 2.50GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GTX 770 / Radeon 8950 HD</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Pentafloat"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":""