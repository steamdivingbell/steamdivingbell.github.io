ned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"30 Oct, 2025"},"required_age":0,"reviews":"\u201cWarm up your graphics cards, check your virtual tire pressure, and prepare to be immersed in a world where danger meets breathtaking aesthetics.\u201d<br>La Pause Geek<br><br>\u201cThe game promises an exciting blend of exploration, physics-based gameplay, and a neon-drenched atmosphere\u201d<br>Spiele Magazin<br><br>\u201cAdrift is an upcoming &quot;offroad vaporwave racer&quot; that is, clear as daylight, powered by pure vibes, with a retro-inspired palette that may resonate with people who are interested in relatively lo-fi driving games like Art of Rally\u2014games more about the feel of driving than ultra-hi-res landscapes and cars.\u201d<br>PC Gamer<br>","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903570/5964b38525b0d9daca5e1f90f14fc4abae671753/ss_5964b38525b0d9daca5e1f90f14fc4abae671753.1920x1080.jpg?t=1758213092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903570/5964b38525b0d9daca5e1f90f14fc4abae671753/ss_5964b38525b0d9daca5e1f90f14fc4abae671753.600x338.jpg?t=1758213092"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903570/df6b274f21b9a6239902f5a2b03859cb863c5455/ss_df6b274f21b9a6239902f5a2b03859cb863c5455.1920x1080.jpg?t=1758213092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903570/df6b274f21b9a6239902f5a2b03859cb863c5455/ss_df6b274f21b9a6239902f5a2b03859cb863c5455.600x338.jpg?t=1758213092"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903570/a3bb93b3443cb06fbacae26a5752402c05554a67/ss_a3bb93b3443cb06fbacae26a5752402c