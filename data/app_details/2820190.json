b_paragraph\">An alternate dimension video game conference called &quot;Yeet3&quot;</p></li><li><p class=\"bb_paragraph\">A super long straw so you can drink your neighbor's milkshake </p></li><li><p class=\"bb_paragraph\">Fun</p></li></ul>","developers":["Simmering Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2820190/d233b7410752b874fcd2ae899933eacdd9a0c883/header.jpg?t=1744413230","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257122228,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257122228/movie480.mp4?t=1743781589","max":"http://video.akamai.steamstatic.com/store_trailers/257122228/movie_max.mp4?t=1743781589"},"name":"Sipssassin Release Date Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257122228/9d81396b16835978366abed654afbac880f9c9c5/movie_600x337.jpg?t=1743781589","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257122228/movie480_vp9.webm?t=1743781589","max":"http://video.akamai.steamstatic.com/store_trailers/257122228/movie_max_vp9.webm?t=1743781589"}}],"name":"Sipssassin","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5 (5th Gen)<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GT 750M<br></li><li><strong>Storage:</strong> 8 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Simmering Studios"],"ratings":{"dejus":{"banned":"0","descriptors":"Drogas l\u00edcitas\nViol\u00eancia fantasiosa","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Alkohol / Tabak","rating":"12"