_item_assets/steam/apps/3726730/fb80b09ceb5edd4b00d509bf8802d045149d4ffb/ss_fb80b09ceb5edd4b00d509bf8802d045149d4ffb.600x338.jpg?t=1771558590"}],"short_description":"A roguelike deckbuilder about dreams. Choose cards, by combining 6 different strategies during the day, and at night build your deck while facing the nightmare, to uncover a great mystery.","steam_appid":3726730,"support_info":{"email":"equipesonekagames@gmail.com","url":""},"supported_languages":"English, Portuguese - Brazil, Portuguese - Portugal, Simplified Chinese, Traditional Chinese, Japanese, Korean","type":"game","website":null}