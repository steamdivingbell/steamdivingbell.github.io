04580/extras/ab7f0f1b300092b9e1440d3a53714bef.mp4?t=1771938147\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" style=\"text-align: center\">HIGH QUALITY ENVIRONMENTS</h2><p class=\"bb_paragraph\" >Experience a short psychological experience packed with high fidelity graphics and optimized worlds made available by Unreal Engine 5. Go through a rural ruined parking, a subterrean surreal backroom, a boggy pine forest, a dump, a tribal village, and a continuous, endless skybridge at night, away from everything.</p><p class=\"bb_paragraph\" ></p>","developers":["The Otherworldly Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3304580/header.jpg?t=1771938147","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3304580/1052735913/dfddf9e6e24ca959701df3964e5ddc11bf4fe207/1753444340/dash_av1.mpd?t=1753445818","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3304580/1052735913/dfddf9e6e24ca959701df3964e5ddc11bf4fe207/1753444340/dash_h264.mpd?t=1753445818","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3304580/1052735913/dfddf9e6e24ca959701df3964e5ddc11bf4fe207/1753444340/hls_264_master.m3u8?t=1753445818","id":257173913,"name":"Final Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257173913/803deb25508ed5e3e84864286b2c77cbe4561c3d/movie_600x337.jpg?t=1753445818"}],"name":"AUTO-CRISIS","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"AUTO-CRISIS - $3.99 USD","packageid":1170399,"percent_savings":0,"percent_savings_text":" 