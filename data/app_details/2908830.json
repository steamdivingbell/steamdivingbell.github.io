0/ss_4b4deb97e892742af5866d197f9d0f2c0e7348ec.1920x1080.jpg?t=1741217744","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2908830/ss_4b4deb97e892742af5866d197f9d0f2c0e7348ec.600x338.jpg?t=1741217744"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2908830/70b61ba33484f0bc417b024115a067f2fb75c73c/ss_70b61ba33484f0bc417b024115a067f2fb75c73c.1920x1080.jpg?t=1741217744","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2908830/70b61ba33484f0bc417b024115a067f2fb75c73c/ss_70b61ba33484f0bc417b024115a067f2fb75c73c.600x338.jpg?t=1741217744"}],"short_description":"Something strange is happening on Salamino Island. As the volcano threatens to erupt, buried secrets begin to surface. Meet quirky characters, help rebuild the island, and take on challenges that will test your wits. Amidst the chaos, one thing is certain: there\u2019s always time for pizza!","steam_appid":2908830,"support_info":{"email":"help@frolic.fun","url":"http://www.frolicstudio.fun/"},"supported_languages":"English, Portuguese - Brazil, Spanish - Latin America","type":"game","website":"https://frolicstudio.fun/"}