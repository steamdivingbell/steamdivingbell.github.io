.com/store_item_assets/steam/apps/3727090/05a399110cbed0bef7f6b1cd69d7c3650f4016de/ss_05a399110cbed0bef7f6b1cd69d7c3650f4016de.1920x1080.jpg?t=1761745227","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3727090/05a399110cbed0bef7f6b1cd69d7c3650f4016de/ss_05a399110cbed0bef7f6b1cd69d7c3650f4016de.600x338.jpg?t=1761745227"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3727090/66e3ff215457db7b2b972ca6170a9d5e871ff9a4/ss_66e3ff215457db7b2b972ca6170a9d5e871ff9a4.1920x1080.jpg?t=1761745227","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3727090/66e3ff215457db7b2b972ca6170a9d5e871ff9a4/ss_66e3ff215457db7b2b972ca6170a9d5e871ff9a4.600x338.jpg?t=1761745227"}],"short_description":"Horses of Hoofprint Bay is a lovingly hand-drawn 2D point and click barn buildup game. Take care of your horses, train them to build up their strength and confidence, and compete for prize money! Breed adorable foals, hire and manage staff, and build the stable of your dreams!","steam_appid":3727090,"support_info":{"email":"support@thoglistudios.com","url":""},"supported_languages":"English, German, French","type":"game","website":null}