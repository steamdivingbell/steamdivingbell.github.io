ifferent songs on 4 distinct difficulties.</p></li><li><p class=\"bb_paragraph\" >Earn achievements and customizations like hand models, enemy skins and more.</p></li><li><p class=\"bb_paragraph\" >Climb separate leaderboards for each song on each difficulty.</p></li></ul>","developers":["Polar Studios Robin Kammel"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Sports","id":"18"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3479170/fd37998b285fee71bb6971f17af7669ad8e0dedb/header.jpg?t=1758343602","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3479170/867951/312f5faa31c87ace20495be24bff0ad70e7d13d7/1750854618/dash_av1.mpd?t=1744351208","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3479170/867951/312f5faa31c87ace20495be24bff0ad70e7d13d7/1750854618/dash_h264.mpd?t=1744351208","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3479170/867951/312f5faa31c87ace20495be24bff0ad70e7d13d7/1750854618/hls_264_master.m3u8?t=1744351208","id":257124740,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257124740/movie480.mp4?t=1744351208","max":"https://video.akamai.steamstatic.com/store_trailers/257124740/movie_max.mp4?t=1744351208"},"name":"RHYTHMIC Gameplay Trailer Main","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257124740/9d589ff97e46f042e5f16fa099ec948a90bc88a0/movie_600x337.jpg?t=1744351208","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257124740/movie480_vp9.webm?t=1744351208","max":"https://video.akamai.steamstatic.com/store_trailers/257124740/movie_max_vp9.webm?t=1744351208"}}],"name":"RHYTHMIC","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *: