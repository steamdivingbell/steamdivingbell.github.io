tem_assets/steam/apps/1763380/73bf7c900948f5557ec514c750554d267ed992eb/ss_73bf7c900948f5557ec514c750554d267ed992eb.1920x1080.jpg?t=1765468392","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1763380/73bf7c900948f5557ec514c750554d267ed992eb/ss_73bf7c900948f5557ec514c750554d267ed992eb.600x338.jpg?t=1765468392"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1763380/d2921e984036fcafc3e4ed4a81c4e18d68dceb10/ss_d2921e984036fcafc3e4ed4a81c4e18d68dceb10.1920x1080.jpg?t=1765468392","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1763380/d2921e984036fcafc3e4ed4a81c4e18d68dceb10/ss_d2921e984036fcafc3e4ed4a81c4e18d68dceb10.600x338.jpg?t=1765468392"}],"short_description":"Monkey Do! introduces Mak, a mischievous monkey trying to escape a run-down zoo. With his agile stealth and trusty wrench, he'll explore the various habitats to gain the upper-hand over the Tropico family members and their robotic Keepers. They'll stop at nothing to prevent his ultimate escape.","steam_appid":1763380,"support_info":{"email":"info@signalspacelab.com","url":""},"supported_languages":"English<strong>*</strong>, French<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.signalspacelab.com/monkey-do"}