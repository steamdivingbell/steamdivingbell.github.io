=1769735334\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/extras/dbce8a680c0601332c91f5a3668fc8b4.webm?t=1769735334\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/extras/dbce8a680c0601332c91f5a3668fc8b4.mp4?t=1769735334\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Tune Up Your Dart!</strong></p><p class=\"bb_paragraph\" >Upgrade your dart to meet the challenges ahead. Enhance its speed, acceleration, boost\u00a0and handling by upgrading its\u00a0components. Continuously optimizing your dart's performance is essential to stay competitive in the Galactic Cup.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/extras/4c5498ccd57076613e9fcf10cbb2cd6c.poster.avif?t=1769735334\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/extras/4c5498ccd57076613e9fcf10cbb2cd6c.webm?t=1769735334\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/extras/4c5498ccd57076613e9fcf10cbb2cd6c.mp4?t=1769735334\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Customize Your Dart!</strong></p><p class=\"bb_paragraph\" >Express your style by customizing your dart. Choose from a variety of darts and freely change\u00a0colors\u00a0to make it stand out on the racetrack. Personalize your dart to reflect your racing identity and showcase your creativity.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/extras/b2ad672109866298768df4aeb625779f.poster.avif?t=1769735334\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/extras/b2ad672109866298768df4aeb625779f.webm?t=1769735334\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/extras/b2ad672109866298768df4aeb625779f.mp4?t=1769735334\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Master the Controls!</strong></p><p class=\"bb_paragraph\" >Become proficient in the unique VR controls of the dart or use more familiar flat controls. Master the intricacies of managing thrust, boosting, and executing advanced maneuvers. By honing your control skills, you can navigate challenging tracks, overtake opponents, and maintain optimal path throughout the races.</p>","developers":["LubSoft"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Racing","id":"9"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2401910/c58a4288ba81445e242526caf355ee978126c2f4/header.jpg?t=1769735334","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2401910/1770570907/7f01f425d3500ab325d7d2a46e55d66465f5ac8a/1762626479/dash_av1.mpd?t=1762632539","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2401910/1770570907/7f01f425d3500ab325d7d2a46e55d66465f5ac8a/1762626479/dash_h264.mpd?t=1762632539","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2401910/1770570907/7f01f425d3500ab325d7d2a46e55d66465