 gossip and information influencing gameplay, creating a dynamic and authentic experience. </p></li></ul></h2>","developers":["Glivi Games S.A."],"genres":[{"description":"Action","id":"1"},{"description":"Simulation","id":"28"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1876930/9205d7ce87049f73a722f424b578e883c5e81b3c/header.jpg?t=1758099890","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1876930/2112376642/682fc29b1f361460e7cfc52158bb5e501496411a/1751041926/dash_av1.mpd?t=1749733537","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1876930/2112376642/682fc29b1f361460e7cfc52158bb5e501496411a/1751041926/dash_h264.mpd?t=1749733537","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1876930/2112376642/682fc29b1f361460e7cfc52158bb5e501496411a/1751041926/hls_264_master.m3u8?t=1749733537","id":257155941,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257155941/movie480.mp4?t=1749733537","max":"https://video.akamai.steamstatic.com/store_trailers/257155941/movie_max.mp4?t=1749733537"},"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257155941/22dd55de050d44544a051270a02efd7d15232459/movie_600x337.jpg?t=1749733537","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257155941/movie480_vp9.webm?t=1749733537","max":"https://video.akamai.steamstatic.com/store_trailers/257155941/movie_max_vp9.webm?t=1749733537"}}],"name":"Saloon Simulator","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Saloon Simulator - $18.99 USD","packageid":675783,"percent_savings":0,"percent