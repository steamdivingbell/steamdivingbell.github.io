t_description":"Explore a vast, open world - evade or defeat its monsters, arm yourself with knowledge and equipment, unravel layer upon layer of secrets, and ultimately confront the very magic threatening to destroy everything.","steam_appid":1186050,"support_info":{"email":"thewitchofnull+hs@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}