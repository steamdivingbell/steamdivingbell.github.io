759770792","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036360/c2a985ac44e5b0a0725b795872c4ef6fe8a98242/ss_c2a985ac44e5b0a0725b795872c4ef6fe8a98242.600x338.jpg?t=1759770792"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036360/ss_d381d8c420033fbfb9e0ed827938bb5004bb389a.1920x1080.jpg?t=1759770792","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036360/ss_d381d8c420033fbfb9e0ed827938bb5004bb389a.600x338.jpg?t=1759770792"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036360/ss_3598fded9c3e840d4f30078c958ea2e8cce27ba6.1920x1080.jpg?t=1759770792","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036360/ss_3598fded9c3e840d4f30078c958ea2e8cce27ba6.600x338.jpg?t=1759770792"}],"short_description":"Heaven Crawler is an atmospheric, isometric action roguelite dungeon crawler with RPG elements. Explore The Womb, a forgotten, man-made tower that reaches the heavens. Collect powerful items and strengthen your character on an epic journey to the top. And remember: Bring her back!","steam_appid":3036360,"support_info":{"email":"","url":"https://www.carbonmachina.com/"},"supported_languages":"English","type":"game","website":"https://www.carbonmachina.com/game-in-development"}