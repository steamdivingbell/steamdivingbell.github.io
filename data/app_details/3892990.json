_paragraph\">Decorate your workspace with a range of backgrounds and mats and use the in-game screenshot feature to share your creations with the community. Join in the fun on Discord with regular challenges to show off your designs and let your creativity flow.\u00a0</p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892990/extras/6c003f216ff25121deadc0c827a0245a.poster.avif?t=1754402521\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892990/extras/6c003f216ff25121deadc0c827a0245a.webm?t=1754402521\" type=\"video/webm; codecs=vp9\"></video></div></p>","developers":["Meteor Pixel"],"fullgame":{"appid":"3651310","name":"Little Corners"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892990/cf2222bf61712c6b91a2b11462475f8d3dbdc5d4/header.jpg?t=1754402521","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257173383,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257173383/movie480.mp4?t=1754402295","max":"http://video.akamai.steamstatic.com/store_trailers/257173383/movie_max.mp4?t=1754402295"},"name":"Little Corners | Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257173383/2ddfc9659099539880a7011f4b8103c7654d2d0b/movie_600x337.jpg?t=1754402295","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257173383/movie480_vp9.w