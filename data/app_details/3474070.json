 loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3474070/extras/307b367eedff4de55c04d53e16946df5.poster.avif?t=1768240746\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3474070/extras/307b367eedff4de55c04d53e16946df5.webm?t=1768240746\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3474070/extras/307b367eedff4de55c04d53e16946df5.mp4?t=1768240746\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>2\u20134 Player Co-op Mode:</strong> Work together with your team to survive.</p></li><li><p class=\"bb_paragraph\" ><strong>Proximity Chat:</strong> Experience intense immersion with voice communication based on distance.</p></li><li><p class=\"bb_paragraph\" ><strong>Varied Creature Types:</strong> Face threats that hunt by sound, react to movement, and respond to light.</p></li><li><p class=\"bb_paragraph\" >Player Customization: Place a custom avatar inside your helmet and tweak your skin color for a truly personal look.</p></li><li><p class=\"bb_paragraph\" ><strong>3D Sound:</strong> Enjoy realistic underwater acoustics with dynamic occlusion and environmental reverb.</p></li></ul><p class=\"bb_paragraph\" ></p>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3474070?t=1768240746","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3474070/475513aa2afe72ac41b45257105a4fdbf960507b/page_bg_raw.jpg?t=1768240746","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3474070/e5255fe22ff06858022d6e94c264ec77b8210b3b/capsule_231x87.jpg?t=1768240746","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3474070/e5255fe22ff06858022d6e94c264ec77b8210b3b/capsule_184x69.jpg?t=1768240746","categories":[{"description":"Multi-player","id":1}