5ba271b4b1986b21cea1b5b5e/ss_eb53ffd16846a885ba271b4b1986b21cea1b5b5e.1920x1080.jpg?t=1759229632","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2688780/eb53ffd16846a885ba271b4b1986b21cea1b5b5e/ss_eb53ffd16846a885ba271b4b1986b21cea1b5b5e.600x338.jpg?t=1759229632"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2688780/7b33de937b692a0495e14bfb4e78a9ffa8307ab6/ss_7b33de937b692a0495e14bfb4e78a9ffa8307ab6.1920x1080.jpg?t=1759229632","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2688780/7b33de937b692a0495e14bfb4e78a9ffa8307ab6/ss_7b33de937b692a0495e14bfb4e78a9ffa8307ab6.600x338.jpg?t=1759229632"}],"short_description":"Odd Town is an immersive first-person action game that lets you explore a beautiful historical town and unveil its dark mysteries. Meet whacky characters, eat at restaurants, drink at bars, learn about the local history, find your way into restricted areas and investigate!","steam_appid":2688780,"support_info":{"email":"matt.vacek@live.fr","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}