51ba3400855b1c45c2.poster.avif?t=1774506281\" class=\"bb_img\" width=32 height=32 /></picture></span>\u00a0 \u00a0\u00a0<span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/e817d9d4ac84d635ca2d34814362ec6e.apng?t=1774506281\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/e817d9d4ac84d635ca2d34814362ec6e.poster.avif?t=1774506281\" class=\"bb_img\" width=32 height=32 /></picture></span></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/7e4d16639c325663fc2306bbcc0e52a5.poster.avif?t=1774506281\" width=960 height=540 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/7e4d16639c325663fc2306bbcc0e52a5.webm?t=1774506281\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/7e4d16639c325663fc2306bbcc0e52a5.mp4?t=1774506281\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Use Relics and your wits and creativity to bend the rules to create massive scoring combos.\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0</p><h2 class=\"bb_tag\" style=\"text-align: center\">\u00a0<span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/2a840f4649a7ae5fd8a8bd7ae0db6a00.apng?t=1774506281\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/2a840f4649a7ae5fd8a8bd7ae0db6a00.poster.avif?t=1774506281\" class=\"bb_img\" width=32 height=32 /></picture></span>\u00a0 \u00a0<span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/567b0558800fa28ef41e6ee08c414dff.apng?t=1774506281\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/567b0558800fa28ef41e6ee08c414dff.poster.avif?t=1774506281\" class=\"bb_img\" width=32 height=32 /></picture></span> \u00a0 <span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/526b20a4307918b0d3478cff81230ded.apng?t=1774506281\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/526b20a4307918b0d3478cff81230ded.poster.avif?t=1774506281\" class=\"bb_img\" width=32 height=32 /></picture></span>\u00a0 <span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/bb81b541c1077851ba3400855b1c45c2.apng?t=1774506281\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/bb81b541c1077851ba3400855b1c45c2.poster.avif?t=1774506281\" class=\"bb_img\" width=32 height=32 /></picture></span>\u00a0 \u00a0 \u00a0<span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/e817d9d4ac84d635ca2d34814362ec6e.apng?t=1774506281\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/e817d9d4ac84d635ca2d34814362ec6e.poster.avif?t=1774506281\" class=\"bb_img\" width=32 height=32 /></picture></span>\u00a0</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/0b93bda3d3e78b5008768ecbf980761c.poster.avif?t=1774506281\" width=960 height=540 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extras/0b93bda3d3e78b5008768ecbf980761c.webm?t=1774506281\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822710/extr