ng forgotten, <strong>a dark Djinn has found its way back</strong>, driven by an insatiable desire to reclaim its full powers and extend its supreme will on the desert and beyond.</p></p>","developers":["Fioretto Studios"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730820/665c8dc0946521607b31d07ca0926b15d06474e4/header.jpg?t=1769766957","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2730820/1550416674/ed2ba8032950226900df86864e57d9cb4a89198c/1767711122/dash_av1.mpd?t=1767712441","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2730820/1550416674/ed2ba8032950226900df86864e57d9cb4a89198c/1767711122/dash_h264.mpd?t=1767712441","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2730820/1550416674/ed2ba8032950226900df86864e57d9cb4a89198c/1767711122/hls_264_master.m3u8?t=1767712441","id":257178547,"name":"Gameplay 1","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257178547/93ff2c8fba4ef98f889d5e249a7665c38d843673/movie_600x337.jpg?t=1767712441"}],"name":"Aliosso","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Aliosso - $8.99 USD","packageid":977251,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":899}],"title":"Buy Aliosso"}],"packages":[977251],"pc_requirements":{"min