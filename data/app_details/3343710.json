g\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/extras/END_WAVE.gif?t=1744521292\" /></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Kill the final boss.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/extras/LAST_WAVE_BOSS.gif?t=1744521292\" /></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p>","developers":["TribanzDev","TribanzDev"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/14bf019ea9526f2a5e011525cf5db8018d15356e/header.jpg?t=1744521292","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257077608,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257077608/movie480.mp4?t=1744521291","max":"http://video.akamai.steamstatic.com/store_trailers/257077608/movie_max.mp4?t=1744521291"},"name":"Rendagor Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257077608/066aec0e1bce987616435c60ceb079267d7177bf/movie_600x337.jpg?t=1744521291","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257077608/movie480_vp9.webm?t=1744521291","max":"http://video.akamai.steamstatic.com/store_trailers/257077608/movie_max_vp9.webm?t=1744521291"}}],"name":"Rendagor","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core 2 Duo E8200, AMD Athlon XE BE-2300<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 5500 (Broadwell), AMD Radeon R5 Graphics (Kaveri)<br></li><li><strong>Storage:</strong> 310 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><str