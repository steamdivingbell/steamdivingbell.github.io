g\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/extras/END_WAVE.gif?t=1747334017\" /></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Kill the final boss.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/extras/LAST_WAVE_BOSS.gif?t=1747334017\" /></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p>","developers":["TribanzDev","TribanzDev"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/14bf019ea9526f2a5e011525cf5db8018d15356e/header.jpg?t=1747334017","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Linux distribution released after 2016<br></li><li><strong>Processor:</strong> Intel Core 2 Duo E8200, AMD Athlon XE BE-2300, Raspberry Pi 4<br></li><li><strong>Memory:</strong> 3 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 5500 (Broadwell), AMD Radeon R5 Graphics (Kaveri)<br></li><li><strong>Storage:</strong> 310 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Linux distribution released after 2016<br></li><li><strong>Processor:</strong> Intel Core i5-6600K, AMD Ryzen 5 1600, Raspberry Pi 5 with overclocking<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 1050 (Pascal), AMD Radeon RX 460 (GCN 4.0)<br></li><li><strong>Storage:</strong> 3 MB available space</li></ul>"},"mac_requirements":[],"movies":[{"highlight":true,"id":257077608,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257077608/movie480.mp4?t=1747334016","max":"http://video.akamai.steamstatic.com/store_trailers/257077608/movie_max.mp4?t=1747334016"},"name":"Rendagor Trailer","thu