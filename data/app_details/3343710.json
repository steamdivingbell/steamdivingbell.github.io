21987e1184.1920x1080.jpg?t=1747334017","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/55a6f270aa2220ff4c6ddbd7ce4a5721987e1184/ss_55a6f270aa2220ff4c6ddbd7ce4a5721987e1184.600x338.jpg?t=1747334017"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/cd47c50bf2854635905939f60606d06e9da5b1b5/ss_cd47c50bf2854635905939f60606d06e9da5b1b5.1920x1080.jpg?t=1747334017","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/cd47c50bf2854635905939f60606d06e9da5b1b5/ss_cd47c50bf2854635905939f60606d06e9da5b1b5.600x338.jpg?t=1747334017"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/40cf39147d781a911046983f63792a58ec6e2cb4/ss_40cf39147d781a911046983f63792a58ec6e2cb4.1920x1080.jpg?t=1747334017","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/40cf39147d781a911046983f63792a58ec6e2cb4/ss_40cf39147d781a911046983f63792a58ec6e2cb4.600x338.jpg?t=1747334017"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/75ceac07b402861f13c9dacea47aff74bb9cc06a/ss_75ceac07b402861f13c9dacea47aff74bb9cc06a.1920x1080.jpg?t=1747334017","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3343710/75ceac07b402861f13c9dacea47aff74bb9cc06a/ss_75ceac07b402861f13c9dacea47aff74bb9cc06a.600x338.jpg?t=1747334017"}],"short_description":"A top down 2d pixel art sci-fi shooter. Destroy threats, solve small puzzles, kill bosses in each level to advance to the next. Upgrade your drone with the power-ups and weapons you find around the levels to become increasingly lethal.","steam_appid":3343710,"support_info":{"email":"tribanzdev@gmail.com","url":""},"supported_languages":"English, Italian","type":"game","website":null}