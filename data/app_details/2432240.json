_assets/steam/apps/2432240/4036a4459fb98c2f52c69d749bb453a65d009691/ss_4036a4459fb98c2f52c69d749bb453a65d009691.600x338.jpg?t=1772213517"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2432240/62aa1e037a1e0e34232de55e06ec76eefeeffff0/ss_62aa1e037a1e0e34232de55e06ec76eefeeffff0.1920x1080.jpg?t=1772213517","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2432240/62aa1e037a1e0e34232de55e06ec76eefeeffff0/ss_62aa1e037a1e0e34232de55e06ec76eefeeffff0.600x338.jpg?t=1772213517"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2432240/ffeab282513706388e3b6e2d88ff7e8b7321e8d4/ss_ffeab282513706388e3b6e2d88ff7e8b7321e8d4.1920x1080.jpg?t=1772213517","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2432240/ffeab282513706388e3b6e2d88ff7e8b7321e8d4/ss_ffeab282513706388e3b6e2d88ff7e8b7321e8d4.600x338.jpg?t=1772213517"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2432240/afaa76d247647c838d7cd07c481165a0d0eb751f/ss_afaa76d247647c838d7cd07c481165a0d0eb751f.1920x1080.jpg?t=1772213517","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2432240/afaa76d247647c838d7cd07c481165a0d0eb751f/ss_afaa76d247647c838d7cd07c481165a0d0eb751f.600x338.jpg?t=1772213517"}],"short_description":"Smash it Wild is a tactical turn-based game combining volleyball and dodgeball in a fantasy universe. Upgrade your players and defeat your opponents in an intense roguelike competition!","steam_appid":2432240,"support_info":{"email":"support+smashitwild@goblinzstudio.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Korean, Polish, Simplified Chinese","type":"game","website":null}