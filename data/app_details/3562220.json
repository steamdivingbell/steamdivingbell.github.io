3562220/3fe70356280752c3edfda92d7ccd45366dbe99be/ss_3fe70356280752c3edfda92d7ccd45366dbe99be.600x338.jpg?t=1754624266"}],"short_description":"Questy Chess is a puzzling RPG set in the world of an ageing chess computer. Make your way though 4 worlds, using your inventory of powers and moves, to restore peace to this humble chess program.","steam_appid":3562220,"support_info":{"email":"","url":"https://dadako.com/about/#contact"},"supported_languages":"English, Japanese","type":"game","website":"https://questychess.com"}