/bc6d4ea821da82755e2f3c1f131dd945dc2cf190/ss_bc6d4ea821da82755e2f3c1f131dd945dc2cf190.1920x1080.jpg?t=1769491713","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045080/bc6d4ea821da82755e2f3c1f131dd945dc2cf190/ss_bc6d4ea821da82755e2f3c1f131dd945dc2cf190.600x338.jpg?t=1769491713"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045080/150f0aa175fecc388382d1ea4fb4485fc245bb93/ss_150f0aa175fecc388382d1ea4fb4485fc245bb93.1920x1080.jpg?t=1769491713","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045080/150f0aa175fecc388382d1ea4fb4485fc245bb93/ss_150f0aa175fecc388382d1ea4fb4485fc245bb93.600x338.jpg?t=1769491713"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045080/5c15fd3e923e646b4f1495adaf23e480f7d25db5/ss_5c15fd3e923e646b4f1495adaf23e480f7d25db5.1920x1080.jpg?t=1769491713","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4045080/5c15fd3e923e646b4f1495adaf23e480f7d25db5/ss_5c15fd3e923e646b4f1495adaf23e480f7d25db5.600x338.jpg?t=1769491713"}],"short_description":"Jezbel is a narrative-driven visual novel set in medieval Rosegate. Play as Duvessa Devereux, a ruthless noblewoman scheming her way to power. With RPG elements and branching paths, your choices shape her fate and the future of the kingdom.","steam_appid":4045080,"support_info":{"email":"","url":"https://saikeystudios.com"},"supported_languages":"English","type":"game","website":"https://saikeystudios.com"}