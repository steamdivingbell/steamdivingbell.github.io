596250e48e60565/ss_88e90ce2d9c5f501804e80291596250e48e60565.1920x1080.jpg?t=1769097300","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286440/88e90ce2d9c5f501804e80291596250e48e60565/ss_88e90ce2d9c5f501804e80291596250e48e60565.600x338.jpg?t=1769097300"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286440/284a3062a9e1597fad62dd2c59e1a053e8656273/ss_284a3062a9e1597fad62dd2c59e1a053e8656273.1920x1080.jpg?t=1769097300","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286440/284a3062a9e1597fad62dd2c59e1a053e8656273/ss_284a3062a9e1597fad62dd2c59e1a053e8656273.600x338.jpg?t=1769097300"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286440/aee727c051f3ac898691e8ec1733f38b0b51fd64/ss_aee727c051f3ac898691e8ec1733f38b0b51fd64.1920x1080.jpg?t=1769097300","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286440/aee727c051f3ac898691e8ec1733f38b0b51fd64/ss_aee727c051f3ac898691e8ec1733f38b0b51fd64.600x338.jpg?t=1769097300"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286440/26b18e0ec3d24af5b189e4b902c05158dfd91221/ss_26b18e0ec3d24af5b189e4b902c05158dfd91221.1920x1080.jpg?t=1769097300","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286440/26b18e0ec3d24af5b189e4b902c05158dfd91221/ss_26b18e0ec3d24af5b189e4b902c05158dfd91221.600x338.jpg?t=1769097300"}],"short_description":"Step into the wheels of a robot in this sci-fi cleaning adventure set after the apocalypse. Wash, vacuum, recycle and repair abandoned structures while learning about the ultimate fate of mankind, alone or with friends.","steam_appid":3286440,"support_info":{"email":"info@packgamesim.com","url":"https://www.packgamesim.com"},"supported_languages":"English","type":"game","website":"https://www.packgamesim.com"}