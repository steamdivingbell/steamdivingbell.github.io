=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/e638886e598be674f232cf03916db62b.mp4?t=1770985666\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Combine dice values to unleash powerful skills!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/8598d4e6242b4ca19c7a405c8f6675f3.poster.avif?t=1770985666\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/8598d4e6242b4ca19c7a405c8f6675f3.webm?t=1770985666\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/8598d4e6242b4ca19c7a405c8f6675f3.mp4?t=1770985666\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Sometimes, a crisis can turn into an opportunity\u2014use enemy attacks strategically to gain the upper hand.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>18 Unique Heroes &amp; Skill Combinations</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/0c9f3de8967a0400b02ad5e3b5563a3e.poster.avif?t=1770985666\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/0c9f3de8967a0400b02ad5e3b5563a3e.webm?t=1770985666\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/0c9f3de8967a0400b02ad5e3b5563a3e.mp4?t=1770985666\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Recruit and develop <strong>18 unique heroes</strong>.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/1351fece207038ab367126b40b0f1ea1.avif?t=1770985666\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras_big/1351fece207038ab367126b40b0f1ea1.avif?t=1770985666 width=800 height=450 /></span></p><p class=\"bb_paragraph\" >Each hero follows a different skill path and plays a unique role in combat.</p><p class=\"bb_paragraph\" >Leverage their distinctive abilities to make every battle dynamic and engaging.</p><p class=\"bb_paragraph\" >The more heroes you gather, the stronger their synergy becomes\u2014push enemies back, burn them, or freeze them in place!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>World &amp; Events</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/f4e8e8a9333a363913c0130371047fa2.poster.avif?t=1770985666\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/f4e8e8a9333a363913c0130371047fa2.webm?t=1770985666\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/f4e8e8a9333a363913c0130371047fa2.mp4?t=1770985666\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Embark on a journey filled with countless stories.</p><p class=\"bb_paragraph\" >From heroes to townsfolk, and even a mischievous little imp\u2014everyone has a tale to tell.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/3b58d3f8b2b34fc839a7a573a18dc6de.poster.avif?t=1770985666\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/3b58d3f8b2b34fc839a7a573a18dc6de.webm?t=1770985666\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/3b58d3f8b2b34fc839a7a573a18dc6de.mp4?t=1770985666\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Discover their stories, recruit them, and expand your team.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/a4fdf4d0170c9d8a7ca453cea7923ed8.poster.avif?t=1770985666\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/a4fdf4d0170c9d8a7ca453cea7923ed8.webm?t=1770985666\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/a4fdf4d0170c9d8a7ca453cea7923ed8.mp4?t=1770985666\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Roll the dice and shape your destiny.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/c515486380826b97aceacf57fbdc1fff.poster.avif?t=1770985666\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/c515486380826b97aceacf57fbdc1fff.webm?t=1770985666\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/c515486380826b97aceacf57fbdc1fff.mp4?t=1770985666\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Seek out Goddess Statues to receive blessings and enhance your dice!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Relics</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/b9786219df41e8350cef8114bc9c39f6.poster.avif?t=1770985666\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/b9786219df41e8350cef8114bc9c39f6.webm?t=1770985666\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/b9786219df41e8350cef8114bc9c39f6.mp4?t=1770985666\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Relics with unique effects help define your combat strategy.</p><p class=\"bb_paragraph\" >Collect relics to maximize your heroes\u2019 potential and discover new ways to claim victory.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Heroic Chronicle</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras/4c6db2b4f34b42aed84175ae0322e993.avif?t=1770985666\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3279980/extras_big/4c6db2b4f34b42aed84175ae0322e993.avif?t=1770985666 width=800 height=450 /></span></p><p class=\"bb_paragraph\" >Gain experience as you play and strengthen the Heroic Chronicle.</p><p class=\"bb_paragraph\" >Empower your team and unlock new starting heroes!</p><p class=\"bb_paragraph\" ></p>","developers":["Superlazy"],"genres":[{"description":"