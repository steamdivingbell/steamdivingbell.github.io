apps/3829120/5485d5229974db2c8b699c0892242b468edeb50a/ss_5485d5229974db2c8b699c0892242b468edeb50a.600x338.jpg?t=1752834486"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3829120/b6ce3d1e63b529b009bd6fedc759b0b1b0b7edb7/ss_b6ce3d1e63b529b009bd6fedc759b0b1b0b7edb7.1920x1080.jpg?t=1752834486","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3829120/b6ce3d1e63b529b009bd6fedc759b0b1b0b7edb7/ss_b6ce3d1e63b529b009bd6fedc759b0b1b0b7edb7.600x338.jpg?t=1752834486"}],"short_description":"A next-gen GPU benchmark built for extreme fidelity. Real-time lighting, ray tracing, and ultra-dense geometry push modern graphics cards to their limits. Features an exploration mode to freely explore the world.","steam_appid":3829120,"support_info":{"email":"nextvisualsbenchmark@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}