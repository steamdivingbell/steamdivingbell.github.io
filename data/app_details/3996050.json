.jpg?t=1769136918"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996050/4be47cec9a44afca6554165295d7650298d6aab9/ss_4be47cec9a44afca6554165295d7650298d6aab9.1920x1080.jpg?t=1769136918","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996050/4be47cec9a44afca6554165295d7650298d6aab9/ss_4be47cec9a44afca6554165295d7650298d6aab9.600x338.jpg?t=1769136918"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996050/0eb1f00ae2773aeee38caca1c1d20676b3dc7aa2/ss_0eb1f00ae2773aeee38caca1c1d20676b3dc7aa2.1920x1080.jpg?t=1769136918","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996050/0eb1f00ae2773aeee38caca1c1d20676b3dc7aa2/ss_0eb1f00ae2773aeee38caca1c1d20676b3dc7aa2.600x338.jpg?t=1769136918"}],"short_description":"Manic Meeples is a deck building rogue-like featuring countless cute and special new pieces! Inspired by chess, this game goes above and beyond its LAME source material (sorry not sorry to the 6th century AD chess devopers) to create a fun and fresh experience!","steam_appid":3996050,"support_info":{"email":"theberriestbush@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}