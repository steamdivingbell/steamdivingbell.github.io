mp4\"></video></span></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>Discover Hidden Truths</strong></h2><p class=\"bb_paragraph\" >Every boss has a story. Learn as much\u00a0\u2014 or as little\u00a0\u2014 as you choose.\u00a0</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3692670/extras/c5f90f5ab9c7fc7ceeecffa57d987af1.poster.avif?t=1759936535\" width=1170 height=518 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3692670/extras/c5f90f5ab9c7fc7ceeecffa57d987af1.webm?t=1759936535\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3692670/extras/c5f90f5ab9c7fc7ceeecffa57d987af1.mp4?t=1759936535\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>Make Allies</strong></h2><p class=\"bb_paragraph\" >In a realm where death can be endlessly deferred, some defeated foes may return in unexpected ways.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3692670/extras/639cbcc141710191d400ceafab444c4e.poster.avif?t=1759936535\" width=1170 height=518 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3692670/extras/639cbcc141710191d400ceafab444c4e.webm?t=1759936535\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3692670/extras/639cbcc141710191d400ceafab444c4e.mp4?t=1759936535\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>Game Features</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Linear storyline with fast-paced action combat duels against multiple bosses.\u00a0</p></li><li><p class=\"bb_paragraph\" >Seamlessly blend offense and defense with dodges, parries, and counter-attacks.</p></li><li><p class=\"bb_paragraph\" >All abilities are available from the start for you to play with.\u00a0</p></li><li><p class=\"bb_paragraph\" >Optional character stories and interactions enrich the world without interrupting gameplay.</p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["kemomimic"],"genres":[{"description":"Action","id":"1"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3692670/7527eb5f06e0a760abaf851682b1d6a577a6fe8a/header.jpg?t=1759936535","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3692670/2132322741/17dc4cf15bfdca08cf1f75d9deb0c3eb9b8bf22e/1759935703/dash_av1.mpd?t=1759936529","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3692670/2132322741/17dc4cf15bfdca08cf1f75d9deb0c3eb9b8bf22e/1759935703/dash_h264.mpd?t=1759936529","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3692670/2132322741/17dc4cf15bfdca08cf1f75d9deb0c3eb9b8bf22e/1759935703/hls_264_master.m3u8?t=1759936529","id":257214323,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257214323/movie480.mp4?t=1759936529","max":"https://video.akamai.steamstatic.com/store_trailers/257214323/movie_max.mp4?t=1759936529"},"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257214323/532eebdb77b68acd4a6c438145ceddeba2e3657e/movie_600x337.jpg?t=1759936529","webm":{"480":"https://video.akamai.steamstatic.com