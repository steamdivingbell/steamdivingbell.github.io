5fd6d3b4e50f49e0b13afa5c8a9d2c/ss_fca55cae345fd6d3b4e50f49e0b13afa5c8a9d2c.1920x1080.jpg?t=1744257606","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3603530/fca55cae345fd6d3b4e50f49e0b13afa5c8a9d2c/ss_fca55cae345fd6d3b4e50f49e0b13afa5c8a9d2c.600x338.jpg?t=1744257606"}],"short_description":"Conquer dungeons and flirt with girls in this roguelite RPG! You'll need wisdom, courage, and luck to traverse these mysterious depths and secure the best ending for you and your unexpected travel companion Monica.","steam_appid":3603530,"support_info":{"email":"steamsupport@dlsite.com","url":""},"supported_languages":"English, Simplified Chinese, Traditional Chinese, Korean","type":"game","website":null}