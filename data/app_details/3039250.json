ND STATUS</strong></h2><p class=\"bb_paragraph\" >Compete on global leaderboards to carve out your name at the top. You\u2019ll either win or wipe out, so stay sharp and don\u2019t blink.</p><p class=\"bb_paragraph\" ></p>","developers":["Repixel8"],"genres":[{"description":"Racing","id":"9"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3039250/header.jpg?t=1760645571","is_free":false,"legal_notice":"The Numskull Games logo is a registered trademark of Numskull Games Ltd.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3039250/800881/920f7468861266d945052acd46515531a3984a9b/1750960094/dash_av1.mpd?t=1734361510","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3039250/800881/920f7468861266d945052acd46515531a3984a9b/1750960094/dash_h264.mpd?t=1734361510","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3039250/800881/920f7468861266d945052acd46515531a3984a9b/1750960094/hls_264_master.m3u8?t=1734361510","id":257082607,"name":"Neon Apex Announcement","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257082607/2b559fe563493fea9ac4259e87a24cb23e9bc266/movie_600x337.jpg?t=1734361510"}],"name":"Neon Apex: Beyond the Limit","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Neon Apex: Beyond the Limit - $24.99 USD","packageid":1080455,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_d