0656d7216c5a23388f03a5.600x338.jpg?t=1772179766"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3690490/07ba0b9dd7d657c257ab6303b988a0d55d4d2230/ss_07ba0b9dd7d657c257ab6303b988a0d55d4d2230.1920x1080.jpg?t=1772179766","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3690490/07ba0b9dd7d657c257ab6303b988a0d55d4d2230/ss_07ba0b9dd7d657c257ab6303b988a0d55d4d2230.600x338.jpg?t=1772179766"}],"short_description":"Become the last conductor and rule over the final train society in a frozen world. Gather, expand, and forge your train while building powerful synergies with mighty artifacts. Your position\u2014and the safety of your passengers\u2014now rests in your hands.","steam_appid":3690490,"support_info":{"email":"nemonan.inc@gmail.com","url":""},"supported_languages":"Korean, English, Japanese, German, Greek, Simplified Chinese, Czech, Russian, Ukrainian, Polish, Portuguese - Brazil","type":"game","website":null}