_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3946540/7807b9a26b8058800ca7fc1f75d31333cf08e9d3/ss_7807b9a26b8058800ca7fc1f75d31333cf08e9d3.1920x1080.jpg?t=1756216052","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3946540/7807b9a26b8058800ca7fc1f75d31333cf08e9d3/ss_7807b9a26b8058800ca7fc1f75d31333cf08e9d3.600x338.jpg?t=1756216052"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3946540/e3b6b0f8d6936933a2910d371dad42a8cd51ad02/ss_e3b6b0f8d6936933a2910d371dad42a8cd51ad02.1920x1080.jpg?t=1756216052","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3946540/e3b6b0f8d6936933a2910d371dad42a8cd51ad02/ss_e3b6b0f8d6936933a2910d371dad42a8cd51ad02.600x338.jpg?t=1756216052"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3946540/50a1846b012c655ee1f530bcf9a5c57a0f8d01fd/ss_50a1846b012c655ee1f530bcf9a5c57a0f8d01fd.1920x1080.jpg?t=1756216052","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3946540/50a1846b012c655ee1f530bcf9a5c57a0f8d01fd/ss_50a1846b012c655ee1f530bcf9a5c57a0f8d01fd.600x338.jpg?t=1756216052"}],"short_description":"Selan\u00eca is a narrative cozy game: meet a cast of eccentric characters, gain their trust, and help them rewrite their stories. And yours. Lose yourself in Selan\u00eca, where the greenhouse blooms of curious plants, the kitchen is always hungry, and the library whispers tales. Or just sit down, and relax.","steam_appid":3946540,"support_info":{"email":"onefoxonewolf@gmail.com","url":"https://www.instagram.com/owofgames/"},"supported_languages":"English, Italian","type":"game","website":null}