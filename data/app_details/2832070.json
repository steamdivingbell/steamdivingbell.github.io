b_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832070/extras/Collectible.gif?t=1749490656\" /></div></p><p class=\"bb_paragraph\"> </p><p class=\"bb_paragraph\">Prove that you are the ultimate martial artist and go kick Satan in his face!</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832070/extras/WishlistGif.gif?t=1749490656\" /></div></p>","developers":["Fire Foot Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832070/header.jpg?t=1749490656","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257139036,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257139036/movie480.mp4?t=1747130108","max":"http://video.akamai.steamstatic.com/store_trailers/257139036/movie_max.mp4?t=1747130108"},"name":"Kick'n Hell - Official Release Date trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257139036/a71b176a732cde8f67d932a3fbb2a285ca4f2420/movie_600x337.jpg?t=1747130108","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257139036/movie480_vp9.webm?t=1747130108","max":"http://video.akamai.steamstatic.com/store_trailers/257139036/movie_max_vp9.webm?t=1747130108"}}],"name":"Kick'n Hell","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 or 11<br></li><li><strong>Processor:</strong> Intel Core i5-3330 3.0 GHz, AMD FX-8300 3.3 GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 950 or Radeon HD 7970<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</stron