)</p><p class=\"bb_paragraph\">Dive into our game, where every punch, dodge, and movement is at the tip of your fingers - literally! Embrace the challenge, let your intuition guide you, and become the boxing legend you were meant to be!</p>","developers":["Rahu Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Sports","id":"18"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2548440/91faa0c384d39d467e6f6c3da87f47be72c73e3a/header.jpg?t=1752912614","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":256966444,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/256966444/movie480.mp4?t=1752912612","max":"http://video.akamai.steamstatic.com/store_trailers/256966444/movie_max.mp4?t=1752912612"},"name":"boxingTrailer2","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256966444/e764204e4e96c5df8803090ff3367d4a07d74294/movie_600x337.jpg?t=1752912612","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/256966444/movie480_vp9.webm?t=1752912612","max":"http://video.akamai.steamstatic.com/store_trailers/256966444/movie_max_vp9.webm?t=1752912612"}}],"name":"Boxing Simulator","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5-6300HQ<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GTX 960<br></li><li><stro