ai.steamstatic.com/store_item_assets/steam/apps/3383510/df4dbe995387280a7f8e1091b168a13a5015183c/ss_df4dbe995387280a7f8e1091b168a13a5015183c.600x338.jpg?t=1770758087"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383510/31339c1e6e4e90ea3b4e016fe8fc22ec81be1f5e/ss_31339c1e6e4e90ea3b4e016fe8fc22ec81be1f5e.1920x1080.jpg?t=1770758087","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383510/31339c1e6e4e90ea3b4e016fe8fc22ec81be1f5e/ss_31339c1e6e4e90ea3b4e016fe8fc22ec81be1f5e.600x338.jpg?t=1770758087"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383510/4d154464ced9398c6e854d8162ab3db6ee732a20/ss_4d154464ced9398c6e854d8162ab3db6ee732a20.1920x1080.jpg?t=1770758087","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383510/4d154464ced9398c6e854d8162ab3db6ee732a20/ss_4d154464ced9398c6e854d8162ab3db6ee732a20.600x338.jpg?t=1770758087"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383510/1775edb8bb8990a79f901348ba48e54da72388f2/ss_1775edb8bb8990a79f901348ba48e54da72388f2.1920x1080.jpg?t=1770758087","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383510/1775edb8bb8990a79f901348ba48e54da72388f2/ss_1775edb8bb8990a79f901348ba48e54da72388f2.600x338.jpg?t=1770758087"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383510/9676d0b37a2f07595e6d5977613f29ca5572552d/ss_9676d0b37a2f07595e6d5977613f29ca5572552d.1920x1080.jpg?t=1770758087","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3383510/9676d0b37a2f07595e6d5977613f29ca5572552d/ss_9676d0b37a2f07595e6d5977613f29ca5572552d.600x338.jpg?t=1770758087"}],"short_description":"Co-op cosmic horror game for up to 4 players. Explore dimensions inspired by Lovecraft\u2019s tales, gather primordial energy, extract alien artifacts, in