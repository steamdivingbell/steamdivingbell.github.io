ase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Fever Meme - $4.20 USD","packageid":1104625,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":420}],"title":"Buy Fever Meme"}],"packages":[1104625],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel i5-8400 / AMD Ryzen 5 2600<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1060 (6GB) / AMD RX 580<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 4 GB available space<br></li><li><strong>Additional Notes:</strong> Game may behave unpredictably at low frame rates (&lt;45 FPS). Use of older laptops or integrated GPUs is not recommended.</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"price_overview":{"currency":"USD","discount_percent":0,"final":420,"final_formatted":"$4.20 USD","initial":420,"initial_formatted":""},"publishers":["Aimbok"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00c3\u00aancia","rating":"10","rating_generated":"1","required_age":"10","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"recommendations":{"total":3632},"release_date":{"coming_soon":false,"date":"4 Jul, 2025"},"required_age":0,"reviews":"\u201cFever Meme is an incredibly overstimulating game. It\u2019s brash, bold, and incredibly in-your-face at almost every moment.\u201d<br>Highly Recommended \u2013 VICE<br><br>\u201cTrolling people is an art form, and a lot of people just don\u2019t have the talent or the drive it takes to really do it well. So when you find someone who is putting real skill and effort into rage-baiting people, you have to respect the lengths they go to for a dream and a love of the game.\u201d<br>Kotaku<br><br>\u201cIf you enjoy satire and games where choices truly matter, this one may surprise you.\u201d<br>4.2/5 \u2013 Softonic<br>","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3110070/75512ab836312789e592c5d17b90039b2072100e/ss_75512ab836312789e592c5d17b90039b2072100e.1920x1080.jpg?t=1764329811","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3110070/75512ab836312789e592c5d17b90039b2072100e/ss_75512ab836312789e592c5d17b90039b2072100e.600x338.jpg?t=1764329811"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3110070/fb804c6b58e9c57abdd65055a2ef3903fb7158cb/ss_fb804c6b58e9c57abdd65055a2ef3903fb7158cb.1920x1080.jpg?t=1764329811","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3110070/fb804c6b58e9c57abdd65055a2ef3903fb7158cb/ss_fb804c6b58e9c57abdd65055a2ef3903fb7158cb.600x338.jpg?t=1764329811"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3110070/8e5b672acba4a8c08c6c2f082d6df998ea82a0a6/ss_8e5b672acba4a8c08c6c2f082d6df998ea82a0a6.1920x1080.jpg?t=1764329811","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3110070/8e5b672acba4a8c08c6c2f082d6df998ea82a0a6/ss_8e5b672acba4a8c08c6c2f082d6df998ea82a0a6.600x338.jpg?t=1764329811"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3110070/4876cfe20e33b23d9bd61ff7014c1456d68b5593/ss_4876cfe20e33b23d9bd61ff7014c1456d68b5593.1920x1080.jpg?t=1764329811","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3110070/4876cfe20e33b23d9bd61ff7014c1456d68b5593/ss_4876cfe20e33b23d9bd61ff7014c1456d68b5593.600x338.jpg?t=1764329811"},{"id":4,"