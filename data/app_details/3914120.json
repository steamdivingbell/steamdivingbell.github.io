em_assets/steam/apps/3914120/extras/96b734404675b02c3f9073e23768d8a2.poster.avif?t=1754369706\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3914120/extras/96b734404675b02c3f9073e23768d8a2.webm?t=1754369706\" type=\"video/webm; codecs=vp9\"></video></div></h2><h2 class=\"bb_tag\">A Growing World In Progress</h2><p class=\"bb_paragraph\">This is an evolving game. Planned updates for the full game include:</p><p class=\"bb_paragraph\">\u2022 More  heroes (definitely)</p><p class=\"bb_paragraph\">\u2022 More mounts (definitely)</p><p class=\"bb_paragraph\">\u2022 Personal housing you can decorate (maybe)</p><p class=\"bb_paragraph\">\u2022 New biomes for new outposts (probably)</p><p class=\"bb_paragraph\">\u2022 You let us know what else you want to see!</p>","developers":["Tidepool Games"],"fullgame":{"appid":"3897350","name":"Idlewood Outpost"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3914120/c09a791b5d2c93d546c2d3ae4adb0831ac032012/header.jpg?t=1754369706","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OS X 10.9+<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core i3<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Graphics card with DX9<br></li><li><strong>Storage:</strong> 256 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257175928,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257175928/movie480.mp4?t=1754369514","max":"http://video.akamai.steamstatic.com/store_trailers/257175928/movi