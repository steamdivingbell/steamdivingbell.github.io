/3691940/663346d5bcffb94aac5fa9fefbe022d97e42d456/ss_663346d5bcffb94aac5fa9fefbe022d97e42d456.600x338.jpg?t=1764615734"}],"short_description":"The chess roguelike deckbuilder. Solo Chess is a cozy strategy game where you play chess-themed cards on a 3\u00d73 grid, trigger piece effects, and earn points through clever combos. Build your deck with pets and food to conquer waves of unique battles.","steam_appid":3691940,"support_info":{"email":"noursaidana@kinzoraco.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Polish, Portuguese - Brazil, Simplified Chinese, Traditional Chinese, Japanese, Korean, Russian","type":"game","website":null}