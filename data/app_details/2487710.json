h_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/23c48ff7621b6148310152a64bb852b89fe6bcfa/ss_23c48ff7621b6148310152a64bb852b89fe6bcfa.1920x1080.jpg?t=1771104651","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/23c48ff7621b6148310152a64bb852b89fe6bcfa/ss_23c48ff7621b6148310152a64bb852b89fe6bcfa.600x338.jpg?t=1771104651"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/8600ac1d609b84596282371f38c4b8649ebda18e/ss_8600ac1d609b84596282371f38c4b8649ebda18e.1920x1080.jpg?t=1771104651","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/8600ac1d609b84596282371f38c4b8649ebda18e/ss_8600ac1d609b84596282371f38c4b8649ebda18e.600x338.jpg?t=1771104651"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/b31f51cfcd9e91c4c0b7fd96c53ba20065f530ad/ss_b31f51cfcd9e91c4c0b7fd96c53ba20065f530ad.1920x1080.jpg?t=1771104651","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/b31f51cfcd9e91c4c0b7fd96c53ba20065f530ad/ss_b31f51cfcd9e91c4c0b7fd96c53ba20065f530ad.600x338.jpg?t=1771104651"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/ab734fdd3d000c01077939258098aac77bfd0e4b/ss_ab734fdd3d000c01077939258098aac77bfd0e4b.1920x1080.jpg?t=1771104651","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/ab734fdd3d000c01077939258098aac77bfd0e4b/ss_ab734fdd3d000c01077939258098aac77bfd0e4b.600x338.jpg?t=1771104651"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/8a28849cdd3bafb4c33448a02d16e91331bba2c6/ss_8a28849cdd3bafb4c33448a02d16e91331bba2c6.1920x1080.jpg?t=1771104651","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2487710/8a28849cdd3bafb4c33448a02d16e91331bba2c6/ss_8a28849c