50/af6960c5f1b8a52c54b50c9ba7cc34ccc88665a1/ss_af6960c5f1b8a52c54b50c9ba7cc34ccc88665a1.600x338.jpg?t=1772461856"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3562250/46dd0645715216aeac80c25c07731bb0faa94194/ss_46dd0645715216aeac80c25c07731bb0faa94194.1920x1080.jpg?t=1772461856","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3562250/46dd0645715216aeac80c25c07731bb0faa94194/ss_46dd0645715216aeac80c25c07731bb0faa94194.600x338.jpg?t=1772461856"}],"short_description":"MIXCITY SWAP is a fresh and dynamic card game set in a futuristic world where athletes from all sports compete for the crowd\u2019s excitement. Build your team by selecting 9 unique athletes and be the first to score 5 KOs to win the match!","steam_appid":3562250,"support_info":{"email":"support@atypique-studio.com","url":"support@atypique-studio.com"},"supported_languages":"English<strong>*</strong>, French, Spanish - Spain, Portuguese - Portugal<br><strong>*</strong>languages with full audio support","type":"game","website":"https://mixcity-swap.com"}