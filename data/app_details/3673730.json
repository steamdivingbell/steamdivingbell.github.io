a15ead483e218cd04b0fa0bbee882baee38f210c/ss_a15ead483e218cd04b0fa0bbee882baee38f210c.1920x1080.jpg?t=1755914587","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673730/a15ead483e218cd04b0fa0bbee882baee38f210c/ss_a15ead483e218cd04b0fa0bbee882baee38f210c.600x338.jpg?t=1755914587"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673730/c828bac7cb0963e53edd52f5b3307166c5d18a3d/ss_c828bac7cb0963e53edd52f5b3307166c5d18a3d.1920x1080.jpg?t=1755914587","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3673730/c828bac7cb0963e53edd52f5b3307166c5d18a3d/ss_c828bac7cb0963e53edd52f5b3307166c5d18a3d.600x338.jpg?t=1755914587"}],"short_description":"Magic Maho: Dream Runner, a cute endless-style runner game about platforming and fighting monsters. Play as Maho, a magical girl stuck in an endless dream where she runs atop rooftops and is chased by monsters. Collect and use her magical staff to feed and defeat the monsters with pokies.","steam_appid":3673730,"support_info":{"email":"noah@ninostudios.com","url":"https://www.ninostudios.com/"},"supported_languages":"English","type":"game","website":null}