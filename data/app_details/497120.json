lass=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/497120/extras/6a068a0de18258fba2623a4984108f33.poster.avif?t=1761280009\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/497120/extras/6a068a0de18258fba2623a4984108f33.webm?t=1761280009\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/497120/extras/6a068a0de18258fba2623a4984108f33.mp4?t=1761280009\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >BE PART OF THE ACTION</h2><p class=\"bb_paragraph\" >Take your rightful place in the Arena and prove you\u2019re the ultimate Champion. Master unique playstyles, summon powerful allies, outthink your opponents with tactical deckbuilding, and dominate the battlefield in adrenaline-fueled 2v2 combat. The path to Wildcard victory is yours to claim - are you ready to take it?</p>","developers":["The Wildcard Alliance"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/497120/00705e67f561a321426e52f4ecfb98177990ff06/header.jpg?t=1761280009","is_free":true,"legal_notice":"\u00a9 2025 PLAYFUL, Corp. All rights reserved.","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/497120/1402650757/c18c9554b360820716c5c15e4273195924670e77/1760719993/dash_av1.mpd?t=1760720597","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/497120/1402650757/c18c9554b360820716c5c15e4273195924670e77/1760719993/dash_h264.mpd?t=1760720597","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/497120/1402650757/c18c9554b360820716c5c15e42731959