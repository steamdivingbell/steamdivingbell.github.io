ai.steamstatic.com/store_item_assets/steam/apps/3632740/b4c817fe6419aa8cada44330da52614e4b10d9e8/ss_b4c817fe6419aa8cada44330da52614e4b10d9e8.600x338.jpg?t=1758134453"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3632740/fdb00124b654518a97ca4dde1d538e31c75e31a2/ss_fdb00124b654518a97ca4dde1d538e31c75e31a2.1920x1080.jpg?t=1758134453","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3632740/fdb00124b654518a97ca4dde1d538e31c75e31a2/ss_fdb00124b654518a97ca4dde1d538e31c75e31a2.600x338.jpg?t=1758134453"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3632740/c6b0005113ab1e3e86c5f6958255e62ef260ea07/ss_c6b0005113ab1e3e86c5f6958255e62ef260ea07.1920x1080.jpg?t=1758134453","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3632740/c6b0005113ab1e3e86c5f6958255e62ef260ea07/ss_c6b0005113ab1e3e86c5f6958255e62ef260ea07.600x338.jpg?t=1758134453"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3632740/d45e5fbb17323a4cf079e996fec25c9fcdbe9345/ss_d45e5fbb17323a4cf079e996fec25c9fcdbe9345.1920x1080.jpg?t=1758134453","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3632740/d45e5fbb17323a4cf079e996fec25c9fcdbe9345/ss_d45e5fbb17323a4cf079e996fec25c9fcdbe9345.600x338.jpg?t=1758134453"}],"short_description":"You find yourself inside a cinema hallway, ready to watch your film. The venue, however, has other plans for you.","steam_appid":3632740,"support_info":{"email":"contact@manguezalgames.com","url":""},"supported_languages":"English<strong>*</strong>, Portuguese - Brazil, French, German<br><strong>*</strong>languages with full audio support","type":"game","website":null}