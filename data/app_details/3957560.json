7b099fc3ceb7e64645a5f/ss_bda019fc2b0fba0d5747b099fc3ceb7e64645a5f.600x338.jpg?t=1758055781"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3957560/b48e7ab54e899f674e036172154e358a17d19c2e/ss_b48e7ab54e899f674e036172154e358a17d19c2e.1920x1080.jpg?t=1758055781","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3957560/b48e7ab54e899f674e036172154e358a17d19c2e/ss_b48e7ab54e899f674e036172154e358a17d19c2e.600x338.jpg?t=1758055781"}],"short_description":"A fun cooperative action game for 1-4 players about escaping from a special clinic. Become a patient, take experimental drugs, get superpowers\u2026 And unpredictable side effects!","steam_appid":3957560,"support_info":{"email":"steam@twohornunicorn.com","url":""},"supported_languages":"English, Russian, French, German, Spanish - Spain, Simplified Chinese, Portuguese - Brazil, Japanese","type":"game","website":null}