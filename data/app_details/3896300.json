mg_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3896300/extras/187a557484213ad549eef2cf1d5808d4.poster.avif?t=1774465205\" width=800 height=486 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3896300/extras/187a557484213ad549eef2cf1d5808d4.webm?t=1774465205\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3896300/extras/187a557484213ad549eef2cf1d5808d4.mp4?t=1774465205\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Break into houses, grab valuables, and escape before the sirens catch up. Some loot is worth the risk. Some not so much.</p>","developers":["SifDev"],"dlc":[4506650],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3896300/745a728689cbfecd9347b900dab32f63aaa8107d/header.jpg?t=1774465205","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> SteamOS or Ubuntu 16.04 or 17.04<br></li><li><strong>Processor:</strong> 3GHz 4-Core or similar<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 750ti or RX 560<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> SteamOS or Ubuntu 16.04 or 17.04<br></li><li><strong>Processor:</strong> 3.5GHz 6-Core or similar<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GeForce RTX 1060 or Radeon RX 580<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>"},"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3896300/538