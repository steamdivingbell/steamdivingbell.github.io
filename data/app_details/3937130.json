ull":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3937130/67df78e7a884b34c3924c163e98b258ed7b428db/ss_67df78e7a884b34c3924c163e98b258ed7b428db.1920x1080.jpg?t=1765548195","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3937130/67df78e7a884b34c3924c163e98b258ed7b428db/ss_67df78e7a884b34c3924c163e98b258ed7b428db.600x338.jpg?t=1765548195"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3937130/6333ca91ef689dde7734cfef8a55d81c6934e149/ss_6333ca91ef689dde7734cfef8a55d81c6934e149.1920x1080.jpg?t=1765548195","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3937130/6333ca91ef689dde7734cfef8a55d81c6934e149/ss_6333ca91ef689dde7734cfef8a55d81c6934e149.600x338.jpg?t=1765548195"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3937130/a1d27e2697987cd006573808fa4dac38c6bb9c77/ss_a1d27e2697987cd006573808fa4dac38c6bb9c77.1920x1080.jpg?t=1765548195","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3937130/a1d27e2697987cd006573808fa4dac38c6bb9c77/ss_a1d27e2697987cd006573808fa4dac38c6bb9c77.600x338.jpg?t=1765548195"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3937130/58f4bf9570cd4e42e592fe0bc979064059fba109/ss_58f4bf9570cd4e42e592fe0bc979064059fba109.1920x1080.jpg?t=1765548195","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3937130/58f4bf9570cd4e42e592fe0bc979064059fba109/ss_58f4bf9570cd4e42e592fe0bc979064059fba109.600x338.jpg?t=1765548195"}],"short_description":"A retro-futuristic, sci-fi, turn-based management RPG. Become the CEO of an R&amp;D behemoth: hire scientists, woo investors, dabble in corporate espionage, and forge the science of tomorrow. Whether the technological wonders that emerge will save humanity\u2014or doom it\u2014is up to you.","steam_appid":3937130,"support_info":{"email":"glassbubble2017@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}