ai.steamstatic.com/store_item_assets/steam/apps/3634870/00c86490152c29c6860d0174579561401bd29563/ss_00c86490152c29c6860d0174579561401bd29563.600x338.jpg?t=1745657361"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/2459f7e21b804172c828e8544bbaa447e5e3dc13/ss_2459f7e21b804172c828e8544bbaa447e5e3dc13.1920x1080.jpg?t=1745657361","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/2459f7e21b804172c828e8544bbaa447e5e3dc13/ss_2459f7e21b804172c828e8544bbaa447e5e3dc13.600x338.jpg?t=1745657361"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/4061dda7b0df4fb4f3edebe8e974e51955bca11a/ss_4061dda7b0df4fb4f3edebe8e974e51955bca11a.1920x1080.jpg?t=1745657361","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/4061dda7b0df4fb4f3edebe8e974e51955bca11a/ss_4061dda7b0df4fb4f3edebe8e974e51955bca11a.600x338.jpg?t=1745657361"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/7c84fa07d3a15949d1015ea0cae66d8537a84459/ss_7c84fa07d3a15949d1015ea0cae66d8537a84459.1920x1080.jpg?t=1745657361","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/7c84fa07d3a15949d1015ea0cae66d8537a84459/ss_7c84fa07d3a15949d1015ea0cae66d8537a84459.600x338.jpg?t=1745657361"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/9209370a84d6ad4ffe94568f143635c48a5c2798/ss_9209370a84d6ad4ffe94568f143635c48a5c2798.1920x1080.jpg?t=1745657361","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/9209370a84d6ad4ffe94568f143635c48a5c2798/ss_9209370a84d6ad4ffe94568f143635c48a5c2798.600x338.jpg?t=1745657361"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3634870/f2740c2d1fe9aa0341f91a7da268691d68475884/ss_f2740c2d1fe9aa0341f91a7da268691d