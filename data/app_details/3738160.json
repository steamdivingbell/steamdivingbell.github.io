160/8e75bcf368edce05b4f158f36ddee6caf7101622/ss_8e75bcf368edce05b4f158f36ddee6caf7101622.600x338.jpg?t=1756781606"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3738160/8dd1c3cbe778cf56997d570d3a206ca29b229f1e/ss_8dd1c3cbe778cf56997d570d3a206ca29b229f1e.1920x1080.jpg?t=1756781606","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3738160/8dd1c3cbe778cf56997d570d3a206ca29b229f1e/ss_8dd1c3cbe778cf56997d570d3a206ca29b229f1e.600x338.jpg?t=1756781606"}],"short_description":"Matter of Factory is competitive chaos, packed with adventure! Compete against and sabotage your friends in a race to build more toys and make money!","steam_appid":3738160,"support_info":{"email":"BigMooseGamesOfficial@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}