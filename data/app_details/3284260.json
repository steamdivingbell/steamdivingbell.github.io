c762d8b75bc58.webm?t=1770650768\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3284260/extras/a3c7f878965b3231970c762d8b75bc58.mp4?t=1770650768\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Face hordes of enemies in local co-op battles and relive the glory of arcades with a modern, cinematic, action-packed presentation.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3284260/extras/a2e747feba5b80013f3f86680b526272.poster.avif?t=1770650768\" width=780 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3284260/extras/a2e747feba5b80013f3f86680b526272.webm?t=1770650768\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3284260/extras/a2e747feba5b80013f3f86680b526272.mp4?t=1770650768\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Key features:</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Two legendary heroes: play as Arthur or Lancelot, each with their own weapons and moves.</p></li><li><p class=\"bb_paragraph\" >Local co-op: fight alongside a friend in cooperative campaign mode.</p></li><li><p class=\"bb_paragraph\" >Stylized 2.5D visuals: 3D art with a pixelated filter that blends the new and the nostalgic.</p></li><li><p class=\"bb_paragraph\" >Classic beat 'em up reimagined: straightforward action, combos, spells, and colossal bosses.</p></li><li><p class=\"bb_paragraph\" >Mythical story: discover the adventures that precede the formation of the Round Table.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >With beautiful 3D environments featuring a retro pixel filter, Blades &amp; Battles is a love letter to the classics of the 90s, reinvented for a new generation of knights and indie game fans.</p>","developers":["QUByte Interactive"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3284260/d04f89bfc2ebc13ab26b3a52d8b5a4800b0eb296/header.jpg?t=1770650768","is_free":false,"legal_notice":"<strong>All Rights Reserved (C) 2024 QUByte Interactive. Mr. Dev Studio.</strong>","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3284260/2012014767/062c35c3cd3f35648ae12240b394d9fa9151476c/1761342545/dash_av1.mpd?t=1761857973","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3284260/2012014767/062c35c3cd3f35648ae12240b394d9fa9151476c/1761342545/dash_h264.mpd?t=1761857973","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3284260/2012014767/062c35c3cd3f35648ae12240b394d9fa9151476c/1761342545/hls_264_master.m3u8?t=1761857973","id":257222294,"name":"Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257222294/e9ee6caf9f7b9c0f0731b05e8b583a4bff4f595f/movie_600x337.jpg?t=1761857973"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3284260/750442953/a6a69730162b2fb03a9aa185aef2de1486aeaf50/1761589686/dash_av1.mpd?t=1761857975","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3284260/750442953/a6a69730162b2fb03a9aa185aef2de1486aeaf50/1761589686/dash_h264.mpd?t=1761857975","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3284260/750442953/a6a69730162b2fb03a9aa185aef2de1486aeaf50/1761589686/hls_264_master.m3u8?t=1761857975","id":257223293,"name":"New Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257223293/db80c50be513d4688ae5a73e7c6fd890e2405e03/movie_600x337.jpg?t=1761857975"}],"name":"Blades & Battles","package_groups":[],"pc_requirements":{"minim