e_item_assets/steam/apps/1976860/a3dbc304b3fe863a965f45a09b9cd65078650cc1/ss_a3dbc304b3fe863a965f45a09b9cd65078650cc1.1920x1080.jpg?t=1760300807","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1976860/a3dbc304b3fe863a965f45a09b9cd65078650cc1/ss_a3dbc304b3fe863a965f45a09b9cd65078650cc1.600x338.jpg?t=1760300807"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1976860/699f5baf48eae6e7e4a8e65669712add5c2f020a/ss_699f5baf48eae6e7e4a8e65669712add5c2f020a.1920x1080.jpg?t=1760300807","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1976860/699f5baf48eae6e7e4a8e65669712add5c2f020a/ss_699f5baf48eae6e7e4a8e65669712add5c2f020a.600x338.jpg?t=1760300807"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1976860/637085bcff41cf2f75d8c8ab7b6ddaf01e84d891/ss_637085bcff41cf2f75d8c8ab7b6ddaf01e84d891.1920x1080.jpg?t=1760300807","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1976860/637085bcff41cf2f75d8c8ab7b6ddaf01e84d891/ss_637085bcff41cf2f75d8c8ab7b6ddaf01e84d891.600x338.jpg?t=1760300807"}],"short_description":"Vanquish the Kaiser's Imperial Fleet using timing, tactics and telegraphy in MORSE, a minimalist strategy game that teaches you the lost language of Morse code. Can you change the world with the push of a button?","steam_appid":1976860,"support_info":{"email":"","url":"https://steamcommunity.com/app/1976860/discussions/0/3278068162666968533/"},"supported_languages":"English","type":"game","website":"https://alexvscoding.itch.io/morse"}