static.com/store_item_assets/steam/apps/4018410/161356df9eb4c244d32adc989c39a106f099a61b/ss_161356df9eb4c244d32adc989c39a106f099a61b.1920x1080.jpg?t=1759495349","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4018410/161356df9eb4c244d32adc989c39a106f099a61b/ss_161356df9eb4c244d32adc989c39a106f099a61b.600x338.jpg?t=1759495349"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4018410/a718ae133bd02ff27f2bd1af6108ba701e360b4d/ss_a718ae133bd02ff27f2bd1af6108ba701e360b4d.1920x1080.jpg?t=1759495349","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4018410/a718ae133bd02ff27f2bd1af6108ba701e360b4d/ss_a718ae133bd02ff27f2bd1af6108ba701e360b4d.600x338.jpg?t=1759495349"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4018410/20dc59f716377b9be37b27981d22cc89c718498a/ss_20dc59f716377b9be37b27981d22cc89c718498a.1920x1080.jpg?t=1759495349","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4018410/20dc59f716377b9be37b27981d22cc89c718498a/ss_20dc59f716377b9be37b27981d22cc89c718498a.600x338.jpg?t=1759495349"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4018410/9d920fc52e3decda0e7a53f82dcccfe2537e9434/ss_9d920fc52e3decda0e7a53f82dcccfe2537e9434.1920x1080.jpg?t=1759495349","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4018410/9d920fc52e3decda0e7a53f82dcccfe2537e9434/ss_9d920fc52e3decda0e7a53f82dcccfe2537e9434.600x338.jpg?t=1759495349"}],"short_description":"MECHANIS OBSCURA is an indie psychological escape-room thriller game, blending FMV cutscenes, 2000s horror vibes, and intricate puzzle mechanisms. After unknowingly enrolling in a deep-web trial, you have been abducted into a nightmarish escape room. No choices, only one reality remains...ESCAPE!","steam_appid":4018410,"support_info":{"email":"nobudgetstudiosofficial@