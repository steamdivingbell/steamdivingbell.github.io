=1773504439"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3354960/1bf936249ec299c09eba7a6e24a1b7da23ef6de8/ss_1bf936249ec299c09eba7a6e24a1b7da23ef6de8.1920x1080.jpg?t=1773504439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3354960/1bf936249ec299c09eba7a6e24a1b7da23ef6de8/ss_1bf936249ec299c09eba7a6e24a1b7da23ef6de8.600x338.jpg?t=1773504439"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3354960/81129072e286096ccc084e89e56cf28718c9ecf1/ss_81129072e286096ccc084e89e56cf28718c9ecf1.1920x1080.jpg?t=1773504439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3354960/81129072e286096ccc084e89e56cf28718c9ecf1/ss_81129072e286096ccc084e89e56cf28718c9ecf1.600x338.jpg?t=1773504439"}],"short_description":"Sandbox city building meets automation: Design unique buildings, create vibrant cities, and perfect production chains. Create a civilization that suits your style. Perfect for anyone who loves creativity and strategy!","steam_appid":3354960,"support_info":{"email":"bigcodersplanet@gmail.com","url":"https://bigcodersplanet.com/contact"},"supported_languages":"English<strong>*</strong>, French<strong>*</strong>, German<strong>*</strong>, Spanish - Spain<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://bigcodersplanet.com/"}