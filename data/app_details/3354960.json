_paragraph\" >Among other things, construction contracts, jobs and taxes influence quality of life.\u00a0 <br> <br>  <br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3354960/extras/6e907d74500242243220388f4369d353.avif?t=1773504439\" alt=\"A divider with the Empluna logo.\" width=1560 height=81 /></span></p></li></ul><p class=\"bb_paragraph\" style=\"text-align: center\">If you want to design cities, build houses, plan roads and play in a relaxed manner, <br> then Empluna is just the thing for you!</p><p class=\"bb_paragraph\" > <br> </p>","developers":["BigCodersPlanet"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3354960/fdf91941148cb14e91c3d0cc06722b12673ad294/header.jpg?t=1773504439","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3354960/1342815794/63a4e81c39ca59268bab229d38eb9d06ce653589/1773134580/dash_av1.mpd?t=1773504438","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3354960/1342815794/63a4e81c39ca59268bab229d38eb9d06ce653589/1773134580/dash_h264.mpd?t=1773504438","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3354960/1342815794/63a4e81c39ca59268bab229d38eb9d06ce653589/1773134580/hls_264_master.m3u8?t=1773504438","id":257117457,"name":"Empluna-Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257117457/beb0276de183105048a736fbb9656d1057c7b33d/movie_600x337.jpg?t=1773504438"}],"name":"Empluna","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Storage:</strong> 20 GB a