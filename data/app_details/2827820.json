ailers/2827820/711220/7aeefafaa9fc180fd741429dc229675aa82e7656/1750945285/hls_264_master.m3u8?t=1771233727","id":257029536,"name":"FGS Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257029536/f04a0ee964cf1c3942cfedbaaf62263111bd5c78/movie_600x337.jpg?t=1771233727"}],"name":"The Relic: First Guardian","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>Additional Notes:</strong> Specs TBC</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Perp Games"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Drastische Gewalt","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"26 May, 2026"},"required_age":0,"reviews":"\u201cStylish combat, tragic bosses, and a world inspired by Asian folklore combine to make The Relic: First Guardian one of the most exciting upcoming action RPGs\u2026and  just shot to the top of my Steam wishlist\u201d<br />\r\nPC Gamer<br />\r\n<br />\r\n\u201cIt has a unique art style and combat that looks spectacular.\u201d<br />\r\nDualShocker<br />\r\n<br />\r\n\u201cThe Witcher Meets Dark Souls in Gorgeous 2026 Action-RPG\u201d<br />\r\nGaming Bible<br />\r\n","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2827820/7780e098199ef9028e8e68f1f0531f2ac64fe8fe/ss_7780e098199ef9028e8e68f1f0531f2ac64fe8fe.1920x1080.jpg?t=1772191874","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2827820/7780e098199ef9028e8e68f1f0531f2ac64fe8fe/ss_7780e098199ef902