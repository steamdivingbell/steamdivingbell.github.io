f29cd6a31d1a.600x338.jpg?t=1772191874"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2827820/ss_983f253a1babd69d202405f84b49c49e1bec12b4.1920x1080.jpg?t=1772191874","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2827820/ss_983f253a1babd69d202405f84b49c49e1bec12b4.600x338.jpg?t=1772191874"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2827820/ss_72dcf0ee2073a5b21811837dece25f853fd204d0.1920x1080.jpg?t=1772191874","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2827820/ss_72dcf0ee2073a5b21811837dece25f853fd204d0.600x338.jpg?t=1772191874"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2827820/ss_990c5db741a636bda0c71364ea3b02425ee35a55.1920x1080.jpg?t=1772191874","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2827820/ss_990c5db741a636bda0c71364ea3b02425ee35a55.600x338.jpg?t=1772191874"}],"short_description":"Embark on a heroic fantasy adventure in this unique, Asian-inspired Action RPG.","steam_appid":2827820,"support_info":{"email":"","url":"https://perpgames.com/"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Korean<br><strong>*</strong>languages with full audio support","type":"game","website":"https://perpgames.com/game/relic/"}