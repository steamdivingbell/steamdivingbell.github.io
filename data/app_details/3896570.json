<p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3896570/extras/024e7c0958e9437f1a52d48b8a52f481.poster.avif?t=1757516674\" width=456 height=164 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3896570/extras/024e7c0958e9437f1a52d48b8a52f481.webm?t=1757516674\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3896570/extras/024e7c0958e9437f1a52d48b8a52f481.mp4?t=1757516674\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Plays entirely with the keyboard, or with a gamepad. Takes 2 to 4 hours to complete.</p>","developers":["PUNKCAKE Delicieux"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3896570/44dd2d0db6b1744642fd7e7135b5ea1591e17d14/header.jpg?t=1757516674","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3896570/927290271/2ced2f8e9fdc2656b864921be58efdfebdea3126/1757434006/dash_av1.mpd?t=1757516672","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3896570/927290271/2ced2f8e9fdc2656b864921be58efdfebdea3126/1757434006/dash_h264.mpd?t=1757516672","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3896570/927290271/2ced2f8e9fdc2656b864921be58efdfebdea3126/1757434006/hls_264_master.m3u8?t=1757516672","id":257195134,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257195134/movie480.mp4?t=1757516672","max":"https://video.akamai.steamstatic.com/store_trailers/257195134/movie_max.mp4?t=1757516672"},"name":"Frontline:  War of Echoes \ud83d\udea9trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/