span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >The show must go on!</h2><p class=\"bb_paragraph\" >You are only valuable to the prison if you generate revenue! As the show goes on, you need to fend for yourself and unlock as many helpful items as you can by completing side quests during your episode!</p>","developers":["Virtual Void Studio"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3379780/69d5c280fd16e7ae81b124db1e7c1bdd1be7652f/header.jpg?t=1764224470","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3379780/1592914154/cd4255ec1c3a27c4fd06e9fcbf357bcea34243c7/1754860247/dash_av1.mpd?t=1755460854","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3379780/1592914154/cd4255ec1c3a27c4fd06e9fcbf357bcea34243c7/1754860247/dash_h264.mpd?t=1755460854","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3379780/1592914154/cd4255ec1c3a27c4fd06e9fcbf357bcea34243c7/1754860247/hls_264_master.m3u8?t=1755460854","id":257181223,"name":"Dash_Dash_Dead_Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257181223/84aa399e248d19f2ff0d57d9e08ed13f970d286f/movie_600x337.jpg?t=1755460854"}],"name":"Dash Dash Dead","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong>  Zen 2<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li