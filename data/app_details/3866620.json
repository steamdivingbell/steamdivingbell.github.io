/3866620/88cd25ed7a702c378a2d336a5ec9e9efc99cd700/ss_88cd25ed7a702c378a2d336a5ec9e9efc99cd700.600x338.jpg?t=1756835531"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/906f50bc37ce1d1528d57e5dc236cd794f131325/ss_906f50bc37ce1d1528d57e5dc236cd794f131325.1920x1080.jpg?t=1756835531","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/906f50bc37ce1d1528d57e5dc236cd794f131325/ss_906f50bc37ce1d1528d57e5dc236cd794f131325.600x338.jpg?t=1756835531"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/6fa628e9102ec0fe0c9f0d10723e2c3192e9f67a/ss_6fa628e9102ec0fe0c9f0d10723e2c3192e9f67a.1920x1080.jpg?t=1756835531","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/6fa628e9102ec0fe0c9f0d10723e2c3192e9f67a/ss_6fa628e9102ec0fe0c9f0d10723e2c3192e9f67a.600x338.jpg?t=1756835531"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/e84f527ffa123c19c42e66d7168a83fc5e0b3c8e/ss_e84f527ffa123c19c42e66d7168a83fc5e0b3c8e.1920x1080.jpg?t=1756835531","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/e84f527ffa123c19c42e66d7168a83fc5e0b3c8e/ss_e84f527ffa123c19c42e66d7168a83fc5e0b3c8e.600x338.jpg?t=1756835531"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/763b43a13104447776cc0dc6d259ff41312e0c3d/ss_763b43a13104447776cc0dc6d259ff41312e0c3d.1920x1080.jpg?t=1756835531","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/763b43a13104447776cc0dc6d259ff41312e0c3d/ss_763b43a13104447776cc0dc6d259ff41312e0c3d.600x338.jpg?t=1756835531"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/9dd278b69a2ecdab737c001f4cf1aaf67d9b8be2/ss_9dd278b69a2ecdab737c001f4cf1aaf67d9b8be2.1920x1080.jpg?t=1756835531","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/9dd278b69a2ecdab737c001f4cf1aaf67d9b8be2/ss_9dd278b69a2ecdab737c001f4cf1aaf67d9b8be2.600x338.jpg?t=1756835531"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/ffdbfe497021e86182785b8007d21c61c7c5e88d/ss_ffdbfe497021e86182785b8007d21c61c7c5e88d.1920x1080.jpg?t=1756835531","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/ffdbfe497021e86182785b8007d21c61c7c5e88d/ss_ffdbfe497021e86182785b8007d21c61c7c5e88d.600x338.jpg?t=1756835531"}],"short_description":"A tense, procedurally generated dungeon crawler where your only advantage is the dark. Face relentless enemies and find a way to reclaim the light that was stolen.","steam_appid":3866620,"support_info":{"email":"calebtyson2006@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}