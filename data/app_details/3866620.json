b_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/extras/90ae289277f34e77774601db32d47d16.avif?t=1768255379\" width=800 height=225 /></span></p><h2 class=\"bb_tag\" ><strong>THE VILLAGE</strong></h2><p class=\"bb_paragraph\" >An endangered sanctuary at the heart of chaos; the residents just don't know it yet. Here, upgrade your weapons, refill your supplies, and recuperate before facing the horrors ahead. The four paths surrounding the village all lead into the unknown that grows restless.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/extras/ebd9348f4dcefcb1f3487314b4fa1597.avif?t=1768255379\" width=800 height=257 /></span></p>","developers":["Caleb Tyson"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3866620/807c2c7edd51259275a59e8727910880ae815669/header.jpg?t=1768255379","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3866620/971994400/98aea7a3fc4c8ae378da13b9507da81929033c34/1768254802/dash_av1.mpd?t=1768255377","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3866620/971994400/98aea7a3fc4c8ae378da13b9507da81929033c34/1768254802/dash_h264.mpd?t=1768255377","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3866620/971994400/98aea7a3fc4c8ae378da13b9507da81929033c34/1768254802/hls_264_master.m3u8?t=1768255377","id":257263827,"name":"v0.2 Update Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257263827/e08a1a4bd9ed5c0f9f27bc377599f7b85855f996/movie_600x337.jpg?t=1768255377"},{"dash_av1"