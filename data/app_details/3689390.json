760309068\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Craft arrows that suit your style, select your skills, and prepare for combat.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3689390/extras/14abf32749852d2360162670c625b13b.poster.avif?t=1760309068\" width=1140 height=738 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3689390/extras/14abf32749852d2360162670c625b13b.webm?t=1760309068\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3689390/extras/14abf32749852d2360162670c625b13b.mp4?t=1760309068\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Enjoy charming Korean-style anthropomorphic characters and beautifully rendered backgrounds.</p>","achievements":{"highlighted":[{"name":"DIY Arrows","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3689390/6e48012c3fc7d13fcf51fab1cd53a4fe424f4013.jpg"},{"name":"Master Archer","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3689390/7890cf1ccf1a9744764af10045446b60c1b6c756.jpg"},{"name":"Overflowing Supplies","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3689390/712a3a1d5aebedb16b80663508419ab796098cf9.jpg"},{"name":"Keeper\u2019s Duty","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3689390/666901f0867e2cd325497c1fa5cbcfa5ccb2dd06.jpg"},{"name":"Village Guard Captain","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3689390/256812abd7f99707f3ab3fa86fc0f8f2eb38b3ee.jpg"},{"name":"War Terminator","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/3689390/a178d95b462fe65caea677e4831ad1d64a60e4e5.jpg"},{"name":"Path of T