38.jpg?t=1747043775"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2337860/aba6b2d0a1e8ed17912557ecbef60291d30702e7/ss_aba6b2d0a1e8ed17912557ecbef60291d30702e7.1920x1080.jpg?t=1747043775","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2337860/aba6b2d0a1e8ed17912557ecbef60291d30702e7/ss_aba6b2d0a1e8ed17912557ecbef60291d30702e7.600x338.jpg?t=1747043775"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2337860/7ac8eda982021aaee5f31a04291a7944821937cd/ss_7ac8eda982021aaee5f31a04291a7944821937cd.1920x1080.jpg?t=1747043775","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2337860/7ac8eda982021aaee5f31a04291a7944821937cd/ss_7ac8eda982021aaee5f31a04291a7944821937cd.600x338.jpg?t=1747043775"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2337860/c20e77a8cf48c41c9e848fa47a640b07c4a26009/ss_c20e77a8cf48c41c9e848fa47a640b07c4a26009.1920x1080.jpg?t=1747043775","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2337860/c20e77a8cf48c41c9e848fa47a640b07c4a26009/ss_c20e77a8cf48c41c9e848fa47a640b07c4a26009.600x338.jpg?t=1747043775"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2337860/cf47b6118b85134c2edb8d452154d0ee5fd29929/ss_cf47b6118b85134c2edb8d452154d0ee5fd29929.1920x1080.jpg?t=1747043775","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2337860/cf47b6118b85134c2edb8d452154d0ee5fd29929/ss_cf47b6118b85134c2edb8d452154d0ee5fd29929.600x338.jpg?t=1747043775"}],"short_description":"As a true chaotic Nub warrior, your skills will be put to the ultimate test in a trap-filled arena. Arm yourself with a can-o-beanz, Burny-Hogz-Stick, or a fish as you battle your way to the top in short fast-paced multiplayer brawls.","steam_appid":2337860,"support_info":{"email":"community@playnubs.com","url":"https://playnubs.com"},"supported_languages":"English<strong>*</strong>, Simplified Chinese, French, German, Spanish - Spain, Dutch, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Traditional Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://playnubs.com/"}