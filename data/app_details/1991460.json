ec7667762e2451dc94a27561.poster.avif?t=1770530166\" width=1000 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/faedd476ec7667762e2451dc94a27561.webm?t=1770530166\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/a2a94d28966f3727ed7a329f484b5204.webp?t=1770530166\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/a2a94d28966f3727ed7a329f484b5204.poster.avif?t=1770530166\" class=\"bb_img\" width=1000 height=280 /></picture></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">Collecting resources is easy enough from the safety provided by town walls.<br>Beware of venturing in the wilderness unprepared.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/9aa694265b9d35d2ba03766738c35e0f.poster.avif?t=1770530166\" width=160 height=160 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/9aa694265b9d35d2ba03766738c35e0f.webm?t=1770530166\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/9e2342b131de353457ef3a9c6414a9fe.webp?t=1770530166\" width=616 height=1 /></span></p><h2 class=\"bb_tag\" >BUILD STRUCTURES!</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/cd13a72e9454a7f57934f50781aa7f29.poster.avif?t=1770530166\" width=1000 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/cd13a72e9454a7f57934f50781aa7f29.webm?t=1770530166\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/cd13a72e9454a7f57934f50781aa7f29.mp4?t=1770530166\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">Create your environment on demand! Building within towns can be limited by property ownership.<br>Players can buy, sell or lease plots within towns for item storage and other conveniences.  </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/ed489f1b71fb98f85986f8d2806787fa.poster.avif?t=1770530166\" width=1000 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/ed489f1b71fb98f85986f8d2806787fa.webm?t=1770530166\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/9e2342b131de353457ef3a9c6414a9fe.webp?t=1770530166\" width=616 height=1 /></span></p><h2 class=\"bb_tag\" >LEVEL SKILLS!</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/934f59dbeab521a25da466f5bb9db460.poster.avif?t=1770530166\" width=1000 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/934f59dbeab521a25da466f5bb9db460.webm?t=1770530166\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/934f59dbeab521a25da466f5bb9db460.mp4?t=1770530166\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">Level up your combat and non-combat skills to discover new magic,<br>or money making strategies.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/fb419f8f1d2bd55fe3fdc4aa1e9ccadb.apng?t=1770530166\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/fb419f8f1d2bd55fe3fdc4aa1e9ccadb.poster.avif?t=1770530166\" class=\"bb_img\" width=160 height=160 /></picture></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/9e2342b131de353457ef3a9c6414a9fe.webp?t=1770530166\" width=616 height=1 /></span></p><h2 class=\"bb_tag\" >WEAPONS &amp; ARMOR!</h2><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/ba55cdb7c6200084d11a316099b1d291.webp?t=1770530166\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/ba55cdb7c6200084d11a316099b1d291.poster.avif?t=1770530166\" class=\"bb_img\" width=1000 height=280 /></picture></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">Equip yourself for your battles freely<br>Each piece of worn equipment from helmet to boots is on display<br>Armor and weapons provide different bonuses<br>Metal armor will slow a mage down, so mages avoid that</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/1bb9fa5b0eb21bef302910558ecc8765.poster.avif?t=1770530166\" width=160 height=160 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/1bb9fa5b0eb21bef302910558ecc8765.webm?t=1770530166\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/9e2342b131de353457ef3a9c6414a9fe.webp?t=1770530166\" width=616 height=1 /></span></p><h2 class=\"bb_tag\" >TECHNICAL DETAILS!</h2><p class=\"bb_paragraph\" style=\"text-align: center\">Ygg Engine includes a client, server, and editor<br>Ygg Engine runs as a client and server, which can be limited to single-player or opened for multi-player\u00a0<br>Authoritative server design, actions are validated on the server to ensure fair gameplay</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/c183b1014c2c4fdf2082c137f54c20b6.apng?t=1770530166\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/extras/c183b1014c2c4fdf2082c137f54c20b6.poster.avif?t=1770530166\" class=\"bb_img\" width=160 height=160 /></picture></span></p>","developers":["Meganerd"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Massively Multiplayer","id":"29"},{"description":"RPG","id":"3"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991460/header.jpg?t=1770530166","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Storage:</strong> 1 GB available space<br></li><li><strong>Additional Notes:</strong> Resolution min 640x480. Recommended: 1920x1080 or higher</li></ul>","recom