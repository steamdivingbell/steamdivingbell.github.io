"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966510/55d90e3025cd3ae0fb5c280cf430d0a272a83444/ss_55d90e3025cd3ae0fb5c280cf430d0a272a83444.1920x1080.jpg?t=1757200075","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966510/55d90e3025cd3ae0fb5c280cf430d0a272a83444/ss_55d90e3025cd3ae0fb5c280cf430d0a272a83444.600x338.jpg?t=1757200075"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966510/8ceceac818f928ae5ec8c830d144fa6945c625a8/ss_8ceceac818f928ae5ec8c830d144fa6945c625a8.1920x1080.jpg?t=1757200075","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966510/8ceceac818f928ae5ec8c830d144fa6945c625a8/ss_8ceceac818f928ae5ec8c830d144fa6945c625a8.600x338.jpg?t=1757200075"}],"short_description":"Time to feed the dragon! If your island is to survive, you can\u2019t let its protector go hungry. And the hunger grows. Dragon Fodder is a balatroesque roguelite where you build, roll and fix dice, harvest, and cook. Hunt for broken combos, make the numbers go up, and survive 20 years.","steam_appid":3966510,"support_info":{"email":"capitaneus.moraviae@gmail.com","url":""},"supported_languages":"English, German, Spanish - Spain, Czech, Polish, Portuguese - Brazil","type":"game","website":null}