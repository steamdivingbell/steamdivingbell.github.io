ym or travel around multiple locations around the town and endulge in the local drinks and cuisine while you find the locals at their usual spots.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Give it a lash!</p>","developers":["BoopDood"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4032290/0fd1d201b46fa39e0b86e9b31fbbad78d3cc85c3/header.jpg?t=1773421006","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4032290/302986818/a240b98ab9d2568dd8bd5295f6071e28b7ff8d74/1766336247/dash_av1.mpd?t=1766338096","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4032290/302986818/a240b98ab9d2568dd8bd5295f6071e28b7ff8d74/1766336247/dash_h264.mpd?t=1766338096","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4032290/302986818/a240b98ab9d2568dd8bd5295f6071e28b7ff8d74/1766336247/hls_264_master.m3u8?t=1766338096","id":257253731,"name":"Exercise your Demons","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257253731/b90312b8aa9c26da4334a10bea38095d5af27cb0/movie_600x337.jpg?t=1766338096"}],"name":"Exercise your Demons","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Acla\u00edocht do Deamhain - $2.99 USD","packageid":1414544,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount"