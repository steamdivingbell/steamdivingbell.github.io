steamstatic.com/store_item_assets/steam/apps/4060180/0abb553e7128a55ec30716920f8ec4d9ee90ed71/ss_0abb553e7128a55ec30716920f8ec4d9ee90ed71.1920x1080.jpg?t=1762199539","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4060180/0abb553e7128a55ec30716920f8ec4d9ee90ed71/ss_0abb553e7128a55ec30716920f8ec4d9ee90ed71.600x338.jpg?t=1762199539"}],"short_description":"Complete the gallery of an eccentric millionaire, collect entities and objects from the Backroom, record their anomalies, expand their lores and uncover hidden rooms and secrets. Randomness, roguelite replayability, unique galleries and runs, horror, absurd humor... One mistake and you\u2019ll be doomed!","steam_appid":4060180,"support_info":{"email":"bearswipestudios@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Spanish - Spain<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://github.com/BearSwipeStudios/BackroomCollector-Credits-and-Attributions"}