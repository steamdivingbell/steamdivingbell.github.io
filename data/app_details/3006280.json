shared.akamai.steamstatic.com/store_item_assets/steam/apps/3006280/4831d844d1955dfde0f24212570f045aefeee411/ss_4831d844d1955dfde0f24212570f045aefeee411.600x338.jpg?t=1757489500"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3006280/9983d0f52b526c2c969ffca9cafbceafed672af7/ss_9983d0f52b526c2c969ffca9cafbceafed672af7.1920x1080.jpg?t=1757489500","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3006280/9983d0f52b526c2c969ffca9cafbceafed672af7/ss_9983d0f52b526c2c969ffca9cafbceafed672af7.600x338.jpg?t=1757489500"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3006280/7e5856c6d9f91ecdc57b71e6080a882144339c6a/ss_7e5856c6d9f91ecdc57b71e6080a882144339c6a.1920x1080.jpg?t=1757489500","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3006280/7e5856c6d9f91ecdc57b71e6080a882144339c6a/ss_7e5856c6d9f91ecdc57b71e6080a882144339c6a.600x338.jpg?t=1757489500"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3006280/57dea45dc490babed90fbee6685dab57811226f0/ss_57dea45dc490babed90fbee6685dab57811226f0.1920x1080.jpg?t=1757489500","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3006280/57dea45dc490babed90fbee6685dab57811226f0/ss_57dea45dc490babed90fbee6685dab57811226f0.600x338.jpg?t=1757489500"}],"short_description":"Sheepherds! is a cozy co-op party game where you and your sheepdog buddies guide colorful flocks through beautiful landscapes to collect their wool. There's no time limit: bark, run, and play together \u2014 or take on challenges to win even more rewards!","steam_appid":3006280,"support_info":{"email":"contact.ultimodisco@gmail.com","url":"https://ultimodiscogames.com/"},"supported_languages":"English, French","type":"game","website":null}