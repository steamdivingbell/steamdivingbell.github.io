dab57811226f0/ss_57dea45dc490babed90fbee6685dab57811226f0.600x338.jpg?t=1761729647"}],"short_description":"Sheepherds! is a cozy co-op party game where you and your sheepdog buddies guide colorful flocks through beautiful landscapes to collect their wool. There's no time limit: bark, run, and play together \u2014 or take on challenges to win even more rewards!","steam_appid":3006280,"support_info":{"email":"contact.ultimodisco@gmail.com","url":"https://ultimodiscogames.com/"},"supported_languages":"English, French, German, Russian, Japanese, Simplified Chinese, Traditional Chinese, Portuguese - Brazil, Korean, Spanish - Spain","type":"game","website":null}