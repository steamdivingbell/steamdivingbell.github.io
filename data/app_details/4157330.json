tem_assets/steam/apps/4157330/d5d9dcbfbfed3bd8a5d24fcf3455e64174159b68/ss_d5d9dcbfbfed3bd8a5d24fcf3455e64174159b68.1920x1080.jpg?t=1773737406","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4157330/d5d9dcbfbfed3bd8a5d24fcf3455e64174159b68/ss_d5d9dcbfbfed3bd8a5d24fcf3455e64174159b68.600x338.jpg?t=1773737406"}],"short_description":"Memorize the room. Spot the anomaly. Flip the switch. If you miss a detail, the loop resets. A psychological horror where your attention is the only weapon against a shifting reality. Can you break the cycle?","steam_appid":4157330,"support_info":{"email":"antoneveroff@gmail.com","url":"https://discord.gg/Xaanr6Wz"},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Japanese, Portuguese - Brazil, Russian, Traditional Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}