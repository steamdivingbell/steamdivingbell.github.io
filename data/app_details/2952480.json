" >A wealth of secrets that will test your code breaking skills and challenge you to put together the true story of the world around you. They could be hidden anywhere, even right here. Nowhere is off limits!</p></li><li><p class=\"bb_paragraph\" >Small in size, large in scale: designed to be small in file size, but offer tons of content; with millions of possible layouts, no two playthroughs will ever be the same</p></li></ul>","developers":["Willomena"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2952480/bc13019ab6fc32fe1eb6453da66f48da3ea36de5/header.jpg?t=1768695901","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 5.11<br></li><li><strong>Processor:</strong> Intel i5 4690<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GTX 960 (2GB+ of VRAM)<br></li><li><strong>Storage:</strong> 400 MB available space</li></ul>"},"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2952480/814203/699e172885799517b7d6bde7e3631cd5ff76ced7/1750952587/dash_av1.mpd?t=1737095499","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2952480/814203/699e172885799517b7d6bde7e3631cd5ff76ced7/1750952587/dash_h264.mpd?t=1737095499","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2952480/814203/699e172885799517b7d6bde7e3631cd5ff76ced7/1750952587/hls_264_master.m3u8?t=1737095499","id":257089808,"name":"Breakout: Official Launch Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257089808/c66f013e0cbe51068b4b20bfbeb0ba303ae19e9b/movie_600x337.jpg?t=1737095499"}],"name":"Breakout","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name"