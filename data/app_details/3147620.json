i.steamstatic.com/store_item_assets/steam/apps/3147620/ss_a90dc7bc738f1fa93b2345b4e68f1125fc3a12f1.600x338.jpg?t=1763838396"}],"short_description":"Alone in a hostile universe, you're the last of your kind. Team up in a crew of up to 4 players, gather vital resources, upgrade your gear, and defend your spacecraft with the help of intelligent robots. But beware, in the dark, something is watching - and it won't stop until it finds you.","steam_appid":3147620,"support_info":{"email":"help.pacebloom@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}