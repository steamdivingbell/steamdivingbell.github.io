570"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3739620/031ad5edf61322cb00960a8f82e2be93238c3699/ss_031ad5edf61322cb00960a8f82e2be93238c3699.1920x1080.jpg?t=1772963570","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3739620/031ad5edf61322cb00960a8f82e2be93238c3699/ss_031ad5edf61322cb00960a8f82e2be93238c3699.600x338.jpg?t=1772963570"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3739620/bc3d09a24002c5655b72ff189937b4e92c3e4876/ss_bc3d09a24002c5655b72ff189937b4e92c3e4876.1920x1080.jpg?t=1772963570","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3739620/bc3d09a24002c5655b72ff189937b4e92c3e4876/ss_bc3d09a24002c5655b72ff189937b4e92c3e4876.600x338.jpg?t=1772963570"}],"short_description":"A weekend getaway turns into a desperate fight for survival. In Midnight Escape, team up with 3 friends to explore a terrifying villa while hunted by a relentless creature. You must find clues, solve intricate puzzles, and find one of the multiple escape routes before the night claims you all.","steam_appid":3739620,"support_info":{"email":"moonlight.studio974@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://impress.games/press-kit/moonlight-studio/midnight-escape"}