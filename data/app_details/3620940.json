2/ss_d7b03e020bd6b71ce6d54d5dd9b7bae6c3bc3652.1920x1080.jpg?t=1759927083","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3620940/d7b03e020bd6b71ce6d54d5dd9b7bae6c3bc3652/ss_d7b03e020bd6b71ce6d54d5dd9b7bae6c3bc3652.600x338.jpg?t=1759927083"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3620940/fccefb0c60934f390343c27148fa66de6fa0f8a5/ss_fccefb0c60934f390343c27148fa66de6fa0f8a5.1920x1080.jpg?t=1759927083","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3620940/fccefb0c60934f390343c27148fa66de6fa0f8a5/ss_fccefb0c60934f390343c27148fa66de6fa0f8a5.600x338.jpg?t=1759927083"}],"short_description":"He\u2019s round. He\u2019s hungry. He\u2019s back! Help your feline friend eat all the sushi (and find love) in this bundle of squishy puzzle classics! This collection includes the original Sushi Cat, Sushi Cat The Honeymoon, Sushi Cat 2, The Great Purrade, Sushi Cat-a-Pult, and more...","steam_appid":3620940,"support_info":{"email":"support@armorgames.com","url":"https://armorgamesstudios.com/contact/"},"supported_languages":"English","type":"game","website":null}