 class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>High-Flying Action:</strong> Launch Sushi Cat and use limited bounces and special abilities to stay airborne and travel farther.</p></li><li><p class=\"bb_paragraph\" ><strong>Upgradeable Gadgets:</strong> Spend your earnings on hilarious and helpful items like magnets, bird seed, and launch power to improve your distance and score.</p></li><li><p class=\"bb_paragraph\" ><strong>Aim for the High Score:</strong> Compete with yourself to beat your best distance. Every run earns you more cash for upgrades, encouraging one more launch to shatter your record!</p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["Armor Games Studios"],"genres":[{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3620940/a3f66ec05c8567723bc407afb1be3bba0076db42/header.jpg?t=1759927083","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 2.0 GHz Dual Core<br></li><li><strong>Memory:</strong> 2 GB RAM</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 2.4 GHz Quad Core<br></li><li><strong>Memory:</strong> 4 GB RAM</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3620940/2045197574/282167b6c7c8c79fca4e59654459f1cb0c05c03d/1752684934/dash_av1.mpd?t=1756481910","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3620940/2045197574/282167b6c7c8c79fca4e59654459f1cb0c05c03d/1752684934/dash_h264.mpd?t=1756481910","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3620940/2045197574/282167b6c7c8c79fca4e59654459f1cb0c05c03d/1752684934/hls_264_master.m3u8?t=1756481910","id":257169812,"mp4":{"480":"