32eda31481e.600x338.jpg?t=1726370872"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_d710ce834d4b6472f75fcf97f6f0002242989d28.1920x1080.jpg?t=1726370872","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_d710ce834d4b6472f75fcf97f6f0002242989d28.600x338.jpg?t=1726370872"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_94b5068b85af6449b50509188de1f3889c045198.1920x1080.jpg?t=1726370872","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_94b5068b85af6449b50509188de1f3889c045198.600x338.jpg?t=1726370872"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_64a391a3c4656c184e93c7d5a10c18b9368edc1c.1920x1080.jpg?t=1726370872","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_64a391a3c4656c184e93c7d5a10c18b9368edc1c.600x338.jpg?t=1726370872"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_1c8b11f1a0d12dc2c322b939fb9686046049f215.1920x1080.jpg?t=1726370872","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_1c8b11f1a0d12dc2c322b939fb9686046049f215.600x338.jpg?t=1726370872"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_f1aba0534c86d2e410256dfadb7ec75078ff919e.1920x1080.jpg?t=1726370872","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_f1aba0534c86d2e410256dfadb7ec75078ff919e.600x338.jpg?t=1726370872"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_43dc17c58c10bcbef9a34ce74e0a95f614907faf.1920x1080.jpg?t=1726370872","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_43dc17c58c10bcbef9a34ce74e0a95f614907faf.600x338.jpg?t=1726370872"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_6c6ae4a94267005e22c50f29fdea9939fe59f3fb.1920x1080.jpg?t=1726370872","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1023550/ss_6c6ae4a94267005e22c50f29fdea9939fe59f3fb.600x338.jpg?t=1726370872"}],"short_description":"Bullet Hell Insanity + Tower Defense Strategy. Rogue Star Rescue is a quirky new type of rogue-like shooter. Blast your way through diverse planets while rescuing your teammates and gathering traps for your defense strategy. Play solo or online to stop the Rogue Star before it annihilates everything!","steam_appid":1023550,"support_info":{"email":"chuteapps.games@gmail.com","url":"http://roguestarrescue.com/"},"supported_languages":"English<strong>*</strong>, French<strong>*</strong>, Italian<strong>*</strong>, Spanish - Spain<strong>*</strong>, Japanese<strong>*</strong>, Russian<strong>*</strong>, Simplified Chinese<strong>*</strong>, Spanish - Latin America<strong>*</strong>, Portuguese - Portugal<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, German<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://www.chuteapps.com"}