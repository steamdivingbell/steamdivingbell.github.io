id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286430/d0192d88cecfc1285d41d3bf8f6cdd04516d84bb/ss_d0192d88cecfc1285d41d3bf8f6cdd04516d84bb.1920x1080.jpg?t=1750234547","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286430/d0192d88cecfc1285d41d3bf8f6cdd04516d84bb/ss_d0192d88cecfc1285d41d3bf8f6cdd04516d84bb.600x338.jpg?t=1750234547"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286430/047e047ad0e1150b486d5248d9330aebf19c10c9/ss_047e047ad0e1150b486d5248d9330aebf19c10c9.1920x1080.jpg?t=1750234547","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3286430/047e047ad0e1150b486d5248d9330aebf19c10c9/ss_047e047ad0e1150b486d5248d9330aebf19c10c9.600x338.jpg?t=1750234547"}],"short_description":"The Revenants is a turn-based strategy game inspired by ATOM RPG and XCOM. In the post-apocalypse world, there\u2019s only you, a bunch of survivors and hordes of monsters. Anything can end your life here, whether it's a disease or just a pack of rats. How long can you stay alive?","steam_appid":3286430,"support_info":{"email":"the_revenants@mail.ru","url":""},"supported_languages":"Russian, English, Simplified Chinese, Spanish - Spain, Portuguese - Brazil, Spanish - Latin America, Korean, Japanese","type":"game","website":null}