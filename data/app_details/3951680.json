x1080.jpg?t=1756139044","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3951680/eac659b6e5aa5507628ad7161330bc0e8b440104/ss_eac659b6e5aa5507628ad7161330bc0e8b440104.600x338.jpg?t=1756139044"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3951680/7f3090fd2ece809bbad4dcab908b8bad486fec2d/ss_7f3090fd2ece809bbad4dcab908b8bad486fec2d.1920x1080.jpg?t=1756139044","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3951680/7f3090fd2ece809bbad4dcab908b8bad486fec2d/ss_7f3090fd2ece809bbad4dcab908b8bad486fec2d.600x338.jpg?t=1756139044"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3951680/d4d2893c9b9dda0a42d0325af568b1c6348d03ee/ss_d4d2893c9b9dda0a42d0325af568b1c6348d03ee.1920x1080.jpg?t=1756139044","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3951680/d4d2893c9b9dda0a42d0325af568b1c6348d03ee/ss_d4d2893c9b9dda0a42d0325af568b1c6348d03ee.600x338.jpg?t=1756139044"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3951680/82113ad14efa2ea40f4f4010e42a54f161c25f41/ss_82113ad14efa2ea40f4f4010e42a54f161c25f41.1920x1080.jpg?t=1756139044","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3951680/82113ad14efa2ea40f4f4010e42a54f161c25f41/ss_82113ad14efa2ea40f4f4010e42a54f161c25f41.600x338.jpg?t=1756139044"}],"short_description":"A claustrophobic anomaly-horror game where you can only turn, blink, and decide: is it real or not? Survive five endings and uncover Mike\u2019s story.","steam_appid":3951680,"support_info":{"email":"alla@swytapp.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Simplified Chinese, Korean, Polish, Portuguese - Brazil, Turkish, Ukrainian, Japanese<br><strong>*</strong>languages with full audio support","type":"game","website":null}