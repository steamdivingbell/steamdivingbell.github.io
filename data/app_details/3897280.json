:"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897280/add88a7c30128350c8f42d41a875f8c7a24ba2df/ss_add88a7c30128350c8f42d41a875f8c7a24ba2df.1920x1080.jpg?t=1766575812","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897280/add88a7c30128350c8f42d41a875f8c7a24ba2df/ss_add88a7c30128350c8f42d41a875f8c7a24ba2df.600x338.jpg?t=1766575812"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897280/74d389d04dfac3973487468492e0a082329f1abd/ss_74d389d04dfac3973487468492e0a082329f1abd.1920x1080.jpg?t=1766575812","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897280/74d389d04dfac3973487468492e0a082329f1abd/ss_74d389d04dfac3973487468492e0a082329f1abd.600x338.jpg?t=1766575812"}],"short_description":"Welcome to Totopia! Soulsync with Atomons, explore vibrant cities, challenge quirky levels and fight the Bitrot crisis! Team with friends or go solo\u2014unlock endless party fun. Build your neighborhood, craft unique looks and rule your vibe. Join Atomons now, save Data Isles, and put Bitrot to an end!","steam_appid":3897280,"support_info":{"email":"help.projectatom@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}