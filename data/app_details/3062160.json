ssets/steam/apps/3062160/extras/f9932740d084eb3dabadf9d112f8017b.poster.avif?t=1755268940\" width=800 height=352 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3062160/extras/f9932740d084eb3dabadf9d112f8017b.webm?t=1755268940\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3062160/extras/f9932740d084eb3dabadf9d112f8017b.mp4?t=1755268940\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Strategic Decisions for Success</strong></h2><p class=\"bb_paragraph\" >Listen to customer complaints, offer tailored solutions, and make decisions that maximize profit. Think like a true business owner!</p><h2 class=\"bb_tag\" ><strong>Explore an Interactive Open World</strong></h2><p class=\"bb_paragraph\" >Visit scrapyards, hunt for rare parts, find market deals, or order premium components online. Build your dream workshop in a world full of endless possibilities!</p><p class=\"bb_paragraph\" ><strong>Build your dream garage and become the best in the industry!</strong></p><p class=\"bb_paragraph\" >Add Car Service Simulator to your wishlist now and don\u2019t miss this unique experience!</p>","developers":["Red Axe Games"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Racing","id":"9"},{"description":"Simulation","id":"28"},{"description":"Free To Play","id":"37"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3062160/bf64d8fd8c17274e0379e75c8904d1ff0454ad97/header.jpg?t=1755268940","is_free":true,"linux_requirements":[],"mac_requirements":[],"name":"Car Service Simulator : Prologue","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows (64-bit) 10<br></li><li><strong>Processor:</strong> Intel Core i5-3470 / AMD FX 4350<br></li><li><strong>Memory:</strong> 6 G