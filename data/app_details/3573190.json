eamstatic.com/store_item_assets/steam/apps/3573190/72842e081715c54c9cc13a096e32be55c935dfa3/ss_72842e081715c54c9cc13a096e32be55c935dfa3.600x338.jpg?t=1741307527"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3573190/8121e8173f2099cee3d99d16ba5f0b67200b008a/ss_8121e8173f2099cee3d99d16ba5f0b67200b008a.1920x1080.jpg?t=1741307527","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3573190/8121e8173f2099cee3d99d16ba5f0b67200b008a/ss_8121e8173f2099cee3d99d16ba5f0b67200b008a.600x338.jpg?t=1741307527"}],"short_description":"This is a relaxing 3D Japanese-style rural simulation business game! Your goal is to earn money by catching insects, fishing, picking flowers,and other activities while enjoying rural life. Use this money to buy stalls in the town, attract customers, and launch the town revitalization plan","steam_appid":3573190,"support_info":{"email":"2907868118@qq.com","url":"https://space.bilibili.com/33060921?spm_id_from=333.1007.0.0"},"supported_languages":"Simplified Chinese, English, Japanese","type":"game","website":null}