akamai.steamstatic.com/store_item_assets/steam/apps/2073620/65588a8c7e3c040b4ae4cb0b32831cf3859d3439/capsule_184x69.jpg?t=1768449900","categories":[{"description":"Multi-player","id":1},{"description":"MMO","id":20},{"description":"PvP","id":49},{"description":"Online PvP","id":36},{"description":"Co-op","id":9},{"description":"Online Co-op","id":38},{"description":"Steam Achievements","id":22},{"description":"Steam Trading Cards","id":29},{"description":"In-App Purchases","id":35}],"content_descriptors":{"ids":[5],"notes":"The game contains gun shooting and violent content."},"detailed_description":"<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/87702f5f194d480b1a68592776ec0eae.avif?t=1768449900\" width=1161 height=142 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/5bc899186bd7b5d1455df046f469fe78.poster.avif?t=1768449900\" width=1128 height=480 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/5bc899186bd7b5d1455df046f469fe78.webm?t=1768449900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/5bc899186bd7b5d1455df046f469fe78.mp4?t=1768449900\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Arena Breakout: Infinite is a high-stakes tactical extraction shooter where every decision matters. Fight, loot, and extract\u2014or lose it all. With stunningly realistic visuals, lifelike sound, and unforgiving PvPvE combat, every raid is a gamble between glory and ruin.</p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/3eabab65842d1b887cd9d4e2165ac7b1.webp?t=1768449900\" width=1158 height=38 /></span></h2><p class=\"bb_paragraph\" >Once a bustling aviation hub, Guoyapos International Airport has now become a hunting ground. With the highest carry-in value limit, the richest rewards, diverse indoor and outdoor combat scenarios, and all-new gameplay mechanics and extraction methods, the hunt begins the moment you step onto the airport grounds. </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/08afe6b27e366400e1a2f0f059bc5ca2.poster.avif?t=1768449900\" width=1170 height=496 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/08afe6b27e366400e1a2f0f059bc5ca2.webm?t=1768449900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/08afe6b27e366400e1a2f0f059bc5ca2.mp4?t=1768449900\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/03e9cd1a961b6f52d0ffa742c1911948.webp?t=1768449900\" width=410 height=38 /></span></p><p class=\"bb_paragraph\" >Northridge gets a snowy makeover, with snowfields blanketing the terrain. The snowy weather changes how you play: the sound of footsteps on snow, the footprints left behind, and the way snow affects visibility all add fresh challenges and excitement to every raid.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/29c612780fffcb20d38d572cd83add61.poster.avif?t=1768449900\" width=1170 height=496 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/29c612780fffcb20d38d572cd83add61.webm?t=1768449900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/29c612780fffcb20d38d572cd83add61.mp4?t=1768449900\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/9abcbf2ca1db9b4a19cb994707e194de.webp?t=1768449900\" width=330 height=38 /></span></h2><p class=\"bb_paragraph\" >New rare items can be found in raids. Join the battle to find more red items and fight your way out. A new collection room has been added to showcase the rare items you've acquired.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/ec14bcdcdb265799194b56b636e49834.poster.avif?t=1768449900\" width=1170 height=496 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/ec14bcdcdb265799194b56b636e49834.webm?t=1768449900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/ec14bcdcdb265799194b56b636e49834.mp4?t=1768449900\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/83637fb1d71e44f2dba85ab7a9f4beb9.webp?t=1768449900\" width=813 height=43 /></span> </h2><p class=\"bb_paragraph\" >Arena Breakout: Infinite respects the depth military fans crave while welcoming newcomers with the red carpet treatment. For military enthusiasts, our Ultimate Gunsmith System features over 900 weapon mods on over 20 attachment slots to allow you to create your ultimate weapon. For newcomers, we\u2019ve built in quality-of-life features that let you gear up in seconds.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/94c70e0752e9bab8d342d68cf5576e06.poster.avif?t=1768449900\" width=1170 height=496 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/94c70e0752e9bab8d342d68cf5576e06.webm?t=1768449900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/94c70e0752e9bab8d342d68cf5576e06.mp4?t=1768449900\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/f8d028846ef35cf4895643573c5d0ffe.webp?t=1768449900\" width=644 height=44 /></span></h2><p class=\"bb_paragraph\" >Arena Breakout: Infinite offers a variety of game modes for all operators - Tactical Ops, Solo Ops, Covert Ops and fast-paced 4v4 Deathmatch modes. Whether you prefer tactical teamwork or going in alone, you decide how you take on the fight.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/e780c4620801f77da0e60dedac1c03c6.poster.avif?t=1768449900\" width=1170 height=496 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/e780c4620801f77da0e60dedac1c03c6.webm?t=1768449900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/e780c4620801f77da0e60dedac1c03c6.mp4?t=1768449900\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/4f566ea5fabf4af8a5a1556229f2136f.webp?t=1768449900\" width=619 height=38 /></span> </p><p class=\"bb_paragraph\" >The Trophy Room is your off-field stronghold, where every upgrade and decoration tells your story. That rare sniper rifle, a stack of high-tier armor, or a collection of enemy dog tags - showcase all your hard-earned loot with pride!  Here, progression never stops and each season brings fresh challenges - complete weekly and seasonal tasks to unlock rewards that grow with your lethal reputation. The crown jewel? A free, top-tier 3X3 Titanium Case ensuring your most valuable loot stays safe no matter how tough the raid gets.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/599645d51671b6f23ca4c9b8548ee797.poster.avif?t=1768449900\" width=1128 height=480 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/599645d51671b6f23ca4c9b8548ee797.webm?t=1768449900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/599645d51671b6f23ca4c9b8548ee797.mp4?t=1768449900\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/8ec2df3d01c1bcb231671188b2206cdf.webp?t=1768449900\" width=544 height=38 /></span></h2><p class=\"bb_paragraph\" >In Arena Breakout: Infinite, fair combat is a guarantee with our ever-improving, anti-cheat system. This includes Killcam Replays that allow you to submit a one-tap report whenever you flag suspicious activity. Moreover, if you\u2019re confirmed to have lost a match due to cheating, automatic in-game compensation will hit your inventory.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/f709e172c1ef2aec55949ee134564d9c.poster.avif?t=1768449900\" width=1170 height=496 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/f709e172c1ef2aec55949ee134564d9c.webm?t=1768449900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/extras/f709e172c1ef2aec55949ee134564d9c.mp4?t=1768449900\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ></h2>","developers":["Morefun Studios"],"ext_user_account_notice":" LEVEL INFINITE PASS ","genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Massively Multiplayer","id":"29"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2073620/e21ebf1c59daac4b9d01fdca56684f3cd938981a/header.jpg?t=1768449900","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2073620/433171158/4adadc427224464d7a467bc08864760d15b9f280/1767093142/dash_av1.mpd?t=1767147979","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2073620/433171158/4adadc427224464d7a467bc08864760d15b9f280/1767093142/dash_h264.mpd?t=1767147979","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2073620/433171158/4adadc427224464d7a467bc08864760d15b9f280/1767093142/hls_264_master.m3u8?t=1767147979","id":257256977,"name":"S4-PV-EN","thumbnail":"https://shared.akamai.steamstatic.com/store_i