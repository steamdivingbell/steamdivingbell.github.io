</i> RPG with an amazing mix of original soundtracks and many different art styles. Explore new paths through this harmony of ideas.","developers":["Gabriel Maki"],"dlc":[2279780],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2246120/header.jpg?t=1761452578","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2246120/566335/644623a594d088dad22df28060aa1861ffccbcac/1751094881/dash_av1.mpd?t=1752182240","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2246120/566335/644623a594d088dad22df28060aa1861ffccbcac/1751094881/dash_h264.mpd?t=1752182240","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2246120/566335/644623a594d088dad22df28060aa1861ffccbcac/1751094881/hls_264_master.m3u8?t=1752182240","id":256946079,"name":"Coralina","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256946079/movie.293x165.jpg?t=1752182240"}],"name":"Coralina","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Coralina - $0.99 USD","packageid":805382,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":99}],"title":"Buy Coralina"}],"packages":[805382],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Microsoft Windows 7. (32bit/64bit)<br></li><li><strong>Processor:</strong> Intel N4100 (or similar) or better<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> DirectX 9/OpenGL 4.1 capable GPU<br></li><li><strong>Storage:</strong> 450