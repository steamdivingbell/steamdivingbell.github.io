a25754b2347b92df585f1a7202d8cddb8/ss_b5dc042a25754b2347b92df585f1a7202d8cddb8.1920x1080.jpg?t=1761247782","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3160570/b5dc042a25754b2347b92df585f1a7202d8cddb8/ss_b5dc042a25754b2347b92df585f1a7202d8cddb8.600x338.jpg?t=1761247782"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3160570/da0f121f7a104abe5b274dc52ae34938615f6524/ss_da0f121f7a104abe5b274dc52ae34938615f6524.1920x1080.jpg?t=1761247782","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3160570/da0f121f7a104abe5b274dc52ae34938615f6524/ss_da0f121f7a104abe5b274dc52ae34938615f6524.600x338.jpg?t=1761247782"}],"short_description":"Cast runes to summon the goddess of death, unleash eldritch horrors to fend off villagers, and wield dark magic in this unique tower defense. Balance your power between summoning and fortifying as waves of enemies close in. Can you complete the ritual before your defenses crumble?","steam_appid":3160570,"support_info":{"email":"info@joystickventures.com","url":"https://www.tlrgames.com/"},"supported_languages":"English, Spanish - Spain","type":"game","website":"https://www.tlrgames.com/signal.html"}