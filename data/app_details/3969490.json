apps/3969490/extras/0b5f843a330da9c2aa4b0124a93a6aeb.mp4?t=1772201193\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Solve increasingly complex spatial puzzles, experience wave-particle teleporter and relativistic time pickups - don't you worry: they are a mystery to everyone. Compete against other players on a worldwide leader board to see who can beat the levels in the quickest times.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Axiomatik brings elements of classic Arcade games into VR \u2013 neon graphics against black background and 8-bit synth sounds \u2013 with modern platforming and controls.</p>","developers":["J&J"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3969490/c1b316a1d83fead41c66f49546656a4ad2527ae4/header.jpg?t=1772201193","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3969490/1068135435/b233050e366b2b22d224dda8779c37c6277cf027/1768573777/dash_av1.mpd?t=1768574290","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3969490/1068135435/b233050e366b2b22d224dda8779c37c6277cf027/1768573777/dash_h264.mpd?t=1768574290","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3969490/1068135435/b233050e366b2b22d224dda8779c37c6277cf027/1768573777/hls_264_master.m3u8?t=1768574290","id":257209277,"name":"AxiomatikTrailerJan26","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257209277/985906f94b3b922345f52c201f971a797b95e8f3/movie_600x337.jpg?t=