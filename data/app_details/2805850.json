bd444ca4da92252c351df15bccc2232d386.1920x1080.jpg?t=1772882226","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2805850/01d36bd444ca4da92252c351df15bccc2232d386/ss_01d36bd444ca4da92252c351df15bccc2232d386.600x338.jpg?t=1772882226"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2805850/d9b51e7b7a5ea50e862153df9733051b2e0433ca/ss_d9b51e7b7a5ea50e862153df9733051b2e0433ca.1920x1080.jpg?t=1772882226","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2805850/d9b51e7b7a5ea50e862153df9733051b2e0433ca/ss_d9b51e7b7a5ea50e862153df9733051b2e0433ca.600x338.jpg?t=1772882226"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2805850/687bebc42b448a0b1f92c3e3afc93f5977764299/ss_687bebc42b448a0b1f92c3e3afc93f5977764299.1920x1080.jpg?t=1772882226","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2805850/687bebc42b448a0b1f92c3e3afc93f5977764299/ss_687bebc42b448a0b1f92c3e3afc93f5977764299.600x338.jpg?t=1772882226"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2805850/3ddecbacaa6e89caa2eb50804da40284f67a4b04/ss_3ddecbacaa6e89caa2eb50804da40284f67a4b04.1920x1080.jpg?t=1772882226","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2805850/3ddecbacaa6e89caa2eb50804da40284f67a4b04/ss_3ddecbacaa6e89caa2eb50804da40284f67a4b04.600x338.jpg?t=1772882226"}],"short_description":"Strategy game with turn based combat. Become an Elder, a master Sorcerer. Manipulate or conquer your way to godhood, mastering arcane spells and transforming armies. Achieve total domination or destroy the world itself.","steam_appid":2805850,"support_info":{"email":"contact@ironward.com","url":"www.ironward.com"},"supported_languages":"English<strong>*</strong>, Simplified Chinese, French, German, Japanese, Korean, Polish, Russian, Portuguese - Brazil<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.ironward.com/"}