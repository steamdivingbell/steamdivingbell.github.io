evenge.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339570/extras/febebd15f7ac33782ee7aa72dde586d2.poster.avif?t=1771063010\" width=600 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339570/extras/febebd15f7ac33782ee7aa72dde586d2.webm?t=1771063010\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339570/extras/febebd15f7ac33782ee7aa72dde586d2.mp4?t=1771063010\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u2022 WISHLIST!</p><p class=\"bb_paragraph\" >If you like what you see here, please feel free to WISHLIST now, Thanks so much!</p><p class=\"bb_paragraph\" ></p>","developers":["Rubicon Game Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339570/header.jpg?t=1771063010","is_free":false,"legal_notice":"Copyright 2025 Webpeak Technologies, Ltd. DBA Rubicon Game Studios. All Rights Reserved.","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3339570/1972288/6f096ca178e3e5752219d088584dba3e97b483d2/1753478850/dash_av1.mpd?t=1753480512","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3339570/1972288/6f096ca178e3e5752219d088584dba3e97b483d2/1753478850/dash_h264.mpd?t=1753480512","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3339570/1972288/6f096ca178e3e5752219d088584dba3e97b483d2/1753478850/hls_264_master.m3u8?t=1753480512","id":257174142,"name":"Adrenaline Overdrive Demo Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257174142/6e0b580305f1633e015