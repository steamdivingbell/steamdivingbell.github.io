/steam/apps/2396130/19217b706bf973fca8b917c10207018c43388eac/ss_19217b706bf973fca8b917c10207018c43388eac.600x338.jpg?t=1771943174"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2396130/d2a8bd9abd62107aa2abd5f28bd2823026d8fc22/ss_d2a8bd9abd62107aa2abd5f28bd2823026d8fc22.1920x1080.jpg?t=1771943174","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2396130/d2a8bd9abd62107aa2abd5f28bd2823026d8fc22/ss_d2a8bd9abd62107aa2abd5f28bd2823026d8fc22.600x338.jpg?t=1771943174"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2396130/4fbe7982e20d89631ab371fdc6b0014b2f3ed8f6/ss_4fbe7982e20d89631ab371fdc6b0014b2f3ed8f6.1920x1080.jpg?t=1771943174","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2396130/4fbe7982e20d89631ab371fdc6b0014b2f3ed8f6/ss_4fbe7982e20d89631ab371fdc6b0014b2f3ed8f6.600x338.jpg?t=1771943174"}],"short_description":"Join our mercenary team: high-risk, low-benefit positions available! Defend cargo trains in this innovative Turn-Based Tower Defense meets Reverse Bullet Hell. Deploy units, merge them to create powerful new types and variations, withstand relentless waves, deliver the goods.","steam_appid":2396130,"support_info":{"email":"community@mysticforge.com","url":"https://mysticforge.com/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Arabic, Dutch, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Thai, Traditional Chinese","type":"game","website":null}