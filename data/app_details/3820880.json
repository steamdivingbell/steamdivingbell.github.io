:"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820880/868c8d699d46a0427566bd5865108f8158dff8e8/ss_868c8d699d46a0427566bd5865108f8158dff8e8.1920x1080.jpg?t=1759335165","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820880/868c8d699d46a0427566bd5865108f8158dff8e8/ss_868c8d699d46a0427566bd5865108f8158dff8e8.600x338.jpg?t=1759335165"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820880/b9f5e7dd6a387eae81224fcc4b7d39cc94498b90/ss_b9f5e7dd6a387eae81224fcc4b7d39cc94498b90.1920x1080.jpg?t=1759335165","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820880/b9f5e7dd6a387eae81224fcc4b7d39cc94498b90/ss_b9f5e7dd6a387eae81224fcc4b7d39cc94498b90.600x338.jpg?t=1759335165"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820880/209b7367840bb361fee774d14860b3e765458e28/ss_209b7367840bb361fee774d14860b3e765458e28.1920x1080.jpg?t=1759335165","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820880/209b7367840bb361fee774d14860b3e765458e28/ss_209b7367840bb361fee774d14860b3e765458e28.600x338.jpg?t=1759335165"}],"short_description":"A village trapped in fear and snow. Leap and climb across rooftops to avoid danger. When the curse shifts, choose a powerful ability card to turn the tide. Avoid the monster and collect three relics to escape in this intense asymmetric multiplayer battle.","steam_appid":3820880,"support_info":{"email":"info@terralithic.com","url":"www.terralithic.com"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Simplified Chinese, Traditional Chinese, Japanese, Korean, Spanish - Latin America, Polish, Russian, Turkish, Greek, Portuguese - Portugal<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.terralithic.com/"}