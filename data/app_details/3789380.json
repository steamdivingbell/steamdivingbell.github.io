oom!</i> is here to test your skills and your sanity!</p>","developers":["Ravi Gyani","R K Gyani"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3789380/1ea39c93abe0f3d6a5436c6bacc2b5f5d7b8eb26/header.jpg?t=1767295891","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3789380/266509528/f6d1e25894ebd127f56028fdf90463b536c39126/1750376773/dash_av1.mpd?t=1749143921","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3789380/266509528/f6d1e25894ebd127f56028fdf90463b536c39126/1750376773/dash_h264.mpd?t=1749143921","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3789380/266509528/f6d1e25894ebd127f56028fdf90463b536c39126/1750376773/hls_264_master.m3u8?t=1749143921","id":257149055,"name":"Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257149055/f1ae10053cd8043d7585eba1ecf8c531b5de9f92/movie_600x337.jpg?t=1749143921"}],"name":"Dhadoom!","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Dhadoom! - $9.99 USD","packageid":1333052,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":999}],"title":"Buy Dhadoom!"}],"packages":[1333052],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor 