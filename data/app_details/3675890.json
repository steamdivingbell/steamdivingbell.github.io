565621291fc3424150ecfbc6eddbe9388b3084/ss_ac565621291fc3424150ecfbc6eddbe9388b3084.1920x1080.jpg?t=1769796183","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3675890/ac565621291fc3424150ecfbc6eddbe9388b3084/ss_ac565621291fc3424150ecfbc6eddbe9388b3084.600x338.jpg?t=1769796183"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3675890/2ecd1b88b912bb0cd7081527afee54f1f6f3c901/ss_2ecd1b88b912bb0cd7081527afee54f1f6f3c901.1920x1080.jpg?t=1769796183","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3675890/2ecd1b88b912bb0cd7081527afee54f1f6f3c901/ss_2ecd1b88b912bb0cd7081527afee54f1f6f3c901.600x338.jpg?t=1769796183"}],"short_description":"Story-driven role-playing game in retro JRPG style with an active-time-battle-wait system with a rock soundtrack. The higher a character's AGI value, the faster their turn. Earn &quot;SP&quot; in battle and learn new skills. Increase their level by using them, improving their loading time and attributes.","steam_appid":3675890,"support_info":{"email":"Marco.Close@ruhr-uni-bochum.de","url":""},"supported_languages":"German","type":"game","website":null}