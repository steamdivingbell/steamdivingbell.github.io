40-50 hours of gameplay, you'll unlock new TP modes, mostly story-driven. These allow you to decide how your characters earn technique points (TP) to use techniques in battle. Adapt the TP modes to your play style and your group.<br><br><strong><i>In-game translation into English is available via \u201cOptions.\u201d Skills and quest-journal texts are currently only available in German.</i></strong></p>","developers":["Marco Close"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3675890/e14c3f23db94605f2532d6e25369c561f6de0464/header.jpg?t=1769796183","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> <br></li><li><strong>Processor:</strong> <br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Additional Notes:</strong> </li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Storage:</strong> 2200 MB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3675890/742789393/6e0f7d7731309e73f80971afa060f6adf3ba4e27/1750398174/dash_av1.mpd?t=1747686771","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3675890/742789393/6e0f7d7731309e73f80971afa060f6adf3ba4e27/1750398174/dash_h264.mpd?t=1747686771","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3675890/742789393/6e0f7d7731309e73f80971afa060f6adf3ba4e27/1750398174/hls_264_master.m3u8?t=1747686771","id":257140955,"name":"Trailer Englisch","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257140955/b538ab95c8894f1a1073adac710f39d159a2f557/movie_600x337.jpg?t=1747686771"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3675890/1582397559/dd33d3f80d838bcc2049003596c758ae06f09771/1750398511/dash_av1.mpd?t=1747496509","dash_h264":"htt