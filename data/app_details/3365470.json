ain on your windshield.</p></li><li><p class=\"bb_paragraph\"><strong>Custom Music</strong> :\u00a0Load up your own songs and drive to your perfect playlist.</p></li><li><p class=\"bb_paragraph\"><strong>Leaderboards\u00a0</strong>: Chase high scores on global and friends' leaderboards.</p></li><li><p class=\"bb_paragraph\"><strong>Cool Vibes\u00a0</strong>: Brings back fond memories of simpler times.\u00a0</p></li></ul><p class=\"bb_paragraph\"></p>","developers":["Runebox Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Racing","id":"9"},{"description":"Simulation","id":"28"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3365470/header.jpg?t=1745049356","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257127989,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127989/movie480.mp4?t=1745049354","max":"http://video.akamai.steamstatic.com/store_trailers/257127989/movie_max.mp4?t=1745049354"},"name":"Release Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257127989/b324acf38445696110f9d394011461f6158855b8/movie_600x337.jpg?t=1745049354","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127989/movie480_vp9.webm?t=1745049354","max":"http://video.akamai.steamstatic.com/store_trailers/257127989/movie_max_vp9.webm?t=1745049354"}},{"highlight":true,"id":257076302,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257076302/movie480.mp4?t=1733412774","max":"http://video.akamai.steamstatic.com/store