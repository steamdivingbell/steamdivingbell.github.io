/ss_bd4a2b9e3b4a7365cd7c0223c6d130f84ef8514e.600x338.jpg?t=1765210850"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3558770/ce22b939b55f85a1ea734577f0e866c7ba30f09e/ss_ce22b939b55f85a1ea734577f0e866c7ba30f09e.1920x1080.jpg?t=1765210850","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3558770/ce22b939b55f85a1ea734577f0e866c7ba30f09e/ss_ce22b939b55f85a1ea734577f0e866c7ba30f09e.600x338.jpg?t=1765210850"}],"short_description":"A fast-paced top-down team shooter. The arena is split in half, limiting direct hero contact. Use a harpoon to pull enemies to your side and finish them with teammates! Accuracy and cold calculation will lead you to victory. Just avoid other harpoons flying from all directions...","steam_appid":3558770,"support_info":{"email":"contact@fairgoose.com","url":"https://fairgoose.com/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Arabic, Bulgarian, Czech, Danish, Dutch, Finnish, Greek, Hungarian, Indonesian, Japanese, Korean, Norwegian, Polish, Portuguese - Brazil, Portuguese - Portugal, Romanian, Russian, Simplified Chinese, Spanish - Latin America, Swedish, Thai, Traditional Chinese, Turkish, Vietnamese, Ukrainian","type":"game","website":null}