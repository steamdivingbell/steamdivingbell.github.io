27700/extras/26ef6b462204851032c7f7ad01e0f47a.poster.avif?t=1767450536\" width=888 height=500 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2627700/extras/26ef6b462204851032c7f7ad01e0f47a.webm?t=1767450536\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2627700/extras/26ef6b462204851032c7f7ad01e0f47a.mp4?t=1767450536\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2627700/extras/139b8199922834c1b872c2beb235368f.avif?t=1767450536\" width=585 height=74 /></span></p><p class=\"bb_paragraph\" >Run your own blacksmith shop: set up displays and manage inventory. Upgrade your store and decorate your storefront to attract more customers.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2627700/extras/582734814cb05387b9d82e6f3f609a69.poster.avif?t=1767450536\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2627700/extras/582734814cb05387b9d82e6f3f609a69.webm?t=1767450536\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2627700/extras/582734814cb05387b9d82e6f3f609a69.mp4?t=1767450536\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2627700/extras/fa0fbbc9eb3c9ff116bb0dac43a77fb1.avif?t=1767450536\" width=585 height=74 /></span></p><p class=\"bb_paragraph\" >Mine, hunt, cut down trees, forage, and fish. Discover new biomes, gather precious resources, and turn them into tools that help Grandall thrive.</p><p class