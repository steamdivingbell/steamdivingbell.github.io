b_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3331120/extras/a471010a1214d8bb16d08116da694f1e.poster.avif?t=1760668427\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3331120/extras/a471010a1214d8bb16d08116da694f1e.webm?t=1760668427\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Eecrypt</h2><p class=\"bb_paragraph\" >Each area has decryption elements that match its style, solving puzzles and obtaining items that make characters stronger.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Please help Slei Dog leave this planet and explore various regions to its fullest!</p>","developers":["Cow Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3331120/header.jpg?t=1760668427","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3331120/805401/45ee65dd1782d9a3e8f041f2e537fa49b75a703f/1750869861/dash_av1.mpd?t=1735410248","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3331120/805401/45ee65dd1782d9a3e8f041f2e537fa49b75a703f/1750869861/dash_h264.mpd?t=1735410248","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3331120/805401/45ee65dd1782d9a3e8f041f2e537fa49b75a703f/1750869861/hls_264_master.m3u8?t=1735410248","id":257085251,"name":"PV1","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257085251/0c684a0d59084c078a710f18f7f719e068b51d26/movie_600x337.jpg?t=1735410248"}],"name":"\u53f2\u83b1\u72d7(Slimg)","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"