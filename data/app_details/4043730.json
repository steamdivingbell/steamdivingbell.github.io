99dfde829768d5c104.mp4?t=1771882731\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/extras/9956e88964d86006ed894b43cfb1d3de.avif?t=1771882731\" width=630 height=71 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The sun is setting. Every corridor you clear brings you closer to the heart of the nightmare. When Nightrise comes, it will all be over \u2014 One way or another.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/extras/e0b4e911948aed8dfc512b49e5226f71.poster.avif?t=1771882731\" width=630 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/extras/e0b4e911948aed8dfc512b49e5226f71.webm?t=1771882731\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/extras/e0b4e911948aed8dfc512b49e5226f71.mp4?t=1771882731\" type=\"video/mp4\"></video></span></p>","developers":["Treetop"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/0a128e5958d64a733b9e658f42433f44cf29b027/header.jpg?t=1771882731","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4043730/1017123628/a3b479910930b8b225bd806caebbf30ff0c55203/1771439845/dash_av1.mpd?t=1771644495","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4043730/1017123628/a3b479910930b8b225bd806caebbf30ff0c55203/1771439845/dash_h264.mpd?t=1771644495","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4043730/1017123628/a3b479910930b8b225bd806caebbf30ff0c55203/1771439845/hls_264_master.m3u8?t=1771644495","id":257289617,"name":"Demo Release Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257289617/6efb1b43d3cda778e2a353986aac2941e1bfc549/movie_600x337.jpg?t=1771644495"}],"name":"Vampire Hunter: Nightrise","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> WIndows 10<br></li><li><strong>Processor:</strong> AMD Ryzen 5 3600 / Intel Core i5-9600K or equivalent<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1060 (6GB) / AMD Radeon RX 580 (8GB) / Intel Arc A380 or equivalent<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 1 GB available space<br></li><li><strong>Additional Notes:</strong> Designed to run at 1080p, Low settings</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Treetop"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia\nMedo","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Horror","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"6 Apr, 2026"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/c904eb39f86bb26615158b458b9b23d3237c2e8b/ss_c904eb39f86bb26615158b458b9b23d3237c2e8b.1920x1080.jpg?t=1771882731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/c904eb39f86bb26615158b458b9b23d3237c2e8b/ss_c904eb39f86bb26615158b458b9b23d3237c2e8b.600x338.jpg?t=1771882731"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/76030048c5105eeffcd99d0a5fe0626519ccb642/ss_76030048c5105eeffcd99d0a5fe0626519ccb642.1920x1080.jpg?t=1771882731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/76030048c5105eeffcd99d0a5fe0626519ccb642/ss_76030048c5105eeffcd99d0a5fe0626519ccb642.600x338.jpg?t=1771882731"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/4c4ee47971c3432add8f948f1c0eee20b5075ed0/ss_4c4ee47971c3432add8f948f1c0eee20b5075ed0.1920x1080.jpg?t=1771882731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/4c4ee47971c3432add8f948f1c0eee20b5075ed0/ss_4c4ee47971c3432add8f948f1c0eee20b5075ed0.600x338.jpg?t=1771882731"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/01ffa8b87aeaef56bf4a6757b007e3921b7a5f5b/ss_01ffa8b87aeaef56bf4a6757b007e3921b7a5f5b.1920x1080.jpg?t=1771882731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/01ffa8b87aeaef56bf4a6757b007e3921b7a5f5b/ss_01ffa8b87aeaef56bf4a6757b007e3921b7a5f5b.600x338.jpg?t=1771882731"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/3ba97fd88e641c759215de489f872f563b9384cc/ss_3ba97fd88e641c759215de489f872f563b9384cc.1920x1080.jpg?t=1771882731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/3ba97fd88e641c759215de489f872f563b9384cc/ss_3ba97fd88e641c759215de489f872f563b9384cc.600x338.jpg?t=1771882731"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/2a168d7799afd68921d16513700d30ad424a2fde/ss_2a168d7799afd68921d16513700d30ad424a2fde.1920x1080.jpg?t=1771882731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043730/2a168d7799afd68921d16513700d30ad424a2fde/ss_2a168d7799afd68921d16513700d30ad424a2fde.600x338.jpg?t=1771882731"}],"short_description":"You came to hunt a vampire. Instead, you're trapped in his sprawling Gothic castle. You must hold on to your dwindling faith and dismantle his defenses before Nightrise \u2014 or become his prey in this single, story-driven experience.","steam_appid":4043730,"support_info":{"email":"TreetopGameHelp@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}