.1920x1080.jpg?t=1755018246","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3664510/6f46752b2a36d729af6de0d79ff02c022041ee5c/ss_6f46752b2a36d729af6de0d79ff02c022041ee5c.600x338.jpg?t=1755018246"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3664510/28800f672c6f4907f04c28211e17bf571a6d2266/ss_28800f672c6f4907f04c28211e17bf571a6d2266.1920x1080.jpg?t=1755018246","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3664510/28800f672c6f4907f04c28211e17bf571a6d2266/ss_28800f672c6f4907f04c28211e17bf571a6d2266.600x338.jpg?t=1755018246"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3664510/77468185c9f05aa14a75b4ea71212b11443888f9/ss_77468185c9f05aa14a75b4ea71212b11443888f9.1920x1080.jpg?t=1755018246","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3664510/77468185c9f05aa14a75b4ea71212b11443888f9/ss_77468185c9f05aa14a75b4ea71212b11443888f9.600x338.jpg?t=1755018246"}],"short_description":"Join Cliff Hanger, the elephant with the unique ability to latch on and become weightless! Use drawings from an old fairy tale book to create your own climbing paths, conquer tricky sections, and collect peanuts to unlock new levels.","steam_appid":3664510,"support_info":{"email":"sculptyfix@gmail.com","url":""},"supported_languages":"English, French, German","type":"game","website":null}