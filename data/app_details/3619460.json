838b6422ecd.600x338.jpg?t=1772082793"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619460/16f0b5f8153ca2d7d8850a8c5f31e9a83379b66d/ss_16f0b5f8153ca2d7d8850a8c5f31e9a83379b66d.1920x1080.jpg?t=1772082793","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619460/16f0b5f8153ca2d7d8850a8c5f31e9a83379b66d/ss_16f0b5f8153ca2d7d8850a8c5f31e9a83379b66d.600x338.jpg?t=1772082793"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619460/12776fccf986ebd423b177382c452c371a640893/ss_12776fccf986ebd423b177382c452c371a640893.1920x1080.jpg?t=1772082793","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619460/12776fccf986ebd423b177382c452c371a640893/ss_12776fccf986ebd423b177382c452c371a640893.600x338.jpg?t=1772082793"}],"short_description":"Otherworld Chronicles is a Lovecraftian narrative puzzle game set in a dark fantasy world. In a forgotten land where power and war never ceased, you are chosen as a savior, unraveling mysteries, ascending the tower, and drawing closer to a long-buried truth that has waited to be revealed.","steam_appid":3619460,"support_info":{"email":"service@eegams.com","url":""},"supported_languages":"Simplified Chinese, Traditional Chinese, English","type":"game","website":"https://www.eegames.com/Games/GameDetails?gameId=200002"}