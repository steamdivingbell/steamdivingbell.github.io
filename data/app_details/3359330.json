 full release later this year! And join our discord for all the latest announcements!<br><br><strong><i>All aboard!</i></strong></p>","developers":["Densetsu Creative LLC"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3359330/header_alt_assets_0.jpg?t=1740425543","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257075717,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257075717/movie480.mp4?t=1734942732","max":"http://video.akamai.steamstatic.com/store_trailers/257075717/movie_max.mp4?t=1734942732"},"name":"Crystal Rail Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257075717/6099131506627ed2009272289f032d001663ec93/movie_600x337.jpg?t=1734942732","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257075717/movie480_vp9.webm?t=1734942732","max":"http://video.akamai.steamstatic.com/store_trailers/257075717/movie_max_vp9.webm?t=1734942732"}},{"highlight":true,"id":257093287,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257093287/movie480.mp4?t=1738203664","max":"http://video.akamai.steamstatic.com/store_trailers/257093287/movie_max.mp4?t=1738203664"},"name":"Meet the Tarpan","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257093287/1d7dc7fa62f28f5562a6399d7d2fa1c95f86796c/movie_600x337.jpg?t=1738203664","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257093287/movie480_vp9.webm?t=1738203664","max":"http://video.akamai.steamstatic.com/store_trailers/257093287/movie_max_vp9.webm?t=1738203664