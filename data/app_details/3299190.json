r, and more.</p><p class=\"bb_paragraph\">A TOTAL experience.</p>","developers":["Eternity Dev"],"dlc":[3467970],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3299190/header.jpg?t=1742717996","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 16 or superior<br></li><li><strong>Processor:</strong> Universal (32 or 64)<br></li><li><strong>Memory:</strong> 3 GB RAM<br></li><li><strong>Graphics:</strong> AMD Mobility Radeon HD<br></li><li><strong>Storage:</strong> 3 GB available space</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> MacOS X Yosemite OR superior<br></li><li><strong>Processor:</strong> Universal (32 or 64)<br></li><li><strong>Memory:</strong> 3 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 530<br></li><li><strong>Storage:</strong> 3 GB available space</li></ul>"},"movies":[{"highlight":true,"id":257068821,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257068821/movie480.mp4?t=1730802550","max":"http://video.akamai.steamstatic.com/store_trailers/257068821/movie_max.mp4?t=1730802550"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257068821/a7c65157c1f4c135ef457b422b9414693f03ebc0/movie_600x337.jpg?t=1730802550","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257068821/movie480_vp9.webm?t=1730802550","max":"http://video.akamai.steamstatic.com/store_trailers/257068821/movie_max_vp9.webm?t=1730802550"}}],"name":"LSD: Dream Emulator Retro","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purcha