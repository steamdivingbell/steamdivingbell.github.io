a20fa607.mp4?t=1764005936\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Optionally, after each shift, you may view cutscenes you've unlocked during the course of your playtrough, where you can see Poba's discussions, adventures and misadventures when interacting with the other people around the city of Paphollana.</p>","developers":["Coconut Witch"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3778600/499992b2b1ca541e1060d6cb4c4b3f7b53a98ec6/header.jpg?t=1764005936","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3778600/829908014/343573e59e1bafada743b1f4dfdc4bf50984499a/1753705639/dash_av1.mpd?t=1753706310","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3778600/829908014/343573e59e1bafada743b1f4dfdc4bf50984499a/1753705639/dash_h264.mpd?t=1753706310","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3778600/829908014/343573e59e1bafada743b1f4dfdc4bf50984499a/1753705639/hls_264_master.m3u8?t=1753706310","id":257169541,"name":"Bar at the Edge of Papillon - Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257169541/1a23fe1fc617bcca955a15016d161f1ec7d6ee92/movie_600x337.jpg?t=1753706310"}],"name":"Bar at the Edge of Papillon","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel(R) Core(TM) i5-6400 CPU @ 2.70GHz   2.70 GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA\u00ae GeForce\u00ae GTS 450 (1 GB)<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Additional Notes:</strong> Game will be tested on lower end devices, which