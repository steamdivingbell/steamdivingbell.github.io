s. Use them as you wish, for survival, power, or social reputation.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127510/extras/232db0208492fbafec13923870a34188.poster.avif?t=1762223957\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127510/extras/232db0208492fbafec13923870a34188.webm?t=1762223957\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127510/extras/232db0208492fbafec13923870a34188.mp4?t=1762223957\" type=\"video/mp4\"></video></span></p>","developers":["Digital Bast"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127510/ad2b8fe5347f688d739d55727b4f6bf136c6bef8/header.jpg?t=1762223957","is_free":false,"legal_notice":"\u00a9 2025 Ignacio Jesus Cuesta Vazquez. All rights reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4127510/1416559430/dc29732a83e4178b5185f6e7c9d670bb126417fc/1761603464/dash_av1.mpd?t=1761762601","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4127510/1416559430/dc29732a83e4178b5185f6e7c9d670bb126417fc/1761603464/dash_h264.mpd?t=1761762601","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4127510/1416559430/dc29732a83e4178b5185f6e7c9d670bb126417fc/1761603464/hls_264_master.m3u8?t=1761762601","id":257222790,"mp4":{"480":"https://video.akamai.steamstatic.co