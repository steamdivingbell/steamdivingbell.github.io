6543af7601d5e1dcb6979f562d/ss_8f04f4602b5e316543af7601d5e1dcb6979f562d.1920x1080.jpg?t=1754419015","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484210/8f04f4602b5e316543af7601d5e1dcb6979f562d/ss_8f04f4602b5e316543af7601d5e1dcb6979f562d.600x338.jpg?t=1754419015"}],"short_description":"An online co-op horror game where you and your crew form strategies to hunt invading Abnormal Entities inside a massive armored WALKER. Use your environment, items, or whatever is at your disposal to protect your WALKER.","steam_appid":3484210,"support_info":{"email":"dadilipgames@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}