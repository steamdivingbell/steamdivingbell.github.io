eam/apps/3863710/b8d6b50f1c0ff975362a9e1a2a67de0451e06695/ss_b8d6b50f1c0ff975362a9e1a2a67de0451e06695.600x338.jpg?t=1753239853"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3863710/1f8079debd24f6c6729ba9beebf332e6ab169806/ss_1f8079debd24f6c6729ba9beebf332e6ab169806.1920x1080.jpg?t=1753239853","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3863710/1f8079debd24f6c6729ba9beebf332e6ab169806/ss_1f8079debd24f6c6729ba9beebf332e6ab169806.600x338.jpg?t=1753239853"}],"short_description":"You are 'The Crethian', the only man in the sky. The world is yours. People are your toys. Violence is your religion. Laser ANY npc to pieces using the built-in ULTRA-REALISTIC Procedural Dismemberment (realistic limb cutting). Fly across the world, destroying THOUSANDS of NPCs.","steam_appid":3863710,"support_info":{"email":"haroldcrowyt@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}