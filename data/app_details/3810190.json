kamai.steamstatic.com/store_item_assets/steam/apps/3810190/767227be5bf0c80fc7e22d0f45755bafc0e75819/ss_767227be5bf0c80fc7e22d0f45755bafc0e75819.1920x1080.jpg?t=1763138863","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810190/767227be5bf0c80fc7e22d0f45755bafc0e75819/ss_767227be5bf0c80fc7e22d0f45755bafc0e75819.600x338.jpg?t=1763138863"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810190/ea5ea1577c9d6c253ab6de50fafdbfc46b83106a/ss_ea5ea1577c9d6c253ab6de50fafdbfc46b83106a.1920x1080.jpg?t=1763138863","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810190/ea5ea1577c9d6c253ab6de50fafdbfc46b83106a/ss_ea5ea1577c9d6c253ab6de50fafdbfc46b83106a.600x338.jpg?t=1763138863"}],"short_description":"SHOTGUNS DREAMS is a first-person 3D platformer with an emphasis on momentum and creativity. Utilize simple parkour abilities like sliding and wall-running to maintain top speed. Leverage shell pickups to gain velocity, teleport, and manipulate gravity. How you reach the goal is up to you.","steam_appid":3810190,"support_info":{"email":"Yorgishmorgies@gmail.com","url":"https://x.com/Tarkensplat"},"supported_languages":"English","type":"game","website":null}