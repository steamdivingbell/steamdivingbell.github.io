2990060/dccf4331184e3751600a559fb7b9ff12bb524b49/ss_dccf4331184e3751600a559fb7b9ff12bb524b49.1920x1080.jpg?t=1772810197","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2990060/dccf4331184e3751600a559fb7b9ff12bb524b49/ss_dccf4331184e3751600a559fb7b9ff12bb524b49.600x338.jpg?t=1772810197"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2990060/514fc00819479b061acfa70113524bebdb95cc19/ss_514fc00819479b061acfa70113524bebdb95cc19.1920x1080.jpg?t=1772810197","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2990060/514fc00819479b061acfa70113524bebdb95cc19/ss_514fc00819479b061acfa70113524bebdb95cc19.600x338.jpg?t=1772810197"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2990060/8b4206ee4a5aba02ab07ae834dd09cd281cb5d2f/ss_8b4206ee4a5aba02ab07ae834dd09cd281cb5d2f.1920x1080.jpg?t=1772810197","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2990060/8b4206ee4a5aba02ab07ae834dd09cd281cb5d2f/ss_8b4206ee4a5aba02ab07ae834dd09cd281cb5d2f.600x338.jpg?t=1772810197"}],"short_description":"Rip through retro-futuristic Tokyo highways in a demonic pursuit of speed and power! Lane split through heavy traffic and dominate tracks filled with obstacles on an action-packed mission to overcome possession. Are you fast enough to outrun your demons?","steam_appid":2990060,"support_info":{"email":"support@baltorogames.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Traditional Chinese, Simplified Chinese, Dutch, Japanese, Korean, Polish, Portuguese - Brazil","type":"game","website":null}