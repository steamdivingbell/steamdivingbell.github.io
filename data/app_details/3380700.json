ull":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/08cd0c9783afdaeb4807de4924e6bbe8564d0126/ss_08cd0c9783afdaeb4807de4924e6bbe8564d0126.1920x1080.jpg?t=1762771074","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/08cd0c9783afdaeb4807de4924e6bbe8564d0126/ss_08cd0c9783afdaeb4807de4924e6bbe8564d0126.600x338.jpg?t=1762771074"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/c3b9581fd3674821aaf099fa3f40f3ce986c0622/ss_c3b9581fd3674821aaf099fa3f40f3ce986c0622.1920x1080.jpg?t=1762771074","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/c3b9581fd3674821aaf099fa3f40f3ce986c0622/ss_c3b9581fd3674821aaf099fa3f40f3ce986c0622.600x338.jpg?t=1762771074"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/444efd17a64e0708199a137d2e9672cd9621fe2b/ss_444efd17a64e0708199a137d2e9672cd9621fe2b.1920x1080.jpg?t=1762771074","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/444efd17a64e0708199a137d2e9672cd9621fe2b/ss_444efd17a64e0708199a137d2e9672cd9621fe2b.600x338.jpg?t=1762771074"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/fd41e101e58608127fc358c26a4dfdae886ed450/ss_fd41e101e58608127fc358c26a4dfdae886ed450.1920x1080.jpg?t=1762771074","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/fd41e101e58608127fc358c26a4dfdae886ed450/ss_fd41e101e58608127fc358c26a4dfdae886ed450.600x338.jpg?t=1762771074"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/26de6073b59f4ad5bfe3cffd3df17d6a25f06d83/ss_26de6073b59f4ad5bfe3cffd3df17d6a25f06d83.1920x1080.jpg?t=1762771074","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/26de6073b59f4ad5bfe3cffd3df17d6a25f06d83/ss_26de6073b59f4ad5bfe3cffd3df17d6a25f06d83.600x338.jpg?t=1762771074"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/1eb0a80c15b2cc584c0885576e62371dd15926f2/ss_1eb0a80c15b2cc584c0885576e62371dd15926f2.1920x1080.jpg?t=1762771074","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3380700/1eb0a80c15b2cc584c0885576e62371dd15926f2/ss_1eb0a80c15b2cc584c0885576e62371dd15926f2.600x338.jpg?t=1762771074"}],"short_description":"Arrange a living backpack of swords, potions, and trinkets to auto\u2011battle foes in a paper\u2011theater roguelike. Link items to trigger chain reactions, play tactical cards, and outsmart bosses run after run.","steam_appid":3380700,"support_info":{"email":"contact@agezero.net","url":"https://www.agezero.net/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese","type":"game","website":null}