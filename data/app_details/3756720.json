integration</strong> for sharing your designs and downloading new mods with ease.</p></li><li><p class=\"bb_paragraph\">Full version: <strong>Lots of new encounters, assignments, modules and more to discover!</strong></p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">eXoSpace is a passion project by Fantastimaker, an independent game studio led by a former software engineer and supported by his two enthusiastic sons.</p>","developers":["Fantastimaker"],"fullgame":{"appid":"2876200","name":"eXoSpace Combat Engineer"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3756720/8a8f9a6293c9d25b0929a9a4a1df6d7ca8af7d6c/header.jpg?t=1748241578","is_free":true,"legal_notice":"Copyright 2025 Bas @ Fantastimaker","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257141566,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257141566/movie480.mp4?t=1747928296","max":"http://video.akamai.steamstatic.com/store_trailers/257141566/movie_max.mp4?t=1747928296"},"name":"eXoSpace Combat Engineer - Official Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257141566/e78ce1f0204e8cf51928dc0edfe71f75c9703c57/movie_600x337.jpg?t=1747928296","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257141566/movie480_vp9.webm?t=1747928296","max":"http://video.akamai.steamstatic.com/store_trailers/257141566/movie_max_vp9.webm?t=1747928296"}}],"name":"eXoSpace Combat Engineer Demo","packa