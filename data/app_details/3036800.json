b94d3f8a773282f546860.poster.avif?t=1768240988\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/cb22d1b63f0b94d3f8a773282f546860.webm?t=1768240988\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/cb22d1b63f0b94d3f8a773282f546860.mp4?t=1768240988\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><u><strong>Work Together to Escape</strong></u></p><p class=\"bb_paragraph\" style=\"text-align: center\">Team up or queue solo to complete ridiculous objectives, coordinate outrageous escape plans, and unleash a mix of clever strategies and chaotic bodily functions. Stay alert because a single mistake can send you straight to the Nap Room!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/8c6273f79daa8fcbb335883c3b311825.poster.avif?t=1768240988\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/8c6273f79daa8fcbb335883c3b311825.webm?t=1768240988\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/8c6273f79daa8fcbb335883c3b311825.mp4?t=1768240988\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><u><strong>Select Your Animal Inmate</strong></u></p><p class=\"bb_paragraph\" style=\"text-align: center\">Every animal offers a distinct skillset and personality. Whether you're carving through robots as a lion sword master, tricking pursuers as an elephant art-fraudster, or creating pure pandemonium with your messy abilities, every match offers new chaos and unique breakouts.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/131adcedc73de2ee3efb1ca3e13476e4.avif?t=1768240988\" width=920 height=139 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">Grab a partner and hunt down the escaping inmates using customizable robot parts, powerful gadgets, and circuitry tough enough to withstand constant exposure to\u2026unexpected liquids.\u00a0</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/0291e8b3b9c554d5d830646885a7d4f0.poster.avif?t=1768240988\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/0291e8b3b9c554d5d830646885a7d4f0.webm?t=1768240988\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/0291e8b3b9c554d5d830646885a7d4f0.mp4?t=1768240988\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><u><strong>Mix &amp; Match Robot Parts</strong></u></p><p class=\"bb_paragraph\" style=\"text-align: center\">Build your robot from interchangeable parts, combining upper and lower bodies to capture animals your own way. Shape your offense with options like the Stun Gun for shocking close-range captures or the Lasso for long-distance takedowns. Adapt your movement with options like the Wheels for high-speed chases or Tank Treads for bulldozing through obstacles.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/2abab81e67607efa4181a322e7716e08.poster.avif?t=1768240988\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/2abab81e67607efa4181a322e7716e08.webm?t=1768240988\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/2abab81e67607efa4181a322e7716e08.mp4?t=1768240988\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><u><strong>Choose Your Gadget &amp; Boost</strong></u></p><p class=\"bb_paragraph\" style=\"text-align: center\">Equip your robot with active-use gadgets and passive boosts that shape your capture strategy. Use gadgets like the Magic Hand to set traps or the Wormhole to slip through walls, then pair them with boosts like Shield for protection or Camouflage to vanish when standing still. Collect Poopie during each match to unlock powerful upgrades and supercharge your robot.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/extras/8728fd7f55cd67036a2ddbd435a1ab0f.avif?t=1768240988\" width=920 height=139 /></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Cute looks, total chaos! Enjoy<strong> fast-paced, asymmetrical 4v2 battles</strong> between the Animals Team and the Robot Team</p></li><li><p class=\"bb_paragraph\" >Quick <strong>10-minute matches</strong> make it perfect for parties and pick-up-and-play sessions</p></li><li><p class=\"bb_paragraph\" >Hilarious yet surprisingly strategic battle system built around <strong>mess-based mechanics</strong></p></li><li><p class=\"bb_paragraph\" >Adorable art by <strong>Kanahei </strong>paired with a high-energy soundtrack from<strong> TeddyLoid</strong></p></li><li><p class=\"bb_paragraph\" ><strong>Full cross-play support </strong>across all platforms</p></li><li><p class=\"bb_paragraph\" >S<strong>ingle-player campaign </strong>that uncovers the strange secrets of Prison Island</p></li><li><p class=\"bb_paragraph\" >Complete challenges to earn <strong>Pritto Coins</strong> and unlock fun customization items</p></li><li><p class=\"bb_paragraph\" >Personalize both animals and robots with <strong>unique skins and decorations</strong></p></li><li><p class=\"bb_paragraph\" >Play with friends using custom rules in <strong>Private Match</strong> mode</p></li></ul>","developers":["PinCool"],"dlc":[4173140,4173150,4173160,4173170,4173180,4173190,4173200,4173210,4173220,4173230,4173260,4173270,4173280,4173290,4173300,4173310,4173320,4173330,4173340,4173350,4173370,4173380,4173390,4173400,4173410,4173420,4173430,4173440,4173450,4173460,4173470,4173480,4173490,4173500],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3036800/94aca481d4060e40ad0c806208daedf9f33a8a6e/header.jpg?t=1768240988","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 12.6 or later<br></li><li><strong>Processor:</strong> Intel\u00ae Core\u2122 i3 10th generation or higher<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Intel Iris Plus or better<br></li><li><strong>Storage:</strong> 5.1 GB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3036800/15561883/4425a124a7c11066dbf41309ec5830d9cae7fd0d/1765425375/dash_av1.mpd?t=1765599455","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3036800/15561883/4425a124a7c11066dbf41309ec5830d9cae7fd0d/1765425375/dash_h264.mpd?t=1765599455","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3036800/15561883/