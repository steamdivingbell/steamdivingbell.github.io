/steam/apps/3741470/aced8240b9cce3184c58fa9d72e979cadacdb12e/ss_aced8240b9cce3184c58fa9d72e979cadacdb12e.600x338.jpg?t=1749660673"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3741470/020f120f8b4278a91f9c753d1c666b1b75dfb37b/ss_020f120f8b4278a91f9c753d1c666b1b75dfb37b.1920x1080.jpg?t=1749660673","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3741470/020f120f8b4278a91f9c753d1c666b1b75dfb37b/ss_020f120f8b4278a91f9c753d1c666b1b75dfb37b.600x338.jpg?t=1749660673"}],"short_description":"Dive into the mysterious world of Lonelight! Explore what remains of Earth-3, uncover secrets left behind by your creator, fight a cast of twisted enemies, and above all, don't let the light fade away...","steam_appid":3741470,"support_info":{"email":"fyllas.help@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}