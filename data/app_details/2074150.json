e begins. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074150/extras/a1d37b1fc29f76e1450f8ef196cdafc8.poster.avif?t=1761192168\" width=506 height=288 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074150/extras/a1d37b1fc29f76e1450f8ef196cdafc8.webm?t=1761192168\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074150/extras/a1d37b1fc29f76e1450f8ef196cdafc8.mp4?t=1761192168\" type=\"video/mp4\"></video></span></p>","developers":["Sameer Hirezi"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074150/header.jpg?t=1761192168","is_free":false,"legal_notice":"\u00a92025 Sameer Hirezi. All Rights Reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2074150/695980/573290dffafe77dbd99d0dd61245e977f4f59c1f/1751072011/dash_av1.mpd?t=1714830143","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2074150/695980/573290dffafe77dbd99d0dd61245e977f4f59c1f/1751072011/dash_h264.mpd?t=1714830143","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2074150/695980/573290dffafe77dbd99d0dd61245e977f4f59c1f/1751072011/hls_264_master.m3u8?t=1714830143","id":257020862,"name":"Next Fest Early Access Trailer_","thumbnail":"https://shared.ak