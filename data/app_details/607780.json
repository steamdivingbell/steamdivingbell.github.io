ttps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/607780/ss_9b40eb3742b83a169dac94c19788cbed28dc85c0.600x338.jpg?t=1704657391"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/607780/ss_e03a7c8598490adbef4fcb7cc8145e1d00fa799f.1920x1080.jpg?t=1704657391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/607780/ss_e03a7c8598490adbef4fcb7cc8145e1d00fa799f.600x338.jpg?t=1704657391"}],"short_description":"Toymaker is a roleplaying game that takes place in a dark, snow-filled world, where life is harsh and the people living there have become hard and cold. In this land, the darkness has eyes, the winter wind whispers with a piercing voice and the frost hungers for warm flesh.","steam_appid":607780,"support_info":{"email":"","url":"https://redskald.wordpress.com/contact/"},"supported_languages":"English","type":"game","website":"https://redskald.wordpress.com/games/toymaker/"}