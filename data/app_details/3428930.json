eamstatic.com/store_item_assets/steam/apps/3428930/a2cb6862a5c2c8e79590e28e9e5b26e23194da93/ss_a2cb6862a5c2c8e79590e28e9e5b26e23194da93.600x338.jpg?t=1773071945"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3428930/f341fa177e566e327d65e1cea2bc3bd785be2456/ss_f341fa177e566e327d65e1cea2bc3bd785be2456.1920x1080.jpg?t=1773071945","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3428930/f341fa177e566e327d65e1cea2bc3bd785be2456/ss_f341fa177e566e327d65e1cea2bc3bd785be2456.600x338.jpg?t=1773071945"}],"short_description":"Dash, sprint, defend, and wield any weapon with 18 unique heroes, each with a loyal combat pet and fully visible gear. Deep strategic item and set bonus system, complete mid-run challenges, survive relentless waves, and face mighty bosses in this fast-paced arena roguelike bullet heaven!","steam_appid":3428930,"support_info":{"email":"slimeattacksurvivor@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Dutch, Japanese, Korean, Polish, Russian, Simplified Chinese, Traditional Chinese, Turkish, Portuguese - Brazil","type":"game","website":null}