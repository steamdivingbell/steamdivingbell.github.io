gs.</p><p class=\"bb_paragraph\"><strong>Starseed Pilgrim - </strong>Lack of hand-holding &amp; tile interaction aspects.</p>","developers":["CZDOOM"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3747140/276f62aa97e9e25cccccdcf41ebdc0459735a1a4/header.jpg?t=1747956405","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257142298,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257142298/movie480.mp4?t=1747762642","max":"http://video.akamai.steamstatic.com/store_trailers/257142298/movie_max.mp4?t=1747762642"},"name":"Fourmiworld - Reveal Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257142298/4c925de0c50ef57f9a500677520b4f0c3baad3aa/movie_600x337.jpg?t=1747762642","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257142298/movie480_vp9.webm?t=1747762642","max":"http://video.akamai.steamstatic.com/store_trailers/257142298/movie_max_vp9.webm?t=1747762642"}}],"name":"Fourmiworld","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel\u00ae Core\u2122 i5-2400<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 750 Ti<br></li><li><strong>Storage:</strong> 750 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["CZDOOM"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Gewalt","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Q3 2025"},"required_age":0,"screenshots":[{"id":0,"pat