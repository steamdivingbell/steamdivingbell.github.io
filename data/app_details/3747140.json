am/apps/3747140/6786c37a4268914a9d83aeb95c85515ed92b98b4/ss_6786c37a4268914a9d83aeb95c85515ed92b98b4.600x338.jpg?t=1747956405"}],"short_description":"Carve your own path through Fourmiworld - an &quot;open-world-ant-farm-metroidvania&quot;. Play as an interdimensional urban explorer girl, collect gamut to unlock new abilities, and discover the sights, plights, &amp; soundbites of a surreal alien dimension.","steam_appid":3747140,"support_info":{"email":"contactczdoom@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}