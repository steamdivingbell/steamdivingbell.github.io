aracter abilities, power-ups, and even more wild tracks!</p><p class=\"bb_paragraph\">Whether you're racing solo or going wheel-to-wheel with friends, <strong>Broom Broom Karts</strong> is the ultimate <strong>low-poly, high-fun</strong> kart racing experience. Buckle up, hit the gas, and let's GO!</p>","developers":["arnenzo1"],"genres":[{"description":"Indie","id":"23"},{"description":"Racing","id":"9"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3365990/5f1d153f89bd72355664220a3b2fc6ee7e1a9578/header.jpg?t=1744659274","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257076785,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257076785/movie480.mp4?t=1742906896","max":"http://video.akamai.steamstatic.com/store_trailers/257076785/movie_max.mp4?t=1742906896"},"name":"Game Play Trailer #2","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257076785/7165ff4acee75df8053ee8871078a1ce8e6b8672/movie_600x337.jpg?t=1742906896","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257076785/movie480_vp9.webm?t=1742906896","max":"http://video.akamai.steamstatic.com/store_trailers/257076785/movie_max_vp9.webm?t=1742906896"}}],"name":"Broom Broom Karts","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["arnenzo1"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Coming soon"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3365990/9b69327358d6df23a9daffbba870147e818e5c19/s