ysinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3044420/extras/e006e57e9490cfbe328ff8dd791bc258.poster.avif?t=1762760188\" width=800 height=148 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3044420/extras/e006e57e9490cfbe328ff8dd791bc258.webm?t=1762760188\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >Don\u2019t forget to <strong>upgrade</strong> your ship!</p><p class=\"bb_paragraph\" >There are many useful perks you can unlock to make your journey a little easier.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3044420/extras/28a354c766adefa7c4ed1aaa70af327e.poster.avif?t=1762760188\" width=1170 height=174 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3044420/extras/28a354c766adefa7c4ed1aaa70af327e.webm?t=1762760188\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><strong>Explore</strong> the hostile void and find your way home!</p><p class=\"bb_paragraph\" ></p>","developers":["ZIPSTED"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3044420/63db388a48979a23cd10e3816bc51e30cb559481/header.jpg?t=1762760188","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> SteamOS 3.0+ | Ubuntu 22.04+<br></li><li><strong>Processor:</strong> AMD Zen 2 4-core | AMD Ryzen 3+<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> AMD RDNA 2 | GeForce GTX 1050+</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<