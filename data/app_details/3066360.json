em_assets/steam/apps/3066360/ss_cd220b5c72e0ea58514ff45e29453fa594437115.600x338.jpg?t=1745228866"}],"short_description":"Help KoKo on his first day at work! Push, kick, grab and rearrange the boxes, while avoiding the dangers throughout the mega-warehouse. Solve all the puzzles and finally reach the exit!","steam_appid":3066360,"support_info":{"email":"turbosodagames@gmail.com","url":"https://www.turbosoda.games/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Simplified Chinese, Korean, Spanish - Latin America, Japanese, Dutch, Portuguese - Brazil, Portuguese - Portugal, Russian","type":"game","website":null}