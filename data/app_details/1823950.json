ass=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1823950/extras/2de066d5598ed0e72d6dc989d35b5016.poster.avif?t=1770990978\" width=1170 height=214 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1823950/extras/2de066d5598ed0e72d6dc989d35b5016.webm?t=1770990978\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1823950/extras/2de066d5598ed0e72d6dc989d35b5016.mp4?t=1770990978\" type=\"video/mp4\"></video></span></p>","developers":["Quite OK Games"],"dlc":[2926820],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1823950/header.jpg?t=1770990978","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1823950/470063/50dbba78e2dec509b40fd893e9ad7708f3bf13cd/1751035226/dash_av1.mpd?t=1716832978","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1823950/470063/50dbba78e2dec509b40fd893e9ad7708f3bf13cd/1751035226/dash_h264.mpd?t=1716832978","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1823950/470063/50dbba78e2dec509b40fd893e9ad7708f3bf13cd/1751035226/hls_264_master.m3u8?t=1716832978","id":256890578,"name":"Gameplay Explainer Video","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256890578/movie.293x165.jpg?t=1716832978"},