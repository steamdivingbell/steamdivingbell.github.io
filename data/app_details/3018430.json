ated":"1","required_age":"18","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"31 Oct, 2025"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_75d2adab9d922807ae0caf37fa470f7c5e61fbc0.1920x1080.jpg?t=1758960633","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_75d2adab9d922807ae0caf37fa470f7c5e61fbc0.600x338.jpg?t=1758960633"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_d1ac6a4efe90c89cddba55c891f3163af1ba0385.1920x1080.jpg?t=1758960633","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_d1ac6a4efe90c89cddba55c891f3163af1ba0385.600x338.jpg?t=1758960633"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_e55883e4c13132efe3a8fbdd3e6a6c925f3810d2.1920x1080.jpg?t=1758960633","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_e55883e4c13132efe3a8fbdd3e6a6c925f3810d2.600x338.jpg?t=1758960633"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_45cab817355d791b95857134f899e63eb7e92357.1920x1080.jpg?t=1758960633","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_45cab817355d791b95857134f899e63eb7e92357.600x338.jpg?t=1758960633"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_e44a7a215daa3a63e954944eade5d988a5b18549.1920x1080.jpg?t=1758960633","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018430/ss_e44a7a215daa3a63e954944eade5d988a5b18549.600x338.jpg?t=1758960633"}],"short_description":"Find your missing daughter in the Hospital of Madness. Collect items, fight enemies, and do whatever it takes to reach her!","steam_appid":3018430,"support_info":{"email":"Info@