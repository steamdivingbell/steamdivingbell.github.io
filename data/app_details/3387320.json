4a8fb1829f72ecb415f3e5ea241ad/ss_1d9a40a10224a8fb1829f72ecb415f3e5ea241ad.600x338.jpg?t=1744451760"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3387320/3693f610398ec5ac37db6a7383a991a39c5e8192/ss_3693f610398ec5ac37db6a7383a991a39c5e8192.1920x1080.jpg?t=1744451760","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3387320/3693f610398ec5ac37db6a7383a991a39c5e8192/ss_3693f610398ec5ac37db6a7383a991a39c5e8192.600x338.jpg?t=1744451760"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3387320/09d534ea727ec645fe88768a87174e8a5057d554/ss_09d534ea727ec645fe88768a87174e8a5057d554.1920x1080.jpg?t=1744451760","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3387320/09d534ea727ec645fe88768a87174e8a5057d554/ss_09d534ea727ec645fe88768a87174e8a5057d554.600x338.jpg?t=1744451760"}],"short_description":"Niluas, an android who suddenly activated 276 years after the extinction of humanity. With her AI, Naive, she seeks lost memories, her activation's mystery, and humanity's extinction's cause. Facing enigmatic foes and hostile androids, she quests for truth about her existence and the desolate world.","steam_appid":3387320,"support_info":{"email":"organization@teammoko.com","url":""},"supported_languages":"English, Simplified Chinese, Japanese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://teammoko.com/"}