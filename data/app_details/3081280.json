x1080.jpg?t=1761537738","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3081280/38940375ecfb5df3de9f7233b35bbd40e8099401/ss_38940375ecfb5df3de9f7233b35bbd40e8099401.600x338.jpg?t=1761537738"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3081280/e623cbad53bae58406c110eff334db81bcca6e42/ss_e623cbad53bae58406c110eff334db81bcca6e42.1920x1080.jpg?t=1761537738","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3081280/e623cbad53bae58406c110eff334db81bcca6e42/ss_e623cbad53bae58406c110eff334db81bcca6e42.600x338.jpg?t=1761537738"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3081280/fe96f839e365eef89736a8bcd2481840f9d8ec93/ss_fe96f839e365eef89736a8bcd2481840f9d8ec93.1920x1080.jpg?t=1761537738","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3081280/fe96f839e365eef89736a8bcd2481840f9d8ec93/ss_fe96f839e365eef89736a8bcd2481840f9d8ec93.600x338.jpg?t=1761537738"}],"short_description":"A 1v1 tactical auto battler game with elements of roguelike mechanics and backpack management in a dark medieval art style. It was inspired by Backpack Battles and developed with Unreal Engine. Create your own unique attack combos by arranging items in your backpack to connect moves.","steam_appid":3081280,"support_info":{"email":"Wretch@ogopogo.games","url":"https://ogopogo.games/"},"supported_languages":"English<strong>*</strong>, Simplified Chinese<strong>*</strong>, Traditional Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}