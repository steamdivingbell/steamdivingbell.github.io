0f8095d2b72f1/ss_b3c751e2029c54339404138a3e60f8095d2b72f1.600x338.jpg?t=1761696692"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3191110/f8c4c847316f9634e294ccade8cd6cd018b32c37/ss_f8c4c847316f9634e294ccade8cd6cd018b32c37.1920x1080.jpg?t=1761696692","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3191110/f8c4c847316f9634e294ccade8cd6cd018b32c37/ss_f8c4c847316f9634e294ccade8cd6cd018b32c37.600x338.jpg?t=1761696692"}],"short_description":"The universe's greatest cat burglar? The ultimate phantom thief across dimensions? Nah... Time Snatcher Handy, that's me! A time-stop bullet-hell action roguelike starring &quot;Handy&quot; the stylish cat burglar! Stop the time to dodge bullets, gather items to get stronger, and escape the Time Museum!","steam_appid":3191110,"support_info":{"email":"cs@cometsoft.co.kr","url":"http://www.cometsoft.co.kr/"},"supported_languages":"English, Japanese, Korean, Simplified Chinese, Traditional Chinese","type":"game","website":null}