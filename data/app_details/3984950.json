rkshop:</strong> Download other players levels and complete them.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/extras/28346e2b91132a2c6123bbef034e7307.poster.avif?t=1764451145\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/extras/28346e2b91132a2c6123bbef034e7307.webm?t=1764451145\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/extras/28346e2b91132a2c6123bbef034e7307.mp4?t=1764451145\" type=\"video/mp4\"></video></span></p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["Quadrigo","Grumbar"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/ce397110db8c36f64367e77c2353ba87d94d9dc4/header.jpg?t=1764451145","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3984950/1465696531/00596ae9809ed0b37c85e834d2b1d4e25ab820c3/1764449940/dash_av1.mpd?t=1764451144","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3984950/1465696531/00596ae9809ed0b37c85e834d2b1d4e25ab820c3/1764449940/dash_h264.mpd?t=1764451144","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3984950/1465696531/00596ae9809ed0b37c85e834d2b1d4e25ab820c3/1764449940/hls_264_master.m3u8?t=1764451144","id":257191436,"name":"Trailer","thumbnail":"https://shared.