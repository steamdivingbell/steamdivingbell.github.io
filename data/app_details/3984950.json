.steamstatic.com/store_item_assets/steam/apps/3984950/77e0d6cbb385eaed16931b6e63103516aa26ddbb/ss_77e0d6cbb385eaed16931b6e63103516aa26ddbb.600x338.jpg?t=1770594710"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/c4b55b28468e494cc96e9ced72472c608ace4c80/ss_c4b55b28468e494cc96e9ced72472c608ace4c80.1920x1080.jpg?t=1770594710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/c4b55b28468e494cc96e9ced72472c608ace4c80/ss_c4b55b28468e494cc96e9ced72472c608ace4c80.600x338.jpg?t=1770594710"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/30e8b5036dab350941e6164ec3ac04a0244d017c/ss_30e8b5036dab350941e6164ec3ac04a0244d017c.1920x1080.jpg?t=1770594710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/30e8b5036dab350941e6164ec3ac04a0244d017c/ss_30e8b5036dab350941e6164ec3ac04a0244d017c.600x338.jpg?t=1770594710"}],"short_description":"A hardcore multiplayer 3D survival platformer. You only have one shot to reach the end. The character is always running forward - there\u2019s no stopping him. Simple controls: just jump and crouch to avoid traps. Play community-made worlds, compete with friends, and create your own maps in the editor!","steam_appid":3984950,"support_info":{"email":"vanya.paliyov@gmail.com","url":""},"supported_languages":"English, Russian, French, Italian, German, Spanish - Spain, Simplified Chinese, Polish, Portuguese - Brazil, Portuguese - Portugal, Japanese","type":"game","website":null}