lete them.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/extras/28346e2b91132a2c6123bbef034e7307.poster.avif?t=1770594710\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/extras/28346e2b91132a2c6123bbef034e7307.webm?t=1770594710\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/extras/28346e2b91132a2c6123bbef034e7307.mp4?t=1770594710\" type=\"video/mp4\"></video></span></p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["Quadrigo","Grumbar"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3984950/9f63c2f1965e622d73939f949b1934db9318472e/header.jpg?t=1770594710","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3984950/1465696531/00596ae9809ed0b37c85e834d2b1d4e25ab820c3/1764449940/dash_av1.mpd?t=1768691069","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3984950/1465696531/00596ae9809ed0b37c85e834d2b1d4e25ab820c3/1764449940/dash_h264.mpd?t=1768691069","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3984950/1465696531/00596ae9809ed0b37c85e834d2b1d4e25ab820c3/1764449940/hls_264_master.m3u8?t=1768691069","id":257191436,"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257