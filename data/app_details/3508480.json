apps/3508480/3682ea15697a08358fbc9eec05fbb46a26fefa45/ss_3682ea15697a08358fbc9eec05fbb46a26fefa45.600x338.jpg?t=1762099669"}],"short_description":"Night Shift is a first-person psychological horror game. During a late shift, reality begins to distort. What starts as a normal lonely shift descends into a nightmare of lost time and haunting childhood memories, where the line between real and imagined disappear...can you survive the shift ?","steam_appid":3508480,"support_info":{"email":" Midnight_Entertainment@outlook.com","url":""},"supported_languages":"English<strong>*</strong>, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Spanish - Latin America<br><strong>*</strong>languages with full audio support","type":"game","website":null}