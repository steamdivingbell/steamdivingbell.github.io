paragraph\" >Eyebrows, lashes, eyes, mouth, and skin colors \u2013 we have you covered!</p></li><li><p class=\"bb_paragraph\" >3 craftable crops with 7 colors to mix in your Sawing Machine</p></li><li><p class=\"bb_paragraph\" >Over 60 hours of fashion-filled farming and storytelling!</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290600/extras/d22df961d62804f9720ce92bf6bca1b7.poster.avif?t=1754306561\" width=680 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290600/extras/d22df961d62804f9720ce92bf6bca1b7.webm?t=1754306561\" type=\"video/webm; codecs=vp9\"></video></span></p>","developers":["RedDeer.Games"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3290600/417d1bb8c01f6cc4c23ef74826c33d05a60627c7/header.jpg?t=1754306561","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3290600/862398/b5ec8320df280be44d714c999a5629a22ed132b3/1750976285/dash_av1.mpd?t=1743602687","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3290600/862398/b5ec8320df280be44d714c999a5629a22ed132b3/1750976285/dash_h264.mpd?t=1743602687","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3290600/862398/b5ec8320df280be44d714c999a5629a22ed132b3/1750976285/hls_264_master.m3u8?t=1743602687","id":257121378,"name":"Cottonville Kickstarter Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257121378/6f34a1d1894f08e8886bde2dca59645083b97575/movie_600x337.jpg?t=1743602687"},{"dash_av1":"https://video.ak