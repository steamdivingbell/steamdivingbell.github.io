/3365560/4fbd1fe49ea594b0c9ca684e4ec9f235b23e8c11/ss_4fbd1fe49ea594b0c9ca684e4ec9f235b23e8c11.600x338.jpg?t=1753778503"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3365560/9c732d92b643e924cab2908705a79c16c8d3a034/ss_9c732d92b643e924cab2908705a79c16c8d3a034.1920x1080.jpg?t=1753778503","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3365560/9c732d92b643e924cab2908705a79c16c8d3a034/ss_9c732d92b643e924cab2908705a79c16c8d3a034.600x338.jpg?t=1753778503"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3365560/7a2bb08ff90d44cd14d77145c0ff27d8b2bbcc23/ss_7a2bb08ff90d44cd14d77145c0ff27d8b2bbcc23.1920x1080.jpg?t=1753778503","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3365560/7a2bb08ff90d44cd14d77145c0ff27d8b2bbcc23/ss_7a2bb08ff90d44cd14d77145c0ff27d8b2bbcc23.600x338.jpg?t=1753778503"}],"short_description":"Fireside Fables is a narrative driven 3D platformer, made in partnership with Great Ormond Street Hospital Charity! Play through your plushies greatest adventures, explore whimsical worlds, and re-discover your inner child!","steam_appid":3365560,"support_info":{"email":"inkforgestudios@gmail.com","url":"https://www.inkforgestudios.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.inkforgestudios.com"}