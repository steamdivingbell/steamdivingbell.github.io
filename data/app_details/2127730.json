rce src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2127730/extras/51484ff241f4f411412dfcce7437275b.webm?t=1749682268\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >\u25a0 Travel through a multitude of regions, each with unique maps and environmental conditions that challenge your adaptability.</p><p class=\"bb_paragraph\" >\u25a0 Manage resources and upgrades in the Returners' encampment to bolster your forces, support allies, and expand your influence!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" > </p>","developers":["Triple Tech Arts"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2127730/8a51745fc8324e53f9c086ab7c8ebf165b73f66b/header.jpg?t=1749682268","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2127730/1067944814/6c0950e52a7c5a9e8a0ed574b395650df07e18ff/1751079542/dash_av1.mpd?t=1748547534","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2127730/1067944814/6c0950e52a7c5a9e8a0ed574b395650df07e18ff/1751079542/dash_h264.mpd?t=1748547534","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2127730/1067944814/6c0950e52a7c5a9e8a0ed574b395650df07e18ff/1751079542/hls_264_master.m3u8?t=1748547534","id":257067569,"name":"Tactics Returners Gameplay Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257067569/f4c5825bb31b020e7a3fde12ce8f8c6afc856908/movie_600x337.jpg?t=1748547534"}],"name":"Tactics Returners","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> i3<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel Iris 