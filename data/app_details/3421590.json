ai.steamstatic.com/store_item_assets/steam/apps/3421590/28fc8c7d41244f42292f7f03f87e3b05980b60ad/ss_28fc8c7d41244f42292f7f03f87e3b05980b60ad.600x338.jpg?t=1772165477"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/c982e20211f1cb3c48d8fbc516aa2fd1a18791b9/ss_c982e20211f1cb3c48d8fbc516aa2fd1a18791b9.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/c982e20211f1cb3c48d8fbc516aa2fd1a18791b9/ss_c982e20211f1cb3c48d8fbc516aa2fd1a18791b9.600x338.jpg?t=1772165477"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/6b290896ec6a3b79d489b13fd3efcc6fce7b0e57/ss_6b290896ec6a3b79d489b13fd3efcc6fce7b0e57.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/6b290896ec6a3b79d489b13fd3efcc6fce7b0e57/ss_6b290896ec6a3b79d489b13fd3efcc6fce7b0e57.600x338.jpg?t=1772165477"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/d398192fbd14ca040c3aaa351775b1b8d62c4d3d/ss_d398192fbd14ca040c3aaa351775b1b8d62c4d3d.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/d398192fbd14ca040c3aaa351775b1b8d62c4d3d/ss_d398192fbd14ca040c3aaa351775b1b8d62c4d3d.600x338.jpg?t=1772165477"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/ss_aaeb3d04e0b7b973dd8317f07818afb111f7448d.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/ss_aaeb3d04e0b7b973dd8317f07818afb111f7448d.600x338.jpg?t=1772165477"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/2100c6608d37bce5d80d466daa39c3044d623a4e/ss_2100c6608d37bce5d80d466daa39c3044d623a4e.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/2100c6608d37bce5d80d466daa39c3044d623a4e/ss_2100c6608d37bce5d80d466daa39c3044d623a4e.600x338.jpg?t=1772165477"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/ss_81c3f86cc9a6af63722ab87d15c1257d18998f57.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/ss_81c3f86cc9a6af63722ab87d15c1257d18998f57.600x338.jpg?t=1772165477"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/f920e72d380e7ee60f6d6dbe5b10fecec1bc2fba/ss_f920e72d380e7ee60f6d6dbe5b10fecec1bc2fba.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/f920e72d380e7ee60f6d6dbe5b10fecec1bc2fba/ss_f920e72d380e7ee60f6d6dbe5b10fecec1bc2fba.600x338.jpg?t=1772165477"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/df1a7df97b33767bf3b071a9cebc70915d970bff/ss_df1a7df97b33767bf3b071a9cebc70915d970bff.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/df1a7df97b33767bf3b071a9cebc70915d970bff/ss_df1a7df97b33767bf3b071a9cebc70915d970bff.600x338.jpg?t=1772165477"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/ss_005b58dc388bb67313be745581e6ee8d71a095ee.1920x1080.jpg?t=1772165477","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3421590/ss_005b58dc388bb67313be745581e6ee8d71a095ee.600x338.jpg?t=1772165477"}],"short_description":"Bootsies is a pure 1D fighting game with a handmade retro aesthetic that emphasizes reading your opponent, precise spacing, and making bold moves to outplay opponents. Play as a colorful cast of cute boot-clad fighters determined to shape their planet's future. Steel-toe yourself and BOOT UP!","steam_appid":3421590,"support_info":{"email":"carlo@playgardengames.com","url":""},"supported_languages":"English<strong>*</strong>, Japanese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.playgardengames.com/#bootsies"}