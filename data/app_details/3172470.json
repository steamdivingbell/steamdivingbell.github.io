team/apps/3172470/ss_57cbf426b26d5d103afed659b4c846912fc71387.1920x1080.jpg?t=1740459924","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3172470/ss_57cbf426b26d5d103afed659b4c846912fc71387.600x338.jpg?t=1740459924"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3172470/ss_a768f33a4052d1cbd814f6da662c3d9e81527a7e.1920x1080.jpg?t=1740459924","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3172470/ss_a768f33a4052d1cbd814f6da662c3d9e81527a7e.600x338.jpg?t=1740459924"}],"short_description":"The Backwars is a survival horror game where you gather resources, craft, and hide from lurking terrors. Play solo, co-op, or versus in a hauntingly realistic world where anything can interact with anything. Trust no one, and do whatever it takes to survive.","steam_appid":3172470,"support_info":{"email":"scaper.studio@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}