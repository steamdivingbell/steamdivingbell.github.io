y called the &quot;Demon King,&quot; who is said to command the Mamono, and bring an end to the 900-year-long war against these creatures.<br><br>You can experience the opening section of the story in this demo.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3681090/extras/Banner3.gif?t=1746054671\" /></p>","developers":["KITTYPOOL"],"fullgame":{"appid":"3380620","name":" Shoestrings Story"},"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3681090/62ca509ba5e3adbada11c98d97c54a2d80d65fcd/header.jpg?t=1746054671","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257127543,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127543/movie480.mp4?t=1746054667","max":"http://video.akamai.steamstatic.com/store_trailers/257127543/movie_max.mp4?t=1746054667"},"name":"demo_Trailer01_jp","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257127543/39697a99b14a6a74333e14d2f095fb6ccd5b6a2c/movie_600x337.jpg?t=1746054667","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127543/movie480_vp9.webm?t=1746054667","max":"http://video.akamai.steamstatic.com/store_trailers/257127543/movie_max_vp9.webm?t=1746054667"}},{"highlight":true,"id":257127542,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127542/movie480.mp4?t=1746054669","max":"http://video.akamai.steamstatic.com/store_trailers/257127542/movie_max.mp4?t=1746054669"},"name":"demo_Trailer01_en","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257127542/0cf04abaa9d7c7a875594d2e75855ea6dbe808c3/movie_600x337.jpg?t=1746054669","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127542/movie480_vp9.webm?t=1746054669","max":"http://video.akam