f49f30.1920x1080.jpg?t=1767892221","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2452130/ss_306179d1a57cf150a7de0fa5cf0ac91076f49f30.600x338.jpg?t=1767892221"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2452130/3133a06b3a2bedcf478c2d24dc8554135be52429/ss_3133a06b3a2bedcf478c2d24dc8554135be52429.1920x1080.jpg?t=1767892221","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2452130/3133a06b3a2bedcf478c2d24dc8554135be52429/ss_3133a06b3a2bedcf478c2d24dc8554135be52429.600x338.jpg?t=1767892221"}],"short_description":"A relaxing evolution simulation where AI-driven block creatures move in unexpected ways. There are no complex ecosystems\u2014just pure movement learning through a physics engine. Watch as these creatures scurry, stumble, and evolve in their own unique, unpredictable ways.","steam_appid":2452130,"support_info":{"email":"support@attructure.com","url":"https://attructure.com/"},"supported_languages":"English, Japanese, French, German, Spanish - Spain, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Traditional Chinese, Korean, Italian, Arabic, Indonesian, Ukrainian, Dutch, Greek, Swedish, Spanish - Latin America, Thai, Czech, Danish, Turkish, Norwegian, Hungarian, Finnish, Bulgarian, Vietnamese, Polish, Romanian","type":"game","website":"https://anlife.app/"}