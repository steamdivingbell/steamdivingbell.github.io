044c49072166534de10744e/ss_0e9c87f8b94ee08a6044c49072166534de10744e.1920x1080.jpg?t=1761749252","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4081240/0e9c87f8b94ee08a6044c49072166534de10744e/ss_0e9c87f8b94ee08a6044c49072166534de10744e.600x338.jpg?t=1761749252"}],"short_description":"Shield of Breaker is a single-player Action-RPG set in a fantasy world. Protect your castle from endless waves of enemies and turn the tide of battle by deflecting their own blazing fireballs. Choose your hero, upgrade your powers,. Each victory unlocks your path to defend new lands in your realm.","steam_appid":4081240,"support_info":{"email":"info@rollingrockgames.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Turkish","type":"game","website":null}