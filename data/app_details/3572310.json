s/steam/apps/3572310/ba7f81e9f4132d5d40bd4a9e4fe5ecd297a8fd11/ss_ba7f81e9f4132d5d40bd4a9e4fe5ecd297a8fd11.600x338.jpg?t=1772872174"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3572310/63bb313e73fac8557a5cd5135872f0319048d58a/ss_63bb313e73fac8557a5cd5135872f0319048d58a.1920x1080.jpg?t=1772872174","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3572310/63bb313e73fac8557a5cd5135872f0319048d58a/ss_63bb313e73fac8557a5cd5135872f0319048d58a.600x338.jpg?t=1772872174"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3572310/11e197394f9a75aacdfa7f131f86e1b00c50581c/ss_11e197394f9a75aacdfa7f131f86e1b00c50581c.1920x1080.jpg?t=1772872174","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3572310/11e197394f9a75aacdfa7f131f86e1b00c50581c/ss_11e197394f9a75aacdfa7f131f86e1b00c50581c.600x338.jpg?t=1772872174"}],"short_description":"Match babies to their parents by solving genetics puzzles. Get paid for being right, fined for mistakes. Each choice in branching dialogues has different consequences. Immerse yourself in the atmosphere of the gloomy 1920s totalitarian state.","steam_appid":3572310,"support_info":{"email":"voltekgames@gmail.com","url":""},"supported_languages":"English, Russian, German, Spanish - Spain, Spanish - Latin America","type":"game","website":null}