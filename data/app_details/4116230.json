at \u2014 only survival through discovery and courage</p></li></ul><p class=\"bb_paragraph\" ><strong>The Heritage</strong> \u2014 Some legacies are better left forgotten.</p>","developers":["StopMountain Studio"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4116230/feec651ad6b53b43b364b0bf997fe1762e46fc88/header.jpg?t=1762455405","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4116230/1915956065/9600b7621de552ddcf2e6ce7a333f2b7df916f11/1761177876/dash_av1.mpd?t=1761179467","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4116230/1915956065/9600b7621de552ddcf2e6ce7a333f2b7df916f11/1761177876/dash_h264.mpd?t=1761179467","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4116230/1915956065/9600b7621de552ddcf2e6ce7a333f2b7df916f11/1761177876/hls_264_master.m3u8?t=1761179467","id":257221338,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257221338/movie480.mp4?t=1761179467","max":"https://video.akamai.steamstatic.com/store_trailers/257221338/movie_max.mp4?t=1761179467"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257221338/6077d9818e4dd4156a45401979f61def1fa6966e/movie_600x337.jpg?t=1761179467","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257221338/movie480.webm?t=1761179467","max":"https://video.akamai.steamstatic.com/store_trailers/257221338/movie_max.webm?t=1761179467"}}],"name":"The Heritage","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10+<br></li><li><strong>Processor:</strong> Intel Core i3-4170<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia 6800 or ATI X1300 or Intel HD3000<br></li><li><str