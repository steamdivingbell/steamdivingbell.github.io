.jpg?t=1773843876","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3952330/780cff7234f3b8ac18dcf4106b1cbde8cc625fb0/ss_780cff7234f3b8ac18dcf4106b1cbde8cc625fb0.600x338.jpg?t=1773843876"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3952330/6792c62f8b6bd209acba7d57350ed7658debd8fc/ss_6792c62f8b6bd209acba7d57350ed7658debd8fc.1920x1080.jpg?t=1773843876","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3952330/6792c62f8b6bd209acba7d57350ed7658debd8fc/ss_6792c62f8b6bd209acba7d57350ed7658debd8fc.600x338.jpg?t=1773843876"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3952330/b2bdc1ad3e81b4f79c0d53466aa009f07fecf9f3/ss_b2bdc1ad3e81b4f79c0d53466aa009f07fecf9f3.1920x1080.jpg?t=1773843876","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3952330/b2bdc1ad3e81b4f79c0d53466aa009f07fecf9f3/ss_b2bdc1ad3e81b4f79c0d53466aa009f07fecf9f3.600x338.jpg?t=1773843876"}],"short_description":"An explosive sci-fi adventure! Master a jetpack and use expressive platforming moves to explore incredible worlds, complete challenging missions, face unique rivals, and wield powerful gadgets. Run, fly, and fight in a journey full of speed and style!","steam_appid":3952330,"support_info":{"email":"eonigamedev@gmail.com","url":""},"supported_languages":"English, Japanese, Korean, Simplified Chinese, Traditional Chinese","type":"game","website":null}