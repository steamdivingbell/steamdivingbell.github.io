eam/apps/659920/24568cc6400213c4ff9239d962907b3fe8360854/ss_24568cc6400213c4ff9239d962907b3fe8360854.600x338.jpg?t=1741095764"}],"short_description":"Transports is a transportation business simulation game. Build your business empire by building transportation routes for trucks, trains, ships and planes to transport goods between industrial buildings and cities.","steam_appid":659920,"support_info":{"email":"support@jpbapps.de","url":""},"supported_languages":"English, German","type":"game","website":"https://www.transports-game.com"}