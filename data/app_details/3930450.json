/apps/3930450/408a90130e0e3d778e926e009ae09647b8438ec6/ss_408a90130e0e3d778e926e009ae09647b8438ec6.1920x1080.jpg?t=1774305568","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3930450/408a90130e0e3d778e926e009ae09647b8438ec6/ss_408a90130e0e3d778e926e009ae09647b8438ec6.600x338.jpg?t=1774305568"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3930450/643830b8d8eed770a8f496df0b842619d2e2fb88/ss_643830b8d8eed770a8f496df0b842619d2e2fb88.1920x1080.jpg?t=1774305568","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3930450/643830b8d8eed770a8f496df0b842619d2e2fb88/ss_643830b8d8eed770a8f496df0b842619d2e2fb88.600x338.jpg?t=1774305568"}],"short_description":"A rogue-like spin on two casino classics. Play blackjack against a roulette wheel of opponents. Collect power-up boules and purchase insurance policies to give you the edge against the dealer in this strategic and chaotic mash-up.","steam_appid":3930450,"support_info":{"email":"info@reactvts.com","url":"https://reactvts.com/"},"supported_languages":"English","type":"game","website":"https://reactvts.com/"}