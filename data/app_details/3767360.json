186617\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3767360/extras/67ff5e3e67c16b1439440fb3fbdc06fb.mp4?t=1767186617\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >And then, have a good <strong><i>NIGHT.</i></strong></p>","developers":["\u843d\u591c"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3767360/fe134f1e030bfe9510e501036d36b87dfc62e6f3/header.jpg?t=1767186617","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3767360/431546451/d284384c00c8cae473c5a69fdd95260cef7b1f70/1750379795/dash_av1.mpd?t=1750293789","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3767360/431546451/d284384c00c8cae473c5a69fdd95260cef7b1f70/1750379795/dash_h264.mpd?t=1750293789","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3767360/431546451/d284384c00c8cae473c5a69fdd95260cef7b1f70/1750379795/hls_264_master.m3u8?t=1750293789","id":257156201,"name":"No One Sleep Tonight","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257156201/31aa2766beb2279a9dae60d0415e220ccda23945/movie_600x337.jpg?t=1750293789"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3767360/579912262/5a809eb36366fa7d7b554cd1fc2adeeed3da851c/1750379800/dash_av1.mpd?t=1750293792","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3767360/579912262/5a809eb36366fa7d7b554cd1fc2adeeed3da851c/1750379800/dash_h264.mpd?t=1750293792","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3767360/579912262/5a809eb36366fa7d7b554cd1fc2adeeed3da851c/1750379800/hls_264_master