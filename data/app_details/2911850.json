assets/steam/apps/2911850/extras/74b2da43e8a2759c0a4fdfbae9d1a678.poster.avif?t=1734535695\" width=600 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2911850/extras/74b2da43e8a2759c0a4fdfbae9d1a678.webm?t=1734535695\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2911850/extras/74b2da43e8a2759c0a4fdfbae9d1a678.mp4?t=1734535695\" type=\"video/mp4\"></video></span><br><br><i>The game was developed to commemorate the centenary of Kafka\u2019s death and was developed in cooperation with the Goethe-Institut, Prague.</i><br><br><i>\u200bThe Chinese language version was initiated and supported by the Czech Centre Taipei.</i><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2911850/extras/ed542a7704e55146ff0e5548dfab9c36.avif?t=1734535695\" width=616 height=147 /></span>","developers":["Charles Games"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2911850/header.jpg?t=1734535695","is_free":true,"legal_notice":"\u00a9 Charles Games","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OS X v10.13 and higher<br></li><li><strong>Processor:</strong> both Apple  Silicon and Intel are supported<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Storage:</strong> 800 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2911850/685813/71111388acc0097dadb240f830698464fbf8acfc/175088