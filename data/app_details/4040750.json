om/store_item_assets/steam/apps/4040750/d05afb0ba6ccb14232f6180d3d03e3e690ae0dd7/ss_d05afb0ba6ccb14232f6180d3d03e3e690ae0dd7.1920x1080.jpg?t=1763399600","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4040750/d05afb0ba6ccb14232f6180d3d03e3e690ae0dd7/ss_d05afb0ba6ccb14232f6180d3d03e3e690ae0dd7.600x338.jpg?t=1763399600"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4040750/7ee4baef32e28d6b6491574c9efda0457340519d/ss_7ee4baef32e28d6b6491574c9efda0457340519d.1920x1080.jpg?t=1763399600","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4040750/7ee4baef32e28d6b6491574c9efda0457340519d/ss_7ee4baef32e28d6b6491574c9efda0457340519d.600x338.jpg?t=1763399600"}],"short_description":"Paradoxical is a first-person mind-bending puzzle game with impossible spaces and groundbreaking portal mechanics. Explore surreal environments where perspective and illusion intertwine. Challenge logic, question what's real and possible.","steam_appid":4040750,"support_info":{"email":"guubebra@gmail.com","url":""},"supported_languages":"English, Portuguese - Brazil, Japanese","type":"game","website":"https://venn-studios.com/games/paradoxical"}