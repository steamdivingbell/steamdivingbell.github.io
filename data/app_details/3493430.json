eam/apps/3493430/153a96bbdc1561d85376848afa5a5401f9f603ea/ss_153a96bbdc1561d85376848afa5a5401f9f603ea.600x338.jpg?t=1759324417"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3493430/74430c8e43768773e0385fb24136bd8a1ada4b63/ss_74430c8e43768773e0385fb24136bd8a1ada4b63.1920x1080.jpg?t=1759324417","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3493430/74430c8e43768773e0385fb24136bd8a1ada4b63/ss_74430c8e43768773e0385fb24136bd8a1ada4b63.600x338.jpg?t=1759324417"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3493430/08776a5aa3cbd55130252c068dd6cdb09dc70059/ss_08776a5aa3cbd55130252c068dd6cdb09dc70059.1920x1080.jpg?t=1759324417","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3493430/08776a5aa3cbd55130252c068dd6cdb09dc70059/ss_08776a5aa3cbd55130252c068dd6cdb09dc70059.600x338.jpg?t=1759324417"}],"short_description":"Assemble your party to survive in this dice-management game! Master steel and magic: roll dice and next use them to attack directly or for powerful abilities. Scout, light a fire, use ancient runes or equip perks to prepare before battle. Use tactics to fight monsters and Unhallowed. Set a watch!","steam_appid":3493430,"support_info":{"email":"contact@acram.eu","url":""},"supported_languages":"English, Polish","type":"game","website":"https://acram.eu"}