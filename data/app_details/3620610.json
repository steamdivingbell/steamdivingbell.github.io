r><strong>Steam Next Fest Demo</strong>: February 23 \u2013 March 2, 2026<br><strong>Early Access</strong>: Q3\u2013Q4 2026</p><p class=\"bb_paragraph\" ></p>","developers":["Quantum Box"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3620610/8641936cb05e52ad6c3df58d78725d24122f949c/header.jpg?t=1768434157","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3620610/1781766262/e4124406209a969e23b38c39afe564a7f0670b86/1761527668/dash_av1.mpd?t=1761849097","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3620610/1781766262/e4124406209a969e23b38c39afe564a7f0670b86/1761527668/dash_h264.mpd?t=1761849097","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3620610/1781766262/e4124406209a969e23b38c39afe564a7f0670b86/1761527668/hls_264_master.m3u8?t=1761849097","id":257222920,"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257222920/d83c0081e6137cb1890ba6bdcb965297240cc293/movie_600x337.jpg?t=1761849097"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3620610/1453578521/d8ee27ee21ceac8d2cbee7cd02431f87fe048b1e/1763373153/dash_av1.mpd?t=1763379859","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3620610/1453578521/d8ee27ee21ceac8d2cbee7cd02431f87fe048b1e/1763373153/dash_h264.mpd?t=1763379859","highlight":false,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3620610/1453578521/d8ee27ee21ceac8d2cbee7cd02431f87fe048b1e/1763373153/hls_264_master.m3u8?t=1763379859","id":257233178,"name":"Pre-Alpha Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257233178/9c97952a6b477bd7d0a53a835cb03d9200a74383/movie_600x337.jp