tore_item_assets/steam/apps/3437820/8d83db3d8098cf957331a68d62f2856f0c065c3e/ss_8d83db3d8098cf957331a68d62f2856f0c065c3e.600x338.jpg?t=1758426824"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/c16883d71ced0a0092e038a66b259873eff59320/ss_c16883d71ced0a0092e038a66b259873eff59320.1920x1080.jpg?t=1758426824","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/c16883d71ced0a0092e038a66b259873eff59320/ss_c16883d71ced0a0092e038a66b259873eff59320.600x338.jpg?t=1758426824"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/3e21482764cf5f5629c27e01dc701b6c453d702b/ss_3e21482764cf5f5629c27e01dc701b6c453d702b.1920x1080.jpg?t=1758426824","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/3e21482764cf5f5629c27e01dc701b6c453d702b/ss_3e21482764cf5f5629c27e01dc701b6c453d702b.600x338.jpg?t=1758426824"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/74fd1cc60d17d1c30654e4ce15a7ebbcdcfd4d4e/ss_74fd1cc60d17d1c30654e4ce15a7ebbcdcfd4d4e.1920x1080.jpg?t=1758426824","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/74fd1cc60d17d1c30654e4ce15a7ebbcdcfd4d4e/ss_74fd1cc60d17d1c30654e4ce15a7ebbcdcfd4d4e.600x338.jpg?t=1758426824"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/3a968e5222f03c0e4e3d56b2473fc13ce595ddb3/ss_3a968e5222f03c0e4e3d56b2473fc13ce595ddb3.1920x1080.jpg?t=1758426824","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/3a968e5222f03c0e4e3d56b2473fc13ce595ddb3/ss_3a968e5222f03c0e4e3d56b2473fc13ce595ddb3.600x338.jpg?t=1758426824"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/c21c70f3a3802c15c0e53f04eda9b714ce528c40/ss_c21c70f3a3802c15c0e53f04eda9b714ce528c40.1920x1080.jpg?t=1758426824","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/c21c70f3a3802c15c0e53f04eda9b714ce528c40/ss_c21c70f3a3802c15c0e53f04eda9b714ce528c40.600x338.jpg?t=1758426824"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/cfd18e923b08719456086fe611b291be373af255/ss_cfd18e923b08719456086fe611b291be373af255.1920x1080.jpg?t=1758426824","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/cfd18e923b08719456086fe611b291be373af255/ss_cfd18e923b08719456086fe611b291be373af255.600x338.jpg?t=1758426824"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/60b11bed7f1486c23438a20ebd378e6364b87cba/ss_60b11bed7f1486c23438a20ebd378e6364b87cba.1920x1080.jpg?t=1758426824","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437820/60b11bed7f1486c23438a20ebd378e6364b87cba/ss_60b11bed7f1486c23438a20ebd378e6364b87cba.600x338.jpg?t=1758426824"}],"short_description":"Wiped Clean VR is a story-driven crime scene cleaning game where you play as an undercover agent piecing together a dangerous conspiracy. Use specialized tools to scrub away evidence, discover secrets, and navigate dark, gritty environments in your search for the hitman, Victor Kane.","steam_appid":3437820,"support_info":{"email":"luminarycreationsofficial@gmail.com","url":"https://www.luminarycreations.net/contact-us"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.luminarycreations.net/"}