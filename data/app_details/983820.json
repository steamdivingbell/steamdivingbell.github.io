3820/extras/2fb859a222cf3959754b299bcff1a686.webm?t=1577013219\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/983820/extras/2fb859a222cf3959754b299bcff1a686.mp4?t=1577013219\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/983820/extras/8b0ea2f396ea975209792862d6de5894.poster.avif?t=1577013219\" width=532 height=382 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/983820/extras/8b0ea2f396ea975209792862d6de5894.webm?t=1577013219\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/983820/extras/8b0ea2f396ea975209792862d6de5894.mp4?t=1577013219\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/983820/extras/1bcbcbc871a369bef04c1c3996a088a2.poster.avif?t=1577013219\" width=474 height=232 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/983820/extras/1bcbcbc871a369bef04c1c3996a088a2.webm?t=1577013219\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/983820/extras/1bcbcbc871a369bef04c1c3996a088a2.mp4?t=1577013219\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >PERFORMANCE</h2><ul class=\"bb_ul\"><li>RainWidget aims to deliver an entertaining experience using as few system resources as possible. <br></li><li>All the animated widgets have been optimised to bring great visuals and fast system performance at the same time.<br></li><li>Various options to tweak quality and performance exist to make widgets suit your needs. <br></li><li>As a general rule of thumb, static based widgets will perform best, while full animations widgets will require more resources from your system. <br></li><li>A dedicated GPU is highly recommended, but not required.</li></ul><h2 class=\"bb_tag\" >FAQ</h2>Q: How to config shortcuts in widget?<br>A: Please right click widget and select menuitem &quot;Settings...&quot;<br><br>Q: How to change widget size or zoom in/out widget?<br>A: Please right click widget and select menuitem &quot;Window &gt; Zoom&quot;<br><br>Q: How to change widget Opacity?<br>A: Please right click widget and select menuitem &quot;Window &gt; Opacity&quot;<br><br>Q: How to create widget?<br>A: Right click the tray icon of RainWidget and select the menu item &quot;Create Widget&quot;,it will auto create a simple widget from template and run it on your desktop,and it will auto open the folder of the widget and list all the widget's files e.g. HTML CSS JS , you can edit the files and then click the widget and select menu item &quot;Refresh&quot; or press F5 to update widget.","developers":["RainySoft"],"genres":[{"description":"Animation & Modeling","id":"51"},{"description":"Design & Illustration","id":"53"},{"description":"Utilities","id":"57"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/983820/header.jpg?t=1577013219","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/983820/196482/c293a451ad9326834a052635b8679f0bb824146b/1751172188/dash_av1.mpd?t=1542786398","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/983820/196482/c293a451ad9326834a052635b8679f0bb824146b/1751172188/dash_h264.mpd?t=1542786398","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/983820/196482/c293a451ad9326834a052635b8679f0bb824146b/1751172188/hls_264_master.m3u8?t=1542786398","id":256735893,"name":"first","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/25673589