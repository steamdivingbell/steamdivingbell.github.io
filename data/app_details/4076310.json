42a03d1feeb3d19/ss_c4553d87f0efd3fdb9d99aa0e42a03d1feeb3d19.1920x1080.jpg?t=1759696031","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4076310/c4553d87f0efd3fdb9d99aa0e42a03d1feeb3d19/ss_c4553d87f0efd3fdb9d99aa0e42a03d1feeb3d19.600x338.jpg?t=1759696031"}],"short_description":"Hop on kayaks and boats for a fun adventure with up to 8 friends! Work together to paddle through cool waters, overcome obstacles and bosses, and reach new islands. If the legend is true, a hidden treasure awaits on the final island. Can you make it without sinking?","steam_appid":4076310,"support_info":{"email":"boattogethergame@gmail.com","url":""},"supported_languages":"English","type":"demo","website":null}