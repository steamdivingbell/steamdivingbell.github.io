68b0332e560c7ff7faa7cb0af.webm?t=1775566461\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1096140/extras/8d7693368b0332e560c7ff7faa7cb0af.mp4?t=1775566461\" type=\"video/mp4\"></video></span><br><br><strong>Skill Tree:</strong> Choose how your spells upgrade -- yielding ever more powerful magic and intricate build choices!<br><br><strong>Original Soundtrack:</strong> Sumptuous, expansive soundtrack filled with epic moments (and a few earworms)!<br><br><br>This game was made by an indie team of 3 people who prioritized innovative game mechanics over AAA graphics; and we hope you'll love TimeMelters as much as we do!<br>Happy gaming!","developers":["Autoexec Games"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1096140/header.jpg?t=1775566461","is_free":false,"legal_notice":"Copyright Autoexec Games inc.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"metacritic":{"score":89,"url":"https://www.metacritic.com/game/pc/timemelters?ftag=MCD-06-10aaa1f"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1096140/708025/8a05ca7335db3fa8272b53c40c0a59a943adc2f3/1750618320/dash_av1.mpd?t=1774375713","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1096140/708025/8a05ca7335db3fa8272b53c40c0a59a943adc2f3/1750618320/dash_h264.mpd?t=1774375713","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1096140/708025/8a05ca7335db3fa8272b53c40c0a59a943adc2f3/1750618320/hls_264_master.m3u8?t=1774375713","id":257027569,"name":"G