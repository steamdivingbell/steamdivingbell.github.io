<p class=\"bb_paragraph\" >Multiple layers of Axis with escalating difficulty and bosses</p></li><li><p class=\"bb_paragraph\" >Temporary upgrades between battles and permanent unlocks with Influence</p></li><li><p class=\"bb_paragraph\" >Endless score-chasing replayability for roguelite fans</p></li></ul>","developers":["Daniel Fevriere"],"genres":[{"description":"Action","id":"1"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026160/c207de79a1f2a14589ca078889a0d192177e1b46/header.jpg?t=1765811658","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4026160/814726653/98a09c05dad0d8157a547bead2075433a0731f9b/1759872803/dash_av1.mpd?t=1759873235","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4026160/814726653/98a09c05dad0d8157a547bead2075433a0731f9b/1759872803/dash_h264.mpd?t=1759873235","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4026160/814726653/98a09c05dad0d8157a547bead2075433a0731f9b/1759872803/hls_264_master.m3u8?t=1759873235","id":257213217,"name":"Contraxis Demo Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257213217/288fb63fe7591f4ac40a7ed5cddb526d214d5cdd/movie_600x337.jpg?t=1759873235"}],"name":"CONTRAXIS","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Storage:</strong> 200 MB available space<br></li><li><strong>Sound Card:</strong> what is a sound card</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10<br></li><li><strong>Memory:</strong> 4 GB RAM</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Studio IFX"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"10","rating_generated":"1