steam/apps/3950070/4e88ac08ebfc1d6d8c238f04499cbeaee230b71a/ss_4e88ac08ebfc1d6d8c238f04499cbeaee230b71a.600x338.jpg?t=1765920858"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950070/306a73de107aa34bf5d846267c80d4678b78a3f6/ss_306a73de107aa34bf5d846267c80d4678b78a3f6.1920x1080.jpg?t=1765920858","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950070/306a73de107aa34bf5d846267c80d4678b78a3f6/ss_306a73de107aa34bf5d846267c80d4678b78a3f6.600x338.jpg?t=1765920858"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950070/e7f585e5c92677406d6e8414183bf3b2b6c15721/ss_e7f585e5c92677406d6e8414183bf3b2b6c15721.1920x1080.jpg?t=1765920858","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950070/e7f585e5c92677406d6e8414183bf3b2b6c15721/ss_e7f585e5c92677406d6e8414183bf3b2b6c15721.600x338.jpg?t=1765920858"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950070/b799cb3c857e258ca9368ba5c4db02e7d8b0ade5/ss_b799cb3c857e258ca9368ba5c4db02e7d8b0ade5.1920x1080.jpg?t=1765920858","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950070/b799cb3c857e258ca9368ba5c4db02e7d8b0ade5/ss_b799cb3c857e258ca9368ba5c4db02e7d8b0ade5.600x338.jpg?t=1765920858"}],"short_description":"An intergalactic mission gone horribly wrong! The alien brothers tried to land on Earth, but got lost and are now in the middle of a human maelstrom! Control the UvU drone and bring order to the chaos in this unique adventure.","steam_appid":3950070,"support_info":{"email":"escalembur@gmail.com","url":""},"supported_languages":"English, Portuguese - Brazil<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}