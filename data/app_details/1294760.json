5ad9fd4f61001ae31.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_51f0daf0264860fc1caf7505ad9fd4f61001ae31.600x338.jpg?t=1776959926"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_80b51d4e79ff7487103ed19528cc0e9411a79f28.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_80b51d4e79ff7487103ed19528cc0e9411a79f28.600x338.jpg?t=1776959926"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_ddc418abd7eee1717dd92457f33b89320726cf2a.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_ddc418abd7eee1717dd92457f33b89320726cf2a.600x338.jpg?t=1776959926"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_7bfe8ab301def741bd0844b31fa7ee391e218f0f.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_7bfe8ab301def741bd0844b31fa7ee391e218f0f.600x338.jpg?t=1776959926"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_1fbd31922ced762c345e8f0998a12c0cdd7d02fb.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_1fbd31922ced762c345e8f0998a12c0cdd7d02fb.600x338.jpg?t=1776959926"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_98ebabd5f730b99443cd54d354390736ccfbebcb.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_98ebabd5f730b99443cd54d354390736ccfbebcb.600x338.jpg?t=1776959926"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_a6f21c298f1ebdebf0f3eac546de393748e6f4f5.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_a6f21c298f1ebdebf0f3eac546de393748e6f4f5.600x338.jpg?t=1776959926"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_36b03a262f2e7d8150fa94adf9a95e405691c8b6.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_36b03a262f2e7d8150fa94adf9a95e405691c8b6.600x338.jpg?t=1776959926"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_1937b29cdf0771e3d9201b15437d4f8f16d5fa62.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_1937b29cdf0771e3d9201b15437d4f8f16d5fa62.600x338.jpg?t=1776959926"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_5b412232a3743c40539fa993f624e6b54996c564.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_5b412232a3743c40539fa993f624e6b54996c564.600x338.jpg?t=1776959926"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_5174bf5148e5bc00df949d44bf878896158eaa79.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_5174bf5148e5bc00df949d44bf878896158eaa79.600x338.jpg?t=1776959926"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_ba8ecf75f25e97745142b34d017ce4a8e4de830e.1920x1080.jpg?t=1776959926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1294760/ss_ba8ecf75f25e97745142b34d017ce4a8e4de830e.600x338.jpg?t=1776959926"}],"short_description":"HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes.","steam_appid":1294760,"support_info":{"email":"hello@gexagon.com","url":"https://www.gexagon.com"},"supported_languages":"English<strong>*</strong>, Simplified Chinese, Russian, Traditional Chinese, German, Spanish - Spain, Greek, Czech, Finnish, Japanese, Korean, Portuguese - Brazil, Swedish, French, Polish, Danish, Dutch, Turkish, Ukrainian, Italian, Arabic, Thai, Vietnamese, Hungarian, Norwegian, Romanian, Hebrew, Hindi<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.gexagon.com"}