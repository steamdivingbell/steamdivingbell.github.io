67f4c897f7017ef0769fa26a/ss_17cd025fd521523a67f4c897f7017ef0769fa26a.1920x1080.jpg?t=1770816320","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2334400/17cd025fd521523a67f4c897f7017ef0769fa26a/ss_17cd025fd521523a67f4c897f7017ef0769fa26a.600x338.jpg?t=1770816320"}],"short_description":"The Tale of LUMI is a fast paced, metroidvania inspired, action game. Collect powers from Gods and Heroes. Upgrade your Skills. Defeat unyielding enemies. Explore LUMI and unveil the secrets that lie within this puzzling Kingdom.","steam_appid":2334400,"support_info":{"email":"hello@gamerxpstudio.com","url":"https://gamerxparena.com.br/lumi"},"supported_languages":"English<strong>*</strong>, Portuguese - Brazil, Simplified Chinese, Spanish - Spain, Spanish - Latin America<br><strong>*</strong>languages with full audio support","type":"game","website":"https://thetaleoflumi.com"}