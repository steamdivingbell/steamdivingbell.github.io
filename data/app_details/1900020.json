amai.steamstatic.com/store_item_assets/steam/apps/1900020/66d866c6e1dc657ec5388898afeb617091c14201/ss_66d866c6e1dc657ec5388898afeb617091c14201.600x338.jpg?t=1768239674"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1900020/6e8377201ab13d8e4685492380bd85c076dff9a9/ss_6e8377201ab13d8e4685492380bd85c076dff9a9.1920x1080.jpg?t=1768239674","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1900020/6e8377201ab13d8e4685492380bd85c076dff9a9/ss_6e8377201ab13d8e4685492380bd85c076dff9a9.600x338.jpg?t=1768239674"}],"short_description":"PunjiVR is an unforgiving tactical shooter set during the Vietnam War. Gameplay is non-linear, replayable, and intense. This is not just &quot;another VR shooter&quot; or a tech demo. The jungle wants you dead, will you give in?","steam_appid":1900020,"support_info":{"email":"","url":"https://discord.gg/U4W5Wm529S"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}