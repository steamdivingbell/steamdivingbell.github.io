an class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3948200/extras/c1b674a648d35c01ef680042ee799f11.poster.avif?t=1760088393\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3948200/extras/c1b674a648d35c01ef680042ee799f11.webm?t=1760088393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3948200/extras/c1b674a648d35c01ef680042ee799f11.mp4?t=1760088393\" type=\"video/mp4\"></video></span></p></li><li><p class=\"bb_paragraph\" ><strong>Dynamic Threat:</strong> The ghost train isn\u2019t bound to a single track \u2014 it roams. It hears. It hunts.</p></li></ul><p class=\"bb_paragraph\" >This is not a shooter. It\u2019s a horror game where survival comes from being quiet, thinking fast, and paying attention to every sound in the darkness.</p>","developers":["CGI LAB GAMES SRL"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3948200/ea70b939d143960b201329ad6e82686f5177d6c8/header.jpg?t=1760088393","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3948200/2024933558/7c916cc1b792a5cd6ad69335ca1c1a6c4c98761f/1754919355/dash_av1.mpd?t=1755065866","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3948200/2024933558/7c916cc1b792a5cd6ad69335ca1c1a6c4c98761f/1754919355/dash_h264.mpd?t=1755065866","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3948200/2024933558/7c916cc1b792a5cd6ad69335ca1c1a6c4c98761f/1754919355/hls_264_master.m3u8?t=1755065866","id":257181546,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257181546/