assets/steam/apps/2678830/249d27a867b1a5f6ffbcf286ba981667feae31a0/ss_249d27a867b1a5f6ffbcf286ba981667feae31a0.600x338.jpg?t=1749467223"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2678830/aec4095b53b0da88d3108e1673047184e3fad21c/ss_aec4095b53b0da88d3108e1673047184e3fad21c.1920x1080.jpg?t=1749467223","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2678830/aec4095b53b0da88d3108e1673047184e3fad21c/ss_aec4095b53b0da88d3108e1673047184e3fad21c.600x338.jpg?t=1749467223"}],"short_description":"Welcome to Taoyuan Village to heal your loneliness. Here, you can lead a carefree, self-sufficient life: farm, tame animals, raise livestock, fish, and build a prosperous homestead. Or, immerse in village life, meet kindred spirits, find love, and influence their destinies with your choices.","steam_appid":2678830,"support_info":{"email":"3639498378@qq.com","url":""},"supported_languages":"Simplified Chinese<strong>*</strong>, English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}