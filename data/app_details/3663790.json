0/6e0ce4e518aa88f9ba64cc2f094d041d4a1d5eb6/ss_6e0ce4e518aa88f9ba64cc2f094d041d4a1d5eb6.600x338.jpg?t=1771879314"}],"short_description":"A sci-fi survival game on a hostile alien world. As a lone robotic unit, manage resources, upgrade your systems, face extreme weather, and uncover the mystery of the three moons through choices that shape your fate.","steam_appid":3663790,"support_info":{"email":"contact@beyondaetherstudio.com","url":""},"supported_languages":"English, French, Spanish - Spain, Simplified Chinese, Traditional Chinese, Greek, Portuguese - Brazil, Spanish - Latin America","type":"game","website":null}