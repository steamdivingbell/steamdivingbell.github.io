store_item_assets/steam/apps/3588360/b2076e0a667ff321ae5691871ed2c3abfa598501/ss_b2076e0a667ff321ae5691871ed2c3abfa598501.600x338.jpg?t=1756667985"}],"short_description":"Stressed out from life, you decide to take an impromptu weekend hike through the mountains. As you go on your way, it seems like the stresses of life followed you into the woods. Once you get to the trailer home for the night, you should feel a bit better.","steam_appid":3588360,"support_info":{"email":"nopathforwardgame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}