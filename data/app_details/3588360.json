0b893164cfd0bd624427ecaffb6c177d6c622a04/ss_0b893164cfd0bd624427ecaffb6c177d6c622a04.600x338.jpg?t=1761761358"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3588360/d6c731b47366d4df28f75d217cba669d947b83a0/ss_d6c731b47366d4df28f75d217cba669d947b83a0.1920x1080.jpg?t=1761761358","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3588360/d6c731b47366d4df28f75d217cba669d947b83a0/ss_d6c731b47366d4df28f75d217cba669d947b83a0.600x338.jpg?t=1761761358"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3588360/411ea1c7491e9801a4913d8bf1840e3312d6aaf8/ss_411ea1c7491e9801a4913d8bf1840e3312d6aaf8.1920x1080.jpg?t=1761761358","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3588360/411ea1c7491e9801a4913d8bf1840e3312d6aaf8/ss_411ea1c7491e9801a4913d8bf1840e3312d6aaf8.600x338.jpg?t=1761761358"}],"short_description":"Stressed out from life, you decide to take an impromptu weekend hike through the mountains. As you go on your way, it seems like the stresses of life followed you into the woods. Once you get to the trailer home for the night, you should feel a bit better.","steam_appid":3588360,"support_info":{"email":"nopathforwardgame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}