1766129207"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2947280/780172c614797d5290443e383db869f0178ed67b/ss_780172c614797d5290443e383db869f0178ed67b.1920x1080.jpg?t=1766129207","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2947280/780172c614797d5290443e383db869f0178ed67b/ss_780172c614797d5290443e383db869f0178ed67b.600x338.jpg?t=1766129207"}],"short_description":"Solateria is a hand-drawn action Metroidvania with parry-focused combat. A small fire warrior journeys to find the Primordial Flame, the world\u2019s last hope against the Shadow Plague. Defeat foes with stylish parries and explore mysterious realms to uncover the world\u2019s secrets.","steam_appid":2947280,"support_info":{"email":"contact@studiodoodal.com","url":"https://discord.gg/tqqMPrbZWH"},"supported_languages":"English, Japanese, Korean, Simplified Chinese, Traditional Chinese, German, Spanish - Spain, Portuguese - Portugal","type":"game","website":null}