/3268290/d9240985e19078e2d580e77d9a13f2e51b905f57/ss_d9240985e19078e2d580e77d9a13f2e51b905f57.600x338.jpg?t=1773668275"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3268290/04b0156808a81404c6d11cd256ba341d82ba6f1f/ss_04b0156808a81404c6d11cd256ba341d82ba6f1f.1920x1080.jpg?t=1773668275","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3268290/04b0156808a81404c6d11cd256ba341d82ba6f1f/ss_04b0156808a81404c6d11cd256ba341d82ba6f1f.600x338.jpg?t=1773668275"}],"short_description":"ChessFinity is chess reimagined in 3D\u2014plus Mana Chess deckbuilding. Explore curated variants, strange new pieces, puzzles and chaotic mini\u2011games on boards you\u2019ve never seen before.","steam_appid":3268290,"support_info":{"email":"team@chessfinity.xyz","url":""},"supported_languages":"English, French, Simplified Chinese, Ukrainian, Hindi, Tamil, Italian, German, Spanish - Spain, Japanese, Russian","type":"game","website":"https://chessfinity.xyz"}