"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449390/479fec180a6e0fbfb06fe6c25f14bcce192c80b8/ss_479fec180a6e0fbfb06fe6c25f14bcce192c80b8.600x338.jpg?t=1750849811"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449390/d5ad629a4a5aa1e3f786890fdbd858efac6d41ff/ss_d5ad629a4a5aa1e3f786890fdbd858efac6d41ff.1920x1080.jpg?t=1750849811","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449390/d5ad629a4a5aa1e3f786890fdbd858efac6d41ff/ss_d5ad629a4a5aa1e3f786890fdbd858efac6d41ff.600x338.jpg?t=1750849811"}],"short_description":"Embark into a deck-building roguelike where real-time action will challenge your reaction and strategy skills. Face the deadliest criminals in intense turn-based combat, where each card defines the pace of the battle and save the city from the Vegangsters!","steam_appid":2449390,"support_info":{"email":"info@poisonpillgames.com","url":"https://poisonpillgames.com/en/contact/"},"supported_languages":"English, Spanish - Spain","type":"game","website":null}