tatic.com/store_item_assets/steam/apps/2920010/ss_f9606fb850e6945e4a265e1ba38100924ec3d1d1.600x338.jpg?t=1758688827"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920010/ss_29fea5e38a56735588264bb0945d0e0fa2bab7b1.1920x1080.jpg?t=1758688827","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920010/ss_29fea5e38a56735588264bb0945d0e0fa2bab7b1.600x338.jpg?t=1758688827"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920010/ss_857b9c9152861168253de5143b9ab576ff0d1fc6.1920x1080.jpg?t=1758688827","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920010/ss_857b9c9152861168253de5143b9ab576ff0d1fc6.600x338.jpg?t=1758688827"}],"short_description":"Comet Angel is a sci-fi yuri narrative adventure with point and click puzzles. Join teenagers Izzy and Nat on an emotional journey of self-discovery and acceptance as they make humanity's first-ever alien contact.","steam_appid":2920010,"support_info":{"email":"crosscouloircc@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://linktr.ee/cross_couloir"}