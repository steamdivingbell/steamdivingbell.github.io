.com/store_item_assets/steam/apps/3092280/4034bc7ec81eac304bb1ea8770151e2a4e5b9d1d/ss_4034bc7ec81eac304bb1ea8770151e2a4e5b9d1d.1920x1080.jpg?t=1747741160","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092280/4034bc7ec81eac304bb1ea8770151e2a4e5b9d1d/ss_4034bc7ec81eac304bb1ea8770151e2a4e5b9d1d.600x338.jpg?t=1747741160"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092280/7d4774c2c6a26107dea084c0bbe354e88805af08/ss_7d4774c2c6a26107dea084c0bbe354e88805af08.1920x1080.jpg?t=1747741160","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092280/7d4774c2c6a26107dea084c0bbe354e88805af08/ss_7d4774c2c6a26107dea084c0bbe354e88805af08.600x338.jpg?t=1747741160"}],"short_description":"&quot;Guardians Of Restoration&quot; is a top-down robot action game that combines action and bullet hell elements. Level up within a set time to enjoy thrilling battles against various bosses. Each boss randomly possesses one of three traits, ensuring a unique and exciting experience every time you play.","steam_appid":3092280,"support_info":{"email":"blackgoraegames.dev@gmail.com","url":""},"supported_languages":"English, Japanese, Korean, French, Italian, German, Spanish - Spain, Russian, Simplified Chinese, Portuguese - Portugal, Polish","type":"game","website":null}