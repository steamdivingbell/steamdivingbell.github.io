th_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3837720/8d59bd11a9cf2aa66eeb28d58e07f290ea90fde6/ss_8d59bd11a9cf2aa66eeb28d58e07f290ea90fde6.600x338.jpg?t=1768836614"}],"short_description":"PRAY OR DIE is a game that combines the genres of survivor-like, tower defense, MOBA, and action roguelite. Players must build defense towers on the island, equip their sailboat with weapons, and pray to Guardian Spirits for powerful blessings to protect the island from invaders and corruption.","steam_appid":3837720,"support_info":{"email":"hyperego1221@gmail.com","url":"https://www.instagram.com/hyperegogames/"},"supported_languages":"English, Japanese, Simplified Chinese, Korean","type":"game","website":null}