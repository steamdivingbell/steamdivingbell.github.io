4bb36a738c2678607ef102adf86/ss_a381b9b3126444bb36a738c2678607ef102adf86.600x338.jpg?t=1755076330"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/e7c88ec4884c8b7ebec323c8a02c5715ef2cb36f/ss_e7c88ec4884c8b7ebec323c8a02c5715ef2cb36f.1920x1080.jpg?t=1755076330","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/e7c88ec4884c8b7ebec323c8a02c5715ef2cb36f/ss_e7c88ec4884c8b7ebec323c8a02c5715ef2cb36f.600x338.jpg?t=1755076330"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/8bb912c95e5948d103ba4703840b0544f459de8d/ss_8bb912c95e5948d103ba4703840b0544f459de8d.1920x1080.jpg?t=1755076330","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/8bb912c95e5948d103ba4703840b0544f459de8d/ss_8bb912c95e5948d103ba4703840b0544f459de8d.600x338.jpg?t=1755076330"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/133f3c5eacf664bedc2f89bc1e10eb1349e7e084/ss_133f3c5eacf664bedc2f89bc1e10eb1349e7e084.1920x1080.jpg?t=1755076330","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/133f3c5eacf664bedc2f89bc1e10eb1349e7e084/ss_133f3c5eacf664bedc2f89bc1e10eb1349e7e084.600x338.jpg?t=1755076330"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/c153a6f454662bf84cc21655fa4cd21dcbf358ad/ss_c153a6f454662bf84cc21655fa4cd21dcbf358ad.1920x1080.jpg?t=1755076330","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/c153a6f454662bf84cc21655fa4cd21dcbf358ad/ss_c153a6f454662bf84cc21655fa4cd21dcbf358ad.600x338.jpg?t=1755076330"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/c00f85bf0dee810cd211c12af71ad350d99c160d/ss_c00f85bf0dee810cd211c12af71ad350d99c160d.1920x1080.jpg?t=1755076330","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920750/c00f85bf0dee810cd211c12af71ad350d99c160d/ss_c00f85bf0dee810cd211c12af71ad350d99c160d.600x338.jpg?t=1755076330"}],"short_description":"Bubble Gun is a frantic 2D party brawler where chaos rules the arena. You play as a bubble, armed with two hands slots and a wild arsenal. Every weapon and environment effect can be combined, manipulated, and exploited for over-the-top fun.","steam_appid":3920750,"support_info":{"email":"","url":"http://www.digitalemergenceltd.com/contact"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Portuguese - Portugal","type":"demo","website":"http://www.digitalemergenceltd.com/bubble-gun"}