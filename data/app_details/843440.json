cond wind on writing (clever?!) sound card details? There's only one way to know... --&gt; Turn to page 37 if you want to know.  --&gt; Turn to page 52 if you think this bit went terribly.<br></li><li><strong>Additional Notes:</strong> The universe is a cruel uncaring void. The key to being happy isn't a search for meaning, it's to just keep yourself busy with unimportant nonsense, and eventually you'll be dead.</li></ul>"},"platforms":{"linux":true,"mac":true,"windows":true},"price_overview":{"currency":"USD","discount_percent":0,"final":99,"final_formatted":"$0.99 USD","initial":99,"initial_formatted":""},"publishers":["Adamvision Studios"],"ratings":{"dejus":{"rating":"l"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"recommendations":{"total":170},"release_date":{"coming_soon":false,"date":"14 May, 2018"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/843440/ss_66764f31a11af22b8e82d45451f63a6f6f2b6dc7.1920x1080.jpg?t=1745903582","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/843440/ss_66764f31a11af22b8e82d45451f63a6f6f2b6dc7.600x338.jpg?t=1745903582"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/843440/ss_79faebdbdbe2815cf3682b55ae1ba1d2b5537b7a.1920x1080.jpg?t=1745903582","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/843440/ss_79faebdbdbe2815cf3682b55ae1ba1d2b5537b7a.600x338.jpg?t=1745903582"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/843440/ss_b1f001e3559fb0369f5e680ec8a54664eb153340.1920x1080.jpg?t=1745903582","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/843440/ss_b1f001e3559fb0369f5e680ec8a54664eb153340.600x338.jpg?t=1745903582"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/st