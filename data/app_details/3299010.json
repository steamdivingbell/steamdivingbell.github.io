apps/3299010/extras/0beb97ea33c3287e221456d463bc45d4.webm?t=1762541613\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3299010/extras/0beb97ea33c3287e221456d463bc45d4.mp4?t=1762541613\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Meet memorable NPCs, trade hard-earned resources, and take on missions from those clinging to what's left. Scavenge the ruins for materials to upgrade <strong>your own shelter</strong>, unlock new crafting stations, and build what you need to survive in this unforgiving world. Your base is where plans are made, gear is prepared, and the next day\u2019s survival begins.</p>","developers":["Sinners Bytes"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3299010/9beb68ad7843d2da443e87eb5796a8e4c6d36377/header.jpg?t=1762541613","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 22.04 or 24.04<br></li><li><strong>Processor:</strong> Quad core CPU 2.0+ GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Any OpenGL 3.2+ or Vulkan-capable GPU with 2GB VRAM<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 22.04 or 24.04<br></li><li><strong>Processor:</strong> Quad core CPU 3.0+ GHz<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Any OpenGL 3.2+ or Vulkan-capable GPU with 3GB VRAM<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Big Sur 11.0 or newer<br></li><li><strong>Processor:</strong> M