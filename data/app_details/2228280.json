shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/6f98f2521519623b82e933170fced0cbf398c9ea/ss_6f98f2521519623b82e933170fced0cbf398c9ea.600x338.jpg?t=1746031674"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/89f97d6135a2ec84587e53227f46662f062f19ba/ss_89f97d6135a2ec84587e53227f46662f062f19ba.1920x1080.jpg?t=1746031674","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/89f97d6135a2ec84587e53227f46662f062f19ba/ss_89f97d6135a2ec84587e53227f46662f062f19ba.600x338.jpg?t=1746031674"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/e9be6992b2ea7d9e30ee04080cd4f38079bc11d5/ss_e9be6992b2ea7d9e30ee04080cd4f38079bc11d5.1920x1080.jpg?t=1746031674","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/e9be6992b2ea7d9e30ee04080cd4f38079bc11d5/ss_e9be6992b2ea7d9e30ee04080cd4f38079bc11d5.600x338.jpg?t=1746031674"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/a69f69c49abcf0f48761768c28a6e4c86be471ea/ss_a69f69c49abcf0f48761768c28a6e4c86be471ea.1920x1080.jpg?t=1746031674","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/a69f69c49abcf0f48761768c28a6e4c86be471ea/ss_a69f69c49abcf0f48761768c28a6e4c86be471ea.600x338.jpg?t=1746031674"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/d7fe7668d4b7326015d0157a9276c8e99a5f12e2/ss_d7fe7668d4b7326015d0157a9276c8e99a5f12e2.1920x1080.jpg?t=1746031674","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/d7fe7668d4b7326015d0157a9276c8e99a5f12e2/ss_d7fe7668d4b7326015d0157a9276c8e99a5f12e2.600x338.jpg?t=1746031674"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2228280/f83eb7040a59e5b9199ce543d84c06466158eb4c/ss_f83eb7040a59e5b9199ce543