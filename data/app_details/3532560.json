estart levels.</p></li><li><p class=\"bb_paragraph\">Earn jukebox sounds and fill your gallery with new images!</p></li></ul>","developers":["Eastasiasoft Limited","Yume Game Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3532560/d0feb4c426aac73aaa8cc7fa0280b0fe69d78940/header.jpg?t=1744072903","is_free":false,"legal_notice":"\u00a9 Eastasiasoft Limited, Yume Game Studio. All Rights Reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257111482,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257111482/movie480.mp4?t=1741499485","max":"http://video.akamai.steamstatic.com/store_trailers/257111482/movie_max.mp4?t=1741499485"},"name":"Moe Waifu H Push-Box Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257111482/862742ce5f1f48baf83ab26c9566c15993c58d74/movie_600x337.jpg?t=1741499485","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257111482/movie480_vp9.webm?t=1741499485","max":"http://video.akamai.steamstatic.com/store_trailers/257111482/movie_max_vp9.webm?t=1741499485"}}],"name":"Moe Waifu H Push-Box","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> x64 architecture with SSE2 instruction set support.<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> GTX 660 Ti 2GB or similar<br></li><li><strong>DirectX:</