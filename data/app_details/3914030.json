trong>Hand-drawn visuals inspired by traditional Chinese woodblock prints</strong></p></li></ul>","developers":["\u7a77\u67e5\u7406\u7684\u5e7b\u60f3"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3914030/bc052c8661357cff33a0dab7a76f6783092080e8/header.jpg?t=1770888745","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3914030/1860980131/c3f2b9e101b31fcb58f2dbf95c4b51354ea83b83/1770888025/dash_av1.mpd?t=1770888743","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3914030/1860980131/c3f2b9e101b31fcb58f2dbf95c4b51354ea83b83/1770888025/dash_h264.mpd?t=1770888743","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3914030/1860980131/c3f2b9e101b31fcb58f2dbf95c4b51354ea83b83/1770888025/hls_264_master.m3u8?t=1770888743","id":257285377,"name":"Demo\u516c\u5f00","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257285377/725e4b5f458ac9cdea8307a8439cb713e8c98afc/movie_600x337.jpg?t=1770888743"}],"name":"The 109th Hero","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GT 750<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GT 980<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</stro