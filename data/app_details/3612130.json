/extras/3ada73ec242af7d926531826f5877f50.mp4?t=1752744174\" type=\"video/mp4\"></video></div></p>","developers":["Stack\u00a0to\u00a0Ascension"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3612130/30a6a79054c82ddd3244a47b79077a16dabd8a4e/header.jpg?t=1752744174","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257166338,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257166338/movie480.mp4?t=1751965374","max":"http://video.akamai.steamstatic.com/store_trailers/257166338/movie_max.mp4?t=1751965374"},"name":"PV_EN","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257166338/c87b5d92f79da9e3739532f65702457a196e9377/movie_600x337.jpg?t=1751965374","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257166338/movie480_vp9.webm?t=1751965374","max":"http://video.akamai.steamstatic.com/store_trailers/257166338/movie_max_vp9.webm?t=1751965374"}}],"name":"Stack\u00a0to\u00a0Ascension","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows\u00a07/8.1/10\u00a0x64<br></li><li><strong>Processor:</strong> Intel\u00a0Core\u00a0i3-7100\u00a0or\u00a0AMD\u00a0Athlon\u00a0II\u00a0X4\u00a0860K<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 630<br></li><li><strong>DirectX:</strong> Version 9.0<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> Intel\u00a0Core\u00a0i5-8100<br></li><li><strong>Memory:</