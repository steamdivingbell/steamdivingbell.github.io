illains. Every day, more and more sinister eyes look at you, waiting for your failure.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3150530/extras/afe0e85f2a32ba92af855197a6254c22.poster.avif?t=1755849950\" width=596 height=308 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3150530/extras/afe0e85f2a32ba92af855197a6254c22.webm?t=1755849950\" type=\"video/webm; codecs=vp9\"></video></span></p>","developers":["Pavel Urakov"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3150530/header.jpg?t=1755849950","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257144470,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257144470/movie480.mp4?t=1748025304","max":"http://video.akamai.steamstatic.com/store_trailers/257144470/movie_max.mp4?t=1748025304"},"name":"Lazy Writer Short Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257144470/4baea239dc591c634222d513e56fb5694c2caaba/movie_600x337.jpg?t=1748025304","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257144470/movie480_vp9.webm?t=1748025304","max":"http://video.akamai.steamstatic.com/store_trailers/257144470/movie_max_vp9.webm?t=1748025304"}},{"highlight":false,"id":257054755,"mp4":{"480":