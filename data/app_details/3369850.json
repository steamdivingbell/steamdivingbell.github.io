ng>Chilling Atmosphere</strong>: Experience the haunting ambiance of a quiet sushi bar illuminated by flickering neon lights, with sounds of the city fading into a sinister silence.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Story-Driven Horror</strong>: Piece together the bar\u2019s dark secrets through cryptic notes and unsettling encounters.</p><p class=\"bb_paragraph\" ></p>","developers":["KM Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3369850/header.jpg?t=1767557353","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3369850/796632/27b1f70eb2aaf221acf1b7bcc7e3e3177a4dd5dd/1750844751/dash_av1.mpd?t=1733609094","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3369850/796632/27b1f70eb2aaf221acf1b7bcc7e3e3177a4dd5dd/1750844751/dash_h264.mpd?t=1733609094","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3369850/796632/27b1f70eb2aaf221acf1b7bcc7e3e3177a4dd5dd/1750844751/hls_264_master.m3u8?t=1733609094","id":257079947,"name":"The Sushi Bar | \u5bff\u53f8\u30d0\u30fc Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257079947/2c139b32e8d1c228fabbea5f5c723c0e20fbe5c2/movie_600x337.jpg?t=1733609094"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3369850/790249/679590a3025ea52d1dcc447941f305da04187ccf/1750844751/dash_av1.mpd?t=1732823008","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3369850/790249/679590a3025ea52d1dcc447941f305da04187ccf/1750844751/dash_h264.mpd?t=1732823008","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3369850/790249/679590a3025ea52d1dcc447941f305d