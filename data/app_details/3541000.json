190b41c3036395197cdc0ec5c86bb0/ss_2e0a6de681190b41c3036395197cdc0ec5c86bb0.600x338.jpg?t=1764958786"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541000/35ce0577506805789c02f5212f79deb2fbada711/ss_35ce0577506805789c02f5212f79deb2fbada711.1920x1080.jpg?t=1764958786","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541000/35ce0577506805789c02f5212f79deb2fbada711/ss_35ce0577506805789c02f5212f79deb2fbada711.600x338.jpg?t=1764958786"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541000/93ba8a1ef09349f19428d34f50c00609e4a074c1/ss_93ba8a1ef09349f19428d34f50c00609e4a074c1.1920x1080.jpg?t=1764958786","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3541000/93ba8a1ef09349f19428d34f50c00609e4a074c1/ss_93ba8a1ef09349f19428d34f50c00609e4a074c1.600x338.jpg?t=1764958786"}],"short_description":"Command your champions through a relentless Loop in pursuit of the Grail, where humans clash with the undead. Forge your army, grow your realm, and outwit foes in gripping tactical battles. Triumph, fall, adapt, and rise again - each Loop forges you into a legend.","steam_appid":3541000,"support_info":{"email":"kingdomloop3@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Spanish - Latin America, Simplified Chinese, Korean, Russian","type":"game","website":"https://t.me/kingdom_loop"}