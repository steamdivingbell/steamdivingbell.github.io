ps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3868010/29963210308d7955e2c65d6f62656d26932bdb10/ss_29963210308d7955e2c65d6f62656d26932bdb10.600x338.jpg?t=1767114592"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3868010/be907f8c5e24adfd17cd23cf93f50a9b88f83f02/ss_be907f8c5e24adfd17cd23cf93f50a9b88f83f02.1920x1080.jpg?t=1767114592","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3868010/be907f8c5e24adfd17cd23cf93f50a9b88f83f02/ss_be907f8c5e24adfd17cd23cf93f50a9b88f83f02.600x338.jpg?t=1767114592"}],"short_description":"Launch your newspaper and sway the masses in a unique animal world! Direct reporters, plan stories, blow up Headlines for Impact and throw in Ads for Profit. With every faction gunning for a piece of your front page, how far will you go to keep your paper in print \u2014 and yourself out of trouble?","steam_appid":3868010,"support_info":{"email":"papercodagames@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}