/p><p class=\"bb_paragraph\" >With 4 different victory types, 5 early game overs and 30+ different endings, each playthrough lets you uncover your own unique truth.</p><p class=\"bb_paragraph\" ></p>","developers":["Papercoda Games"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3868010/ecb680db288d035c3493183c0bcce6ab200c540f/header.jpg?t=1767114592","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3868010/448785362/a7ad3a2beba39996b4f17bd753f34aaccf493aef/1754991696/dash_av1.mpd?t=1755241912","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3868010/448785362/a7ad3a2beba39996b4f17bd753f34aaccf493aef/1754991696/dash_h264.mpd?t=1755241912","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3868010/448785362/a7ad3a2beba39996b4f17bd753f34aaccf493aef/1754991696/hls_264_master.m3u8?t=1755241912","id":257178721,"name":"Media Circus - Teaser Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257178721/aede504decc3fdb7198eb74bb61942133e1bac1f/movie_600x337.jpg?t=1755241912"}],"name":"Media Circus","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 and above<br></li><li><strong>Processor:</strong>  1.7 GHz Dual Core<br></li><li><strong>Memory:</strong> 4 MB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 4600<br></li><li><strong>Storage:</strong> 1000 MB available space<br></li><li><strong>Additional Notes:</strong> Requires a 64-bit processor and operating system</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Additional Notes:</strong> Requires a 64-bit processor and operating system</li></ul>"},"platforms":{"lin