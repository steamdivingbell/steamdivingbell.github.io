ever the same.</p><p class=\"bb_paragraph\" >The units you summon shape how you choose runes and upgrades\u2014turning randomness into strategy.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>Will luck be on your side? Or will you fall to the darkness?</i></p><p class=\"bb_paragraph\" ></p>","developers":["JDL"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3304340/1628527495a5b8d6708a277615689068dea4c922/header.jpg?t=1758034951","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3304340/247327400/522224f5b038c006c85227e92c5d7b7ac9bf6b3e/1756041980/dash_av1.mpd?t=1756043429","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3304340/247327400/522224f5b038c006c85227e92c5d7b7ac9bf6b3e/1756041980/dash_h264.mpd?t=1756043429","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3304340/247327400/522224f5b038c006c85227e92c5d7b7ac9bf6b3e/1756041980/hls_264_master.m3u8?t=1756043429","id":257145220,"name":"ELARIENNE","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257145220/e0be4d743056bca56b3ffa164aa77e4e5de2e62c/movie_600x337.jpg?t=1756043429"}],"name":"ELARIENNE","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"ELARIENNE - $7.99 USD","packageid":1170316,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":799}],"title":"Buy ELARIENNE"}],"packages":[1170316],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 64-b