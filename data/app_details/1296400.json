d.akamai.steamstatic.com/store_item_assets/steam/apps/1296400/ebac3ed9f2f9314fc9628d3eb2625eaaf3def010/ss_ebac3ed9f2f9314fc9628d3eb2625eaaf3def010.1920x1080.jpg?t=1764149745","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1296400/ebac3ed9f2f9314fc9628d3eb2625eaaf3def010/ss_ebac3ed9f2f9314fc9628d3eb2625eaaf3def010.600x338.jpg?t=1764149745"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1296400/966ce146495f512d933f4e9a625dfa2541674709/ss_966ce146495f512d933f4e9a625dfa2541674709.1920x1080.jpg?t=1764149745","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1296400/966ce146495f512d933f4e9a625dfa2541674709/ss_966ce146495f512d933f4e9a625dfa2541674709.600x338.jpg?t=1764149745"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1296400/8813bad084c538701b73b47ef6200c0b783d6ed8/ss_8813bad084c538701b73b47ef6200c0b783d6ed8.1920x1080.jpg?t=1764149745","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1296400/8813bad084c538701b73b47ef6200c0b783d6ed8/ss_8813bad084c538701b73b47ef6200c0b783d6ed8.600x338.jpg?t=1764149745"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1296400/f137578218a45f523b098c6cc916facaa64ecebc/ss_f137578218a45f523b098c6cc916facaa64ecebc.1920x1080.jpg?t=1764149745","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1296400/f137578218a45f523b098c6cc916facaa64ecebc/ss_f137578218a45f523b098c6cc916facaa64ecebc.600x338.jpg?t=1764149745"}],"short_description":"Create dream homes! From 3D plan modelling through to on-site decision-making, you must bring each project to life while giving free rein to your creativity, to take your architectural firm to the pinnacle of the profession.","steam_appid":1296400,"support_info":{"email":"support@nacon.fr","url":""},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Dutch, Italian, Traditional Chinese, Korean","type":"game","website":null}