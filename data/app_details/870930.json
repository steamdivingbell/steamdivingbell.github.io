arflowers<br></li><li>Clean up the world with pollution-absorbing plants<br></li><li>Open greenhouses to find rare plants <br></li><li>Unlock mysterious sites with your plant collection<br></li><li>And many more!</li></ul>","developers":["Kestrel Games"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/870930/fe65cc11301db41c67ff5ba1221554914d563431/header.jpg?t=1774468352","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> OSX 10.15 or later<br></li><li><strong>Processor:</strong> Core i5 or equivalent<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Integrated<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 11<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Storage:</strong> 500 GB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/870930/236028225/f6c0a08a9dffa7d82657ad850a42938ca22705e5/1759952606/dash_av1.mpd?t=1760476437","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/870930/236028225/f6c0a08a9dffa7d82657ad850a42938ca22705e5/1759952606/dash_h264.mpd?t=1760476437","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/870930/236028225/f6c0a08a9dffa7d82657ad850a42938ca22705e5/1759952606/hls_264_master.m3u8?t=1760476437","id":257214453,"name":"Gameplay | Farming","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257214453/733e00df5d33282e153f639bcff1285e6b0b61a8/movie_600x337.jpg?t=1760476437"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/870930/1357576831/0345d1c3654efe9704b1d4f7df3a1d1b695bbef1/1760475061/dash_a