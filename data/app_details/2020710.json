ore_item_assets/steam/apps/2020710/f7d1360e88acc5d88c5db21d285c7f2f2966c176/capsule_184x69.jpg?t=1771527614","categories":[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Steam Cloud","id":23},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"demos":[{"appid":2125130,"description":""}],"detailed_description":"<h1>NEW DLC!</h1><p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2020710/extras/624e4c87fbab13721c43f56713679de0.poster.avif?t=1771527614\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2020710/extras/624e4c87fbab13721c43f56713679de0.webm?t=1771527614\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2020710/extras/624e4c87fbab13721c43f56713679de0.mp4?t=1771527614\" type=\"video/mp4\"></video></span></p></p><br><h1>About the Game</h1><p class=\"bb_paragraph\" >Havendock is a cozy colony sim set in the heart of the ocean, where you\u2019ll build a thriving town from the ground up.\u00a0Welcome new settlers, manage resources, explore new lands, and live your best life. Lead your humble settlement into a high-tech society.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2020710/extras/f39b26a5317850cac3a6ea10a16141a4.avif?t=1771527614\" width=600 height=150 /></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2020710/extras/e06447b62b54369c2ccb20773e79acff.poster.avif?t=1771527614\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_asse