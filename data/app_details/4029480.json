s it seems in the world of Axol's Quest... Prepare yourself for twists, turns, trials, and even tribulations! And be sure to collect all 15 peanuts in the land and shoot for the stars!</p></li><li><p class=\"bb_paragraph\" ><strong>Roughly 1-hour Original Soundtrack</strong></p></li></ul>","developers":["CartMart"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4029480/3d203973d2030682267a96ca083b6d7dd42273ed/header.jpg?t=1759526400","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4029480/1253944894/5b6acef8fdfaccbfaa6b0b11bfa1ffca23ef2973/1757867078/dash_av1.mpd?t=1758333793","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4029480/1253944894/5b6acef8fdfaccbfaa6b0b11bfa1ffca23ef2973/1757867078/dash_h264.mpd?t=1758333793","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4029480/1253944894/5b6acef8fdfaccbfaa6b0b11bfa1ffca23ef2973/1757867078/hls_264_master.m3u8?t=1758333793","id":257197648,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257197648/movie480.mp4?t=1758333793","max":"https://video.akamai.steamstatic.com/store_trailers/257197648/movie_max.mp4?t=1758333793"},"name":"Axol's Quest Launch Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257197648/4a28a02c8c4d012277fdd78bee1a94123e75ed6b/movie_600x337.jpg?t=1758333793","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257197648/movie480_vp9.webm?t=1758333793","max":"https://video.akamai.steamstatic.com/store_trailers/257197648/movie_max_vp9.webm?t=1758333793"}}],"name":"Axol's Quest","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_lic