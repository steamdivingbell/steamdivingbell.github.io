ho you are.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4025700/extras/e02a0725ba94ef455d810e54105e7f64.avif?t=1760059865\" width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ><strong>\u25c6 A Seamless Fairy-tale Town</strong></p><p class=\"bb_paragraph\" > Walk slowly, take scenic detours, and get lost in its beauty. With no loading screens and no boundaries, the entire fairy-tale town is yours to explore.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4025700/extras/5c4b27a73cfe225ac36548fa567b36c3.avif?t=1760059865\" width=1560 height=878 /></span></p><p class=\"bb_paragraph\" > </p>","developers":["XD"],"genres":[{"description":"Casual","id":"4"},{"description":"Simulation","id":"28"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4025700/edc3ad12e05101b0f839f16b86ab610cfcba1235/header.jpg?t=1760059865","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4025700/575149878/eab169ef355480db2eec2f6ce2f898fc1eb8cc47/1757580334/dash_av1.mpd?t=1760059864","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4025700/575149878/eab169ef355480db2eec2f6ce2f898fc1eb8cc47/1757580334/dash_h264.mpd?t=1760059864","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4025700/575149878/eab169ef355480db2eec2f6ce2f898fc1eb8cc47/1757580334/hls_264_master.m3u8?t=1760059864","id":257196098,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257196098/movie480.mp4?t=1760059864","max":"https://video.akamai.steamstatic.com/store_trailers/257196098/movie_max.mp4?t=1760059864"},"name":"Heartopia","thumbnail":"https://shared.akamai.steamstatic.com/store_item_as