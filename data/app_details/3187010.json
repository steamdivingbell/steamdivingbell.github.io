/steam/apps/3187010/b75ecf94a821ef55e020677055db25819f9192bb/ss_b75ecf94a821ef55e020677055db25819f9192bb.1920x1080.jpg?t=1759267677","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3187010/b75ecf94a821ef55e020677055db25819f9192bb/ss_b75ecf94a821ef55e020677055db25819f9192bb.600x338.jpg?t=1759267677"}],"short_description":"When dinosaurs were brought back to life, none wanted to be a cop, so humans made you: Dinocop. Investigate the guests of the Cretaceous hotel to crack a meaty case that will confront you with your most profound existential dilemma. Who brought human meat to the dinosaur rights convention ?","steam_appid":3187010,"support_info":{"email":"support@piecesgames.com","url":""},"supported_languages":"English","type":"game","website":null}