 darkness that threaten to consume you.</p>","developers":["Shire Brew Studios"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3375630/61240f707f3b1ccce9832766a99f7c3c7db39025/header.jpg?t=1760029494","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3375630/1584482739/cd887299290deb1b2b9761d1abeb3ceec12d69bc/1756506749/dash_av1.mpd?t=1756539184","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3375630/1584482739/cd887299290deb1b2b9761d1abeb3ceec12d69bc/1756506749/dash_h264.mpd?t=1756539184","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3375630/1584482739/cd887299290deb1b2b9761d1abeb3ceec12d69bc/1756506749/hls_264_master.m3u8?t=1756539184","id":257190919,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257190919/384c1240467083f6214d9276b1ea7a4d610e95d3/movie_600x337.jpg?t=1756539184"}],"name":"Lightkeeper's Curse","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Lightkeeper's Curse - <span class=\"discount_original_price\">$8.99</span> $4.49 USD","packageid":1194493,"percent_savings":0,"percent_savings_text":"-50% ","price_in_cents_with_discount":449}],"title":"B