ssets/steam/apps/4001780/f4360bd1f22981a29e00c0dd0e7e46f16fa3fdb0/ss_f4360bd1f22981a29e00c0dd0e7e46f16fa3fdb0.600x338.jpg?t=1772454351"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/d5a324088605f1c7ec272b545f4d51306c039cc5/ss_d5a324088605f1c7ec272b545f4d51306c039cc5.1920x1080.jpg?t=1772454351","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/d5a324088605f1c7ec272b545f4d51306c039cc5/ss_d5a324088605f1c7ec272b545f4d51306c039cc5.600x338.jpg?t=1772454351"}],"short_description":"Repaint platforms on the map to solve asymmetric puzzles for two players. Use the unique function of each platform type to open up new paths. Cooperate, plan, solve, experiment with colors, and restart freely if need be. A vibrant pixel art world and its spirits need your help.","steam_appid":4001780,"support_info":{"email":"mail@gryfyard.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://gryfyard.com"}