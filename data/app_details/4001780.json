:0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/a4410480124c553aa729bde1b76c11d0e865c01e/ss_a4410480124c553aa729bde1b76c11d0e865c01e.1920x1080.jpg?t=1759492290","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/a4410480124c553aa729bde1b76c11d0e865c01e/ss_a4410480124c553aa729bde1b76c11d0e865c01e.600x338.jpg?t=1759492290"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/4b8da634ab1b915d44aff4c19a61b1e36b47fb45/ss_4b8da634ab1b915d44aff4c19a61b1e36b47fb45.1920x1080.jpg?t=1759492290","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/4b8da634ab1b915d44aff4c19a61b1e36b47fb45/ss_4b8da634ab1b915d44aff4c19a61b1e36b47fb45.600x338.jpg?t=1759492290"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/9278079f8a7eabd780676e3425c81aaef200411f/ss_9278079f8a7eabd780676e3425c81aaef200411f.1920x1080.jpg?t=1759492290","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/9278079f8a7eabd780676e3425c81aaef200411f/ss_9278079f8a7eabd780676e3425c81aaef200411f.600x338.jpg?t=1759492290"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/5713892fa8fb9535df09b948fe66156d7a4f9593/ss_5713892fa8fb9535df09b948fe66156d7a4f9593.1920x1080.jpg?t=1759492290","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/5713892fa8fb9535df09b948fe66156d7a4f9593/ss_5713892fa8fb9535df09b948fe66156d7a4f9593.600x338.jpg?t=1759492290"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/d5a324088605f1c7ec272b545f4d51306c039cc5/ss_d5a324088605f1c7ec272b545f4d51306c039cc5.1920x1080.jpg?t=1759492290","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001780/d5a324088605f1c7ec272b545f4d51306c039cc5/ss_d5a324088605f1c7ec272b545f4d51306c039cc5.600x338.jpg?t=1759492290"}],"short_description":"A co-op puzzle platformer set in a vibrant pixel art world. Change colors on the map to solve asymmetric puzzles, and help two spirits save their forest. Cooperate, plan, solve - and restart when colors spill the wrong way.","steam_appid":4001780,"support_info":{"email":"mail@gryfyard.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://gryfyard.com"}