ab839a17c1717281fd12b733a3e1151d1e9f9.600x338.jpg?t=1750493244"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3683050/67f997130c2bd75d8677af3fce0b63a7c96874f8/ss_67f997130c2bd75d8677af3fce0b63a7c96874f8.1920x1080.jpg?t=1750493244","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3683050/67f997130c2bd75d8677af3fce0b63a7c96874f8/ss_67f997130c2bd75d8677af3fce0b63a7c96874f8.600x338.jpg?t=1750493244"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3683050/d163233cd52e36f8d4831fba252da53de50da3f7/ss_d163233cd52e36f8d4831fba252da53de50da3f7.1920x1080.jpg?t=1750493244","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3683050/d163233cd52e36f8d4831fba252da53de50da3f7/ss_d163233cd52e36f8d4831fba252da53de50da3f7.600x338.jpg?t=1750493244"}],"short_description":"Hexalith is a casual sci-fi city-building game with dynamic twists. Collect resources, complete missions, discover new city blueprints, and expand your civilization in this tile-based space odyssey.","steam_appid":3683050,"support_info":{"email":"support@artemi-studios.com","url":"https://artemi-studios.com"},"supported_languages":"English, French, Italian, German, Spanish - Spain","type":"game","website":"https://artemi-studios.com"}