s!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757020/extras/93b79344c8641dab33925cd247387da7.avif?t=1768716392\" width=600 height=220 /></span></p><p class=\"bb_paragraph\" ></p>","developers":["CRAFTS & MEISTER Co., Ltd."],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757020/ef38b9be3c19579edecb089c4f485dfd9bcf6d7e/header.jpg?t=1768716392","is_free":false,"legal_notice":"\u00a9CRAFTS&MEISTER Co., Ltd.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3757020/1329992545/18f9131c70c4ed1f30f7e6fd46fe8a58c2a622cd/1755498448/dash_av1.mpd?t=1755501563","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3757020/1329992545/18f9131c70c4ed1f30f7e6fd46fe8a58c2a622cd/1755498448/dash_h264.mpd?t=1755501563","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3757020/1329992545/18f9131c70c4ed1f30f7e6fd46fe8a58c2a622cd/1755498448/hls_264_master.m3u8?t=1755501563","id":257184607,"name":"BLOKES on BLOCKS // Announcement_Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257184607/a072c33ee56078f8dfa193a71cb1e768d47cc68a/movie_600x337.jpg?t=1755501563"}],"name":"BLOKES on BLOCKS!","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 (64-bit)<br></li><li><strong