c1d447ca20be8f9fe762b7cac307dc8a03d5.1920x1080.jpg?t=1757355950","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3073240/ss_ac3bc1d447ca20be8f9fe762b7cac307dc8a03d5.600x338.jpg?t=1757355950"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3073240/ss_7838209d25d69f2b6838db56d1cb9dae739c19a1.1920x1080.jpg?t=1757355950","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3073240/ss_7838209d25d69f2b6838db56d1cb9dae739c19a1.600x338.jpg?t=1757355950"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3073240/ss_770f368eaf2a2958e08140160df93b11248a2382.1920x1080.jpg?t=1757355950","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3073240/ss_770f368eaf2a2958e08140160df93b11248a2382.600x338.jpg?t=1757355950"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3073240/bdb4569ad9454c0c1c96d2d6ae370c3ab8ed87c0/ss_bdb4569ad9454c0c1c96d2d6ae370c3ab8ed87c0.1920x1080.jpg?t=1757355950","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3073240/bdb4569ad9454c0c1c96d2d6ae370c3ab8ed87c0/ss_bdb4569ad9454c0c1c96d2d6ae370c3ab8ed87c0.600x338.jpg?t=1757355950"}],"short_description":"Concierge is a challenging, suspenseful nonlinear adventure about an old man and an older hotel. Discover your identity and explore your purpose in a surrealistic world of puzzles and trials of every sort. You're on your own - but you are not alone.","steam_appid":3073240,"support_info":{"email":"kodinoartes@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Portuguese - Brazil<br><strong>*</strong>languages with full audio support","type":"game","website":null}