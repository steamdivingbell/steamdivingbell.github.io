kest thoughts!","steam_appid":3612110,"support_info":{"email":"contact@mbtactics.com","url":""},"supported_languages":"English<strong>*</strong>, Simplified Chinese<strong>*</strong>, Traditional Chinese<strong>*</strong>, Spanish - Spain<strong>*</strong>, Japanese<strong>*</strong>, Korean<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Russian<strong>*</strong>, Spanish - Latin America<strong>*</strong>, German<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}