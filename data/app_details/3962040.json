ets/steam/apps/3962040/30124a94dfbc0d308b87264ee4f5371d9824978e/ss_30124a94dfbc0d308b87264ee4f5371d9824978e.600x338.jpg?t=1771849162"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3962040/0e2f2a674f165fd9eef691219e85f1e82a8c94f5/ss_0e2f2a674f165fd9eef691219e85f1e82a8c94f5.1920x1080.jpg?t=1771849162","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3962040/0e2f2a674f165fd9eef691219e85f1e82a8c94f5/ss_0e2f2a674f165fd9eef691219e85f1e82a8c94f5.600x338.jpg?t=1771849162"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3962040/ffb99c75334d691eb9d4b58dd0d8059d52a32866/ss_ffb99c75334d691eb9d4b58dd0d8059d52a32866.1920x1080.jpg?t=1771849162","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3962040/ffb99c75334d691eb9d4b58dd0d8059d52a32866/ss_ffb99c75334d691eb9d4b58dd0d8059d52a32866.600x338.jpg?t=1771849162"}],"short_description":"Grow your ranch, raise cattle, lead cowboys, and trade with settlers in a new real-time economic strategy with survival challenges.","steam_appid":3962040,"support_info":{"email":"support@kscreating.com","url":""},"supported_languages":"English","type":"game","website":null}