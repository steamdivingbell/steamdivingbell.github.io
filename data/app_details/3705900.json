00/c636ec429666195b83d6ac4d8d4f1a035f45e6fa/ss_c636ec429666195b83d6ac4d8d4f1a035f45e6fa.600x338.jpg?t=1773670488"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3705900/9ddb2f91314928feebcb4810cb30fc59ceee3ef2/ss_9ddb2f91314928feebcb4810cb30fc59ceee3ef2.1920x1080.jpg?t=1773670488","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3705900/9ddb2f91314928feebcb4810cb30fc59ceee3ef2/ss_9ddb2f91314928feebcb4810cb30fc59ceee3ef2.600x338.jpg?t=1773670488"}],"short_description":"Become President of the USA: sign absurd decrees and balance your policies to avoid being called a &quot;sellout.&quot; Communicate to gain popularity, manage interviews, and face press conferences. Everything falling apart? Press the red button.","steam_appid":3705900,"support_info":{"email":"potus.simulator@gmail.com","url":""},"supported_languages":"English, French, German, Simplified Chinese, Russian, Turkish","type":"game","website":null}