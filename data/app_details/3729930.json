<p class=\"bb_paragraph\" >Shadow-like entities that evolve the longer you stay</p></li><li><p class=\"bb_paragraph\" >Hidden levels created by the Mirage\u2019s growing mind</p></li><li><p class=\"bb_paragraph\" >Multiple endings based on how far you're willing to go</p></li></ul>","developers":["Joseph Weller"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3729930/54ef946b3fde62cdc39aef9f586f11674de4157e/header.jpg?t=1763449699","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3729930/1132301392/fc226a5dbab01b06040d803b8e4918f9144b873a/1753397474/dash_av1.mpd?t=1753399424","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3729930/1132301392/fc226a5dbab01b06040d803b8e4918f9144b873a/1753397474/dash_h264.mpd?t=1753399424","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3729930/1132301392/fc226a5dbab01b06040d803b8e4918f9144b873a/1753397474/hls_264_master.m3u8?t=1753399424","id":257152817,"name":"The Mirage Project","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257152817/418d29b3b19a2770317fc3ac32b90e1858532144/movie_600x337.jpg?t=1753399424"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3729930/1924982126/8fb2450f373fd179c417df24ea9c88f1efeadc1c/1753400519/dash_av1.mpd?t=1753401355","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3729930/1924982126/8fb2450f373fd179c417df24ea9c88f1efeadc1c/1753400519/dash_h264.mpd?t=1753401355","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3729930/1924982126/8fb2450f373fd179c417df24ea9c88f1efeadc1c/1753400519/hls_264_master.m3u8?t=1753401355","id":257173608,"name":"The Mirage Project Teaser","thumbnail":"https://shared.akamai.steamstatic.co