/apps/3929410/b5d059553dc83759f635f1313d3907501b9584d1/ss_b5d059553dc83759f635f1313d3907501b9584d1.600x338.jpg?t=1760346882"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929410/dce92c8e3894a9a9fa6056ec2f47f27263345478/ss_dce92c8e3894a9a9fa6056ec2f47f27263345478.1920x1080.jpg?t=1760346882","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929410/dce92c8e3894a9a9fa6056ec2f47f27263345478/ss_dce92c8e3894a9a9fa6056ec2f47f27263345478.600x338.jpg?t=1760346882"}],"short_description":"Mystery of Silence is a point-and-click adventure where William, a young writer in search of inspiration, enters an abbey shrouded in silence. What William finds within those walls is not just a story to tell, but a secret that should never be discovered.","steam_appid":3929410,"support_info":{"email":"info@devilishgames.com","url":"https://www.devilishgames.com/en/contact/"},"supported_languages":"English, Spanish - Spain, Catalan, Basque","type":"game","website":"https://www.devilishgames.com/"}