 scenarios set in the 1980s\u20132000s era.</p>","developers":["ZDSimulator Team"],"fullgame":{"appid":"3381120","name":"ZDSimulator"},"genres":[{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3614830/c7fba1cab069c80526824515aaa6701885db068f/header.jpg?t=1744917872","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"ZDSimulator - ChS4T Locomotive","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"ZDSimulator - ChS4T Locomotive - $5.99 USD","packageid":1274610,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":599}],"title":"Buy ZDSimulator - ChS4T Locomotive"}],"packages":[1274610],"pc_requirements":[],"platforms":{"linux":false,"mac":false,"windows":true},"price_overview":{"currency":"USD","discount_percent":0,"final":599,"final_formatted":"$5.99 USD","initial":599,"initial_formatted":""},"publishers":["ZDSimulator Team"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":false,"date":"17 Apr, 2025"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3614830/6e6b6c9aaee2ccca6ebba47894cbde30c16273d9/ss_6e6b6c9aaee2ccca6ebba47894cbde30c16273d9.1920x1080.jpg?t=1744917872","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3614830/6e6b6c9aaee2ccca6ebba47894cbde30c16273d9/ss_6e6b6c9aaee2ccca6ebba47894cbde30c16273d9.600x338.jpg?t=1744917872"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/