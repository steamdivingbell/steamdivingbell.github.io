ff1c9/ss_7093421b3f596b5dd2c169326e699706543ff1c9.1920x1080.jpg?t=1755076739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3156330/7093421b3f596b5dd2c169326e699706543ff1c9/ss_7093421b3f596b5dd2c169326e699706543ff1c9.600x338.jpg?t=1755076739"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3156330/ss_7f3bf6767f0f612cc8c61d16e9f0ed3cdde91130.1920x1080.jpg?t=1755076739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3156330/ss_7f3bf6767f0f612cc8c61d16e9f0ed3cdde91130.600x338.jpg?t=1755076739"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3156330/ss_5ddab4b437ab914052d5bc309e910508ca110f08.1920x1080.jpg?t=1755076739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3156330/ss_5ddab4b437ab914052d5bc309e910508ca110f08.600x338.jpg?t=1755076739"}],"short_description":"In this presidential rogue-like action game, gather votes and run for presidency by day, then transform into a warrior to take down your enemies by night! Master unique skills to become a swordmaster, a cyber mage, or anything in between, and overthrow the ruthless president!","steam_appid":3156330,"support_info":{"email":"info@phewphewgames.com","url":"https://phewphewgames.com/"},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America, Turkish<strong>*</strong>, Japanese<br><strong>*</strong>languages with full audio support","type":"game","website":null}