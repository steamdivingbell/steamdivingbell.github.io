d37dd79bc9b14eb312ffab0859370466.1920x1080.jpg?t=1761818211","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3639650/a3eb97f6d37dd79bc9b14eb312ffab0859370466/ss_a3eb97f6d37dd79bc9b14eb312ffab0859370466.600x338.jpg?t=1761818211"}],"short_description":"Kotama and Academy Citadel is a 3D Metroidvania game. Players assume the role of an exchange student named Kotama as she explores through the mysterious Academy Citadel, aiming to become the esteemed [Carmel Star].","steam_appid":3639650,"support_info":{"email":"atomstring@163.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese","type":"game","website":null}