h the virtual cockpit for a seamless digital mixed reality experience.</p><p class=\"bb_paragraph\" >\ud83d\udd13 <strong>Custom controller uploads</strong> <i>(PRO DLC)</i><br>Create and upload your own 3D controller models if they\u2019re not in our database.<br><br><strong><u>A 5-hour PRO trial is available!</u></strong></p><p class=\"bb_paragraph\" ></p>","developers":["Daniel Zettisch","Zoltan Erdos","Zsolt Szigetlaki"],"genres":[{"description":"Racing","id":"9"},{"description":"Utilities","id":"57"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2532240/header.jpg?t=1751959659","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2532240/654152/b3c0ec6050fe23b027746635c0f5ec19423164dd/1750928450/dash_av1.mpd?t=1708245758","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2532240/654152/b3c0ec6050fe23b027746635c0f5ec19423164dd/1750928450/dash_h264.mpd?t=1708245758","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2532240/654152/b3c0ec6050fe23b027746635c0f5ec19423164dd/1750928450/hls_264_master.m3u8?t=1708245758","id":256996257,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/256996257/movie480.mp4?t=1708245758","max":"https://video.akamai.steamstatic.com/store_trailers/256996257/movie_max.mp4?t=1708245758"},"name":"Infuse VR introduction","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256996257/movie.293x165.jpg?t=1708245758","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/256996257/movie480_vp9.webm?t=1708245758","max":"https://video.akamai.steamstatic