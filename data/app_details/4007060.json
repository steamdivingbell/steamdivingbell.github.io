IVORS</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >A RELENTLESS RACE AGAINST TIME</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >MAKE HEART-WRENCHING CHOICES</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >CRAFT YOUR SURVIVAL</p></li></ul>","developers":["Arcadesindo"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4007060/00fe490a21075954365e9cfc82a7893f99907585/header.jpg?t=1758679890","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"name":"Rail Of Sorrows","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS *:</strong> Windows 7 64-Bit or later<br></li><li><strong>Processor:</strong> Intel Core i3 or AMD equivalent<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 620 or AMD equivalent<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Arcadesindo"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Drastische Gewalt","rating":"16","rating_generated":"1","require