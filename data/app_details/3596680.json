ore_item_assets/steam/apps/3596680/afd08d27fa01c0abc683d59c66b275760f4db25e/ss_afd08d27fa01c0abc683d59c66b275760f4db25e.600x338.jpg?t=1772001699"}],"short_description":"A nonlinear psychological horror set in a watermill. You were a simple miller with a loving family, but now you are branded as possessed by a demon. Overcome the trials, figure out what happened, and find the one responsible for all your misfortunes.","steam_appid":3596680,"support_info":{"email":"spikaveil934@gmail.com","url":""},"supported_languages":"English, German, Spanish - Spain, Portuguese - Brazil, Russian","type":"game","website":null}