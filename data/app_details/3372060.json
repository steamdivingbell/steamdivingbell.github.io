":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/f1158a3324449c7719f80b1083e2ba60200adf97/ss_f1158a3324449c7719f80b1083e2ba60200adf97.600x338.jpg?t=1748001031"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/d9f243009debb2b5f359a85ad3215f69d2e58c55/ss_d9f243009debb2b5f359a85ad3215f69d2e58c55.1920x1080.jpg?t=1748001031","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/d9f243009debb2b5f359a85ad3215f69d2e58c55/ss_d9f243009debb2b5f359a85ad3215f69d2e58c55.600x338.jpg?t=1748001031"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/e7c06fb5d86b2db11375b6fea0cfec1ce9be1086/ss_e7c06fb5d86b2db11375b6fea0cfec1ce9be1086.1920x1080.jpg?t=1748001031","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/e7c06fb5d86b2db11375b6fea0cfec1ce9be1086/ss_e7c06fb5d86b2db11375b6fea0cfec1ce9be1086.600x338.jpg?t=1748001031"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/567353029629546debdae9b2ef2dfa84faafacae/ss_567353029629546debdae9b2ef2dfa84faafacae.1920x1080.jpg?t=1748001031","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/567353029629546debdae9b2ef2dfa84faafacae/ss_567353029629546debdae9b2ef2dfa84faafacae.600x338.jpg?t=1748001031"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/8765dd956a782bfae31800944da8e276900d3a9f/ss_8765dd956a782bfae31800944da8e276900d3a9f.1920x1080.jpg?t=1748001031","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/8765dd956a782bfae31800944da8e276900d3a9f/ss_8765dd956a782bfae31800944da8e276900d3a9f.600x338.jpg?t=1748001031"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3372060/89d92043d74a6889cf0292e6c61a70a5fb9c138d/ss_89d92043d74a68