m/store_item_assets/steam/apps/3104670/8c444cc58b9d16e6c4b951de66a632d88f505eda/ss_8c444cc58b9d16e6c4b951de66a632d88f505eda.600x338.jpg?t=1771340727"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104670/8c645712b71afed6c21979a01611ef4207ad5a3b/ss_8c645712b71afed6c21979a01611ef4207ad5a3b.1920x1080.jpg?t=1771340727","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104670/8c645712b71afed6c21979a01611ef4207ad5a3b/ss_8c645712b71afed6c21979a01611ef4207ad5a3b.600x338.jpg?t=1771340727"}],"short_description":"Blend in, hunt, and outsmart your friends to be the last person standing. Find the real players among clones called &quot;Doppels&quot; to win. Experience random events that make each round unique. A hilarious local multiplayer challenge perfect for a party! 2-6 Players","steam_appid":3104670,"support_info":{"email":"taylor@eggsaladstudios.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://eggsaladstudios.com/"}