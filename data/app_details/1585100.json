ic.com/store_item_assets/steam/apps/1585100/extras/f71d6a87be90e288f885fd9d28c1c7fd.poster.avif?t=1731246708\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1585100/extras/f71d6a87be90e288f885fd9d28c1c7fd.webm?t=1731246708\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1585100/extras/f71d6a87be90e288f885fd9d28c1c7fd.mp4?t=1731246708\" type=\"video/mp4\"></video></span><br><br>So what are you waiting for? Find your way in the blinding lights of the cities and lush pine forests, grab some power-ups to wreak havoc among your enemies and climb the scoreboard to earn your place as the undisputed champion of the snowfields!<br><br>Key features:<br>- Classic PvP FPS (First Person Snowball) action with up to 16 players<br>- Free-for-all and different Team fight modes<br>- Play Online or LAN<br>- Play offline against Bots<br>- Variety of different Power-Ups that alter the game<br>- Create a Custom server where you set the rules","developers":["Gnomecraft"],"genres":[{"description":"Action","id":"1"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1585100/header.jpg?t=1731246708","is_free":false,"legal_notice":"Copyright Gnomecraft.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1585100/470834/37759314bb14bc384d05f36b889c59c45f7a83ee/1751006464/dash_av1.mpd?t=1655120934","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1585100/470834/37759314bb14bc384d05f36b889c59c45f7a83ee/1751006464/dash_h264.mpd?t=1655120934"