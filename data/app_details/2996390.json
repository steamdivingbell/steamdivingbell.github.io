mai.steamstatic.com/store_item_assets/steam/apps/2996390/extras/eb5f73767bc7ad69188df71cb6308388.poster.avif?t=1771979923\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996390/extras/eb5f73767bc7ad69188df71cb6308388.webm?t=1771979923\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996390/extras/eb5f73767bc7ad69188df71cb6308388.mp4?t=1771979923\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>","developers":["Lucas T"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2996390/62d92d18e8991d704af2def7066f501843fddcdc/header.jpg?t=1771979923","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2996390/728396/8569e98be4eb4f8b3f61051dde682fc055e23261/1750956405/dash_av1.mpd?t=1721439902","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2996390/728396/8569e98be4eb4f8b3f61051dde682fc055e23261/1750956405/dash_h264.mpd?t=1721439902","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2996390/728396/8569e98be4eb4f8b3f61051dde682fc055e23261/1750956405/hls_264_master.m3u8?t=1721439902","id":257039169,"name":"Fails Meme Compilation #1","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257039169/movie.293x165.jpg?t=1721439902"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2996390/725375/74c4e6b9f887cbe9b4cc9bb50689e795db5d7b3a/1750956405/dash_av1.mpd?t=1721023244","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2996390/725375/74c4e6b9f887cbe9b4cc9bb50689e795db5d7b3a/1750956405/dash_h264.mpd?t=1721023244","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2996390/72