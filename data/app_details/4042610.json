10/b4a25f4260071faf74932cb7f8d65403abf11625/ss_b4a25f4260071faf74932cb7f8d65403abf11625.1920x1080.jpg?t=1771704665","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/b4a25f4260071faf74932cb7f8d65403abf11625/ss_b4a25f4260071faf74932cb7f8d65403abf11625.600x338.jpg?t=1771704665"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/cf4a851933d3c7828203e05f1056fee037e9e7fe/ss_cf4a851933d3c7828203e05f1056fee037e9e7fe.1920x1080.jpg?t=1771704665","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/cf4a851933d3c7828203e05f1056fee037e9e7fe/ss_cf4a851933d3c7828203e05f1056fee037e9e7fe.600x338.jpg?t=1771704665"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/dbdc13278918e9b97e45e08f7389b03dff8039db/ss_dbdc13278918e9b97e45e08f7389b03dff8039db.1920x1080.jpg?t=1771704665","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/dbdc13278918e9b97e45e08f7389b03dff8039db/ss_dbdc13278918e9b97e45e08f7389b03dff8039db.600x338.jpg?t=1771704665"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/f70734714b91dd3a66cd4cd6eda54773268dd4f6/ss_f70734714b91dd3a66cd4cd6eda54773268dd4f6.1920x1080.jpg?t=1771704665","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/f70734714b91dd3a66cd4cd6eda54773268dd4f6/ss_f70734714b91dd3a66cd4cd6eda54773268dd4f6.600x338.jpg?t=1771704665"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/fcc3d6daca0376ee6bc4efad9c05b2ccc094f54e/ss_fcc3d6daca0376ee6bc4efad9c05b2ccc094f54e.1920x1080.jpg?t=1771704665","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042610/fcc3d6daca0376ee6bc4efad9c05b2ccc094f54e/ss_fcc3d6daca0376ee6bc4efad9c05b2ccc094f54e.600x338.jpg?t=1771704665"},{"id":9,"path_full":"ht