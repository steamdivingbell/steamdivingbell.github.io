.akamai.steamstatic.com/store_item_assets/steam/apps/3998790/4f9344b2a75fa93b2f8f74635617b7dcfa1316b6/ss_4f9344b2a75fa93b2f8f74635617b7dcfa1316b6.1920x1080.jpg?t=1765410704","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3998790/4f9344b2a75fa93b2f8f74635617b7dcfa1316b6/ss_4f9344b2a75fa93b2f8f74635617b7dcfa1316b6.600x338.jpg?t=1765410704"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3998790/0266439c4bd9bf248df31e2541d63313dafb330d/ss_0266439c4bd9bf248df31e2541d63313dafb330d.1920x1080.jpg?t=1765410704","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3998790/0266439c4bd9bf248df31e2541d63313dafb330d/ss_0266439c4bd9bf248df31e2541d63313dafb330d.600x338.jpg?t=1765410704"}],"short_description":"A snowy night, returning home after the night shift to an empty house. Where did your family go? Truth seeping through the cracks of memory. A first-person psychological horror adventure.","steam_appid":3998790,"support_info":{"email":"kimjinhong0325@gmail.com","url":"https://blog.naver.com/kimjinhong01"},"supported_languages":"English, Japanese, Korean, Simplified Chinese","type":"game","website":null}