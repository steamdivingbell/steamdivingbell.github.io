s/3998790/c030bf6d4895bf3664b2ed6b46025fae28106493/ss_c030bf6d4895bf3664b2ed6b46025fae28106493.1920x1080.jpg?t=1773936266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3998790/c030bf6d4895bf3664b2ed6b46025fae28106493/ss_c030bf6d4895bf3664b2ed6b46025fae28106493.600x338.jpg?t=1773936266"}],"short_description":"VHS-style single-player horror part-time job simulator. Endure the night shift at a remote gas station/convenience store, then return home and collect hidden clues. As the days pass, nightmares bleed into reality\u2014and depending on the clues you uncover, the ending changes.","steam_appid":3998790,"support_info":{"email":"kimjinhong0325@gmail.com","url":"https://blog.naver.com/kimjinhong01"},"supported_languages":"English, Japanese, Korean, Simplified Chinese, Spanish - Spain, Russian, Traditional Chinese, Portuguese - Brazil","type":"game","website":null}