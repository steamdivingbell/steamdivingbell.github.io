0e8cbe8b85d153171bc9f117756ac47b4202.1920x1080.jpg?t=1768959626","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3998790/3c8f0e8cbe8b85d153171bc9f117756ac47b4202/ss_3c8f0e8cbe8b85d153171bc9f117756ac47b4202.600x338.jpg?t=1768959626"}],"short_description":"VHS-style single-player horror part-time job simulator. Endure the night shift at a remote gas station/convenience store, then return home and collect hidden clues. As the days pass, nightmares bleed into reality\u2014and depending on the clues you uncover, the ending changes.","steam_appid":3998790,"support_info":{"email":"kimjinhong0325@gmail.com","url":"https://blog.naver.com/kimjinhong01"},"supported_languages":"English, Japanese, Korean, Simplified Chinese","type":"game","website":null}