steamcommunity/public/images/apps/2447680/adc8b119cdec4bd89e998e31e6ce0e2afdd5248c.jpg"},{"name":"Shelter","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2447680/dda2d266b78f2fcb4723e7f7eacd71ff8785812c.jpg"},{"name":"Joy of Planting","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2447680/3f2a92714bafd5a3cfe5a56a777e2e7e2195331f.jpg"},{"name":"Path of the Strong","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2447680/05b2f8efbc8d77db7e0132c58985b1d5d6a75aca.jpg"},{"name":"Fine Weapon","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2447680/046e6a2cc16fd0caf021f962bb589d049317dbbf.jpg"},{"name":"Fine Armor","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2447680/d92613d012e7d0a17d28a65fca90a14fa0a55317.jpg"},{"name":"Minion Horde","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2447680/a0e78edd6f66fbbc99df8811a84f2b96bc6156d6.jpg"},{"name":"Legion","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2447680/bf310eb8fb788aa542777790e9f89aca0c4b8de5.jpg"}],"total":20},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/2447680?t=1767326760","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/page_bg_raw.jpg?t=1767326760","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/b7a04d90b8c3e4f9b9174e23a076e401d5e22cbd/capsule_231x87.jpg?t=1767326760","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/b7a04d90b8c3e4f9b9174e23a076e401d5e22cbd/capsule_184x69.jpg?t=1767326760","categories":[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Custom Volume Controls","id":68},{"description":"Adjustable Difficulty","id":78},{"description":"Playable without Timed Input","id":74},{"description":"Save Anytime","id":79},{"description":"Stereo Sound","id":69},{"description":"Steam Cloud","id":23},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[1,5],"notes":"English: Adult Content Warning: This game contains partial nudity or sexual content (revealing/sexy clothing, suggestive/sexy dances), sexual behavior (kissing, hugging), extreme violence, and suicide; it may not be suitable for all ages."},"detailed_description":"<h2 class=\"bb_tag\" > Story Introduction:</h2><p class=\"bb_paragraph\" >After a yacht accident, you and your guests are stranded on a mysterious island. Will you survive alone or help everyone pull through together? The game blends romance, survival, crafting, farming, fishing, pet taming, and more\u2014promising a unique survival adventure.</p><h2 class=\"bb_tag\" >Game Features:</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >A vast island map featuring caves, abandoned structures, cliffs, and other special locations. With ultra-high vegetation density, nearly every environmental object can be gathered, each holding unique value.</p></li><li><p class=\"bb_paragraph\" >Forge bonds with NPCs through a comprehensive affinity system. Each NPC features authentic voice acting to enhance immersion.</p></li><li><p class=\"bb_paragraph\" >Intelligent NPCs capable of independent eating, cooking, resting, gathering, and combat. They dynamically adjust behavior based on player status, offering care and emotional interactions.</p></li><li><p class=\"bb_paragraph\" >Multiple NPC outfits unlockable through affinity progression.</p></li><li><p class=\"bb_paragraph\" >Includes all core survival elements: base building, farming, pet hatching, pet rearing, armor/weapon crafting, and more.</p></li><li><p class=\"bb_paragraph\" >Diverse creatures (monsters) with designated habitats\u2014each engages in <i>all-terrain combat</i>. Fully open-world exploration with zero player restrictions.</p></li><li><p class=\"bb_paragraph\" >Extensive weapon variety: combat tools (axes, bows, spears, crossbows, firearms) and non-combat tools (shovels, sickles, bamboo tubes).</p></li><li><p class=\"bb_paragraph\" >Fully open-ended gameplay\u2014explore both land and underwater realms.</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Recent Update Showcase:</h2><p class=\"bb_paragraph\" ><strong>New Creatures</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/extras/4c7b7f5720edb9fe5d386caf20ff0986.poster.avif?t=1767326760\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/extras/4c7b7f5720edb9fe5d386caf20ff0986.webm?t=1767326760\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/extras/2bc633f5dc958177ae8f05d99d6eda28.poster.avif?t=1767326760\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/extras/2bc633f5dc958177ae8f05d99d6eda28.webm?t=1767326760\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/extras/2bc633f5dc958177ae8f05d99d6eda28.mp4?t=1767326760\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>New Weapons</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2447680/extras/67ff8d6640a4c859fae3973b8b1e17f1.poster.avif?t=1767326760\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_a