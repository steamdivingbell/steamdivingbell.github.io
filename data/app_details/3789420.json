atic.com/store_item_assets/steam/apps/3789420/extras/image1.png?t=1750003037\" /></p><p class=\"bb_paragraph\">There are multiple ways to add materials to symbols:</p><p class=\"bb_paragraph\"></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">Silver: Bonus +2</p></li><li><p class=\"bb_paragraph\">Gold: Bonus +5</p></li></ul><h2 class=\"bb_tag\"><strong>Lucky Coins</strong></h2><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3789420/extras/image4.png?t=1750003037\" /></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">After clearing each level, players can buy Lucky Coins from the store.</p></li><li><p class=\"bb_paragraph\">Different Lucky Coins have different effects.</p></li></ul>","developers":["indieCommune"],"fullgame":{"appid":"2850460","name":"\u5e78\u8fd0\u4ff1\u4e50\u90e8\uff1a\u522e\u522e\u4e50|Lukcy Club:Scratcher"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3789420/a05de7bcb1f622e10e52e482456eddfd18526df1/header.jpg?t=1750003037","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257149134,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257149134/movie480.mp4?t=1749476573","max":"http://video.akamai.steamstatic.com/store_trailers/257149134/movie_max.mp4?t=1749476573"},"name":"GamePlay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257149134/283e6158087be72c2d352b0089460224bb9ad9ad/movie_600x337.jpg?t=1749476573","webm