ong>Graphics:</strong> 512 MB<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"price_overview":{"currency":"USD","discount_percent":0,"final":1499,"final_formatted":"$14.99 USD","initial":1499,"initial_formatted":""},"publishers":["mino_dev"],"ratings":{"dejus":{"descriptors":"Viol\u00eancia fantasiosa","rating":"l"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"recommendations":{"total":9135},"release_date":{"coming_soon":false,"date":"9 May, 2024"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132850/ss_91952981162e91bb26079bef1291394740e5fe70.1920x1080.jpg?t=1771398437","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132850/ss_91952981162e91bb26079bef1291394740e5fe70.600x338.jpg?t=1771398437"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132850/ss_883aa4fc91ed1ed7c6120d5201b52fab1d107c4e.1920x1080.jpg?t=1771398437","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132850/ss_883aa4fc91ed1ed7c6120d5201b52fab1d107c4e.600x338.jpg?t=1771398437"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132850/ss_38433b305258a508e6c3151c4b9e8429aace8f19.1920x1080.jpg?t=1771398437","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132850/ss_38433b305258a508e6c3151c4b9e8429aace8f19.600x338.jpg?t=1771398437"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132850/ss_b2a351bf0d7603bb5182c0054abaf81374965f57.1920x1080.jpg?t=1771398437","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2132850/ss_b2a351bf0d7603bb5182c0054abaf81374965f57.600x338.jpg?t=1771398437"},{"id":4,"pa