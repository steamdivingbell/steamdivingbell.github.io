.akamai.steamstatic.com/store_item_assets/steam/apps/3973050/e114545ba68560e6e51f33413799819e797f0292/ss_e114545ba68560e6e51f33413799819e797f0292.1920x1080.jpg?t=1765529834","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973050/e114545ba68560e6e51f33413799819e797f0292/ss_e114545ba68560e6e51f33413799819e797f0292.600x338.jpg?t=1765529834"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973050/6e36d318be289f436a8a6432d011e66900eb6f82/ss_6e36d318be289f436a8a6432d011e66900eb6f82.1920x1080.jpg?t=1765529834","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973050/6e36d318be289f436a8a6432d011e66900eb6f82/ss_6e36d318be289f436a8a6432d011e66900eb6f82.600x338.jpg?t=1765529834"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973050/295269fd469ab19ba57966affa3d4e656dcab945/ss_295269fd469ab19ba57966affa3d4e656dcab945.1920x1080.jpg?t=1765529834","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973050/295269fd469ab19ba57966affa3d4e656dcab945/ss_295269fd469ab19ba57966affa3d4e656dcab945.600x338.jpg?t=1765529834"}],"short_description":"Flutterdash is a colorful, fast-paced rhythm game where you click notes in sync with the beat. Create your own levels and challenge your reaction speed, timing, and skill across increasingly difficult levels.","steam_appid":3973050,"support_info":{"email":"flutterdashofficial@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Bulgarian, Japanese, Korean, Polish, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":null}