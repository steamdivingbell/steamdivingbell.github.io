4cb4730ba90189c7af927.poster.avif?t=1758214113\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023350/extras/cab21ff80ff4cb4730ba90189c7af927.webm?t=1758214113\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023350/extras/cab21ff80ff4cb4730ba90189c7af927.mp4?t=1758214113\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>3. Conquer the Unknown!</strong></h2><p class=\"bb_paragraph\" >Defeat swarms of enemies and take down powerful bosses.   <br>Step through the portal to the next dimension.   <br>Beyond the Rifts, greater challenges and rewards await.</p><p class=\"bb_paragraph\" ><br>Note: This demo represents a limited portion of the full game.  </p><p class=\"bb_paragraph\" >Some features are still in development and may change before release.</p>","developers":["A Team Games"],"fullgame":{"appid":"3833830","name":"Rift Survivors"},"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023350/13e8480055c7c947659cb58ae2bcd21a4a7c88c3/header.jpg?t=1758214113","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257195595,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257195595/movie480.mp4?t=1757689044","max":"http://video.akamai.steamstatic.com/store_trailers/257195595/movie_max.mp4?t=1757689044"},"name":"Demo(sep.2025) Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257195595/1f18bc27ad8cb77b49820bd0cf2cdc9ad53a0631/movie_600x337.jpg?t=1757689044","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257195595/movie480_vp9.webm?t=1757689044","max":"http://video.akamai.steamstatic.com/store_trailers/257195595/movie_max_vp9.webm?t=1757689044"