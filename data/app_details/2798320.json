ps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2798320/extras/ac2968ec7d54e92835f0b3a9119ec8c5.poster.avif?t=1764153330\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2798320/extras/ac2968ec7d54e92835f0b3a9119ec8c5.webm?t=1764153330\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2798320/extras/ac2968ec7d54e92835f0b3a9119ec8c5.mp4?t=1764153330\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>FREQUENTLY ASKED QUESTIONS</strong></h2><p class=\"bb_paragraph\" ><strong>How do you play Super Sami Roll 2?</strong></p><p class=\"bb_paragraph\" >Super Sami Roll is not your standard 3D platformer series, these are rolling-physics based platformers! Movement is free-form and expressive, allowing for unique playstyles and precise control as you navigate your way through each of the challenging levels on offer. Keep your momentum up by using Sami\u2019s tongue to grapple and jump over dangerous obstacles and enemies, and sometimes even skip entire areas! <br><br>It's up to you to create your own path. Do you want to take it slow and enjoy the beautiful scenery, or do you want to discover all of the skips and tricks to be the fastest lizard possible?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Do I need to have played Super Sami Roll 1 before?</strong></p><p class=\"bb_paragraph\" >No. In terms of story and gameplay, both titles are standalone experiences, so you can play them in any order!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>What's Sonzai Games done before Super Sami Roll 1 and 2?</strong></p><p class=\"bb_paragraph\" >Since its founding in 2020, Sonzai Games has also developed the 2D retro platformer Bat Boy, in addition to helping with the development of other cool indie titles such as Last Time I Saw You and Smelter.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i><strong>Once again, it's time to ROLL!</strong></i></p>","developers":["Sonzai Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2798320/header.jpg?t=1764153330","is_free":false,"legal_notice":"\u00a9 2025 Sonzai Games","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2798320/663853/0ee0db8c04c1a5afdd022275bbfc5c1085509958/1750901190/dash_av1.mpd?t=1710249907","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2798320/663853/0ee0db8c04c1a5afdd022275bbfc5c1085509958/1750901190/dash_h264.mpd?t=1710249907","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2798320/663853/0ee0db8c04c1a5afdd022275bbfc5c1085509958/1750901190/hls_264_master.m3u8?t=1710249907","id":257001830,"name":"Reveal Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257001830/movie.293x165.jpg?t=1710249907"}],"name":"Super Sami Roll 2","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3 or equivalent<br></li><li><strong>Graphics:</strong> GeForce GTX 1650<br></li><li><strong>DirectX:</strong> Version 11</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Sonzai Games"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia fantasiosa","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"6","rating_generated":"1","required_age":"6","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"htt