/steam/apps/2798320/f8489305ba59ca43c670b27c1611a5060dc02634/ss_f8489305ba59ca43c670b27c1611a5060dc02634.600x338.jpg?t=1764153330"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2798320/dedb4216e727a93a1aa38abef1418d0e91d5c3aa/ss_dedb4216e727a93a1aa38abef1418d0e91d5c3aa.1920x1080.jpg?t=1764153330","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2798320/dedb4216e727a93a1aa38abef1418d0e91d5c3aa/ss_dedb4216e727a93a1aa38abef1418d0e91d5c3aa.600x338.jpg?t=1764153330"}],"short_description":"Join Sami on this epic adventure to rescue his friends from the evil monkey Albert VII! Use Sami\u2019s rolling ability to boost, bounce and grapple across several worlds! Can you save all your friends and thwart Albert's wicked plans?","steam_appid":2798320,"support_info":{"email":"support@sonzaigames.com","url":""},"supported_languages":"English, Spanish - Spain, Japanese","type":"game","website":null}