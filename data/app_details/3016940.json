full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3016940/2f4a808371d0a46408102fc180cc857c14707ff3/ss_2f4a808371d0a46408102fc180cc857c14707ff3.1920x1080.jpg?t=1768165402","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3016940/2f4a808371d0a46408102fc180cc857c14707ff3/ss_2f4a808371d0a46408102fc180cc857c14707ff3.600x338.jpg?t=1768165402"}],"short_description":"Become the architect of a thriving ant colony in this real-time simulation. Establish and evolve your ant colony, grow specialized worker castes, cultivate fungus, and explore a living world above and below ground where day and night bring shifting challenges and resources.","steam_appid":3016940,"support_info":{"email":"wietrack.softwork@gmail.com","url":"http://wietrack.cz/contact.php"},"supported_languages":"English<strong>*</strong>, Czech<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://wietrack.cz/goa/"}