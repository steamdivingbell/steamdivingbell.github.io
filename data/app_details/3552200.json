"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552200/03cf5c8a78b3206580df9bf417c3f2d3c06eba22/ss_03cf5c8a78b3206580df9bf417c3f2d3c06eba22.1920x1080.jpg?t=1756227866","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552200/03cf5c8a78b3206580df9bf417c3f2d3c06eba22/ss_03cf5c8a78b3206580df9bf417c3f2d3c06eba22.600x338.jpg?t=1756227866"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552200/62caf4d463f1fde3ab5d446154730283e6ecd99e/ss_62caf4d463f1fde3ab5d446154730283e6ecd99e.1920x1080.jpg?t=1756227866","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552200/62caf4d463f1fde3ab5d446154730283e6ecd99e/ss_62caf4d463f1fde3ab5d446154730283e6ecd99e.600x338.jpg?t=1756227866"}],"short_description":"Anomaly-Spotting Horror inside a cursed house ruled by a twisted lawyer. Dr. John Ravenwood watches your every move. Spot the shifting horrors or suffer his twisted justice. In the end, you\u2019ll sign his contract\u2026 and no, you don\u2019t get a lawyer.","steam_appid":3552200,"support_info":{"email":"patrik.macsuga.game.dev@outlook.com","url":""},"supported_languages":"English<strong>*</strong>, Hungarian, German, French, Italian, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Ukrainian, Romanian<br><strong>*</strong>languages with full audio support","type":"game","website":null}