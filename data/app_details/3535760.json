597e38a7079d233c25c33/ss_af510dfb70bd11d6d48597e38a7079d233c25c33.600x338.jpg?t=1773772536"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3535760/1fd6a451c728edf5670c3f7cad0e58de12e2c3fe/ss_1fd6a451c728edf5670c3f7cad0e58de12e2c3fe.1920x1080.jpg?t=1773772536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3535760/1fd6a451c728edf5670c3f7cad0e58de12e2c3fe/ss_1fd6a451c728edf5670c3f7cad0e58de12e2c3fe.600x338.jpg?t=1773772536"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3535760/f87b5ad30619e2ff142057f677a6451e6070f036/ss_f87b5ad30619e2ff142057f677a6451e6070f036.1920x1080.jpg?t=1773772536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3535760/f87b5ad30619e2ff142057f677a6451e6070f036/ss_f87b5ad30619e2ff142057f677a6451e6070f036.600x338.jpg?t=1773772536"}],"short_description":"High Above is a cozy rooftop-building game about finding peace in the skies. Design and grow your perfect rooftop retreat, from vibrant Mediterranean courtyards to modern urban hideaways. Watch the world come to life around you, at your own pace, in your own little oasis.","steam_appid":3535760,"support_info":{"email":"alex@dvision.games","url":""},"supported_languages":"English, Polish, Russian, Simplified Chinese, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Turkish","type":"game","website":"https://www.unikat-label.com/high-above"}