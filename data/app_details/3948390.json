68e84b6451a62874d87/ss_f50881c2ae4e8f4f7dfb768e84b6451a62874d87.600x338.jpg?t=1755289659"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3948390/5a09d355b94326dec435d543aae293b2c52ca167/ss_5a09d355b94326dec435d543aae293b2c52ca167.1920x1080.jpg?t=1755289659","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3948390/5a09d355b94326dec435d543aae293b2c52ca167/ss_5a09d355b94326dec435d543aae293b2c52ca167.600x338.jpg?t=1755289659"}],"short_description":"Defeat Satan by digging through the nine circles of Hell, platforming, and battling demons and mythical creatures in this rogue-lite incremental game inspired by Dante\u2019s Inferno, where you can upgrade yourself to become extremely overpowered.","steam_appid":3948390,"support_info":{"email":"viciousloop@outlook.com","url":"https://discord.gg/48w9N46zZU"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}