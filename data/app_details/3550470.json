/3550470/extras/686924042a567f95b0e22ca57d1d3762.webm?t=1752321282\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3550470/extras/686924042a567f95b0e22ca57d1d3762.mp4?t=1752321282\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Photo and Video Submission Guidelines</h2><p class=\"bb_paragraph\" >Whether for commercial or non-commercial purposes, you are free to use this game's footage in YouTube videos, live streams, or on websites.</p><p class=\"bb_paragraph\" ></p>","developers":["Mukai Systems"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3550470/96ea18e796768c15c1021d687e9b595c15fdb380/header.jpg?t=1752321282","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 10.15<br></li><li><strong>Processor:</strong> Apple M1/Intel<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Storage:</strong> 400 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 15<br></li><li><strong>Processor:</strong> Apple M4<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Storage:</strong> 600 MB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3550470/341524543/8fd9b1af772d36faf52e67068a21cc2e6e31843c/1750859862/dash_av1.mpd?t=1749821616","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3550470/341524543/8fd9b1af772d36faf52e67068a21cc2e6e31843c/1750859862/dash_h264.mpd?t=1749821616","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3550470/341524543/8fd9b1af772d36faf52e67068a21cc2e6e31843c/1750859862/hls_264_master.m3u8?t=1749821616","id":257138015,"name":"Trai