/apps/3165090/44d6d5d6de8e9cdfee9cbb861e42355ef871774b/ss_44d6d5d6de8e9cdfee9cbb861e42355ef871774b.600x338.jpg?t=1769028749"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3165090/9bce0b37614ec32d9676be1a91497b0fb72458bf/ss_9bce0b37614ec32d9676be1a91497b0fb72458bf.1920x1080.jpg?t=1769028749","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3165090/9bce0b37614ec32d9676be1a91497b0fb72458bf/ss_9bce0b37614ec32d9676be1a91497b0fb72458bf.600x338.jpg?t=1769028749"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3165090/ce8437beb1c81751022f6b3406b00264931f0ce8/ss_ce8437beb1c81751022f6b3406b00264931f0ce8.1920x1080.jpg?t=1769028749","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3165090/ce8437beb1c81751022f6b3406b00264931f0ce8/ss_ce8437beb1c81751022f6b3406b00264931f0ce8.600x338.jpg?t=1769028749"}],"short_description":"Fancy some cards, alchemist? Grime &amp; Gold is a small game about stacking and mixing cards to craft strange recipes. Open boosters, delve into dungeons to find rare resources, hire goblins to help you to craft the Holy Grail and save the city, and don't forget to serve your shady clients!","steam_appid":3165090,"support_info":{"email":"grimeandgoldgame@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://linktr.ee/grimeandgoldgame"}