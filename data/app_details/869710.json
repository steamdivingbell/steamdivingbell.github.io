E, DISCOVER, ENCOUNTER</h2>Travel across mountains and forests, swamps and settlements. Meet the locals - and wipe them out!<br><br>Some of them will join you on your conquest against evil.<br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/869710/extras/28a2653c7c0fb59f1919e0806ca132fc.avif?t=1695111607\" width=628 height=200 /></span>","developers":["Extra Nice"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/869710/header.jpg?t=1695111607","is_free":false,"legal_notice":"\u00a9 2018 Extra Nice","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/869710/198478/dc4028d4ee8ce4d7772815be052c904fd9273fb9/1751156160/dash_av1.mpd?t=1559831608","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/869710/198478/dc4028d4ee8ce4d7772815be052c904fd9273fb9/1751156160/dash_h264.mpd?t=1559831608","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/869710/198478/dc4028d4ee8ce4d7772815be052c904fd9273fb9/1751156160/hls_264_master.m3u8?t=1559831608","id":256737050,"name":"Story Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256737050/movie.293x165.jpg?t=1559831608"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/869710/198340/55d629467ac4bf8dda4c7830b3d56355900fba89/1751156158/dash_av1.mpd?t=1559816913","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/869710/198340/55d629467ac4bf8dda4c7830b3d56355900fba89/1751156158/dash_h264.mpd?t=1559816913","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/869710/198340/55d629467ac4bf8dda4c7830b3d56355900fba89/1751156158/hls_264_master.m3u8?t=1559816913","id":256736991,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com