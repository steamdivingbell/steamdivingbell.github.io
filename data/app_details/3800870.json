:6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/9a3bf751c5da2bf8ceb6a09bf8e946b93645ba06/ss_9a3bf751c5da2bf8ceb6a09bf8e946b93645ba06.1920x1080.jpg?t=1772266460","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/9a3bf751c5da2bf8ceb6a09bf8e946b93645ba06/ss_9a3bf751c5da2bf8ceb6a09bf8e946b93645ba06.600x338.jpg?t=1772266460"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/305ede779fd82b65e1b3233b59629015b00af755/ss_305ede779fd82b65e1b3233b59629015b00af755.1920x1080.jpg?t=1772266460","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/305ede779fd82b65e1b3233b59629015b00af755/ss_305ede779fd82b65e1b3233b59629015b00af755.600x338.jpg?t=1772266460"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/666f2dc0b3b48e5447c3f4e05f8898e9f7def9c3/ss_666f2dc0b3b48e5447c3f4e05f8898e9f7def9c3.1920x1080.jpg?t=1772266460","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/666f2dc0b3b48e5447c3f4e05f8898e9f7def9c3/ss_666f2dc0b3b48e5447c3f4e05f8898e9f7def9c3.600x338.jpg?t=1772266460"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/9d5b19ca05a460d3075b00a9dd2bd8ebbcc18347/ss_9d5b19ca05a460d3075b00a9dd2bd8ebbcc18347.1920x1080.jpg?t=1772266460","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/9d5b19ca05a460d3075b00a9dd2bd8ebbcc18347/ss_9d5b19ca05a460d3075b00a9dd2bd8ebbcc18347.600x338.jpg?t=1772266460"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/02883b744cd0c2533344b26fc258b04a96af3202/ss_02883b744cd0c2533344b26fc258b04a96af3202.1920x1080.jpg?t=1772266460","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3800870/02883b744cd0c2533344b26fc258b04a96af3202/ss_02883b744cd0c2533344b26fc258b04a96af3202.600x338.jpg?t=1772266460"}],"short_description":"Divineblaze : March Tactics is a roguelite tactical RPG. Assemble your expedition, battle unique foes, and forge your ultimate squad. Customize tactics with gear and skills to crush nefarious leaders.","steam_appid":3800870,"support_info":{"email":"ldgamestudio@outlook.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese","type":"game","website":null}