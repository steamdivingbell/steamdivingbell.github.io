ssets/steam/apps/3583970/7492a0572d6f25b5cda292fa90eec1a5ee128ad6/ss_7492a0572d6f25b5cda292fa90eec1a5ee128ad6.600x338.jpg?t=1773868726"}],"short_description":"Go alone or with other contractors on time-limited missions set in a dark and liminal procedurally generated forest. Use your wits and the equipment provided to find your bearings, get Mycelium, complete objectives, and extract alive. But be wary \u2013 you are being watched.","steam_appid":3583970,"support_info":{"email":"pokolustudio@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Ukrainian<br><strong>*</strong>languages with full audio support","type":"game","website":null}