ed"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/344e6825048f79b541c6951200b9d8a96b53c1d4/ss_344e6825048f79b541c6951200b9d8a96b53c1d4.1920x1080.jpg?t=1757798163","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/344e6825048f79b541c6951200b9d8a96b53c1d4/ss_344e6825048f79b541c6951200b9d8a96b53c1d4.600x338.jpg?t=1757798163"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/f4ef121fa252fa8af62a4e1751aab11840174b83/ss_f4ef121fa252fa8af62a4e1751aab11840174b83.1920x1080.jpg?t=1757798163","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/f4ef121fa252fa8af62a4e1751aab11840174b83/ss_f4ef121fa252fa8af62a4e1751aab11840174b83.600x338.jpg?t=1757798163"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/db908ebf09788796bfd2e36b917fe6c264048776/ss_db908ebf09788796bfd2e36b917fe6c264048776.1920x1080.jpg?t=1757798163","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/db908ebf09788796bfd2e36b917fe6c264048776/ss_db908ebf09788796bfd2e36b917fe6c264048776.600x338.jpg?t=1757798163"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/4b6b61e83d2baf7c5ef19122626debd823497a57/ss_4b6b61e83d2baf7c5ef19122626debd823497a57.1920x1080.jpg?t=1757798163","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/4b6b61e83d2baf7c5ef19122626debd823497a57/ss_4b6b61e83d2baf7c5ef19122626debd823497a57.600x338.jpg?t=1757798163"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/ce30e8b2e9a674ae578931a66099b9cc2976b265/ss_ce30e8b2e9a674ae578931a66099b9cc2976b265.1920x1080.jpg?t=1757798163","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583970/ce30e