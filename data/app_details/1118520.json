/apps/1118520/ss_4bdd8607569b11de50fe0fdfed3152cc43e9033f.1920x1080.jpg?t=1759243456","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1118520/ss_4bdd8607569b11de50fe0fdfed3152cc43e9033f.600x338.jpg?t=1759243456"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1118520/6351f29224f613e11c30b681a17118217d63da85/ss_6351f29224f613e11c30b681a17118217d63da85.1920x1080.jpg?t=1759243456","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1118520/6351f29224f613e11c30b681a17118217d63da85/ss_6351f29224f613e11c30b681a17118217d63da85.600x338.jpg?t=1759243456"}],"short_description":"You live and then you die. But at least do it in a nice house! Paralives is an upcoming life simulation game. Build your dream house, create some characters and manage their lives the way you want!","steam_appid":1118520,"support_info":{"email":"","url":"https://www.paralives.com/contact"},"supported_languages":"English, French, Italian, German, Polish, Portuguese - Brazil, Spanish - Latin America, Simplified Chinese","type":"game","website":"https://paralives.com"}