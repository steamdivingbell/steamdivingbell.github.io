ai.steamstatic.com/store_item_assets/steam/apps/1653360/extras/gameplay.jpg?t=1746375427\" /></p>","developers":["Daniel Brendel"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1653360/db19ea722ea1a2c9818ceaa74db2dc79995d2c65/header.jpg?t=1746375427","is_free":true,"legal_notice":"Game is (C) by Daniel Brendel<br />\r\nMenu theme licensed to Daniel Brendel for Hyper Frenzy, created by Manuel Senfft (www.tagirijus.de)","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":256954652,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/256954652/movie480.mp4?t=1687478121","max":"http://video.akamai.steamstatic.com/store_trailers/256954652/movie_max.mp4?t=1687478121"},"name":"Hyper Frenzy Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256954652/movie.293x165.jpg?t=1687478121","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/256954652/movie480_vp9.webm?t=1687478121","max":"http://video.akamai.steamstatic.com/store_trailers/256954652/movie_max_vp9.webm?t=1687478121"}}],"name":"Hyper Frenzy","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS *:</strong> Windows 7 or above<br></li><li><strong>Processor:</strong> 1.5 Ghz or more<br></li><li><strong>Memory:</strong> 1024 MB RAM<br></li><li><strong>Graphics:</strong> Intel HD chipcard or better<br></li><li><strong>DirectX:</strong> Version 9.0</l