item_assets/steam/apps/4008370/407edba669f1ec725804d5784b1cb7eff117b8fb/ss_407edba669f1ec725804d5784b1cb7eff117b8fb.1920x1080.jpg?t=1759958583","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/407edba669f1ec725804d5784b1cb7eff117b8fb/ss_407edba669f1ec725804d5784b1cb7eff117b8fb.600x338.jpg?t=1759958583"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/d58e83661013a82af018f8e4fbe97278e6a9a790/ss_d58e83661013a82af018f8e4fbe97278e6a9a790.1920x1080.jpg?t=1759958583","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/d58e83661013a82af018f8e4fbe97278e6a9a790/ss_d58e83661013a82af018f8e4fbe97278e6a9a790.600x338.jpg?t=1759958583"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/b63c87fcda75833365502a771109993ec55dbae7/ss_b63c87fcda75833365502a771109993ec55dbae7.1920x1080.jpg?t=1759958583","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/b63c87fcda75833365502a771109993ec55dbae7/ss_b63c87fcda75833365502a771109993ec55dbae7.600x338.jpg?t=1759958583"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/982db7844fa3991837256cea62bee162f359fe7a/ss_982db7844fa3991837256cea62bee162f359fe7a.1920x1080.jpg?t=1759958583","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/982db7844fa3991837256cea62bee162f359fe7a/ss_982db7844fa3991837256cea62bee162f359fe7a.600x338.jpg?t=1759958583"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/dac7a144045c8ab10a2944896d3cbdad8e412b51/ss_dac7a144045c8ab10a2944896d3cbdad8e412b51.1920x1080.jpg?t=1759958583","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008370/dac7a144045c8ab10a2944896d3cbdad8e412b51/ss_dac7a144045c8ab10a2944896d3cbdad8e412b51.600x338.jpg?t=17599585