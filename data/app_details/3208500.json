th_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/22d0616fc4582baddd3a705f205f6ff4c4cc6ae2/ss_22d0616fc4582baddd3a705f205f6ff4c4cc6ae2.1920x1080.jpg?t=1764489814","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/22d0616fc4582baddd3a705f205f6ff4c4cc6ae2/ss_22d0616fc4582baddd3a705f205f6ff4c4cc6ae2.600x338.jpg?t=1764489814"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/4fde84369b27cd618cfe31611b9a82d418ac5cee/ss_4fde84369b27cd618cfe31611b9a82d418ac5cee.1920x1080.jpg?t=1764489814","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/4fde84369b27cd618cfe31611b9a82d418ac5cee/ss_4fde84369b27cd618cfe31611b9a82d418ac5cee.600x338.jpg?t=1764489814"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/4a4bf8b05fac1e1253b32caf48cd6396331a8711/ss_4a4bf8b05fac1e1253b32caf48cd6396331a8711.1920x1080.jpg?t=1764489814","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/4a4bf8b05fac1e1253b32caf48cd6396331a8711/ss_4a4bf8b05fac1e1253b32caf48cd6396331a8711.600x338.jpg?t=1764489814"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/fb1750193da426b70aecb277c81af425d4e430e5/ss_fb1750193da426b70aecb277c81af425d4e430e5.1920x1080.jpg?t=1764489814","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/fb1750193da426b70aecb277c81af425d4e430e5/ss_fb1750193da426b70aecb277c81af425d4e430e5.600x338.jpg?t=1764489814"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/846ced13090e4f53ad16f2556db47f3765c684e8/ss_846ced13090e4f53ad16f2556db47f3765c684e8.1920x1080.jpg?t=1764489814","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3208500/846ced13090e4f53ad16f2556db47f3765c684e8/ss_846ced13090e4f53ad16f2556db47f3765c684e8.600x338.jpg?t=1764489814"}],"short_description":"Monsters are invading the world! It's up to your team of scientists to pilot your giant robot and save the day. Strategize your way through monster battles, discover cartridges to control your robot, modify it and your deck, collaborate on strategic combinations, and put an end to the invasion.","steam_appid":3208500,"support_info":{"email":"","url":"https://www.bigadventure.games/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://linktr.ee/bigadventure"}