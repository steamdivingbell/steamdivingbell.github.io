3481838"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839250/61fe5ca6a7e2ab93671c651b89e9a3244366dfb0/ss_61fe5ca6a7e2ab93671c651b89e9a3244366dfb0.1920x1080.jpg?t=1773481838","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839250/61fe5ca6a7e2ab93671c651b89e9a3244366dfb0/ss_61fe5ca6a7e2ab93671c651b89e9a3244366dfb0.600x338.jpg?t=1773481838"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839250/018044b0d659ba5a06759105d9696642f5ed34fd/ss_018044b0d659ba5a06759105d9696642f5ed34fd.1920x1080.jpg?t=1773481838","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839250/018044b0d659ba5a06759105d9696642f5ed34fd/ss_018044b0d659ba5a06759105d9696642f5ed34fd.600x338.jpg?t=1773481838"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839250/381f33f58d403d4ac50ea5f10edaac0cdf611eb9/ss_381f33f58d403d4ac50ea5f10edaac0cdf611eb9.1920x1080.jpg?t=1773481838","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839250/381f33f58d403d4ac50ea5f10edaac0cdf611eb9/ss_381f33f58d403d4ac50ea5f10edaac0cdf611eb9.600x338.jpg?t=1773481838"}],"short_description":"In \u2019Soulforge Lost Path \u2018, become a legendary hunter slaughtering endless Corrupted Souls. Scavenge Sacred Remains to forge Exorcist Artefacts, manage limited inventory strategically, and uncover the world's festering corruption truth.","steam_appid":3839250,"support_info":{"email":"","url":"https://www.ziyue-tech.com/"},"supported_languages":"Simplified Chinese<strong>*</strong>, English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}