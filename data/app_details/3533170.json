d.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/83fda9e40f7ab43cab5af66857fb7aee.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/86ea01e2988e5e812979ea3585f21e5a.avif?t=1773995393\" width=560 height=138 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/481cdc8184de104aaaccc1eee24ccf3d.avif?t=1773995393\" width=566 height=145 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/b4f920fd20f84c745d3c56acbaf424e2.avif?t=1773995393\" width=800 height=180 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/c8b51d1f2cb8c84aa0beeae1a87302d4.poster.avif?t=1773995393\" width=1170 height=650 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/c8b51d1f2cb8c84aa0beeae1a87302d4.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/c8b51d1f2cb8c84aa0beeae1a87302d4.mp4?t=1773995393\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>UNION,\u00a0</strong>otherwise known as\u00a0<strong>University of Rungeon</strong>, is one of the biggest universities in <strong>Rungeon City</strong>.</p><p class=\"bb_paragraph\" style=\"text-align: center\"> It boasts a large number of study programs and technological advancement, </p><p class=\"bb_paragraph\" style=\"text-align: center\">while producing people with special skill as well.</p><p class=\"bb_paragraph\" style=\"text-align: center\"> However, not all parts of <strong>UNION</strong> are as flawless as people see it.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/26f08a5b75c3fa17b0b2e7a9e998a174.poster.avif?t=1773995393\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/26f08a5b75c3fa17b0b2e7a9e998a174.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/26f08a5b75c3fa17b0b2e7a9e998a174.mp4?t=1773995393\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/0fedee5d26c282495c5e005e81b09a6d.poster.avif?t=1773995393\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/0fedee5d26c282495c5e005e81b09a6d.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/0fedee5d26c282495c5e005e81b09a6d.mp4?t=1773995393\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" style=\"text-align: center\">Hunt through UNION as the new student Farid, or bring Rani along to double the trouble!</p><p class=\"bb_paragraph\" style=\"text-align: center\"> Raid off-limit zones, gather clues, and rip apart the campus conspiracy. It\u2019s day one, so go out and meet the newcomers\u2014but keep your fists ready, because not everyone is here to be your friend.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>Class is out. War is in. </strong></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>FARID &amp; RANI: Let your fists do the talking!</strong></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/e3f23ac429289c10e179cb9e17fa5bd5.avif?t=1773995393\" width=800 height=180 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/25dc4196bcd5257f90da3160e0a97771.poster.avif?t=1773995393\" width=1170 height=490 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/25dc4196bcd5257f90da3160e0a97771.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/25dc4196bcd5257f90da3160e0a97771.mp4?t=1773995393\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" style=\"text-align: center\">Thugs trashing the campus?</p><p class=\"bb_paragraph\" style=\"text-align: center\">Unknown city gangsters suddenly barged into the university to wreak havoc!</p><p class=\"bb_paragraph\" style=\"text-align: center\"> Farid has no choice but to handle the situation, classic action movie style!<strong> </strong></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>Wrong place, wrong time. Time to clean house!</strong></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/24bd47c87b4515e35cb501dd2f39f9ca.avif?t=1773995393\" width=800 height=180 /></span><strong> </strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/cb0fcb05dda2a29e645f947e01198eb5.poster.avif?t=1773995393\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/cb0fcb05dda2a29e645f947e01198eb5.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/cb0fcb05dda2a29e645f947e01198eb5.mp4?t=1773995393\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/3e39f1cf2bef318380140729f2b3248a.avif?t=1773995393\" width=1080 height=719 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>\u3010Garuda Emblem supports Xbox controllers and mostly other generic USB joysticks.\u3011</strong></p><p class=\"bb_paragraph\" style=\"text-align: center\">Move, scrubs! I'm late for class.</p><p class=\"bb_paragraph\" style=\"text-align: center\">Build the meter, unleash the beast, and K.O. 'em all!</p><p class=\"bb_paragraph\" style=\"text-align: center\">Dynamic Combo Mechanics\u00a0allows you to utilize a variety of attacks and skills to beat the bad guys!</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/b23681f0cbfabb6a2b375dab5db7fed0.avif?t=1773995393\" width=800 height=180 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/93afdcc839364e56de472c6059341172.poster.avif?t=1773995393\" width=1170 height=660 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/93afdcc839364e56de472c6059341172.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/93afdcc839364e56de472c6059341172.mp4?t=1773995393\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>One\u2019s a fight, two\u2019s a riot!</strong></p><p class=\"bb_paragraph\" style=\"text-align: center\">Take on the campus conspiracy solo in <strong>Single Player Story Mode</strong>, or tag in a homie for <strong>Multiplayer Arcade Co-op Mode</strong> to turn the hallways into a total riot.</p><p class=\"bb_paragraph\" style=\"text-align: center\"> Whether you\u2019re grinding alone or smashing skulls with a friend, the mission is simple: kick ass and take names.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/c5fe0f96ff8e37740ebd0000540db647.avif?t=1773995393\" width=800 height=180 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/d7569661f1645b9ee9bb94830e7ff884.poster.avif?t=1773995393\" width=1170 height=660 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/d7569661f1645b9ee9bb94830e7ff884.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/d7569661f1645b9ee9bb94830e7ff884.mp4?t=1773995393\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" style=\"text-align: center\">Rules are for nerds\u2014grab a trash can, a mop, whatever\u2019s handy, and crack some skulls!</p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>Keep your toes on the ground! </strong></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>Since it's a street fight, use your surrounding for your advantages!</strong></p><p class=\"bb_paragraph\" style=\"text-align: center\">No rules! Use anything as your weapon. Do everything you can to survive!</p><h2 class=\"bb_tag\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/8a5fed01a13b4c5aa0a36ec43aae0c27.avif?t=1773995393\" width=800 height=180 /></span></h2><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Hand-drawn </strong>sprites, environment, as well as effects and animation</p></li><li><p class=\"bb_paragraph\" ><strong>Learn new abilities and skills</strong> from fights to develop your characters.</p></li><li><p class=\"bb_paragraph\" ><strong>Character selection</strong> and <strong>customization</strong> (skill tree and equipment).</p></li><li><p class=\"bb_paragraph\" ><strong>Day</strong> and <strong>night</strong> cycle.</p></li><li><p class=\"bb_paragraph\" >Various <strong>side quest</strong> and <strong>mini games</strong>.</p></li><li><p class=\"bb_paragraph\" ><strong>More places</strong> to explore, <strong>more enemies</strong> to face, and <strong>more mysteries\u00a0</strong>waiting to be solved!</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/86ea01e2988e5e812979ea3585f21e5a.avif?t=1773995393\" width=560 height=138 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/481cdc8184de104aaaccc1eee24ccf3d.avif?t=1773995393\" width=566 height=145 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/a2580427165eb289c6e98fb35a03ef37.poster.avif?t=1773995393\" width=500 height=120 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/a2580427165eb289c6e98fb35a03ef37.webm?t=1773995393\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/extras/a2580427165eb289c6e98fb35a03ef37.mp4?t=1773995393\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p>","developers":["Team Batalion","Vifth Floor"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533170/52d9aeb82e355c728f416951d50d41c7a49d4ba4/header.jpg?t=1773995393","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3533170/1966562370/caafd1935385933aa2cc52