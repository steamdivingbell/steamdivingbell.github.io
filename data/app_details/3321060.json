ef67211.poster.avif?t=1752880043\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/670d8a255954a7944a2a8b275ef67211.webm?t=1752880043\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/670d8a255954a7944a2a8b275ef67211.mp4?t=1752880043\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/c40825a4fa800ca231eba18962680894.avif?t=1752880043\" data-has-big /></div></p><p class=\"bb_paragraph\">Fast-paced grappling hook movement with no speed cap\u2014go as fast as your skill allows. Just don't crash: almost any collision means death.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/1ff2b2d82c076fa339de235c3314896f.poster.avif?t=1752880043\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/1ff2b2d82c076fa339de235c3314896f.webm?t=1752880043\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/1ff2b2d82c076fa339de235c3314896f.mp4?t=1752880043\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Compete for medals and try to beat times set by the developers themselves.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Race against up to 10 friends in online multiplayer lobbies.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">90 handcrafted levels across 5 unique themes\u2014each a playground for speedrunning mastery.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/d6508b2114815f5a349f41d49cb02020.poster.avif?t=1752880043\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/d6508b2114815f5a349f41d49cb02020.webm?t=1752880043\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/extras/d6508b2114815f5a349f41d49cb02020.mp4?t=1752880043\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Customize your look with unlockable skins, trails, and grappling hooks.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Find your own path. Levels are designed as obstacle courses with multiple routes.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Push your limits with brutally difficult challenge levels meant for only the most skilled players.</p>","developers":["Backcannon Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Racing","id":"9"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321060/a3e85b8afd37ab06647e664845c21ed2901d8e34/header.jpg?t=1752880043","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257169838,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257169838/movie480.mp4?t=1752880038","max":"http://video.akamai.steamstatic.com/store_trailers/257169838/movie_max.mp4?t=1752880038"},"name":"Bean There, Swung That | Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257169838/418f692615a4e1b101767b469cdabd2dbf604320/movie_600x337.jpg?t=1752880038","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257169838/movie480_vp9.webm?t=1752880038","max":"http://video.akamai.steamstatic.com/store_trailers/257169838/movie_max_vp9.webm?t=1752880038