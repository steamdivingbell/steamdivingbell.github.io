ic.com/store_item_assets/steam/apps/3751520/ecaac221b62d92c69d1eca29ee7bba527c197bbf/ss_ecaac221b62d92c69d1eca29ee7bba527c197bbf.600x338.jpg?t=1768998959"}],"short_description":"Shaky Hand is an arcade game where you deliver food to tables and avoid dropping it on the floor. Dodge obstacles and work quickly before your customers get upset!","steam_appid":3751520,"support_info":{"email":"contact@ritual-interactive.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}