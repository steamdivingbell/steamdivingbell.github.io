steam/apps/3795000/extras/ceecad99a896aa3db52898199f97e2e7.mp4?t=1773656164\" type=\"video/mp4\"></video></span> </p><p class=\"bb_paragraph\" ><strong>Unravel a Compelling Narrative:\u00a0</strong>Interact with a core cast of characters, each with their own stake in the unfolding story. Progress through a compelling, quest-driven main story and take on optional side quests to uncover more about the world and earn valuable rewards.</p>","developers":["Loomeit Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795000/86a2c1b84af67679ede24f4a4ce8b4e46d91f29b/header.jpg?t=1773656164","is_free":false,"legal_notice":"\u00a9 2025 Loomeit Studios. All rights reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3795000/271045168/c906e6e4deeab3bac19be858e0da6f194cbf2df8/1752697098/dash_av1.mpd?t=1753453767","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3795000/271045168/c906e6e4deeab3bac19be858e0da6f194cbf2df8/1752697098/dash_h264.mpd?t=1753453767","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3795000/271045168/c906e6e4deeab3bac19be858e0da6f194cbf2df8/1752697098/hls_264_master.m3u8?t=1753453767","id":257167772,"name":"Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257167772/7606c8c75d190be511819629e9f8c10e63b2ea0b/movie_600x337.jpg?t=1753453767"}],"name":"Open Robot","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>