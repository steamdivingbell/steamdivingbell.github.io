ng action, joy and plenty of chaos to enjoy with friends.</p><p class=\"bb_paragraph\" >Play, enjoy and give us your positive review.</p><p class=\"bb_paragraph\" >Bye</p>","developers":["Jamceco"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2896790/ac3b7c9d56eb7d437cb6f644b393ca56dff1af71/header.jpg?t=1771284750","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2896790/747677/6283aa116a9ee9aa8dfc5f116d2018e9a091ae8c/1750951785/dash_av1.mpd?t=1729042373","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2896790/747677/6283aa116a9ee9aa8dfc5f116d2018e9a091ae8c/1750951785/dash_h264.mpd?t=1729042373","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2896790/747677/6283aa116a9ee9aa8dfc5f116d2018e9a091ae8c/1750951785/hls_264_master.m3u8?t=1729042373","id":257050405,"name":"FEW Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257050405/movie.293x165.jpg?t=1729042373"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2896790/779559/137a7255007c2a70b9c4d9508045a45ee255be6f/1750951786/dash_av1.mpd?t=1730340671","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2896790/779559/137a7255007c2a70b9c4d9508045a45ee255be6f/1750951786/dash_h264.mpd?t=1730340671","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2896790/779559/137a7255007c2a70b9c4d9508045a45ee255be6f/1750951786/hls_264_master.m3u8?t=1730340671","id":257069775,"name":"Characters","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257069775/8745aa425d1e081a84561fea10c4c816625ee435/movie_600x337.jpg?t=1730340671"}],"name":"Four Elite Warriors","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</st