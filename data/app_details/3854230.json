.com/store_item_assets/steam/apps/3854230/dc38de700d81ff5cf87c555ce6aa383c6ae58b4f/ss_dc38de700d81ff5cf87c555ce6aa383c6ae58b4f.1920x1080.jpg?t=1767867886","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3854230/dc38de700d81ff5cf87c555ce6aa383c6ae58b4f/ss_dc38de700d81ff5cf87c555ce6aa383c6ae58b4f.600x338.jpg?t=1767867886"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3854230/567f04038a72c5da0fecdeb0d34e56c8f185b142/ss_567f04038a72c5da0fecdeb0d34e56c8f185b142.1920x1080.jpg?t=1767867886","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3854230/567f04038a72c5da0fecdeb0d34e56c8f185b142/ss_567f04038a72c5da0fecdeb0d34e56c8f185b142.600x338.jpg?t=1767867886"}],"short_description":"Congratulations, You've been hired as the new nightshift employee at silver lake gas station. Can you survive the night?","steam_appid":3854230,"support_info":{"email":"joytreestudios@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Arabic, Simplified Chinese, Portuguese - Brazil, Bulgarian, Danish, Indonesian, Dutch, Finnish, Traditional Chinese, Japanese, Korean, Spanish - Latin America, Polish, Hungarian, Norwegian, Portuguese - Portugal, Romanian, Russian, Thai, Turkish, Ukrainian, Vietnamese, Greek, Czech, Swedish","type":"game","website":null}