ca14a38e8258f6c76e0a17c0e1427b15b97c95.600x338.jpg?t=1761668913"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897520/bb55f43313ae0e4d3eaebd6d4488276e1b07211f/ss_bb55f43313ae0e4d3eaebd6d4488276e1b07211f.1920x1080.jpg?t=1761668913","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897520/bb55f43313ae0e4d3eaebd6d4488276e1b07211f/ss_bb55f43313ae0e4d3eaebd6d4488276e1b07211f.600x338.jpg?t=1761668913"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897520/bec94ea86ae73bd704a1d7103aadcc79f26a0cce/ss_bec94ea86ae73bd704a1d7103aadcc79f26a0cce.1920x1080.jpg?t=1761668913","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897520/bec94ea86ae73bd704a1d7103aadcc79f26a0cce/ss_bec94ea86ae73bd704a1d7103aadcc79f26a0cce.600x338.jpg?t=1761668913"}],"short_description":"Build 3D jigsaw puzzles of famous works of art, sculptures, artifacts and more. An evocative, visually stunning experience with immersive soundscapes and intuitive\u00a0mechanics. Two gameplay modes: &quot;Chill&quot; for relaxing and &quot;Assembly&quot; for a more challenging puzzle interaction.","steam_appid":3897520,"support_info":{"email":"info@pazlstudio.com","url":""},"supported_languages":"English","type":"game","website":"https://www.kickstarter.com/projects/1831872668/pazleum-3d-jigsaw-puzzle-museum"}