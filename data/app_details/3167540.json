 <br><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3167540/extras/0329__2__5_.gif?t=1743266897\" /> </p><p class=\"bb_paragraph\"></p></li><li><p class=\"bb_paragraph\"><strong><u>Twitch &amp; Streaming integration</u></strong><br>Connect to your stream and let chat join your cafe and become your customer.<strong> </strong> <br><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3167540/extras/0329__2__1_.gif?t=1743266897\" /></p></li><li><p class=\"bb_paragraph\"><strong><u>Send presents to your friends</u></strong><br>Send fresh ingredients from your farm to your IRL friend via postal service.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3167540/extras/0329__3__2_.gif?t=1743266897\" /></p></li></ul><p class=\"bb_paragraph\">Take a break, sip your coffee, and let your cafe flourish.</p>","developers":["Sunny Syrup Studio"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3167540/50c5888d480c93a16a3e625c1264d61149da73e0/header.jpg?t=1743266897","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257119147,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257119147/movie480.mp4?t=1743079878","max":"http://video.akamai.steamstatic.com/store_trailers/257119147/movie_max.mp4?t=1743079878"},"name":"Brief Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257119147/7b0f70784d5d0e1dd9444b39597bf1cdc184dc62/movie_600x337.jpg?t=1743079878","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257119147/movie480_vp9.webm?t=1743079878","max":"http://video.akamai.steamstatic.com/store_trailers/257119147/movie_max_vp9.webm?t=1743079878"}},{"highli