ared.akamai.steamstatic.com/store_item_assets/steam/apps/1928320/ss_df5aa8efc0208df6c27ccc131f1621ff36cb2d17.600x338.jpg?t=1769568665"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1928320/ss_dd8701a01011f831a4475228ea8b78d678364ec8.1920x1080.jpg?t=1769568665","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1928320/ss_dd8701a01011f831a4475228ea8b78d678364ec8.600x338.jpg?t=1769568665"}],"short_description":"Join a magical girl with a soda-powered arsenal on a dreamy quest to save her home! In this part beat-\u2018em-up, part musical shooter, you\u2019ll experience the whimsical story of Ria and Gin as they fight against sinister invaders from another dimension\u2026and maybe even groove to that funky beat!","steam_appid":1928320,"support_info":{"email":"","url":"https://www.popslinger.com/"},"supported_languages":"English<strong>*</strong>, Japanese, Spanish - Latin America<br><strong>*</strong>languages with full audio support","type":"game","website":null}