steamstatic.com/store_item_assets/steam/apps/3657460/1afbcfa0ac5ebc46f8c99da94e2104a4c64f2737/ss_1afbcfa0ac5ebc46f8c99da94e2104a4c64f2737.1920x1080.jpg?t=1748070859","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3657460/1afbcfa0ac5ebc46f8c99da94e2104a4c64f2737/ss_1afbcfa0ac5ebc46f8c99da94e2104a4c64f2737.600x338.jpg?t=1748070859"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3657460/1aed81ecd8565b3767af88fde5e1503329530ed8/ss_1aed81ecd8565b3767af88fde5e1503329530ed8.1920x1080.jpg?t=1748070859","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3657460/1aed81ecd8565b3767af88fde5e1503329530ed8/ss_1aed81ecd8565b3767af88fde5e1503329530ed8.600x338.jpg?t=1748070859"}],"short_description":"Lost Taboo Forest is a game about an ordinary person who breaks a taboo and enters a forbidden forest to save his sister. Ominous sounds are approaching as you walk in the darkness, but you can't see what makes the sound. Walk through the darkness and avoid letting the sound get too close.","steam_appid":3657460,"support_info":{"email":"gambutstudio@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}