tatic.com/store_item_assets/steam/apps/3795930/extras/5046118c8045d6d7078d8d651b83101a.mp4?t=1753972119\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\">Rent, supply costs, staff wages... Staying profitable at the end of each day is up to you. Make strategic choices to expand your shop!</p><h2 class=\"bb_tag\"><strong>Ready your cups \u2013 success is brewing!</strong></h2>","developers":["Leartes Games"],"fullgame":{"appid":"3561900","name":"The Roast - Coffee Shop Simulator"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795930/4861147343b5936f6eb60869fd2395f4b5bac40b/header.jpg?t=1753972119","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257175327,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257175327/movie480.mp4?t=1753872694","max":"http://video.akamai.steamstatic.com/store_trailers/257175327/movie_max.mp4?t=1753872694"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257175327/07cf876c6e8868ae072c74ee4d375763bbffebe6/movie_600x337.jpg?t=1753872694","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257175327/movie480_vp9.webm?t=1753872694","max":"http://video.akamai.steamstatic.com/store_trailers/257175327/movie_max_vp9.webm?t=1753872694"}}],"name":"The Roast: Coffee Shop Simulator - Prologue","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 64-bit<br></li><li><strong>Processor:</strong> Intel i5 4690 / AMD FX 8350<br></li><li><strong>Memory:</strong> 8 MB RAM<br></li><li><strong>Graphics:</strong> Nvidia GTX 1050 / RX 570 (4GB+ of VRAM)<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","recommended":"<strong>R