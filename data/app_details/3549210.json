d.akamai.steamstatic.com/store_item_assets/steam/apps/3549210/cd34db7a0ff00a887da21487fec01abba52cc1f1/ss_cd34db7a0ff00a887da21487fec01abba52cc1f1.600x338.jpg?t=1750723134"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549210/5d2fd6794412a2d9dfe26ed1bf010617027869ce/ss_5d2fd6794412a2d9dfe26ed1bf010617027869ce.1920x1080.jpg?t=1750723134","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549210/5d2fd6794412a2d9dfe26ed1bf010617027869ce/ss_5d2fd6794412a2d9dfe26ed1bf010617027869ce.600x338.jpg?t=1750723134"}],"short_description":"Cut open your destiny with 9 cards! Master strategy in a turn-based roguelike auto-battler. Collect cards and survive battles by utilizing 'placement' and 'linking' mechanics.","steam_appid":3549210,"support_info":{"email":"info@mlb.co.jp","url":""},"supported_languages":"English, Simplified Chinese, Japanese","type":"game","website":null}