9713d/ss_87a011b0a8054b4ba7c47b9a9d71056327b9713d.600x338.jpg?t=1763464159"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3010170/c2232c73dc528fdfdce0b6f16a011c4702230bba/ss_c2232c73dc528fdfdce0b6f16a011c4702230bba.1920x1080.jpg?t=1763464159","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3010170/c2232c73dc528fdfdce0b6f16a011c4702230bba/ss_c2232c73dc528fdfdce0b6f16a011c4702230bba.600x338.jpg?t=1763464159"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3010170/e210407a0518baed4d55fbc81aa5e121e4b7997b/ss_e210407a0518baed4d55fbc81aa5e121e4b7997b.1920x1080.jpg?t=1763464159","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3010170/e210407a0518baed4d55fbc81aa5e121e4b7997b/ss_e210407a0518baed4d55fbc81aa5e121e4b7997b.600x338.jpg?t=1763464159"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3010170/94ddf477855247466db06a452cd969752ae21847/ss_94ddf477855247466db06a452cd969752ae21847.1920x1080.jpg?t=1763464159","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3010170/94ddf477855247466db06a452cd969752ae21847/ss_94ddf477855247466db06a452cd969752ae21847.600x338.jpg?t=1763464159"}],"short_description":"Create your very own spooky realm in this relaxing builder/puzzle game. Shape the landscape, place eerie landmarks, open portals, welcome friendly monsters, lay rails for the ghost train, complete special objectives and admire the playfully fiendish little worlds that you create!","steam_appid":3010170,"support_info":{"email":"support@absolutelygames.net","url":"https://www.absolutelygames.net/"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Traditional Chinese, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.fangtopia.com"}