56fcf408d82/ss_bdc57abeafd3a4d5c812d2e520ce556fcf408d82.600x338.jpg?t=1753793936"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3671420/639f34dab10a47d895f3fdf6f2d95db3c0111039/ss_639f34dab10a47d895f3fdf6f2d95db3c0111039.1920x1080.jpg?t=1753793936","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3671420/639f34dab10a47d895f3fdf6f2d95db3c0111039/ss_639f34dab10a47d895f3fdf6f2d95db3c0111039.600x338.jpg?t=1753793936"}],"short_description":"Pipeworks puzzle adds a new twist to the classic sliding-tile puzzle! Connect pipes as you move them in a grid-based arena to match the blueprint. You can only move the pieces into empty tiles, so plan your next move carefully.","steam_appid":3671420,"support_info":{"email":"contact@ninesconnect.com","url":"https://ninesconnect.com"},"supported_languages":"English, Turkish","type":"game","website":null}