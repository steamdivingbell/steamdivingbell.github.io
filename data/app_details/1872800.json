1872800/271cb0b4e036a91056cfd1de7cace335544982a2/ss_271cb0b4e036a91056cfd1de7cace335544982a2.600x338.jpg?t=1768553818"}],"short_description":"EVE Vanguard is a brutal sci-fi shooter. Scavenge resources, upgrade your gear, and outmatch rivals in a universe at war.","steam_appid":1872800,"support_info":{"email":"support@eveonline.com","url":"https://support.eveonline.com/hc/en-us"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://vanguard.eveonline.com/"}