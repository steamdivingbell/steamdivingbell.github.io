nail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2468430/ss_3bbd1c07454e988c4aee121a7818fea74f5d3aba.600x338.jpg?t=1728180190"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2468430/ss_9705cfeea7c18b50355c129168a988e1b70807f3.1920x1080.jpg?t=1728180190","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2468430/ss_9705cfeea7c18b50355c129168a988e1b70807f3.600x338.jpg?t=1728180190"}],"short_description":"Leap into Frogreign! Join frog prince Rill in this amphibious adventure where your tongue is your grappling hook!","steam_appid":2468430,"support_info":{"email":"arkanpixelbusiness@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://arkanpixel.com/games"}