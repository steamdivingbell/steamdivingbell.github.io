ec5d24c97da9106b09602c8b6b89f2fb/ss_4f8ad911ec5d24c97da9106b09602c8b6b89f2fb.600x338.jpg?t=1774306862"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846570/d753f77f57030ba3fb6593383331d681e749519b/ss_d753f77f57030ba3fb6593383331d681e749519b.1920x1080.jpg?t=1774306862","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846570/d753f77f57030ba3fb6593383331d681e749519b/ss_d753f77f57030ba3fb6593383331d681e749519b.600x338.jpg?t=1774306862"}],"short_description":"Have you ever wondered what happens when we fall into a coma? Why do only some make it back? Aphasia is a first-person horror where you\u2019re trapped inside your own mind, with no memory of who you are. As you explore your fractured memories, your sense of guilt won\u2019t let you escape...","steam_appid":3846570,"support_info":{"email":"thelastawakens@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Italian<strong>*</strong>, French, German, Spanish - Spain, Simplified Chinese, Japanese, Portuguese - Brazil, Russian, Ukrainian<br><strong>*</strong>languages with full audio support","type":"game","website":null}