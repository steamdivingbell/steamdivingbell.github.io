demo.</p>","developers":["The K Game Studio"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3947990/ea45e9cb2865586b2a9347d3b4821b5937a15cfe/header.jpg?t=1768313956","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3947990/2145467358/b35606531c38213c1fc6373006c0c205d2254562/1758821138/dash_av1.mpd?t=1758822792","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3947990/2145467358/b35606531c38213c1fc6373006c0c205d2254562/1758821138/dash_h264.mpd?t=1758822792","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3947990/2145467358/b35606531c38213c1fc6373006c0c205d2254562/1758821138/hls_264_master.m3u8?t=1758822792","id":257206307,"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257206307/f43402215acb9778fd5e6ef9a99373b9faeffea7/movie_600x337.jpg?t=1758822792"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3947990/1407050898/ad9ec0a5d8cfac632247da9d4990215188ce8d4b/1758470533/dash_av1.mpd?t=1758471907","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3947990/1407050898/ad9ec0a5d8cfac632247da9d4990215188ce8d4b/1758470533/dash_h264.mpd?t=1758471907","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3947990/1407050898/ad9ec0a5d8cfac632247da9d4990215188ce8d4b/1758470533/hls_264_master.m3u8?t=1758471907","id":257203385,"name":"Intro","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257203385/e85c6fceb8e4fc48978bf7e1c54fe2b4bc145de5/movie_600x337.jpg?t=1758471907"}],"name":"Blackwood's Dilemma","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Storage:</strong> 1 GB available space</li></u