steamstatic.com/store_item_assets/steam/apps/3947990/0d427648e5ce4f96b26433509279fb4094f8196d/ss_0d427648e5ce4f96b26433509279fb4094f8196d.600x338.jpg?t=1768313956"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3947990/48e5c26f3fb8f91d869b93879f1dfb00fc28d739/ss_48e5c26f3fb8f91d869b93879f1dfb00fc28d739.1920x1080.jpg?t=1768313956","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3947990/48e5c26f3fb8f91d869b93879f1dfb00fc28d739/ss_48e5c26f3fb8f91d869b93879f1dfb00fc28d739.600x338.jpg?t=1768313956"}],"short_description":"Demo updated for the Detective Fest! Step into detective Brian Storm\u2019s shoes and unravel a grim 17th-century mystery. Interrogate villagers, gather clues, and piece together the evidence in a deduction system where every secret matters.","steam_appid":3947990,"support_info":{"email":"thekgamestudio@gmail.com","url":""},"supported_languages":"English, Hungarian","type":"game","website":null}