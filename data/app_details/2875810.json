ters!","steam_appid":2875810,"support_info":{"email":"gideon@doublecrowgames.com","url":""},"supported_languages":"English<strong>*</strong>, German<strong>*</strong>, Spanish - Spain<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Japanese<strong>*</strong>, Russian<strong>*</strong>, Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}