3dc1a97aa83fbf2a4d0e7a3949aaca12f2cc1.600x338.jpg?t=1755956365"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3682340/1e941cbb7ada0b159a9b9d0d706bef5b102b2a1d/ss_1e941cbb7ada0b159a9b9d0d706bef5b102b2a1d.1920x1080.jpg?t=1755956365","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3682340/1e941cbb7ada0b159a9b9d0d706bef5b102b2a1d/ss_1e941cbb7ada0b159a9b9d0d706bef5b102b2a1d.600x338.jpg?t=1755956365"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3682340/08ecfbc79e1ce81fbb2074368160ee8a2867a40c/ss_08ecfbc79e1ce81fbb2074368160ee8a2867a40c.1920x1080.jpg?t=1755956365","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3682340/08ecfbc79e1ce81fbb2074368160ee8a2867a40c/ss_08ecfbc79e1ce81fbb2074368160ee8a2867a40c.600x338.jpg?t=1755956365"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3682340/45350acc105e7f7cc50e6108134a0a82dfece81f/ss_45350acc105e7f7cc50e6108134a0a82dfece81f.1920x1080.jpg?t=1755956365","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3682340/45350acc105e7f7cc50e6108134a0a82dfece81f/ss_45350acc105e7f7cc50e6108134a0a82dfece81f.600x338.jpg?t=1755956365"}],"short_description":"Here Comes the Swarm demo drops you into the infested world of Ulora. In this RTS with a pause button, you\u2019ll build and defend your first settlement, master tactical combat, and deliver your blow to the hivemind. Will you make your mark against the relentless Swarm?","steam_appid":3682340,"support_info":{"email":"support@cablehookgames.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"demo","website":"https://herecomestheswarm.com"}