3976950/694d6e7343ccd769e212b211fbdaade1bf0dfd42/ss_694d6e7343ccd769e212b211fbdaade1bf0dfd42.600x338.jpg?t=1763502033"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976950/7eb2105cb86dac382ce8c5f273a65ba3b03ae703/ss_7eb2105cb86dac382ce8c5f273a65ba3b03ae703.1920x1080.jpg?t=1763502033","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976950/7eb2105cb86dac382ce8c5f273a65ba3b03ae703/ss_7eb2105cb86dac382ce8c5f273a65ba3b03ae703.600x338.jpg?t=1763502033"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976950/251178f6f44567011f9f11bcf1fcb2a22f59c677/ss_251178f6f44567011f9f11bcf1fcb2a22f59c677.1920x1080.jpg?t=1763502033","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976950/251178f6f44567011f9f11bcf1fcb2a22f59c677/ss_251178f6f44567011f9f11bcf1fcb2a22f59c677.600x338.jpg?t=1763502033"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976950/06d6a94e92ec78b308983f8d35acc9317b7851d0/ss_06d6a94e92ec78b308983f8d35acc9317b7851d0.1920x1080.jpg?t=1763502033","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976950/06d6a94e92ec78b308983f8d35acc9317b7851d0/ss_06d6a94e92ec78b308983f8d35acc9317b7851d0.600x338.jpg?t=1763502033"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976950/538b4db7607e9d1c7a15c7d7bfcb1b9c2fdf0c6e/ss_538b4db7607e9d1c7a15c7d7bfcb1b9c2fdf0c6e.1920x1080.jpg?t=1763502033","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976950/538b4db7607e9d1c7a15c7d7bfcb1b9c2fdf0c6e/ss_538b4db7607e9d1c7a15c7d7bfcb1b9c2fdf0c6e.600x338.jpg?t=1763502033"}],"short_description":"12 Levels. One Life. No Saves. Ember Island is a punishing, retro-style arcade platformer where you must beat the entire game in a single run. Choose your mercenary: Knight, Mage, or Rogue, and fight through 12 deadly zones to claim the ultimate bounty.","steam_appid":3976950,"support_info":{"email":"","url":"https://www.calibuscreations.com/ember_island/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}