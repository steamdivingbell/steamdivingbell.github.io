605cffd46316f2805e97cd731cd4754e.600x338.jpg?t=1773095458"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3661830/6e34f0c23fa1493005e8655479bb7d9ef80fff91/ss_6e34f0c23fa1493005e8655479bb7d9ef80fff91.1920x1080.jpg?t=1773095458","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3661830/6e34f0c23fa1493005e8655479bb7d9ef80fff91/ss_6e34f0c23fa1493005e8655479bb7d9ef80fff91.600x338.jpg?t=1773095458"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3661830/e3b05517a209c9432a243e3faa1ff2e01c7279b8/ss_e3b05517a209c9432a243e3faa1ff2e01c7279b8.1920x1080.jpg?t=1773095458","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3661830/e3b05517a209c9432a243e3faa1ff2e01c7279b8/ss_e3b05517a209c9432a243e3faa1ff2e01c7279b8.600x338.jpg?t=1773095458"}],"short_description":"Tape Us Out is an asymmetric, online co-op puzzle game. Players are sucked into a VHS tape and must face challenges of logic, coordination, and communication within the universe of old movies to find their way back to reality.","steam_appid":3661830,"support_info":{"email":"digitalgraveyardstudios@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}