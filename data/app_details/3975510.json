umbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3975510/07849184669e46b78df67f8d04f65fc4bbab3a2e/ss_07849184669e46b78df67f8d04f65fc4bbab3a2e.600x338.jpg?t=1766033879"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3975510/1dfc4104e64471d062ce7118f99f31de57fa6c17/ss_1dfc4104e64471d062ce7118f99f31de57fa6c17.1920x1080.jpg?t=1766033879","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3975510/1dfc4104e64471d062ce7118f99f31de57fa6c17/ss_1dfc4104e64471d062ce7118f99f31de57fa6c17.600x338.jpg?t=1766033879"}],"short_description":"Cyan Brain is a decadent sci-fi side-scrolling action shooter. Awaken to face endless slaughter and desperate encounters. &quot;Are you ready to make the ultimate devotion?&quot;","steam_appid":3975510,"support_info":{"email":"support@mangopartygames.com","url":""},"supported_languages":"Japanese<strong>*</strong>, English, Simplified Chinese, Traditional Chinese, Korean<br><strong>*</strong>languages with full audio support","type":"game","website":null}