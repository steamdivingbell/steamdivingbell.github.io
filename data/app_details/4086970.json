steam/apps/4086970/9d10862753ad6cc40db0721ed3ff76d144322e60/ss_9d10862753ad6cc40db0721ed3ff76d144322e60.1920x1080.jpg?t=1764515034","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/9d10862753ad6cc40db0721ed3ff76d144322e60/ss_9d10862753ad6cc40db0721ed3ff76d144322e60.600x338.jpg?t=1764515034"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/05cd251ed3c3586ee964d0d1d51459c068bf43fe/ss_05cd251ed3c3586ee964d0d1d51459c068bf43fe.1920x1080.jpg?t=1764515034","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/05cd251ed3c3586ee964d0d1d51459c068bf43fe/ss_05cd251ed3c3586ee964d0d1d51459c068bf43fe.600x338.jpg?t=1764515034"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/c5eebcd7127df22b57579de40868cbcea77f443c/ss_c5eebcd7127df22b57579de40868cbcea77f443c.1920x1080.jpg?t=1764515034","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/c5eebcd7127df22b57579de40868cbcea77f443c/ss_c5eebcd7127df22b57579de40868cbcea77f443c.600x338.jpg?t=1764515034"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/53331c00d63d95f742d692bcd868ff0c4a0a4237/ss_53331c00d63d95f742d692bcd868ff0c4a0a4237.1920x1080.jpg?t=1764515034","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/53331c00d63d95f742d692bcd868ff0c4a0a4237/ss_53331c00d63d95f742d692bcd868ff0c4a0a4237.600x338.jpg?t=1764515034"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/deff16da2e444f4204b64c234f2fae1c7a2060e5/ss_deff16da2e444f4204b64c234f2fae1c7a2060e5.1920x1080.jpg?t=1764515034","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086970/deff16da2e444f4204b64c234f2fae1c7a2060e5/ss_deff16da2e444f4204b64c234f2fae1c7a2060e5.600x338.jpg?t=1764515034"}],"short_description":"In the dungeons of a fallen empire, the last elven assassin \u201cLuna\u201d dons her disguise to seek vengeance. A dark fantasy Roguelike action RPG blending battles, party customization, and corruption systems. Forge your character, command your allies, and survive the infernal depths of blood and desire.","steam_appid":4086970,"support_info":{"email":"hakuryu999hdbl@gmail.com","url":""},"supported_languages":"English, Japanese<strong>*</strong>, Simplified Chinese, Traditional Chinese, Korean<br><strong>*</strong>languages with full audio support","type":"game","website":null}