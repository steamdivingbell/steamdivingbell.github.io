.steamstatic.com/store_item_assets/steam/apps/3312130/581db04a6b619f396535a56919ac88c84799a9b5/ss_581db04a6b619f396535a56919ac88c84799a9b5.1920x1080.jpg?t=1770389358","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3312130/581db04a6b619f396535a56919ac88c84799a9b5/ss_581db04a6b619f396535a56919ac88c84799a9b5.600x338.jpg?t=1770389358"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3312130/0eb5fe993a32e709f415beae87da16bf55c5f323/ss_0eb5fe993a32e709f415beae87da16bf55c5f323.1920x1080.jpg?t=1770389358","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3312130/0eb5fe993a32e709f415beae87da16bf55c5f323/ss_0eb5fe993a32e709f415beae87da16bf55c5f323.600x338.jpg?t=1770389358"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3312130/a0f622e3698c5a8accd487bde2821093205dea49/ss_a0f622e3698c5a8accd487bde2821093205dea49.1920x1080.jpg?t=1770389358","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3312130/a0f622e3698c5a8accd487bde2821093205dea49/ss_a0f622e3698c5a8accd487bde2821093205dea49.600x338.jpg?t=1770389358"}],"short_description":"Build and automate a tropical island village at the base of a sentient volcano. Use conveyor belts, boats, trains, catapults and ziplines to produce and deliver everything your town needs!","steam_appid":3312130,"support_info":{"email":"support@82apps.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Russian, Simplified Chinese, Traditional Chinese, Ukrainian<br><strong>*</strong>languages with full audio support","type":"game","website":null}