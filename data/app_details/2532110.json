a39e08097aaff671bb21c88dd99c88c/ss_9a3195d25a39e08097aaff671bb21c88dd99c88c.600x338.jpg?t=1772567787"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2532110/600ff92671796337e31c6db897e5b79ca6d4f615/ss_600ff92671796337e31c6db897e5b79ca6d4f615.1920x1080.jpg?t=1772567787","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2532110/600ff92671796337e31c6db897e5b79ca6d4f615/ss_600ff92671796337e31c6db897e5b79ca6d4f615.600x338.jpg?t=1772567787"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2532110/a0f2994c00c811f3adac527853c862f5a83931d5/ss_a0f2994c00c811f3adac527853c862f5a83931d5.1920x1080.jpg?t=1772567787","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2532110/a0f2994c00c811f3adac527853c862f5a83931d5/ss_a0f2994c00c811f3adac527853c862f5a83931d5.600x338.jpg?t=1772567787"}],"short_description":"A multiplayer sport where the goal adapts to stop you. No aim assist. No randomness. Just ball physics, hero abilities, and a target that gets harder to break the closer you get to winning.","steam_appid":2532110,"support_info":{"email":"support@cabbageballgame.com","url":"https://www.cabbageballgame.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.cabbageballgame.com/"}