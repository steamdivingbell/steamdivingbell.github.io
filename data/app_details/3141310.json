338.jpg?t=1765467053"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3141310/f2d7328dc32e3832c137af4dda908d55c169cf7b/ss_f2d7328dc32e3832c137af4dda908d55c169cf7b.1920x1080.jpg?t=1765467053","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3141310/f2d7328dc32e3832c137af4dda908d55c169cf7b/ss_f2d7328dc32e3832c137af4dda908d55c169cf7b.600x338.jpg?t=1765467053"}],"short_description":"Inkshade is a turn-based tactics game carved out of strange wooden miniatures, wrapped in a web of locked rooms, and orchestrated by an otherworldly game master. Victory is not guaranteed, and the only constant is the cruel black ink that flows within the pieces.","steam_appid":3141310,"support_info":{"email":"","url":"https://studiovezelle.com/#contact"},"supported_languages":"English","type":"game","website":null}