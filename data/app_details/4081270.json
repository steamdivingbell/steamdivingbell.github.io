IDIA GTX 1050 / AMD RX 560 (2 GB VRAM)<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Additional Notes:</strong> Designed for 720p\u20131080p gameplay. Volumetric effects may reduce performance on older GPUs.</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11 64-bit<br></li><li><strong>Processor:</strong> AMD Ryzen 5 5600X / Intel Core i5-12400<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> AMD RX 6600 / NVIDIA RTX 3060 (6\u20138 GB VRAM)<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Additional Notes:</strong> Runs smoothly at 1080p\u20131440p with all visual features enabled.</li></ul>"},"platforms":{"linux":true,"mac":false,"windows":true},"publishers":["Bobi's Heart Studio"],"ratings":{"dejus":{"banned":"0","descriptors":"Medo","rating":"10","rating_generated":"1","required_age":"10","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"\u00c4ngstigende Inhalte","rating":"6","rating_generated":"1","required_age":"6","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Coming soon"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4081270/13bcc66b27a5d5eda67cf7b9afdd776fa89768bd/ss_13bcc66b27a5d5eda67cf7b9afdd776fa89768bd.1920x1080.jpg?t=1770314413","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4081270/13bcc66b27a5d5eda67cf7b9afdd776fa89768bd/ss_13bcc66b27a5d5eda67cf7b9afdd776fa89768bd.600x338.jpg?t=1770314413"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4081270/bde969fd426818183663de454ad873e2ee4b8f1b/ss_bde969fd426818183663de454ad873e2ee4b8f1b.1920x1080.jpg?t=1770314413","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4081270/bde969fd426818183663de454ad873e2ee4b8f1b/ss_bde969fd426818183663de454ad873e2ee4