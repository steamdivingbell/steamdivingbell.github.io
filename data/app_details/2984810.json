ai.steamstatic.com/store_item_assets/steam/apps/2984810/extras/fbfc7e1f6316935dacd60347a8bf392b.avif?t=1768703698\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras_big/fbfc7e1f6316935dacd60347a8bf392b.avif?t=1768703698 width=800 height=62 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras/9078c11363c1ade00df77894f24eef2e.poster.avif?t=1768703698\" width=800 height=800 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras/9078c11363c1ade00df77894f24eef2e.webm?t=1768703698\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras/9078c11363c1ade00df77894f24eef2e.mp4?t=1768703698\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Launch yourself into battle, fighting endless hordes of unique enemies, adapt and overcome the challenge.\u00a0</p><h2 class=\"bb_tag\" >Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Fight Countless Waves of Enemies: Face off against swarms of alien adversaries with unique behaviors and attack patterns, creating an ever-intensifying bullet hell experience. </p></li><li><p class=\"bb_paragraph\" >Equip and Upgrade: Manage multiple weapons simultaneously, each with its own upgrade path. Collect and utilize a variety of power-ups to enhance your combat effectiveness.</p></li><li><p class=\"bb_paragraph\" >Gather Resources: Accumulate gold and alien artifacts during each run to purchase permanent upgrades and unlock new abilities, bettering chances of survival in subsequent attempts. </p></li><li><p class=\"bb_paragraph\" >Roguelite Elements: Each death is not the end but a stepping stone. Use the collected resources to upgrade your skills, unlocking new weapons and abilities to aid in future runs.</p></li></ul>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/2984810?t=1768703698","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/page_bg_raw.jpg?t=1768703698","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/69e2fd524a6afddc30883594949fc4c27970540f/capsule_231x87.jpg?t=1768703698","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/69e2fd524a6afddc30883594949fc4c27970540f/capsule_184x69.jpg?t=1768703698","categories":[{"description":"Single-player","id":2},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"detailed_description":"<p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras/9933f3c698913ea20a5fef7a9165a694.avif?t=1768703698\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras_big/9933f3c698913ea20a5fef7a9165a694.avif?t=1768703698 width=800 height=61 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras/8bc0c9d00d2551a08940aac8d4b8cd4a.poster.avif?t=1768703698\" width=706 height=706 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras/8bc0c9d00d2551a08940aac8d4b8cd4a.webm?t=1768703698\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2984810/extras/f8fd5e04f6743937311ec6005a272a4c.avif?t=1768703698\" data-big-src=https://shared.akamai.steamstatic.com/store_item_asset