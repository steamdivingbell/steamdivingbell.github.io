/shared.akamai.steamstatic.com/store_item_assets/steam/apps/2665020/b634e276f859159c351bc13c9705d29e6349a844/ss_b634e276f859159c351bc13c9705d29e6349a844.600x338.jpg?t=1762010226"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2665020/b9f076e01cb9e8bac8085036f24cc49c81922770/ss_b9f076e01cb9e8bac8085036f24cc49c81922770.1920x1080.jpg?t=1762010226","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2665020/b9f076e01cb9e8bac8085036f24cc49c81922770/ss_b9f076e01cb9e8bac8085036f24cc49c81922770.600x338.jpg?t=1762010226"}],"short_description":"Survive together in this Horde-Shooter set in a World War-era hell controlled by Milo, the leader of an absurd nightmare cult that worships a mysterious beverage.","steam_appid":2665020,"support_info":{"email":"spencersharpartist@gmail.com","url":"https://milo10.godaddysites.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://milothegame.com/"}