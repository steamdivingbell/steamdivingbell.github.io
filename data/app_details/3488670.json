/ed20aff0b69e18997480d5de428476b8752f71c5/ss_ed20aff0b69e18997480d5de428476b8752f71c5.600x338.jpg?t=1757308532"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488670/34c695e25fcabe6047d9e0e0599f7ce1138e858f/ss_34c695e25fcabe6047d9e0e0599f7ce1138e858f.1920x1080.jpg?t=1757308532","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488670/34c695e25fcabe6047d9e0e0599f7ce1138e858f/ss_34c695e25fcabe6047d9e0e0599f7ce1138e858f.600x338.jpg?t=1757308532"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488670/18326785141ddfd9a113bcec68696e20b0385baa/ss_18326785141ddfd9a113bcec68696e20b0385baa.1920x1080.jpg?t=1757308532","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488670/18326785141ddfd9a113bcec68696e20b0385baa/ss_18326785141ddfd9a113bcec68696e20b0385baa.600x338.jpg?t=1757308532"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488670/26d4d4611b5be8bcbe1ede495ad321bfc29e1107/ss_26d4d4611b5be8bcbe1ede495ad321bfc29e1107.1920x1080.jpg?t=1757308532","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488670/26d4d4611b5be8bcbe1ede495ad321bfc29e1107/ss_26d4d4611b5be8bcbe1ede495ad321bfc29e1107.600x338.jpg?t=1757308532"}],"short_description":"Join the outcasts of Villainville in this cozy farming sim adventure where Stardew Valley meets Shrek. Grow magic crops, tame the tiny unicorns, sneak into the night market, and befriend misfit fairy tale characters. Bonus? Find the misery mushroom plague saboteur and redeem the irredeemable.","steam_appid":3488670,"support_info":{"email":"","url":"https://flamingacorngames.com/"},"supported_languages":"English","type":"game","website":"https://flamingacorngames.com/"}