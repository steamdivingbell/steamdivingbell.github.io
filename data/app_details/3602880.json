om/store_item_assets/steam/apps/3602880/3b9a852e5b26124d80e9134b062a06670270b11e/ss_3b9a852e5b26124d80e9134b062a06670270b11e.1920x1080.jpg?t=1747412264","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3602880/3b9a852e5b26124d80e9134b062a06670270b11e/ss_3b9a852e5b26124d80e9134b062a06670270b11e.600x338.jpg?t=1747412264"}],"short_description":"Trapped underground after a collapse, you are the sole survivor of a deadly attack. Armed only with a night vision camera, navigate the darkness, avoid the creature, and find a way out in this retro-style survival horror game.","steam_appid":3602880,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}