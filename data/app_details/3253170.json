pps/3253170/1eed9c1b9dc1c98cd0ada9abba79a282c86ed2f3/ss_1eed9c1b9dc1c98cd0ada9abba79a282c86ed2f3.600x338.jpg?t=1759907614"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3253170/72bb95a4f19bf4af42f1a62218ef44b00d18e5e5/ss_72bb95a4f19bf4af42f1a62218ef44b00d18e5e5.1920x1080.jpg?t=1759907614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3253170/72bb95a4f19bf4af42f1a62218ef44b00d18e5e5/ss_72bb95a4f19bf4af42f1a62218ef44b00d18e5e5.600x338.jpg?t=1759907614"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3253170/678379de2590edd631ef8835c4af968f78fb107d/ss_678379de2590edd631ef8835c4af968f78fb107d.1920x1080.jpg?t=1759907614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3253170/678379de2590edd631ef8835c4af968f78fb107d/ss_678379de2590edd631ef8835c4af968f78fb107d.600x338.jpg?t=1759907614"}],"short_description":"You find yourself trapped in a cabin, where every night your abductor appears. One night, you manage to break free and take a cellphone with you. However, what you thought was your phone is, in fact, your kidnapper's phone...","steam_appid":3253170,"support_info":{"email":"","url":"justohdias@gmail.com"},"supported_languages":"English, Portuguese - Brazil","type":"game","website":null}