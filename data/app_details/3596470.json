a1e0653ca60988b0ce8f8998a174.webm?t=1756897699\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3596470/extras/3a21a1e0653ca60988b0ce8f8998a174.mp4?t=1756897699\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >\u2694\ufe0f MASTER YOUR ARSENAL</h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Equip demonic weapons, cast devastating elemental spells, harness runes with wild powers, and deploy powerful defenses across the battlefield.</p><p class=\"bb_paragraph\" >From deadly traps to arcane towers, you'll need every tool at your disposal... and even then, it might not be enough.</p><p class=\"bb_paragraph\" >When night falls, something worse than monsters may be waiting.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>Tick-tock. Tick-tock...</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3596470/extras/599a68105d39b98533cbd523b0f75815.poster.avif?t=1756897699\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3596470/extras/599a68105d39b98533cbd523b0f75815.webm?t=1756897699\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3596470/extras/599a68105d39b98533cbd523b0f75815.mp4?t=1756897699\" type=\"video/mp4\"></video></span><i> </i><br><i> </i></p><p class=\"bb_paragraph\" ></p>","developers":["Helvetica Gaming GmbH","Zero Games Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3596470/6608d6025693088997c5d33424765b7a4645e13b/header.jpg?t=1756897699","is_free":false,"legal_notice":"\u00a9 2025 Helvetica Gaming GmbH. All righ