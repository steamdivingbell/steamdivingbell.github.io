3539330/71d3ef8d58a1fbc31f1be01cf868fa860c5455ca/ss_71d3ef8d58a1fbc31f1be01cf868fa860c5455ca.1920x1080.jpg?t=1742666277","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/71d3ef8d58a1fbc31f1be01cf868fa860c5455ca/ss_71d3ef8d58a1fbc31f1be01cf868fa860c5455ca.600x338.jpg?t=1742666277"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/d054650467698ab78b6e03a967f022d5349e7e24/ss_d054650467698ab78b6e03a967f022d5349e7e24.1920x1080.jpg?t=1742666277","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/d054650467698ab78b6e03a967f022d5349e7e24/ss_d054650467698ab78b6e03a967f022d5349e7e24.600x338.jpg?t=1742666277"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/4c7233d9b2850708304145f044a3feed09693b12/ss_4c7233d9b2850708304145f044a3feed09693b12.1920x1080.jpg?t=1742666277","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/4c7233d9b2850708304145f044a3feed09693b12/ss_4c7233d9b2850708304145f044a3feed09693b12.600x338.jpg?t=1742666277"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/522a4fd95f0d8e5b8e4582c76c1b52304f1498c8/ss_522a4fd95f0d8e5b8e4582c76c1b52304f1498c8.1920x1080.jpg?t=1742666277","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/522a4fd95f0d8e5b8e4582c76c1b52304f1498c8/ss_522a4fd95f0d8e5b8e4582c76c1b52304f1498c8.600x338.jpg?t=1742666277"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/a7e8674478a86f7927b094373cf7b8af22de1e40/ss_a7e8674478a86f7927b094373cf7b8af22de1e40.1920x1080.jpg?t=1742666277","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3539330/a7e8674478a86f7927b094373cf7b8af22de1e40/ss_a7e8674478a86f7927b094373cf7b8af22de1e40.600x338.jpg?t=1742666277"}],"short_descriptio