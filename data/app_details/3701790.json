</p><p class=\"bb_paragraph\">- Settings and game data are automatically saved.</p><p class=\"bb_paragraph\">- Portrait orientation modes not using screen rotation feature.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3701790/extras/video-1.gif?t=1746544176\" /></p>","developers":["Sci-Tech Binary"],"fullgame":{"appid":"3380320","name":"Non-Euclidean Minesweeper"},"genres":[{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3701790/04c5514074e3bad71f7a57a17bbbfc0352cad869/header.jpg?t=1746544176","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257133451,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257133451/movie480.mp4?t=1746026737","max":"http://video.akamai.steamstatic.com/store_trailers/257133451/movie_max.mp4?t=1746026737"},"name":"Non-Euclidean Minesweeper Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257133451/1ca62a29e9f74d2afce15ff87d2939b9afa02b27/movie_600x337.jpg?t=1746026737","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257133451/movie480_vp9.webm?t=1746026737","max":"http://video.akamai.steamstatic.com/store_trailers/257133451/movie_max_vp9.webm?t=1746026737"}}],"name":"Non-Euclidean Minesweeper Soundtrack","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Storage:</strong> 2 MB available space</li></ul>"},"platforms":{"linux":true,"mac":true,"windows":true},"publishers":["Sci-Tech Binary"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"May 2025"},"required_age":0,"screensho