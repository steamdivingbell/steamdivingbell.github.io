store_item_assets/steam/apps/4092390/a929637bcb635c27540da9f943cb74083292f7c4/ss_a929637bcb635c27540da9f943cb74083292f7c4.600x338.jpg?t=1760460466"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4092390/fdb401c3b4ac2a4af3c192b328cbb2b382f9f2ee/ss_fdb401c3b4ac2a4af3c192b328cbb2b382f9f2ee.1920x1080.jpg?t=1760460466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4092390/fdb401c3b4ac2a4af3c192b328cbb2b382f9f2ee/ss_fdb401c3b4ac2a4af3c192b328cbb2b382f9f2ee.600x338.jpg?t=1760460466"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4092390/24c4508ede62244d8ea1a53ebf0a721445b9d68a/ss_24c4508ede62244d8ea1a53ebf0a721445b9d68a.1920x1080.jpg?t=1760460466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4092390/24c4508ede62244d8ea1a53ebf0a721445b9d68a/ss_24c4508ede62244d8ea1a53ebf0a721445b9d68a.600x338.jpg?t=1760460466"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4092390/5bd35a0662e08f789d81a051db16ad0dc4302aa9/ss_5bd35a0662e08f789d81a051db16ad0dc4302aa9.1920x1080.jpg?t=1760460466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4092390/5bd35a0662e08f789d81a051db16ad0dc4302aa9/ss_5bd35a0662e08f789d81a051db16ad0dc4302aa9.600x338.jpg?t=1760460466"}],"short_description":"Fight through endless hordes in trials bestowed by constellation patrons. Upgrade skills, collect relics, and craft broken builds in true roguelite fashion! Rediscover the fantasy behind the words hack and slash and bullet heaven. Will you survive the densest monster Survivor-like ever created?","steam_appid":4092390,"support_info":{"email":"support@angrywisp.com","url":"https://angrywisp.com/en/"},"supported_languages":"English, Italian, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Spanish - Latin America, Tra