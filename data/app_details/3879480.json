/steam/apps/3879480/9f4b26423535f69e1f8f9ef7190f0eff03f2e944/ss_9f4b26423535f69e1f8f9ef7190f0eff03f2e944.600x338.jpg?t=1756139710"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879480/6f3f41ae74e756140c9f596f39b3be6cda3b8551/ss_6f3f41ae74e756140c9f596f39b3be6cda3b8551.1920x1080.jpg?t=1756139710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879480/6f3f41ae74e756140c9f596f39b3be6cda3b8551/ss_6f3f41ae74e756140c9f596f39b3be6cda3b8551.600x338.jpg?t=1756139710"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879480/3374dcab2af87f0b6e68b575d81ea9e6ac8ee2ef/ss_3374dcab2af87f0b6e68b575d81ea9e6ac8ee2ef.1920x1080.jpg?t=1756139710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879480/3374dcab2af87f0b6e68b575d81ea9e6ac8ee2ef/ss_3374dcab2af87f0b6e68b575d81ea9e6ac8ee2ef.600x338.jpg?t=1756139710"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879480/fe160e01f8f0877359e6443e1e60e9969ce0695f/ss_fe160e01f8f0877359e6443e1e60e9969ce0695f.1920x1080.jpg?t=1756139710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879480/fe160e01f8f0877359e6443e1e60e9969ce0695f/ss_fe160e01f8f0877359e6443e1e60e9969ce0695f.600x338.jpg?t=1756139710"}],"short_description":"Balloon is a 3rd-person interactive poem where you play as a lost red balloon\u2014fragile and uncontrollable, yet endlessly desirable.","steam_appid":3879480,"support_info":{"email":"shepherdsagame@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}