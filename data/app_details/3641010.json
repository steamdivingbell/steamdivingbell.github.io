i.steamstatic.com/store_item_assets/steam/apps/3641010/1fcbbb6c0a9507e0a329dc398f9d18af3816466f/ss_1fcbbb6c0a9507e0a329dc398f9d18af3816466f.1920x1080.jpg?t=1772751334","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3641010/1fcbbb6c0a9507e0a329dc398f9d18af3816466f/ss_1fcbbb6c0a9507e0a329dc398f9d18af3816466f.600x338.jpg?t=1772751334"}],"short_description":"A precise momentum-based platformer that emphasizes exploration and navigation puzzles. Run and jump your way through a wide variety of obstacles and challenges as you explore an abandoned derelict freighter. Be careful: getting in is often easier than getting out!","steam_appid":3641010,"support_info":{"email":"luminous.tree.help@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}