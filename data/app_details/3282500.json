08f6/ss_9a727d40508a8227dd9df7fb7ef216a4ae7408f6.1920x1080.jpg?t=1771125625","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3282500/9a727d40508a8227dd9df7fb7ef216a4ae7408f6/ss_9a727d40508a8227dd9df7fb7ef216a4ae7408f6.600x338.jpg?t=1771125625"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3282500/426ce9a5ce67c509f9e7369ca5403392e03fc878/ss_426ce9a5ce67c509f9e7369ca5403392e03fc878.1920x1080.jpg?t=1771125625","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3282500/426ce9a5ce67c509f9e7369ca5403392e03fc878/ss_426ce9a5ce67c509f9e7369ca5403392e03fc878.600x338.jpg?t=1771125625"}],"short_description":"\u300aSweets' Devil\u300bis a Top-View action adventure game that emphasizes one shot kill and roaming. Engage in level battles and boss challenges in a humorous and entertaining fairy tale style , \u200cfight against various sweets legions that treat human as the devil in their legend .","steam_appid":3282500,"support_info":{"email":"nomyui@163.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese","type":"game","website":null}