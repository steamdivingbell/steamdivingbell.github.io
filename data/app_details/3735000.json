am/apps/3735000/88fcbd0c0842a9e80583b6a5e0fdd9a61e78919d/ss_88fcbd0c0842a9e80583b6a5e0fdd9a61e78919d.600x338.jpg?t=1749654483"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735000/0eeffd4ea48f4d803c55a2c33777a9864787c141/ss_0eeffd4ea48f4d803c55a2c33777a9864787c141.1920x1080.jpg?t=1749654483","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735000/0eeffd4ea48f4d803c55a2c33777a9864787c141/ss_0eeffd4ea48f4d803c55a2c33777a9864787c141.600x338.jpg?t=1749654483"}],"short_description":"Begin your adventure in the airship survival game Echoes of Elysium with this free demo. Explore the skies, gather resources, and begin customizing your airship in a procedural world where clockwork wonders and ancient mysteries await.","steam_appid":3735000,"support_info":{"email":"support@loricgames.com","url":"https://www.loricgames.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":"https://www.echoes.games"}