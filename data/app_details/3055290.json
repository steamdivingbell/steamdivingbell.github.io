d623e3.1920x1080.jpg?t=1772564257","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3055290/cb36171e484ffadd4a15aa548094b2c35bd623e3/ss_cb36171e484ffadd4a15aa548094b2c35bd623e3.600x338.jpg?t=1772564257"}],"short_description":"Sunny Trails is a cozy turn-based RPG. Amaterasu and her sisters travel to a party on a paradisiacal Brazilian island, only to find all the guests turned to stone. Fish, decorate your camp, and explore the island to discover who petrified your friends!","steam_appid":3055290,"support_info":{"email":"contact@sunnytrails.net","url":""},"supported_languages":"English<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Spanish - Latin America<br><strong>*</strong>languages with full audio support","type":"game","website":"https://sunnytrails.net"}