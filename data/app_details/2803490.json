90/9a02538b69d57cd1c6e9cc1f95729622c7622876/ss_9a02538b69d57cd1c6e9cc1f95729622c7622876.1920x1080.jpg?t=1771890032","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2803490/9a02538b69d57cd1c6e9cc1f95729622c7622876/ss_9a02538b69d57cd1c6e9cc1f95729622c7622876.600x338.jpg?t=1771890032"}],"short_description":"Adventure in a world where every pixel is physically and chemically simulated! In this ever-evolving sandbox, creativity meets chaos, and the only limit is your imagination!","steam_appid":2803490,"support_info":{"email":"henry@triplejumpgames.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Spanish - Latin America, Turkish","type":"game","website":null}