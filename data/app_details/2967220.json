am/apps/2967220/9a426827881d5f874519973247227b5c42c39aab/ss_9a426827881d5f874519973247227b5c42c39aab.600x338.jpg?t=1772638998"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/857ba0119d1864d943c6a96dd3cd84f4ee77ed30/ss_857ba0119d1864d943c6a96dd3cd84f4ee77ed30.1920x1080.jpg?t=1772638998","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/857ba0119d1864d943c6a96dd3cd84f4ee77ed30/ss_857ba0119d1864d943c6a96dd3cd84f4ee77ed30.600x338.jpg?t=1772638998"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/abf18284e4b4c1d722ce3ea42d373445c66758ae/ss_abf18284e4b4c1d722ce3ea42d373445c66758ae.1920x1080.jpg?t=1772638998","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/abf18284e4b4c1d722ce3ea42d373445c66758ae/ss_abf18284e4b4c1d722ce3ea42d373445c66758ae.600x338.jpg?t=1772638998"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/dc9533d4cd0d5d86bdef2b293ea9e190fa38987c/ss_dc9533d4cd0d5d86bdef2b293ea9e190fa38987c.1920x1080.jpg?t=1772638998","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/dc9533d4cd0d5d86bdef2b293ea9e190fa38987c/ss_dc9533d4cd0d5d86bdef2b293ea9e190fa38987c.600x338.jpg?t=1772638998"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/cda8a2a50ec5e207082b11f080353d798a50b0fa/ss_cda8a2a50ec5e207082b11f080353d798a50b0fa.1920x1080.jpg?t=1772638998","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/cda8a2a50ec5e207082b11f080353d798a50b0fa/ss_cda8a2a50ec5e207082b11f080353d798a50b0fa.600x338.jpg?t=1772638998"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2967220/56aae152f2e511e01b07b428f02fb7c1c6dfc63f/ss_56aae152f2e511e01b07b428f02fb7c1c6dfc63f.1920x1080.jpg?t=1772638998","path_t