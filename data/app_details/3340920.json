tic.com/store_item_assets/steam/apps/3340920/67dc52b3cc07583a75e404b1839a762f88a27032/ss_67dc52b3cc07583a75e404b1839a762f88a27032.600x338.jpg?t=1763361249"}],"short_description":"Experience relentless bullet hell shmup gameplay in a dark hand-drawn style. Salvage powerful relics from fallen rivals to push through the ever-rising pressure and escape Madlum's Vault.","steam_appid":3340920,"support_info":{"email":"blindvoid0@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}