tatic.com/store_item_assets/steam/apps/2154240/0bbe886cacc538cabff008447cf05fa703145c5a/ss_0bbe886cacc538cabff008447cf05fa703145c5a.1920x1080.jpg?t=1741992495","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2154240/0bbe886cacc538cabff008447cf05fa703145c5a/ss_0bbe886cacc538cabff008447cf05fa703145c5a.600x338.jpg?t=1741992495"}],"short_description":"Ragnarok was just the beginning\u2026 of the end! Odinfall is a Viking-themed, rogue-lite, twin-stick shooter. Blast your way through procedurally generated levels, upgrade your character, modify your weapons and take down robotic Norse gods to earn your freedom!","steam_appid":2154240,"support_info":{"email":"","url":"https://fireshinegames.co.uk/customer-support/"},"supported_languages":"English, German, Spanish - Spain, Simplified Chinese","type":"game","website":null}