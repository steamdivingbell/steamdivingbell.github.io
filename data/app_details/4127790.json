hared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/27bdc97b32b22576f967c173c8703e751cc12f91/ss_27bdc97b32b22576f967c173c8703e751cc12f91.600x338.jpg?t=1761912341"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/c15a0f2f2dc8c07edfbc1d2a2efa061af87d9b83/ss_c15a0f2f2dc8c07edfbc1d2a2efa061af87d9b83.1920x1080.jpg?t=1761912341","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/c15a0f2f2dc8c07edfbc1d2a2efa061af87d9b83/ss_c15a0f2f2dc8c07edfbc1d2a2efa061af87d9b83.600x338.jpg?t=1761912341"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/afc2b861b95377fa3707b98222d16e72ca7247ab/ss_afc2b861b95377fa3707b98222d16e72ca7247ab.1920x1080.jpg?t=1761912341","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/afc2b861b95377fa3707b98222d16e72ca7247ab/ss_afc2b861b95377fa3707b98222d16e72ca7247ab.600x338.jpg?t=1761912341"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/0e756228882db7a980f161ba9db592c5aef08eb4/ss_0e756228882db7a980f161ba9db592c5aef08eb4.1920x1080.jpg?t=1761912341","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/0e756228882db7a980f161ba9db592c5aef08eb4/ss_0e756228882db7a980f161ba9db592c5aef08eb4.600x338.jpg?t=1761912341"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/28c100678ad8b405cbb0dc603f305f79c7026c98/ss_28c100678ad8b405cbb0dc603f305f79c7026c98.1920x1080.jpg?t=1761912341","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/28c100678ad8b405cbb0dc603f305f79c7026c98/ss_28c100678ad8b405cbb0dc603f305f79c7026c98.600x338.jpg?t=1761912341"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/73153d8de041d29d3637a02a95bb09ab5794dfcd/ss_73153d8de041d29d3637a02a95bb09ab5794dfcd.1920x1080.jpg?t=1761912341","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/73153d8de041d29d3637a02a95bb09ab5794dfcd/ss_73153d8de041d29d3637a02a95bb09ab5794dfcd.600x338.jpg?t=1761912341"}],"short_description":"Survive as a young, lost vampire in 1950s Kowloon and navigate its dark depths, but beware; you're not the only thing that lurks within them. Grow as a vampire, using skills and vampiric abilities to overcome challenges, gain allies and manage your overwhelming thirst.","steam_appid":4127790,"support_info":{"email":"manekimushidev@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}