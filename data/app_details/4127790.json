4127790/73153d8de041d29d3637a02a95bb09ab5794dfcd/ss_73153d8de041d29d3637a02a95bb09ab5794dfcd.1920x1080.jpg?t=1769887335","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4127790/73153d8de041d29d3637a02a95bb09ab5794dfcd/ss_73153d8de041d29d3637a02a95bb09ab5794dfcd.600x338.jpg?t=1769887335"}],"short_description":"Survive as a young, lost vampire in 1950s Kowloon and navigate its dark depths, but beware; you're not the only thing that lurks within them. Grow as a vampire, using skills and vampiric abilities to overcome challenges, gain allies and manage your overwhelming thirst.","steam_appid":4127790,"support_info":{"email":"manekimushidev@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}