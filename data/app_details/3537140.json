140/extras/9d786cea88b01a56f36373e3fc99d54b.poster.avif?t=1749850405\" width=520 height=350 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/extras/9d786cea88b01a56f36373e3fc99d54b.webm?t=1749850405\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/extras/9d786cea88b01a56f36373e3fc99d54b.mp4?t=1749850405\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Purchase and unlock upgrades!</h2><p class=\"bb_paragraph\" >Use your research points to improve Misty's fishing gear, letting you catch better fish even faster, store more fish and bait, or get bonus luck! <br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/extras/b273ae37e8548588a534d677ceeeef7a.poster.avif?t=1749850405\" width=520 height=350 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/extras/b273ae37e8548588a534d677ceeeef7a.webm?t=1749850405\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/extras/b273ae37e8548588a534d677ceeeef7a.mp4?t=1749850405\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Customize Misty's and her boat!</h2><p class=\"bb_paragraph\" >Convert your research points into money, and spend it on customizing Misty's outfit, hairstyle and boat!<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/extras/281b5a164707154721dd75ba13ace707.poster.avif?t=1749850405\" width=520 height=350 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/extras/281b5a164707154721dd75ba13ace707.webm?t=1749850405\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/extras/281b5a164707154721dd75ba13ace707.mp4?t=1749850405\" type=\"video/mp4\"></video></span></p>","developers":["Midware Games"],"genres":[{"description":"Casual","id":"4"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3537140/25b5bcff4fbe6adea2b6216b0513efdb6a4a2a98/header.jpg?t=1749850405","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3537140/1230152277/1e03106c5161a55ed5d1aa5732bab6e540f06a92/1750859028/dash_av1.mpd?t=1749766183","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3537140/1230152277/1e03106c5161a55ed5d1aa5732bab6e540f06a92/1750859028/dash_h264.mpd?t=1749766183","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3537140/1230152277/1e03106c5161a55ed5d1aa5732bab6e540f06a92/1750859028/hls_264_master.m3u8?t=1749766183","id":257149882,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257149882/c9b6fc98b7bbb6043e8753a025885a522f7618be/movie_600x337.jpg?t=1749766183"}],"name":"Misty's Idle Fishing","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Misty's Idle Fishing - <span class=\"discount_original_price\">$5.99</span> $3.29 USD","packageid":1248572,"percent_savings":0,"percent_savings_text":"-45% ","price_in_cents_with_discount":329}],"title":"Buy Misty's Idle Fishin