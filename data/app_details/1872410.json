nail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/fa0f9ca1fd8886d1057cc3f786b140d93bf7670e/ss_fa0f9ca1fd8886d1057cc3f786b140d93bf7670e.600x338.jpg?t=1769135181"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/f193adf957e029b777d3c706de9400a2d6598b4c/ss_f193adf957e029b777d3c706de9400a2d6598b4c.1920x1080.jpg?t=1769135181","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/f193adf957e029b777d3c706de9400a2d6598b4c/ss_f193adf957e029b777d3c706de9400a2d6598b4c.600x338.jpg?t=1769135181"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/dbd1f708c75e97dc743e81d4b0c5b9967e0590f3/ss_dbd1f708c75e97dc743e81d4b0c5b9967e0590f3.1920x1080.jpg?t=1769135181","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/dbd1f708c75e97dc743e81d4b0c5b9967e0590f3/ss_dbd1f708c75e97dc743e81d4b0c5b9967e0590f3.600x338.jpg?t=1769135181"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/0c8f33d8bc5b6a715fba445a90c4a4b1334440d3/ss_0c8f33d8bc5b6a715fba445a90c4a4b1334440d3.1920x1080.jpg?t=1769135181","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/0c8f33d8bc5b6a715fba445a90c4a4b1334440d3/ss_0c8f33d8bc5b6a715fba445a90c4a4b1334440d3.600x338.jpg?t=1769135181"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/ce003449c135517338fcd111b9058536bca546be/ss_ce003449c135517338fcd111b9058536bca546be.1920x1080.jpg?t=1769135181","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/ce003449c135517338fcd111b9058536bca546be/ss_ce003449c135517338fcd111b9058536bca546be.600x338.jpg?t=1769135181"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1872410/ss_17ae3a553742d045419e97a173f762e98a34f598.1920x108