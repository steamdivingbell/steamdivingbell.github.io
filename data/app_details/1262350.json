steamstatic.com/store_item_assets/steam/apps/1262350/extras/49906939f5426c854ec1be48eaf52fcb.mp4?t=1773697315\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/996594ad919c09192a7fa5de8b68b1eb.poster.avif?t=1773697315\" width=600 height=80 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/996594ad919c09192a7fa5de8b68b1eb.webm?t=1773697315\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/996594ad919c09192a7fa5de8b68b1eb.mp4?t=1773697315\" type=\"video/mp4\"></video></span><br>Experience fear and apprehension as you encounter strange horrors, carefully manage scarce resources, and seek solutions to challenging riddles.<br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/0bd5cb0af3279ccbd2b4eff035a9afe0.webp?t=1773697315\" width=600 height=32 /></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/9099b3e9f319421abc7112b880e741a7.poster.avif?t=1773697315\" width=600 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/9099b3e9f319421abc7112b880e741a7.webm?t=1773697315\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/9099b3e9f319421abc7112b880e741a7.mp4?t=1773697315\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/0578bbf175ef2cf2160f0ac65a3562a4.poster.avif?t=1773697315\" width=600 height=80 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/0578bbf175ef2cf2160f0ac65a3562a4.webm?t=1773697315\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/0578bbf175ef2cf2160f0ac65a3562a4.mp4?t=1773697315\" type=\"video/mp4\"></video></span><br>Explore the dim corners of a derelict spaceship, delve into the mysterious fate of the inhabitants of a doomed facility, and seek what lies beneath.<br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/0bd5cb0af3279ccbd2b4eff035a9afe0.webp?t=1773697315\" width=600 height=32 /></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/a1a2661f63aa3f5de5faddfee4d954f1.poster.avif?t=1773697315\" width=600 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/a1a2661f63aa3f5de5faddfee4d954f1.webm?t=1773697315\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/a1a2661f63aa3f5de5faddfee4d954f1.mp4?t=1773697315\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/bce1e8719aa1f4d2587b882dc9be7268.poster.avif?t=1773697315\" width=600 height=80 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/bce1e8719aa1f4d2587b882dc9be7268.webm?t=1773697315\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1262350/extras/bce1e8719aa1f4d2587b882dc9be7268.mp4?t=1773697315\" type=\"video/mp4\"></video></s