th_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709040/ebffbb10fb2bbd7b18c018feb4215533b07162b8/ss_ebffbb10fb2bbd7b18c018feb4215533b07162b8.1920x1080.jpg?t=1767711774","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709040/ebffbb10fb2bbd7b18c018feb4215533b07162b8/ss_ebffbb10fb2bbd7b18c018feb4215533b07162b8.600x338.jpg?t=1767711774"}],"short_description":"Experience a VR survival horror where you battle eerie creatures and solve hands-on VR puzzles in immersive dark worlds. Manage resources, upgrade your gear, and face relentless, twisted dangers to escape the nightmare.","steam_appid":3709040,"support_info":{"email":"support@dreadarion.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Portuguese - Portugal, Arabic, Korean","type":"game","website":null}