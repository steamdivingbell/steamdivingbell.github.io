assets/steam/apps/2929040/d3fa5c5fab586828b04cf65e73a85a34091c9e0e/ss_d3fa5c5fab586828b04cf65e73a85a34091c9e0e.1920x1080.jpg?t=1772707443","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2929040/d3fa5c5fab586828b04cf65e73a85a34091c9e0e/ss_d3fa5c5fab586828b04cf65e73a85a34091c9e0e.600x338.jpg?t=1772707443"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2929040/c044f88ea8182bee3ccffe1db9a324b912fe1927/ss_c044f88ea8182bee3ccffe1db9a324b912fe1927.1920x1080.jpg?t=1772707443","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2929040/c044f88ea8182bee3ccffe1db9a324b912fe1927/ss_c044f88ea8182bee3ccffe1db9a324b912fe1927.600x338.jpg?t=1772707443"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2929040/b2dd0b6bd578d77f747889238359e46ee9d75345/ss_b2dd0b6bd578d77f747889238359e46ee9d75345.1920x1080.jpg?t=1772707443","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2929040/b2dd0b6bd578d77f747889238359e46ee9d75345/ss_b2dd0b6bd578d77f747889238359e46ee9d75345.600x338.jpg?t=1772707443"}],"short_description":"From the minds behind Age of Empires, Age of Mythology, and Halo Wars comes a new generation of RTS. Forge powerful alliances and build an unstoppable fleet as you battle across the galaxy to drive back the insidious Voltari.","steam_appid":2929040,"support_info":{"email":"support@lastkeep.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.lastkeep.com/"}