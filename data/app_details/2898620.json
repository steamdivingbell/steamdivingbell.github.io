ss_a91e730b31283b54cc6c6c15ee7984b17538271a.600x338.jpg?t=1772824375"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2898620/177cc3083b2eadcaf2a30f9f97b370c23c25f0cc/ss_177cc3083b2eadcaf2a30f9f97b370c23c25f0cc.1920x1080.jpg?t=1772824375","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2898620/177cc3083b2eadcaf2a30f9f97b370c23c25f0cc/ss_177cc3083b2eadcaf2a30f9f97b370c23c25f0cc.600x338.jpg?t=1772824375"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2898620/a7ceb660b353ae023635c84ecff556c08e95c3ef/ss_a7ceb660b353ae023635c84ecff556c08e95c3ef.1920x1080.jpg?t=1772824375","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2898620/a7ceb660b353ae023635c84ecff556c08e95c3ef/ss_a7ceb660b353ae023635c84ecff556c08e95c3ef.600x338.jpg?t=1772824375"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2898620/a46b04b560b1c7c88e088ddb15e8dbeabe671bf6/ss_a46b04b560b1c7c88e088ddb15e8dbeabe671bf6.1920x1080.jpg?t=1772824375","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2898620/a46b04b560b1c7c88e088ddb15e8dbeabe671bf6/ss_a46b04b560b1c7c88e088ddb15e8dbeabe671bf6.600x338.jpg?t=1772824375"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2898620/74e7af7719027b2e49472a56463582f194c8e349/ss_74e7af7719027b2e49472a56463582f194c8e349.1920x1080.jpg?t=1772824375","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2898620/74e7af7719027b2e49472a56463582f194c8e349/ss_74e7af7719027b2e49472a56463582f194c8e349.600x338.jpg?t=1772824375"}],"short_description":"Cast into an idyllic wilderness, will you endure? A sandbox city-building game featuring a deceptively cheerful world: build freely \u2014no grids\u2014 plus a fully simulated economy, intricate production chains, deep research tree, and growth you can feel. Can your people survive the winter?","steam_appid":2898620,"support_info":{"email":"support@rospeathstudios.co.uk","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.rospeathstudios.co.uk"}