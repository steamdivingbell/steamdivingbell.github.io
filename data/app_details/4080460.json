ttps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4080460/ed0418f7bf75bb8082069bfa9a902a5e2dcd47d5/ss_ed0418f7bf75bb8082069bfa9a902a5e2dcd47d5.600x338.jpg?t=1770195847"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4080460/12bed979abbeb56a2058998008768c3eb30327e8/ss_12bed979abbeb56a2058998008768c3eb30327e8.1920x1080.jpg?t=1770195847","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4080460/12bed979abbeb56a2058998008768c3eb30327e8/ss_12bed979abbeb56a2058998008768c3eb30327e8.600x338.jpg?t=1770195847"}],"short_description":"You simply fell asleep, bored of studying as usual. But when you opened your eyes, you were trapped in a school where the same day repeats. No friends, no teachers. Only things that used to be your friends roam the corridors. Gather supplies, survive, and find a way out.","steam_appid":4080460,"support_info":{"email":"numberone8019@gmail.com","url":""},"supported_languages":"English, Japanese, Korean<strong>*</strong>, Simplified Chinese, Traditional Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}