sets/steam/apps/2994630/extras/df4250e54f5413562fdf572130fc36be.avif?t=1764689906\" width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Staff List</strong></p><p class=\"bb_paragraph\" >Planning: KENKOH-KIKOH</p><p class=\"bb_paragraph\" >Direction and General Management: Shishikura Shishinobu</p><p class=\"bb_paragraph\" >Visual Materials Production, Backgrounds, UI Design: Jun Osato</p><p class=\"bb_paragraph\" >System Engineer: Keita Kanai</p><p class=\"bb_paragraph\" >Sound Effects, BGM Production: Kiyoshi Hori</p><p class=\"bb_paragraph\" >Illustrations and Partial Animations: Shuu Yonezawa</p>","developers":["Wellness Mechanism"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2994630/15577820fe4af787620bf420ef917735f27f8ebd/header.jpg?t=1764689906","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Apple M1\u307e\u305f\u306f\u30a4\u30f3\u30c6\u30ebCore M</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2994630/788206/fbf8b890e496669dacbd6e6b515131a52737f0cf/1750956247/dash_av1.mpd?t=1742809571","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2994630/788206/fbf8b890e496669dacbd6e6b515131a52737f0cf/1750956247/dash_h264.mpd?t=1742809571","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2994630/788206/fbf8b890e496669dacbd6e6b515131a52737f0cf/1750956247/hls_264_master.m3u8?t=1742809571","id":257074956,"name":"Children's Garden Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257074956/9f305873e1fdec52cd1f1a36487076ddeae83f74/movie_600x337.jpg?t=1742809571"}],"name":"Children's Garden","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong