32240/extras/8cb5faef621e3c5cbc46e350254f4f37.poster.avif?t=1771843019\" width=960 height=540 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/8cb5faef621e3c5cbc46e350254f4f37.webm?t=1771843019\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/8cb5faef621e3c5cbc46e350254f4f37.mp4?t=1771843019\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/184b4898b4f286d973a0d77a242205c8.avif?t=1771843019\" width=616 height=94 /></span></p><p class=\"bb_paragraph\" >The game incorporates active and passive bonuses through Family Bonuses, Research and Development, and Imperial Privileges. There are two main research branches: Technology and Philosophy.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/725c32703d1850a31c45a3bfbdcca7d5.poster.avif?t=1771843019\" width=960 height=540 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/725c32703d1850a31c45a3bfbdcca7d5.webm?t=1771843019\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/725c32703d1850a31c45a3bfbdcca7d5.mp4?t=1771843019\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/f733f40dbcddd1d990f5faef81ca5340.avif?t=1771843019\" width=616 height=94 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">The greatest threats are not always on the battlefield. Earthquakes, fires, famine, plagues, and political sabotage can strike without warning. Some enemies will wear armor, others will smile as they shake your hand, all will test your leadership.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/3fc48c7380a49e744aca3dfa56e55d70.poster.avif?t=1771843019\" width=960 height=540 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/3fc48c7380a49e744aca3dfa56e55d70.webm?t=1771843019\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/3fc48c7380a49e744aca3dfa56e55d70.mp4?t=1771843019\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Co-financed by the Croatian Audiovisual Centre</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/extras/29023f93d96773e9d87fe390fd59b27b.avif?t=1771843019\" width=616 height=140 /></span></p>","developers":["Siscia Games"],"dlc":[4031290],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632240/8c5a16635913dd4cda31d92509bf3e80fac4e2dd/header.jpg?t=1771843019","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>