_assets/steam/apps/4010340/4ff63acf8bf58df72a6fbc1c67219f62a22c2433/ss_4ff63acf8bf58df72a6fbc1c67219f62a22c2433.600x338.jpg?t=1772967722"}],"short_description":"A hex based strategy game set in the time of the Roman Republic. Fight through numerous historical wars and campaigns to experience the rise of one of the worlds greatest empires.","steam_appid":4010340,"support_info":{"email":"MooreGamesENK@outlook.com","url":"https://RomanGeneral.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://RomanGeneral.com"}