3d2e4.webm?t=1757447742\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/50a257fdf35324a330043dd92663d2e4.mp4?t=1757447742\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83e\udddf <strong>Fight to Survive</strong><br>Battle hordes of the undead, hostile survivors, and twisted military experiments.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/b5344976948c4491e231e2122b40f932.poster.avif?t=1757447742\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/b5344976948c4491e231e2122b40f932.webm?t=1757447742\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83d\uddfa\ufe0f <strong>Quest System</strong></p><p class=\"bb_paragraph\" >Embark on story-driven adventures and discover the secrets of the wasteland.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/957bbe0f6f1229c7922b7147218ae8a5.poster.avif?t=1757447742\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/957bbe0f6f1229c7922b7147218ae8a5.webm?t=1757447742\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/957bbe0f6f1229c7922b7147218ae8a5.mp4?t=1757447742\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83d\ude97 <strong>Vehicle System</strong><br>Repair, upgrade, and maintain vehicles to traverse the wasteland.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/f205b10690c5e95267e3d27af874e12f.poster.avif?t=1757447742\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/f205b10690c5e95267e3d27af874e12f.webm?t=1757447742\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/f205b10690c5e95267e3d27af874e12f.mp4?t=1757447742\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83e\udde0 <strong>Skill-Based Progression</strong> <br>Level up by surviving. Unlock new abilities and reclaim fragments of your stolen power.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/5a4c5c881736cf9c2402a07137487ab4.poster.avif?t=1757447742\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/5a4c5c881736cf9c2402a07137487ab4.webm?t=1757447742\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/5a4c5c881736cf9c2402a07137487ab4.mp4?t=1757447742\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83c\udfd5\ufe0f <strong>Build &amp; Barricade</strong><br>Create safe zones anywhere. Fortify your shelter and hold out against the night.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83c\udf26\ufe0f <strong>Dynamic Weather &amp; Day/Night Cycle</strong><br>Adapt to changing conditions where every hour brings new dangers.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83e\udd1d <strong>Survive Together</strong> <br>Play solo or in online co-op. Team up to share resources, build stronger defenses, and face greater threats.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83d\udcb0 <strong>Trade &amp; Customize</strong><br>Barter with survivors, adjust difficulty, and tailor the experience to your playstyle.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\ud83d\udd2b <strong>Loot &amp; Equip</strong> <br>Find powerful firearms, melee weapons, and survival gear to improve your chances.<br><br><br>Last Pulse Studio!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/extras/2149d1e7d796d879d590c58df1765411.avif?t=1757447742\" width=1560 height=498 /></span></p><p class=\"bb_paragraph\" ></p>","developers":["LastPulse Studio"],"fullgame":{"appid":"3721680","name":"Shatterland"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020910/aea151ad3ebf1ad9f2818bdf5e5ca266380a9181/header.jpg?t=1757447742","is_free":true,"legal_notice":"All right reserved","linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257194794,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257194794/movie480.mp4?t=1757447740","max":"http://video.akamai.steamstatic.com/store_trailers/257194794/movie_max.mp4?t=1757447740"},"name":"Demo - Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257194794/c8e4eb0e35f845c33612d8784bcd62bf11ae91a1/movie_600x337.jpg?t=1757447740","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257194794/movie480_vp9.webm?t=1757447740","max":"http://vi