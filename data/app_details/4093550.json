6\u6cb3\u7cfb\uff0c\u4e3a\u6b64\u4eba\u7c7b\u4e5f\u8bbe\u7acb\u4e86\u9ad8\u5ea6\u667a\u80fd\u5316\u7684\u57fa\u5730\u7ef4\u62a4\u7cfb\u7edf\u548c\u9632\u536b\u7cfb\u7edf\uff0c\u5f53\u67d0\u4e2a\u57fa\u5730\u53d7\u5230\u5b87\u5b99\u4e2d\u4e0d\u65ad\u8513\u5ef6\u7684\u71b5\u517d\u653b\u51fb\u65f6\uff0c\u71b5\u51cf\u534f\u8bae\u5c31\u4f1a\u88ab\u6fc0\u6d3b\uff0c\u57fa\u5730\u5c06\u4f1a\u53ec\u5524\u4eba\u7c7b\u77e5\u8bc6\u5b9d\u5e93\u7684\u6700\u540e\u667a\u68b0\u7ef4\u62a4\u8005\u201c\u4e07\u5178\u58c1\u5792\u201d\uff0c\u6765\u4e0e\u8fd9\u4e9b\u4ee3\u8868\u9057\u5fd8\u548c\u6df7\u4e71\u7684\u71b5\u517d\u602a\u7269\u8fdb\u884c\u6218\u6597\uff0c\u6062\u590d\u57fa\u5730\u7684\u6b63\u5e38\u8fd0\u4f5c\u3002</p><h2 class=\"bb_tag\" ><strong>\u6d41\u7a0b\u539f\u7406</strong></h2><p class=\"bb_paragraph\" >\u6e38\u620f\u4e2d\uff0c\u73a9\u5bb6\u6240\u626e\u6f14\u7684\u667a\u68b0\u7ef4\u62a4\u8005\u901a\u8fc7\u6536\u96c6\u5361\u724c/\u83b7\u5f97\u9053\u5177/\u63d0\u5347\u5c5e\u6027\u6765\u8fdb\u884c\u81ea\u8eab\u6784\u7b51\uff0c\u6bcf\u4e00\u5f20\u5361\u724c\u90fd\u7ed1\u5b9a\u4e86\u4e00\u4e2a\u5355\u8bcd\uff08\u77e5\u8bc6\u70b9\uff09\uff0c\u73a9\u5bb6\u6bcf\u6b21\u4f7f\u7528\u5361\u724c\u65f6\u90fd\u9700\u8981\u6b63\u786e\u5730\u56de\u7b54\u95ee\u9898\uff0c\u56e0\u6b64\uff0c\u73a9\u5bb6\u5728\u6218\u6597\u7684\u8fc7\u7a0b\u4e2d\uff0c\u4e0d\u4ec5\u53ef\u4ee5\u5728\u6570\u503c\u548c\u9053\u5177\u7684\u83b7\u53d6\u4e0a\u517b\u6210\u548c\u6210\u957f\uff0c\u66f4\u53ef\u4ee5\u901a\u8fc7\u81ea\u5df1\u5bf9\u4e8e\u5355\u8bcd\u7684\u719f\u7ec3\u7a0b\u5ea6\u6765\u52a0\u5f3a\u8f93\u51fa\uff0c\u7528\u8fd9\u79cd\u6b63\u53cd\u9988\u6765\u5f3a\u5316\u8bb0\u5fc6\u3002</p><p class=\"bb_paragraph\" >\u73a9\u5bb6\u5728\u6e38\u620f\u521d\u59cb\u65f6\u53ea\u9700\u8981\u638c\u63e1\u6781\u5c11\u7684\u5355\u8bcd\uff085\u4e2a\uff09\uff0c\u6bcf\u5b8c\u6210\u4e00\u4e2a\u5173\u5361\u540e\u73a9\u5bb6\u5c06\u4f1a\u83b7\u5f97\u4e00\u4e2a\u65b0\u7684\u5361\u724c\u548c\u5355\u8bcd\uff0c\u5982\u6b64\u73a9\u5bb6\u53ef\u4ee5\u5faa\u5e8f\u6e10\u8fdb\u5730\u4e0d\u65ad\u719f\u6089\u548c\u8bb0\u5fc6\u65b0\u7684\u5355\u8bcd\uff0c\u73a9\u5bb6\u5728\u719f\u6089\u548c\u6784\u7b51\u81ea\u5df1\u5361\u7ec4\u7684\u540c\u65f6\uff0c\u4e5f\u4e0d\u65ad\u5730\u5c06\u788e\u7247\u5316\u77e5\u8bc6\u8f6c\u5316\u4e3a\u957f\u671f\u8bb0\u5fc6\uff0c\u5b9e\u73b0\u77e5\u8bc6\u7684\u6709\u5e8f\u5316\u5b58\u50a8\uff0c\u76f4\u81f3\u6e38\u620f\u7ed3\u675f\u65f6\uff0c\u7406\u8bba\u4e0a\u73a9\u5bb6\u5c06\u4f1a\u65e0\u969c\u788d\u5730\u719f\u7ec3\u638c\u63e115-20\u4e2a\u65b0\u5355\u8bcd\u3002</p><h2 class=\"bb_tag\" ><strong>\u6559\u80b2\u54f2\u5b66</strong></h2><p class=\"bb_paragraph\" >\u5c06\u5b66\u4e60\u884c\u4e3a\u91cd\u6784\u4e3a\u5bf9\u6297\u77e5\u8bc6\u71b5\u589e\u7684\u79d1\u6280\u6218\u4e89\uff0c\u4f7f\u8bb0\u5fc6\u8fc7\u7a0b\u4ece\u67af\u71e5\u91cd\u590d\u5347\u534e\u4e3a\u53f2\u8bd7\u7ea7\u6587\u660e\u62ef\u6551\u884c\u52a8\uff0c\u8d4b\u4e88\u5b66\u4e60\u884c\u4e3a\u66f4\u6df1\u523b\u7684\u6559\u80b2\u610f\u4e49\u3002\u73a9\u5bb6\u5728\u6e38\u620f\u4e2d\u7684\u6bcf\u4e00\u6b65\u64cd\u4f5c\u90fd\u8c61\u5f81\u7740\u4e0e\u77e5\u8bc6\u9057\u5fd8\u7684\u6218\u6597\uff0c\u901a\u8fc7\u5b8c\u6210\u4efb\u52a1\u548c\u6218\u6597\uff0c\u73a9\u5bb6\u4e0d\u4ec5\u5b66\u4e60\u4e86\u77e5\u8bc6\uff0c\u8fd8\u4f53\u9a8c\u5230\u4e86\u62ef\u6551\u6587\u660e\u7684\u6210\u5c31\u611f\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["yitian studio"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4093550/17fce5a7f6cb2140f2cb7dab5ae75c723301d65d/header.jpg?t=1764744832","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/