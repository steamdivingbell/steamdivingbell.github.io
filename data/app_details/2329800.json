939a46e6fda71b921493c/ss_93c794f10e06610a6a7939a46e6fda71b921493c.600x338.jpg?t=1771879351"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2329800/ss_3e79e27ecba08680e31b1dd18210420cb8874235.1920x1080.jpg?t=1771879351","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2329800/ss_3e79e27ecba08680e31b1dd18210420cb8874235.600x338.jpg?t=1771879351"}],"short_description":"Lose yourself in space. Battle through intense planetary and space combat, traversing vast exotic planets in an endless universe. Hack, loot, trade your way up. Interact with a variety of alien life including trusty companions. Can you discover your past and the future of a decaying humanity?","steam_appid":2329800,"support_info":{"email":"away2thestars@gmail.com","url":"[url=https://mastodon.gamedev.place/@away2thestars]Mastodon[/url]"},"supported_languages":"English, Spanish - Spain","type":"game","website":"https://trello.com/b/GqTRk82D/away-to-the-stars-roadmap"}