ong>Nostalgic visuals</strong> with original, <strong>hand-painted</strong> digital textures;</p><p class=\"bb_paragraph\">- An <strong>original</strong> and <strong>distorted</strong> <strong>soundtrack.</strong></p>","developers":["Aura","Flafo"],"genres":[{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3560420/50dc4753e42c4b90c80fce1ade437625ef327134/header.jpg?t=1745251229","is_free":false,"legal_notice":"Gigantic G Studio. All rights reserved. All trademarks are the property of their respective owners in the US and other countries. VAT included in all prices where applicable.","linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257112100,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257112100/movie480.mp4?t=1741711877","max":"http://video.akamai.steamstatic.com/store_trailers/257112100/movie_max.mp4?t=1741711877"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257112100/2814592aeefaab459d9ce001ae3af92849dd7a41/movie_600x337.jpg?t=1741711877","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257112100/movie480_vp9.webm?t=1741711877","max":"http://video.akamai.steamstatic.com/store_trailers/257112100/movie_max_vp9.webm?t=1741711877"}}],"name":"Espirito Delusion","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> i5<br></li><li><strong>Memory:</strong> 2 GB RAM</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> i7<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GTX 1050</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Gigantic G"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","r