p for use by configuring them in the options menu.</p>","developers":["Genki Co., Ltd."],"dlc":[3959440],"genres":[{"description":"Racing","id":"9"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2634950/header.jpg?t=1758767059","is_free":false,"legal_notice":"\u00a9 Genki Co., Ltd.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2634950/1150095618/a501f5ae6222c9a9a02a287db95fc2503d6fb26e/1757836747/dash_av1.mpd?t=1757926841","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2634950/1150095618/a501f5ae6222c9a9a02a287db95fc2503d6fb26e/1757836747/dash_h264.mpd?t=1757926841","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2634950/1150095618/a501f5ae6222c9a9a02a287db95fc2503d6fb26e/1757836747/hls_264_master.m3u8?t=1757926841","id":257071517,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257071517/movie480.mp4?t=1757926841","max":"https://video.akamai.steamstatic.com/store_trailers/257071517/movie_max.mp4?t=1757926841"},"name":"PV Short #0","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257071517/ce190c0d58bacc11ac4627e7ae208bf476a2a9a0/movie_600x337.jpg?t=1757926841","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257071517/movie480_vp9.webm?t=1757926841","max":"https://video.akamai.steamstatic.com/store_trailers/257071517/movie_max_vp9.webm?t=1757926841"}},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2634950/1828750264/b99bc2f19a659ba015eb202fc892c36a94f7e212/1757845741/dash_av1.mpd?t=1757926852","dash_h264":"https:/