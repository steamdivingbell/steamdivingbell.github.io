on.</p><p class=\"bb_paragraph\">For paid plugins,</p><p class=\"bb_paragraph\">select the desired DLC from the &quot;DLC&quot; section in the left menu and download it.</p><p class=\"bb_paragraph\"></p>","developers":["STRIKEWORKS"],"fullgame":{"appid":"3634660","name":"TyranoStudio Visual Novel Scripting"},"genres":[{"description":"Free To Play","id":"37"},{"description":"Utilities","id":"57"},{"description":"Game Development","id":"60"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3774460/71411bb98ce86bc2f70c652e35cd8765941a69cc/header.jpg?t=1748600912","is_free":false,"legal_notice":"\u00a9 STRIKEWORKS","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Additional Notes:</strong> System supporting Tyrano Studio</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Additional Notes:</strong> System supporting Tyrano Studio</li></ul>"},"movies":[{"highlight":true,"id":257146364,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257146364/movie480.mp4?t=1748446709","max":"http://video.akamai.steamstatic.com/store_trailers/257146364/movie_max.mp4?t=1748446709"},"name":"Rule Transition Plugin","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257146364/5e8f9c202a45405bbd76d9dd99caac4e7583b056/movie_600x337.jpg?t=1748446709","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257146364/movie480_vp9.webm?t=1748446709","max":"http://video.akamai.steamstatic.com/store_trailers/257146364/movie_max_vp9.webm?t=1748446709"}}],"name":"Tyrano Studio - Advanced Pro Kit","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"ca