/3661500/extras/ff477955bd021dba4612759cb4afbabb.webm?t=1770590588\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3661500/extras/ff477955bd021dba4612759cb4afbabb.mp4?t=1770590588\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><u>We can't wait to see you in the office!</u></strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3661500/extras/5efef9a8ffd039300dcc77fa807accec.avif?t=1770590588\" width=683 height=1059 /></span></p><p class=\"bb_paragraph\" ></p>","developers":["Headplug Games"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3661500/2d270927f266d667cf5c77b339bdc384b0c4988d/header.jpg?t=1770590588","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3661500/1295911574/d5aa0ef601ee0acac84a73284a6a006fce3ec683/1765310686/dash_av1.mpd?t=1765315361","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3661500/1295911574/d5aa0ef601ee0acac84a73284a6a006fce3ec683/1765310686/dash_h264.mpd?t=1765315361","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3661500/1295911574/d5aa0ef601ee0acac84a73284a6a006fce3ec683/1765310686/hls_264_master.m3u8?t=1765315361","id":257158040,"name":"Middle Management Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257158040/770c5d3ffee37042f6c623555d6a82ace75c2283/movie_600x337.jpg?t=1765315361"}],"name":"Middle Management","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 (64 b