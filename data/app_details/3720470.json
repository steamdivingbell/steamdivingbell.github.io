steam/apps/3720470/9c1568067b918271327bec6b379902056052548e/ss_9c1568067b918271327bec6b379902056052548e.600x338.jpg?t=1773036843"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3720470/2a680cb7b9f7b606454b5c841e1cb25bc1d69256/ss_2a680cb7b9f7b606454b5c841e1cb25bc1d69256.1920x1080.jpg?t=1773036843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3720470/2a680cb7b9f7b606454b5c841e1cb25bc1d69256/ss_2a680cb7b9f7b606454b5c841e1cb25bc1d69256.600x338.jpg?t=1773036843"}],"short_description":"Manage, defend, exploit! As the boss, use cards to build, assign staff, and force overtime for profit in this sim/tower defense/card blend. Experience overtime culture from the boss view.","steam_appid":3720470,"support_info":{"email":"394856387@qq.com","url":""},"supported_languages":"English, Simplified Chinese, Traditional Chinese","type":"game","website":null}