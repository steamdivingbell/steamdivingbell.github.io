ai.steamstatic.com/store_item_assets/steam/apps/4076910/fc4081876662f5bedc32062a65534cfa0e04cb81/ss_fc4081876662f5bedc32062a65534cfa0e04cb81.600x338.jpg?t=1773365807"}],"short_description":"Uncover the truth of darkness in a Souls-like RPG. Face punishing enemies, dig up ancient secrets and Light your way through a mysterious world that challenges every decision.","steam_appid":4076910,"support_info":{"email":"natalia@eldoriagame.com","url":"https://eldoriagame.com"},"supported_languages":"English","type":"game","website":null}