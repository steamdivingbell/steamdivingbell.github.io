l the different regions of Aurellia, unlock new heroes, face-off against powerful enemies, and go head to head with &quot;Void Raids&quot;.</p></li><li><p class=\"bb_paragraph\" >Arcade Modes</p><p class=\"bb_paragraph\" >We will be continually releasing new and exciting arcade modes, adding layers to the existing gameplay, and giving you more ways to play.\u00a0</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >And more....</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Factions &amp; Faction Leaderboards</p></li><li><p class=\"bb_paragraph\" >Daily &amp; Weekly Mission System</p></li><li><p class=\"bb_paragraph\" >Promo Cards &amp; Special In-game Events</p></li></ul>","developers":["Hybrid Theory Games Inc."],"genres":[{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3398750/header.jpg?t=1763847146","is_free":true,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 11 Big Sur (Mac computers using Apple silicon chips are currently not on the list of supported devices.)</li></ul>"},"name":"Gear Slayer CCG","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (64-bit)</li></ul>"},"platforms":{"linux":false,"mac":true,"windows":true},"publishers":["Hybrid Theory Games Inc."],"ratings":{"dejus":{"banned":"0","descriptors":"Linguagem impr\u00f3pria\nConte\u00fado sexual\nViol\u00eancia","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Sexuelle Andeutungen\nGewalt\nAlkohol / Tabak","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamst