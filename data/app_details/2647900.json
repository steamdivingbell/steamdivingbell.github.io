ai.steamstatic.com/store_item_assets/steam/apps/2647900/extras/death_is_only_the_beginning.gif?t=1748078424\" /></div>Each god have their own style. <strong>Receive their powers, combine them</strong> and make each one of your run unique. </p><p class=\"bb_paragraph\">Between two runs, restore your divinity to become the feared god you used to be.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2647900/extras/b\u00e9n\u00e9dictions_eng.gif?t=1748078424\" /></div></p>","developers":["Chaotic Games"],"genres":[{"description":"Action","id":"1"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2647900/8914d4f76303de36d47a8d4069229f8439a86f86/header.jpg?t=1748078424","is_free":false,"legal_notice":"\u00a9ChaoticGames, SAS 2023. All rights reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257088361,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257088361/movie480.mp4?t=1747383875","max":"http://video.akamai.steamstatic.com/store_trailers/257088361/movie_max.mp4?t=1747383875"},"name":"Pre alpha gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257088361/1ec508ea3079246a03e198f3f28c594a2fb14695/movie_600x337.jpg?t=1747383875","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257088361/movie480_vp9.webm?t=1747383875","max":"http://video.akamai.steamstatic.com/store_trailers/257088361/movie_max_vp9.webm?t=1747383875"}}],"name":"Seth","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"