tem_assets/steam/apps/3520420/e85568107a86c7f68f0a46e1f66e9726eb8d16dd/ss_e85568107a86c7f68f0a46e1f66e9726eb8d16dd.600x338.jpg?t=1754669591"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/0caa9ca2b3ffdb7b3fefb1b7917a2d5d71dd5457/ss_0caa9ca2b3ffdb7b3fefb1b7917a2d5d71dd5457.1920x1080.jpg?t=1754669591","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/0caa9ca2b3ffdb7b3fefb1b7917a2d5d71dd5457/ss_0caa9ca2b3ffdb7b3fefb1b7917a2d5d71dd5457.600x338.jpg?t=1754669591"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/b12b15d9c9f0883b2382dd051268a8a46cf6e9b0/ss_b12b15d9c9f0883b2382dd051268a8a46cf6e9b0.1920x1080.jpg?t=1754669591","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/b12b15d9c9f0883b2382dd051268a8a46cf6e9b0/ss_b12b15d9c9f0883b2382dd051268a8a46cf6e9b0.600x338.jpg?t=1754669591"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/f548b43d2ab89d7c9ecb1b2765e93faf14ae547b/ss_f548b43d2ab89d7c9ecb1b2765e93faf14ae547b.1920x1080.jpg?t=1754669591","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/f548b43d2ab89d7c9ecb1b2765e93faf14ae547b/ss_f548b43d2ab89d7c9ecb1b2765e93faf14ae547b.600x338.jpg?t=1754669591"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/40b94dbc70a4cacfc817bda3e05b7f54420cfbcd/ss_40b94dbc70a4cacfc817bda3e05b7f54420cfbcd.1920x1080.jpg?t=1754669591","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/40b94dbc70a4cacfc817bda3e05b7f54420cfbcd/ss_40b94dbc70a4cacfc817bda3e05b7f54420cfbcd.600x338.jpg?t=1754669591"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/759f4859f698b5dc270097ea1ed4530946ab322d/ss_759f4859f698b5dc270097ea1ed4530946ab322d.1920x1080.jpg?t=1754669591","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520420/759f4859f698b5dc270097ea1ed4530946ab322d/ss_759f4859f698b5dc270097ea1ed4530946ab322d.600x338.jpg?t=1754669591"}],"short_description":"The feeling of high-level MMO raids, without the grind. Nullpoint Protocol is a 1-4 player co-op action roguelite where you face harbingers of the apocalypse. Craft your own class from randomized loot, master each boss fight, and save your species from extinction!","steam_appid":3520420,"support_info":{"email":"support@everbloomgames.com","url":"https://everbloomgames.com/contact-us/bug/"},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://everbloomgames.com/nullpoint-protocol/"}