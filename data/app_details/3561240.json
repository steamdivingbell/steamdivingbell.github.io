s and purchase items.</strong></p></li></ul>","developers":["Peculiar Arts"],"genres":[{"description":"Action","id":"1"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3561240/df9851865f1104cd577857d76e052d80ee66664e/header.jpg?t=1742759191","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257113056,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257113056/movie480.mp4?t=1741715569","max":"http://video.akamai.steamstatic.com/store_trailers/257113056/movie_max.mp4?t=1741715569"},"name":"Heroes Unhinged","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257113056/b5f09b6187b03f5dcadee4670b3d1b8f130a0745/movie_600x337.jpg?t=1741715569","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257113056/movie480_vp9.webm?t=1741715569","max":"http://video.akamai.steamstatic.com/store_trailers/257113056/movie_max_vp9.webm?t=1741715569"}}],"name":"Heroes Unhinged","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 64-bit<br></li><li><strong>Processor:</strong> Intel Core i3-3220 CPU @ 3.30GHz<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics<br></li><li><strong>DirectX:</strong> Version 10<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Peculiar Arts"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia Extrema\nLinguagem impr\u00f3pria","rating":"18","rating_generated":"1","required_age":"18","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Drastische Gewalt\nDerbe Sprache","rating":"18","rating_generated":"1","required_age":"18","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"June 2025"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steams