_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571730/2d61ab3d7dda2fe23ed64bc502823e516c3a0c6e/ss_2d61ab3d7dda2fe23ed64bc502823e516c3a0c6e.600x338.jpg?t=1765520657"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571730/e7dfaf93047f2e21b03ba72642161adbcb6e4e22/ss_e7dfaf93047f2e21b03ba72642161adbcb6e4e22.1920x1080.jpg?t=1765520657","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571730/e7dfaf93047f2e21b03ba72642161adbcb6e4e22/ss_e7dfaf93047f2e21b03ba72642161adbcb6e4e22.600x338.jpg?t=1765520657"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571730/ac8308e0ec7ce1fc0372dff8420ecfea8d0c21c7/ss_ac8308e0ec7ce1fc0372dff8420ecfea8d0c21c7.1920x1080.jpg?t=1765520657","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571730/ac8308e0ec7ce1fc0372dff8420ecfea8d0c21c7/ss_ac8308e0ec7ce1fc0372dff8420ecfea8d0c21c7.600x338.jpg?t=1765520657"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571730/5eae96a92933c73d478515e96baf294c2157e168/ss_5eae96a92933c73d478515e96baf294c2157e168.1920x1080.jpg?t=1765520657","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571730/5eae96a92933c73d478515e96baf294c2157e168/ss_5eae96a92933c73d478515e96baf294c2157e168.600x338.jpg?t=1765520657"}],"short_description":"For Mercuri, a girl who fell into a fallen kingdom, everything is overwhelming. She digs deeper into the depths of the kingdom with the help of Golem Hando. Take down the enemies in front of you with TAG-ACTION that alternates between two characters and continue your exploration!","steam_appid":2571730,"support_info":{"email":"teamflask@teamflask.com","url":"https://discord.gg/QekfN6U4dQ"},"supported_languages":"English, Korean, Japanese, French, German, Spanish - Spain, Russian, Simplified Chinese, Traditional Chinese, Portugue