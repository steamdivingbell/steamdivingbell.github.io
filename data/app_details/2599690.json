nematic action style</strong> \u2013 Inspired by classic Hong Kong action films from the \u201980s and \u201990s.</p><p class=\"bb_paragraph\" > </p></li></ul>","developers":["MONTE GALLO"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2599690/header.jpg?t=1772781153","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2599690/1456722022/59b8d570cdd93565cabcd5ccfc91f979673acb91/1755237115/dash_av1.mpd?t=1755251649","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2599690/1456722022/59b8d570cdd93565cabcd5ccfc91f979673acb91/1755237115/dash_h264.mpd?t=1755251649","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2599690/1456722022/59b8d570cdd93565cabcd5ccfc91f979673acb91/1755237115/hls_264_master.m3u8?t=1755251649","id":257183519,"name":"MicroProse","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257183519/b2037bc76b813f571eb84a607ee3d4e8991a6822/movie_600x337.jpg?t=1755251649"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2599690/611113055/9f5cb484790a177c2184c34f35c0317f49a27382/1750935190/dash_av1.mpd?t=1750296015","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2599690/611113055/9f5cb484790a177c2184c34f35c0317f49a27382/1750935190/dash_h264.mpd?t=1750296015","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2599690/611113055/9f5cb484790a177c2184c34f35c0317f49a27382/1750935190/hls_264_master.m3u8?t=1750296015","id":257158494,"name":"minitrailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257158494/51435cb112f30c848892610b829f24faca0aead6/movie_600x337.jpg?t=1750296015"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2599690/854843/6990f6fd8b3e094485d18e86347a9c347f47f56c/