ecies!</h2>Experiment with DNA to create new, unique species with special abilities and traits. Watch as they change colours and shapes as you progress trough the vastness of space and conquer new territories.<br><br><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366290/extras/genemix.gif?t=1715621232\" />","developers":["Mezumo"],"genres":[{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366290/header.jpg?t=1715621232","is_free":false,"legal_notice":"all rights reserved by Mezumo Sp. z O. O.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257020741,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257020741/movie480.mp4?t=1714765241","max":"http://video.akamai.steamstatic.com/store_trailers/257020741/movie_max.mp4?t=1714765241"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257020741/movie.293x165.jpg?t=1714765241","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257020741/movie480_vp9.webm?t=1714765241","max":"http://video.akamai.steamstatic.com/store_trailers/257020741/movie_max_vp9.webm?t=1714765241"}}],"name":"Ants in Space!","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10, Windows 11<br></li><li><strong>Processor:</strong> 3 GHz<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> 1 GB VRAM<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong>