amai.steamstatic.com/store_item_assets/steam/apps/2430390/af68af557ff02c54570eca2c1ccc1c1dc9e1845f/ss_af68af557ff02c54570eca2c1ccc1c1dc9e1845f.1920x1080.jpg?t=1761056442","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2430390/af68af557ff02c54570eca2c1ccc1c1dc9e1845f/ss_af68af557ff02c54570eca2c1ccc1c1dc9e1845f.600x338.jpg?t=1761056442"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2430390/7b67e63d2f23979b3b32b93b2a05cfe04e50e5e2/ss_7b67e63d2f23979b3b32b93b2a05cfe04e50e5e2.1920x1080.jpg?t=1761056442","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2430390/7b67e63d2f23979b3b32b93b2a05cfe04e50e5e2/ss_7b67e63d2f23979b3b32b93b2a05cfe04e50e5e2.600x338.jpg?t=1761056442"}],"short_description":"You are the Guardian - the last hope for a realm under peril. Summoned from our world into theirs, you'll venture into a vast and beautiful fantastic realm to learn, master and thrive - and to chase away the darkness. Forge your destiny from the ruins in this open world survival crafting game.","steam_appid":2430390,"support_info":{"email":"","url":"http://www.10tons.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://dysplaced.com"}