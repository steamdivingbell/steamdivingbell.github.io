am/apps/3892340/295a1fc8dd3e2c07070cd3495c2fd2f4babb0499/ss_295a1fc8dd3e2c07070cd3495c2fd2f4babb0499.600x338.jpg?t=1768830337"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/9f8547c224a8834a7fffe5bb53fd160cec28be83/ss_9f8547c224a8834a7fffe5bb53fd160cec28be83.1920x1080.jpg?t=1768830337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/9f8547c224a8834a7fffe5bb53fd160cec28be83/ss_9f8547c224a8834a7fffe5bb53fd160cec28be83.600x338.jpg?t=1768830337"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/de90b681828d122fb6cbc6952a3c229c8a5b9e0c/ss_de90b681828d122fb6cbc6952a3c229c8a5b9e0c.1920x1080.jpg?t=1768830337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/de90b681828d122fb6cbc6952a3c229c8a5b9e0c/ss_de90b681828d122fb6cbc6952a3c229c8a5b9e0c.600x338.jpg?t=1768830337"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/8b3fb6e9aceb561d43b99bdc4ed3ac602847a34e/ss_8b3fb6e9aceb561d43b99bdc4ed3ac602847a34e.1920x1080.jpg?t=1768830337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/8b3fb6e9aceb561d43b99bdc4ed3ac602847a34e/ss_8b3fb6e9aceb561d43b99bdc4ed3ac602847a34e.600x338.jpg?t=1768830337"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/2ea92151c9dedc93e7eecfc11d88a87f3804aa51/ss_2ea92151c9dedc93e7eecfc11d88a87f3804aa51.1920x1080.jpg?t=1768830337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/2ea92151c9dedc93e7eecfc11d88a87f3804aa51/ss_2ea92151c9dedc93e7eecfc11d88a87f3804aa51.600x338.jpg?t=1768830337"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892340/775b0f0a9f96cd8c69cc0d9e80ef00fa63b76a44/ss_775b0f0a9f96cd8c69cc0d9e80ef00fa63b76a44.1920x1080.jpg?t=1768830337","path_t