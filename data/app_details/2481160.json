apps/2481160/fa6f852463a2b4d34fcd3fbdfc0badd46007e4df/ss_fa6f852463a2b4d34fcd3fbdfc0badd46007e4df.1920x1080.jpg?t=1745450597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2481160/fa6f852463a2b4d34fcd3fbdfc0badd46007e4df/ss_fa6f852463a2b4d34fcd3fbdfc0badd46007e4df.600x338.jpg?t=1745450597"}],"short_description":"The Hungry Town is an interactive visual novel in a dark urban fantasy setting with vampires. You are a young vampire who has been drawn into a violent confrontation between two generations of vampires. You will have to choose a side or decide to stay true to yourself.","steam_appid":2481160,"support_info":{"email":"oshpunch@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Russian<strong>*</strong>, Simplified Chinese, Japanese<br><strong>*</strong>languages with full audio support","type":"game","website":null}