/p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3195990/extras/040fe227e65321d338f5b808eda7ae61.avif?t=1764775261\" width=619 height=200 /></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Original soundtrack by Josie Brechner</p></li><li><p class=\"bb_paragraph\" >Up to 4 players online co-op</p></li><li><p class=\"bb_paragraph\" >Single player mode,\u00a0with help from Frank the Automaton</p></li><li><p class=\"bb_paragraph\" >5 unique character classes  </p></li><li><p class=\"bb_paragraph\" >5 specialty car types and 20 upgrade options  </p></li></ul>","developers":["Long Lost"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3195990/header.jpg?t=1764775261","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3195990/1510046714/631bafd599eed452b774be67aa6e5df204216ade/1761059016/dash_av1.mpd?t=1761060048","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3195990/1510046714/631bafd599eed452b774be67aa6e5df204216ade/1761059016/dash_h264.mpd?t=1761060048","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3195990/1510046714/631bafd599eed452b774be67aa6e5df204216ade/1761059016/hls_264_master.m3u8?t=1761060048","id":257217837,"name":"Rhyolite Nightmare Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257217837/8830d96631750e12161df7b3ff5b2c82a685580f/movie_600x337.jpg?t=1761060048"}],"name":"Rhyolite","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> 2.1 