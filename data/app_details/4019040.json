=1773073122","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4019040/cd5fbc14cbcff10752eee9b1e9750d54c9d244ed/ss_cd5fbc14cbcff10752eee9b1e9750d54c9d244ed.600x338.jpg?t=1773073122"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4019040/10e6e93d5ac7df93a1e972c3c79c25058ecfcd0c/ss_10e6e93d5ac7df93a1e972c3c79c25058ecfcd0c.1920x1080.jpg?t=1773073122","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4019040/10e6e93d5ac7df93a1e972c3c79c25058ecfcd0c/ss_10e6e93d5ac7df93a1e972c3c79c25058ecfcd0c.600x338.jpg?t=1773073122"}],"short_description":"Most autobattlers reset after every match. One Last Sacrifice doesn't. Unlock skills across a branching skill tree. Build a deck. Improve creatures by crafting. Compete in 1v1 duels or 8-player elimination tournaments - sync and async play supported.","steam_appid":4019040,"support_info":{"email":"support@megamaw.de","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://one-last-sacrifice.com"}