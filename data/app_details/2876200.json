static.com/store_item_assets/steam/apps/2876200/d92ca365bd2d565cc9c2c5bbffb4dc6dd688064c/ss_d92ca365bd2d565cc9c2c5bbffb4dc6dd688064c.1920x1080.jpg?t=1766066979","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2876200/d92ca365bd2d565cc9c2c5bbffb4dc6dd688064c/ss_d92ca365bd2d565cc9c2c5bbffb4dc6dd688064c.600x338.jpg?t=1766066979"}],"short_description":"Design your warship and hunt the galaxy\u2019s worst supervillains. Tear enemy spaceships apart piece by piece in physics driven battles. Defeat bosses, rank up, and take on new assignments. Twist the rules with modifiers and unleash chaos in the sandbox!","steam_appid":2876200,"support_info":{"email":"","url":"https://exospace-combat-engineer.com/support/"},"supported_languages":"English, Dutch","type":"game","website":"https://exospace-combat-engineer.com/"}