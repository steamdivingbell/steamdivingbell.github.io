/steam/apps/3216230/6a481ca10935c9f808611987eecf8f5e0cf82f7b/ss_6a481ca10935c9f808611987eecf8f5e0cf82f7b.600x338.jpg?t=1771320063"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/fcc824263f7eba1286f2786d70cd1dd27b0e0b45/ss_fcc824263f7eba1286f2786d70cd1dd27b0e0b45.1920x1080.jpg?t=1771320063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/fcc824263f7eba1286f2786d70cd1dd27b0e0b45/ss_fcc824263f7eba1286f2786d70cd1dd27b0e0b45.600x338.jpg?t=1771320063"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/1cf662732d2eb53a5a088b4b857b36494ca93b2a/ss_1cf662732d2eb53a5a088b4b857b36494ca93b2a.1920x1080.jpg?t=1771320063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/1cf662732d2eb53a5a088b4b857b36494ca93b2a/ss_1cf662732d2eb53a5a088b4b857b36494ca93b2a.600x338.jpg?t=1771320063"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/58d122be9c63ac9a39940c593d312c12123c927d/ss_58d122be9c63ac9a39940c593d312c12123c927d.1920x1080.jpg?t=1771320063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/58d122be9c63ac9a39940c593d312c12123c927d/ss_58d122be9c63ac9a39940c593d312c12123c927d.600x338.jpg?t=1771320063"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/e562d95a9bf191f52d4d5dbde1fa85759a43c113/ss_e562d95a9bf191f52d4d5dbde1fa85759a43c113.1920x1080.jpg?t=1771320063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/e562d95a9bf191f52d4d5dbde1fa85759a43c113/ss_e562d95a9bf191f52d4d5dbde1fa85759a43c113.600x338.jpg?t=1771320063"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/e6d8ad0bb3de2f1a7e73c82a5bb22eaf94af7748/ss_e6d8ad0bb3de2f1a7e73c82a5bb22eaf94af7748.1920x1080.jpg?t=1771320063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/e6d8ad0bb3de2f1a7e73c82a5bb22eaf94af7748/ss_e6d8ad0bb3de2f1a7e73c82a5bb22eaf94af7748.600x338.jpg?t=1771320063"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/a48871e0470e6160333c541e28a48917881ca5a4/ss_a48871e0470e6160333c541e28a48917881ca5a4.1920x1080.jpg?t=1771320063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/a48871e0470e6160333c541e28a48917881ca5a4/ss_a48871e0470e6160333c541e28a48917881ca5a4.600x338.jpg?t=1771320063"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/4954d914509da46f1a0d095e715b4f15dd2b1f5a/ss_4954d914509da46f1a0d095e715b4f15dd2b1f5a.1920x1080.jpg?t=1771320063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3216230/4954d914509da46f1a0d095e715b4f15dd2b1f5a/ss_4954d914509da46f1a0d095e715b4f15dd2b1f5a.600x338.jpg?t=1771320063"}],"short_description":"Meat Train is a FPS game where you operate a train thats uses MEAT for FUEL. Explore a wasteland where everything wants you dead, scavenge for weapons and loot. Upgrade the train and attempt to destroy an evil AI megafactory.","steam_appid":3216230,"support_info":{"email":"","url":"https://www.kiwiforgegames.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.kiwiforgegames.com"}