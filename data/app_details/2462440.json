2440/6d6e5574a44d5bfaa4a38ad105b27cbd1948f061/ss_6d6e5574a44d5bfaa4a38ad105b27cbd1948f061.600x338.jpg?t=1767683247"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/70fb61314a57368a9334cc723ded0dc389788497/ss_70fb61314a57368a9334cc723ded0dc389788497.1920x1080.jpg?t=1767683247","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/70fb61314a57368a9334cc723ded0dc389788497/ss_70fb61314a57368a9334cc723ded0dc389788497.600x338.jpg?t=1767683247"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/e6b5924399794d42dad4f1d7252be1ebc7966379/ss_e6b5924399794d42dad4f1d7252be1ebc7966379.1920x1080.jpg?t=1767683247","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/e6b5924399794d42dad4f1d7252be1ebc7966379/ss_e6b5924399794d42dad4f1d7252be1ebc7966379.600x338.jpg?t=1767683247"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/df80c0f49db8c89aa418b0d4370c4b620dbf111e/ss_df80c0f49db8c89aa418b0d4370c4b620dbf111e.1920x1080.jpg?t=1767683247","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/df80c0f49db8c89aa418b0d4370c4b620dbf111e/ss_df80c0f49db8c89aa418b0d4370c4b620dbf111e.600x338.jpg?t=1767683247"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/97b2ebc36ec1abb109d7633977490a14dcab2edd/ss_97b2ebc36ec1abb109d7633977490a14dcab2edd.1920x1080.jpg?t=1767683247","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/97b2ebc36ec1abb109d7633977490a14dcab2edd/ss_97b2ebc36ec1abb109d7633977490a14dcab2edd.600x338.jpg?t=1767683247"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/f863f8831beec098fc8738a44693a745927f8e53/ss_f863f8831beec098fc8738a44693a745927f8e53.1920x1080.jpg?t=1767683247","path_thumbnail":"