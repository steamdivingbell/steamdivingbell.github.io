_paragraph\"><strong>Single Player only.</strong></p><p class=\"bb_paragraph\"><strong>Made in Unreal Engine 5.4</strong></p>","developers":["HOLLOW"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2462440/49b2b8b6895cbae8899241bb589c3375ca736b4b/header.jpg?t=1745213196","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"name":"PHANTOM","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10, 64 Bit<br></li><li><strong>Processor:</strong> i5 9400F<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> RTX 2060 Super 6GB<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Additional Notes:</strong> 1080P Performance, 60FPS</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>DirectX:</strong> Version 12</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["HOLLOW"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia\nMedo\nAtos criminosos","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Horror\nAlkohol / Tabak","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamsta