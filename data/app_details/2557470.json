/steam/apps/2557470/8a7a2a633b3c3bbf71428e71a3ec8a9c964d5e9a/ss_8a7a2a633b3c3bbf71428e71a3ec8a9c964d5e9a.1920x1080.jpg?t=1761261263","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/8a7a2a633b3c3bbf71428e71a3ec8a9c964d5e9a/ss_8a7a2a633b3c3bbf71428e71a3ec8a9c964d5e9a.600x338.jpg?t=1761261263"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/0d3dca890ad719b9293fcbed5118a723cea3ef9a/ss_0d3dca890ad719b9293fcbed5118a723cea3ef9a.1920x1080.jpg?t=1761261263","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/0d3dca890ad719b9293fcbed5118a723cea3ef9a/ss_0d3dca890ad719b9293fcbed5118a723cea3ef9a.600x338.jpg?t=1761261263"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/e7b48aa84df8e7e8eabd0f7a0b83beaf8f0cadf3/ss_e7b48aa84df8e7e8eabd0f7a0b83beaf8f0cadf3.1920x1080.jpg?t=1761261263","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/e7b48aa84df8e7e8eabd0f7a0b83beaf8f0cadf3/ss_e7b48aa84df8e7e8eabd0f7a0b83beaf8f0cadf3.600x338.jpg?t=1761261263"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/41383c06e87c811081ca087369302469c3e5ab13/ss_41383c06e87c811081ca087369302469c3e5ab13.1920x1080.jpg?t=1761261263","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/41383c06e87c811081ca087369302469c3e5ab13/ss_41383c06e87c811081ca087369302469c3e5ab13.600x338.jpg?t=1761261263"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/0e9e97af97689882d7b52105b070e063adaf2810/ss_0e9e97af97689882d7b52105b070e063adaf2810.1920x1080.jpg?t=1761261263","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/0e9e97af97689882d7b52105b070e063adaf2810/ss_0e9e97af97689882d7b52105b070e063adaf2810.600x338.jpg?t=1761261263"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/6106b1a58b2eef7ceb499ef1455c0fcfa95bb917/ss_6106b1a58b2eef7ceb499ef1455c0fcfa95bb917.1920x1080.jpg?t=1761261263","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557470/6106b1a58b2eef7ceb499ef1455c0fcfa95bb917/ss_6106b1a58b2eef7ceb499ef1455c0fcfa95bb917.600x338.jpg?t=1761261263"}],"short_description":"You are a soul lost in the Drift. Weaponize your momentum to defeat the greater demons and the devil ending your cyclical hell. Explore a procedural map, collect new weapons and escape to the hub to stash your loot. Pack your knapsack carefully! If you die you'll loose everything you brought.","steam_appid":2557470,"support_info":{"email":"Contact@EvilVillainGames.com","url":"https://evilvillaingames.com/"},"supported_languages":"English","type":"game","website":"https://evilvillaingames.com/"}