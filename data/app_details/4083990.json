ve your fading beloved wife.","steam_appid":4083990,"support_info":{"email":"ongayhan@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Turkish, German, Portuguese - Brazil, Spanish - Latin America<br><strong>*</strong>languages with full audio support","type":"game","website":null}