0928d9ffc009e921178a95e47c.webm?t=1749588546\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566430/extras/e281d90928d9ffc009e921178a95e47c.mp4?t=1749588546\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><u>Shockwave</u></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566430/extras/b83c05e21f8a534120a2d1e580455513.poster.avif?t=1749588546\" width=380 height=222 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566430/extras/b83c05e21f8a534120a2d1e580455513.webm?t=1749588546\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566430/extras/b83c05e21f8a534120a2d1e580455513.mp4?t=1749588546\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><u>Freeze</u></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566430/extras/6edc98665e90b6d4ccde02140144d34d.poster.avif?t=1749588546\" width=380 height=222 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566430/extras/6edc98665e90b6d4ccde02140144d34d.webm?t=1749588546\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566430/extras/6edc98665e90b6d4ccde02140144d34d.mp4?t=1749588546\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features:</strong></p><p class=\"bb_paragraph\" >\u2022 <strong>Power Ups</strong>\u2013 Equip special attacks like <strong>Freeze</strong>, <strong>Bomb</strong>, and <strong>Shockwave</strong></p><p class=\"bb_paragraph\" >\u2022 <strong>Kill Streaks</strong> \u2013 Your character will <i>overclock</i> <strong>Speed</strong>, <strong>Attack</strong>, and <strong>Health</strong> with each killstreak achieved; culminating in a <strong>Super Mode</strong></p><p class=\"bb_paragraph\" >\u2022 <strong>Skill Trees </strong>\u2013 Customize your play style by choosing which upgrades to spend your skill points on: Speed, Health, or Attack</p><p class=\"bb_paragraph\" >\u2022 <strong>Global Leaderboards</strong> \u2013 Track your progress and rise through the ranks</p><p class=\"bb_paragraph\" >\u2022 <strong>Practice Offline</strong> \u2013 Test your bot before going live</p><p class=\"bb_paragraph\" >\u2022 <strong>Choose Your Language</strong> \u2013 Program in your preferred coding language or use the built in Javascript editor</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Whether you\u2019re a beginner or a seasoned coder, <strong>Botomy</strong> is a challenging new way to apply your programming skills. The best strategy wins.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Can your bot reach level 30?</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Dev Environment Info: </strong>The built in language support is javascript but you can spin up your own custom local development environments in any language.</p>","developers":["Brokkli Labs LLC"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566430/e1309982c1d39b89ab6e36d8832d1d547d3d54b0/header.jpg?t=1749588546","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Linux distribution released after 2016<br></li><li><strong>Processor:</strong> x86_64 CPU<br></li><li><strong>Memory:</strong> 2 GB RAM<br><