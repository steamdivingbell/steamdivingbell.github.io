ai.steamstatic.com/store_item_assets/steam/apps/4138820/c77b9bf83d6b104ed5d72e194d5b16213d3e5840/ss_c77b9bf83d6b104ed5d72e194d5b16213d3e5840.600x338.jpg?t=1768146047"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4138820/c97f1c17b053a73235ab0a3b78d701d3fcebfe07/ss_c97f1c17b053a73235ab0a3b78d701d3fcebfe07.1920x1080.jpg?t=1768146047","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4138820/c97f1c17b053a73235ab0a3b78d701d3fcebfe07/ss_c97f1c17b053a73235ab0a3b78d701d3fcebfe07.600x338.jpg?t=1768146047"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4138820/b5a370c6ab37d4361d9c837b14a18c77af45964c/ss_b5a370c6ab37d4361d9c837b14a18c77af45964c.1920x1080.jpg?t=1768146047","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4138820/b5a370c6ab37d4361d9c837b14a18c77af45964c/ss_b5a370c6ab37d4361d9c837b14a18c77af45964c.600x338.jpg?t=1768146047"}],"short_description":"Cleanse the system of pirates, destroy their bases and free the captives. On the asteroids, build a base, mining colonies, explore asteroids and extract resources needed for survival. Develop buildings, build defenses and turn the asteroid into a fortress.","steam_appid":4138820,"support_info":{"email":"info@euromazury.pl","url":""},"supported_languages":"English, Polish, French, German, Spanish - Spain, Simplified Chinese, Japanese, Portuguese - Brazil","type":"game","website":null}