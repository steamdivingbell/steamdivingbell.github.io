id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3672210/158edbe94ebc9c8a4a962895ac6ccb2b747f0721/ss_158edbe94ebc9c8a4a962895ac6ccb2b747f0721.1920x1080.jpg?t=1754355688","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3672210/158edbe94ebc9c8a4a962895ac6ccb2b747f0721/ss_158edbe94ebc9c8a4a962895ac6ccb2b747f0721.600x338.jpg?t=1754355688"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3672210/ceb44fc020ea7fa91eaf0e7d628dd74164ac66c6/ss_ceb44fc020ea7fa91eaf0e7d628dd74164ac66c6.1920x1080.jpg?t=1754355688","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3672210/ceb44fc020ea7fa91eaf0e7d628dd74164ac66c6/ss_ceb44fc020ea7fa91eaf0e7d628dd74164ac66c6.600x338.jpg?t=1754355688"}],"short_description":"Step into the shadows of Contraria, solve 3D puzzles and collect ProtoCores while crew logs whisper from another time\u2014or maybe another reality. Keep solving. Keep looping. Until the final room. The Answer\u2026 or just another Question.","steam_appid":3672210,"support_info":{"email":"hello@hellyeah.jp","url":"hellyeah.jp"},"supported_languages":"English","type":"game","website":null}