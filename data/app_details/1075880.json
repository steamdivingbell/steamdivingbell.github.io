a95c4878/ss_1896341bd16c6f936b3d633a8ec6afe4a95c4878.1920x1080.jpg?t=1768323807","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1075880/1896341bd16c6f936b3d633a8ec6afe4a95c4878/ss_1896341bd16c6f936b3d633a8ec6afe4a95c4878.600x338.jpg?t=1768323807"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1075880/63dcd184bc03df80ca510ad8e139449c2c09adf1/ss_63dcd184bc03df80ca510ad8e139449c2c09adf1.1920x1080.jpg?t=1768323807","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1075880/63dcd184bc03df80ca510ad8e139449c2c09adf1/ss_63dcd184bc03df80ca510ad8e139449c2c09adf1.600x338.jpg?t=1768323807"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1075880/a7438b6e449a0392a71aa620777286003e50d0b2/ss_a7438b6e449a0392a71aa620777286003e50d0b2.1920x1080.jpg?t=1768323807","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1075880/a7438b6e449a0392a71aa620777286003e50d0b2/ss_a7438b6e449a0392a71aa620777286003e50d0b2.600x338.jpg?t=1768323807"}],"short_description":"Elemental Brawl is a multiplayer party game for everyone who likes to beat up their friends (in a good way!) with the power of the elements! Compete across interactive arenas, mix and match elements for new and exciting attacks, and use them to bring even more excitement into other players' lives!","steam_appid":1075880,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English<strong>*</strong>, Portuguese - Brazil<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://elementalbrawl.com/"}