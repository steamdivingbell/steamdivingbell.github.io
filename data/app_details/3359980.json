mai.steamstatic.com/store_item_assets/steam/apps/3359980/ss_c4e2c838b7c60c66c45478f0e7a9199e0e69a244.600x338.jpg?t=1743189838"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3359980/ss_b669578bdd4a44a51a753420167a7172bfb1067f.1920x1080.jpg?t=1743189838","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3359980/ss_b669578bdd4a44a51a753420167a7172bfb1067f.600x338.jpg?t=1743189838"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3359980/ss_6b36514580a420c07a729a86334f7a63cc7e3e74.1920x1080.jpg?t=1743189838","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3359980/ss_6b36514580a420c07a729a86334f7a63cc7e3e74.600x338.jpg?t=1743189838"}],"short_description":"Create a galaxy with individual solar systems and provide each with rich detail, history, and visual styles with Stellar Navigator. Set up visually stunning dioramas of your solar systems and define each celestial body, moon, asteroid, or even black hole with information that makes each unique.","steam_appid":3359980,"support_info":{"email":"support@stellar-navigator.com","url":""},"supported_languages":"English","type":"game","website":"https://www.stellar-navigator.com/"}