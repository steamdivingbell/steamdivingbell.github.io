.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/3624a5f0d9ad7fc26e6edaa22cdd9d07d6b9fb9b/page_bg_raw.jpg?t=1752771237","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/2b0365e36dd94082c1ffab899400148aae48da5a/capsule_231x87.jpg?t=1752771237","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/2b0365e36dd94082c1ffab899400148aae48da5a/capsule_184x69.jpg?t=1752771237","categories":[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Camera Comfort","id":67},{"description":"Custom Volume Controls","id":68},{"description":"Playable without Timed Input","id":74},{"description":"Stereo Sound","id":69},{"description":"Subtitle Options","id":65},{"description":"Partial Controller Support","id":18},{"description":"Steam Cloud","id":23},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"detailed_description":"<p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/extras/59c5a4b6b2b65839d1c567c422f200a7.poster.avif?t=1752771237\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/extras/59c5a4b6b2b65839d1c567c422f200a7.webm?t=1752771237\" type=\"video/webm\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/extras/59c5a4b6b2b65839d1c567c422f200a7.mp4?t=1752771237\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Are you fascinated by Egyptian history and mythology?</p><p class=\"bb_paragraph\">Some legends may be closer to the truth than we think. What if they were real? What if the ancient gods of Egypt were never truly gone\u2014but merely forgotten? And worse\u2026 what if they never forgot us?</p><p class=\"bb_paragraph\">we set out to explore these questions in a haunting journey through lost temples, buried secrets, and the thin veil between myth and reality.</p><p class=\"bb_paragraph\">The forgotten gods of Ancient Egypt are stirring once again.</p><p class=\"bb_paragraph\">In <strong>The Third</strong>, you play as an archaeologist trapped inside a mysterious temple where ancient forces awaken. With realistic graphics and a haunting atmosphere, this immersive horror adventure will pull you deep into a world of lost rituals and eternal darkness. As Osiris and Isis reclaim their forms, only one soul remains\u2014their son Horus. Will you become the third? The Third delivers a gripping story, terrifying moments, and intense exploration you won\u2019t forget.</p><p class=\"bb_paragraph\">Uncover ancient secrets, read the forgotten notes of those who came before you, and piece together the terrifying truth. Use your flashlight and an old camera to navigate cursed corridors, solve puzzles, and survive. Every step you take brings you closer to the shadows\u2026 and to your fate.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/extras/2f14025abe5af0a84253f6d580855fe0.poster.avif?t=1752771237\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/extras/2f14025abe5af0a84253f6d580855fe0.webm?t=1752771237\" type=\"video/webm\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/extras/2f14025abe5af0a84253f6d580855fe0.mp4?t=1752771237\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3877870/extras/c744788197c347483946d30d766d9225.poster.avif?t=1752771237\" ><source src=\"https://shared.akam