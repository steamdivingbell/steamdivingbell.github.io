static.com/store_item_assets/steam/apps/3917840/725a50aa1219c0797538be93dd8559319fd90120/ss_725a50aa1219c0797538be93dd8559319fd90120.1920x1080.jpg?t=1761407519","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3917840/725a50aa1219c0797538be93dd8559319fd90120/ss_725a50aa1219c0797538be93dd8559319fd90120.600x338.jpg?t=1761407519"}],"short_description":"The continuation of the Shaolin vs Wutang series, this game is yet another indie love letter to martial arts and classic Kung Fu films. Designed for casual gaming fans, it\u2019s not aimed at hardcore fighting game players.","steam_appid":3917840,"support_info":{"email":"jaeleejb@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Spanish - Spain, Simplified Chinese, Traditional Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}