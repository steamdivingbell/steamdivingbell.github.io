","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3976500/07158cbe1a4cbcf373536aa951a1673bedb750e5/header.jpg?t=1774588928","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3976500/1154961704/6549b07c18957d02969095053d2e3f522bbe92c5/1774519702/dash_av1.mpd?t=1774526674","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3976500/1154961704/6549b07c18957d02969095053d2e3f522bbe92c5/1774519702/dash_h264.mpd?t=1774526674","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3976500/1154961704/6549b07c18957d02969095053d2e3f522bbe92c5/1774519702/hls_264_master.m3u8?t=1774526674","id":257309379,"name":"Launch Date Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257309379/dfdbc726712b1f87ca9c2a97dd4ae39c1e3ba447/movie_600x337.jpg?t=1774526674"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3976500/1694827420/60c20ccd4e97301cfb5dbd0b9c113f207b0875f0/1771504486/dash_av1.mpd?t=1771513364","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3976500/1694827420/60c20ccd4e97301cfb5dbd0b9c113f207b0875f0/1771504486/dash_h264.mpd?t=1771513364","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3976500/1694827420/60c20ccd4e97301cfb5dbd0b9c113f207b0875f0/1771504486/hls_264_master.m3u8?t=1771513364","id":257290044,"name":"Demo Launch Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257290044/9f1119e1a19bd36b6c953b49fa33165143443189/movie_600x337.