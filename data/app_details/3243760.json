ared.akamai.steamstatic.com/store_item_assets/steam/apps/3243760/54855377b76adbb4ee5c8360fd9374317db01824/ss_54855377b76adbb4ee5c8360fd9374317db01824.600x338.jpg?t=1745306337"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3243760/ss_961bddb2fb54b9f12d7c90676110327c238bcb20.1920x1080.jpg?t=1745306337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3243760/ss_961bddb2fb54b9f12d7c90676110327c238bcb20.600x338.jpg?t=1745306337"}],"short_description":"Doloc Town is a cozy pixel art farm simulation game set in a post-apocalyptic world. Build your dream farm from scratch and explore this mysterious wasteland. Harvest, plant, build, and discover the untold stories of this forgotten land!","steam_appid":3243760,"support_info":{"email":"doloctown@logoi.net","url":""},"supported_languages":"Simplified Chinese, English","type":"demo","website":null}