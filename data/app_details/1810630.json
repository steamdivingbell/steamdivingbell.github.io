ts/steam/apps/1810630/1576cf105787ebb4a5f681829304195b420c706a/ss_1576cf105787ebb4a5f681829304195b420c706a.1920x1080.jpg?t=1740704666","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/1576cf105787ebb4a5f681829304195b420c706a/ss_1576cf105787ebb4a5f681829304195b420c706a.600x338.jpg?t=1740704666"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/9f786f78f58b9f0b6350433ed4161c4c51c66423/ss_9f786f78f58b9f0b6350433ed4161c4c51c66423.1920x1080.jpg?t=1740704666","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/9f786f78f58b9f0b6350433ed4161c4c51c66423/ss_9f786f78f58b9f0b6350433ed4161c4c51c66423.600x338.jpg?t=1740704666"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/353c0e328b0d833fdee0c5043fa9ba6cca66d84a/ss_353c0e328b0d833fdee0c5043fa9ba6cca66d84a.1920x1080.jpg?t=1740704666","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/353c0e328b0d833fdee0c5043fa9ba6cca66d84a/ss_353c0e328b0d833fdee0c5043fa9ba6cca66d84a.600x338.jpg?t=1740704666"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/67693289694f8480cb198ba91b43bb99db219c9f/ss_67693289694f8480cb198ba91b43bb99db219c9f.1920x1080.jpg?t=1740704666","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/67693289694f8480cb198ba91b43bb99db219c9f/ss_67693289694f8480cb198ba91b43bb99db219c9f.600x338.jpg?t=1740704666"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/1284d169fb42dafdc06cc869ee02b889bcf8d552/ss_1284d169fb42dafdc06cc869ee02b889bcf8d552.1920x1080.jpg?t=1740704666","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/1284d169fb42dafdc06cc869ee02b889bcf8d552/ss_1284d169fb42dafdc06cc869ee02b889bcf8d552.600x338.jpg?t=1740704666"}],"short_description":"Lokko is a bouncy, action-packed 3D platformer where YOU create the adventure! In Lokko, players race to deliver hot pizzas around the globe while battling the sinister Goobol fast-food corporation.","steam_appid":1810630,"support_info":{"email":"support@appymonkeys.com","url":"https://www.lokko.com/contact-us"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.lokko.com/"}