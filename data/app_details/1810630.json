0/extras/892bf6f493a68f4f3776783acc39349e.webp?t=1768540104\" width=600 height=47 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/extras/d583dcae206664e75f3588f44420b268.webp?t=1768540104\" width=600 height=30 /></span></p><p class=\"bb_paragraph\" >   <br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/extras/794d570ee9876962a817530eebf08eee.poster.avif?t=1768540104\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/extras/794d570ee9876962a817530eebf08eee.webm?t=1768540104\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/extras/794d570ee9876962a817530eebf08eee.mp4?t=1768540104\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Local 2 Player mode with Controllers</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/extras/892bf6f493a68f4f3776783acc39349e.webp?t=1768540104\" width=600 height=47 /></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/extras/22dc84e4f0340b347ee78c7a7e28ba09.webp?t=1768540104\" width=600 height=30 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/extras/51e8f5474f468c5b1c74aa504a49da6d.poster.avif?t=1768540104\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1810630/extras/51e8f5474f468c5b1c74aa504a49da6d.webm?t=1768540104\"