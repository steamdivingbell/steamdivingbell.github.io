ets/steam/apps/3842300/4183ff6b0b6cebf071d38ebc0a783a0f73a61cca/ss_4183ff6b0b6cebf071d38ebc0a783a0f73a61cca.600x338.jpg?t=1751375374"}],"short_description":"Build your infernal domain by strategically placing hell structures from cards. Master synergistic placement to earn Souls, unlock new buildings, and complete the Dark Lord's vision. When resources run low, Transmute Hell for powerful relics and begin anew in this roguelike city builder.","steam_appid":3842300,"support_info":{"email":"thegamewhatever@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}