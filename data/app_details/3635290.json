0x338.jpg?t=1747360883"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3635290/c3f335c48c346416278286e30ec79dbce87420d4/ss_c3f335c48c346416278286e30ec79dbce87420d4.1920x1080.jpg?t=1747360883","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3635290/c3f335c48c346416278286e30ec79dbce87420d4/ss_c3f335c48c346416278286e30ec79dbce87420d4.600x338.jpg?t=1747360883"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3635290/9bf395d210fecb68258e42b7dca337947ebef386/ss_9bf395d210fecb68258e42b7dca337947ebef386.1920x1080.jpg?t=1747360883","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3635290/9bf395d210fecb68258e42b7dca337947ebef386/ss_9bf395d210fecb68258e42b7dca337947ebef386.600x338.jpg?t=1747360883"}],"short_description":"Gaze upon the moon-filled skies of the Jovian system and drive absurdly long distances across the Galilean moons of Jupiter! The routes themselves are easy, but the distances are not!","steam_appid":3635290,"support_info":{"email":"","url":"https://bsky.app/profile/caseyfromspace.bsky.social"},"supported_languages":"English","type":"game","website":null}