tps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2434600/63d99cb027afd17a66c43deb14e63d6077c8c6ab/ss_63d99cb027afd17a66c43deb14e63d6077c8c6ab.600x338.jpg?t=1764249680"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2434600/19d36a18c7bc1519647ba52953b27ea445164fdf/ss_19d36a18c7bc1519647ba52953b27ea445164fdf.1920x1080.jpg?t=1764249680","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2434600/19d36a18c7bc1519647ba52953b27ea445164fdf/ss_19d36a18c7bc1519647ba52953b27ea445164fdf.600x338.jpg?t=1764249680"}],"short_description":"ShantyTown is a relaxing diorama-building game about finding beauty in everyday chaos. Bring new locations to life, stack your urban buildings high, and fill each little nook and cranny with your own touch. Even messiness has its own little charm.","steam_appid":2434600,"support_info":{"email":"Erik@SilkSoftworks.com","url":"https://www.silksoftworks.com/"},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Spanish - Latin America, Traditional Chinese","type":"game","website":"https://www.silksoftworks.com/"}