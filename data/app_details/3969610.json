e4e2b5f0cccc25/ss_56ca96046c80562bf93b7eac5de4e2b5f0cccc25.1920x1080.jpg?t=1758836460","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3969610/56ca96046c80562bf93b7eac5de4e2b5f0cccc25/ss_56ca96046c80562bf93b7eac5de4e2b5f0cccc25.600x338.jpg?t=1758836460"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3969610/2dfd752b5950cc80e67f20c5c870315f12d75071/ss_2dfd752b5950cc80e67f20c5c870315f12d75071.1920x1080.jpg?t=1758836460","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3969610/2dfd752b5950cc80e67f20c5c870315f12d75071/ss_2dfd752b5950cc80e67f20c5c870315f12d75071.600x338.jpg?t=1758836460"}],"short_description":"An adventure game with crafting and transformations about a devil in the service of Peter the Great. Play as a little imp - trick, lie, steal and cheat in order to get your way and move up the ladder!","steam_appid":3969610,"support_info":{"email":"support@babayagagames.ru","url":""},"supported_languages":"English<strong>*</strong>, Russian<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://babayagagames.ru/"}