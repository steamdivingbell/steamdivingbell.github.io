uths buried within the depths of this eerie abode. <br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3633250/extras/2e6de5d710d06152e01e31b41d69438b.poster.avif?t=1761874623\" width=614 height=346 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3633250/extras/2e6de5d710d06152e01e31b41d69438b.webm?t=1761874623\" type=\"video/webm; codecs=vp9\"></video></span></p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["SOFTSTAR ENTERTAINMENT"],"genres":[{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3633250/df13e848370ffc44aa190191d6e587c7ebf18fe0/header.jpg?t=1761874623","is_free":false,"legal_notice":"\u00a9 2024-2025 SOFTSTAR ENTERTAINMENT INC. All rights reserved.<br />\r\n\u00a9 JI/Asahi Shimbun Publications, Junji Ito Maniac Production Committee","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3633250/1205894335/964b7c1ae3ee1833cb8424bd498ba92ef8189892/1761804161/dash_av1.mpd?t=1761807107","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3633250/1205894335/964b7c1ae3ee1833cb8424bd498ba92ef8189892/1761804161/dash_h264.mpd?t=1761807107","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3633250/1205894335/964b7c1ae3ee1833cb8424bd498ba92ef8189892/1761804161/hls_264_master.m3u8?t=1761807107","id":257224480,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257224480/movie480.mp4?t=1761807107","max":"https://video.