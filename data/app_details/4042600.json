egendary artefacts and make your adventure unforgettable.</p>","developers":["Bart Mamzer"],"genres":[{"description":"Casual","id":"4"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4042600/fb26b97b0041b1f2155067f174574b10e125366f/header.jpg?t=1759338040","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4042600/1199968815/fb22c91cab7d627bd3d1c0d46df9fb2878e8244e/1758184333/dash_av1.mpd?t=1758623080","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4042600/1199968815/fb22c91cab7d627bd3d1c0d46df9fb2878e8244e/1758184333/dash_h264.mpd?t=1758623080","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4042600/1199968815/fb22c91cab7d627bd3d1c0d46df9fb2878e8244e/1758184333/hls_264_master.m3u8?t=1758623080","id":257200418,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257200418/movie480.mp4?t=1758623080","max":"https://video.akamai.steamstatic.com/store_trailers/257200418/movie_max.mp4?t=1758623080"},"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257200418/3d660214d8e657563409ba6f52d5b160dc7f5afb/movie_600x337.jpg?t=1758623080","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257200418/movie480_vp9.webm?t=1758623080","max":"https://video.akamai.steamstatic.com/store_trailers/257200418/movie_max_vp9.webm?t=1758623080"}}],"name":"Arcane Plunder","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-