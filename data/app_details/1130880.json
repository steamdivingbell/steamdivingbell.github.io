gn] with 21 missions to fly<br></li><li>Choose your ship and weapons based on missions requirements<br></li><li>Steam Workshop support for missions with built-in Level Editor<br></li><li>2 wave-based game modes with Steam Leaderboards.</li></ul><br>Play Absolute Territory today.","developers":["Digitum Software"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1130880/header.jpg?t=1762858186","is_free":false,"legal_notice":"Absolute Territory\u2122","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1130880/357222/19f0d3855dee1b67e8435704b93256619ad18bae/1751192791/dash_av1.mpd?t=1617012995","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1130880/357222/19f0d3855dee1b67e8435704b93256619ad18bae/1751192791/dash_h264.mpd?t=1617012995","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1130880/357222/19f0d3855dee1b67e8435704b93256619ad18bae/1751192791/hls_264_master.m3u8?t=1617012995","id":256827792,"name":"Absolute Territory Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256827792/movie.293x165.jpg?t=1617012995"}],"name":"Absolute Territory","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Absolute Territory - $9.99 USD","packageid":3843