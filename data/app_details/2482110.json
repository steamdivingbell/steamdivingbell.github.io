m/store_item_assets/steam/apps/2482110/extras/d6236eb7ce54de66272f6d2ea4e42089.webm?t=1757070086\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/extras/d6236eb7ce54de66272f6d2ea4e42089.mp4?t=1757070086\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >As a nice side effect, they will help you maintain your mech and produce ammunition. If you find some raw materials. And machinery. And fuel to operate them. There is a lot to do.  <br><strong><i>Better get going.</i></strong> </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>Note: This game is played with mouse and keyboard. Controller support may be added at a later date.</i></p>","developers":["Sinking Dutchman"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/59a73053533b0b1d8c2b8911ae1bc03ff899408a/header.jpg?t=1757070086","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257175332,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257175332/movie480.mp4?t=1754034173","max":"http://video.akamai.steamstatic.com/store_trailers/257175332/movie_max.mp4?t=1754034173"},"name":"Rogue Mech","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257175332/af4b9a1329ce5ba3eddaeb781ad21b6e20333288/movie_600x337.jpg?t=1754034173","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257175332/movie480_vp9.webm?t=1754034173","max":"http://video.akamai.steamstatic.com/store_trailers/257175332/movie_max_vp9.webm?t=1754034173"}}],"name":"Rogue Mech","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Haswell 2 cores / 4 threads @ 2.5Ghz or equivalent<br></li><li><strong>Memory:</s