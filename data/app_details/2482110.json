0da58a38d54c382168c441469e40.600x338.jpg?t=1772315698"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/3623a5bedcddde23f6de2527167a2a1f2245f1b0/ss_3623a5bedcddde23f6de2527167a2a1f2245f1b0.1920x1080.jpg?t=1772315698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/3623a5bedcddde23f6de2527167a2a1f2245f1b0/ss_3623a5bedcddde23f6de2527167a2a1f2245f1b0.600x338.jpg?t=1772315698"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/cc6034216396c8e5cbfe2c37d73b90af108efecc/ss_cc6034216396c8e5cbfe2c37d73b90af108efecc.1920x1080.jpg?t=1772315698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/cc6034216396c8e5cbfe2c37d73b90af108efecc/ss_cc6034216396c8e5cbfe2c37d73b90af108efecc.600x338.jpg?t=1772315698"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/b81041e3746f90cd2e17d6ad2580f863b8255376/ss_b81041e3746f90cd2e17d6ad2580f863b8255376.1920x1080.jpg?t=1772315698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/b81041e3746f90cd2e17d6ad2580f863b8255376/ss_b81041e3746f90cd2e17d6ad2580f863b8255376.600x338.jpg?t=1772315698"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/73acb0db2b4a2d141ed8d82a04257bbcdbc5923f/ss_73acb0db2b4a2d141ed8d82a04257bbcdbc5923f.1920x1080.jpg?t=1772315698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/73acb0db2b4a2d141ed8d82a04257bbcdbc5923f/ss_73acb0db2b4a2d141ed8d82a04257bbcdbc5923f.600x338.jpg?t=1772315698"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/cfca26369057a85f3ed4fd87367e98cc0814d821/ss_cfca26369057a85f3ed4fd87367e98cc0814d821.1920x1080.jpg?t=1772315698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/cfca26369057a85f3ed4fd87367e98cc0814d821/ss_cfca26369057a85f3ed4fd87367e98cc0814d821.600x338.jpg?t=1772315698"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/11798cb488bee77dc4c760905e4a78fb09c5a5ce/ss_11798cb488bee77dc4c760905e4a78fb09c5a5ce.1920x1080.jpg?t=1772315698","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2482110/11798cb488bee77dc4c760905e4a78fb09c5a5ce/ss_11798cb488bee77dc4c760905e4a78fb09c5a5ce.600x338.jpg?t=1772315698"}],"short_description":"A unique blend of Mech and survival gameplay in a post-apocalyptic world. Scavenge for supplies, upgrade your Mech, build a base, farm, hack, barter, and forge alliances. Break free from the oppression of a ruthless general and become the spearhead for a better world in this action-packed adventure.","steam_appid":2482110,"support_info":{"email":"mail@sinkingdutchman.com","url":"http://www.sinkingdutchman.com"},"supported_languages":"English, German, Simplified Chinese, Russian, Japanese","type":"game","website":null}