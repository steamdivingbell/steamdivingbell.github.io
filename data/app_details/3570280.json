ai.steamstatic.com/store_item_assets/steam/apps/3570280/fb8cd0d5a894dab9b7689e6f05a44a90b51ae1c6/ss_fb8cd0d5a894dab9b7689e6f05a44a90b51ae1c6.600x338.jpg?t=1747660164"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570280/27aca86d5b9d11e163cdac463eef6b0454ea5679/ss_27aca86d5b9d11e163cdac463eef6b0454ea5679.1920x1080.jpg?t=1747660164","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570280/27aca86d5b9d11e163cdac463eef6b0454ea5679/ss_27aca86d5b9d11e163cdac463eef6b0454ea5679.600x338.jpg?t=1747660164"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570280/41f71d3f5f58fe4f55a362253f5af1db648b209c/ss_41f71d3f5f58fe4f55a362253f5af1db648b209c.1920x1080.jpg?t=1747660164","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570280/41f71d3f5f58fe4f55a362253f5af1db648b209c/ss_41f71d3f5f58fe4f55a362253f5af1db648b209c.600x338.jpg?t=1747660164"}],"short_description":"Upfall is a game about bouncing, dodging, and near death experiences. Burst bubbles to progress upwards, but be careful to dodge the hazards in the depths. How far will your upfall be? A free game for the in betweens.","steam_appid":3570280,"support_info":{"email":"","url":"https://www.amicableanimal.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.amicableanimal.com/"}