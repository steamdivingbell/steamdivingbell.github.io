ragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3400300/extras/2025_MAIO_GIF_MADORA_4.gif?t=1748895798\" /></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><strong>Create builds like never before.</strong> With a system of active and passive skills that allows for over 100,000 combinations, Madora is a feast for those who love experimentation. Experience a new adventure with each playthrough, enjoying the best of the roguelite genre as you face armies of darkness and try to free the world of Madora from chaos.</p><p class=\"bb_paragraph\"></p>","developers":["Jabutkba Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3400300/9b22aa0d60568b90530fe175ac62a3fcc09943ee/header.jpg?t=1748895798","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257150004,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257150004/movie480.mp4?t=1748895718","max":"http://video.akamai.steamstatic.com/store_trailers/257150004/movie_max.mp4?t=1748895718"},"name":"Demo eng","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257150004/7280900beb8022655c81897423b9fdf89065beb1/movie_600x337.jpg?t=1748895718","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257150004/movie480_vp9.webm?t=1748895718","max":"http://video.akamai.steamstatic.com/store_trailers/257150004/movie_max_vp9.webm?t=1748895718"}}],"name":"Madora","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> I3 - 6100<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</str