om/store_item_assets/steam/apps/3102250/5d9720093c7755b79d69a5869dd628d782547b16/ss_5d9720093c7755b79d69a5869dd628d782547b16.600x338.jpg?t=1772105866"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3102250/ss_6abcff58db3ee67353d118f150343f560e9d54e6.1920x1080.jpg?t=1772105866","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3102250/ss_6abcff58db3ee67353d118f150343f560e9d54e6.600x338.jpg?t=1772105866"}],"short_description":"KOVOCLAK is a hand-drawn 2D platformer set in a strange, poetic, and musical universe. Created by Lingouf, an electronic music producer and artist. No weapons here \u2014 only a watering can, an umbrella\u2026 and a boombox. You just have to find the right frequency\u00a0!","steam_appid":3102250,"support_info":{"email":"lingouf@lingouf.org","url":"https://lingouf.org"},"supported_languages":"French, English, Italian, German, Spanish - Spain, Spanish - Latin America, Indonesian, Dutch, Polish, Portuguese - Brazil, Portuguese - Portugal, Arabic, Simplified Chinese, Russian","type":"game","website":"https://lingouf.org"}