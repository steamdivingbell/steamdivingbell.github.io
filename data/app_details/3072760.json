c":false,"windows":true},"price_overview":{"currency":"USD","discount_percent":0,"final":999,"final_formatted":"$9.99 USD","initial":999,"initial_formatted":""},"publishers":["HistoryXPlorer"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":false,"date":"5 Jan, 2026"},"required_age":0,"reviews":"\u201cRetro Relics is a relatively short but satisfying game that felt as though I was having a conversation with the developer, enthusing about their passion for metal detecting. Overall, I enjoyed learning about the metal detecting hobby as I searched for buried items, built up my collection, and ultimately completed grandpa\u2019s final request.\u201d<br>8/9 \u2013 LadiesGamers<br><br>\u201cThere\u2019s something strangely comforting about slow discoveries. Retro Relics leans into that feeling completely: the soft crunch of footsteps on grass, the gentle beep of a metal detector, and the small thrill of uncovering something forgotten beneath the soil. It isn\u2019t loud, flashy, or urgent, and that\u2019s exactly the point. Retro Relics invites you to take your time, wander through nature, and see what stories might be hiding in the dirt.\u201d<br>ScreenHype<br>","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3072760/43f1a8b142b984a640c4d0c3a31fa2e9ce18b5ce/ss_43f1a8b142b984a640c4d0c3a31fa2e9ce18b5ce.1920x1080.jpg?t=1767807975","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3072760/43f1a8b142b984a640c4d0c3a31fa2e9ce18b5ce/ss_43f1a8b142b984a640c4d0c3a31fa2e9ce18b5ce.600x338.jpg?t=1767807975"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3072760/a8a27ba91cdbb2badd555b91407583cf1ae93961/ss_a8a27ba91cdbb2badd555b914