rld!","steam_appid":3976130,"support_info":{"email":"vsairegames@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Arabic, Simplified Chinese, Portuguese - Brazil, Dutch, Japanese, Korean, Spanish - Latin America, Portuguese - Portugal, Russian, Turkish, Polish","type":"game","website":null}