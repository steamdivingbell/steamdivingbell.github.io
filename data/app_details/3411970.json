mai.steamstatic.com/store_item_assets/steam/apps/3411970/1f1eb58264c7c31070dd352a2c2b9db7cf99515e/ss_1f1eb58264c7c31070dd352a2c2b9db7cf99515e.600x338.jpg?t=1764672235"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/2d81123737aa8074e613489384d7fd4e15354a37/ss_2d81123737aa8074e613489384d7fd4e15354a37.1920x1080.jpg?t=1764672235","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/2d81123737aa8074e613489384d7fd4e15354a37/ss_2d81123737aa8074e613489384d7fd4e15354a37.600x338.jpg?t=1764672235"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/fb337d1c58371021d0321bfc987eb19064696627/ss_fb337d1c58371021d0321bfc987eb19064696627.1920x1080.jpg?t=1764672235","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/fb337d1c58371021d0321bfc987eb19064696627/ss_fb337d1c58371021d0321bfc987eb19064696627.600x338.jpg?t=1764672235"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/660373f4fee1d3932093b06ddd27dea6a1fd65c5/ss_660373f4fee1d3932093b06ddd27dea6a1fd65c5.1920x1080.jpg?t=1764672235","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/660373f4fee1d3932093b06ddd27dea6a1fd65c5/ss_660373f4fee1d3932093b06ddd27dea6a1fd65c5.600x338.jpg?t=1764672235"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/7541b3a2288eb9302bfcfb97d90df8e8d75ce731/ss_7541b3a2288eb9302bfcfb97d90df8e8d75ce731.1920x1080.jpg?t=1764672235","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/7541b3a2288eb9302bfcfb97d90df8e8d75ce731/ss_7541b3a2288eb9302bfcfb97d90df8e8d75ce731.600x338.jpg?t=1764672235"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/7d02dd917afdc6ffb1297134ae3cc5659767a9f6/ss_7d02dd917afdc6ffb1297134ae3cc5659767a9f6.1920x1080.jpg?t=1764672235","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3411970/7d02dd917afdc6ffb1297134ae3cc5659767a9f6/ss_7d02dd917afdc6ffb1297134ae3cc5659767a9f6.600x338.jpg?t=1764672235"}],"short_description":"The Abbess Garden is a cozy and historical gardening game set in 17th-century France. Play as Agnes, a young peasant who is tasked to grow plants, find and identify new ones, and decorate the garden. Help uncover a spy plot, assist others in the local community, and find a lover.","steam_appid":3411970,"support_info":{"email":"abbessgarden@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://profuse-clover-7f6.notion.site/The-Abbess-Garden-1a57d26db14d80d9a227ec61b1fcea61"}