4300/extras/6133f4cf0e453c502fc844fac69fe13d.webm?t=1764953932\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4124300/extras/6133f4cf0e453c502fc844fac69fe13d.mp4?t=1764953932\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">There is no rush.<br>No timers.<br>Only warmth, patience, and the soft glow of discovery<br>as every solved fragment brings a little more light into the scene.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4124300/extras/e1b4f98b2923fc2b061ec0368fbd2cf3.avif?t=1764953932\" width=1560 height=146 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4124300/extras/be7ca2b46780f4fdbe9236a17eb7f76c.poster.avif?t=1764953932\" width=568 height=320 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4124300/extras/be7ca2b46780f4fdbe9236a17eb7f76c.webm?t=1764953932\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4124300/extras/e1b4f98b2923fc2b061ec0368fbd2cf3.avif?t=1764953932\" width=1560 height=146 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4124300/extras/e768c910e0b9a1f7705f014fdab85073.poster.avif?t=1764953932\" width=568 height=320 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4124300/extras/e768c910e0b9a1f7705f014fdab85073.webm?t=1764953932\