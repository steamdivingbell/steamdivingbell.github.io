ared.akamai.steamstatic.com/store_item_assets/steam/apps/3645410/643e55a4959f6690cd1ac4c8b0d08dc566ec80ae/ss_643e55a4959f6690cd1ac4c8b0d08dc566ec80ae.1920x1080.jpg?t=1773138318","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3645410/643e55a4959f6690cd1ac4c8b0d08dc566ec80ae/ss_643e55a4959f6690cd1ac4c8b0d08dc566ec80ae.600x338.jpg?t=1773138318"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3645410/e6cd0b0b209d483d196f75af86dd2b7b75c4d82c/ss_e6cd0b0b209d483d196f75af86dd2b7b75c4d82c.1920x1080.jpg?t=1773138318","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3645410/e6cd0b0b209d483d196f75af86dd2b7b75c4d82c/ss_e6cd0b0b209d483d196f75af86dd2b7b75c4d82c.600x338.jpg?t=1773138318"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3645410/bceea73947672a3592baf6a25d9471fa6bbac98a/ss_bceea73947672a3592baf6a25d9471fa6bbac98a.1920x1080.jpg?t=1773138318","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3645410/bceea73947672a3592baf6a25d9471fa6bbac98a/ss_bceea73947672a3592baf6a25d9471fa6bbac98a.600x338.jpg?t=1773138318"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3645410/77a9582161d9e480374ceb2d0865a31bcdc2216e/ss_77a9582161d9e480374ceb2d0865a31bcdc2216e.1920x1080.jpg?t=1773138318","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3645410/77a9582161d9e480374ceb2d0865a31bcdc2216e/ss_77a9582161d9e480374ceb2d0865a31bcdc2216e.600x338.jpg?t=1773138318"}],"short_description":"You are a Duke sent to govern a village at the edge of the realm. Build, protect, and guide your people toward prosperity. But beware, hidden threats await... Choose your strategy wisely, forge alliances and face your fate. Will your village thrive\u2026 or be swallowed by chaos?","steam_appid":3645410,"support_info":{"email":"holyradish.studio@gmail.com","url":""},"supported_languages":"English, Italian","type":"game","website":null}