8.jpg?t=1761872843"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3724910/51348afd3e29ebbe4321716760bf72b09250dca7/ss_51348afd3e29ebbe4321716760bf72b09250dca7.1920x1080.jpg?t=1761872843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3724910/51348afd3e29ebbe4321716760bf72b09250dca7/ss_51348afd3e29ebbe4321716760bf72b09250dca7.600x338.jpg?t=1761872843"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3724910/038b0181ced2304b9ee8a359b79e91d354a45604/ss_038b0181ced2304b9ee8a359b79e91d354a45604.1920x1080.jpg?t=1761872843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3724910/038b0181ced2304b9ee8a359b79e91d354a45604/ss_038b0181ced2304b9ee8a359b79e91d354a45604.600x338.jpg?t=1761872843"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3724910/37ad1993e50b7fba9b2816e25bb5e048b25515f6/ss_37ad1993e50b7fba9b2816e25bb5e048b25515f6.1920x1080.jpg?t=1761872843","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3724910/37ad1993e50b7fba9b2816e25bb5e048b25515f6/ss_37ad1993e50b7fba9b2816e25bb5e048b25515f6.600x338.jpg?t=1761872843"}],"short_description":"Step into Serene Estates: Last Guy, a 3D action-adventure inspired by the golden age of early 2000s classics. Explore a surreal housing complex where Y2K optimism meets abandoned brutalism. Hack robots, fight, and uncover the secrets of a system that keeps running long after humanity\u2019s gone.","steam_appid":3724910,"support_info":{"email":"lastguygame@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://kvltgames.com/start/"}