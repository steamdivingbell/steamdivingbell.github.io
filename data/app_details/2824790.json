apps/2824790/7df8766baa211466e0ceac68b9f64d7e78e1e1e5/ss_7df8766baa211466e0ceac68b9f64d7e78e1e1e5.600x338.jpg?t=1752138927"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2824790/46c7b92a88037cca6c7d1b241535fece3046d934/ss_46c7b92a88037cca6c7d1b241535fece3046d934.1920x1080.jpg?t=1752138927","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2824790/46c7b92a88037cca6c7d1b241535fece3046d934/ss_46c7b92a88037cca6c7d1b241535fece3046d934.600x338.jpg?t=1752138927"}],"short_description":"Type anything, generate a creature. Outwit, outlast, and out-weird your enemies in a sandbox tactics battler with deep simulation systems, wildly varied combat and endless procedurally-generated chaos!","steam_appid":2824790,"support_info":{"email":"help@martianlawyers.club","url":""},"supported_languages":"English","type":"game","website":"https://martianlawyers.club/"}