e465a0cc8c3689427/ss_d26d3e0cac7ebe073a1e055e465a0cc8c3689427.1920x1080.jpg?t=1742916681","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581040/d26d3e0cac7ebe073a1e055e465a0cc8c3689427/ss_d26d3e0cac7ebe073a1e055e465a0cc8c3689427.600x338.jpg?t=1742916681"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581040/b1c17dc8dc1292e35e38bafaec62404c09590f2d/ss_b1c17dc8dc1292e35e38bafaec62404c09590f2d.1920x1080.jpg?t=1742916681","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581040/b1c17dc8dc1292e35e38bafaec62404c09590f2d/ss_b1c17dc8dc1292e35e38bafaec62404c09590f2d.600x338.jpg?t=1742916681"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581040/78782572718dc8ed063eb4a610f367456c78d7a4/ss_78782572718dc8ed063eb4a610f367456c78d7a4.1920x1080.jpg?t=1742916681","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581040/78782572718dc8ed063eb4a610f367456c78d7a4/ss_78782572718dc8ed063eb4a610f367456c78d7a4.600x338.jpg?t=1742916681"}],"short_description":"Lead a police force in noir India. Manage officers, respond to emergencies, and upgrade your team. Navigate crime, corruption, and deep-rooted social tensions. Every decision has consequences.","steam_appid":3581040,"support_info":{"email":"bharatpolicegame@gmail.com","url":""},"supported_languages":"English, Russian, Hindi","type":"game","website":null}