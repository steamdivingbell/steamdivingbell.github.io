x338.jpg?t=1748103130"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3703730/fbbcf05dddc4ecc3c92c2ac52f314fd9e7f8dfa3/ss_fbbcf05dddc4ecc3c92c2ac52f314fd9e7f8dfa3.1920x1080.jpg?t=1748103130","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3703730/fbbcf05dddc4ecc3c92c2ac52f314fd9e7f8dfa3/ss_fbbcf05dddc4ecc3c92c2ac52f314fd9e7f8dfa3.600x338.jpg?t=1748103130"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3703730/cb7b2d6c4d8f50c7351597d4b2d07171846475a4/ss_cb7b2d6c4d8f50c7351597d4b2d07171846475a4.1920x1080.jpg?t=1748103130","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3703730/cb7b2d6c4d8f50c7351597d4b2d07171846475a4/ss_cb7b2d6c4d8f50c7351597d4b2d07171846475a4.600x338.jpg?t=1748103130"}],"short_description":"Tezzel is a cozy, colorful, and crafty puzzle game where every level completed becomes a colorful tile that gets added to the mosaic Wall. Discover mind-bending mechanics across 100+ handcrafted levels.","steam_appid":3703730,"support_info":{"email":"info@oldmayor.com","url":"www.oldmayor.com"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Catalan, Hindi, Tamil, Japanese, Korean, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Spanish - Latin America","type":"game","website":null}