com/store_item_assets/steam/apps/3528380/extras/d0904471eabab0cd4ea788c2408ffbd9.mp4?t=1752570888\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >It's not uncommon to see portals in sokoban-like games, so we've also made some fun features.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3528380/extras/8143d1d3f83099f571dd6cde1de875ba.poster.avif?t=1752570888\" width=800 height=284 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3528380/extras/8143d1d3f83099f571dd6cde1de875ba.webm?t=1752570888\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3528380/extras/8143d1d3f83099f571dd6cde1de875ba.mp4?t=1752570888\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Every level is unique, hoping that you'll find yourself amazed as you solve them. We don\u2019t want you to feel frustrated if you're stuck for too long, so we've left helpful hints for you. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >With 8 chapters and 100 levels, get ready for a puzzling adventure like no other!</p>","developers":["EGGNISI"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3528380/header.jpg?t=1752570888","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3528380/852160/eb0dabe9ccffbf2dc4a47e897733952ada2b8727/1750858434/dash_av1.mpd?t=1742162726","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3528380/852160/eb0dabe9ccffbf2dc4a47e897733952ada2b8727/1750858434/dash_h264.mpd?t=1742162726","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailer