0450/7d8df0fb2d129d49d92f54bfaaca39bb2165839e/ss_7d8df0fb2d129d49d92f54bfaaca39bb2165839e.600x338.jpg?t=1760744401"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/b34e47418372518aff627093096b04845dfde329/ss_b34e47418372518aff627093096b04845dfde329.1920x1080.jpg?t=1760744401","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/b34e47418372518aff627093096b04845dfde329/ss_b34e47418372518aff627093096b04845dfde329.600x338.jpg?t=1760744401"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/49f313b39d17464979ccef64f7ee9fe72ca8eaaa/ss_49f313b39d17464979ccef64f7ee9fe72ca8eaaa.1920x1080.jpg?t=1760744401","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/49f313b39d17464979ccef64f7ee9fe72ca8eaaa/ss_49f313b39d17464979ccef64f7ee9fe72ca8eaaa.600x338.jpg?t=1760744401"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/4e5646a7217512eff5d022e2eb4c8ee02d8789dd/ss_4e5646a7217512eff5d022e2eb4c8ee02d8789dd.1920x1080.jpg?t=1760744401","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/4e5646a7217512eff5d022e2eb4c8ee02d8789dd/ss_4e5646a7217512eff5d022e2eb4c8ee02d8789dd.600x338.jpg?t=1760744401"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/01f027e9e28d52e694a44f79068753ad2cf3714f/ss_01f027e9e28d52e694a44f79068753ad2cf3714f.1920x1080.jpg?t=1760744401","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/01f027e9e28d52e694a44f79068753ad2cf3714f/ss_01f027e9e28d52e694a44f79068753ad2cf3714f.600x338.jpg?t=1760744401"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/f39585c6d2df85d97588f0a5ca784b3cf3675fd7/ss_f39585c6d2df85d97588f0a5ca784b3cf3675fd7.1920x1080.jpg?t=1760744401","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/f39585c6d2df85d97588f0a5ca784b3cf3675fd7/ss_f39585c6d2df85d97588f0a5ca784b3cf3675fd7.600x338.jpg?t=1760744401"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/a731ae698b1ae9aace0589a2b989f2c84534af49/ss_a731ae698b1ae9aace0589a2b989f2c84534af49.1920x1080.jpg?t=1760744401","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/a731ae698b1ae9aace0589a2b989f2c84534af49/ss_a731ae698b1ae9aace0589a2b989f2c84534af49.600x338.jpg?t=1760744401"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/5361a24680d61369bb60b541232228d2f68c9066/ss_5361a24680d61369bb60b541232228d2f68c9066.1920x1080.jpg?t=1760744401","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/5361a24680d61369bb60b541232228d2f68c9066/ss_5361a24680d61369bb60b541232228d2f68c9066.600x338.jpg?t=1760744401"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/155a5941fca5ae939eacbae5458c3093257cb85a/ss_155a5941fca5ae939eacbae5458c3093257cb85a.1920x1080.jpg?t=1760744401","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3790450/155a5941fca5ae939eacbae5458c3093257cb85a/ss_155a5941fca5ae939eacbae5458c3093257cb85a.600x338.jpg?t=1760744401"}],"short_description":"A story-driven mystery visual novel set in a remote island village. Gather clues through conversations and exploration, and uncover hidden truths through branching routes and multiple endings amid the tense, claustrophobic atmosphere.","steam_appid":3790450,"support_info":{"email":"sayneinteractive@gmail.com","url":""},"supported_languages":"Korean","type":"game","website":null}