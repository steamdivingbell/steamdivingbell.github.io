n buy parts, check out shop designs, or join in a race.</p>","developers":["That One Game Studio"],"genres":[{"description":"Casual","id":"4"},{"description":"Racing","id":"9"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982690/3c53792f181da6045d2d014a5e10ff86935d0cf2/header.jpg?t=1757684692","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Pocket Racer Shop Sim","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> intel core i5 9400F<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GTX 1660<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["That One Game Studio"],"ratings":{"dejus":{"banned":"0","descriptors":"Drogas l\u00edcitas","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Alkohol / Tabak","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982690/42a32bf62ad92c909dcb6470d2e1ab859edc8a77/ss_42a32bf62ad92c909dcb6470d2e1ab859edc8a77.1920x1080.jpg?t=1757684692","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982690/42a32bf62ad92c909dcb6470d2e1ab859edc8a77/ss_42a32bf62ad92c909dcb6470d2e1ab859edc8a77.600x338.jpg?t=1757684692"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3982690/4aa6eaa165462ee8eecb0064d49ac66767ad51da/ss_4aa6eaa165462ee8eecb0064d49ac66767ad51da.1920x1080.jpg?t=1757684692","path_thumbnail":"https://sha