8.jpg"}],"total":10},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/1937170?t=1667315837","background_raw":"https://store.akamai.steamstatic.com/images/storepagebackground/app/1937170?t=1667315837","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/capsule_231x87.jpg?t=1667315837","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/capsule_184x69.jpg?t=1667315837","categories":[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Full controller support","id":28},{"description":"Steam Workshop","id":30},{"description":"Steam Cloud","id":23},{"description":"Includes level editor","id":17},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"controller_support":"full","detailed_description":"Pokaban is a puzzle game where you push cards around to make poker hands. There are marked positions that correlate to a poker hand on the screen. Once enough cards are added to a hand it will be compared with the dealer's hand. If all of your hands beat the dealer then you win the match!<h2 class=\"bb_tag\" >How to Play</h2><br>Push cards:<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/1114981cc0a0800599f74301a343248d.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/1114981cc0a0800599f74301a343248d.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/1114981cc0a0800599f74301a343248d.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br><br>When pushed into a slot the card is added to a hand<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/7424de7cd129423b56db7ccbaf52ea7f.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/7424de7cd129423b56db7ccbaf52ea7f.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/7424de7cd129423b56db7ccbaf52ea7f.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br><br>Once a hand is completed it will be compared with the dealer<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/64e3f3eab67922ff062362657be92227.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/64e3f3eab67922ff062362657be92227.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/64e3f3eab67922ff062362657be92227.mp4?t=1667315837\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >You cannot <span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/16d7d8829fb73f9c461ca12ce8d776df.webp?t=1667315837\" width=16 height=16 /></span></h2><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/16d7d8829fb73f9c461ca12ce8d776df.webp?t=1667315837\" width=16 height=16 /></span> Push more than one card<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/5b316f439455e035631d8211fe571aab.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/5b316f439455e035631d8211fe571aab.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/5b316f439455e035631d8211fe571aab.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/16d7d8829fb73f9c461ca12ce8d776df.webp?t=1667315837\" width=16 height=16 /></span> Pull cards<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/de83f61d2da05eb5f96b826b9bcebb4c.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/de83f61d2da05eb5f96b826b9bcebb4c.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/de83f61d2da05eb5f96b826b9bcebb4c.mp4?t=1667315837\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >Wild</h2><br>Wild cards can take the place of any other card. It makes creating poker hands more challenging. Like other cards you can place wild cards into marked positions to add to your hand.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/aa5612689981197829e4dbff761fbaa4.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/aa5612689981197829e4dbff761fbaa4.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/aa5612689981197829e4dbff761fbaa4.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br><br>Positions on the game board can be marked as wild. Placing a card there will turn all cards sharing the rank and suit into wild cards. Be careful though this will affect the dealer' cards as well.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/36cfc3cddc693305f399749260485587.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/36cfc3cddc693305f399749260485587.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/36cfc3cddc693305f399749260485587.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br><br>These modifiers affect the dealer's cards as well so use them carefully.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/9c6bca5fa35822c27a6449d9206fcb16.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/9c6bca5fa35822c27a6449d9206fcb16.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/9c6bca5fa35822c27a6449d9206fcb16.mp4?t=1667315837\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >Suit Swap</h2><br>Placing a card onto a position marked with another suit will swap the suits of both cards.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/4584d72b2ac4316b1e71bd6028249b3e.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/4584d72b2ac4316b1e71bd6028249b3e.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/4584d72b2ac4316b1e71bd6028249b3e.mp4?t=1667315837\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >Hand</h2><br>Add cards to your hand<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/062790ffe8388f4bcd3f7322d82092f3.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/062790ffe8388f4bcd3f7322d82092f3.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/062790ffe8388f4bcd3f7322d82092f3.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/761af4512bdf5907f06a4a45689baf59.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/761af4512bdf5907f06a4a45689baf59.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/761af4512bdf5907f06a4a45689baf59.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br><br>Throw cards from your hand<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/0a181e72a6f948c238a65a6bd1290bbc.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/0a181e72a6f948c238a65a6bd1290bbc.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/0a181e72a6f948c238a65a6bd1290bbc.mp4?t=1667315837\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" > Additional features<br><br><ul class=\"bb_ul\"><li> Create and share custom levels with friends and strangers.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/b36bcfb53d2b355fc2b0db70b95497eb.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/b36bcfb53d2b355fc2b0db70b95497eb.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/b36bcfb53d2b355fc2b0db70b95497eb.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br></li><li> Unlimited undo/redo movement.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/f4c43391ca0179dc1a28944cb5f20c4f.poster.avif?t=1667315837\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/f4c43391ca0179dc1a28944cb5f20c4f.webm?t=1667315837\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/f4c43391ca0179dc1a28944cb5f20c4f.mp4?t=1667315837\" type=\"video/mp4\"></video></span><br></li><li> Fully configurable keyboard/gamepad mapping<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937170/extras/33313019c3b7a5afa21b02