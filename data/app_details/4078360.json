8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078360/264d91490f62c968fa67c9ce6ce8bd4f65f47c1e/ss_264d91490f62c968fa67c9ce6ce8bd4f65f47c1e.1920x1080.jpg?t=1771864987","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078360/264d91490f62c968fa67c9ce6ce8bd4f65f47c1e/ss_264d91490f62c968fa67c9ce6ce8bd4f65f47c1e.600x338.jpg?t=1771864987"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078360/945e376ec934bd6103bc36344840b1c23ea996ba/ss_945e376ec934bd6103bc36344840b1c23ea996ba.1920x1080.jpg?t=1771864987","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078360/945e376ec934bd6103bc36344840b1c23ea996ba/ss_945e376ec934bd6103bc36344840b1c23ea996ba.600x338.jpg?t=1771864987"}],"short_description":"When We Arrive is a co-op travel game set in a fantasy world, where you and your friends embark on a shared journey. Play as a hunter, mage, or warrior, manage your supplies, discover hidden treasures, and make sure you all reach your destination safely.","steam_appid":4078360,"support_info":{"email":"support@twopixels.games","url":""},"supported_languages":"English<strong>*</strong>, German<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}