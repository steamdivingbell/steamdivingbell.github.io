0/ae3bdfcbaece8fe4f44923ae84428200d8025a97/ss_ae3bdfcbaece8fe4f44923ae84428200d8025a97.600x338.jpg?t=1769182219"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3841840/ece5c1f31f88b946826de1fe05f71be7a1717f4a/ss_ece5c1f31f88b946826de1fe05f71be7a1717f4a.1920x1080.jpg?t=1769182219","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3841840/ece5c1f31f88b946826de1fe05f71be7a1717f4a/ss_ece5c1f31f88b946826de1fe05f71be7a1717f4a.600x338.jpg?t=1769182219"}],"short_description":"Build train tracks and command turrets in this Loop-based TD Roguelike game! Face the Eldritch God's trials, fend off waves of minions, and build unbreakable rail defenses. Strategize, upgrade, and fight to protect humanity's last hope against cosmic horrors!","steam_appid":3841840,"support_info":{"email":"manxia30@gmail.com","url":""},"supported_languages":"English, Simplified Chinese","type":"game","website":null}