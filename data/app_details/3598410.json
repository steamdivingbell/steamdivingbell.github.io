><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3598410/extras/GIF3.gif?t=1746120758\" /></p><h2 class=\"bb_tag\">\ud83d\udd8c\ufe0f CREATIVE MODE \ud83d\udd8c\ufe0f</h2><p class=\"bb_paragraph\">Create a landscape where you are in complete control. Use the extra tools in this game mode to freely place and delete as many tiles as you want. No tasks, points, or tile limits. Use the handy button to hide UI elements to get that perfect screenshot and share it with others!</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3598410/extras/GIF4.gif?t=1746120758\" /></p>","developers":["Thinking of Moths"],"genres":[{"description":"Casual","id":"4"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3598410/7904dc73f7a50af485d8c59a66a8afc4d4d27343/header.jpg?t=1746120758","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257131731,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257131731/movie480.mp4?t=1746120755","max":"http://video.akamai.steamstatic.com/store_trailers/257131731/movie_max.mp4?t=1746120755"},"name":"LuonTile","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257131731/82bde6adf76ddd70335db938dab3070124c75b8a/movie_600x337.jpg?t=1746120755","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257131731/movie480_vp9.webm?t=1746120755","max":"http://video.akamai.steamstatic.com/store_trailers/257131731/movie_max_vp9.webm?t=1746120755"}}],"name":"LuonTile","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 or newer<br></li><li><strong>Processor:</strong> 2.5 GHz or better<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> Suppo