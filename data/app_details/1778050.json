om/store_item_assets/steam/apps/1778050/extras/a7ee2bb5f2931edafafd62f6672570d8.mp4?t=1754646502\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\">While you\u2019re fixing up the mortal realm, you\u2019ll be tearing things down in Olympus. Prove your worth as you face the challenges from the gods.</p><p class=\"bb_paragraph\">Win, and you could earn their favour. Can you convince them to show grace to the mortals? Or are you all better off without them?</p>","developers":["Team Artichoke"],"genres":[{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1778050/d1cd98062c463b400058c5d13053ff380161f356/header.jpg?t=1754646502","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> OS X 10.11 or later<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core M<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 6 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> OS X 10.11 or later<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core M<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 6 GB available space</li></ul>"},"movies":[{"highlight":true,"id":257179637,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257179637/movie480.mp4?t=1754579667","max":"http://video.akamai.steamstatic.com/store_trailers/257179637/movie_max.mp4?t=1754579667"},"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257179637/05978f5b3c844961ae683dfb1fd0f34842d197f1/movie_600x337.jpg?t=1754579667","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/2571