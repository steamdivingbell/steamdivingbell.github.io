://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1778050/ss_d7640ae68e39a56c35d76dee0005cba954ea4e9f.1920x1080.jpg?t=1771416330","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1778050/ss_d7640ae68e39a56c35d76dee0005cba954ea4e9f.600x338.jpg?t=1771416330"}],"short_description":"Build a community to challenge the gods in this narrative-rich anti-capitalist merge game. Play as outcast Artemis and work alongside the mortals to repair their broken buildings and relationships. Merge the items, unite the people, make a home.","steam_appid":1778050,"support_info":{"email":"hello@teamartichoke.com","url":"teamartichoke.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.teamartichoke.com/"}