img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3265260/extras/banner_2.png?t=1740740575\" /></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3265260/extras/OGORA_STEAM_GIF_2.gif?t=1740740575\" /></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">Select your hero and choose a Partner to aid you in your journey. Each partner offers unique powers and abilities, so choose carefully!</p></li><li><p class=\"bb_paragraph\">Whoever you don\u2019t choose is out to win, so make sure you\u2019re prepared!</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Forge your own path as you journey through - Ogora!</p>","developers":["Oolcay Hitsay"],"fullgame":{"appid":"3262090","name":"OGORA"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3265260/header.jpg?t=1740740575","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257108308,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257108308/movie480.mp4?t=1740740573","max":"http://video.akamai.steamstatic.com/store_trailers/257108308/movie_max.mp4?t=1740740573"},"name":"OGORA","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257108308/57a6f6b0dc433f95567cb22606d04e91ec73abec/movie_600x337.jpg?t=1740740573","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257108308/movie480_vp9.webm?t=1740740573","max":"http://video.akamai.steamstatic.com/store_trailers/257108308/movie_max_vp9.webm?t=1740740573"}}],"name":"OGORA: Prologue","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7+<br></li><li><strong>Processor:</strong> 2 Ghz<br></li><li><strong>Memory:</strong> 2 