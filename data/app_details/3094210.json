mai.steamstatic.com/store_item_assets/steam/apps/3094210/ddf9a90d8e2319b259530b8a6fc12158b4d92557/ss_ddf9a90d8e2319b259530b8a6fc12158b4d92557.1920x1080.jpg?t=1760056797","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3094210/ddf9a90d8e2319b259530b8a6fc12158b4d92557/ss_ddf9a90d8e2319b259530b8a6fc12158b4d92557.600x338.jpg?t=1760056797"}],"short_description":"Be. Faster. You are a corporate scavenger drone, sent to rip through the decaying corpse of a dying world to salvage its nullstar. Master flight, thrusters, and face ancient guardians and hazards in 80 precision platformer levels set in the ruins of a civilization where all is not as it might seem.","steam_appid":3094210,"support_info":{"email":"support@indie.io","url":"https://smashattackaus.com/contact-us"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://smashattackaus.com/nullstar-solus"}