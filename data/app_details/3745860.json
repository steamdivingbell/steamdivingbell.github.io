lanets, solve puzzles, repair your ship, and find your way back home.","steam_appid":3745860,"support_info":{"email":"sinminki1@naver.com","url":"https://x.com/ANYWAYGAMES"},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese, Korean, French, Italian, German, Spanish - Spain, Russian, Vietnamese, Arabic, Indonesian, Thai, Turkish, Portuguese - Brazil","type":"game","website":null}