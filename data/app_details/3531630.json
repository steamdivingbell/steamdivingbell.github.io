dcd85e/ss_ad60209fad5754c7c956d960de96b7a623dcd85e.600x338.jpg?t=1771869589"}],"short_description":"Tomb of the Bloodletter is a strategic word roguelike where your keyboard becomes your arsenal. Use your wit to unleash deadly words through tactical combinations of your letters to defeat the denizens of this dingy tomb and claim the Bloodletter for yourself...","steam_appid":3531630,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English","type":"game","website":null}