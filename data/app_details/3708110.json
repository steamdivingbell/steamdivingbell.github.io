110/949b8142bc0f62ddde8787223e2e9ebbb7609e73/ss_949b8142bc0f62ddde8787223e2e9ebbb7609e73.600x338.jpg?t=1767032536"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708110/daad47dc345259865b17dc318961ab1cf77031d0/ss_daad47dc345259865b17dc318961ab1cf77031d0.1920x1080.jpg?t=1767032536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708110/daad47dc345259865b17dc318961ab1cf77031d0/ss_daad47dc345259865b17dc318961ab1cf77031d0.600x338.jpg?t=1767032536"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708110/9d4e00bedf0cc068c84244fb4932b4548fb08dac/ss_9d4e00bedf0cc068c84244fb4932b4548fb08dac.1920x1080.jpg?t=1767032536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708110/9d4e00bedf0cc068c84244fb4932b4548fb08dac/ss_9d4e00bedf0cc068c84244fb4932b4548fb08dac.600x338.jpg?t=1767032536"}],"short_description":"Medieval Europe. With dark humor, pagan gods, and endless Fridays. You are a former king. Having quarreled with the gods, you lost everything and are stuck in a curse. From now on, you are forced to live the same day forever. Everything depends on your actions. Can you break the curse?","steam_appid":3708110,"support_info":{"email":"slobidskiihry@gmail.com","url":""},"supported_languages":"English, Ukrainian","type":"game","website":null}