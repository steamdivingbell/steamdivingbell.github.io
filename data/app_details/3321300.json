mbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321300/ss_21171260a290f139e94da0fa625c66a46bb1d676.600x338.jpg?t=1765489886"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321300/ss_0bae53df68a7f73a8bb7a60b181765e5707b2d97.1920x1080.jpg?t=1765489886","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321300/ss_0bae53df68a7f73a8bb7a60b181765e5707b2d97.600x338.jpg?t=1765489886"}],"short_description":"4 Thieves vs. 1 Guardian! A medieval heist game! Play as a thief, disguise yourself among the crowd, and steal the treasure, or take on the role of the guardian and hunt down the thieves! Everyone has a unique role and strategy. Find the right approach and lead your team to victory!","steam_appid":3321300,"support_info":{"email":"dointogethergames@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Turkish<strong>*</strong>, French<strong>*</strong>, Italian<strong>*</strong>, German<strong>*</strong>, Spanish - Spain<strong>*</strong>, Japanese<strong>*</strong>, Korean<strong>*</strong>, Portuguese - Portugal<strong>*</strong>, Russian<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Traditional Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.dointogethergames.com/"}