20/97f7e11e5c2aa6720906ade10ab575cc5885b5de/ss_97f7e11e5c2aa6720906ade10ab575cc5885b5de.600x338.jpg?t=1770654593"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2237320/2747b3b68c4ed0849cef3c4a9449468218481a62/ss_2747b3b68c4ed0849cef3c4a9449468218481a62.1920x1080.jpg?t=1770654593","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2237320/2747b3b68c4ed0849cef3c4a9449468218481a62/ss_2747b3b68c4ed0849cef3c4a9449468218481a62.600x338.jpg?t=1770654593"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2237320/aec63e327d80ca7164c0a9033b8ecee46179fe23/ss_aec63e327d80ca7164c0a9033b8ecee46179fe23.1920x1080.jpg?t=1770654593","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2237320/aec63e327d80ca7164c0a9033b8ecee46179fe23/ss_aec63e327d80ca7164c0a9033b8ecee46179fe23.600x338.jpg?t=1770654593"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2237320/eb4fa8244ae9f224f1860a8d02d79d4ca2bcd012/ss_eb4fa8244ae9f224f1860a8d02d79d4ca2bcd012.1920x1080.jpg?t=1770654593","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2237320/eb4fa8244ae9f224f1860a8d02d79d4ca2bcd012/ss_eb4fa8244ae9f224f1860a8d02d79d4ca2bcd012.600x338.jpg?t=1770654593"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2237320/eabcf48bce1f53beaf63896d514b5655e270441f/ss_eabcf48bce1f53beaf63896d514b5655e270441f.1920x1080.jpg?t=1770654593","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2237320/eabcf48bce1f53beaf63896d514b5655e270441f/ss_eabcf48bce1f53beaf63896d514b5655e270441f.600x338.jpg?t=1770654593"}],"short_description":"In this first-person extraction roguelite adventure, strap on your gloves, grab your Battlemallet, and explore randomly-generated mines as a new Delveling. Gather riches, avoid deadly hazards and try to make