.akamai.steamstatic.com/store_item_assets/steam/apps/3484960/aba7b3cfaab79500d29d394b2ee0a93b9ec0e502/ss_aba7b3cfaab79500d29d394b2ee0a93b9ec0e502.1920x1080.jpg?t=1751725861","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484960/aba7b3cfaab79500d29d394b2ee0a93b9ec0e502/ss_aba7b3cfaab79500d29d394b2ee0a93b9ec0e502.600x338.jpg?t=1751725861"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484960/a2301b1f734d418a2a3f1a572da31712a5f26674/ss_a2301b1f734d418a2a3f1a572da31712a5f26674.1920x1080.jpg?t=1751725861","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484960/a2301b1f734d418a2a3f1a572da31712a5f26674/ss_a2301b1f734d418a2a3f1a572da31712a5f26674.600x338.jpg?t=1751725861"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484960/c4291bd6547f264970c640a70c4d622f21d88600/ss_c4291bd6547f264970c640a70c4d622f21d88600.1920x1080.jpg?t=1751725861","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484960/c4291bd6547f264970c640a70c4d622f21d88600/ss_c4291bd6547f264970c640a70c4d622f21d88600.600x338.jpg?t=1751725861"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484960/4b040f4914cfc86c553340b4aec0d5009ae94c36/ss_4b040f4914cfc86c553340b4aec0d5009ae94c36.1920x1080.jpg?t=1751725861","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484960/4b040f4914cfc86c553340b4aec0d5009ae94c36/ss_4b040f4914cfc86c553340b4aec0d5009ae94c36.600x338.jpg?t=1751725861"}],"short_description":"Entrotria is a turn-based space 4X strategy game with distinctive resource management. Explore exotic systems and acquire powerful technologies. Exploit your planets, trade with other races and destroy those who stand in your way.","steam_appid":3484960,"support_info":{"email":"entrotria@gmx.de","url":""},"supported_languages":"English, German","type":"game","website":null}