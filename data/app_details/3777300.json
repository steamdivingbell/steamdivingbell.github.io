x1080.jpg?t=1764930021","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3777300/07f0d62269dc74eccc45eb02efda8f00d1a405a5/ss_07f0d62269dc74eccc45eb02efda8f00d1a405a5.600x338.jpg?t=1764930021"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3777300/20e55120c2bdbffb18e6be84aee2002dd5888f6c/ss_20e55120c2bdbffb18e6be84aee2002dd5888f6c.1920x1080.jpg?t=1764930021","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3777300/20e55120c2bdbffb18e6be84aee2002dd5888f6c/ss_20e55120c2bdbffb18e6be84aee2002dd5888f6c.600x338.jpg?t=1764930021"}],"short_description":"A third-person co-op stealth comedy where up to four players sneak into an all-girls college while one player becomes the principal \u2014 the aggressive hunter with a shinai. Talk to the girls who only trust specific characters, complete missions, rescue captured friends, and survive the chaos together.","steam_appid":3777300,"support_info":{"email":"masskai.th@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}