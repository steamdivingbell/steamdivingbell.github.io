Prove Yourself to the World!</p><p class=\"bb_paragraph\" >Are you the best firefighter? Share your score and show your heroism to the world.</p>","developers":["Burak Pi\u015fkin"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444000/header.jpg?t=1762010269","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3444000/808167/7997b858b5df0efa00424c136faa8bc3bc4dbb4c/1750851595/dash_av1.mpd?t=1740139249","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3444000/808167/7997b858b5df0efa00424c136faa8bc3bc4dbb4c/1750851595/dash_h264.mpd?t=1740139249","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3444000/808167/7997b858b5df0efa00424c136faa8bc3bc4dbb4c/1750851595/hls_264_master.m3u8?t=1740139249","id":257086652,"name":"Firefighters Together | Save The Kittens","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257086652/8fea5168891cfa829393cd9fb21a8a939664e7e0/movie_600x337.jpg?t=1740139249"}],"name":"Firefighters Together","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Firefighters Together - <span class=\"discount_original_price\">$4.99</span> $1.74 USD","packageid":1217218,"percent_savings":0,"p