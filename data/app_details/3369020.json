umbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3369020/147f775b72cbec0ad58dde50f0bd4a574a949094/ss_147f775b72cbec0ad58dde50f0bd4a574a949094.600x338.jpg?t=1749556940"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3369020/fc3544d31bae906198128df9e8784e22775d87e5/ss_fc3544d31bae906198128df9e8784e22775d87e5.1920x1080.jpg?t=1749556940","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3369020/fc3544d31bae906198128df9e8784e22775d87e5/ss_fc3544d31bae906198128df9e8784e22775d87e5.600x338.jpg?t=1749556940"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3369020/ss_f27492d768f4c1382fdbf39c7c607c23a24c0069.1920x1080.jpg?t=1749556940","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3369020/ss_f27492d768f4c1382fdbf39c7c607c23a24c0069.600x338.jpg?t=1749556940"}],"short_description":"In a world where the fae-touched fall prey to a sinister killer, only a Faeologist can uncover the truth. A dark academia murder mystery visual novel with supernatural cases, interactive investigation, romanceable characters, and multiple endings, set in the roaring 1920s New York.","steam_appid":3369020,"support_info":{"email":"contact@mushroomallow.com","url":""},"supported_languages":"English","type":"game","website":null}