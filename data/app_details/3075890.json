ling for your blood?</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3075890/extras/Early_Access_Title.png?t=1746208593\" /></p><p class=\"bb_paragraph\">We have lots of ideas to make Hostile Lands a memorable experience\u2026but we can\u2019t do it without you!\u00a0\u00a0If you have any suggestions or need to report a bug please leave a comment in our discussion boards!</p><p class=\"bb_paragraph\"></p>","developers":["Perceiving Light"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3075890/header.jpg?t=1746208593","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257065113,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257065113/movie480.mp4?t=1730152438","max":"http://video.akamai.steamstatic.com/store_trailers/257065113/movie_max.mp4?t=1730152438"},"name":"Hostile Lands - First Look","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257065113/f7d40201348b6169d047bedfdbc5edfa671ef2c6/movie_600x337.jpg?t=1730152438","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257065113/movie480_vp9.webm?t=1730152438","max":"http://video.akamai.steamstatic.com/store_trailers/257065113/movie_max_vp9.webm?t=1730152438"}},{"highlight":true,"id":257100959,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257100959/movie480.mp4?t=1740252753","max":"http://video.akamai.steamstatic.com/store_trailers/257100959/movie_max.mp4?t=1740252753"},"name":"Hostile Lands - Co-Op","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257100959/8483de17ec23136513621cbf29f8357c86fce854/movie_600x337.jpg?t=1740252753","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/25710095