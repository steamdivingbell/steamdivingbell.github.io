teamstatic.com/store_item_assets/steam/apps/3661430/extras/c34c45e8a444a983cb8056e47ad0cc2c.mp4?t=1766350264\" type=\"video/mp4\"></video></span></p>","developers":["Sylvanhart"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3661430/3fed368c10099f00ff84a3b5b1540840e4e49099/header.jpg?t=1766350264","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3661430/778654653/b813e4558bb1932479362a1499e5feb8b72b1c1f/1755997210/dash_av1.mpd?t=1756101966","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3661430/778654653/b813e4558bb1932479362a1499e5feb8b72b1c1f/1755997210/dash_h264.mpd?t=1756101966","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3661430/778654653/b813e4558bb1932479362a1499e5feb8b72b1c1f/1755997210/hls_264_master.m3u8?t=1756101966","id":257187801,"name":"EnglishTrailerNew","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257187801/51fb0df2c0308466600c55ca76fff5c294c6fedd/movie_600x337.jpg?t=1756101966"}],"name":"Feather Land","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7<br></li><li><strong>Processor:</strong> Intel Core 2 Duo E8400 or equivalent<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> Integrated graphics (Intel HD 3000 or better)<br></li><li><strong>DirectX:</strong> Version 9.0<br></li><li><strong>Storage:</strong> 200 MB available space<br></li><li><strong>Sound Card:</strong> Any</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel i3 (3rd Gen) or equivalent<br></li><li><strong>Memory:</strong> 4 GB RAM<b