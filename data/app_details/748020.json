nail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/748020/ss_0df8da21e7f3d35d78cb6cf8b960363a0ef4c9b6.600x338.jpg?t=1772590773"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/748020/ss_20fe9013d8dd65a5bc3b1eecdcf071f3de7dbfca.1920x1080.jpg?t=1772590773","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/748020/ss_20fe9013d8dd65a5bc3b1eecdcf071f3de7dbfca.600x338.jpg?t=1772590773"}],"short_description":"Puzzle your way through 80+ hand-crafted levels in this uniquely challenging action-adventure game. Unleash world-shifting abilities, awaken ancient mechanisms, and defeat 8 brutal bosses - balancing cunning and force to rescue the cursed spirits of your fellow warriors.","steam_appid":748020,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English, Simplified Chinese<strong>*</strong>, Traditional Chinese, Spanish - Spain<br><strong>*</strong>languages with full audio support","type":"game","website":null}