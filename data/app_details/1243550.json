t=1776290325"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1243550/02f4b11659830ee5a201a143e724d6fe5e4e0589/ss_02f4b11659830ee5a201a143e724d6fe5e4e0589.1920x1080.jpg?t=1776290325","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1243550/02f4b11659830ee5a201a143e724d6fe5e4e0589/ss_02f4b11659830ee5a201a143e724d6fe5e4e0589.600x338.jpg?t=1776290325"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1243550/ef29966ce6403b9e4fb6a4c517437abf19a7f291/ss_ef29966ce6403b9e4fb6a4c517437abf19a7f291.1920x1080.jpg?t=1776290325","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1243550/ef29966ce6403b9e4fb6a4c517437abf19a7f291/ss_ef29966ce6403b9e4fb6a4c517437abf19a7f291.600x338.jpg?t=1776290325"}],"short_description":"SILKROAD Project blends a dynamic combat system, where players control two characters, with a guesthouse management experience filled with unique activities. Chain spectacular combos, welcome your guests, plan their daily routines, and help your caravanserai thrive.","steam_appid":1243550,"support_info":{"email":"garilhe.nicolas@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, French, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}