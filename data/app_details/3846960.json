sets/steam/apps/3846960/692fe57aa33eba9f73014016a1861af2c5e7ace3/ss_692fe57aa33eba9f73014016a1861af2c5e7ace3.600x338.jpg?t=1759145314"}],"short_description":"Tank Havoc is a fast-paced team-based action game where tanks clash in explosive, strategy driven battles. Fight across multiple modes, customize your tank, build a unique skill loadout, and adapt your tactics on the fly. Team up, flank hard, and unleash havoc in every match across dynamic arenas.","steam_appid":3846960,"support_info":{"email":"support@madmissile.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Traditional Chinese, Simplified Chinese, Japanese, Korean, Polish, Portuguese - Brazil, Russian","type":"game","website":null}