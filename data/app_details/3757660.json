ull":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757660/467ec1c3311faa102eebb1a92fdae3ed6255dc60/ss_467ec1c3311faa102eebb1a92fdae3ed6255dc60.1920x1080.jpg?t=1748008598","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757660/467ec1c3311faa102eebb1a92fdae3ed6255dc60/ss_467ec1c3311faa102eebb1a92fdae3ed6255dc60.600x338.jpg?t=1748008598"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757660/59dd54d455efeacc63df518dc97d62b325d90f59/ss_59dd54d455efeacc63df518dc97d62b325d90f59.1920x1080.jpg?t=1748008598","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757660/59dd54d455efeacc63df518dc97d62b325d90f59/ss_59dd54d455efeacc63df518dc97d62b325d90f59.600x338.jpg?t=1748008598"}],"short_description":"Howdy! I\u2019m Starla, Junior Ranger on a mission to fix up Barcadero National Park \u2014 with a little help from my 25-foot-tall robot buddy, Shorty. We\u2019re climbin\u2019, explorin\u2019, and teamin\u2019 up to bring this place back to life\u2026 and maybe help him find his way home, too.","steam_appid":3757660,"support_info":{"email":"station58.game@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}