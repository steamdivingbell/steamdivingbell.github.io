deo/mp4\"></video></span></p><p class=\"bb_paragraph\" >Hire hundreds of craftsmen and travelers, each with unique skills to help the town thrive.</p><h2 class=\"bb_tag\" style=\"text-align: center\"><u><strong>\u2014Explore the World\u2014</strong></u></h2><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3864100/extras/c123df1d49cf0f4dda91bc5852b6fb05.poster.avif?t=1757388185\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3864100/extras/c123df1d49cf0f4dda91bc5852b6fb05.webm?t=1757388185\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3864100/extras/c123df1d49cf0f4dda91bc5852b6fb05.mp4?t=1757388185\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Send townsfolk on expeditions to uncover rare resources and treasures for your settlement.</p><h2 class=\"bb_tag\" style=\"text-align: center\"><u><strong>\u2014More Features\u2014</strong></u></h2><p class=\"bb_paragraph\" >Enjoy diverse gameplay like vocational tournaments, guilds, world bosses, and more to enrich town life.</p><p class=\"bb_paragraph\" ></p>","developers":["Electronic Soul"],"genres":[{"description":"Casual","id":"4"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3864100/0e66dd796e7c20aecf8730014f90152937b588ae/header.jpg?t=1757388185","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257190185,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257190185/movie480.mp4?t=1756782358","max":"http://video.akamai.steamstatic.com/store_trailers/257190185/movie_max.mp4?t=1756782358"},"name":"\u300atales of terrarum\u300b","thumbnail":"https://shared.akamai.steamstatic.com/store