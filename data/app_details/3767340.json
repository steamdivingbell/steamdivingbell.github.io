ts/steam/apps/3767340/95f15337d216254692c0fb4419062b308a2f328e/ss_95f15337d216254692c0fb4419062b308a2f328e.600x338.jpg?t=1756536392"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3767340/5053b2d93d20169c192f1518e9f613bda40973f6/ss_5053b2d93d20169c192f1518e9f613bda40973f6.1920x1080.jpg?t=1756536392","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3767340/5053b2d93d20169c192f1518e9f613bda40973f6/ss_5053b2d93d20169c192f1518e9f613bda40973f6.600x338.jpg?t=1756536392"}],"short_description":"Fracturefront is a fantasy third-person 3D action roguelike. Centered on random equipment, it delivers a variable and strategically deep combat experience. Players take on the role of a warrior who travels through rifts to stop enemies from seizing the energy core.","steam_appid":3767340,"support_info":{"email":"z754576@163.com","url":""},"supported_languages":"English<strong>*</strong>, Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}