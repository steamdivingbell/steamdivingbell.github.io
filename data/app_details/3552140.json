store_item_assets/steam/apps/3552140/d8630826ab082c7394c9bf738a9a0681b63e2bf3/ss_d8630826ab082c7394c9bf738a9a0681b63e2bf3.600x338.jpg?t=1767132857"}],"short_description":"Manage your very own video store in the early 90s! Rent, sell, decorate and expand your business from the ground up and relive the golden ages of video rentals!","steam_appid":3552140,"support_info":{"email":"info@bloodpactstudios.com","url":"https://discord.com/invite/cgBqUUhCW3"},"supported_languages":"English, French, German","type":"game","website":null}