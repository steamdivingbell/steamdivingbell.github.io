5868a400e0480e932858d354568c27a04c504af5.1920x1080.jpg?t=1755864739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583790/5868a400e0480e932858d354568c27a04c504af5/ss_5868a400e0480e932858d354568c27a04c504af5.600x338.jpg?t=1755864739"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583790/8f12292799198daf558b77edf621335741ca8082/ss_8f12292799198daf558b77edf621335741ca8082.1920x1080.jpg?t=1755864739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583790/8f12292799198daf558b77edf621335741ca8082/ss_8f12292799198daf558b77edf621335741ca8082.600x338.jpg?t=1755864739"}],"short_description":"Experience next level board control, skate with friends, and film insane tricks in the most immersive skateboarding game ever made.","steam_appid":3583790,"support_info":{"email":"info@flipaxisstudios.com","url":"https://www.flipaxisstudios.com"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Simplified Chinese","type":"game","website":"https://www.virtualskategame.com"}