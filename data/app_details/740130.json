491334f8b7d648d902a5d2e4c2b88fbbb80a806.jpg"},{"icon":"de62cb26b64c7caf766109a101c633c5d8fa1cf9.jpg","localized_name":"Intertwining Hearts","name":"Intertwining Hearts","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/740130/de62cb26b64c7caf766109a101c633c5d8fa1cf9.jpg"}],"total":58},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/740130?t=1770964399","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/14b9c1d87776e2a905a44d666033bbc9c7721446/page_bg_raw.jpg?t=1770964399","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/3c17579d4d76ad1cb7a40c5402a99da0fb478e91/capsule_231x87.jpg?t=1770964399","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/3c17579d4d76ad1cb7a40c5402a99da0fb478e91/capsule_184x69.jpg?t=1770964399","categories":[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Full controller support","id":28},{"description":"Steam Trading Cards","id":29},{"description":"Steam Cloud","id":23},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"controller_support":"full","demos":[{"appid":1458040,"description":""}],"detailed_description":"<h1>Beyond the Dawn Edition</h1><p><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/2fa0fccdb7a414f24aa1aafd0ebddab7.poster.avif?t=1770964399\" width=616 height=420 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/2fa0fccdb7a414f24aa1aafd0ebddab7.webm?t=1770964399\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/2fa0fccdb7a414f24aa1aafd0ebddab7.mp4?t=1770964399\" type=\"video/mp4\"></video></span><br>The Beyond the Dawn Edition includes:<br>\u2022 Tales of ARISE<br>\u2022 Additional scenario &quot;Beyond the Dawn&quot;<br>\u2022 Additional costumes &amp; items<br><br><br>For 300 years, Rena has ruled over Dahna, pillaging the planet of its resources and stripping people of their dignity and freedom.<br>Our tale begins with two people, born on different worlds, each looking to change their fate and create a new future.<br>Featuring a diverse cast of characters, an intuitive and rewarding combat system, and a captivating story set in a lush world worth fighting for, Tales of Arise delivers a first-class JRPG experience.<br><br>BEYOND THE DAWN<br>After the battle for the fate of two worlds, Alphen and his party meet a young girl named Nazamil, who is the daughter of a Renan Lord and a Dahnan. Will the six be able to change the fate of the girl who will eventually fall under the curse of the mask? Explore the world again with party members who are bound together by a strong bond.<br><br>Beyond the Dawn contents:<br>- Additional scenario &quot;Beyond the Dawn&quot;<br>Satisfying storyline, new dungeons, and subquests that depict the new adventures of the party members.<br>- Special Data<br>6 additional costumes, content featuring the hero and heroine, and more.<br>- Travel Support Pack<br>Additional items (50,000 Gald, Level Up +5, CP +100, complete fishing gear).<br>- Silver Weapon Collection<br>A set of new silver-colored variant weapons.<br><br>*Beyond the Dawn content will be available in-game after claiming it from the Unclaimed DLC List.<br>*Content included in this product can be purchased separately.<br>*A Premium Edition is also available. Please be careful not to purchase the same content twice.</p><br><h1>Beyond the Dawn Premium Edition</h1><p><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/3152b82f835ede343ce5976cd79e57dd.avif?t=1770964399\" width=1560 height=878 /></span><br>Wield the Blazing Sword and join a mysterious, untouchable girl to fight your oppressors.<br><br>The Beyond the Dawn Premium Edition includes:<br>\u2022 Tales of ARISE<br>\u2022 Additional scenario &quot;Beyond the Dawn&quot;<br>\u2022 Classic Characters Costume &amp; Arranged BGM Pack<br>\u2022 Premium Travel Pack<br>\u2022 Starter Pack<br>\u2022 Premium Item/Premium Costume Packs<br>\u2022 Additional Costumes &amp; Items</p><br><h1>About the Game</h1><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/673e5d90afffea5af67c38f2e4531854.poster.avif?t=1770964399\" width=616 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/673e5d90afffea5af67c38f2e4531854.webm?t=1770964399\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/673e5d90afffea5af67c38f2e4531854.mp4?t=1770964399\" type=\"video/mp4\"></video></span><br><strong>A world of nature drawn with the \u201cAtmospheric Shader\u201d</strong><br>We are introducing a new graphics shader, inspired by anime and watercolor painting. Characters with attractive designs travel among backgrounds filled with beautiful and delicate visuals.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/e61e07b1f02095c9235cd76e5b2a7258.poster.avif?t=1770964399\" width=616 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/e61e07b1f02095c9235cd76e5b2a7258.webm?t=1770964399\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/e61e07b1f02095c9235cd76e5b2a7258.mp4?t=1770964399\" type=\"video/mp4\"></video></span><br><strong>Explore a world that feels alive</strong><br>Explore the world of Dahna, where a mix of unique, natural environments change in appearance based on the time of day. Climb over the rocky terrain, swim in rivers, gather around the campfire, cook food, head to the next town, defeat the master of an alien planet, and liberate the people!<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/9e7d4bef081b8cdbccd828f3def333e1.poster.avif?t=1770964399\" width=616 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/9e7d4bef081b8cdbccd828f3def333e1.webm?t=1770964399\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/9e7d4bef081b8cdbccd828f3def333e1.mp4?t=1770964399\" type=\"video/mp4\"></video></span><br><strong>Stylish action and battles</strong><br>Through the new system \u201cBoost Strike\u201d, you can now chain combos of powerful attacks together with your party members. Chain Artes, Boost Attacks, and Boost Strike combos to take down your enemies!<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/bf9fc99d8edd4ad07e49f8e080d5a508.poster.avif?t=1770964399\" width=616 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/bf9fc99d8edd4ad07e49f8e080d5a508.webm?t=1770964399\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/740130/extras/bf9fc99d8edd4ad07e49f8e080d5a508.mp4?t=1770964399\" type=\"video/mp4\"></video></span><br><strong>Experience the story of the divided Renan and Dahnan people</strong><br>The protagonists who will determine the fate of these two worlds are Alphen and Shionne. They will ov