 and slide into a world of artistic discovery and narrative charm!</i><br><br>","developers":["Be\u015finci Kural A.\u015e."],"dlc":[4092270,4150840],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3766130/89da9a5661dbded37e0010ee6d5f43e720bb0880/header.jpg?t=1769537692","is_free":false,"legal_notice":"Copyright 2025 Be\u015finci Kural A.\u015e.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 12.04 or newer<br></li><li><strong>Processor:</strong> Intel Core 2 Duo 2.1 ghz or equivalent<br></li><li><strong>Graphics:</strong> OpenGL 3.3 support</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 12.04 or newer<br></li><li><strong>Processor:</strong> Intel Core 2 Duo 2.1 ghz or equivalent<br></li><li><strong>Graphics:</strong> OpenGL 3.3 support</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3766130/631721533/b2df2b167ddb8d3be60372fd49660649a96d1e8e/1758624845/dash_av1.mpd?t=1758627877","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3766130/631721533/b2df2b167ddb8d3be60372fd49660649a96d1e8e/1758624845/dash_h264.mpd?t=1758627877","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3766130/631721533/b2df2b167ddb8d3be60372fd49660649a96d1e8e/1758624845/hls_264_master.m3u8?t=1758627877","id":257155600,"name":"Mirror Atelier - Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257155600/ee55d5d316da17c147bfa76793d26178306ebf96/movie_600x337.jpg?t=1758627877"}],"name":"Mirror Atelier","package_groups":[{"description":"",