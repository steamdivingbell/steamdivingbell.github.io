2941af/ss_f6d623c7f1a3e33d0f7785fff1489391f32941af.1920x1080.jpg?t=1759767965","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973310/f6d623c7f1a3e33d0f7785fff1489391f32941af/ss_f6d623c7f1a3e33d0f7785fff1489391f32941af.600x338.jpg?t=1759767965"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973310/747a679b0fe989d6aa1c5e82d6afbf5279e22273/ss_747a679b0fe989d6aa1c5e82d6afbf5279e22273.1920x1080.jpg?t=1759767965","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973310/747a679b0fe989d6aa1c5e82d6afbf5279e22273/ss_747a679b0fe989d6aa1c5e82d6afbf5279e22273.600x338.jpg?t=1759767965"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973310/328250fb9aee572cc54c4d09ec3ce37887a2dbdf/ss_328250fb9aee572cc54c4d09ec3ce37887a2dbdf.1920x1080.jpg?t=1759767965","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973310/328250fb9aee572cc54c4d09ec3ce37887a2dbdf/ss_328250fb9aee572cc54c4d09ec3ce37887a2dbdf.600x338.jpg?t=1759767965"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973310/5e70ad7cfcbc644d813dc64a7c3f7ab5be159993/ss_5e70ad7cfcbc644d813dc64a7c3f7ab5be159993.1920x1080.jpg?t=1759767965","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973310/5e70ad7cfcbc644d813dc64a7c3f7ab5be159993/ss_5e70ad7cfcbc644d813dc64a7c3f7ab5be159993.600x338.jpg?t=1759767965"}],"short_description":"Turn-based roguelike inspired by Greek mythology. Capture and corrupt creatures, evolve through decisions, and face unique events across procedural maps. Your choices shape the story, your team, and Pandora\u2019s daughter.","steam_appid":3973310,"support_info":{"email":"marketing@oppstudios.co.uk","url":"https://www.legacyofpandoragame.com/"},"supported_languages":"English<strong>*</strong>, Portuguese - Brazil<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.legacyofpandoragame.com/"}