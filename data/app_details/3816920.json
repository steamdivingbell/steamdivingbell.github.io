5161d08c4ea885b86f049b3/ss_706f7856d082f8bb35161d08c4ea885b86f049b3.600x338.jpg?t=1770332885"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816920/a01df7e3b617126067ba1c46f6c07aab9f861f67/ss_a01df7e3b617126067ba1c46f6c07aab9f861f67.1920x1080.jpg?t=1770332885","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816920/a01df7e3b617126067ba1c46f6c07aab9f861f67/ss_a01df7e3b617126067ba1c46f6c07aab9f861f67.600x338.jpg?t=1770332885"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816920/3cfd4010f15773736803500977cd91f0ff8fdfd2/ss_3cfd4010f15773736803500977cd91f0ff8fdfd2.1920x1080.jpg?t=1770332885","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816920/3cfd4010f15773736803500977cd91f0ff8fdfd2/ss_3cfd4010f15773736803500977cd91f0ff8fdfd2.600x338.jpg?t=1770332885"}],"short_description":"An atmospheric, eerie point-and-click adventure. Play as Ana, a botanist venturing into a misty forest with buried secrets. Prepare bizarre meals for cryptids to obtain information and items. The more she investigates, the stranger things become \u2014 and someone doesn\u2019t want her there.","steam_appid":3816920,"support_info":{"email":"milosiristudio@gmail.com","url":""},"supported_languages":"English, Spanish - Spain, Spanish - Latin America","type":"game","website":"https://milosiristudio.carrd.co/"}