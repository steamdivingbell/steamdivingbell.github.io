ough almost anything without taking damage.</p></li><li><p class=\"bb_paragraph\" >Unlock <strong>familiars</strong> that automatically gather resources, block, and attack enemies.</p></li></ul>","developers":["TERMAX Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3714400/856be379bddf561ef846f7a059d0308e465c231c/header.jpg?t=1774055207","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3714400/587208524/9714016698760bfd61d957a158933867e105aeb1/1772460956/dash_av1.mpd?t=1772462294","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3714400/587208524/9714016698760bfd61d957a158933867e105aeb1/1772460956/dash_h264.mpd?t=1772462294","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3714400/587208524/9714016698760bfd61d957a158933867e105aeb1/1772460956/hls_264_master.m3u8?t=1772462294","id":257220291,"name":"Trailer - Full Release","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257220291/92c56bec6554c3a988681edb1d07c45a0affbb8b/movie_600x337.jpg?t=1772462294"}],"name":"Echoes of Red","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Echoes of Red - $4.99 USD","packageid":1307575,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":499}],"title":"Buy Echoes of Red"}],"packages":[1307575],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 64bit<br></li><li><strong>Processor:</strong> Inte