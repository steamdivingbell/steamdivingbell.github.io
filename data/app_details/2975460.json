/ss_57da295fa113a404b43b11d0a4709244b2bf0972.1920x1080.jpg?t=1737572444","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_57da295fa113a404b43b11d0a4709244b2bf0972.600x338.jpg?t=1737572444"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_aa72460ec0a23789d7184bdfadc48f5fac8262aa.1920x1080.jpg?t=1737572444","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_aa72460ec0a23789d7184bdfadc48f5fac8262aa.600x338.jpg?t=1737572444"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_21369882fb842dd02ff270c438ba01275f1d7b25.1920x1080.jpg?t=1737572444","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_21369882fb842dd02ff270c438ba01275f1d7b25.600x338.jpg?t=1737572444"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_d95fceba17ceb1416a7b8e38b955425fe045693b.1920x1080.jpg?t=1737572444","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_d95fceba17ceb1416a7b8e38b955425fe045693b.600x338.jpg?t=1737572444"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_0305353c65639b2ef89f36024079fd0069bf1fa2.1920x1080.jpg?t=1737572444","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_0305353c65639b2ef89f36024079fd0069bf1fa2.600x338.jpg?t=1737572444"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_1646232483f9be645f853be0dc3817f7c5300be4.1920x1080.jpg?t=1737572444","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975460/ss_1646232483f9be645f853be0dc3817f7c5300be4.600x338.jpg?t=1737572444"}],"short_description":"Create your own farm. Harvest crops, take care of animals, sell goods, set prices at your discretion, hire staff, expand, design, and build your dream farm.","steam_appid":2975460,"support_info":{"email":"sleepysealsgames@gmail.com","url":""},"supported_languages":"English, Spanish - Spain, Russian, Simplified Chinese, French, Italian, German, Portuguese - Brazil, Korean, Dutch, Portuguese - Portugal, Turkish, Japanese, Polish","type":"game","website":null}