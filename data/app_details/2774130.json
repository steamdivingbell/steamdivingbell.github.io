pps/2774130/ss_f8ee5a072591cf0a26969313ff24c1c0e1b06550.600x338.jpg?t=1772518678"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/ss_87f612770f91f632c6ca9d62aff78fe3cc184233.1920x1080.jpg?t=1772518678","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/ss_87f612770f91f632c6ca9d62aff78fe3cc184233.600x338.jpg?t=1772518678"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/ss_b43897c0c3179494d989ec52c644f4ad25ecdde5.1920x1080.jpg?t=1772518678","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/ss_b43897c0c3179494d989ec52c644f4ad25ecdde5.600x338.jpg?t=1772518678"}],"short_description":"Plagueborn is a 2D action roguelike where you and your allies battle through plague-ridden dungeons. Explore procedurally generated floors, master a wide arsenal of weapons, forge unique builds, and cut down relentless hordes of darkness.","steam_appid":2774130,"support_info":{"email":"boohboohkeys@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}