68c945542.600x338.jpg?t=1744534771"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2363160/b6bca61626af390120eccf4458e57eb375bb0d89/ss_b6bca61626af390120eccf4458e57eb375bb0d89.1920x1080.jpg?t=1744534771","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2363160/b6bca61626af390120eccf4458e57eb375bb0d89/ss_b6bca61626af390120eccf4458e57eb375bb0d89.600x338.jpg?t=1744534771"}],"short_description":"Team up (or screw over) your friends in Haphazard Angel! Control one wing each of a shared angel and navigate chaotic challenges where cooperation and hilarious sabotage collide in this 2-4 player party game. Who needs teamwork when you\u2019ve got wings and questionable decisions?","steam_appid":2363160,"support_info":{"email":"accounts@capriccioso.studio","url":"https://discord.gg/RNeFn3xnXq"},"supported_languages":"English, Japanese, Korean, Simplified Chinese","type":"game","website":"https://capriccioso.studio/haphazard-angel-press-kit/?v=ef2cab854a9f"}