</ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2363160/extras/Haphazard_Headers__7_.gif?t=1744534771\" /></p><p class=\"bb_paragraph\"><strong>The controls are simple:</strong> flap your wings, navigate the chaos, and work (or fight) with your teammates. Whether you\u2019re playing couch co-op or online, Haphazard Angel delivers the perfect mix of fun and frustration!</p>","developers":["Capriccioso Games Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2363160/header.jpg?t=1744534771","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires an Apple processor<br></li><li><strong>OS:</strong> Monterey<br></li><li><strong>Processor:</strong> Apple Intel</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires an Apple processor<br></li><li><strong>OS:</strong> Monterey<br></li><li><strong>Processor:</strong> Apple M1</li></ul>"},"movies":[{"highlight":true,"id":257118029,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257118029/movie480.mp4?t=1744531114","max":"http://video.akamai.steamstatic.com/store_trailers/257118029/movie_max.mp4?t=1744531114"},"name":"Haphazard MarienyanGameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257118029/14c6cb8264bbd75bd246d425fc840984e5f3690d/movie_600x337.jpg?t=1744531114","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257118029/movie480_vp9.webm?t=1744531114","max":"http://video.akamai.steamstatic.com/store_tra