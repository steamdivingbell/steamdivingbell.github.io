/3692960/69f3a9f85501756e6ebd2f07b1c0f8176985b5b4/ss_69f3a9f85501756e6ebd2f07b1c0f8176985b5b4.600x338.jpg?t=1746537075"}],"short_description":"In a serene, immersive world, strategically craft your path to turn every multiple of 10 into a rewarding harvest. Unlock the powerful interplay of numbers and strategy, and savor the satisfaction of perfect alignment and numerical zen.","steam_appid":3692960,"support_info":{"email":"","url":"https://tally.so/r/nP8vae"},"supported_languages":"English, Simplified Chinese, Traditional Chinese, Japanese","type":"demo","website":null}