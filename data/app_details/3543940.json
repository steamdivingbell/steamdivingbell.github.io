4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3543940/28dd5aaabed66bd6c7e06edea2e09bee92355002/ss_28dd5aaabed66bd6c7e06edea2e09bee92355002.1920x1080.jpg?t=1761073998","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3543940/28dd5aaabed66bd6c7e06edea2e09bee92355002/ss_28dd5aaabed66bd6c7e06edea2e09bee92355002.600x338.jpg?t=1761073998"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3543940/ss_8431c9616eaaf3c8984232c2d2b727867a2a1738.1920x1080.jpg?t=1761073998","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3543940/ss_8431c9616eaaf3c8984232c2d2b727867a2a1738.600x338.jpg?t=1761073998"}],"short_description":"Aspiel: Edge of Chaos is a third-person fantasy Action-RPG. Explore numerous locations ravaged by the dark power of Death, face various creatures consumed by Chaos, and harness the power of Life to save the continent of Aspiel.","steam_appid":3543940,"support_info":{"email":"support@sylphaworks.com","url":"https://sylphaworks.com/Contact/"},"supported_languages":"English<strong>*</strong>, Italian<br><strong>*</strong>languages with full audio support","type":"game","website":"https://sylphaworks.com/Aspiel-Edge-Of-Chaos/"}