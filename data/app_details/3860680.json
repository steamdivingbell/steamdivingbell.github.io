amai.steamstatic.com/store_item_assets/steam/apps/3860680/7142944803839147143feeb1591b6fbe55d6524b/ss_7142944803839147143feeb1591b6fbe55d6524b.1920x1080.jpg?t=1772246026","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3860680/7142944803839147143feeb1591b6fbe55d6524b/ss_7142944803839147143feeb1591b6fbe55d6524b.600x338.jpg?t=1772246026"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3860680/60aa291c3f77474479fe83b8ac73a0dd942ab838/ss_60aa291c3f77474479fe83b8ac73a0dd942ab838.1920x1080.jpg?t=1772246026","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3860680/60aa291c3f77474479fe83b8ac73a0dd942ab838/ss_60aa291c3f77474479fe83b8ac73a0dd942ab838.600x338.jpg?t=1772246026"}],"short_description":"Build, earn, negotiate and think your way to the top! Raise the most famous cyberpunk city in this casual puzzle style citybuilder where corporations dominate the world around you!","steam_appid":3860680,"support_info":{"email":"rizgamescompany@gmail.com","url":""},"supported_languages":"English, Spanish - Spain","type":"game","website":null}