ps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/8bd2067d286dacc8d6c6dabdcddab3ae.poster.avif?t=1768784168\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/8bd2067d286dacc8d6c6dabdcddab3ae.webm?t=1768784168\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/8bd2067d286dacc8d6c6dabdcddab3ae.mp4?t=1768784168\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Some of the available upgrades include:</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Increasing the ball size</p></li><li><p class=\"bb_paragraph\" >Creating a zone that doubles the points of squares</p></li><li><p class=\"bb_paragraph\" >Equipping a laser on the paddle</p></li><li><p class=\"bb_paragraph\" >Vertical projectiles fired by the ball</p></li><li><p class=\"bb_paragraph\" >Installing a jet on the paddle that makes squares worth more points when hit</p></li><li><p class=\"bb_paragraph\" >Launching multiple balls at the same time</p></li><li><p class=\"bb_paragraph\" >Installing fireballs that spin around the main ball</p></li><li><p class=\"bb_paragraph\" >Increasing the points received</p></li><li><p class=\"bb_paragraph\" >And much more!</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Single Player &amp; Local Co-op</h2><p class=\"bb_paragraph\" >Play solo, controlling both paddles yourself, or team up with a friend in local co-op where each player controls one paddle. Work together to blast the shapes!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/1740b46a71e4cd0d6e623e9cc74e1fba.poster.avif?t=1768784168\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/1740b46a71e4cd0d6e623e9cc74e1fba.webm?t=1768784168\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/1740b46a71e4cd0d6e623e9cc74e1fba.mp4?t=1768784168\" type=\"video/mp4\"></video></span></p>","developers":["Vinicius Ventura"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/6c5e4bc3d5c4ac0d201f06803ee00174c001880c/header.jpg?t=1768784168","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3780730/383740474/dd84449c9dad4a7600648119447879a400ef053a/1759366921/dash_av1.mpd?t=1759369274","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3780730/383740474/dd84449c9dad4a7600648119447879a400ef053a/1759366921/dash_h264.mpd?t=1759369274","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3780730/383740474/dd84449c9dad4a7600648119447879a400ef053a/1759366921/hls_264_master.m3u8?t=1759369274","id":257147422,"name":"First Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257147422/1fc394d0fcba50de020fa43d24836e41dd37dd83/movie_600x337.jpg?t=1759369274"}],"name":"Shape Blast","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10+<br></li><li><strong>Processor:</strong> Intel Core i3-2330M<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong>  Intel HD Graphics 3000<br></li><li><strong>DirectX:</strong> Version 10</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Vinicius Ventura"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"ste