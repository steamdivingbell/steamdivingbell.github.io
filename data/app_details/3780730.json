 controls one paddle. Work together to face the waves of enemies!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/1740b46a71e4cd0d6e623e9cc74e1fba.poster.avif?t=1756172507\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/1740b46a71e4cd0d6e623e9cc74e1fba.webm?t=1756172507\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/extras/1740b46a71e4cd0d6e623e9cc74e1fba.mp4?t=1756172507\" type=\"video/mp4\"></video></span></p>","developers":["Vinicius Ventura"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3780730/35f11ec3be8ebc125de93ebb36e3d6b66332d342/header.jpg?t=1756172507","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257147422,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257147422/movie480.mp4?t=1749043727","max":"http://video.akamai.steamstatic.com/store_trailers/257147422/movie_max.mp4?t=1749043727"},"name":"First Gameplay Video","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257147422/82b98286b8b875e3cba798ae85f7f2eb36c2b8b5/movie_600x337.jpg?t=1749043727","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257147422/movie480_vp9.webm?t=1749043727","max":"http://video.akamai.steamstatic.com/store_trailers/257147422/movie_max_vp9.webm?t=1749043727"}}],"name":"Shape Blast","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10+<br></li><li><strong>Processor:</strong> Intel Core i3-2330M<br></li>