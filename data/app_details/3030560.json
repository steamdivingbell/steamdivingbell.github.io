ore_item_assets/steam/apps/3030560/01eec8dad89f5d1ea809b55bfa3e43b1f4cf30c8/ss_01eec8dad89f5d1ea809b55bfa3e43b1f4cf30c8.600x338.jpg?t=1770594044"}],"short_description":"Sloppy Forgeries is a fast-paced competitive painting game. Practice your skills by butchering iconic masterpieces in one of the few drawing games that measures accuracy pixel-by-pixel in real-time.","steam_appid":3030560,"support_info":{"email":"jonah@playfulsystems.com","url":"https://playfulsystems.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://sloppyforgeries.com/"}