9e2404fba2a4017e08bffee73c72473276c/ss_ac8269e2404fba2a4017e08bffee73c72473276c.1920x1080.jpg?t=1759340303","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3811000/ac8269e2404fba2a4017e08bffee73c72473276c/ss_ac8269e2404fba2a4017e08bffee73c72473276c.600x338.jpg?t=1759340303"}],"short_description":"Balance. Patience. Perfection. The Cairns Demo gives the complete experience of the full game, but is set in a unique rural Outback Australia level exclusive to the demo.","steam_appid":3811000,"support_info":{"email":"contact@kaijuStomp.com","url":"https://www.kaijuStomp.com"},"supported_languages":"English","type":"demo","website":null}