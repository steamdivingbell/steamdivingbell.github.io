 stunning detail. </p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1431720/extras/Comp_1_4.gif?t=1728902357\" /></p><p class=\"bb_paragraph\">  </p><p class=\"bb_paragraph\"> </p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1431720/extras/spin7.png?t=1728902357\" /></p><p class=\"bb_paragraph\">Stone Lantern Games is a Boston-based studio comprised of 4 MIT graduates. Like a gamer choosing a character class, each engineer on the team specializes in one of four proficiencies: Visual Effects, Art, Music, or Narrative.  </p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1431720/extras/end_slate.png?t=1728902357\" /></p>","developers":["Stone Lantern Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1431720/header.jpg?t=1728902357","is_free":true,"legal_notice":"\u00a92020 Developed by Stone Lantern Games, LLC. Published by PQube Limited.","linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":256807317,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/256807317/movie480.mp4?t=1603967110","max":"http://video.akamai.steamstatic.com/store_trailers/256807317/movie_max.mp4?t=1603967110"},"name":"Announcement Trailer Final","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256807317/movie.293x165.jpg?t=1603967110","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/256807317/movie480_vp9.webm?t=1603967110","max":"http://video.akamai.steamstatic.com/store_trailers/256807317/movie_max_vp9.webm?t=1603967110"}}],"name":"E