4003470/f71270ea29c1755f432484ae97b025264f96f6d7/ss_f71270ea29c1755f432484ae97b025264f96f6d7.600x338.jpg?t=1766261443"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4003470/548e50fdea934d3d30799c22419b3b92e5639c7f/ss_548e50fdea934d3d30799c22419b3b92e5639c7f.1920x1080.jpg?t=1766261443","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4003470/548e50fdea934d3d30799c22419b3b92e5639c7f/ss_548e50fdea934d3d30799c22419b3b92e5639c7f.600x338.jpg?t=1766261443"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4003470/220d5b621f5c82b4d7b863984865691878e7c4a2/ss_220d5b621f5c82b4d7b863984865691878e7c4a2.1920x1080.jpg?t=1766261443","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4003470/220d5b621f5c82b4d7b863984865691878e7c4a2/ss_220d5b621f5c82b4d7b863984865691878e7c4a2.600x338.jpg?t=1766261443"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4003470/90ab02e9aa956bd7d786ae8bf0f0674e2e0c5081/ss_90ab02e9aa956bd7d786ae8bf0f0674e2e0c5081.1920x1080.jpg?t=1766261443","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4003470/90ab02e9aa956bd7d786ae8bf0f0674e2e0c5081/ss_90ab02e9aa956bd7d786ae8bf0f0674e2e0c5081.600x338.jpg?t=1766261443"}],"short_description":"Journey through snow, rain, and dust storms as a lost fox searching for its memories beyond death. Solid Liquid Gas is a haunting exploration of the afterlife, where each element shapes your path and brings you closer to uncovering the truth of that day.","steam_appid":4003470,"support_info":{"email":"shadowbitegames@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}