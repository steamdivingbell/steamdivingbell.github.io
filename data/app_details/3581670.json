_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581670/6b956a1fce90fef9df7a0ab567d9be2382bd8d4e/ss_6b956a1fce90fef9df7a0ab567d9be2382bd8d4e.1920x1080.jpg?t=1756916723","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3581670/6b956a1fce90fef9df7a0ab567d9be2382bd8d4e/ss_6b956a1fce90fef9df7a0ab567d9be2382bd8d4e.600x338.jpg?t=1756916723"}],"short_description":"A turn-based roguelite where you build and command a team, or let them auto-battle through endless, procedurally generated floors. Level up your heroes, unlock powerful upgrades, collect skill scrolls, craft with rare materials, and stack buffs to conquer each floor.","steam_appid":3581670,"support_info":{"email":"virtualswordx@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}