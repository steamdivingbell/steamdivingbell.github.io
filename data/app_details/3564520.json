 muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3564520/extras/aa68268a7aaef781de850ba48c9f563a.poster.avif?t=1773715711\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3564520/extras/aa68268a7aaef781de850ba48c9f563a.webm?t=1773715711\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3564520/extras/aa68268a7aaef781de850ba48c9f563a.mp4?t=1773715711\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Change the past.</strong> <br><strong>Protect the present. </strong>   <br><strong>Save the future.</strong></p>","developers":["Omnaya Studios"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3564520/e3eb3afcfe0dee97efb531d96cb410bb65161ced/header.jpg?t=1773715711","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mavericks 10.9 or later<br></li><li><strong>Processor:</strong> Dual Core 2.4GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3564520/857382/3f48ee5a110457ea003e3b3c71c11572af897819/1750839890/dash_av1.mpd?t=1745465930","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3564520/857382/3f48ee5a110457ea003e3b3c71c11572af897819/1750839890/dash_h264.mpd?t=1745465930","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3564520/857382/3f48ee5a110457ea003e3b3c71c11572af897819/1750839890/hls_264_master.m3u8?t=1745465930","id":257118307,"name":"Back In Time - Official Announcement Teaser","thumbnail":"https://s