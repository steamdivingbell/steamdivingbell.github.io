ic.com/store_item_assets/steam/apps/3339810/extras/0a6185105ee77c2abc37e9b7e68c059a.mp4?t=1766068764\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>THANKS FOR CLICKING</strong></h2><p class=\"bb_paragraph\" >Now put a hat on your ball and get rolling.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339810/extras/82ccfd16e031baff2a7606ad5cd192c6.poster.avif?t=1766068764\" width=600 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339810/extras/82ccfd16e031baff2a7606ad5cd192c6.webm?t=1766068764\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339810/extras/82ccfd16e031baff2a7606ad5cd192c6.mp4?t=1766068764\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Note from the developer:</h2><p class=\"bb_paragraph\" >Ballest is built by a two-person team, but we have big plans for the future of Ballest. </p><p class=\"bb_paragraph\" >If you give it a shot, I hope you feel the magic we're trying to make.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Gumption Games"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Racing","id":"9"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339810/8a44ddfba01e013484cfae2da2d2fa0256886622/header.jpg?t=1766068764","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3339810/1090293376/695cb38e2fd230c8b2c3484425a530b590553d4b/1766003318/dash_av1.mpd?t=1766004002","dash_h264":"https://video.akamai.stea