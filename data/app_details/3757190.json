n the game.</p><h2 class=\"bb_tag\" >Leaderboards</h2><p class=\"bb_paragraph\" >The game also includes leaderboards to allow players to rank amongst their friends and the world. Leaderboards will be progression and time based.</p>","developers":["NYX Digital Ltd"],"genres":[{"description":"Casual","id":"4"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757190/d999ea8bc8bb28aff4156a375d14c2e03ae2e3ef/header.jpg?t=1756448231","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3757190/463195002/ff9016342312b9d41a84e85e5c8404dca66c031b/1750383094/dash_av1.mpd?t=1748853850","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3757190/463195002/ff9016342312b9d41a84e85e5c8404dca66c031b/1750383094/dash_h264.mpd?t=1748853850","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3757190/463195002/ff9016342312b9d41a84e85e5c8404dca66c031b/1750383094/hls_264_master.m3u8?t=1748853850","id":257147105,"name":"Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257147105/dc12eddc41f39faeb23fcc4347f84f81c07da281/movie_600x337.jpg?t=1748853850"}],"name":"Sudoku Mania","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Sudoku Mania - <span class=\"discount_original_price\">$4.99</span> $0.99 USD","packageid":1322167,"percent_savings":0,"percent_savings_text":"-80% ","price_in_cents_with_discount":99}],"title":"Buy Sudoku Mania"}],"packages":[1322167],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7<br></li><li><strong>Processor:</strong> Intel Core i5-2300 | AMD FX-6350<br></li><li><strong>Memory:</strong> 4 GB