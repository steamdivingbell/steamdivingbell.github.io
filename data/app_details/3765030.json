 loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3765030/extras/b127e214c56d4841d506afb2ead2e541.poster.avif?t=1756129550\" width=780 height=218 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3765030/extras/b127e214c56d4841d506afb2ead2e541.webm?t=1756129550\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3765030/extras/b127e214c56d4841d506afb2ead2e541.mp4?t=1756129550\" type=\"video/mp4\"></video></span><br><strong>What Awaits You</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" > <strong>Topological Puzzles</strong></p><p class=\"bb_paragraph\" >Take a single step and reappear in the room\u2019s far corner. Watch, experiment, and deduce the hidden laws of non-Euclidean space.</p></li><li><p class=\"bb_paragraph\" ><strong>Silence Instead of Tutorials</strong></p><p class=\"bb_paragraph\" >Every rule you master is one you uncover yourself. No pop-ups, no glowing arrows \u2014 only time to think and the thrill of a genuine \u201caha!\u201d moment. </p></li><li><p class=\"bb_paragraph\" ><strong>Hand-Crafted Atmosphere</strong></p><p class=\"bb_paragraph\" >Each scene is filled with with period detail, while a minimalist original ambient score creates a calm, reflective mood that lets every discovery resonate.</p></li></ul>","developers":["Strunov Studio"],"genres":[{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3765030/6d0a1c9496c9a4403d1b312470ad2a4002a1eccc/header.jpg?t=1756129550","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"das