b9f151f0d2b0dabb0a447af56dd50fb5409c5.1920x1080.jpg?t=1743548486","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1903560/55fb9f151f0d2b0dabb0a447af56dd50fb5409c5/ss_55fb9f151f0d2b0dabb0a447af56dd50fb5409c5.600x338.jpg?t=1743548486"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1903560/94faddaa2814417acc7ca4be7a4ca58bc308d518/ss_94faddaa2814417acc7ca4be7a4ca58bc308d518.1920x1080.jpg?t=1743548486","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1903560/94faddaa2814417acc7ca4be7a4ca58bc308d518/ss_94faddaa2814417acc7ca4be7a4ca58bc308d518.600x338.jpg?t=1743548486"}],"short_description":"Atomic Picnic is a Roguelike Shooter with Explosive Synergy! Dominate chaotic battles by cutting through swarms of monsters! Team up with friends or take them on solo! Unleash devastating combos by combining and evolving powerful upgrades to conquer The Zone.","steam_appid":1903560,"support_info":{"email":"contact@bitcake.studio","url":"https://bitcake.studio"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Portuguese - Brazil, Simplified Chinese, Traditional Chinese","type":"game","website":null}