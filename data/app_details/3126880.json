80/98d7bedd472a19028a0d4daf05ea5a26a1c27b04/ss_98d7bedd472a19028a0d4daf05ea5a26a1c27b04.600x338.jpg?t=1749199820"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126880/1a1a57e3594bf51520a713c9eff6df8706f5011c/ss_1a1a57e3594bf51520a713c9eff6df8706f5011c.1920x1080.jpg?t=1749199820","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126880/1a1a57e3594bf51520a713c9eff6df8706f5011c/ss_1a1a57e3594bf51520a713c9eff6df8706f5011c.600x338.jpg?t=1749199820"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126880/6eb175b6e9b0d744dac0aecde99283b8dd14d8d1/ss_6eb175b6e9b0d744dac0aecde99283b8dd14d8d1.1920x1080.jpg?t=1749199820","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126880/6eb175b6e9b0d744dac0aecde99283b8dd14d8d1/ss_6eb175b6e9b0d744dac0aecde99283b8dd14d8d1.600x338.jpg?t=1749199820"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126880/25e0d2ba510033b9e041994f429fa4a131a12ec3/ss_25e0d2ba510033b9e041994f429fa4a131a12ec3.1920x1080.jpg?t=1749199820","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126880/25e0d2ba510033b9e041994f429fa4a131a12ec3/ss_25e0d2ba510033b9e041994f429fa4a131a12ec3.600x338.jpg?t=1749199820"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126880/b3411b9ac4cf2258b299e8317913090059d0b8ce/ss_b3411b9ac4cf2258b299e8317913090059d0b8ce.1920x1080.jpg?t=1749199820","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126880/b3411b9ac4cf2258b299e8317913090059d0b8ce/ss_b3411b9ac4cf2258b299e8317913090059d0b8ce.600x338.jpg?t=1749199820"}],"short_description":"Beneath The Six is a traditional roguelike set in a fractured world long-forgotten by space and time. Collect powerful dice sets and use them to forge valiant adventurers to explore daily randomised dungeons full of trinkets, traps and treasures.","steam_appid":3126880,"support_info":{"email":"gamesupport@magicave.io","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}