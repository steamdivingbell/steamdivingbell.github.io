ng-term progression. Prestige, skill synergy, and exploration come together in a steady loop that continues to grow with you.</p><p class=\"bb_paragraph\" ></p>","developers":["Bloobs_Dev"],"dlc":[3263170],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2942780/c992c21814fba6ebb3792dc0fb8d90e6223cd16b/header.jpg?t=1771458855","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2942780/106986205/68841cfd657ed8b84f42bec59c609f5d76b6cbba/1760467138/dash_av1.mpd?t=1760467809","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2942780/106986205/68841cfd657ed8b84f42bec59c609f5d76b6cbba/1760467138/dash_h264.mpd?t=1760467809","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2942780/106986205/68841cfd657ed8b84f42bec59c609f5d76b6cbba/1760467138/hls_264_master.m3u8?t=1760467809","id":257217831,"name":"Bloobs Adventure Idle Trailer !!! New","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257217831/a929f2ab3820c36f3cff8f643fff70680d57dbe8/movie_600x337.jpg?t=1760467809"}],"name":"Bloobs Adventure Idle","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Bloobs Adventure Idle - $7.99 USD","packageid":1048048,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":799}],"title":"Buy Bloobs Adventure Idle"}],"packages":[1048048],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:<