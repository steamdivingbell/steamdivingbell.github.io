pes and explore a fantasy world of Sword and Sorcery.","steam_appid":2488540,"support_info":{"email":"crimsoncapesgame@gmail.com","url":"https://crimsoncapes.com/"},"supported_languages":"English","type":"game","website":"https://crimsoncapes.com/"}