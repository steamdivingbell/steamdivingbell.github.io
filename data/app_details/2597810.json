1436e608e7302ca5f4ff/ss_3b369592581a193319361436e608e7302ca5f4ff.600x338.jpg?t=1770810562"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2597810/43d0079fd5610049ca0841f535a493d0e0a88b5e/ss_43d0079fd5610049ca0841f535a493d0e0a88b5e.1920x1080.jpg?t=1770810562","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2597810/43d0079fd5610049ca0841f535a493d0e0a88b5e/ss_43d0079fd5610049ca0841f535a493d0e0a88b5e.600x338.jpg?t=1770810562"}],"short_description":"Afallon is a single-player RPG with the feel of an MMO. Choose your class and race to forge a unique character, explore a large open world with diverse zones and biomes, and experience a living world that changes based on your actions.","steam_appid":2597810,"support_info":{"email":"stargazinginteractive@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}