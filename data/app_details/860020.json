nline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/860020/extras/6a2997fd14fc9382f25d0a5b53af81c2.poster.avif?t=1766478288\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/860020/extras/6a2997fd14fc9382f25d0a5b53af81c2.webm?t=1766478288\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/860020/extras/6a2997fd14fc9382f25d0a5b53af81c2.mp4?t=1766478288\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>A Sandbox of Possibilities</strong></h2><p class=\"bb_paragraph\" >EXFIL is more than just its core game modes. Players have the freedom to customize their experience by adjusting a wide range of game parameters - from AI presence on the map to time of day, weather, available weapons, and respawn rules - allowing them to create unique challenges, and playstyles to suit any preference.<br><br>Additional Features</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >NPC opposition forces<br>Global stats tracking<br>Loadout customization</p></li></ul><h2 class=\"bb_tag\" ><strong>Early Access and Beyond</strong></h2><p class=\"bb_paragraph\" >The Early Access launch is just the beginning. Over the next 12-18 months, we\u2019re focused on expanding the toolset, adding new features and building a game shaped by the community.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/860020/extras/ef14da7134371bf478179bcf84f6f74d.poster.avif?t=1766478288\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/860020/extras/ef14da7134371bf478179bcf84f6f74d.webm?t=1766478288\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/860020/extras/ef14da7134371bf478179bcf84f6f74d.mp4?t=1766478288\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Whether you're looking for quick, intense battles or tools to create your own scenarios, EXFIL is your playground for tactical combat <i>without</i> compromise.</p><p class=\"bb_paragraph\" ></p>","developers":["Tiny Leviathan"],"dlc":[3370650,4246800],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/860020/b06b43e3f8b44984d8c35839f3612b90f0a50680/header.jpg?t=1766478288","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/860020/1065419244/7f93a52b6b183f98ac67e4aa14a3fdb4ccda2863/1766165649/dash_av1.mpd?t=1766169080","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/860020/1065419244/7f93a52b6b183f98ac67e4aa14a3fdb4ccda2863/1766165649/dash_h264.mpd?t=1766169080","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/860020/1065419244/7f93a52b6b183f98ac67e4aa14a3fdb4ccda2863/1766165649/hls_264_master.m3u8?t=1766169080","id":257252883,"name":"Field Report 4","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257252883/bb6463c765ca2e52139cbe49ff7af96a901918ab/movie_600x337.jpg?t=1766169080"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/860020/1521759987/4ffc4fef6312fd49015afec01530604848f91e97/1766436858/dash_av1.mpd?t=176