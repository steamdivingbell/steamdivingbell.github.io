ai.steamstatic.com/store_item_assets/steam/apps/2269590/extras/50d337e8c266affda11bd547b28ca3d3.poster.avif?t=1769051990\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2269590/extras/50d337e8c266affda11bd547b28ca3d3.webm?t=1769051990\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2269590/extras/50d337e8c266affda11bd547b28ca3d3.mp4?t=1769051990\" type=\"video/mp4\"></video></span><br></li><li>Players can fish for leisure while waiting for crops to grow, either to sell for additional income or to find items in specific areas.</li></ul><h2 class=\"bb_tag\" ><strong>Plan for future updates</strong></h2><ul class=\"bb_ul\"><li>Add cooking feature<br></li><li>More types of vegetables that can be planted<br></li><li>Introduce a mission from a village NPC<br></li><li>More stories and NPC conversations<br></li><li>Add more equipment and facilities<br></li><li>Improve environmental details and introduce various buildings<br></li><li>Introduce dangerous animals in the area<br></li><li>Character's dexterity in the game</li></ul>","developers":["Malongnan Studio"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2269590/header.jpg?t=1769051990","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2269590/594455/5747b61ed146a41adabf9c178056431d8c1ed3a9/1751097025/dash_av1.mpd?t=1691297297","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2269590/594455/5747b61ed146a41adabf9c178056431d8c1ed3a9/1751097025/dash_h264.mpd?t=1691297297","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2269590/594455/5747b61ed146a41adabf9c178056431d8c1ed3a9/1751097025/hls_264_master.m3u8?t=1691297