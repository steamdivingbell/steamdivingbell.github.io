tore_item_assets/steam/apps/3281500/cbf143501dda13298eb55ec2f339006fbe7c4376/ss_cbf143501dda13298eb55ec2f339006fbe7c4376.1920x1080.jpg?t=1773136266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/cbf143501dda13298eb55ec2f339006fbe7c4376/ss_cbf143501dda13298eb55ec2f339006fbe7c4376.600x338.jpg?t=1773136266"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/25910f334e5476a7c20c1e616bd62ba8e92ddee5/ss_25910f334e5476a7c20c1e616bd62ba8e92ddee5.1920x1080.jpg?t=1773136266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/25910f334e5476a7c20c1e616bd62ba8e92ddee5/ss_25910f334e5476a7c20c1e616bd62ba8e92ddee5.600x338.jpg?t=1773136266"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/ss_22ecbd024adab5af5124bd2f93e9aaaaa8d83bfe.1920x1080.jpg?t=1773136266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/ss_22ecbd024adab5af5124bd2f93e9aaaaa8d83bfe.600x338.jpg?t=1773136266"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/1c66a2b7dced580a23e19159110fb2f1b1bca763/ss_1c66a2b7dced580a23e19159110fb2f1b1bca763.1920x1080.jpg?t=1773136266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/1c66a2b7dced580a23e19159110fb2f1b1bca763/ss_1c66a2b7dced580a23e19159110fb2f1b1bca763.600x338.jpg?t=1773136266"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/ss_36deb58d08b61199c22bef6ca68d68d84904a657.1920x1080.jpg?t=1773136266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281500/ss_36deb58d08b61199c22bef6ca68d68d84904a657.600x338.jpg?t=1773136266"}],"short_description":"Avalon: Rise of the Templars is an open-world co-op action RPG set in a fantasy medieval world inspired by the legends of the Knights Templar. Explore dangerous lands filled with mystery, battle powerful enemies alongside friends, and earn rare gear through PvE adventures and 4\u20138 player raids.","steam_appid":3281500,"support_info":{"email":"info@avalonthegame.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Polish, Portuguese - Brazil, Portuguese - Portugal, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.avalonthegame.com/"}