3724"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3433940/1446c389b748d715e632432d3627d2fe0e6d75bc/ss_1446c389b748d715e632432d3627d2fe0e6d75bc.1920x1080.jpg?t=1760523724","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3433940/1446c389b748d715e632432d3627d2fe0e6d75bc/ss_1446c389b748d715e632432d3627d2fe0e6d75bc.600x338.jpg?t=1760523724"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3433940/d893184ff86a2c00fe9bf8c6016ea527bcf7437e/ss_d893184ff86a2c00fe9bf8c6016ea527bcf7437e.1920x1080.jpg?t=1760523724","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3433940/d893184ff86a2c00fe9bf8c6016ea527bcf7437e/ss_d893184ff86a2c00fe9bf8c6016ea527bcf7437e.600x338.jpg?t=1760523724"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3433940/80a764036c5cd5dc4afa7233ed1d89698993d5e0/ss_80a764036c5cd5dc4afa7233ed1d89698993d5e0.1920x1080.jpg?t=1760523724","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3433940/80a764036c5cd5dc4afa7233ed1d89698993d5e0/ss_80a764036c5cd5dc4afa7233ed1d89698993d5e0.600x338.jpg?t=1760523724"}],"short_description":"A visual novel/roguelike hybrid where a simple mission spirals into a cannibalistic odyssey. You'll struggle as a fragile human, blood-soaked knight, or flesh-devouring Forsaker. Devour or be devoured\u2014yet your fate dangles by unseen strings. Choose: cling to this broken world... or forsake it.","steam_appid":3433940,"support_info":{"email":"3992109027@qq.com","url":""},"supported_languages":"English, Simplified Chinese, Traditional Chinese","type":"game","website":null}