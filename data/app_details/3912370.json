.akamai.steamstatic.com/store_item_assets/steam/apps/3912370/6ecb88526600c752b20c04b3cf2371cb13aed0c6/ss_6ecb88526600c752b20c04b3cf2371cb13aed0c6.1920x1080.jpg?t=1757694949","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3912370/6ecb88526600c752b20c04b3cf2371cb13aed0c6/ss_6ecb88526600c752b20c04b3cf2371cb13aed0c6.600x338.jpg?t=1757694949"}],"short_description":"Enter the world of John Beer in this psychotic, fast-paced roguelike where you drink beer to stay alive! Dash as fast as you can through unique and crazy worlds to break the vicious cycle. So what are you waiting for!? LIVE LIFE. EVERY GOLDEN MINUTE OF IT!","steam_appid":3912370,"support_info":{"email":"beercrushhelp@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}