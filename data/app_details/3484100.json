m/apps/3484100/extras/a88cb80a1ab1529d3e2da88159cb5fb4.avif?t=1770892711\" width=960 height=80 /></span></p><p class=\"bb_paragraph\" >Combat is not everything.</p><p class=\"bb_paragraph\" >In this ever-changing underground palace, various mysterious events and secret rooms are hidden. Mysterious merchants, ancient altars, unknown gambles... Every corner hides opportunity or crisis, waiting for you to discover.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Bold Fish"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484100/238403ac7f7cf50e8751ea812bc35a0eb8488dde/header.jpg?t=1770892711","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3484100/1708800227/5706a2042664d0975b5fd682cd1c712b7e5467f5/1767780528/dash_av1.mpd?t=1767781158","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3484100/1708800227/5706a2042664d0975b5fd682cd1c712b7e5467f5/1767780528/dash_h264.mpd?t=1767781158","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3484100/1708800227/5706a2042664d0975b5fd682cd1c712b7e5467f5/1767780528/hls_264_master.m3u8?t=1767781158","id":257261001,"name":"\u6302\u7075 pv_newfes","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257261001/85e52733a67ee7af7e60609fe061700c251e65fc/movie_600x337.jpg?t=1767781158"}],"name":"Bait Soul","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 +<br></li><li><strong>Processor:</strong> 2.5Ghz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> 128MB, OpenGL 3+<br></li><li><strong>Storage:</strong> 1 GB avail