 it\u2019s your very own journey.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3430280/extras/39714f10c04465f1ad3d8cd1ddb199b1.poster.avif?t=1757770016\" width=800 height=320 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3430280/extras/39714f10c04465f1ad3d8cd1ddb199b1.webm?t=1757770016\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3430280/extras/39714f10c04465f1ad3d8cd1ddb199b1.mp4?t=1757770016\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>","developers":["THE ROOF Interactive"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3430280/a555328ca1dab7d3c63f119eb5c007fc31eb7778/header.jpg?t=1757770016","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257097467,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257097467/movie480.mp4?t=1740681584","max":"http://video.akamai.steamstatic.com/store_trailers/257097467/movie_max.mp4?t=1740681584"},"name":"Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257097467/1ae22351959240f9a72a59961eda78e978f1d356/movie_600x337.jpg?t=1740681584","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257097467/movie480_vp9.webm?t=1740681584","max":"http://video.akamai.steamstatic.com/store_trailers/257097467/movie_max_vp9.webm?t=1740681584"}}],"name":"Seaward","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3 or comparable<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li