d?","steam_appid":3292110,"support_info":{"email":"contact@moonmind.studio","url":""},"supported_languages":"English<strong>*</strong>, Spanish - Spain, Simplified Chinese, Portuguese - Brazil, Russian<br><strong>*</strong>languages with full audio support","type":"game","website":"https://moonmind.studio/"}