in?<br>And just one final wish\u2014<br>\u201cPlease\u2026 just don\u2019t sacrifice your love.\u201d</p><h2 class=\"bb_tag\" >  </h2>","developers":["\u3048\u3044\u3068\u3048\u3044\u3069","\u7d05\u828b\u3051\u3093\u3074"],"genres":[{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3839720/feaa18752dfb8b8331c9eb25c6efee0c0c0ea032/header.jpg?t=1754134346","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3839720/2127127204/959a2fd6042208382dc1d28cc5c2273e592c7d89/1753948819/dash_av1.mpd?t=1753950947","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3839720/2127127204/959a2fd6042208382dc1d28cc5c2273e592c7d89/1753948819/dash_h264.mpd?t=1753950947","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3839720/2127127204/959a2fd6042208382dc1d28cc5c2273e592c7d89/1753948819/hls_264_master.m3u8?t=1753950947","id":257176123,"name":"PV_01_en","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257176123/58c742d45134975c66dc3b7d90842ede99342c54/movie_600x337.jpg?t=1753950947"}],"name":"Compensated Girl","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows11<br></li><li><strong>Processor:</strong> Intel Core i3<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows11<br></li><li><strong>Processor:</strong>  Intel Core i3<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Kodansha"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"