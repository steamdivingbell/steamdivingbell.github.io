umbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3904480/a3b2b773c6e721ffe8d8b4df24d3a5dc33238b6d/ss_a3b2b773c6e721ffe8d8b4df24d3a5dc33238b6d.600x338.jpg?t=1761774457"}],"short_description":"Be the person you needed. Brew tea, listen well, and guide branching stories in a narrative slice-of-life about showing up when it matters. No perfect answers. Only your choices and what they set in motion.","steam_appid":3904480,"support_info":{"email":"support@thiswarmplace.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}