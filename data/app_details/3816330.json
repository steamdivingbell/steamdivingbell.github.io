265c20a1c4471f4b0586bd0647dea100.600x338.jpg?t=1764120494"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816330/5f706a8ac59555d41c20d057cded89e857c587a8/ss_5f706a8ac59555d41c20d057cded89e857c587a8.1920x1080.jpg?t=1764120494","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816330/5f706a8ac59555d41c20d057cded89e857c587a8/ss_5f706a8ac59555d41c20d057cded89e857c587a8.600x338.jpg?t=1764120494"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816330/c09d5844f8d016f96b71cab453c7a44c0c80209b/ss_c09d5844f8d016f96b71cab453c7a44c0c80209b.1920x1080.jpg?t=1764120494","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816330/c09d5844f8d016f96b71cab453c7a44c0c80209b/ss_c09d5844f8d016f96b71cab453c7a44c0c80209b.600x338.jpg?t=1764120494"}],"short_description":"A grim after-death workplace deckbuilder/puzzle CCG about crafting the right deck to kill gods. Expect to lose, learn, and revise your mistakes - just like any other job.","steam_appid":3816330,"support_info":{"email":"finalnoticegame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}