5d199550bd15a14e019acc436a5dff.1920x1080.jpg?t=1750269686","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632690/cad0893e235d199550bd15a14e019acc436a5dff/ss_cad0893e235d199550bd15a14e019acc436a5dff.600x338.jpg?t=1750269686"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632690/3b236459f52f73bbfeb558c7afe7ab449dd38d9e/ss_3b236459f52f73bbfeb558c7afe7ab449dd38d9e.1920x1080.jpg?t=1750269686","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2632690/3b236459f52f73bbfeb558c7afe7ab449dd38d9e/ss_3b236459f52f73bbfeb558c7afe7ab449dd38d9e.600x338.jpg?t=1750269686"}],"short_description":"FoMO is a first-person psychological horror game with random mazes, a haunting atmosphere, and disturbing retro visuals. No weapons\u2026 all you can do is run, hide, and survive the monsters that have taken over your life. But remember: your choices have consequences.","steam_appid":2632690,"support_info":{"email":"quantic.monkey.studio@gmail.com","url":""},"supported_languages":"English, Portuguese - Brazil","type":"game","website":"https://quanticmonkey.com/"}