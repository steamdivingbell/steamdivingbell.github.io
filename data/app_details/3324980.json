"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324980/b47c1c9fe154a6666692283be1681b9070ba1033/ss_b47c1c9fe154a6666692283be1681b9070ba1033.1920x1080.jpg?t=1755706089","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324980/b47c1c9fe154a6666692283be1681b9070ba1033/ss_b47c1c9fe154a6666692283be1681b9070ba1033.600x338.jpg?t=1755706089"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324980/4d97c9cfc45d94132a5583567814102004f6048a/ss_4d97c9cfc45d94132a5583567814102004f6048a.1920x1080.jpg?t=1755706089","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324980/4d97c9cfc45d94132a5583567814102004f6048a/ss_4d97c9cfc45d94132a5583567814102004f6048a.600x338.jpg?t=1755706089"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324980/208631329161d6a83b4680ce8abe7dc0551dd599/ss_208631329161d6a83b4680ce8abe7dc0551dd599.1920x1080.jpg?t=1755706089","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324980/208631329161d6a83b4680ce8abe7dc0551dd599/ss_208631329161d6a83b4680ce8abe7dc0551dd599.600x338.jpg?t=1755706089"}],"short_description":"Inspired by horror and B-movies from the '80s, Everdark takes us to a city infested with vampires. Armed with stakes, garlic, crosses, holy water, and an arsenal of firearms and melee weapons, we'll fight our way through this shooter that blends classic survival horror with an oppressive atmosphere.","steam_appid":3324980,"support_info":{"email":"Esdipgames@esdip.online","url":""},"supported_languages":"English, Spanish - Spain","type":"game","website":null}