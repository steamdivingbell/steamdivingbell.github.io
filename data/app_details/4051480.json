338.jpg?t=1758896015"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4051480/515f258e67d55c165dbf36d646ee7eff5f612b75/ss_515f258e67d55c165dbf36d646ee7eff5f612b75.1920x1080.jpg?t=1758896015","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4051480/515f258e67d55c165dbf36d646ee7eff5f612b75/ss_515f258e67d55c165dbf36d646ee7eff5f612b75.600x338.jpg?t=1758896015"}],"short_description":"A first-person investigative game set in a drowned village. Explore abandoned homes, speak with the last remaining locals, and capture through your lens the destruction left behind by the toxic sludge. Gather evidence, follow every clue, and uncover the truth hidden beneath silence and decay.","steam_appid":4051480,"support_info":{"email":"","url":"https://chainwolfgamedev.com/contact/"},"supported_languages":"English<strong>*</strong>, Romanian<br><strong>*</strong>languages with full audio support","type":"demo","website":"https://chainwolfgamedev.com/geamana-village/"}