shared.akamai.steamstatic.com/store_item_assets/steam/apps/2207350/ss_9441f70b761cbb3d6291a5942c15ac51acaa74ce.600x338.jpg?t=1763694184"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2207350/ss_97e3014a5640e6ab1aaba7b19c71663fcb6f92d4.1920x1080.jpg?t=1763694184","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2207350/ss_97e3014a5640e6ab1aaba7b19c71663fcb6f92d4.600x338.jpg?t=1763694184"}],"short_description":"As a counselor in a mysterious facility, you are to examine children with strange powers and fill in their &quot;Paranormal Records&quot;. In this story-based, choice-driven game, you will have to pry open your subjects' minds... but what you find inside them could prove dangerous.","steam_appid":2207350,"support_info":{"email":"info-gcl@kodansha.co.jp","url":"https://creatorslab.kodansha.co.jp/game/"},"supported_languages":"English, Japanese","type":"game","website":null}