paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2710530/extras/ea6aa4b4ef4f055bf7fb128a59ce1414.poster.avif?t=1771582019\" width=600 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2710530/extras/ea6aa4b4ef4f055bf7fb128a59ce1414.webm?t=1771582019\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2710530/extras/ea6aa4b4ef4f055bf7fb128a59ce1414.mp4?t=1771582019\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>","developers":["Monte de shot"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2710530/2ee1dddc4be038659237ac80c9d662411eab6ac1/header.jpg?t=1771582019","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> modern Linux distribution<br></li><li><strong>Processor:</strong> Quad-core processor (e.g., Intel i5-4th generation or equivalent AMD processor)<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Dedicated GPU with Vulkan support (e.g., NVIDIA GTX 600 series / AMD Radeon HD 7000 series or newer)<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> latest version of Linux distribution<br></li><li><strong>Processor:</strong> Intel i7-7th generation or equivalent AMD Ryzen processor<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1000 series / AMD RX 500 series or newer<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><