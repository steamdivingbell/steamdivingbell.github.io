c0e3b2a7.1920x1080.jpg?t=1762298576","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4030020/779186a10a7f8d92b2677c4202c96d40c0e3b2a7/ss_779186a10a7f8d92b2677c4202c96d40c0e3b2a7.600x338.jpg?t=1762298576"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4030020/5ddb09a8c70c5f7760c8411217e28e2dae0588a9/ss_5ddb09a8c70c5f7760c8411217e28e2dae0588a9.1920x1080.jpg?t=1762298576","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4030020/5ddb09a8c70c5f7760c8411217e28e2dae0588a9/ss_5ddb09a8c70c5f7760c8411217e28e2dae0588a9.600x338.jpg?t=1762298576"}],"short_description":"A Thread Between is a Single-Player, Grid-Based, Isometric Puzzle Game. Solve over 50 handcrafted puzzles across a fragmented Timeline, corrupting unstable branches, collapsing Anomalies, and opening Quantum Locks to restore the one true Timeline.","steam_appid":4030020,"support_info":{"email":"kenomahn@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}