d.akamai.steamstatic.com/store_item_assets/steam/apps/3337840/88bee6e1d3994ad82164dd5a6be228c69a8ea462/ss_88bee6e1d3994ad82164dd5a6be228c69a8ea462.1920x1080.jpg?t=1741160357","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337840/88bee6e1d3994ad82164dd5a6be228c69a8ea462/ss_88bee6e1d3994ad82164dd5a6be228c69a8ea462.600x338.jpg?t=1741160357"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337840/27159a220eb968f235595b1f4783d6aed31e44ae/ss_27159a220eb968f235595b1f4783d6aed31e44ae.1920x1080.jpg?t=1741160357","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337840/27159a220eb968f235595b1f4783d6aed31e44ae/ss_27159a220eb968f235595b1f4783d6aed31e44ae.600x338.jpg?t=1741160357"}],"short_description":"Dodge through colorful bullet patterns as you shoot down hoards of enemies in this arcade-style scrolling shooter bullet hell about magic dragon girls! Uncover a tragic story about acceptance as you overcome intense challenges that test both your skills and memory.","steam_appid":3337840,"support_info":{"email":"mongo@noneedforflowers.com","url":""},"supported_languages":"English","type":"game","website":"https://noneedforflowers.com"}