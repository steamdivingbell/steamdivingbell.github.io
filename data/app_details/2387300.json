, rhythmic combat deepens immersion and amplifies the thrill of every battle.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2387300/extras/696fb33ee60b97f5a5d7c537bb6ba221.poster.avif?t=1770893931\" width=614 height=234 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2387300/extras/696fb33ee60b97f5a5d7c537bb6ba221.webm?t=1770893931\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2387300/extras/696fb33ee60b97f5a5d7c537bb6ba221.mp4?t=1770893931\" type=\"video/mp4\"></video></span></p>","developers":["\u795e\u5200\u4e4b\u6b7b"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2387300/0ad689e826af005d195acd077a1d8bcbfab2f99a/header.jpg?t=1770893931","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2387300/608820/dea0fea444dbf16fbe14c73ac1bea58a699654d5/1750913963/dash_av1.mpd?t=1727690141","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2387300/608820/dea0fea444dbf16fbe14c73ac1bea58a699654d5/1750913963/dash_h264.mpd?t=1727690141","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2387300/608820/dea0fea444dbf16fbe14c73ac1bea58a699654d5/1750913963/hls_264_master.m3u8?t=1727690141","id":256970229,"name":"demo_release_trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256970229/c48d99b0ffb4fdd116ab3756eb940435e9c83081/movie_600x337.jpg?t=1727690141"}],"name":"Dustless","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Win7,10<br></li><li><stron