,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3857700/6fda62cdc1a3f34b6b618f04cbb703d6e8dad8a3/ss_6fda62cdc1a3f34b6b618f04cbb703d6e8dad8a3.1920x1080.jpg?t=1771171378","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3857700/6fda62cdc1a3f34b6b618f04cbb703d6e8dad8a3/ss_6fda62cdc1a3f34b6b618f04cbb703d6e8dad8a3.600x338.jpg?t=1771171378"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3857700/29633a8734acd3b7d71fc3dc661b8ebc938039e3/ss_29633a8734acd3b7d71fc3dc661b8ebc938039e3.1920x1080.jpg?t=1771171378","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3857700/29633a8734acd3b7d71fc3dc661b8ebc938039e3/ss_29633a8734acd3b7d71fc3dc661b8ebc938039e3.600x338.jpg?t=1771171378"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3857700/ec234dc87bb0f673ccbceaa24b109e3cffe03e09/ss_ec234dc87bb0f673ccbceaa24b109e3cffe03e09.1920x1080.jpg?t=1771171378","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3857700/ec234dc87bb0f673ccbceaa24b109e3cffe03e09/ss_ec234dc87bb0f673ccbceaa24b109e3cffe03e09.600x338.jpg?t=1771171378"}],"short_description":"This is a desktop game. You can farm, take care of animals, or go fishing!The farm will dynamically switch between day and night based on your time. In the night,something will changed.","steam_appid":3857700,"support_info":{"email":"zx_lalalala@163.com","url":""},"supported_languages":"English<strong>*</strong>, Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}