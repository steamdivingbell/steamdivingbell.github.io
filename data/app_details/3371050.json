36e769d379a284de031240a/ss_dcb4a439679aa516736e769d379a284de031240a.1920x1080.jpg?t=1769151080","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371050/dcb4a439679aa516736e769d379a284de031240a/ss_dcb4a439679aa516736e769d379a284de031240a.600x338.jpg?t=1769151080"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371050/4d5ed8350a58662876ccdbce0cd18ebd2a566180/ss_4d5ed8350a58662876ccdbce0cd18ebd2a566180.1920x1080.jpg?t=1769151080","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371050/4d5ed8350a58662876ccdbce0cd18ebd2a566180/ss_4d5ed8350a58662876ccdbce0cd18ebd2a566180.600x338.jpg?t=1769151080"}],"short_description":"Welcome to Zeverland. Common sense is your best weapon against the Zeds. After figuring out the &quot;not dying&quot; part, grab some friends to save the world. Find a cure, build a rocket, or a tower too high for Zeds to climb. Nothing's off limits. You're here at the very start of the apocalypse. Go wild!","steam_appid":3371050,"support_info":{"email":"cs@quantumquirksgames.com","url":""},"supported_languages":"English<strong>*</strong>, Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}