{"about_the_game":"<p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3394890/extras/AT_App_Img.png?t=1740587393\" /></p><h2 class=\"bb_tag\"><strong>Amazing Tictactoe</strong></h2><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">This game is a casual game based on 6x6 tic-tac-toe using the mouse. You can create an environment that is advantageous to you by using 4 types of items, and you win by filling 1 line with your color.</p><p class=\"bb_paragraph\">The effects of using the 4 items are as follows:</p><p class=\"bb_paragraph\">- Hammer: Delete a 3x3 radius centered on the mouse</p><p class=\"bb_paragraph\">- HandGun: Delete 5 random locations in the entire radius</p><p class=\"bb_paragraph\">- ShotGun: Delete 3 random locations in a 3x3 radius centered on the mouse</p><p class=\"bb_paragraph\">- WildCard: Change the designated location to your color</p>","achievements":{"total":0},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3394890?t=1740587393","background_raw":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3394890?t=1740587393","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3394890/6434d696d9d7866810471c1a97c1968164c8b048/capsule_231x87.jpg?t=1740587393","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3394890/6434d696d9d7866810471c1a97c1968164c8b048/capsule_184x69.jpg?t=1740587393","categories":[{"description":"Single-player","id":2},{"description":"Multi-player","id":1},{"description":"PvP","id":49},{"description":"Online PvP","id":36},{"description":"Shared/Split Screen PvP","id":37},{"description":"Shared/Split Screen","id":24},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"detailed_description":"<p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3394890/extras/AT_App_Img.png?t=1740587393\" /></p><h2 class=\"bb_tag\"><strong>Amazing Tictactoe</strong></h2><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">This game is a casual game based on 6x6 tic-tac-toe using the mouse. You can create an environment that is advantageous to you by using 4 types of items, and you win by filling 1 line with your color.</p><p class=\"bb_paragraph\">The effects of using the 4 items are as follows:</p><p class=\"bb_paragraph\">- Hammer: Delete a 3x3 radius centered on the mouse</p><p class=\"bb_paragraph\">- HandGun: Delete 5 random locations in the entire radius</p><p class=\"bb_paragraph\">- ShotGun: Delete 3 random locations in a 3x3 radius centered on the mouse</p><p class=\"bb_paragraph\">- WildCard: Change the designated location to your color</p>","developers":["Jaewoo Wi"],"genres":[{"description":"Casual","id":"4"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3394890/header.jpg?t=1740587393","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257080514,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257080514/movie480.mp4?t=1740502737","max":"http://video.akamai.steamstatic.com/store_trailers/257080514/movie_max.mp4?t=1740502737"},"name":"Amazing Tictactoe Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257080514/be520d4c2713a2cb099b2cbc4a8128d649d5c0dc/movie_600x337.jpg?t=1740502737","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257080514/movie480_vp9.webm?t=1740502737","max":"http://video.akamai.steamstatic.com/store_trailers/257080514/movie_max_vp9.webm?t=1740502737"}}