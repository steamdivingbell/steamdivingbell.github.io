om/store_item_assets/steam/apps/3376960/ss_e85631ee0b121652e1ed40349ba13aef43eca2e8.1920x1080.jpg?t=1770995137","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3376960/ss_e85631ee0b121652e1ed40349ba13aef43eca2e8.600x338.jpg?t=1770995137"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3376960/ss_e78c6d80229d31026b06f586c43203974231a4fb.1920x1080.jpg?t=1770995137","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3376960/ss_e78c6d80229d31026b06f586c43203974231a4fb.600x338.jpg?t=1770995137"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3376960/ss_8a59cde0108508f65812357bf355fc35471b3747.1920x1080.jpg?t=1770995137","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3376960/ss_8a59cde0108508f65812357bf355fc35471b3747.600x338.jpg?t=1770995137"}],"short_description":"Build shelters, interact with rescuees, battle against the Rot and raiders to survive another night in this Sandbox RPG. Play Solo or team up with friends in Online \u0421o-op.","steam_appid":3376960,"support_info":{"email":"ib@hypetraindigital.com","url":""},"supported_languages":"English, French, German, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America","type":"game","website":null}