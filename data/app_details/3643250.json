fo":{"email":"yashk@ykgamestudio.com","url":"https://www.ykgamestudio.com/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Russian, Simplified Chinese, Polish, Portuguese - Brazil, Spanish - Latin America","type":"game","website":"https://www.ykgamestudio.com/"}