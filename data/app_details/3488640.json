5e9507aaf0d6b9a4084/ss_fc75d1fbcfc96282bb2515e9507aaf0d6b9a4084.1920x1080.jpg?t=1760109961","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488640/fc75d1fbcfc96282bb2515e9507aaf0d6b9a4084/ss_fc75d1fbcfc96282bb2515e9507aaf0d6b9a4084.600x338.jpg?t=1760109961"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488640/9fa7e2a72b8f92f708a8f490b378125b818a5b88/ss_9fa7e2a72b8f92f708a8f490b378125b818a5b88.1920x1080.jpg?t=1760109961","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488640/9fa7e2a72b8f92f708a8f490b378125b818a5b88/ss_9fa7e2a72b8f92f708a8f490b378125b818a5b88.600x338.jpg?t=1760109961"}],"short_description":"Magical Blush is a top-down action-adventure where fast-paced elemental combat meets Metroidvania-style exploration. Chain spell combos, exploit elemental weaknesses, rescue survivors, and team up in local co-op as you battle the powerful Elemental Lords and explore the wondrous world of Wyn.","steam_appid":3488640,"support_info":{"email":"alkacergamestudio@gmail.com","url":"https://x.com/magical_blush"},"supported_languages":"English, Japanese, Portuguese - Brazil","type":"game","website":"https://x.com/magical_blush"}