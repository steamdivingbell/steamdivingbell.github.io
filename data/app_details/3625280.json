am/apps/3625280/76cabccbe00f519cceb65b18f965bc58e5d75254/ss_76cabccbe00f519cceb65b18f965bc58e5d75254.600x338.jpg?t=1760120213"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3625280/1482997f9f0b327ab4325b25175d48853a4b8d1b/ss_1482997f9f0b327ab4325b25175d48853a4b8d1b.1920x1080.jpg?t=1760120213","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3625280/1482997f9f0b327ab4325b25175d48853a4b8d1b/ss_1482997f9f0b327ab4325b25175d48853a4b8d1b.600x338.jpg?t=1760120213"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3625280/51ffbb0e87fedc547f8efecbe1d0e4a92e89f3ef/ss_51ffbb0e87fedc547f8efecbe1d0e4a92e89f3ef.1920x1080.jpg?t=1760120213","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3625280/51ffbb0e87fedc547f8efecbe1d0e4a92e89f3ef/ss_51ffbb0e87fedc547f8efecbe1d0e4a92e89f3ef.600x338.jpg?t=1760120213"}],"short_description":"A mystical point-and-click adventure in a Slavic folklore setting. Explore a mysterious village, solve puzzles, interact with unusual characters. Learn the secrets of witches and solve a mysterious murder","steam_appid":3625280,"support_info":{"email":"borderguardwork@gmail.com","url":""},"supported_languages":"Russian, English, French, Spanish - Spain","type":"game","website":"https://soks23.github.io/AliveSite/"}