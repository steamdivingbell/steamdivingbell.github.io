y.</p></li><li><p class=\"bb_paragraph\" >All characters are equally viable! There is no meta or tier list - the best one is the one you fancy most.</p></li><li><p class=\"bb_paragraph\" >Multiplayer mayhem! Will you work together, or get in each others' way?</p></li></ul>","developers":["ButterySoft, LLC"],"genres":[{"description":"RPG","id":"3"},{"description":"Sports","id":"18"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3310090/12e66e2191dfe7779b70ea943be5829fe61cb35c/header.jpg?t=1751908655","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257155705,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257155705/movie480.mp4?t=1749684840","max":"http://video.akamai.steamstatic.com/store_trailers/257155705/movie_max.mp4?t=1749684840"},"name":"Demo Announce","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257155705/bd5cac80bfbb3de5a7264047b1f20c5d184821f9/movie_600x337.jpg?t=1749684840","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257155705/movie480_vp9.webm?t=1749684840","max":"http://video.akamai.steamstatic.com/store_trailers/257155705/movie_max_vp9.webm?t=1749684840"}},{"highlight":true,"id":257094488,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257094488/movie480.mp4?t=1739576354","max":"http://video.akamai.steamstatic.com/store_trailers/257094488/movie_max.mp4?t=1739576354"},"name":"Reveal Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257094488/07f5aa38f88b8e88873491a0794ebb6d6484369d/movie_600x337.jpg?t=1739576354","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257094488/movie480_vp9.webm?t=1739576354","max":"http://video.akamai.steamstatic.com/store_trailers/257094488/movie_max_vp9.webm?t=1739576354"}}],"name":"Break Shot Hero","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimu