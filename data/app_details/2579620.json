ai.steamstatic.com/store_item_assets/steam/apps/2579620/extras/314201f66f5c4c5d43eca0200f905259.mp4?t=1768213020\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Soar over huge jumps, collect coins mid-air, and leave your rivals in the dust!</p><h2 class=\"bb_tag\" >\ud83c\udf0d Race The World</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2579620/extras/274a8728be3d1fd7893a4d1e482b14ca.poster.avif?t=1768213020\" width=800 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2579620/extras/274a8728be3d1fd7893a4d1e482b14ca.webm?t=1768213020\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2579620/extras/274a8728be3d1fd7893a4d1e482b14ca.mp4?t=1768213020\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Take part in the Wild Horse Racing World Championship! Join League Races to earn points and climb the ranks \u2014 or enter Coin Races if you\u2019re low on cash or just need some practice!</p><h2 class=\"bb_tag\" >\ud83e\uddfc Hoof &amp; Shoe Management</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2579620/extras/27b9d84848e73925b79eb67e58d5f899.poster.avif?t=1768213020\" width=480 height=294 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2579620/extras/27b9d84848e73925b79eb67e58d5f899.webm?t=1768213020\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2579620/extras/27b9d84848e73925b79eb67e58d5f899.mp4?t=1768213020\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Mud and gravel build up during races and slow you down \u2014 keep you