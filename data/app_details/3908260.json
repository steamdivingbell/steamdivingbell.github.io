ai.steamstatic.com/store_item_assets/steam/apps/3908260/0a8765d4e219f5736540e29bd79fe1ea8c4243e7/ss_0a8765d4e219f5736540e29bd79fe1ea8c4243e7.600x338.jpg?t=1766248592"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908260/5995aec43fac1220cbd291537209deb86ed77a1f/ss_5995aec43fac1220cbd291537209deb86ed77a1f.1920x1080.jpg?t=1766248592","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908260/5995aec43fac1220cbd291537209deb86ed77a1f/ss_5995aec43fac1220cbd291537209deb86ed77a1f.600x338.jpg?t=1766248592"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908260/be288f65487f580abdc9860d7000957237d35207/ss_be288f65487f580abdc9860d7000957237d35207.1920x1080.jpg?t=1766248592","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908260/be288f65487f580abdc9860d7000957237d35207/ss_be288f65487f580abdc9860d7000957237d35207.600x338.jpg?t=1766248592"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908260/9e34da46972b8ea70db4a26e290e4907f371648b/ss_9e34da46972b8ea70db4a26e290e4907f371648b.1920x1080.jpg?t=1766248592","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3908260/9e34da46972b8ea70db4a26e290e4907f371648b/ss_9e34da46972b8ea70db4a26e290e4907f371648b.600x338.jpg?t=1766248592"}],"short_description":"Be the voice out of the choir! Beat of Rebellion is an isometric rhythm-based Hack &amp; Slash. Follow the Beat, create your own Melodies and unleash devastating combos to fight against a totalitarian regime in a cyberpunk city.","steam_appid":3908260,"support_info":{"email":"gabriele.martini.gd@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}