re_item_assets/steam/apps/3708250/9f7827d5ac49218668d21f996c3729dacc37d636/ss_9f7827d5ac49218668d21f996c3729dacc37d636.600x338.jpg?t=1759350205"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708250/5f29db8adf2a47c92c443aef5cd98847676a0a06/ss_5f29db8adf2a47c92c443aef5cd98847676a0a06.1920x1080.jpg?t=1759350205","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708250/5f29db8adf2a47c92c443aef5cd98847676a0a06/ss_5f29db8adf2a47c92c443aef5cd98847676a0a06.600x338.jpg?t=1759350205"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708250/67b6263bc5f9433ebc1455907e5866ee6ef178ea/ss_67b6263bc5f9433ebc1455907e5866ee6ef178ea.1920x1080.jpg?t=1759350205","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708250/67b6263bc5f9433ebc1455907e5866ee6ef178ea/ss_67b6263bc5f9433ebc1455907e5866ee6ef178ea.600x338.jpg?t=1759350205"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708250/5a173f8c55eaf82599e86917150f6b4a725f7d9e/ss_5a173f8c55eaf82599e86917150f6b4a725f7d9e.1920x1080.jpg?t=1759350205","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708250/5a173f8c55eaf82599e86917150f6b4a725f7d9e/ss_5a173f8c55eaf82599e86917150f6b4a725f7d9e.600x338.jpg?t=1759350205"}],"short_description":"You're a carpenter sent to Heaven's Dale by the Moon Goddess herself! Manage your carpentry workshop, raise animals, catch fish, explore dark caves, find love, help people and even build a rocket to the moon in this Life Simulator!","steam_appid":3708250,"support_info":{"email":"myheavensdale@gmail.com","url":""},"supported_languages":"English, Portuguese - Brazil","type":"game","website":null}