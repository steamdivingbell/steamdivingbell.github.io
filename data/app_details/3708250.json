.steamstatic.com/store_item_assets/steam/apps/3708250/5a173f8c55eaf82599e86917150f6b4a725f7d9e/ss_5a173f8c55eaf82599e86917150f6b4a725f7d9e.600x338.jpg?t=1761589665"}],"short_description":"You're a carpenter sent to Heaven's Dale by the Moon Goddess herself! Manage your carpentry workshop, raise animals, catch fish, explore dark caves, find love, help people and even build a rocket to the moon in this Life Simulator!","steam_appid":3708250,"support_info":{"email":"myheavensdale@gmail.com","url":""},"supported_languages":"English, Portuguese - Brazil","type":"game","website":null}