apps/3431300/ss_843784e7557bc07aec17930727c10d2fab039b53.1920x1080.jpg?t=1769945518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_843784e7557bc07aec17930727c10d2fab039b53.600x338.jpg?t=1769945518"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_83d1597ba00cc9f2a6471309da37ba54921035bd.1920x1080.jpg?t=1769945518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_83d1597ba00cc9f2a6471309da37ba54921035bd.600x338.jpg?t=1769945518"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_a121815fabed0ec497e1811fd92969c1ca4abb7a.1920x1080.jpg?t=1769945518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_a121815fabed0ec497e1811fd92969c1ca4abb7a.600x338.jpg?t=1769945518"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_40e953f6b37501d06d6f2f45435e7c9e228348c6.1920x1080.jpg?t=1769945518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_40e953f6b37501d06d6f2f45435e7c9e228348c6.600x338.jpg?t=1769945518"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_88791cf5d1b3e67f35f025cceb4570d3275d57ca.1920x1080.jpg?t=1769945518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_88791cf5d1b3e67f35f025cceb4570d3275d57ca.600x338.jpg?t=1769945518"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_2f680d5aa43395954f56a939ab05fcb974b947a8.1920x1080.jpg?t=1769945518","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431300/ss_2f680d5aa43395954f56a939ab05fcb974b947a8.600x338.jpg?t=1769945518"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3