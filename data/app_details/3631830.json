f every die and card.</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Easy to learn, rich in strategy</p></li></ul><p class=\"bb_paragraph\" >Relaxed pacing, solid content\u2014great for casual players and strategy enthusiasts alike.</p>","developers":["Dave Hive"],"genres":[{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3631830/61ba9df936d126ba5617d30d7a142075135f3ea4/header.jpg?t=1760349284","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 10.13 High Sierra<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core i5<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> 512 MB<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3631830/1948799260/5e450152ba6055f1460080d2c06c595fba3f0579/1750458257/dash_av1.mpd?t=1749472680","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3631830/1948799260/5e450152ba6055f1460080d2c06c595fba3f0579/1750458257/dash_h264.mpd?t=1749472680","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3631830/1948799260/5e450152ba6055f1460080d2c06c595fba3f0579/1750458257/hls_264_master.m3u8?t=1749472680","id":257154162,"name":"Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257154162/1796c4cc2fe97dee51c01aff5d36d8d8ae978e01/movie_600x337.jpg?t=1749472680"}],"name":"Dice To Pay","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Dice To Pay - <span class=\"discount_original_price\">$2.99</span> $2.09 USD","packageid":1280237,"percent_savings":0,"p