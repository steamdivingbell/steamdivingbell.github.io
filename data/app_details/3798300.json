/3798300/2fd739c6149e98d5f151ffcbb65cef8b7366298d/ss_2fd739c6149e98d5f151ffcbb65cef8b7366298d.1920x1080.jpg?t=1758427114","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798300/2fd739c6149e98d5f151ffcbb65cef8b7366298d/ss_2fd739c6149e98d5f151ffcbb65cef8b7366298d.600x338.jpg?t=1758427114"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798300/aeee8aa6aed030d38eaa4128f7d7d51c69211b7c/ss_aeee8aa6aed030d38eaa4128f7d7d51c69211b7c.1920x1080.jpg?t=1758427114","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798300/aeee8aa6aed030d38eaa4128f7d7d51c69211b7c/ss_aeee8aa6aed030d38eaa4128f7d7d51c69211b7c.600x338.jpg?t=1758427114"}],"short_description":"WETTOP is a challenging first-person parkour adventure where every jump counts. With only 10 lives, your goal is to climb to the top of a towering world filled with thrilling jumps, moving platforms, and surprising tasks. Miss a jump, and you fall\u2014lose a life. Lose them all? It's game over.","steam_appid":3798300,"support_info":{"email":"simplethinkgamesofficial@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}