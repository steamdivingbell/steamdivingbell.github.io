864218016507238eac3f6693b3f03438/ss_5b0d61eb864218016507238eac3f6693b3f03438.600x338.jpg?t=1767055334"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709130/6968a457af57515c207f9a2824f69704b84e0bce/ss_6968a457af57515c207f9a2824f69704b84e0bce.1920x1080.jpg?t=1767055334","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709130/6968a457af57515c207f9a2824f69704b84e0bce/ss_6968a457af57515c207f9a2824f69704b84e0bce.600x338.jpg?t=1767055334"}],"short_description":"You are an independent mercenary and explorer living on the harsh surface of Largitas. Upgrade and customize your equipment in preparation to fight hostile operators, explore locations on the planet whilst navigating hazards, and interact and connect with the people forced to live here.","steam_appid":3709130,"support_info":{"email":"wm868968@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}