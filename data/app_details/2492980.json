static.com/store_item_assets/steam/apps/2492980/fc4b7b7545dfcdba6b6dacdf6b7293ab2b438a1f/ss_fc4b7b7545dfcdba6b6dacdf6b7293ab2b438a1f.1920x1080.jpg?t=1758036745","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2492980/fc4b7b7545dfcdba6b6dacdf6b7293ab2b438a1f/ss_fc4b7b7545dfcdba6b6dacdf6b7293ab2b438a1f.600x338.jpg?t=1758036745"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2492980/936592e1b51f5fb4087f422dbb81f78c33897620/ss_936592e1b51f5fb4087f422dbb81f78c33897620.1920x1080.jpg?t=1758036745","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2492980/936592e1b51f5fb4087f422dbb81f78c33897620/ss_936592e1b51f5fb4087f422dbb81f78c33897620.600x338.jpg?t=1758036745"}],"short_description":"Rob banks and cause chaos in Heistfest, a top-down action-racer where you escape across destructible cityscapes while outrunning escalating police forces. Outdrive cruisers, dodge missiles, and survive tanks and airstrikes in this high-octane arcade getaway game.","steam_appid":2492980,"support_info":{"email":"support@indie.io","url":"https://www.amilcartek.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":"https://www.amilcartek.com/"}