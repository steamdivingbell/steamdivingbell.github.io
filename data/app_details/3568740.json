815c597a705274f9c9c2db34d64a931d13.1920x1080.jpg?t=1759676549","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3568740/4d8f00815c597a705274f9c9c2db34d64a931d13/ss_4d8f00815c597a705274f9c9c2db34d64a931d13.600x338.jpg?t=1759676549"}],"short_description":"The Fatum \u2014 a test of your deduction in a world of total control. Interrogate, inspect, pass a verdict. Compare visual details, analyze dossiers, and converse with residents. Your decisions write the finale \u2014 be prepared for the consequences.","steam_appid":3568740,"support_info":{"email":"dreamliftstudios@gmail.com","url":""},"supported_languages":"English, Russian","type":"game","website":null}