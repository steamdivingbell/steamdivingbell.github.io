steam/apps/3423700/b61f075e37ac600c82efbd348460fcb0e177720a/ss_b61f075e37ac600c82efbd348460fcb0e177720a.1920x1080.jpg?t=1772034489","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3423700/b61f075e37ac600c82efbd348460fcb0e177720a/ss_b61f075e37ac600c82efbd348460fcb0e177720a.600x338.jpg?t=1772034489"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3423700/2cbc8747a7ecfb244314e06cf974ed0f2ff92aa6/ss_2cbc8747a7ecfb244314e06cf974ed0f2ff92aa6.1920x1080.jpg?t=1772034489","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3423700/2cbc8747a7ecfb244314e06cf974ed0f2ff92aa6/ss_2cbc8747a7ecfb244314e06cf974ed0f2ff92aa6.600x338.jpg?t=1772034489"}],"short_description":"A fast-paced top-down shooter with chaotic online co-op story missions and tense competitive bomb matches. Work for my company, take every shady contract, outgun rivals, and survive. You\u2019re expendable, but if you make me money, I might let you live.","steam_appid":3423700,"support_info":{"email":"support@plan-b4.com","url":"https://plan-b4.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://plan-b4.com"}