.com/store_item_assets/steam/apps/3183410/1f0088adb470b3acdec37879e7980072a4b9c9cb/ss_1f0088adb470b3acdec37879e7980072a4b9c9cb.600x338.jpg?t=1759476926"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183410/768728cd3de15b4d52f404b18331cbf4aa0029bb/ss_768728cd3de15b4d52f404b18331cbf4aa0029bb.1920x1080.jpg?t=1759476926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183410/768728cd3de15b4d52f404b18331cbf4aa0029bb/ss_768728cd3de15b4d52f404b18331cbf4aa0029bb.600x338.jpg?t=1759476926"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183410/06d584b0c74209e5b44174cf98b8a71002204b2c/ss_06d584b0c74209e5b44174cf98b8a71002204b2c.1920x1080.jpg?t=1759476926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183410/06d584b0c74209e5b44174cf98b8a71002204b2c/ss_06d584b0c74209e5b44174cf98b8a71002204b2c.600x338.jpg?t=1759476926"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183410/b131c8b1d202ac38b7889c6174196e9d52d6173a/ss_b131c8b1d202ac38b7889c6174196e9d52d6173a.1920x1080.jpg?t=1759476926","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183410/b131c8b1d202ac38b7889c6174196e9d52d6173a/ss_b131c8b1d202ac38b7889c6174196e9d52d6173a.600x338.jpg?t=1759476926"}],"short_description":"Relax on a park bench, find hidden objects, solve quirky puzzles, and command pesky pigeons in this charming, interactive adventure. Enjoy beautifully stylized, colorful levels keeping you entertained!","steam_appid":3183410,"support_info":{"email":"info@voxel.it","url":"https://voxel.it/it"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Simplified Chinese, Turkish, Ukrainian, Portuguese - Brazil, Spanish - Latin America, Russian","type":"game","website":"https://www.voxel.it/en"}