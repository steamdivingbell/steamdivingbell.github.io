/apps/4047160/extras/d8c83e6bce0acbbc76faae174c42ff15.avif?t=1762629055\" width=1560 height=252 /></span></h2><p class=\"bb_paragraph\" >This game is a love letter to friendship and to community. To those who feel an insatiable urge to create, and to those who lose themselves in their art and lock themselves away. </p>","developers":["zorkie studios"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4047160/8f34a453f0f5979d72becce8bd9057298d03b0ab/header.jpg?t=1762629055","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 64-bit processor<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OS X or above<br></li><li><strong>Processor:</strong> Quad-core Intel or Apple Silicon<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4047160/995905224/9ba2a3ad7c5d82cd5e6b99634c8eea8ab555bd92/1762594301/dash_av1.mpd?t=1762621221","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4047160/995905224/9ba2a3ad7c5d82cd5e6b99634c8eea8ab555bd92/1762594301/dash_h264.mpd?t=1762621221","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4047160/995905224/9ba2a3ad7c5d82cd5e6b99634c8eea8ab555bd92/1762594301/hls_264_master.m3u8?t=1762621221","id":257228541,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257228541/movie480.mp4?t=1762621221","max":"https://video.akamai.steamstatic.com/store_trailers/257228541/movie_max.mp4?t=1762621221"},