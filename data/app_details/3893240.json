.steamstatic.com/store_item_assets/steam/apps/3893240/extras/c80cf5367363a199adbad1cb56091052.avif?t=1753817245\" /></div></p><p class=\"bb_paragraph\">Find over 200 types of anomalies within a time limit.</p><p class=\"bb_paragraph\">Explore branching endings to uncover the truth.</p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3893240/extras/581c27cf811c33db0b37a7aaf1e43ee8.avif?t=1753817245\" /></div></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3893240/extras/8898f77148ad10f865dec5c4981c9aab.avif?t=1753817245\" /></div></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3893240/extras/059822165c60656136dd7587fa35b0ea.avif?t=1753817245\" /></div></p>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3893240?t=1753817245","background_raw":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3893240?t=1753817245","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3893240/221fbac3a5ebede507ffceb662473d7f810f9311/capsule_231x87.jpg?t=1753817245","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3893240/221fbac3a5ebede507ffceb662473d7f810f9311/capsule_184x69.jpg?t=1753817245","categories":[{"description":"Single-player","id":2},{"description":"Full controller support","id":28},{"description":"Captions available","id":13},{"description":"Custom Volume Controls","id":68},{"description":"Keyboard Only Option","id":75},{"description":"Mouse Only Option","id":76},{"description":"Save Anytime","id":79},{"description":"Steam Cloud","id":23},{"description":"Remote Play on TV","id":43},{"description":"HDR available","id":61},{"description":"Family Sharing","id"