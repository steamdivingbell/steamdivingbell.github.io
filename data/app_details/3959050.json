//shared.akamai.steamstatic.com/store_item_assets/steam/apps/3959050/47c44625a96e2c8646dc1efb14d3137eee70490b/ss_47c44625a96e2c8646dc1efb14d3137eee70490b.600x338.jpg?t=1768834691"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3959050/6311b160368f9984d372c80ec132dfbf53964b18/ss_6311b160368f9984d372c80ec132dfbf53964b18.1920x1080.jpg?t=1768834691","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3959050/6311b160368f9984d372c80ec132dfbf53964b18/ss_6311b160368f9984d372c80ec132dfbf53964b18.600x338.jpg?t=1768834691"}],"short_description":"Upgrade your turtle, recruit cute animals like unicorns, giant squids, otters and more, and blast through waves in an idle roguelite auto battler! Swim farther with each run, unlock new skills, and get closer to home every time you grow stronger.","steam_appid":3959050,"support_info":{"email":"havendockyyz@gmail.com","url":"https://yyzstudio.com/"},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese, Thai, Traditional Chinese","type":"game","website":"https://yyzstudio.com/"}