item_assets/steam/apps/3845600/6c41ff3a5e1766c374c154e50574d34f8f7f68f8/ss_6c41ff3a5e1766c374c154e50574d34f8f7f68f8.1920x1080.jpg?t=1761360854","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845600/6c41ff3a5e1766c374c154e50574d34f8f7f68f8/ss_6c41ff3a5e1766c374c154e50574d34f8f7f68f8.600x338.jpg?t=1761360854"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845600/2f999c9f3044e77d0e85bbe4387c8ca3f8fdb685/ss_2f999c9f3044e77d0e85bbe4387c8ca3f8fdb685.1920x1080.jpg?t=1761360854","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3845600/2f999c9f3044e77d0e85bbe4387c8ca3f8fdb685/ss_2f999c9f3044e77d0e85bbe4387c8ca3f8fdb685.600x338.jpg?t=1761360854"}],"short_description":"Care for a local shrine and befriend Mao, the fox girl who lives there. In this light-hearted simulation game, you\u2019ll have 30 days to balance your time between your tasks and building a relationship with Mao. Use your time wisely, and who knows? Maybe she'll let you stay longer.","steam_appid":3845600,"support_info":{"email":"","url":"https://saikeystudios.com"},"supported_languages":"English, Japanese<strong>*</strong>, Korean, Simplified Chinese, Traditional Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}