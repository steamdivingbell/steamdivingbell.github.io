78/ss_7ce33edbefd95d5c7bd22c49c7b5005b74893778.1920x1080.jpg?t=1756467758","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728350/7ce33edbefd95d5c7bd22c49c7b5005b74893778/ss_7ce33edbefd95d5c7bd22c49c7b5005b74893778.600x338.jpg?t=1756467758"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728350/1817124a6c6ee6975a0462ca45766750e3103e9e/ss_1817124a6c6ee6975a0462ca45766750e3103e9e.1920x1080.jpg?t=1756467758","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728350/1817124a6c6ee6975a0462ca45766750e3103e9e/ss_1817124a6c6ee6975a0462ca45766750e3103e9e.600x338.jpg?t=1756467758"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728350/09b123c0c134cf72e36920fc6cf0c23a553e91ac/ss_09b123c0c134cf72e36920fc6cf0c23a553e91ac.1920x1080.jpg?t=1756467758","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728350/09b123c0c134cf72e36920fc6cf0c23a553e91ac/ss_09b123c0c134cf72e36920fc6cf0c23a553e91ac.600x338.jpg?t=1756467758"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728350/8b50e8c9707bb4ef4887c0c665dde238f9bced3a/ss_8b50e8c9707bb4ef4887c0c665dde238f9bced3a.1920x1080.jpg?t=1756467758","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728350/8b50e8c9707bb4ef4887c0c665dde238f9bced3a/ss_8b50e8c9707bb4ef4887c0c665dde238f9bced3a.600x338.jpg?t=1756467758"}],"short_description":"RAFT Days is a Sokoban-like puzzle + simple trading game. You travel across the sea from port to port, loading goods and tools onto your ship. You can save money by trading, expand your raft, hire sailors to help you, and enrich your journey. The waves and winds make this game relaxing to play.","steam_appid":3728350,"support_info":{"email":"steam-info@kayac.com","url":""},"supported_languages":"English, Japanese","type":"demo","website":null}