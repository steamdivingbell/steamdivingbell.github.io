agraph\" >Choose your battles, defeating a boss region will unlock new crafting recipes and new allies. Grind your way against increasingly harder enemies, defeat all bosses and reclaim all regions!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3868420/extras/805202a239513e14945e63e746ac1b47.avif?t=1758196165\" width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["EndeavourDGaming"],"fullgame":{"appid":"3299780","name":"Grinding Guilds"},"genres":[{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3868420/5dd963ce7e04526bb40cd7287328e5b15582b928/header.jpg?t=1758196165","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257191353,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257191353/movie480.mp4?t=1757615457","max":"http://video.akamai.steamstatic.com/store_trailers/257191353/movie_max.mp4?t=1757615457"},"name":"Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257191353/24b804e9776fde58e8f3797cc1bc432051016b42/movie_600x337.jpg?t=1757615457","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257191353/movie480_vp9.webm?t=1757615457","max":"http://video.akamai.steamstatic.com/store_trailers/257191353/movie_max_vp9.webm?t=1757615457"}}],"name":"Grinding Guilds Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Radeon RX 550 or Nvidia GT 1030<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>","recommended":"<