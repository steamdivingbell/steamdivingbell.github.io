m/apps/3835610/d98cd9191afb30440c4ae870a910d1224088786d/ss_d98cd9191afb30440c4ae870a910d1224088786d.600x338.jpg?t=1759199006"}],"short_description":"Once every 100 years, a temple containing a legendary blade appears for only 24 hours. The sword\u2019s power can only be unlocked joining in body and spirit with another, and there are three men hoping to be chosen to share the sword\u2019s power with you. Who will it be?","steam_appid":3835610,"support_info":{"email":"contact@truantpixel.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}