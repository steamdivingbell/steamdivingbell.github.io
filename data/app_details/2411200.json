5fe43a10c6eb6c2323cb8a4415174fe039c429.600x338.jpg?t=1771973274"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2411200/2f241a117a6a97dbfc0e4efdbe8170a63d106533/ss_2f241a117a6a97dbfc0e4efdbe8170a63d106533.1920x1080.jpg?t=1771973274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2411200/2f241a117a6a97dbfc0e4efdbe8170a63d106533/ss_2f241a117a6a97dbfc0e4efdbe8170a63d106533.600x338.jpg?t=1771973274"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2411200/ss_a71db0e421d7c11def6d987fc09e56b3957a2b8f.1920x1080.jpg?t=1771973274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2411200/ss_a71db0e421d7c11def6d987fc09e56b3957a2b8f.600x338.jpg?t=1771973274"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2411200/ss_407318d25187f3a6e6b387d9659096faf5f6c98c.1920x1080.jpg?t=1771973274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2411200/ss_407318d25187f3a6e6b387d9659096faf5f6c98c.600x338.jpg?t=1771973274"}],"short_description":"Explore a dangerous fantasy world in this role-playing dungeon crawler with tactical, turn-based combat. Assemble a party of adventurers, upgrade your gear and descend into the depths of the Underkeep to uncover what lies hidden below.","steam_appid":2411200,"support_info":{"email":"support@rakeingrass.com","url":"http://www.rakeingrass.com/contact.php"},"supported_languages":"English","type":"game","website":"https://www.rakeingrass.com/"}