ebm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3335690/extras/5102693cf3251d50dddf606f129e5a75.mp4?t=1770483445\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Other Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Main Story: Uncover your grandfather\u2019s mysterious final wish.</p></li><li><p class=\"bb_paragraph\" >Friendship System: Grow closer with the townsfolk to unlock new stories and features.</p></li><li><p class=\"bb_paragraph\" >Expanded Areas: Explore the forest, the mines, and nearby islands.</p></li><li><p class=\"bb_paragraph\" >Seasonal Festivals: Take part in special events like the Fishing Festival, Halloween, and more.</p></li><li><p class=\"bb_paragraph\" >...</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Join our community to chat with us and help make the game even better. Your feedback means a lot to us!</p><p class=\"bb_paragraph\" >Click the community link on the right side of the store page to join.</p><p class=\"bb_paragraph\" ></p>","developers":["Aries Echo Studio"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3335690/header.jpg?t=1770483445","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OSX 10.10+<br></li><li><strong>Processor:</strong> Apple Silicon (M1 or later) and Intel (64-bit)<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> 1GB video memory<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3335690/1655703909/e84a7a48d95fb340d1ae27eccb594a5ecc7e12a9/1770481665/dash_av1.mpd?t=1770483443","dash_h264":"https://vid