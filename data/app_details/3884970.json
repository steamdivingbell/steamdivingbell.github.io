5c7702a0068c824a4218f2888302a94b90c.600x338.jpg?t=1757894397"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/42d546628eb02d1a7de1bfe6132146234574c546/ss_42d546628eb02d1a7de1bfe6132146234574c546.1920x1080.jpg?t=1757894397","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/42d546628eb02d1a7de1bfe6132146234574c546/ss_42d546628eb02d1a7de1bfe6132146234574c546.600x338.jpg?t=1757894397"}],"short_description":"Layerland is a sandbox survival game set in a world that mirrors Earth\u2019s terrain. Travel through gates, capture monsters as pets, and team up to battle, gather, craft, and build. Stay connected with real-time pet conversations using Layer Talk app.","steam_appid":3884970,"support_info":{"email":"help@vpudding.com","url":""},"supported_languages":"English, Korean, French, Italian, German, Spanish - Spain, Indonesian, Japanese, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America, Thai, Traditional Chinese, Turkish, Vietnamese","type":"game","website":null}