/apps/3884970/946d6ef8ce329bbf7c99de4e736ea49766c9038e/ss_946d6ef8ce329bbf7c99de4e736ea49766c9038e.600x338.jpg?t=1773818485"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/3214f42a33a00a16d62597425fd35621143e922a/ss_3214f42a33a00a16d62597425fd35621143e922a.1920x1080.jpg?t=1773818485","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/3214f42a33a00a16d62597425fd35621143e922a/ss_3214f42a33a00a16d62597425fd35621143e922a.600x338.jpg?t=1773818485"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/4282346a7fc9fdc851aec843db591c5a1ace53ae/ss_4282346a7fc9fdc851aec843db591c5a1ace53ae.1920x1080.jpg?t=1773818485","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/4282346a7fc9fdc851aec843db591c5a1ace53ae/ss_4282346a7fc9fdc851aec843db591c5a1ace53ae.600x338.jpg?t=1773818485"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/121b46997c71021dcc3059b8e9cbddeef8e612ed/ss_121b46997c71021dcc3059b8e9cbddeef8e612ed.1920x1080.jpg?t=1773818485","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/121b46997c71021dcc3059b8e9cbddeef8e612ed/ss_121b46997c71021dcc3059b8e9cbddeef8e612ed.600x338.jpg?t=1773818485"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/7ea88291d035dc40885ad4a80c633f32c5b0d6a3/ss_7ea88291d035dc40885ad4a80c633f32c5b0d6a3.1920x1080.jpg?t=1773818485","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884970/7ea88291d035dc40885ad4a80c633f32c5b0d6a3/ss_7ea88291d035dc40885ad4a80c633f32c5b0d6a3.600x338.jpg?t=1773818485"}],"short_description":"Layerland is a sandbox survival game set in a world that mirrors Earth\u2019s terrain. Travel through gates, capture monsters as pets, and team up to battle, gather, craft, and build.","steam_