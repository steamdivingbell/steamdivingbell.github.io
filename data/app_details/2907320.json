vive.</strong></p><p class=\"bb_paragraph\" >      </p><h2 class=\"bb_tag\" > </h2>","developers":["Nerve Link"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2907320/3a76cbaa0a77c2172c88d7bafc21df3d585c105a/header.jpg?t=1759340975","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2907320/1915941103/d92d04f27688953fee70e34deec3ec7c0a4ff405/1758298145/dash_av1.mpd?t=1758298710","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2907320/1915941103/d92d04f27688953fee70e34deec3ec7c0a4ff405/1758298145/dash_h264.mpd?t=1758298710","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2907320/1915941103/d92d04f27688953fee70e34deec3ec7c0a4ff405/1758298145/hls_264_master.m3u8?t=1758298710","id":257202294,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257202294/movie480.mp4?t=1758298710","max":"https://video.akamai.steamstatic.com/store_trailers/257202294/movie_max.mp4?t=1758298710"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257202294/bd050d9fc3876e70f722feabf67e28259ef7dd02/movie_600x337.jpg?t=1758298710","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257202294/movie480_vp9.webm?t=1758298710","max":"https://video.akamai.steamstatic.com/store_trailers/257202294/movie_max_vp9.webm?t=1758298710"}},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2907320/802090682/a4857cdb41e2c7a411569fbab90c165c4316f201/1758053406/dash_av1.mpd?t=1758053847","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2907320/802090682/a4857cdb41e2c7a411569fbab90c165c4316f201/1758053406/dash_h264.mpd?t=1758053847","highlight":true,"h