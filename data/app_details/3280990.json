38.jpg?t=1773255968"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/e861fe6f860020efec636ba600a89d0d12fb8e17/ss_e861fe6f860020efec636ba600a89d0d12fb8e17.1920x1080.jpg?t=1773255968","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/e861fe6f860020efec636ba600a89d0d12fb8e17/ss_e861fe6f860020efec636ba600a89d0d12fb8e17.600x338.jpg?t=1773255968"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/f02c8a0db1844ba5fa4c7d9085f2b3e87e0b0897/ss_f02c8a0db1844ba5fa4c7d9085f2b3e87e0b0897.1920x1080.jpg?t=1773255968","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/f02c8a0db1844ba5fa4c7d9085f2b3e87e0b0897/ss_f02c8a0db1844ba5fa4c7d9085f2b3e87e0b0897.600x338.jpg?t=1773255968"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/49fc9a90069f350847b936972b7d5833f85a19ae/ss_49fc9a90069f350847b936972b7d5833f85a19ae.1920x1080.jpg?t=1773255968","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/49fc9a90069f350847b936972b7d5833f85a19ae/ss_49fc9a90069f350847b936972b7d5833f85a19ae.600x338.jpg?t=1773255968"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/36492181e1932b282b15bb323da6c5584fa50cfe/ss_36492181e1932b282b15bb323da6c5584fa50cfe.1920x1080.jpg?t=1773255968","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/36492181e1932b282b15bb323da6c5584fa50cfe/ss_36492181e1932b282b15bb323da6c5584fa50cfe.600x338.jpg?t=1773255968"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/a52708af782d07694c9ad6cef7fb5b34039de03d/ss_a52708af782d07694c9ad6cef7fb5b34039de03d.1920x1080.jpg?t=1773255968","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3280990/a52708af782d07694