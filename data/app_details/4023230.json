assets/steam/apps/4023230/a7e44877fb3a8b0217ce07000646abc8d6b731b6/ss_a7e44877fb3a8b0217ce07000646abc8d6b731b6.600x338.jpg?t=1764561802"},{"id":18,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023230/442176e550d99f17402827b03f491db2d9b8041e/ss_442176e550d99f17402827b03f491db2d9b8041e.1920x1080.jpg?t=1764561802","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023230/442176e550d99f17402827b03f491db2d9b8041e/ss_442176e550d99f17402827b03f491db2d9b8041e.600x338.jpg?t=1764561802"},{"id":19,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023230/905d435f1b9b9b288949d3eeadec6c465267fbaf/ss_905d435f1b9b9b288949d3eeadec6c465267fbaf.1920x1080.jpg?t=1764561802","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023230/905d435f1b9b9b288949d3eeadec6c465267fbaf/ss_905d435f1b9b9b288949d3eeadec6c465267fbaf.600x338.jpg?t=1764561802"}],"short_description":"Seventh Seal is a survival horror action-adventure where you guide Violet through a sealed apartment complex. Fight brutal enemies, solve cryptic puzzles, and uncover whether the nightmare is a virus, the dead rising, or the end of days.","steam_appid":4023230,"support_info":{"email":"al@renderready.com","url":"https://www.renderready.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.renderready.com/"}