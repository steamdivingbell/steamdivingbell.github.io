res the story and intertwines with the world.</p>","developers":["Lezzlebit"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3076330/2aae441434048ca311113e5c9829485e0c730240/header.jpg?t=1762580431","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3076330/1193552102/cd85c8a5ffea28490671f5c1202f3e4d93f88f9e/1762572028/dash_av1.mpd?t=1762580429","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3076330/1193552102/cd85c8a5ffea28490671f5c1202f3e4d93f88f9e/1762572028/dash_h264.mpd?t=1762580429","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3076330/1193552102/cd85c8a5ffea28490671f5c1202f3e4d93f88f9e/1762572028/hls_264_master.m3u8?t=1762580429","id":257228456,"name":"Staraway Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257228456/2b1606479ca1f344f500128507188b1c11f1fea1/movie_600x337.jpg?t=1762580429"}],"name":"Staraway","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>DirectX:</strong> Version 10<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 11<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Lezzlebit"],"ratings":{"dejus":{"banned":"0","descriptors":"Linguagem impr\u00f3pria\nViol\u00eancia","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Gewalt\nDerbe Sprache","rating":"12","rating_generated":"1","requir