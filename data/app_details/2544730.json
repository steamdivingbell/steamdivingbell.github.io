pps/2544730/28d5a79f7bc3b422aeb46ca03dc594560922f6f7/ss_28d5a79f7bc3b422aeb46ca03dc594560922f6f7.600x338.jpg?t=1763957464"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2544730/d62bf7e284c8035647efb6341fabb06403e7285e/ss_d62bf7e284c8035647efb6341fabb06403e7285e.1920x1080.jpg?t=1763957464","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2544730/d62bf7e284c8035647efb6341fabb06403e7285e/ss_d62bf7e284c8035647efb6341fabb06403e7285e.600x338.jpg?t=1763957464"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2544730/b7858781c576e4dd755064800ddaf49be53e3a12/ss_b7858781c576e4dd755064800ddaf49be53e3a12.1920x1080.jpg?t=1763957464","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2544730/b7858781c576e4dd755064800ddaf49be53e3a12/ss_b7858781c576e4dd755064800ddaf49be53e3a12.600x338.jpg?t=1763957464"}],"short_description":"Lead your people through shattered worlds and magical wildernesses in this survival colony sim. Discover ancient monuments, encounter unusual creatures, appease fickle deities, and manage the needs of your people. Will yours be a story of triumph, or tragedy?","steam_appid":2544730,"support_info":{"email":"support@hydrarch.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}