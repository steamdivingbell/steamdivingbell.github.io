=1760900900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/4953ac834701ec10787923c8f841528e.mp4?t=1760900900\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/aa1e00bb009eb8db5a24c44727308dc0.poster.avif?t=1760900900\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/aa1e00bb009eb8db5a24c44727308dc0.webm?t=1760900900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/aa1e00bb009eb8db5a24c44727308dc0.mp4?t=1760900900\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/23a800b338ca7310b35b2cbd49246754.avif?t=1760900900\" width=704 height=904 /></span></p><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/ab8282ba7a2dd15c73477ade40c73743.avif?t=1760900900\" width=614 height=66 /></span></p><p class=\"bb_paragraph\" >With your handy\u00a0<strong>Map, </strong>you can\u00a0<strong>Fast Travel</strong> between discovered landmarks or place markers for taking the scenic route with your trusty Cytron\u00a0<strong>Motorcycle.</strong></p><p class=\"bb_paragraph\" ><strong>Liberate</strong>\u00a0the fantastical modern metropolis from your foes to level up as soon as you can. Scattered lore and triggered <strong>City Events</strong> will populate your <strong>Help</strong> database with  info about those items and enemies.\u00a0Only then can you unlock more skills and\u00a0<strong>Fly</strong> across rooftops or <strong>Wall-Run</strong>  up skyscrapers, finding more loot for crafting and lurking enemies for XP, ultimately becoming the hero this city deserves. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/0c7315a27b22df583f61f84139b9bea7.avif?t=1760900900\" width=576 height=800 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/b3d69482d318294fd55fc8f2787300f4.avif?t=1760900900\" width=614 height=66 /></span></p><p class=\"bb_paragraph\" >Learn the way of the Heroes by retrieving and retaining\u00a0<strong>Orbs</strong>, your  source of strength.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/366480fcff15464e54fd7007a349564a.poster.avif?t=1760900900\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/366480fcff15464e54fd7007a349564a.webm?t=1760900900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/366480fcff15464e54fd7007a349564a.mp4?t=1760900900\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Orbs. Are. Everything! </p><p class=\"bb_paragraph\" >  Be mindful of your <strong>Orb Gauge</strong> <i>(Mana)</i> and <strong>Orb Vitality</strong> <i>(Health)</i>. Should your opponent deal damage to you, you'll lose Orbs from both your Orb Vitality <i>and</i> your Orb Gauge, robbing you of your very essence and your ability to use Magic. </p><p class=\"bb_paragraph\" >You'll also gain or lose Orbs depending on the public's perception of you, in a similar fashion to Karma, so don't go slicing too many light posts and trees in half!\u00a0</p><p class=\"bb_paragraph\" >Retrieve dropped Orbs and Orblettes to maintain vitality and, more importantly,  to unlock new <strong>Advances</strong> <i>(Skills)</i>.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/b21aff39e10515a6e45660eeecab71e4.poster.avif?t=1760900900\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/b21aff39e10515a6e45660eeecab71e4.webm?t=1760900900\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/extras/b21aff39e10515a6e45660eeecab71e4.mp4?t=1760900900\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Between your arsenal, your crafting, and your abilities, you should be well-equipped for the world of battle that lies ahead, <i>hero</i>...\u00a0</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["The Robot","(Solo)"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3431600/header.jpg?t=1760900900","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3431600/911