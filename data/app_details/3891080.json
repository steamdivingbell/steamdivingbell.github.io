38.jpg?t=1771779227"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3891080/3827c220784c45accd8f4bbc7704a0af967067f0/ss_3827c220784c45accd8f4bbc7704a0af967067f0.1920x1080.jpg?t=1771779227","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3891080/3827c220784c45accd8f4bbc7704a0af967067f0/ss_3827c220784c45accd8f4bbc7704a0af967067f0.600x338.jpg?t=1771779227"}],"short_description":"Armed with a big smile and punches that fly endlessly,have fun progressing! P-PAN can fly and hovering,so even if you're not good at play jumping action,this 2D action shooting game has simple controls that can enjoy.","steam_appid":3891080,"support_info":{"email":"info@peta-peta.net","url":""},"supported_languages":"English, Japanese","type":"game","website":null}