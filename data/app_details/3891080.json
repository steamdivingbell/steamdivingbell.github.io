ertical-scrolling shooter-style stages.</p><p class=\"bb_paragraph\" >Each stage and boss has original background music! Boss battles are incredibly exciting! Aim for a complete clear!</p>","developers":["palpuni"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3891080/b691013d5aba199c2da5763326421546ac5ff154/header.jpg?t=1771779227","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3891080/330327822/d4a74fd031b15b3dd1dff7e029cb16302a16cf4d/1770484376/dash_av1.mpd?t=1770485052","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3891080/330327822/d4a74fd031b15b3dd1dff7e029cb16302a16cf4d/1770484376/dash_h264.mpd?t=1770485052","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3891080/330327822/d4a74fd031b15b3dd1dff7e029cb16302a16cf4d/1770484376/hls_264_master.m3u8?t=1770485052","id":257281948,"name":"P\u30d1\u30f3\u4e88\u544a\u7de8\u7b2c\u4e09\u5f3e","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257281948/cc0a63289fa418e8065b92dab31e837f48af5529/movie_600x337.jpg?t=1770485052"}],"name":"P-PAN","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows10+<br></li><li><strong>Memory:</strong> 500 MB RAM<br></li><li><strong>DirectX:</strong> Version 9.0<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows10+<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["palpuni"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00ea