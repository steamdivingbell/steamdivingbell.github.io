shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512280/e2b96082f5a2c2f19d63d1ba9431cadbeb4fb59b/ss_e2b96082f5a2c2f19d63d1ba9431cadbeb4fb59b.1920x1080.jpg?t=1766095545","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512280/e2b96082f5a2c2f19d63d1ba9431cadbeb4fb59b/ss_e2b96082f5a2c2f19d63d1ba9431cadbeb4fb59b.600x338.jpg?t=1766095545"}],"short_description":"WILDERLOCKE is a tactical monster-taming roguelike. Build up a team of diverse &amp; powerful monsters. Find the perfect combinations of moves, passives &amp; stats to create devastating synergies. Triumph in increasingly challenging 2v2 turn-based battles and become unstoppable.","steam_appid":3512280,"support_info":{"email":"davidlitt.dev@gmail.com","url":""},"supported_languages":"English, French","type":"game","website":null}