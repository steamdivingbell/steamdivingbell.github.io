ttps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3472300/57e1af3f48bfdeec6150dfe2809fd4640c9b43a3/ss_57e1af3f48bfdeec6150dfe2809fd4640c9b43a3.1920x1080.jpg?t=1741622497","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3472300/57e1af3f48bfdeec6150dfe2809fd4640c9b43a3/ss_57e1af3f48bfdeec6150dfe2809fd4640c9b43a3.600x338.jpg?t=1741622497"}],"short_description":"Feeling Medievaly? Travel to the most vibrant version of the Dark Ages yet to defend your kingdom from encroaching enemies! Devise creative strategies, manage resources, and enjoy a dynamic simulated medieval battlefield where every decision matters and the unexpected will always happen!","steam_appid":3472300,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English","type":"game","website":"http://steelkrill.com/"}