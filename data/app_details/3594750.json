/ss_874910a3715bdff665e9cd60238fb4a42afe2d78.1920x1080.jpg?t=1751193682","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594750/874910a3715bdff665e9cd60238fb4a42afe2d78/ss_874910a3715bdff665e9cd60238fb4a42afe2d78.600x338.jpg?t=1751193682"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594750/6a5b0c34d753341aad1143f985052a7c0410cafd/ss_6a5b0c34d753341aad1143f985052a7c0410cafd.1920x1080.jpg?t=1751193682","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594750/6a5b0c34d753341aad1143f985052a7c0410cafd/ss_6a5b0c34d753341aad1143f985052a7c0410cafd.600x338.jpg?t=1751193682"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594750/055c1bfadf375ab7ff41e39ae3bdf233444eb987/ss_055c1bfadf375ab7ff41e39ae3bdf233444eb987.1920x1080.jpg?t=1751193682","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594750/055c1bfadf375ab7ff41e39ae3bdf233444eb987/ss_055c1bfadf375ab7ff41e39ae3bdf233444eb987.600x338.jpg?t=1751193682"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594750/71c22dd556d9cb02c542b623c4d0c1e8d13531ab/ss_71c22dd556d9cb02c542b623c4d0c1e8d13531ab.1920x1080.jpg?t=1751193682","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594750/71c22dd556d9cb02c542b623c4d0c1e8d13531ab/ss_71c22dd556d9cb02c542b623c4d0c1e8d13531ab.600x338.jpg?t=1751193682"}],"short_description":"Survive an open world using advanced tech. Manage energy, operate bots, and build your base. But something feels wrong. Power lines fail. Machines go silent. Is it just coincidence or is something watching?","steam_appid":3594750,"support_info":{"email":"thelastresourcer@gmail.com","url":""},"supported_languages":"English, Turkish, French, German, Spanish - Spain, Portuguese - Brazil, Russian","type":"game","website":null}