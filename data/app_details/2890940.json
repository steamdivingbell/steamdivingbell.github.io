05611\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Variety of Gameplay Modes</strong></p><p class=\"bb_paragraph\" >&quot;Cat Girl Survivor: Bullet Action&quot; offers more than just a story mode. Enjoy diverse play modes like \u2018Adventure Mode\u2019 and \u2018Infinite Dungeon.\u2019 Experience the primal thrill of infinite dungeons from classic vampire-like games and the fresh fun of a roguelike system in \u2018Adventure Mode\u2019 for a rich and varied gameplay experience.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Translated with  (free version)</p>","developers":["Minimum Studio Corp."],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2890940/456d61f0833713ff0e96d9ddcc972c9951bfc0fe/header.jpg?t=1757305611","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257011783,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257011783/movie480.mp4?t=1753771491","max":"http://video.akamai.steamstatic.com/store_trailers/257011783/movie_max.mp4?t=1753771491"},"name":"Cat Girl Survivor","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257011783/819461faa0c63e897210ecb6c7ed0f73ec8b2808/movie_600x337.jpg?t=1753771491","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257011783/movie480_vp9.webm?t=1753771491","max":"http://video.akamai.steamstatic.com/store_trailers/257011783/movie_max_vp9.webm?t=1753771491"}}],"name":"Cat Girl Survivor","package_gr