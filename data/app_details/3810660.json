c66a82c906eddc2.1920x1080.jpg?t=1773619273","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810660/825cedca5b8478b399805d981c66a82c906eddc2/ss_825cedca5b8478b399805d981c66a82c906eddc2.600x338.jpg?t=1773619273"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810660/e081537e4ff5360a709f988f9c943750d1eda6de/ss_e081537e4ff5360a709f988f9c943750d1eda6de.1920x1080.jpg?t=1773619273","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810660/e081537e4ff5360a709f988f9c943750d1eda6de/ss_e081537e4ff5360a709f988f9c943750d1eda6de.600x338.jpg?t=1773619273"}],"short_description":"A fast-paced sci-fi cute-em-up filled with colourful bullet-hell chaos and giant adorable animals in huge mechs. Play as Astro a space cat, as you blast, dodge, upgrade, trigger Catnip Special Powers, and take down screen-filling cute critters overlords in retro arcade style.","steam_appid":3810660,"support_info":{"email":"","url":"https://discord.gg/h4w5rD92dH"},"supported_languages":"English<strong>*</strong>, Spanish - Spain, Russian, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.beyond-the-pixels.com"}