pps/2101100/ss_84407bef67a26fec686d3494ad705377ddb1925b.600x338.jpg?t=1766499154"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2101100/ss_17f92c1b3d444ed2b30c15047100490db84cecac.1920x1080.jpg?t=1766499154","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2101100/ss_17f92c1b3d444ed2b30c15047100490db84cecac.600x338.jpg?t=1766499154"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2101100/ss_fcbc6948c2ed36b8144a2cc6e86dc8445b507322.1920x1080.jpg?t=1766499154","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2101100/ss_fcbc6948c2ed36b8144a2cc6e86dc8445b507322.600x338.jpg?t=1766499154"}],"short_description":"Capture, train, and battle with unique creatures in this monster-collection RPG featuring turn-based combat and card game strategy. Explore a vibrant world, build your perfect team, and challenge rivals in epic battles!","steam_appid":2101100,"support_info":{"email":"dev@tropicaltempogames.com","url":""},"supported_languages":"English, Portuguese - Brazil, Simplified Chinese, Japanese","type":"game","website":"https://www.instagram.com/kaardik_studio/"}