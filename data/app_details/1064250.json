?t=1761836377","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/218ab6af710264080347d3bfd5a0cad66b6df7ad/ss_218ab6af710264080347d3bfd5a0cad66b6df7ad.600x338.jpg?t=1761836377"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/815adb25fed02c57ffc0a2436224fc19d0d6df45/ss_815adb25fed02c57ffc0a2436224fc19d0d6df45.1920x1080.jpg?t=1761836377","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/815adb25fed02c57ffc0a2436224fc19d0d6df45/ss_815adb25fed02c57ffc0a2436224fc19d0d6df45.600x338.jpg?t=1761836377"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/20800689592b9ce655b9fb7331cc6779b3272b4c/ss_20800689592b9ce655b9fb7331cc6779b3272b4c.1920x1080.jpg?t=1761836377","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/20800689592b9ce655b9fb7331cc6779b3272b4c/ss_20800689592b9ce655b9fb7331cc6779b3272b4c.600x338.jpg?t=1761836377"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/82eec554141ac140469331aa0041d753c6f4286e/ss_82eec554141ac140469331aa0041d753c6f4286e.1920x1080.jpg?t=1761836377","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/82eec554141ac140469331aa0041d753c6f4286e/ss_82eec554141ac140469331aa0041d753c6f4286e.600x338.jpg?t=1761836377"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/024be4dfbd382d1dd84caa84c238c14a65cbc8ca/ss_024be4dfbd382d1dd84caa84c238c14a65cbc8ca.1920x1080.jpg?t=1761836377","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1064250/024be4dfbd382d1dd84caa84c238c14a65cbc8ca/ss_024be4dfbd382d1dd84caa84c238c14a65cbc8ca.600x338.jpg?t=1761836377"}],"short_description":"A 2D platform game about the ancient stories of the Huni Kuin indigenous people, who live in the Brazilian Amazon. The entire game was produced in collaboration with the Huni Kuin communities of the Jord\u00e3o river, in Acre.","steam_appid":1064250,"support_info":{"email":"contact@qubyteinteractive.com","url":"https://www.qubyteinteractive.com/"},"supported_languages":"English, Portuguese - Brazil, Spanish - Spain","type":"game","website":"http://www.gamehunikuin.com"}