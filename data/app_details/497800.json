st paced gameplay.","steam_appid":497800,"support_info":{"email":"jeremiah@goldenkronehotel.com","url":"http://www.goldenkronehotel.com/"},"supported_languages":"English","type":"game","website":"http://www.goldenkronehotel.com/"}