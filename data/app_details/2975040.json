ai.steamstatic.com/store_item_assets/steam/apps/2975040/extras/2322df6de1ec6d6a2ed7a45fc020cc6a.avif?t=1764610584\" width=616 height=75 /></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975040/extras/ec41a5eea51a9acd7fbd9f1fea3da397.poster.avif?t=1764610584\" width=616 height=150 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975040/extras/ec41a5eea51a9acd7fbd9f1fea3da397.webm?t=1764610584\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >Hordes of undead are on their way, and there are some extremely dangerous opponents among them. Try to delay the moment of imminent end, because you are the only barrier defending life. Survive Death!</p>","developers":["Dmitriy Zakharov","Andrey Zakharov"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2975040/header.jpg?t=1764610584","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2975040/1702902458/b3f7f90e0c2fb337ff98ac597d1fbae883ffe55d/1763977803/dash_av1.mpd?t=1763978889","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2975040/1702902458/b3f7f90e0c2fb337ff98ac597d1fbae883ffe55d/1763977803/dash_h264.mpd?t=1763978889","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2975040/1702902458/b3f7f90e0c2fb337ff98ac597d1fbae883ffe55d/1763977803/hls_264_master.m3u8?t=1763978889","id":257236911,"name":"Early Access Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257236911/559e21d082633cc2aac1e1a3575dc7743f368dad/movie_600x337.jpg?t=1763978889"}],"name":"Gate Guardian","