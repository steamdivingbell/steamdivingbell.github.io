2f95808ff697dd53ddd507b4d429e71b3f1a8c/ss_f72f95808ff697dd53ddd507b4d429e71b3f1a8c.600x338.jpg?t=1757438624"}],"short_description":"Suit up and get ready to rescue survivors of a zombie plague! Team up with friends and form an elite search &amp; rescue unit deploying into an area overrun by zombies. Find survivors and survive against relentless hordes in a co-op zombie survival game experienced through the sturdy lens of a body cam.","steam_appid":3168930,"support_info":{"email":"support@indie.io","url":"https://www.infectcam.com"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Russian, Turkish, Spanish - Spain<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.infectcam.com"}