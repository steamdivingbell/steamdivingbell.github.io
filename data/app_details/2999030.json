ai.steamstatic.com/steamcommunity/public/images/apps/2999030/e2ec3618ba5a47fc207768493255b18bd435238c.jpg"},{"name":"\"OUR\" Cards","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2999030/d398e75b458a7be21904f841d0b3f354f3e79b38.jpg"},{"name":"AI Overlord","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2999030/b71789b49ef79dff8b900e88f6245d9a7a7cf8d6.jpg"},{"name":"Cool Cats don't look at explosions","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2999030/6e2e970843e223563c26809bf8ddbadc051fcc91.jpg"},{"name":"Imploding Doom!","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/2999030/770292b656575df91f3e02ad2968872ca41d9645.jpg"}],"total":16},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/2999030?t=1765983095","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2999030/page_bg_raw.jpg?t=1765983095","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2999030/9efe335c894cc39c3d8bd423cc86c43018c25c00/capsule_231x87.jpg?t=1765983095","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2999030/9efe335c894cc39c3d8bd423cc86c43018c25c00/capsule_184x69.jpg?t=1765983095","categories":[{"description":"Single-player","id":2},{"description":"Multi-player","id":1},{"description":"PvP","id":49},{"description":"Online PvP","id":36},{"description":"Steam Achievements","id":22},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"detailed_description":"<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2999030/extras/5df3609072651b1474d315eaa0374f0f.poster.avif?t=1765983095\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam