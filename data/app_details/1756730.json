bdad654c03b7fc108.1920x1080.jpg?t=1749777691","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1756730/ss_28e8fe362affe28325fad5bbdad654c03b7fc108.600x338.jpg?t=1749777691"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1756730/ss_ca15eccea7c946abda8bae4773b3be5bb0266a64.1920x1080.jpg?t=1749777691","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1756730/ss_ca15eccea7c946abda8bae4773b3be5bb0266a64.600x338.jpg?t=1749777691"}],"short_description":"Kingdom Solaris has been laid low. A former soldier must learn what it means to be a surrogate father in a dying nation. To make ends meet, he turns to the Mercenary Guild for work. Build your company\u2019s forces, overcome impossible odds, and stumble upon ever greater threats to the realm.","steam_appid":1756730,"support_info":{"email":"developer@talberon.com","url":""},"supported_languages":"English","type":"game","website":"https://talberon.com"}