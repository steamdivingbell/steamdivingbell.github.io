m_assets/steam/apps/3530060/4040174a395e4e8cc2685098ea1bf0893e926d5c/ss_4040174a395e4e8cc2685098ea1bf0893e926d5c.600x338.jpg?t=1758798049"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3530060/e2d98e012a32205cbd16ecb56d4b5efd46fac80e/ss_e2d98e012a32205cbd16ecb56d4b5efd46fac80e.1920x1080.jpg?t=1758798049","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3530060/e2d98e012a32205cbd16ecb56d4b5efd46fac80e/ss_e2d98e012a32205cbd16ecb56d4b5efd46fac80e.600x338.jpg?t=1758798049"}],"short_description":"Drill Space is a rogue-lite survival mining game where gravity shapes your journey. Explore a vibrant, randomly generated solar system, mine for resources, upgrade your ship, and defend against alien invasions. How long can you survive as you conquer the vastness of space?","steam_appid":3530060,"support_info":{"email":"exoshorestudios@gmail.com","url":""},"supported_languages":"English, Simplified Chinese, Traditional Chinese, Spanish - Latin America, Vietnamese, Spanish - Spain, Japanese, Korean, Russian, French, German, Italian, Indonesian","type":"game","website":null}