nail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2871090/c98265b5d436041078d684ae75fec9de5652cdff/ss_c98265b5d436041078d684ae75fec9de5652cdff.600x338.jpg?t=1757093679"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2871090/f118d8740cf25cc4a350f84db61fe5dd920ca9f8/ss_f118d8740cf25cc4a350f84db61fe5dd920ca9f8.1920x1080.jpg?t=1757093679","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2871090/f118d8740cf25cc4a350f84db61fe5dd920ca9f8/ss_f118d8740cf25cc4a350f84db61fe5dd920ca9f8.600x338.jpg?t=1757093679"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2871090/b7a2ba471761b9e0ef30aac877a55e100a620bea/ss_b7a2ba471761b9e0ef30aac877a55e100a620bea.1920x1080.jpg?t=1757093679","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2871090/b7a2ba471761b9e0ef30aac877a55e100a620bea/ss_b7a2ba471761b9e0ef30aac877a55e100a620bea.600x338.jpg?t=1757093679"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2871090/9417b0fb72500a1ddc090017140640694db1806c/ss_9417b0fb72500a1ddc090017140640694db1806c.1920x1080.jpg?t=1757093679","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2871090/9417b0fb72500a1ddc090017140640694db1806c/ss_9417b0fb72500a1ddc090017140640694db1806c.600x338.jpg?t=1757093679"}],"short_description":"Dweller is a psychological walking sim horror game where you're trapped in a rotting sewer system with something watching your every move. You're low on resources, high on tension, and the only voice you hear might be trying to help... or mess with your head. Trust no one. Stay quiet. Stay alive.","steam_appid":2871090,"support_info":{"email":"","url":"https://www.alexlemesurier.com/"},"supported_languages":"English","type":"game","website":null}