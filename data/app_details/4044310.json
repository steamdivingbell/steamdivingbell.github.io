f207b03fd3fb5e77e/ss_5a1d4154eb3a293a5cf829df207b03fd3fb5e77e.1920x1080.jpg?t=1763984065","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4044310/5a1d4154eb3a293a5cf829df207b03fd3fb5e77e/ss_5a1d4154eb3a293a5cf829df207b03fd3fb5e77e.600x338.jpg?t=1763984065"}],"short_description":"Periphery is a psychedelic action-horror game. Uncover the truth about your workspace, get introduced to the locals and their gnostic fascination. Warp into the pixelated world of Periphery and experience surreal world built on mystery.","steam_appid":4044310,"support_info":{"email":"evegamestudios@gmail.com","url":""},"supported_languages":"English, Turkish","type":"game","website":null}