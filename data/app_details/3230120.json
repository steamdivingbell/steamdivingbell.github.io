4c98323b/ss_5e3151438482299e8609e9483634c9f94c98323b.1920x1080.jpg?t=1770864821","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3230120/5e3151438482299e8609e9483634c9f94c98323b/ss_5e3151438482299e8609e9483634c9f94c98323b.600x338.jpg?t=1770864821"}],"short_description":"Help Zozo find his way home in this cartoon-inspired Metroidvania platformer. Pillow-fight sentient pastries, train under an octopus master, and brave a cybernetic jungle as you explore the vibrant landscapes of Zozo's dreams.","steam_appid":3230120,"support_info":{"email":"support@reddunesgames.com","url":"www.reddunesgames.com"},"supported_languages":"English","type":"game","website":null}