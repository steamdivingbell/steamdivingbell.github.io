5825","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2818520/ss_d9dfea033f6f6ea1d42b30a4d847aaf408e26d60.600x338.jpg?t=1747165825"}],"short_description":"Face your fears and attempt to endure the Trial of Nightmares in this unforgiving roguelite-survivor game. Unlock gear, skills, origins, and ascensions to create your perfect broken build. Rip through countless hordes of enemies as you battle for control of the nightmare realm.","steam_appid":2818520,"support_info":{"email":"support@aeriedigital.com","url":"http://www.aeriedigital.com"},"supported_languages":"English","type":"game","website":"https://www.megafauna.games/"}