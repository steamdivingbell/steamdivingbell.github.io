apps/3711790/extras/8859fd0efeda913e6b86e8d82f914500.webm?t=1759685204\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711790/extras/8859fd0efeda913e6b86e8d82f914500.mp4?t=1759685204\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >RICH STORYTELLING</h2><p class=\"bb_paragraph\" >Filled with honour, betrayal, slapstick chaos, and Otter Yakuza energy.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >CONTROLLER FRIENDLY</h2><p class=\"bb_paragraph\" >Built for short, punchy sessions or deep story dives.</p>","developers":["GhostBone Studio"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711790/17341531d9286832b6557bea2c3e76331f00937d/header.jpg?t=1759685204","is_free":false,"legal_notice":"<strong>\u00a9 2025 Ghostbone Studio. All rights reserved.</strong><br><br>Otter Yakuza\u2122 and all related characters, environments, names, and visual designs are the property of Ghostbone Studio.<br>Unauthorized reproduction, distribution, or modification of this game or its content is strictly prohibited.<br><br>All other trademarks, service marks, and company names or logos are the property of their respective owners.<br>This game is a work of fiction. Any resemblance to real persons, living or dead, or actual events is purely coincidental.<br><br><i>This game may contain placeholder content or features still under development.<br>Gameplay, visuals, and features are subject to change without notice.</i>","linux_requirements":[],"mac_requirements":[],"name":"Otter Yakuza","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 or later<br></li><li><strong>Processor:</strong>  Intel Core i3-3240 (2 * 3400); AMD FX-4300 (4 * 38