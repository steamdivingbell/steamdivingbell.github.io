e wisely to get the most out of your day. If you miss out on something, there's always <strong>Another Day with You</strong>, and another chance for love.</p><p class=\"bb_paragraph\" ></p>","developers":["baugip"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991110/42b3591c068e04afb36c08841d4a473c4c3223d0/header.jpg?t=1771823364","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1991110/1111031284/f7233e9e59ed716999fc4b69f9385b7c13ba0b82/1768867003/dash_av1.mpd?t=1771261957","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1991110/1111031284/f7233e9e59ed716999fc4b69f9385b7c13ba0b82/1768867003/dash_h264.mpd?t=1771261957","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1991110/1111031284/f7233e9e59ed716999fc4b69f9385b7c13ba0b82/1768867003/hls_264_master.m3u8?t=1771261957","id":257038797,"name":"Main Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257038797/1293a982015417bbad751d5da27a9ec5c147e2a8/movie_600x337.jpg?t=1771261957"}],"name":"Another Day with You","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 x64<br></li><li><strong>Processor:</strong> AMD Ryzen 5 3600<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1060<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["baugip"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"esrb":{"descriptors":"Fantasy Violence\r\n