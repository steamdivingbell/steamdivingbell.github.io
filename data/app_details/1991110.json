_assets/steam/apps/1991110/ee929599f97313d9f417c144d278fd5d62d169fb/ss_ee929599f97313d9f417c144d278fd5d62d169fb.1920x1080.jpg?t=1771823364","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1991110/ee929599f97313d9f417c144d278fd5d62d169fb/ss_ee929599f97313d9f417c144d278fd5d62d169fb.600x338.jpg?t=1771823364"}],"short_description":"Another Day with You is an adventure game featuring mini-games galore. Explore this quiet corner of the city - time passes as you play, whether you are talking to locals, playing hide and seek, or at the arcade. Will you leave your date waiting? Did you bring flowers? It's Another Day with You.","steam_appid":1991110,"support_info":{"email":"","url":"baugipgames@gmail.com"},"supported_languages":"English","type":"game","website":null}