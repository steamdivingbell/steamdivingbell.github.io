mai.steamstatic.com/store_item_assets/steam/apps/4043390/61ce44b00d5339d13aa8f183eeaff651020bf7e4/ss_61ce44b00d5339d13aa8f183eeaff651020bf7e4.600x338.jpg?t=1774058297"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043390/c0f2053904273ea3279979d73787c24e27ad56d7/ss_c0f2053904273ea3279979d73787c24e27ad56d7.1920x1080.jpg?t=1774058297","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043390/c0f2053904273ea3279979d73787c24e27ad56d7/ss_c0f2053904273ea3279979d73787c24e27ad56d7.600x338.jpg?t=1774058297"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043390/31d2b8536f6412d26dff73ea6cce06346902d8d0/ss_31d2b8536f6412d26dff73ea6cce06346902d8d0.1920x1080.jpg?t=1774058297","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043390/31d2b8536f6412d26dff73ea6cce06346902d8d0/ss_31d2b8536f6412d26dff73ea6cce06346902d8d0.600x338.jpg?t=1774058297"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043390/1a3f1093e9fc790e45bddf67b4f16ebe8a8a16a7/ss_1a3f1093e9fc790e45bddf67b4f16ebe8a8a16a7.1920x1080.jpg?t=1774058297","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4043390/1a3f1093e9fc790e45bddf67b4f16ebe8a8a16a7/ss_1a3f1093e9fc790e45bddf67b4f16ebe8a8a16a7.600x338.jpg?t=1774058297"}],"short_description":"An isometric role-playing game about managing a fortress. Receive petitioners, assist residents, and set priorities. Manage time, resources, and relationships with key characters to make important decisions and create a unique story of your reign.","steam_appid":4043390,"support_info":{"email":"","url":"https://www.instagram.com/_.elevel._/"},"supported_languages":"Russian, English, French, Italian, German, Spanish - Spain, Arabic, Simplified Chinese, Korean, Polish, Portuguese - Brazil, Japanese","type":"game","website":null}