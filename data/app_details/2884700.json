/steam/apps/2884700/ffd44958ff949d9d4c77e56bd9928421c7bc36d9/ss_ffd44958ff949d9d4c77e56bd9928421c7bc36d9.1920x1080.jpg?t=1751470762","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2884700/ffd44958ff949d9d4c77e56bd9928421c7bc36d9/ss_ffd44958ff949d9d4c77e56bd9928421c7bc36d9.600x338.jpg?t=1751470762"}],"short_description":"Liberate Nottingham from the dark alliances of Prince John as the daring outlaw Robin Hood. Stick to the shadows, fight the enemies of King Richard, evade and outsmart your foes, and shape the fate of Nottingham forever. A short, simple, sandbox stealth game.","steam_appid":2884700,"support_info":{"email":"andrzej@judicamegames.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}