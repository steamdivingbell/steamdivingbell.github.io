ail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3086440/7b4bd00873c39db2e16ab409b6c564198226d5b2/ss_7b4bd00873c39db2e16ab409b6c564198226d5b2.600x338.jpg?t=1765746840"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3086440/78e679b6bf6364977e4ac63a87686413ef4c6e83/ss_78e679b6bf6364977e4ac63a87686413ef4c6e83.1920x1080.jpg?t=1765746840","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3086440/78e679b6bf6364977e4ac63a87686413ef4c6e83/ss_78e679b6bf6364977e4ac63a87686413ef4c6e83.600x338.jpg?t=1765746840"}],"short_description":"Experience the weight of gladiatorial combat in this techno-Roman survivor where every weapon swing matters. Clone warrior seeks freedom through arena bloodshed in a cycle of power and corruption.","steam_appid":3086440,"support_info":{"email":"biuro@galaktus.pl","url":"https://galaktus.pl "},"supported_languages":"English","type":"game","website":null}