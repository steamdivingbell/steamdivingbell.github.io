/steam/apps/3799560/d6d9633df8281ec6c030a5889992519dc5be2cc0/ss_d6d9633df8281ec6c030a5889992519dc5be2cc0.1920x1080.jpg?t=1774491928","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3799560/d6d9633df8281ec6c030a5889992519dc5be2cc0/ss_d6d9633df8281ec6c030a5889992519dc5be2cc0.600x338.jpg?t=1774491928"}],"short_description":"Battle deadly enemies for soul cards and modifiers, and bend time to undo your mistakes in this dark fantasy roguelite/roguelike deckbuilder. Play as Adam, the Grim Reaper\u2019s son, fight beside your husky, meet Grim\u2019s daily quota, and claw your way toward bringing your girlfriend back from the dead","steam_appid":3799560,"support_info":{"email":"","url":"https://www.ThunderRamStudios.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.GrimsLair.com"}