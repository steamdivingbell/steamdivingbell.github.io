on for a real trip.\u00a0</p></li><li><p class=\"bb_paragraph\" ><strong>MULTIPLE CHALLENGES:</strong> Play the main missions, complete hard challenges or play endlessly without time limitations and score your best time.</p></li><li><p class=\"bb_paragraph\" ><strong>AMAZING MUSIC</strong>: A perfect blend of nostalgia and space feel all thanks to\u00a0<strong><u>Lukasz (X-Ray) Sychowicz</u> </strong>to his song<strong> <u>Zizibum</u></strong></p></li></ul><p class=\"bb_paragraph\" > </p>","developers":["DroidGames Studio"],"dlc":[3744330,3995860],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2213990/02f8e64b3c2392a6c3c20812866aef12c2209ab5/header.jpg?t=1764811436","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2213990/126557193/cc1d7df046429d8e60deef15b5437328b15081a6/1763498482/dash_av1.mpd?t=1763499603","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2213990/126557193/cc1d7df046429d8e60deef15b5437328b15081a6/1763498482/dash_h264.mpd?t=1763499603","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2213990/126557193/cc1d7df046429d8e60deef15b5437328b15081a6/1763498482/hls_264_master.m3u8?t=1763499603","id":257162006,"name":"My Last 20 - Release Gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257162006/a501c4b35cce964d8b50cddd5a34214beb613fc4/movie_600x337.jpg?t=1763499603"}],"name":"My Last 20","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:<