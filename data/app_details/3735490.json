_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/6e0489b6941514fdc6cfa846c1817c9a7286c6c6/ss_6e0489b6941514fdc6cfa846c1817c9a7286c6c6.600x338.jpg?t=1767372230"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/c03746f85db99111fc85408912fcc57107f66b07/ss_c03746f85db99111fc85408912fcc57107f66b07.1920x1080.jpg?t=1767372230","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/c03746f85db99111fc85408912fcc57107f66b07/ss_c03746f85db99111fc85408912fcc57107f66b07.600x338.jpg?t=1767372230"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/e6ca4f1f2ae4b0a20e87fd23e478243ee480728f/ss_e6ca4f1f2ae4b0a20e87fd23e478243ee480728f.1920x1080.jpg?t=1767372230","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/e6ca4f1f2ae4b0a20e87fd23e478243ee480728f/ss_e6ca4f1f2ae4b0a20e87fd23e478243ee480728f.600x338.jpg?t=1767372230"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/fc26b6b8a307dcf97a0834b2337546a20bd29f73/ss_fc26b6b8a307dcf97a0834b2337546a20bd29f73.1920x1080.jpg?t=1767372230","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/fc26b6b8a307dcf97a0834b2337546a20bd29f73/ss_fc26b6b8a307dcf97a0834b2337546a20bd29f73.600x338.jpg?t=1767372230"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/28c5fcc1b23b680cd5f0864779aa3a07b094533c/ss_28c5fcc1b23b680cd5f0864779aa3a07b094533c.1920x1080.jpg?t=1767372230","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/28c5fcc1b23b680cd5f0864779aa3a07b094533c/ss_28c5fcc1b23b680cd5f0864779aa3a07b094533c.600x338.jpg?t=1767372230"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/a46d149ec1eb96a9c5a28af400bb369ee4aa71e5/ss_a46d149ec1eb96a9c5a28af400bb369ee4aa71e5.1920x1080.jpg?t=1767372230","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/a46d149ec1eb96a9c5a28af400bb369ee4aa71e5/ss_a46d149ec1eb96a9c5a28af400bb369ee4aa71e5.600x338.jpg?t=1767372230"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/ba0c335f164a9f0aface6e79bd86e07f033f62e1/ss_ba0c335f164a9f0aface6e79bd86e07f033f62e1.1920x1080.jpg?t=1767372230","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735490/ba0c335f164a9f0aface6e79bd86e07f033f62e1/ss_ba0c335f164a9f0aface6e79bd86e07f033f62e1.600x338.jpg?t=1767372230"}],"short_description":"The witches are gone. Only their cats remain. Make a new home for them in this feline city-builder. Keep your cats fed and happy, clean their litter box, and give them a cozy life in a world ravaged by magic.","steam_appid":3735490,"support_info":{"email":"mistpawravine@gmail.com","url":"http://mistpawravine.com/"},"supported_languages":"English","type":"game","website":"http://mistpawravine.com/"}