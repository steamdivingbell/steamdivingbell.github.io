02020/extras/21e94af0212da80e7e6e2ce224bf1066.poster.avif?t=1772192395\" width=224 height=119 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/21e94af0212da80e7e6e2ce224bf1066.webm?t=1772192395\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">\ud83c\udf3f Automatic growth and harvesting system for a carefree experience <br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/b2b69c3c7d8e33dc722ddad77bd83719.poster.avif?t=1772192395\" width=150 height=108 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/b2b69c3c7d8e33dc722ddad77bd83719.webm?t=1772192395\" type=\"video/webm; codecs=vp9\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/75bb5544b673a59c09121e54a0c33184.poster.avif?t=1772192395\" width=218 height=142 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/75bb5544b673a59c09121e54a0c33184.webm?t=1772192395\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">\ud83d\udcd6 Each plant has its own encyclopedia page to record every stage of growth <br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/fcfb78b94a751c02431263002b1c395a.avif?t=1772192395\" width=1165 height=1153 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">We\u2019ve also designed <strong>exclusive packaging</strong>\u00a0for every flower seed and decoration\u2014</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/773f5826824d13f6248e7a1aefe981c8.poster.avif?t=1772192395\" width=434 height=352 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/773f5826824d13f6248e7a1aefe981c8.webm?t=1772192395\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/773f5826824d13f6248e7a1aefe981c8.mp4?t=1772192395\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">just like shopping for toys at a boutique!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">\ud83c\udf19 Customize your own hide shortcut key for quick \u201cinvisible\u201d mode</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/229c5ff6e419588e41e82db93cef76c3.poster.avif?t=1772192395\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/229c5ff6e419588e41e82db93cef76c3.webm?t=1772192395\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/extras/229c5ff6e419588e41e82db93cef76c3.mp4?t=1772192395\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">You can choose to do nothing and simply watch it change,<br>or tap and interact to harvest fruits, rearrange layouts, and adjust decorations.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>Coming in future updates:</strong><br>As your garden expands, new plant types, weather effects, themes, and special events will gradually be unlocked.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>Main Features</strong><br>\ud83c\udf31 More wondrous plants are on their way!<br>\ud83c\udf38 Even more beautiful decorations will be added!<br>\u2600\ufe0f Diverse growth stages and seasonal changes<br>\ud83c\udfb5 The melody of your garden will become richer \u2014 look forward to new tracks!</p><p class=\"bb_paragraph\" style=\"text-align: center\">Whether you\u2019re busy or resting, <i>Idle Garden</i> keeps growing quietly.<br>It never rushes you, only gently accompanies you\u2014<br>like a small, breathing touch of green, living on your screen.</p>","developers":["ZeroGameStudio"],"genres":[{"description":"Casual","id":"4"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4102020/4d59f1dc18d9adcab3dfd8c61fef1182b3643147/header.jpg?t=1772192395","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4102020/320040769/990e5ec657457492d32dc5201c729c78f488b1e2/1761626992/dash_av1.mpd?t=1761627870","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4102020/320040769/990e5ec657457492d32dc5201c729c78f488b1e2/1761626992/dash_h264.mpd?t=1761627870","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4102020/320040769/990e5ec657457492d32dc5201c729c78f488b1e2/1761626992/hls_264_master.m3u8?t=1761627870","id":257223474,"name":"PV1","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257223474/aaccd68c8901512b3a533d15f1849531be87899f/movie_600x337.jpg?t=1761627870"}],"name":"Idle Garden","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7+<br></li><li><strong>Processor:</strong> Intel i3+<br></li><li><strong>Memory:</strong> 4 GB RAM</li></ul>","recommended":"<strong>Recommended:</strong><br><u