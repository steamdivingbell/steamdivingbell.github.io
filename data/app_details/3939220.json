9220/extras/a4e6dd5d3a28cf4c9aec54a71e168b49.webm?t=1755317912\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3939220/extras/a4e6dd5d3a28cf4c9aec54a71e168b49.mp4?t=1755317912\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3939220/extras/641c6a78a33f955c4bc1ac70de643892.avif?t=1755317912\" width=577 height=66 /></span></p><p class=\"bb_paragraph\" ></p>","developers":["Neat Games"],"fullgame":{"appid":"2248230","name":"YesterSol"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3939220/26ce84aeff354c68b39a9b87baf9c1ccd2f4e83d/header.jpg?t=1755317912","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257179712,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257179712/movie480.mp4?t=1755166907","max":"http://video.akamai.steamstatic.com/store_trailers/257179712/movie_max.mp4?t=1755166907"},"name":"YesterSol Demo Trailer 1","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257179712/3b7b22694c3d3eb95c79eeec14d7fc4e57a8fd18/movie_600x337.jpg?t=1755166907","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257179712/movie480_vp9.webm?t=1755166907","max":"http://video.akamai.steamstatic.com/store_trailers/257179712/movie_max_vp9.webm?t=1755166907"}}],"name":"YesterSol Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimu