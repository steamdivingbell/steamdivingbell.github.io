mai.steamstatic.com/store_item_assets/steam/apps/3886130/0029f8710ae8d514aa78f8ea7240b872b1e28b4d/ss_0029f8710ae8d514aa78f8ea7240b872b1e28b4d.600x338.jpg?t=1766382931"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/8ca2afd4db8cc6352e0bb5a17355d23d9029fa5e/ss_8ca2afd4db8cc6352e0bb5a17355d23d9029fa5e.1920x1080.jpg?t=1766382931","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/8ca2afd4db8cc6352e0bb5a17355d23d9029fa5e/ss_8ca2afd4db8cc6352e0bb5a17355d23d9029fa5e.600x338.jpg?t=1766382931"}],"short_description":"Metamancer is a Roguelike video game that uses procedural generation for every sprite, item, map and faction making for a unique playing experience each time!","steam_appid":3886130,"support_info":{"email":"colter_robinson@yahoo.com","url":"https://www.facebook.com/profile.php?id=61578617573882"},"supported_languages":"English","type":"game","website":null}