_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/5aac75da1d49e878b747908fedb5f77650411700/ss_5aac75da1d49e878b747908fedb5f77650411700.1920x1080.jpg?t=1754600565","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/5aac75da1d49e878b747908fedb5f77650411700/ss_5aac75da1d49e878b747908fedb5f77650411700.600x338.jpg?t=1754600565"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/3030d7694af1b9ad7656510293f5924200e96416/ss_3030d7694af1b9ad7656510293f5924200e96416.1920x1080.jpg?t=1754600565","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/3030d7694af1b9ad7656510293f5924200e96416/ss_3030d7694af1b9ad7656510293f5924200e96416.600x338.jpg?t=1754600565"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/c371c70dee272c4cbf7ac024726f927c40352503/ss_c371c70dee272c4cbf7ac024726f927c40352503.1920x1080.jpg?t=1754600565","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/c371c70dee272c4cbf7ac024726f927c40352503/ss_c371c70dee272c4cbf7ac024726f927c40352503.600x338.jpg?t=1754600565"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/4857e9c093100f0d932904047886461c9926270b/ss_4857e9c093100f0d932904047886461c9926270b.1920x1080.jpg?t=1754600565","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3886130/4857e9c093100f0d932904047886461c9926270b/ss_4857e9c093100f0d932904047886461c9926270b.600x338.jpg?t=1754600565"}],"short_description":"Metamancer is a Roguelike video game that uses procedural generation for every sprite, item, map and faction making for a unique playing experience each time!","steam_appid":3886130,"support_info":{"email":"colter_robinson@yahoo.com","url":"https://www.facebook.com/profile.php?id=61578617573882"},"supported_languages":"English","type