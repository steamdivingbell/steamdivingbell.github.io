731cc7215a003379e91b1f83d657c05397/ss_2ac269731cc7215a003379e91b1f83d657c05397.600x338.jpg?t=1742317596"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538410/530ed088563a1a1e30d278c509582aa6ce99565f/ss_530ed088563a1a1e30d278c509582aa6ce99565f.1920x1080.jpg?t=1742317596","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538410/530ed088563a1a1e30d278c509582aa6ce99565f/ss_530ed088563a1a1e30d278c509582aa6ce99565f.600x338.jpg?t=1742317596"}],"short_description":"Find your way inside the enemy base and acquire a valuable item. In this first-person shooter, only with good aim and strategy will you be able to survive encounters with hordes of enemy robots. One hacker and one demolitionist will assist you in battle. Beat the demo, get an exclusive reward!","steam_appid":3538410,"support_info":{"email":"deathly-reprieve@outlook.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":"https://www.spsichomanis.com/deathly-reprieve"}