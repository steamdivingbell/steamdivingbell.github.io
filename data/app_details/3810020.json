ideo class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810020/extras/f90b43fd70f325e7c596442bef816128.poster.avif?t=1774433595\" width=616 height=348 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810020/extras/f90b43fd70f325e7c596442bef816128.webm?t=1774433595\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810020/extras/f90b43fd70f325e7c596442bef816128.mp4?t=1774433595\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Accumulate enough points on each level to move from stage to stage, at each Gate, and reach the top!</p><p class=\"bb_paragraph\" ></p>","developers":["Seabird Interactive"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3810020/dad6f802807cf7fdd196d4ee1cb8986b5b2fe9c9/header.jpg?t=1774433595","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 20<br></li><li><strong>Processor:</strong> intel Core i5<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GTX 960<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 22<br></li><li><strong>Processor:</strong> intel Core i5<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GTX 1060 6gb<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS Ventura<br></li><li><strong>Processor:</strong> Apple M1, intel Core i5<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> 7 cores GPU, Intel Iris P