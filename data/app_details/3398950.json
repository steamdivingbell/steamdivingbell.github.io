ai.steamstatic.com/store_item_assets/steam/apps/3398950/ss_46adf7ef6b528196db0b1434c0b9ea70462b3f1a.600x338.jpg?t=1742098672"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3398950/ss_c48cfa41ef02ffaa806b82bfa6953d2cd248a0d0.1920x1080.jpg?t=1742098672","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3398950/ss_c48cfa41ef02ffaa806b82bfa6953d2cd248a0d0.600x338.jpg?t=1742098672"},{"id":17,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3398950/9320a5fd62da4c2c339f7c67edc4e8ad5fa466a4/ss_9320a5fd62da4c2c339f7c67edc4e8ad5fa466a4.1920x1080.jpg?t=1742098672","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3398950/9320a5fd62da4c2c339f7c67edc4e8ad5fa466a4/ss_9320a5fd62da4c2c339f7c67edc4e8ad5fa466a4.600x338.jpg?t=1742098672"}],"short_description":"In this dark romance, horror visual novel, a brutal attack on your village leaves you stranded and vulnerable. Making matters worse is your run-in with the beast of the nearby woods. Will you find a way to escape your demented captor, or will you earn his trust? Choose a side; Don't look back.","steam_appid":3398950,"support_info":{"email":"captainedgestudios@gmail.com","url":""},"supported_languages":"English, Russian","type":"game","website":"https://sites.google.com/view/captainedgestudios"}