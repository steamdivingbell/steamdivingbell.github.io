ates. Explore and finish missions to uncover the secrets and mysteries of this universe.","steam_appid":3613300,"support_info":{"email":"chilistrumpan@gmail.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese","type":"game","website":null}