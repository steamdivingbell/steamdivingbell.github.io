steam/apps/3530640/5e8775ce6da1b2031d44b2efd567575ab47e0c3d/ss_5e8775ce6da1b2031d44b2efd567575ab47e0c3d.600x338.jpg?t=1756892126"}],"short_description":"Pecking Order is a fast-paced, absurd party game where sneaky worms must outwit hungry birds to survive. Juke, dodge, and strategise in a frantic battle of wits and reflexes. Work solo or in teams to complete objectives and escape before time runs out!","steam_appid":3530640,"support_info":{"email":"info@talentdigital.art","url":"www.talentdigital.art"},"supported_languages":"English","type":"game","website":null}