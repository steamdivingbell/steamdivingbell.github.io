a0e7c9b0e19ecccb9946afcacd6c5b.1920x1080.jpg?t=1771397097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/c18087eddaa0e7c9b0e19ecccb9946afcacd6c5b/ss_c18087eddaa0e7c9b0e19ecccb9946afcacd6c5b.600x338.jpg?t=1771397097"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/fbd438235e1ab608ce3ab6ea73d0db231e851054/ss_fbd438235e1ab608ce3ab6ea73d0db231e851054.1920x1080.jpg?t=1771397097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/fbd438235e1ab608ce3ab6ea73d0db231e851054/ss_fbd438235e1ab608ce3ab6ea73d0db231e851054.600x338.jpg?t=1771397097"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/30ff317be08e64a0b017d7f5d96881a436aa2d07/ss_30ff317be08e64a0b017d7f5d96881a436aa2d07.1920x1080.jpg?t=1771397097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/30ff317be08e64a0b017d7f5d96881a436aa2d07/ss_30ff317be08e64a0b017d7f5d96881a436aa2d07.600x338.jpg?t=1771397097"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/c7f298d470589c4e8a0728830923df71a97695aa/ss_c7f298d470589c4e8a0728830923df71a97695aa.1920x1080.jpg?t=1771397097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/c7f298d470589c4e8a0728830923df71a97695aa/ss_c7f298d470589c4e8a0728830923df71a97695aa.600x338.jpg?t=1771397097"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/bc84195b06e1897434288ee212a82654803713e5/ss_bc84195b06e1897434288ee212a82654803713e5.1920x1080.jpg?t=1771397097","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238940/bc84195b06e1897434288ee212a82654803713e5/ss_bc84195b06e1897434288ee212a82654803713e5.600x338.jpg?t=1771397097"}],"short_description":"A fully animated and voiced sister life-sim with roguelite runs. Find a cure for Mio\u2019s illness. Share meals and quiet nights at home, then enter the Abyss each day to fight, loot, and push deeper to protect your simple life together.","steam_appid":3238940,"support_info":{"email":"","url":"https://saikeystudios.com"},"supported_languages":"Simplified Chinese, English, Japanese<strong>*</strong>, Korean, Traditional Chinese, French, Spanish - Spain, Russian, Spanish - Latin America, Vietnamese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://saikeystudios.com"}