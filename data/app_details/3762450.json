 required.</p></li></ul>","developers":["nobisiko games"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3762450/e3e13bb65828a7d1cecc9911e623760312001592/header.jpg?t=1748942591","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257145305,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257145305/movie480.mp4?t=1748689493","max":"http://video.akamai.steamstatic.com/store_trailers/257145305/movie_max.mp4?t=1748689493"},"name":"gameplay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257145305/3bd266d24facd7d8b4e5a768470e10e56d8ac12c/movie_600x337.jpg?t=1748689493","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257145305/movie480_vp9.webm?t=1748689493","max":"http://video.akamai.steamstatic.com/store_trailers/257145305/movie_max_vp9.webm?t=1748689493"}}],"name":"KAKURENBO: Hide and Seek","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows10<br></li><li><strong>Processor:</strong> 2.2GHz / 2 core<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Intel UHD Graphics<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 600 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["nobisiko g