/extras/912b7ad1979ebb8f5afbaa1f70e411bf.mp4?t=1745946268\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Russian Village Simulator on Mars combines your fantasies of space and your love of earth into an incredibly detailed and vibrant world. Build your Martian dream village!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Are you ready to take on the challenge and create a new legacy in the most unusual colony on Mars?</strong>.</p><p class=\"bb_paragraph\" ></p>","developers":["VD Games","PropilGames"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2800460/header.jpg?t=1745946268","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2800460/857562/27e648364824c372e7e590480193a7e1cb18ea3b/1750901326/dash_av1.mpd?t=1742918252","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2800460/857562/27e648364824c372e7e590480193a7e1cb18ea3b/1750901326/dash_h264.mpd?t=1742918252","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2800460/857562/27e648364824c372e7e590480193a7e1cb18ea3b/1750901326/hls_264_master.m3u8?t=1742918252","id":257118421,"name":"Game trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257118421/01e7603fe288bc28f7aa6c2fbfb6fb62cc7699a5/movie_600x337.jpg?t=1742918252"}],"name":"Russian Village Simulator on Mars","package_grou