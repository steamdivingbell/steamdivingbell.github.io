59f414f37e/ss_506d3d563d6c66eeb50975456dc33b59f414f37e.1920x1080.jpg?t=1768838871","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3582430/506d3d563d6c66eeb50975456dc33b59f414f37e/ss_506d3d563d6c66eeb50975456dc33b59f414f37e.600x338.jpg?t=1768838871"}],"short_description":"Serve drinks, wrangle passengers, and survive turbulence in this silly solo or co-op flight attendant simulator. Handle routine cabin duties while everything goes hilariously wrong, from loose pets to spiraling passenger panic. It\u2019s pure cabin chaos at 30,000 feet!","steam_appid":3582430,"support_info":{"email":"help@bomas.games","url":"https://uhoh-airlines.com"},"supported_languages":"English, French, German, Spanish - Spain, Dutch, Indonesian, Japanese, Portuguese - Brazil, Portuguese - Portugal, Simplified Chinese, Spanish - Latin America, Latvian, Malay","type":"game","website":"https://uhoh-airlines.com"}