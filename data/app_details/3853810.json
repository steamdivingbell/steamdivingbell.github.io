ai.steamstatic.com/store_item_assets/steam/apps/3853810/2929eff2f165e19286ad4b61bf6f004a8dd111f8/ss_2929eff2f165e19286ad4b61bf6f004a8dd111f8.1920x1080.jpg?t=1758633325","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853810/2929eff2f165e19286ad4b61bf6f004a8dd111f8/ss_2929eff2f165e19286ad4b61bf6f004a8dd111f8.600x338.jpg?t=1758633325"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853810/aa58bf6c7865a42fa9d430d36d9e8cfd78737128/ss_aa58bf6c7865a42fa9d430d36d9e8cfd78737128.1920x1080.jpg?t=1758633325","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853810/aa58bf6c7865a42fa9d430d36d9e8cfd78737128/ss_aa58bf6c7865a42fa9d430d36d9e8cfd78737128.600x338.jpg?t=1758633325"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853810/337e95f9eb59ea5dd31ee15835bb982ce5a81db2/ss_337e95f9eb59ea5dd31ee15835bb982ce5a81db2.1920x1080.jpg?t=1758633325","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853810/337e95f9eb59ea5dd31ee15835bb982ce5a81db2/ss_337e95f9eb59ea5dd31ee15835bb982ce5a81db2.600x338.jpg?t=1758633325"}],"short_description":"Splash the world with color and find your way through the darkness in the demo of this upcoming exploration game. Traverse 3 of the 30+ surreal locations, solve intriguing puzzles, and feel the journey in a way no trailer can show \u2014 before the full version arrives.","steam_appid":3853810,"support_info":{"email":"support@prettysoon.games","url":"https://prettysoon.games"},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Korean, Portuguese - Portugal, Simplified Chinese, Traditional Chinese, Portuguese - Brazil, Russian","type":"demo","website":"https://prettysoon.games"}