d.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/cca03c5e0b54f6b0fc8add6c9b5a44cb.mp4?t=1773110208\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >The world has been covered in goop, which includes giant dinosaurs! Use the environment and all the tools at your disposal to clean every nook and cranny!</p><h2 class=\"bb_tag\" >Upgrade Your Vacuum!</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/9c216ce89f2733e148711015de1e6474.poster.avif?t=1773110208\" width=640 height=220 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/9c216ce89f2733e148711015de1e6474.webm?t=1773110208\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/9c216ce89f2733e148711015de1e6474.mp4?t=1773110208\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >There are multiple kinds of goop to clean in the world, and each affects the world in different ways. Unlock upgrades to your vacuum for overdrive effects specific to each type of goop, providing very different gameplay experiences!</p><h2 class=\"bb_tag\" >Make Dinosaur Friends!</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/1a4a33ecd0ab513c7983a3c4c42922fc.gif?t=1773110208\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/1a4a33ecd0ab513c7983a3c4c42922fc.poster.avif?t=1773110208\" class=\"bb_img\" /></picture></span><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/8424681437b6148cdf9d689fe65d6bd2.apng?t=1773110208\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/8424681437b6148cdf9d689fe65d6bd2.poster.avif?t=1773110208\" class=\"bb_img\" width=32 height=32 /></picture></span><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/11290836f15ffd13cfbd2df08853a760.gif?t=1773110208\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/11290836f15ffd13cfbd2df08853a760.poster.avif?t=1773110208\" class=\"bb_img\" /></picture></span><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/c65cbda2fbec582348dd355e0e5eefe9.apng?t=1773110208\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/c65cbda2fbec582348dd355e0e5eefe9.poster.avif?t=1773110208\" class=\"bb_img\" width=32 height=32 /></picture></span><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/03c8f9815321ea3e84ca8ff88c94e766.apng?t=1773110208\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/03c8f9815321ea3e84ca8ff88c94e766.poster.avif?t=1773110208\" class=\"bb_img\" width=80 height=80 /></picture></span></p><p class=\"bb_paragraph\" >The dinosaur world has been covered in goop, trapping lots of cute characters. Save them from the goop with your trusty vacuum and they'll be waiting for you back at the hub. There you can chat with them between levels, buy hats, and restore the Life Tree to unlock new levels!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3031750/extras/019d3ed918ffc863fa469accf6d54c3b.poster.avif?t=1773110208\" width=640 height=160 >