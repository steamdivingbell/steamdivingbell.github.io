steamstatic.com/store_item_assets/steam/apps/2330570/1871dbf701d64394f6dc4bb935c6c845d8436420/ss_1871dbf701d64394f6dc4bb935c6c845d8436420.1920x1080.jpg?t=1758221421","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2330570/1871dbf701d64394f6dc4bb935c6c845d8436420/ss_1871dbf701d64394f6dc4bb935c6c845d8436420.600x338.jpg?t=1758221421"}],"short_description":"Build and manage a thriving summer camp. Provide your campers with a place to catch fish, kayak, and tell ghost stories around the campfire. Will you create the ultimate summer camp? Or will your reputation as camp director plummet from a bunch of unhappy campers?","steam_appid":2330570,"support_info":{"email":"adam@camplandiagame.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://oddballinteractive.com"}