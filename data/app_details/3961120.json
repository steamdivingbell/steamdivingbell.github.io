s/3961120/55dfc4daecf6ba58103b97054917c1332ca0b5d0/ss_55dfc4daecf6ba58103b97054917c1332ca0b5d0.1920x1080.jpg?t=1771981653","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3961120/55dfc4daecf6ba58103b97054917c1332ca0b5d0/ss_55dfc4daecf6ba58103b97054917c1332ca0b5d0.600x338.jpg?t=1771981653"}],"short_description":"A physics-based comedy platformer where you tumble, roll, and flap your way through chaotic warehouse challenges as a living cardboard box.","steam_appid":3961120,"support_info":{"email":"team@ludocraticgames.com","url":"https://ludocraticgames.com/"},"supported_languages":"English","type":"game","website":"https://ludocraticgames.com/"}