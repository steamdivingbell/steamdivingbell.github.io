/9d01895daf1699cbb353682187395fd7fe9e9241/ss_9d01895daf1699cbb353682187395fd7fe9e9241.600x338.jpg?t=1761283736"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3119700/9df00763a849f6435d6634d62a5b87554329df8a/ss_9df00763a849f6435d6634d62a5b87554329df8a.1920x1080.jpg?t=1761283736","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3119700/9df00763a849f6435d6634d62a5b87554329df8a/ss_9df00763a849f6435d6634d62a5b87554329df8a.600x338.jpg?t=1761283736"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3119700/f284a9ce5896e2ab7cc6572f70f7af9c66e6668b/ss_f284a9ce5896e2ab7cc6572f70f7af9c66e6668b.1920x1080.jpg?t=1761283736","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3119700/f284a9ce5896e2ab7cc6572f70f7af9c66e6668b/ss_f284a9ce5896e2ab7cc6572f70f7af9c66e6668b.600x338.jpg?t=1761283736"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3119700/d8fa9853c3c3bbfb4bb7dac51971d754661d947c/ss_d8fa9853c3c3bbfb4bb7dac51971d754661d947c.1920x1080.jpg?t=1761283736","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3119700/d8fa9853c3c3bbfb4bb7dac51971d754661d947c/ss_d8fa9853c3c3bbfb4bb7dac51971d754661d947c.600x338.jpg?t=1761283736"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3119700/697fd429df3670c87a0eefd6950f3658c21c215b/ss_697fd429df3670c87a0eefd6950f3658c21c215b.1920x1080.jpg?t=1761283736","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3119700/697fd429df3670c87a0eefd6950f3658c21c215b/ss_697fd429df3670c87a0eefd6950f3658c21c215b.600x338.jpg?t=1761283736"}],"short_description":"A charming yet fantastical town, where vitality and decay constantly collide. We hope that through interactions with characters and objects, and the sensory experience created by visuals and sound, you can connect with the emotions and charm of this little world of West Town.","steam_appid":3119700,"support_info":{"email":"publishing@gcores.com","url":""},"supported_languages":"Simplified Chinese, English","type":"game","website":null}