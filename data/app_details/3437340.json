l":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437340/1ba76ade4d12b2c890c2c052128d50bac5fe3ebe/ss_1ba76ade4d12b2c890c2c052128d50bac5fe3ebe.1920x1080.jpg?t=1744293387","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437340/1ba76ade4d12b2c890c2c052128d50bac5fe3ebe/ss_1ba76ade4d12b2c890c2c052128d50bac5fe3ebe.600x338.jpg?t=1744293387"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437340/87667add9551d57b985e63c5bd189066e4c14e06/ss_87667add9551d57b985e63c5bd189066e4c14e06.1920x1080.jpg?t=1744293387","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3437340/87667add9551d57b985e63c5bd189066e4c14e06/ss_87667add9551d57b985e63c5bd189066e4c14e06.600x338.jpg?t=1744293387"}],"short_description":"Muster your fireteam, blast through the corrupted denizens of an ancient, sunken civilization, and wield godly powers in Abyssus \u2013 a fast-paced cooperative FPS and roguelite brinepunk adventure.","steam_appid":3437340,"support_info":{"email":"support@thearcadecrew.com","url":"https://www.thearcadecrew.com/support/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Russian, Simplified Chinese, Traditional Chinese, Ukrainian","type":"demo","website":null}