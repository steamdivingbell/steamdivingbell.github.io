.com/store_item_assets/steam/apps/2574970/74cd4116f91db7584b9a2d5a45218cd0a0cb63d2/ss_74cd4116f91db7584b9a2d5a45218cd0a0cb63d2.600x338.jpg?t=1772726450"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2574970/229fdd3da13caceb2909338a8124b9d1e4aa10ba/ss_229fdd3da13caceb2909338a8124b9d1e4aa10ba.1920x1080.jpg?t=1772726450","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2574970/229fdd3da13caceb2909338a8124b9d1e4aa10ba/ss_229fdd3da13caceb2909338a8124b9d1e4aa10ba.600x338.jpg?t=1772726450"}],"short_description":"Crystalfall is a free online Action RPG where your ground loot matters and your skills offer endless procedural customization. Survive in a world destroyed by a mysterious asteroid and grow more powerful with steampunk weapons and lootable skills in an infinite endgame.","steam_appid":2574970,"support_info":{"email":"","url":"https://crystalfall.com/"},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Japanese, Portuguese - Brazil, Russian, Simplified Chinese, Thai, Turkish, Indonesian<br><strong>*</strong>languages with full audio support","type":"game","website":"https://crystalfall.com/"}