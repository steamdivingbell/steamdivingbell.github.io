ai.steamstatic.com/store_item_assets/steam/apps/3845640/789f355050b58629fd373caf39cd2d384c7cce06/ss_789f355050b58629fd373caf39cd2d384c7cce06.600x338.jpg?t=1774557061"}],"short_description":"Become the manager of your very own hotel from another world! Gather resources, play fun mini-games, expand your establishment, and keep your guests entertained. Build your reputation and create the ultimate otherworldly getaway!","steam_appid":3845640,"support_info":{"email":"","url":"https://saikeystudios.com"},"supported_languages":"English, Japanese<strong>*</strong>, Simplified Chinese, Traditional Chinese, Korean<br><strong>*</strong>languages with full audio support","type":"game","website":"https://saikeystudios.com"}