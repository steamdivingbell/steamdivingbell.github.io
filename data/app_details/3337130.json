631a073fab2e7b382a711b16d5a60cff.poster.avif?t=1758634591\" width=800 height=244 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/631a073fab2e7b382a711b16d5a60cff.webm?t=1758634591\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/631a073fab2e7b382a711b16d5a60cff.mp4?t=1758634591\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/daf1ebb8df2c95b4a0191cb5dd50f82d.avif?t=1758634591\" width=902 height=196 /></span></h2><p class=\"bb_paragraph\" >Every impact, collapse, and explosion feels better (and more wholesome) than the last.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/b75b7745a7ef5e8109c5b3bd55a0d38e.poster.avif?t=1758634591\" width=616 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/b75b7745a7ef5e8109c5b3bd55a0d38e.webm?t=1758634591\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/b75b7745a7ef5e8109c5b3bd55a0d38e.mp4?t=1758634591\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Endless Replayability</strong></h2><p class=\"bb_paragraph\" >No two experiments are ever the same. </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/f42fdcc17651dd316e0c0aea848f6611.poster.avif?t=1758634591\" width=800 height=228 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/f42fdcc17651dd316e0c0aea848f6611.webm?t=1758634591\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/f42fdcc17651dd316e0c0aea848f6611.mp4?t=1758634591\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/7b7f9dd02e872510602641d000d4bd6d.avif?t=1758634591\" width=902 height=196 /></span></h2><p class=\"bb_paragraph\" >The sarcastic AI watching your every move? It has a name: the Voice of the Facility. Explore and see what it\u2019s hiding.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/a48810523ac1f0dc0e83087a02663641.poster.avif?t=1758634591\" width=800 height=228 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/a48810523ac1f0dc0e83087a02663641.webm?t=1758634591\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/a48810523ac1f0dc0e83087a02663641.mp4?t=1758634591\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>How You Play in 3 simple steps</strong></h2><p class=\"bb_paragraph\" ><strong>1) Set Up Your Experiment.</strong></p><p class=\"bb_paragraph\" ><strong>2) Activate physics.</strong></p><p class=\"bb_paragraph\" ><strong>3) Enjoy the chaos.</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/c3ddb1498a70351610128d2cc50294ed.poster.avif?t=1758634591\" width=616 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/c3ddb1498a70351610128d2cc50294ed.webm?t=1758634591\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/c3ddb1498a70351610128d2cc50294ed.mp4?t=1758634591\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>What You Can Do in RPX?</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Build elaborate chain reactions &amp; Launch ragdolls</strong> </p></li><li><p class=\"bb_paragraph\" ><strong>Work your way through the challenge rooms</strong></p></li><li><p class=\"bb_paragraph\" ><strong>Explore the facililty and find out the secrets</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/d6675acbacdb9fa6c4da814f948d52d3.avif?t=1758634591\" width=902 height=196 /></span></p><p class=\"bb_paragraph\" ><strong>Get ready to build, destroy, and laugh harder than you ever have before!</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/f15b405bbc554e9d1efdb93777b8e14f.poster.avif?t=1758634591\" width=800 height=228 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/f15b405bbc554e9d1efdb93777b8e14f.webm?t=1758634591\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/f15b405bbc554e9d1efdb93777b8e14f.mp4?t=1758634591\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3337130/extras/6c7957470447b65234e245a384edb1de.avif?t=1758634591\" width=902 height=196 /></span></p>","developers":["Giraffe Head Studios"],"genres":[{"description":"Casual","id":"4"},{"descrip