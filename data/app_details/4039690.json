team/apps/4039690/c763119fe5d166ee9833549cd87ff2ccaa492459/ss_c763119fe5d166ee9833549cd87ff2ccaa492459.600x338.jpg?t=1760609468"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4039690/cc8837c32f4852712296dfca9d143cf4d2a0193d/ss_cc8837c32f4852712296dfca9d143cf4d2a0193d.1920x1080.jpg?t=1760609468","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4039690/cc8837c32f4852712296dfca9d143cf4d2a0193d/ss_cc8837c32f4852712296dfca9d143cf4d2a0193d.600x338.jpg?t=1760609468"}],"short_description":"Brass &amp; Bramble is a narrative deck-builder set in a steampunk Victorian age where myth and empire collide. As Avalon\u2019s Envoy, battle the brass-forged Empire, uncover forgotten roots of myth, and journey from Ireland to Egypt, Japan, and beyond in story-driven expeditions.","steam_appid":4039690,"support_info":{"email":"community@pucalabs.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://pucalabs.com"}