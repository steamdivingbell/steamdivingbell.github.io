 height=150 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1331510/extras/dc82e205c1b1f1ddaae3aa415ffaf458.webm?t=1749444495\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1331510/extras/dc82e205c1b1f1ddaae3aa415ffaf458.mp4?t=1749444495\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >Features:</h2><br><ul class=\"bb_ul\"><li>5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode<br></li><li>Supports multiplayer mode for 2-4 players and includes a built-in voice chat<br></li><li>Built-in scripted mod menu with 2000+ mods, enhance your gaming experience<br></li><li>Thrill of hack-and-slash with realistic physics interactions.<br></li><li>Variety of enemies and bosses, over 80 enemy variants with different moveset<br></li><li>Plenty of weapons and perks, over 100 weapons and over 60 perks<br></li><li>Seamless huge dungeons with multiple landscapes that regenerate each time</li></ul>","developers":["CyDream"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1331510/header.jpg?t=1749444495","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257153815,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257153815/movie480.mp4?t=1749444493","max":"http://video.akamai.steamstatic.com/store_trailers/257153815/movie_max.mp4?t=1749444493"},"name":"MP","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257153815/39d1519abd677c32730b8f3c61edf5e1f355ed52/movie_600x337.jpg?t=1749444493","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257153815/movie480_vp9.webm?t=1749444493","max":"http://video.akamai.steamstatic.com/store_trailers/257153815/movie_max_vp9.webm?t=1749444493"}},{"h