354d767321bf4506d.600x338.jpg?t=1773295521"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3534220/9f45ce012250b0791d73d25bef9c608d9b2af1dc/ss_9f45ce012250b0791d73d25bef9c608d9b2af1dc.1920x1080.jpg?t=1773295521","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3534220/9f45ce012250b0791d73d25bef9c608d9b2af1dc/ss_9f45ce012250b0791d73d25bef9c608d9b2af1dc.600x338.jpg?t=1773295521"}],"short_description":"You think YOU have it bad? Try getting thrown into a quest with nothing to protect yourself, except your wits! In this trial and error adventure game, patience is key. Explore the castle including 6* bosses and 18 levels complete with their own layouts, enemy paths, buttons, doors and coins!","steam_appid":3534220,"support_info":{"email":"heartfeltinteractive@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}