/shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907570/d6b8fd55fafc1b62f3cce736e6b0bd3a4e662be0/ss_d6b8fd55fafc1b62f3cce736e6b0bd3a4e662be0.600x338.jpg?t=1774428870"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907570/437d0e0a90bec9f10c6bce26d72434f673f8a81f/ss_437d0e0a90bec9f10c6bce26d72434f673f8a81f.1920x1080.jpg?t=1774428870","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907570/437d0e0a90bec9f10c6bce26d72434f673f8a81f/ss_437d0e0a90bec9f10c6bce26d72434f673f8a81f.600x338.jpg?t=1774428870"}],"short_description":"Strategy meets action RPG in the criminal underworld of 1920s New York. Extort, trade, and expand your criminal empire while leading your crew in brutal tactical combat. Rule the city through cunning diplomacy or sheer bloodshed.","steam_appid":3907570,"support_info":{"email":"mciftci@cxuni.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, Spanish - Spain, Russian, Turkish, German, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}