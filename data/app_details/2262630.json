562bcbc5cc9486609c18babb28152e1b31af/ss_87cc562bcbc5cc9486609c18babb28152e1b31af.1920x1080.jpg?t=1771192215","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2262630/87cc562bcbc5cc9486609c18babb28152e1b31af/ss_87cc562bcbc5cc9486609c18babb28152e1b31af.600x338.jpg?t=1771192215"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2262630/ss_6f7a9490bc217840fe5d98aaa4c8ee3cd9f0d346.1920x1080.jpg?t=1771192215","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2262630/ss_6f7a9490bc217840fe5d98aaa4c8ee3cd9f0d346.600x338.jpg?t=1771192215"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2262630/193d2eff7479a1bef76d4ad8465ec57f47842dab/ss_193d2eff7479a1bef76d4ad8465ec57f47842dab.1920x1080.jpg?t=1771192215","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2262630/193d2eff7479a1bef76d4ad8465ec57f47842dab/ss_193d2eff7479a1bef76d4ad8465ec57f47842dab.600x338.jpg?t=1771192215"}],"short_description":"Embark on a delightful journey of breeding and raising adorable animals like bunnies, capybaras, and horses while building meaningful relationships with the residents of Llama Town. What unique animal breeds will you discover, and whom among the townsfolk will you befriend? Adventure awaits!","steam_appid":2262630,"support_info":{"email":"hello@wishuponallama.com","url":"https://www.instagram.com/wishuponallama"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.instagram.com/wishuponallama"}