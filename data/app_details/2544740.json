eamstatic.com/store_item_assets/steam/apps/2544740/808a7ea95365da371e11fe39f236610fbbb816a0/ss_808a7ea95365da371e11fe39f236610fbbb816a0.600x338.jpg?t=1744040785"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2544740/7c65bbd84068c58f7a50e3dc8a6550770c19f877/ss_7c65bbd84068c58f7a50e3dc8a6550770c19f877.1920x1080.jpg?t=1744040785","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2544740/7c65bbd84068c58f7a50e3dc8a6550770c19f877/ss_7c65bbd84068c58f7a50e3dc8a6550770c19f877.600x338.jpg?t=1744040785"}],"short_description":"[THANKS, LIGHT.] is a puzzle platformer where you manipulate objects by switching between 2D and 3D using light.Solve geometric and physics-based puzzles through dimensional shifts.Uncover the cause of strange in-game glitches as you explore a mysterious and surreal world.","steam_appid":2544740,"support_info":{"email":"hb@lightersgames.com","url":""},"supported_languages":"English, Korean, Spanish - Spain, Japanese, Russian, Simplified Chinese, Traditional Chinese","type":"game","website":"https://www.lightersgames.com/"}