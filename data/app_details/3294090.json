assets/steam/apps/3294090/c84856affae550ab7bf9c33879791faffb35508b/ss_c84856affae550ab7bf9c33879791faffb35508b.1920x1080.jpg?t=1742571793","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294090/c84856affae550ab7bf9c33879791faffb35508b/ss_c84856affae550ab7bf9c33879791faffb35508b.600x338.jpg?t=1742571793"}],"short_description":"This is the page for the trial version of \u201cCharoite into the Deep,\u201d an action RPG in which the little witch Charois goes underground with her golem. Use skills such as \u201cdowsing\u201d to reach the deepest part of the basement safely.","steam_appid":3294090,"support_info":{"email":"charoite.game.official@gmail.com","url":"https://yontacr.wixsite.com/charoite"},"supported_languages":"English, Japanese","type":"demo","website":"https://yontacr.wixsite.com/charoite"}