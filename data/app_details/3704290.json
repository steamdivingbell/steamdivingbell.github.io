c6b4/ss_6c9b543ecde5a0ec6210c6c2b3c54ab6a7e4c6b4.600x338.jpg?t=1766062781"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3704290/cc8898ca3959e88b0013eed85f1ab3f382e4ddaa/ss_cc8898ca3959e88b0013eed85f1ab3f382e4ddaa.1920x1080.jpg?t=1766062781","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3704290/cc8898ca3959e88b0013eed85f1ab3f382e4ddaa/ss_cc8898ca3959e88b0013eed85f1ab3f382e4ddaa.600x338.jpg?t=1766062781"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3704290/5217aa7b84782555181eebd377852f84e0bab5f3/ss_5217aa7b84782555181eebd377852f84e0bab5f3.1920x1080.jpg?t=1766062781","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3704290/5217aa7b84782555181eebd377852f84e0bab5f3/ss_5217aa7b84782555181eebd377852f84e0bab5f3.600x338.jpg?t=1766062781"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3704290/bd64c4ecd4720c38d8c9b664dd72fdf5d4c5389f/ss_bd64c4ecd4720c38d8c9b664dd72fdf5d4c5389f.1920x1080.jpg?t=1766062781","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3704290/bd64c4ecd4720c38d8c9b664dd72fdf5d4c5389f/ss_bd64c4ecd4720c38d8c9b664dd72fdf5d4c5389f.600x338.jpg?t=1766062781"}],"short_description":"False Princess Iruruu is an action-packed, story-rich adventure game with a rhythmic, Sekiro-like combat system. Follow Iruruu, a girl from the western steppes of China, as she embarks on a dangerous journey to fulfill a summons from the royal Qing court.","steam_appid":3704290,"support_info":{"email":"contact@pocchistudio.com","url":""},"supported_languages":"English, Japanese, Thai","type":"game","website":"https://www.pocchistudio.com/false-princess-iruruu"}