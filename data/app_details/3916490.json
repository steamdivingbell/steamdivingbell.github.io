 Tomes.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >But most importantly\u2014you'll have our heartfelt thanks. Thank you for choosing to support this DLC!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3916490/extras/13ff10285fa6df2ed932c3be3397e596.webp?t=1761905032\" width=633 height=43 /></span></p>","developers":["Pochemu LTD"],"fullgame":{"appid":"3218710","name":"Everlusting Life"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Massively Multiplayer","id":"29"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3916490/9deffa69b8fe47b4a403eae6c440aabd17674ea7/header.jpg?t=1761905032","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3916490/1446836769/1be3e67ef94c956eef290f02ebf00385990c2806/1761852685/dash_av1.mpd?t=1761894709","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3916490/1446836769/1be3e67ef94c956eef290f02ebf00385990c2806/1761852685/dash_h264.mpd?t=1761894709","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3916490/1446836769/1be3e67ef94c956eef290f02ebf00385990c2806/1761852685/hls_264_master.m3u8?t=1761894709","id":257224797,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257224797/movie480.mp4?t=1761894709","max":"https://video.akamai.steamstatic.com/store_trailers/257224797/movie_max.mp4?t=1761894709"},"name":"Roxanne","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257224797/9dcad521a73db56a7110bb52f59b396028071fb8/movie_600x337.jpg?t=1761894709","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257224797/movie480.webm?t=1761894709","m