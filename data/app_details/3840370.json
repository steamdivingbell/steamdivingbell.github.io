play systems are planned for future updates!</p>","developers":["Candeia Studio"],"ext_user_account_notice":"Gabriel Garcia Jerico ","genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3840370/9d21dca37ea76e031c06a7a1aecd372883262fd1/header.jpg?t=1773458479","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3840370/25521264/16d79134a5c590d7adcc6ca90ac3184358dfbc17/1772849470/dash_av1.mpd?t=1773458475","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3840370/25521264/16d79134a5c590d7adcc6ca90ac3184358dfbc17/1772849470/dash_h264.mpd?t=1773458475","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3840370/25521264/16d79134a5c590d7adcc6ca90ac3184358dfbc17/1772849470/hls_264_master.m3u8?t=1773458475","id":257299232,"name":"SETH SLAYS EVERYBODY - GAMEPLAY!","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257299232/79fd25c41211cf981102f32f02759ca32a204e8c/movie_600x337.jpg?t=1773458475"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3840370/1214368629/0aaafece5f95036eb8bbb7b8117787040925b725/1772849409/dash_av1.mpd?t=1773458476","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3840370/1214368629/0aaafece5f95036eb8bbb7b8117787040925b725/1772849409/dash_h264.mpd?t=1773458476","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3840370/1214368629/0aaafece5f95036eb8bbb7b8117787040925b725/1772849409/hls_264_master.m3u8?t=1773458476","id":257299230,"name":"SETH SLAYS EVERYBODY - GAMEPLAY","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257299230/5e8605f1cd55764d2f63df8e34bbf7666b593d33/movie_600x337.jpg?t=1773458476"},{"dash_av1":"https://video.akamai.steamstatic.com/store_traile