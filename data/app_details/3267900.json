i.steamstatic.com/store_item_assets/steam/apps/3267900/extras/0b175d96ac2cbe497ebf48c91732a5c0.mp4?t=1773034381\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Explore over 12 maps</strong> of increasing size and reward as you expand your bombing campaign.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3267900/extras/f89f2b555fd74b908aa13f78c6842749.poster.avif?t=1773034381\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3267900/extras/f89f2b555fd74b908aa13f78c6842749.webm?t=1773034381\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3267900/extras/f89f2b555fd74b908aa13f78c6842749.mp4?t=1773034381\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Prestige and reset</strong> your progress in exchange for powerful, permanent upgrades\u2014including a devastating nuclear bomb.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3267900/extras/1b9de11ff8f201d1b32c00db69d24483.poster.avif?t=1773034381\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3267900/extras/1b9de11ff8f201d1b32c00db69d24483.webm?t=1773034381\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3267900/extras/1b9de11ff8f201d1b32c00db69d24483.mp4?t=1773034381\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >FEATURES</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Satisfying incremental progression.</p></li><li><p class=\"bb_paragraph\" >A short relaxing experience. (~2-4 hour to complete)</p></li><li><p class=\"bb_paragraph\" >2 skill trees to progress through and upgrade your abilities and economy.</p></li><li><p class=\"bb_paragraph\" >12 maps to unlock and level up.</p><p class=\"bb_paragraph\" ></p></li></ul>","developers":["SOCKHOUSE STUDIOS"],"genres":[{"description":"Casual","id":"4"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3267900/7adb8dfa4a64a758322146ca3eb24da141eaaa6f/header.jpg?t=1773034381","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 2 GHz<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> OpenGL 3.3 compatible<br></li><li><strong>Storage:</strong> 150 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 2 GHz<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> OpenGL 3.3 compatible<br></li><li><strong>Storage:</strong> 150 MB available space</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3267900/875197/d96f9fdb1fc630c9be83448f7d2c57d04f45f771/1750886144/dash_av1.mpd?t=1746315923","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3267900/875197/d96f9fdb1fc630c9be83448f7d2c57d04f45f771/1750886144/dash_h264.mpd?t=1746315923","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3267900/875197/d96f9fdb1fc630c9be83448f7d2c57d04f45f771/1750886144/hls_264_master.m3u8?t=1746315923","id":257129144,"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257129144/3aa331dc2b46dd824