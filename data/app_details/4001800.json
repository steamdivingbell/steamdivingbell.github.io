ed loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001800/extras/1989a0549a83664be83df607ce8e2478.poster.avif?t=1767726035\" width=1170 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001800/extras/1989a0549a83664be83df607ce8e2478.webm?t=1767726035\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001800/extras/1989a0549a83664be83df607ce8e2478.mp4?t=1767726035\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >This game includes extensive audio, atmospheric noises, characters, unique creatures, story telling, language and option setting support. Gameplay will vary between 1 - 2 hours, and the game includes save mechanics and subtitles. </p><h2 class=\"bb_tag\" >- LevelBound Studios</h2>","developers":["LevelBound Studios"],"genres":[{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4001800/4acbadb8ebd9d5cc21c314c41aacf53ec2151729/header.jpg?t=1767726035","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4001800/1790997598/c34766b204685da7a69d9b1f033305274e087ed6/1756720023/dash_av1.mpd?t=1760584192","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4001800/1790997598/c34766b204685da7a69d9b1f033305274e087ed6/1756720023/dash_h264.mpd?t=1760584192","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4001800/1790997598/c34766b204685da7a69d9b1f033305274e087ed6/1756720023/hls_264_master.m3u8?t=1760584192","id":257191627,"name":"D