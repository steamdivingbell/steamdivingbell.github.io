bde/ss_89e2efa5ff06502a696c078da757d82fd1513bde.1920x1080.jpg?t=1770988597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/89e2efa5ff06502a696c078da757d82fd1513bde/ss_89e2efa5ff06502a696c078da757d82fd1513bde.600x338.jpg?t=1770988597"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/93ce37b0afd53eedc0078ff4da5978a50d054cbe/ss_93ce37b0afd53eedc0078ff4da5978a50d054cbe.1920x1080.jpg?t=1770988597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/93ce37b0afd53eedc0078ff4da5978a50d054cbe/ss_93ce37b0afd53eedc0078ff4da5978a50d054cbe.600x338.jpg?t=1770988597"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/312e5af4299ec18cffc9accc3f84cf046f6d100e/ss_312e5af4299ec18cffc9accc3f84cf046f6d100e.1920x1080.jpg?t=1770988597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/312e5af4299ec18cffc9accc3f84cf046f6d100e/ss_312e5af4299ec18cffc9accc3f84cf046f6d100e.600x338.jpg?t=1770988597"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/ad0afc126a0c60fc0ab4b4eeea5a72edf10cf858/ss_ad0afc126a0c60fc0ab4b4eeea5a72edf10cf858.1920x1080.jpg?t=1770988597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/ad0afc126a0c60fc0ab4b4eeea5a72edf10cf858/ss_ad0afc126a0c60fc0ab4b4eeea5a72edf10cf858.600x338.jpg?t=1770988597"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/fe672995d551c067c38c0107dffd80c8a79724c5/ss_fe672995d551c067c38c0107dffd80c8a79724c5.1920x1080.jpg?t=1770988597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2571610/fe672995d551c067c38c0107dffd80c8a79724c5/ss_fe672995d551c067c38c0107dffd80c8a79724c5.600x338.jpg?t=1770988597"}],"short_description":"Vitrified is a post-apocalyptic metroidvania where survival depends on teamwork with your robotic friend ALAN. Explore a mysterious mutant wasteland, upgrade ALAN with abilities to unlock new areas, and uncover the secrets of The Worm.","steam_appid":2571610,"support_info":{"email":"jack@burningfort.com","url":""},"supported_languages":"English","type":"game","website":null}