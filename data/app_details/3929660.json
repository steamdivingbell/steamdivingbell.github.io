x338.jpg?t=1766226786"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929660/34f5d9961e149a7780e690bfa66eff97a69f74d2/ss_34f5d9961e149a7780e690bfa66eff97a69f74d2.1920x1080.jpg?t=1766226786","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929660/34f5d9961e149a7780e690bfa66eff97a69f74d2/ss_34f5d9961e149a7780e690bfa66eff97a69f74d2.600x338.jpg?t=1766226786"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929660/4908eb3fbeee499c1ee77cb9dfaebbfaa11db11f/ss_4908eb3fbeee499c1ee77cb9dfaebbfaa11db11f.1920x1080.jpg?t=1766226786","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929660/4908eb3fbeee499c1ee77cb9dfaebbfaa11db11f/ss_4908eb3fbeee499c1ee77cb9dfaebbfaa11db11f.600x338.jpg?t=1766226786"}],"short_description":"Tick tock... Night shift begins. Welcome to the world of Rules Kaidan. As you complete your tasks, remember the rules of each world at all costs. Never violate the taboos - it's your only way to survive.","steam_appid":3929660,"support_info":{"email":"rheruleskaidan@dawnwood.games","url":""},"supported_languages":"English, Simplified Chinese, Traditional Chinese, Japanese, Korean","type":"game","website":null}