siopeia Station.","steam_appid":2664120,"support_info":{"email":"lonelyspacegame@gmail.com","url":"https://www.facebook.com/groups/854882922895261"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Simplified Chinese, Korean, Polish, Russian, Ukrainian, Belarusian<br><strong>*</strong>languages with full audio support","type":"game","website":null}