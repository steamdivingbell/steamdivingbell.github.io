extras/b4e958b091124324e0bd205a566f2b9d.avif?t=1757852991\" width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ><strong>SHANHAI: Myth Origins</strong> features five distinct playable characters. Explore alone, or team up in up to 4-player co-op. Trade gear, coordinate around the Five-Element counters, and achieve perfect synergy between attributes and equipment.</p>","developers":["Honglizi"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3540450/fc6d8b431ee91d3e81092a34b40a01855ca063f0/header.jpg?t=1757852991","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257188005,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257188005/movie480.mp4?t=1756052884","max":"http://video.akamai.steamstatic.com/store_trailers/257188005/movie_max.mp4?t=1756052884"},"name":"Shan Hai : Mythic Origins","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257188005/a4390c6c9c1a9855e497ad17c2175f65db63d45f/movie_600x337.jpg?t=1756052884","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257188005/movie480_vp9.webm?t=1756052884","max":"http://video.akamai.steamstatic.com/store_trailers/257188005/movie_max_vp9.webm?t=1756052884"}},{"highlight":true,"id":257171038,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257171038/movie480.mp4?t=1753337578","max":"http://video.akamai.steamstatic.com/store_trailers/257171038/movie_max.mp4?t=1753337578"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstat