r a good deal.</p></li></ul>","developers":["ScyllaTrident"],"fullgame":{"appid":"3014870","name":"Tales of Fortune"},"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3256770/header.jpg?t=1748814466","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257149455,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257149455/movie480.mp4?t=1748811116","max":"http://video.akamai.steamstatic.com/store_trailers/257149455/movie_max.mp4?t=1748811116"},"name":"Tales of Fortune Demo Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257149455/638b5ebd67c6020eb483b7ff9373f6dac2f4f42d/movie_600x337.jpg?t=1748811116","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257149455/movie480_vp9.webm?t=1748811116","max":"http://video.akamai.steamstatic.com/store_trailers/257149455/movie_max_vp9.webm?t=1748811116"}}],"name":"Tales of Fortune Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel: Core i3-530<br></li><li><strong>Memory:</strong> 2 MB RAM<br></li><li><strong>Graphics:</strong> NVidia: GeForce 9600GT<br></li><li><strong>DirectX:</strong> Version 10<br></li><li><strong>Storage:</strong> 5 GB available space<br></li><li><strong>Sound Card:</strong> DirectX 9.0c-compatible sound card</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["ScyllaTrident"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"10","rating_generated":"1","required_age":"10","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"release_date":{"coming_soon":false,"date":"31 May