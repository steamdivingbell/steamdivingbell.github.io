":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781740/19a6121ad4d4614497bf807a64da268cbb77affa/ss_19a6121ad4d4614497bf807a64da268cbb77affa.1920x1080.jpg?t=1769543486","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781740/19a6121ad4d4614497bf807a64da268cbb77affa/ss_19a6121ad4d4614497bf807a64da268cbb77affa.600x338.jpg?t=1769543486"}],"short_description":"Vanquish endless waves of challenging enemies in this fast-paced action! Combine upgrades to be even more powerful! Buy and equip Gear for your customized builds! Buy Items to improve your stats! Play as 6 different heroes! Each hero has mechanically unique abilities!","steam_appid":3781740,"support_info":{"email":"vanquishevilgame@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://steamcommunity.com/app/3781740#scrollTop=375"}