x1080.jpg?t=1746988565","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3717520/bb97ce7b996d6f0fdb28cf39585aa1df67dc3dae/ss_bb97ce7b996d6f0fdb28cf39585aa1df67dc3dae.600x338.jpg?t=1746988565"}],"short_description":"Dash and slash your way through the first half of Sick Samurai's opening act in this fully featured and intensely challenging demo. Immerse yourself in lofi hip hop and retro anime aesthetics as you master the art of one-hit-one-kill combat.","steam_appid":3717520,"support_info":{"email":"mattbog@solideo.ca","url":"http://www.solideo.ca"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":"http://www.solideo.ca"}