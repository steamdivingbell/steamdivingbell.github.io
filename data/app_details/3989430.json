b28ee9eeb7.webm?t=1766350852\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/f14b9a156b5ff493d11c76b28ee9eeb7.mp4?t=1766350852\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Want to land your ball on top of a skyscraper? Go for it! Then scale the side of it and hit your next shot. Climb apartment blocks and zipline between rooftops. Whether on foot or in a golf cart, every corner of the environment is yours to explore.</p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/fcef0c55b39f9e9f3a2fd9f766c38527.avif?t=1766350852\" width=1560 height=120 /></span></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/b5e473af21c78c8bfa3c86eeab1aaeb7.poster.avif?t=1766350852\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/b5e473af21c78c8bfa3c86eeab1aaeb7.webm?t=1766350852\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/b5e473af21c78c8bfa3c86eeab1aaeb7.mp4?t=1766350852\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Don\u2019t let the surroundings get in your way. Master rich swing mechanics to show off your skills. Curve shots around buildings or adjust your trajectory to escape difficult situations.</p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/e0f1a7e3b101262f396ee861ee0d7c1d.avif?t=1766350852\" width=1560 height=120 /></span></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinl