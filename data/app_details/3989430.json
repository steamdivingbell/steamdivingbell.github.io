steam/apps/3989430/extras/9ea59d0d4ac4735265eca72d9464e24b.avif?t=1766350852\" width=1560 height=120 /></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/a8cfc4f7780d32bb587bc622ac61fd39.poster.avif?t=1766350852\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/a8cfc4f7780d32bb587bc622ac61fd39.webm?t=1766350852\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/extras/a8cfc4f7780d32bb587bc622ac61fd39.mp4?t=1766350852\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" >And the best part? Every shot you take and every target you hit is recorded, building a complete replay of your game. Challenge other players\u2019 replays in your own session. Watch their shots play out in real time, then see if you\u2019ve got what it takes to beat their score.</p>","developers":["MatthewHall3D"],"genres":[{"description":"Sports","id":"18"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3989430/70d17bc4d22070e2fa4899e2803928799d9dbc13/header.jpg?t=1766350852","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3989430/391309233/f3e1528fb12d33dcf1bc7bbfc888c4ff4bae8b6c/1760716095/dash_av1.mpd?t=1761923201","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3989430/391309233/f3e1528fb12d33dcf1bc7bbfc888c4ff4bae8b6c/1760716095/dash_h264.mpd?t=1761923201","highlight":t