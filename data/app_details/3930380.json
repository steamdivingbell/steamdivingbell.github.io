32a00661b9206aff7a3.600x338.jpg?t=1763025307"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3930380/8e45864ce85bb818923f05f88e75cfc607247986/ss_8e45864ce85bb818923f05f88e75cfc607247986.1920x1080.jpg?t=1763025307","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3930380/8e45864ce85bb818923f05f88e75cfc607247986/ss_8e45864ce85bb818923f05f88e75cfc607247986.600x338.jpg?t=1763025307"}],"short_description":"Kitty Haven is a logic puzzle game about finding the purrfect spot for picky but adorable cats. Bring peace back and upgrade your kitty refuge with each new mission ! Solve puzzles and create the perfect fluffy haven.","steam_appid":3930380,"support_info":{"email":"mabouyastudios@gmail.com","url":""},"supported_languages":"English, French, Japanese, Simplified Chinese, Traditional Chinese","type":"game","website":"https://www.mabouya-studio.com/"}