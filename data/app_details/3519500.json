steamstatic.com/store_item_assets/steam/apps/3519500/c662318d8661dcfa4801d2e6b0bfa82dfbc8732d/ss_c662318d8661dcfa4801d2e6b0bfa82dfbc8732d.600x338.jpg?t=1759326153"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3519500/7110c514dd1eb3e7e42728b57aed3b3d3d6dbf68/ss_7110c514dd1eb3e7e42728b57aed3b3d3d6dbf68.1920x1080.jpg?t=1759326153","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3519500/7110c514dd1eb3e7e42728b57aed3b3d3d6dbf68/ss_7110c514dd1eb3e7e42728b57aed3b3d3d6dbf68.600x338.jpg?t=1759326153"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3519500/cbc3c1ac270c083a2beeabfcfe55bb472620b66e/ss_cbc3c1ac270c083a2beeabfcfe55bb472620b66e.1920x1080.jpg?t=1759326153","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3519500/cbc3c1ac270c083a2beeabfcfe55bb472620b66e/ss_cbc3c1ac270c083a2beeabfcfe55bb472620b66e.600x338.jpg?t=1759326153"}],"short_description":"Elusive is a borrower metroidvania platformer where you ride by day, and engage with your community by night. Evolve your tools and reach the mysterious attic of a giant\u2019s house.","steam_appid":3519500,"support_info":{"email":"support@chibig.com","url":"http://chibig.com"},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Portuguese - Brazil, Portuguese - Portugal, Simplified Chinese, Spanish - Latin America, Catalan","type":"game","website":null}