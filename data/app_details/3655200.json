.steamstatic.com/store_item_assets/steam/apps/3655200/ab3d626a8c8814dc0a487565d2f6fd5273812cc8/ss_ab3d626a8c8814dc0a487565d2f6fd5273812cc8.600x338.jpg?t=1746611006"}],"short_description":"This is a shooting game in which you play as a funny chicken who shoots corn at bees to protect the chick while trying to collect all the keys before the countdown ends. It's a casual and simple game where you challenge yourself to see how far you can go.","steam_appid":3655200,"support_info":{"email":"chickdefendergame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}