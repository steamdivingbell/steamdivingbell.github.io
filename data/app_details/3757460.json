pps/3757460/472a2fe145da4b82b0fe1a8ad3c3fcb81c99844f/ss_472a2fe145da4b82b0fe1a8ad3c3fcb81c99844f.1920x1080.jpg?t=1771864541","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757460/472a2fe145da4b82b0fe1a8ad3c3fcb81c99844f/ss_472a2fe145da4b82b0fe1a8ad3c3fcb81c99844f.600x338.jpg?t=1771864541"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757460/59684f10366d8e68c5a9599f217a3e32a95c3b54/ss_59684f10366d8e68c5a9599f217a3e32a95c3b54.1920x1080.jpg?t=1771864541","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757460/59684f10366d8e68c5a9599f217a3e32a95c3b54/ss_59684f10366d8e68c5a9599f217a3e32a95c3b54.600x338.jpg?t=1771864541"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757460/8088db903ec8b890a197466e57bec9a8263996e5/ss_8088db903ec8b890a197466e57bec9a8263996e5.1920x1080.jpg?t=1771864541","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757460/8088db903ec8b890a197466e57bec9a8263996e5/ss_8088db903ec8b890a197466e57bec9a8263996e5.600x338.jpg?t=1771864541"}],"short_description":"When the war between the Enhanced and ordinary humans shatters the future, turning back time becomes humanity's final gamble. As a life scientist navigating two timelines, you must decide: force genetic equality or embrace natural selection? No matter your choice, someone will pay the price.","steam_appid":3757460,"support_info":{"email":"simiandawn@qq.com","url":""},"supported_languages":"Simplified Chinese, English, Traditional Chinese","type":"game","website":"https://www.xiaohongshu.com/user/profile/66a4b9ce000000000b03208e?xsec_token=YBknl2bcdBNuVl3VMHlzxTOv74lOosrk4IVa2qYSSbVdc%3D&amp;xsec_source=app_share&amp;xhsshare=CopyLink&amp;appuid=66a4b9ce000000000b03208e&amp;apptime=1747831940&amp;share_id=02082a58754f4067b1b9070be94ae429&amp;share_channel=copy_link"}