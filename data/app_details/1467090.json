090/ss_3130abfed600a7cc044441dc20b3a5da5794b99c.600x338.jpg?t=1767456912"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1467090/ss_44ab9601ba480a91ca86efc435fcbd55e00b09b8.1920x1080.jpg?t=1767456912","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1467090/ss_44ab9601ba480a91ca86efc435fcbd55e00b09b8.600x338.jpg?t=1767456912"}],"short_description":"Jensen, the sole survivor of the Nexentia shuttle crash on the planet CECLON. Alone, light years away from all human life! You will have to face the Nocturnes, primitive creatures in order to bring back the Veka energy, humanity's only hope.","steam_appid":1467090,"support_info":{"email":"solidsstudio.solo@gmail.com","url":"https://solidsstudiosolo.wixsite.com/thedarksideofceclon"},"supported_languages":"English<strong>*</strong>, French<br><strong>*</strong>languages with full audio support","type":"game","website":"https://solidsstudiosolo.wixsite.com/thedarksideofceclon"}