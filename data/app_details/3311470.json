lass=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3311470/extras/32a0295e6478a6a37b89c68cbac6f5ad.poster.avif?t=1769685783\" width=720 height=264 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3311470/extras/32a0295e6478a6a37b89c68cbac6f5ad.webm?t=1769685783\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3311470/extras/32a0295e6478a6a37b89c68cbac6f5ad.mp4?t=1769685783\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Game Features:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Fast-paced  boss encounters, with each having different gimmicks and mechanics.</p></li><li><p class=\"bb_paragraph\" >Chases,\u00a0in which you have to rush at breakneck speed. One slip, you're dead.</p></li><li><p class=\"bb_paragraph\" >Funky music, synced to ingame events.</p></li><li><p class=\"bb_paragraph\" >Actual creepy moments. Keeping you mostly on your edge.</p></li><li><p class=\"bb_paragraph\" >A rapidly developing plot. Make allies, enemies and try to find your way out.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" > <br><i><strong>&quot;Let us... strike a deal. How does that sound?&quot;</strong></i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Bartosz \"BartBartGames\""],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3311470/f761d755eb493d8b7785d463100c98b6a142a0cd/header.jpg?t=1769685783","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"min