nail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008070/37d01d7a357b5d8e477acb8e8aa17846c4797662/ss_37d01d7a357b5d8e477acb8e8aa17846c4797662.600x338.jpg?t=1770015326"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008070/47768d3ca2ea9799f9275f158d608c2429d52895/ss_47768d3ca2ea9799f9275f158d608c2429d52895.1920x1080.jpg?t=1770015326","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4008070/47768d3ca2ea9799f9275f158d608c2429d52895/ss_47768d3ca2ea9799f9275f158d608c2429d52895.600x338.jpg?t=1770015326"}],"short_description":"Drive your wacky caravan truck through a procedurally generated Tour de France road. Dodge obstacles, outrun the peloton, and spread joy by blasting goodies to the cheering crowd!","steam_appid":4008070,"support_info":{"email":"tom.bloodyhand@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}