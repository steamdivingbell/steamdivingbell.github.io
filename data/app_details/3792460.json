d.akamai.steamstatic.com/store_item_assets/steam/apps/3792460/f93d04c8148a0d0cd34c96d2e711dfd63dc33fa2/ss_f93d04c8148a0d0cd34c96d2e711dfd63dc33fa2.600x338.jpg?t=1764145394"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3792460/9477c86ba6dc749c6409807c79347bc92dde1e80/ss_9477c86ba6dc749c6409807c79347bc92dde1e80.1920x1080.jpg?t=1764145394","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3792460/9477c86ba6dc749c6409807c79347bc92dde1e80/ss_9477c86ba6dc749c6409807c79347bc92dde1e80.600x338.jpg?t=1764145394"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3792460/b2ac946533b210277186f5da336a0c421a168693/ss_b2ac946533b210277186f5da336a0c421a168693.1920x1080.jpg?t=1764145394","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3792460/b2ac946533b210277186f5da336a0c421a168693/ss_b2ac946533b210277186f5da336a0c421a168693.600x338.jpg?t=1764145394"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3792460/9e386a4a4334095941b9ae73822988544a9f738d/ss_9e386a4a4334095941b9ae73822988544a9f738d.1920x1080.jpg?t=1764145394","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3792460/9e386a4a4334095941b9ae73822988544a9f738d/ss_9e386a4a4334095941b9ae73822988544a9f738d.600x338.jpg?t=1764145394"}],"short_description":"Spin of Dosul is a new roguelike deck-building game that combines slot machine mechanics with inventory management. Test your luck alongside an adorable Dokkaebi! Collect symbols and sacred relics to build your own scroll and defeat monsters on your journey back to the real world.","steam_appid":3792460,"support_info":{"email":"truegame0624@gmail.com","url":""},"supported_languages":"English, Simplified Chinese, Korean, French, Italian, German, Spanish - Spain, Russian, Japanese, Traditional Chinese","type":"game","website":null}