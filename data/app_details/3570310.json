10/fb02b0d86b163f8acafb420ee1c075c55815f269/ss_fb02b0d86b163f8acafb420ee1c075c55815f269.600x338.jpg?t=1741629289"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570310/b62a306b8fa2fb1df7eacddd88f0e11f23a730af/ss_b62a306b8fa2fb1df7eacddd88f0e11f23a730af.1920x1080.jpg?t=1741629289","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570310/b62a306b8fa2fb1df7eacddd88f0e11f23a730af/ss_b62a306b8fa2fb1df7eacddd88f0e11f23a730af.600x338.jpg?t=1741629289"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570310/25e5267d2bde53f8b56ffe788cca09b94753ea95/ss_25e5267d2bde53f8b56ffe788cca09b94753ea95.1920x1080.jpg?t=1741629289","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570310/25e5267d2bde53f8b56ffe788cca09b94753ea95/ss_25e5267d2bde53f8b56ffe788cca09b94753ea95.600x338.jpg?t=1741629289"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570310/fa0a0c2a7b34caaf5d59ca42f1013f3a0aaea87e/ss_fa0a0c2a7b34caaf5d59ca42f1013f3a0aaea87e.1920x1080.jpg?t=1741629289","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3570310/fa0a0c2a7b34caaf5d59ca42f1013f3a0aaea87e/ss_fa0a0c2a7b34caaf5d59ca42f1013f3a0aaea87e.600x338.jpg?t=1741629289"}],"short_description":"Fly and fall for powerful Lassplanes! Discover a hand-crafted anime VN with story-driven arcade shoot-'em-up gameplay. Take part in a romantic story with drama and comedic elements set in a steampunk Kingdom filled with magic and torn by a brutal war. Decide the fate of your country and heart.","steam_appid":3570310,"support_info":{"email":"info@inkydreams.com","url":"https://inkydreams.com/"},"supported_languages":"English<strong>*</strong>, Japanese<strong>*</strong>, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"dlc","website":"https://kamikazelassplanes.com"}