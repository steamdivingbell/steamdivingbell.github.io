_assets/steam/apps/3837370/ca838c190ec8b383af011ab11f2ae1fa5ad8c3ac/ss_ca838c190ec8b383af011ab11f2ae1fa5ad8c3ac.600x338.jpg?t=1759205153"}],"short_description":"A fusion of puzzle, deck-building, and auto-battle. Connect all the tabs to summon units and spells sealed within the pieces!","steam_appid":3837370,"support_info":{"email":"puzzlesummon@gmail.com","url":"https://flowgdd.com"},"supported_languages":"English, Japanese, French, German, Spanish - Spain, Spanish - Latin America, Portuguese - Brazil, Portuguese - Portugal, Simplified Chinese, Traditional Chinese, Korean","type":"game","website":"https://flowgdd.com/summon/"}