static.com/store_item_assets/steam/apps/3393740/751ed238418b0bcd6ea4dacfdbbb5e2fc126a795/ss_751ed238418b0bcd6ea4dacfdbbb5e2fc126a795.1920x1080.jpg?t=1753458956","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393740/751ed238418b0bcd6ea4dacfdbbb5e2fc126a795/ss_751ed238418b0bcd6ea4dacfdbbb5e2fc126a795.600x338.jpg?t=1753458956"}],"short_description":"The Firefly Village awaits! A bite-sized, streamlined farming sim that focuses on moments that matter, without wasting a single second of your time. Build a homestead, raise crops, tend to livestock, make friends, and enjoy a pocket of paradise where farming is a delight and friends plentiful.","steam_appid":3393740,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English, Simplified Chinese","type":"game","website":null}