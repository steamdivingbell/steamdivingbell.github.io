eamstatic.com/store_item_assets/steam/apps/3749110/c1c752cc3e84036e96cfbd34180d5110d4ec7cb4/ss_c1c752cc3e84036e96cfbd34180d5110d4ec7cb4.600x338.jpg?t=1773036780"}],"short_description":"A bite-sized (literally) comedic adventure where you relieve the stress of ordinary life by biting through walls. Therapy is expensive, but drywall is plentiful.","steam_appid":3749110,"support_info":{"email":"contact@peripheralplaybox.com","url":"https://www.peripheralplaybox.com/"},"supported_languages":"English","type":"game","website":"https://www.peripheralplaybox.com/"}