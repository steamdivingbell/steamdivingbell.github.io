 Isle\u2019s history, throw stuff, discover secrets. The island is your oyster. You can even call your mum!</p><p class=\"bb_paragraph\">There\u2019s plenty to do as a mail delivery turnip on Arralla Isle!</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2189310/extras/Island-illo-golden-610.png?t=1748570704\" /></p>","developers":["Little Pink Clouds"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2189310/header.jpg?t=1748570704","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257060179,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257060179/movie480.mp4?t=1727666439","max":"http://video.akamai.steamstatic.com/store_trailers/257060179/movie_max.mp4?t=1727666439"},"name":"Letters To Arralla 2024 Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257060179/4ad0e34e41862566a732b101989be1752c76e4f3/movie_600x337.jpg?t=1727666439","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257060179/movie480_vp9.webm?t=1727666439","max":"http://video.akamai.steamstatic.com/store_trailers/257060179/movie_max_vp9.webm?t=1727666439"}}],"name":"Letters To Arralla","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 (SP1+)</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Little Pink Clouds"],"ratings":{"dejus":{"rating":"l"},"steam_germany":{"banned":"0","descriptors":"Alkohol / Tabak","rating":"6","rating_generated":"1","required_age":"6","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.ste