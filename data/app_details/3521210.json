tore_item_assets/steam/apps/3521210/a8254abe41e3feef2d140152b19858affd323a9e/ss_a8254abe41e3feef2d140152b19858affd323a9e.600x338.jpg?t=1740711561"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3521210/807918612e39c762789887b8d7e769ce26b0b8fd/ss_807918612e39c762789887b8d7e769ce26b0b8fd.1920x1080.jpg?t=1740711561","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3521210/807918612e39c762789887b8d7e769ce26b0b8fd/ss_807918612e39c762789887b8d7e769ce26b0b8fd.600x338.jpg?t=1740711561"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3521210/50a214ddcea6ec029b7a9df3cbd6134cea853e04/ss_50a214ddcea6ec029b7a9df3cbd6134cea853e04.1920x1080.jpg?t=1740711561","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3521210/50a214ddcea6ec029b7a9df3cbd6134cea853e04/ss_50a214ddcea6ec029b7a9df3cbd6134cea853e04.600x338.jpg?t=1740711561"}],"short_description":"A cozy horror game where you own and manage a boba tea shop. Prepare boba teas, serve customers, and expand your menu to grow your business.","steam_appid":3521210,"support_info":{"email":"mikeleeten@gmail.com","url":""},"supported_languages":"English, German, Japanese, Korean, Russian, Simplified Chinese, French","type":"demo","website":null}