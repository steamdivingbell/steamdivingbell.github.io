dbe100a6ac2f169a836ed08.webm?t=1758969957\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996640/extras/1f7041380dbe100a6ac2f169a836ed08.mp4?t=1758969957\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><i><strong>Game Features</strong></i></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >A spine-chilling claustrophobic atmosphere intertwined with unexpected humorous and cute moments.</p></li><li><p class=\"bb_paragraph\" >The main storyline is conveyed through visual imagery and emotions, remaining <span class=\"bb_strike\">almost</span> understandable without words.</p></li><li><p class=\"bb_paragraph\" >The rich sound design, coupled with the mesmerizing melodies written by Stewart Keller (composer of Juice Galaxy), will give you a vivid audio experience.</p></li><li><p class=\"bb_paragraph\" >Challenging puzzles, many of which have randomized solutions. </p></li><li><p class=\"bb_paragraph\" >Simple and intuitive controls.</p></li><li><p class=\"bb_paragraph\" >Creepy, grotesque monsters.</p></li><li><p class=\"bb_paragraph\" >Multiple endings.</p></li><li><p class=\"bb_paragraph\" >Discover hidden rooms containing beautiful collars for Inky. <br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996640/extras/7832c2cb66627391aa541592f4e4a5b2.poster.avif?t=1758969957\" width=608 height=174 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996640/extras/7832c2cb66627391aa541592f4e4a5b2.webm?t=1758969957\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996640/extras/7832c2cb66627391aa541592f4e4a5b2.mp4?t=1758969957\" type=\"video/mp4\"></video></span></p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["Tim Larick"],"genres":[{"description":"Action","id":"1"},{"