f1609b7f900610cbd40b46287fb63fdf299001/ss_79f1609b7f900610cbd40b46287fb63fdf299001.600x338.jpg?t=1765903080"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892250/bb920e38bd457063d56f305106b32928e5e5b3cb/ss_bb920e38bd457063d56f305106b32928e5e5b3cb.1920x1080.jpg?t=1765903080","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3892250/bb920e38bd457063d56f305106b32928e5e5b3cb/ss_bb920e38bd457063d56f305106b32928e5e5b3cb.600x338.jpg?t=1765903080"}],"short_description":"Run, Climb, Fall and Retry - A first person precision platformer about running and jumping through a huge minimalistic tower made from the tears of our playtesters. Nothing is unfair, keep trying and you will succeed.","steam_appid":3892250,"support_info":{"email":"contact@teagher.studio","url":""},"supported_languages":"English<strong>*</strong>, French<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}