46360/fcd006e19ef2c4cf2316b3de405aedc1aa0b9a7a/ss_fcd006e19ef2c4cf2316b3de405aedc1aa0b9a7a.600x338.jpg?t=1767018349"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3746360/8f80c795f50f0cccdd6ec1f3419008c2c42bdc3f/ss_8f80c795f50f0cccdd6ec1f3419008c2c42bdc3f.1920x1080.jpg?t=1767018349","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3746360/8f80c795f50f0cccdd6ec1f3419008c2c42bdc3f/ss_8f80c795f50f0cccdd6ec1f3419008c2c42bdc3f.600x338.jpg?t=1767018349"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3746360/b3692ef535f9dfa3a3ec884c0780f099539acf79/ss_b3692ef535f9dfa3a3ec884c0780f099539acf79.1920x1080.jpg?t=1767018349","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3746360/b3692ef535f9dfa3a3ec884c0780f099539acf79/ss_b3692ef535f9dfa3a3ec884c0780f099539acf79.600x338.jpg?t=1767018349"}],"short_description":"Blade and Madness, a roguelite deckbuilder where turns play out simultaneously and every choice matters. As madness creeps in, your cards change, the battlefield twists, and enemies grow more unpredictable. Adaptation isn\u2019t optional, it\u2019s the only way to survive\u2026 or give in to the dark.","steam_appid":3746360,"support_info":{"email":"crimsonbirdsstudio@gmail.com","url":""},"supported_languages":"English, Spanish - Spain","type":"game","website":null}