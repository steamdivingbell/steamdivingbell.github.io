/ss_51227b4164316e7e57d39aff273cfca54336e1df.600x338.jpg?t=1749563367"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3612210/a45843cc7b47e7c08b80f27d374c25e41d07d6e2/ss_a45843cc7b47e7c08b80f27d374c25e41d07d6e2.1920x1080.jpg?t=1749563367","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3612210/a45843cc7b47e7c08b80f27d374c25e41d07d6e2/ss_a45843cc7b47e7c08b80f27d374c25e41d07d6e2.600x338.jpg?t=1749563367"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3612210/4b9529bd0d50de81f69d31dc55422410447970d6/ss_4b9529bd0d50de81f69d31dc55422410447970d6.1920x1080.jpg?t=1749563367","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3612210/4b9529bd0d50de81f69d31dc55422410447970d6/ss_4b9529bd0d50de81f69d31dc55422410447970d6.600x338.jpg?t=1749563367"}],"short_description":"Outspeed. Outplay. Survive. A fast-paced turn-based roguelike where quick reflexes and precise input decide your fate. Dodge deadly patterns and strike in the blink of an eye.","steam_appid":3612210,"support_info":{"email":"contact@seedgamestudio.com","url":"https://www.facebook.com/profile.php?id=61574830858095"},"supported_languages":"English","type":"game","website":null}