akamai.steamstatic.com/store_item_assets/steam/apps/3730660/594b234253d974c472ebb099e4645d91eb2e2f08/ss_594b234253d974c472ebb099e4645d91eb2e2f08.1920x1080.jpg?t=1751553962","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3730660/594b234253d974c472ebb099e4645d91eb2e2f08/ss_594b234253d974c472ebb099e4645d91eb2e2f08.600x338.jpg?t=1751553962"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3730660/cb3b42947aa1098edde841f14860f5e263f3cfb7/ss_cb3b42947aa1098edde841f14860f5e263f3cfb7.1920x1080.jpg?t=1751553962","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3730660/cb3b42947aa1098edde841f14860f5e263f3cfb7/ss_cb3b42947aa1098edde841f14860f5e263f3cfb7.600x338.jpg?t=1751553962"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3730660/8faaefde9966cecc081a7e8bca46581e8f3d0980/ss_8faaefde9966cecc081a7e8bca46581e8f3d0980.1920x1080.jpg?t=1751553962","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3730660/8faaefde9966cecc081a7e8bca46581e8f3d0980/ss_8faaefde9966cecc081a7e8bca46581e8f3d0980.600x338.jpg?t=1751553962"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3730660/f3cad92ec7b5b606ec31facab5cfcd2b9b29c0dc/ss_f3cad92ec7b5b606ec31facab5cfcd2b9b29c0dc.1920x1080.jpg?t=1751553962","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3730660/f3cad92ec7b5b606ec31facab5cfcd2b9b29c0dc/ss_f3cad92ec7b5b606ec31facab5cfcd2b9b29c0dc.600x338.jpg?t=1751553962"}],"short_description":"Lethal Invasion is a 3D third-person survival and melee combat game. Fight off increasingly stronger hordes of enemies. Upgrade your weapons, buy single-use skills, and unlock new map areas as you try to survive alone or in online co-op.","steam_appid":3730660,"support_info":{"email":"qokustsuport@gmail.com","url":""},"supported_languages":"English, Spanish - Spain","type":"game","website":null}