 DLC!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4039700/extras/13ff10285fa6df2ed932c3be3397e596.webp?t=1759140075\" width=633 height=43 /></span></p>","developers":["Pochemu LTD"],"fullgame":{"appid":"3218710","name":"Everlusting Life"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Massively Multiplayer","id":"29"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4039700/c3b5483688a42792cf6190c9cc01afcae56571ff/header.jpg?t=1759140075","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4039700/1775258403/591d898014e4e1f0a633c7d7879999b6d1fe54cd/1758897119/dash_av1.mpd?t=1759138380","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4039700/1775258403/591d898014e4e1f0a633c7d7879999b6d1fe54cd/1758897119/dash_h264.mpd?t=1759138380","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4039700/1775258403/591d898014e4e1f0a633c7d7879999b6d1fe54cd/1758897119/hls_264_master.m3u8?t=1759138380","id":257206934,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257206934/movie480.mp4?t=1759138380","max":"https://video.akamai.steamstatic.com/store_trailers/257206934/movie_max.mp4?t=1759138380"},"name":"Colombina","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257206934/99a33b2f6f62acfab34433eb2a789f3943965d99/movie_600x337.jpg?t=1759138380","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257206934/movie480_vp9.webm?t=1759138380","max":"https://video.akamai.steamstatic.com/store_trailers/257206934/movie_max_vp9.webm?t=1759138380"}},{"dash_av1":"https://video.akamai.steamstatic.com/store_tra