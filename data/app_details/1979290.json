ai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/2ecbc784afdad570cc82826377b83217.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/c0f52bd8be59e9b5825050a5a11c01a0.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/c0f52bd8be59e9b5825050a5a11c01a0.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/d0b7ca3ca345644c190441e02f9547e5.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/d0b7ca3ca345644c190441e02f9547e5.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/26cbe82043fed5d934f8ba8bb8794c31.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/26cbe82043fed5d934f8ba8bb8794c31.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/f33d23bbcbbad8b2c76e99c63ed8c26a.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/f33d23bbcbbad8b2c76e99c63ed8c26a.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/39a7f106e39583e876d231edd38afe87.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/39a7f106e39583e876d231edd38afe87.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/75a9b27ff790834af9cd3d283fb73a0b.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/75a9b27ff790834af9cd3d283fb73a0b.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/76ccabc9513eb1d80684c8840b225a86.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/76ccabc9513eb1d80684c8840b225a86.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/485200aaf8471ce74519155bb2e0d44a.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/485200aaf8471ce74519155bb2e0d44a.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/3e88bc3b2099e343a0a6acbad3c621de.avif?t=1762944493\" width=520 height=173 /></span></p><p class=\"bb_paragraph\" >*Encountering vivid characters\u2014\u2014</p><p class=\"bb_paragraph\" >What kind of bonds will arise from meeting them? What kind of stories can we write together with them? What changes will your arrival bring to them? This will depend on your actions and choices!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Taste seeking Magic Continent\u2014\u2014</p><p class=\"bb_paragraph\" >Padua and the royal city of Anglin face each other from afar across the Sea of Mirrors. People from all over the world come here every day, how can we satisfy the tastes of different customers? What strange dishes can be cooked using a variety of strange ingredients for harvesting?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Choose a leisurely lifestyle\u2014\u2014</p><p class=\"bb_paragraph\" >How to spend time outside of opening a store? Whether it's feeling the joy of harvesting fruits or experiencing the joy of catching a big fish; Whether it's brewing delicious wine or embarking on adventures and adventures Choose the way you like and enjoy life freely!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Enhance partner goodwill\u2014\u2014</p><p class=\"bb_paragraph\" >The stable operation of the Witch's Tavern relies on the support and assistance of friends. Through interaction and communication, sincere emotions are born. However, can our relationship be closer? Friendship? love? Make a choice!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Take a walk outside when you have free time\u2014\u2014</p><p class=\"bb_paragraph\" >Staying in the store all day is too boring! Going out may encounter strange events and unexpected gains: travelers carrying pig tails, graves washed away by floods, basements as bright as daylight... Maybe you will also see a little-known side of your friends!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Decorate personalized taverns\u2014\u2014</p><p class=\"bb_paragraph\" >I am in charge of my tavern! Is it warm or mischievous? Is it simple or gorgeous? Transform it as you please!</p>","developers":["Second Dream"],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/a14951b50c42c4544d83365c7beac0ff5b29e579/header.jpg?t=1762944493","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OS X<br></li><li><strong>Processor:</strong> Apple\u82af\u7247\u548cIntel\u82af\u7247<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OS X<br></li><li><strong>Processor:</strong> Apple\u82af\u7247\u548cIntel\u82af\u7247<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1979290/1421867354/83a0f6cbaf62ea23878d99207391579f133a0530/1757497075/dash_av1.mpd?t=1757586473","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1979290/1421867354/83a0f6cbaf62ea23878d99207391579f133a0530/1757497075/dash_h264.mpd?t=1757586473","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1979290/1421867354/83a0f6cbaf62ea23878d99207391579f133a0530/1757497075/hls_264_master.m3u8?t=1757586473","id":256915199,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/256915199/movie480.mp4?t=1757586473","max":"https://video.akamai.steamstatic.com/store_trailers/256915199/movie_max.mp4?t=1757586473"},"name":"\u82f1\u6587\u5ba3\u4f209.10","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256915199/abe456c19e578f067c6b41a78f53008cbd06b8d4/movie_600x337.jpg?t=1757586473","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/256915199/movie480_vp9.webm?t=1757586473","max":"https://video.akamai.steamstatic.com/store_tra