01a0.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/c0f52bd8be59e9b5825050a5a11c01a0.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/d0b7ca3ca345644c190441e02f9547e5.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/d0b7ca3ca345644c190441e02f9547e5.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/26cbe82043fed5d934f8ba8bb8794c31.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/26cbe82043fed5d934f8ba8bb8794c31.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/f33d23bbcbbad8b2c76e99c63ed8c26a.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/f33d23bbcbbad8b2c76e99c63ed8c26a.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/39a7f106e39583e876d231edd38afe87.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/39a7f106e39583e876d231edd38afe87.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/75a9b27ff790834af9cd3d283fb73a0b.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/75a9b27ff790834af9cd3d283fb73a0b.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/76ccabc9513eb1d80684c8840b225a86.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/76ccabc9513eb1d80684c8840b225a86.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/485200aaf8471ce74519155bb2e0d44a.avif?t=1762944493\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras_big/485200aaf8471ce74519155bb2e0d44a.webp?t=1762944493 width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/3e88bc3b2099e343a0a6acbad3c621de.avif?t=1762944493\" width=520 height=173 /></span></p><p class=\"bb_paragraph\" >*Encountering vivid characters\u2014\u2014</p><p class=\"bb_paragraph\" >What kind of bonds will arise from meeting them? What kind of stories can we write together with them? What changes will your arrival bring to them? This will depend on your actions and choices!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Taste seeking Magic Continent\u2014\u2014</p><p class=\"bb_paragraph\" >Padua and the royal city of Anglin face each other from afar across the Sea of Mirrors. People from all over the world come here every day, how can we satisfy the tastes of different customers? What strange dishes can be cooked using a variety of strange ingredients for harvesting?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Choose a leisurely lifestyle\u2014\u2014</p><p class=\"bb_paragraph\" >How to spend time outside of opening a store? Whether it's feeling the joy of harvesting fruits or experiencing the joy of catching a big fish; Whether it's brewing delicious wine or embarking on adventures and adventures Choose the way you like and enjoy life freely!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Enhance partner goodwill\u2014\u2014</p><p class=\"bb_paragraph\" >The stable operation of the Witch's Tavern relies on the support and assistance of friends. Through interaction and communication, sincere emotions are born. However, can our relationship be closer? Friendship? love? Make a choice!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Take a walk outside when you have free time\u2014\u2014</p><p class=\"bb_paragraph\" >Staying in the store all day is too boring! Going out may encounter strange events and unexpected gains: travelers carrying pig tails, graves washed away by floods, basements as bright as daylight... Maybe you will also see a little-known side of your friends!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*Decorate personalized taverns\u2014\u2014</p><p class=\"bb_paragraph\" >I am in charge of my tavern! Is it warm or mischievous? Is it simple or gorgeous? Transform it as you please!</p>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/1979290?t=1762944493","background_raw":"https://store.akamai.steamstatic.com/images/storepagebackground/app/1979290?t=1762944493","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/7f1918fdf7d6504ef28f05858f2f1529000a1129/capsule_231x87.jpg?t=1762944493","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/7f1918fdf7d6504ef28f05858f2f1529000a1129/capsule_184x69.jpg?t=1762944493","categories":[{"description":"Single-player","id":2},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"detailed_description":"<p class=\"bb_paragraph\" >The mysterious witch rescued you from a coma in the Demon Forest, only to teach you how to run a tavern.</p><p class=\"bb_paragraph\" >In order to teleport you and the tavern to a strange town, she was willing to let herself vanish into thin air.</p><p class=\"bb_paragraph\" >With the Tranquilizing Honey Wine, which can free witches from their nightmares, your tavern quickly becomes bustling with business. So you start recruiting staff, decorating the tavern, purchasing ingredients, developing dishes, making friends... and exploring this fun-filled world!</p><p class=\"bb_paragraph\" >But please don't forget to find the answer: who is the witch who saved you? What exactly happened before you fell into a coma?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/b89eceab23de39fdef37e782530f46d2.avif?t=1762944493\" width=520 height=173 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/ab5dcfeb4644dcc0a22790a3f6407e73.poster.avif?t=1762944493\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/ab5dcfeb4644dcc0a22790a3f6407e73.webm?t=1762944493\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/ab5dcfeb4644dcc0a22790a3f6407e73.mp4?t=1762944493\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >That's right, how can an interesting world be without fishing?</p><p class=\"bb_paragraph\" >What kind of fish live in the waters of Padua town? Will the dishes made be delicious or will they scare away customers?</p><p class=\"bb_paragraph\" >Choose a desired location, put on special bait, wave your fishing rod, and elegantly, calmly, and fully concentrate on catching that big fish\uff08\uff1f\uff1f\uff1f\uff09!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/62ad6802f9aa776b38934fdd194db149.avif?t=1762944493\" width=520 height=173 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/588a397874224925ff42d68292ace12e.poster.avif?t=1762944493\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/588a397874224925ff42d68292ace12e.webm?t=1762944493\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1979290/extras/588a397874224925ff42d68292ace12e.mp4?t=1762944493\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >In addition to running a tavern, you stroll around the small town of Padua and accidentally enter the 'Tide Jewelry Store' during low tide. Various rare magical accessories are displayed in the store, and violets emit a faint light... In addition, you also noticed that the owner is a black cat?</p><p class=\"bb_paragraph\" >&quot;Do humans like these shiny treasures collected by me Meow\uff1f&quot;</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" 