ps/3388080/0f9f3c0be42217be66916db7c3d988fd7afd455f/ss_0f9f3c0be42217be66916db7c3d988fd7afd455f.600x338.jpg?t=1770841666"}],"short_description":"What lurks in the dark? Only the echoes know. Use your trusty whip to navigate the unforgiving depths, swing across the abyss and fight the living horrors that lie within.","steam_appid":3388080,"support_info":{"email":"eyesightgame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}