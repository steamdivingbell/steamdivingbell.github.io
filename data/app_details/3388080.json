ps/3388080/6208646ec8225bced79703d8be103928e58a18df/ss_6208646ec8225bced79703d8be103928e58a18df.600x338.jpg?t=1767209871"}],"short_description":"What lurks in the dark? Only the echoes know. Use your trusty whip to navigate the unforgiving depths, swing across the abyss and fight the living horrors that lie within.","steam_appid":3388080,"support_info":{"email":"eyesightgame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}