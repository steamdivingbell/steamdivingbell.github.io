tatic.com/store_item_assets/steam/apps/1910150/695fee2805809b626b2d337dc7b6221a1d06b438/ss_695fee2805809b626b2d337dc7b6221a1d06b438.600x338.jpg?t=1758204542"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1910150/cb310a2a6c0f850123dba7a3b5ab833c54d438b8/ss_cb310a2a6c0f850123dba7a3b5ab833c54d438b8.1920x1080.jpg?t=1758204542","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1910150/cb310a2a6c0f850123dba7a3b5ab833c54d438b8/ss_cb310a2a6c0f850123dba7a3b5ab833c54d438b8.600x338.jpg?t=1758204542"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1910150/84930ba8018b7015e4a9001a8a933ad082fb9564/ss_84930ba8018b7015e4a9001a8a933ad082fb9564.1920x1080.jpg?t=1758204542","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1910150/84930ba8018b7015e4a9001a8a933ad082fb9564/ss_84930ba8018b7015e4a9001a8a933ad082fb9564.600x338.jpg?t=1758204542"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1910150/317613410d2dc41a234ba2de4ff30b3604f58189/ss_317613410d2dc41a234ba2de4ff30b3604f58189.1920x1080.jpg?t=1758204542","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1910150/317613410d2dc41a234ba2de4ff30b3604f58189/ss_317613410d2dc41a234ba2de4ff30b3604f58189.600x338.jpg?t=1758204542"}],"short_description":"Walk of Life is a fast-paced, satirical life simulator where you scramble to get a job, earn a degree, pay rent, and beat your friends before everything falls apart.","steam_appid":1910150,"support_info":{"email":"relax@porcelainfortress.com","url":""},"supported_languages":"English, French, German, Japanese, Portuguese - Brazil, Russian, Simplified Chinese, Thai","type":"game","website":null}