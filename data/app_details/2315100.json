338.jpg?t=1760614870"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2315100/30fb28069aa4a73323cb53842ea9ac1400483f65/ss_30fb28069aa4a73323cb53842ea9ac1400483f65.1920x1080.jpg?t=1760614870","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2315100/30fb28069aa4a73323cb53842ea9ac1400483f65/ss_30fb28069aa4a73323cb53842ea9ac1400483f65.600x338.jpg?t=1760614870"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2315100/cf889d90f95575fdad464bfbdd7b8336958ae799/ss_cf889d90f95575fdad464bfbdd7b8336958ae799.1920x1080.jpg?t=1760614870","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2315100/cf889d90f95575fdad464bfbdd7b8336958ae799/ss_cf889d90f95575fdad464bfbdd7b8336958ae799.600x338.jpg?t=1760614870"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2315100/af1cc6aabe290e8b6070dd3c8f7bac834d87b129/ss_af1cc6aabe290e8b6070dd3c8f7bac834d87b129.1920x1080.jpg?t=1760614870","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2315100/af1cc6aabe290e8b6070dd3c8f7bac834d87b129/ss_af1cc6aabe290e8b6070dd3c8f7bac834d87b129.600x338.jpg?t=1760614870"}],"short_description":"A Steampunk Co-Op Horror for 1-4 players. Descend from your fully customizable airship into the streets of Post-Apocalyptic Victorian London to scavenge resources, craft gear and take on terrifying mutants inspired by British myths.","steam_appid":2315100,"support_info":{"email":"contact@jfigames.co.uk","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://linktr.ee/thegreatsmog"}