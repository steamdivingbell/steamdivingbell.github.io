/2951380/ss_c9a00504ff8b034097651363164f9f2cea82bc23.1920x1080.jpg?t=1756742991","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2951380/ss_c9a00504ff8b034097651363164f9f2cea82bc23.600x338.jpg?t=1756742991"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2951380/ss_3d7b35f4fe7361c82372c6878e0c2b68a9360837.1920x1080.jpg?t=1756742991","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2951380/ss_3d7b35f4fe7361c82372c6878e0c2b68a9360837.600x338.jpg?t=1756742991"}],"short_description":"Sentinel Agency is a co-op survival RPG with dinosaurs! As a Special Investigator of the Sentinel Agency, you go on a murderous adventure on a dinosaur theme park island! Solve important puzzles, save others, shoot, sneak, uncover secrets and survive!","steam_appid":2951380,"support_info":{"email":"support@phanto.media","url":"https://www.phanto.media"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.phanto.media"}