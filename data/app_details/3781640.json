":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781640/c773ff18542521fa6a92757e9af55113d27a7657/ss_c773ff18542521fa6a92757e9af55113d27a7657.600x338.jpg?t=1750084414"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781640/21622c674259b300f2f64f13d3ce06bec5ad6984/ss_21622c674259b300f2f64f13d3ce06bec5ad6984.1920x1080.jpg?t=1750084414","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781640/21622c674259b300f2f64f13d3ce06bec5ad6984/ss_21622c674259b300f2f64f13d3ce06bec5ad6984.600x338.jpg?t=1750084414"}],"short_description":"Persevere is a turn-based survival RPG set on a grim and mysterious island. Control your team, explore an open world and fight Affects in an innovative combat system. Will your characters survive or descend into madness?","steam_appid":3781640,"support_info":{"email":"evermyth@protonmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":null}