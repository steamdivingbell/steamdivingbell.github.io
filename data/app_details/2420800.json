/store_item_assets/steam/apps/2420800/072891000469def90251ae9c28c98ca0b60dc1c2/ss_072891000469def90251ae9c28c98ca0b60dc1c2.600x338.jpg?t=1770678574"}],"short_description":"Blast and laugh your way through space with up to 4 friends in this chaotic roguelike co-op. Every run is a new adventure so steer, shield, and work together to take on unpredictable challenges - or at least go out in style.","steam_appid":2420800,"support_info":{"email":"contact@darumagames.com","url":""},"supported_languages":"English","type":"game","website":"https://darumagames.com/"}