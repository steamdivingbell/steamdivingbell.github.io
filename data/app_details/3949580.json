nt lunar research.<br><br><br><br></p></li></ul>","developers":["Cognition"],"genres":[{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3949580/2a839a7b9aca2f120e611e783994e3ed00230e7d/header.jpg?t=1755719998","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3949580/166072513/e431d8da06d0c209e6c19b177836b27811372486/1755193864/dash_av1.mpd?t=1755719923","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3949580/166072513/e431d8da06d0c209e6c19b177836b27811372486/1755193864/dash_h264.mpd?t=1755719923","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3949580/166072513/e431d8da06d0c209e6c19b177836b27811372486/1755193864/hls_264_master.m3u8?t=1755719923","id":257183247,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257183247/movie480.mp4?t=1755719923","max":"https://video.akamai.steamstatic.com/store_trailers/257183247/movie_max.mp4?t=1755719923"},"name":"Lunar strike teaser \"the Moon\"","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257183247/c9131fcea230c1471d871140320f0b5d3a4a9c85/movie_600x337.jpg?t=1755719923","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257183247/movie480_vp9.webm?t=1755719923","max":"https://video.akamai.steamstatic.com/store_trailers/257183247/movie_max_vp9.webm?t=1755719923"}}],"name":"Lunar Strike","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> windows 10/11 64 BIT<br></li><li><strong>Processor:</strong> INTEL 17-10700K AMD RYZEN 5 5600X<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA RTX 3080 AMD RX 6800 XT INTEL ARC A770<br></li><li><strong>Storage:</strong> 70 GB SSD MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows"