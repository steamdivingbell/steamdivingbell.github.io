ur sleeves.</p>","developers":["Wall Spaghetti"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3609980/56bec8a19601351cdcd5eab0adf38e597505a067/header.jpg?t=1745412532","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 11 (Big Sur) or later<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>"},"movies":[{"highlight":true,"id":257126009,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257126009/movie480.mp4?t=1745412530","max":"http://video.akamai.steamstatic.com/store_trailers/257126009/movie_max.mp4?t=1745412530"},"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257126009/540a6b4e86750dde97d089bc645aa2a469dcf46f/movie_600x337.jpg?t=1745412530","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257126009/movie480_vp9.webm?t=1745412530","max":"http://video.akamai.steamstatic.com/store_trailers/257126009/movie_max_vp9.webm?t=1745412530"}}],"name":"Yes, My Queen","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10, 11 x64<br></li><li><strong>Processor:</strong> Intel Core i3<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> OpenGL 2.1 compatible graphics card, integrated graphics<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>"},"platforms":{"linux":false,"mac":true,"windows":true},"publishers":["Wall Spaghetti"],"ratings":{"dejus":{"banned":"0","descriptors":"Linguagem impr\u00f3pria\nViol\u00eancia","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Gewalt