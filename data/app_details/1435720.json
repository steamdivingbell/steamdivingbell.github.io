20/35f8c6ff289789b922107673f71b98b4060bfb48/ss_35f8c6ff289789b922107673f71b98b4060bfb48.1920x1080.jpg?t=1745857884","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1435720/35f8c6ff289789b922107673f71b98b4060bfb48/ss_35f8c6ff289789b922107673f71b98b4060bfb48.600x338.jpg?t=1745857884"},{"id":17,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1435720/e2f6f2ebec497457b6a7f421663a8a9433123a41/ss_e2f6f2ebec497457b6a7f421663a8a9433123a41.1920x1080.jpg?t=1745857884","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1435720/e2f6f2ebec497457b6a7f421663a8a9433123a41/ss_e2f6f2ebec497457b6a7f421663a8a9433123a41.600x338.jpg?t=1745857884"}],"short_description":"Shrine's Legacy is a SNES-era inspired, 16-bit RPG set in the magical world of Ardemia. Follow a pair of heroes as they try to unite the elements of magic, restore the Sword of Shrine, and save the world in both single player and co-op action.","steam_appid":1435720,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":"https://www.positiveconceptgames.com/"}