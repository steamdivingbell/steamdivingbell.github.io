d0537694c3162bc7.1920x1080.jpg?t=1754057994","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1543380/ss_05be1227046db1b0b79633d4d0537694c3162bc7.600x338.jpg?t=1754057994"}],"short_description":"Embark on your asteroid hauling career with Veritago Fortana. Start with a basic ship and earn credits to upgrade, customise and repair as you try to fulfil larger and harder contracts. Built exclusively for VR, use your own hands to build, wire and fly using 100s of interconnecting components.","steam_appid":1543380,"support_info":{"email":"contact@sarumxr.com","url":"https://www.sarumxr.com/"},"supported_languages":"English","type":"game","website":null}