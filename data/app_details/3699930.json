e or a high-score buzz, <i>Orbs Orbs Orbs</i> will keep you clicking, strategizing, and coming back for more!</p></li></ul>","developers":["Acrylic Pixel Games"],"fullgame":{"appid":"3623400","name":"Orbs Orbs Orbs"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3699930/f1e8038b9811a496302ecbc64db388fc425f2b89/header.jpg?t=1746619140","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257131024,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257131024/movie480.mp4?t=1746114485","max":"http://video.akamai.steamstatic.com/store_trailers/257131024/movie_max.mp4?t=1746114485"},"name":"Announce Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257131024/d3978e9d8453924065842f88935430ff9c2e9624/movie_600x337.jpg?t=1746114485","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257131024/movie480_vp9.webm?t=1746114485","max":"http://video.akamai.steamstatic.com/store_trailers/257131024/movie_max_vp9.webm?t=1746114485"}}],"name":"Orbs Orbs Orbs Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong>  Basic<br></li><li><strong>Memory:</strong> 20 MB RAM<br></li><li><strong>Graphics:</strong> Basic</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Acrylic Pixel Games"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":false,"date":"6 May, 2025"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3699930/38