er end or accept who you truly are.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2875510/extras/2e93b0a1f2f91c8cd01a69be2672bc13.poster.avif?t=1773130193\" width=616 height=52 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2875510/extras/2e93b0a1f2f91c8cd01a69be2672bc13.webm?t=1773130193\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2875510/extras/2e93b0a1f2f91c8cd01a69be2672bc13.mp4?t=1773130193\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>","developers":["Exploding Soes"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2875510/7a594ac3a550dfd732adbefef35f00f3af457a9d/header.jpg?t=1773130193","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2875510/1252919612/e288ad596d41fab6322e2f9ac3c962c80dbcfecf/1765864078/dash_av1.mpd?t=1765864663","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2875510/1252919612/e288ad596d41fab6322e2f9ac3c962c80dbcfecf/1765864078/dash_h264.mpd?t=1765864663","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2875510/1252919612/e288ad596d41fab6322e2f9ac3c962c80dbcfecf/1765864078/hls_264_master.m3u8?t=1765864663","id":257062226,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257062226/179352e1fb49609607d6a17fcb6bd5dde18903ee/movie_600x337.jpg?t=1765864663"}],"name":"RAD: Repeat After Death","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul clas