ared.akamai.steamstatic.com/store_item_assets/steam/apps/2465060/a700651a26e434843051468f2aec1189be4c2002/ss_a700651a26e434843051468f2aec1189be4c2002.600x338.jpg?t=1757267058"}],"short_description":"Hollow Mine is an action roguelite that combines mining, crafting, and intense 2D top-down combat. Explore unpredictable, ever-changing mines, battle fierce enemy hordes, and confront tough bosses. Engage, die, learn, and repeat as you uncover new challenges with every run.","steam_appid":2465060,"support_info":{"email":"michalparysz@hollowminegame.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Polish, Spanish - Latin America, Russian, Ukrainian","type":"game","website":"http://hollowmine.com/"}