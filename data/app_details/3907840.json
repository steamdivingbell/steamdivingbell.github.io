98c17b5ef86951c4a273dfda0e7/ss_828f6b004743d98c17b5ef86951c4a273dfda0e7.1920x1080.jpg?t=1773327258","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907840/828f6b004743d98c17b5ef86951c4a273dfda0e7/ss_828f6b004743d98c17b5ef86951c4a273dfda0e7.600x338.jpg?t=1773327258"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907840/a7541fa589ba2bc5a090579a3201db53c1f1d530/ss_a7541fa589ba2bc5a090579a3201db53c1f1d530.1920x1080.jpg?t=1773327258","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907840/a7541fa589ba2bc5a090579a3201db53c1f1d530/ss_a7541fa589ba2bc5a090579a3201db53c1f1d530.600x338.jpg?t=1773327258"}],"short_description":"OUT OF WATER is a visual novel about survival, myths, love, and choice. In 1 CE Watarholt, a quiet village prepares for winter - until bodies begin to surface. Shape your path through bonds, ancient horrors, and a fading peace. Will you fight, plead, or surrender to the waters?","steam_appid":3907840,"support_info":{"email":"","url":"https://lapys-studio.com"},"supported_languages":"English","type":"game","website":"https://lapys-studio.com"}