pe=\"video/webm; codecs=vp9\"></video></span></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>Uncover secrets</strong></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The planet isn\u2019t just vibrant and primitive\u2014it\u2019s hiding something. Uncover its secrets by deciphering an alien language and reveal the story of the universe, hidden in plain sight.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3256470/extras/1098b87154bd5aa72116660904423d94.avif?t=1767809432\" width=1560 height=878 /></span></p>","developers":["Knowledgegrind"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3256470/4d055bd205cd1620c72d2478b62a635284538fb0/header.jpg?t=1767809432","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3256470/1021480735/8e0ceea2f94a22e4d453bd0d204049590d2b07f0/1765402320/dash_av1.mpd?t=1765403824","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3256470/1021480735/8e0ceea2f94a22e4d453bd0d204049590d2b07f0/1765402320/dash_h264.mpd?t=1765403824","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3256470/1021480735/8e0ceea2f94a22e4d453bd0d204049590d2b07f0/1765402320/hls_264_master.m3u8?t=1765403824","id":257097760,"name":"Manickologi demo official gameplay trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257097760/be67ff56b3bb89453c8c90908a82b309be574c6a/movie_600x337.jpg?t=1765403824"}],"name":"Manickologi","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> i5 5th gen<br></li><li><strong>Mem