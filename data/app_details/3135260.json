s/3135260/ed387b84aa6d51c3839d3a3d0d3ec20c250eba42/ss_ed387b84aa6d51c3839d3a3d0d3ec20c250eba42.1920x1080.jpg?t=1759498002","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3135260/ed387b84aa6d51c3839d3a3d0d3ec20c250eba42/ss_ed387b84aa6d51c3839d3a3d0d3ec20c250eba42.600x338.jpg?t=1759498002"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3135260/b8df917932349b90e8b28ed91748d25abedb9747/ss_b8df917932349b90e8b28ed91748d25abedb9747.1920x1080.jpg?t=1759498002","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3135260/b8df917932349b90e8b28ed91748d25abedb9747/ss_b8df917932349b90e8b28ed91748d25abedb9747.600x338.jpg?t=1759498002"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3135260/c62b96f91ad0387cb6030e210b71a3bd019f4dc8/ss_c62b96f91ad0387cb6030e210b71a3bd019f4dc8.1920x1080.jpg?t=1759498002","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3135260/c62b96f91ad0387cb6030e210b71a3bd019f4dc8/ss_c62b96f91ad0387cb6030e210b71a3bd019f4dc8.600x338.jpg?t=1759498002"}],"short_description":"You\u2019re the new intern in a demonic office, tasked with routine work\u2014no mistakes allowed. Only your attention to detail will save you. Can you climb 9 floors and make it to the end of the workday, or will you be fired first?","steam_appid":3135260,"support_info":{"email":"ankoku.indie@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Portuguese - Brazil, Traditional Chinese, Simplified Chinese, Korean, Polish, Russian<strong>*</strong>, Japanese<br><strong>*</strong>languages with full audio support","type":"game","website":null}