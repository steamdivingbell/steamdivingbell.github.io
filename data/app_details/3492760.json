fe2aecda1f2ff092f16730328b4aafa9647d6/ss_4f6fe2aecda1f2ff092f16730328b4aafa9647d6.1920x1080.jpg?t=1752847293","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3492760/4f6fe2aecda1f2ff092f16730328b4aafa9647d6/ss_4f6fe2aecda1f2ff092f16730328b4aafa9647d6.600x338.jpg?t=1752847293"}],"short_description":"An online co-op horror for 1-4 players. Travel across the Old World on the Engine Eternal and explore randomly generated dungeons to locate fuel and upgrades for the last train to Paradise.","steam_appid":3492760,"support_info":{"email":"absolutelycookage@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}