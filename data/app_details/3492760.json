s there.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3492760/extras/ParadisePostcardSmall.png?t=1743113354\" /></p>","developers":["Absolutely Cookage"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3492760/7c30629b4621e1f9869824c26d4e9814666ff815/header.jpg?t=1743113354","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257118885,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257118885/movie480.mp4?t=1743113347","max":"http://video.akamai.steamstatic.com/store_trailers/257118885/movie_max.mp4?t=1743113347"},"name":"Reveal Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257118885/ec31f6095501ba3fc19cd0e2b9c14fd975d933dd/movie_600x337.jpg?t=1743113347","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257118885/movie480_vp9.webm?t=1743113347","max":"http://video.akamai.steamstatic.com/store_trailers/257118885/movie_max_vp9.webm?t=1743113347"}}],"name":"Engine Eternal","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5-9400<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 1660 Super<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Network:</strong> Broa