 humor and easter eggs to old Sierra and Lucasarts games mixed in throughout</p></li></ul>","developers":["Wraithwood Studios"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/af15b8cc7a741e378cf0c6634e60eae51a6298c7/header.jpg?t=1764113644","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3652250/685089269/d5a031d4ca9c8b112e3c94093ad6d7af03a926dc/1763904726/dash_av1.mpd?t=1764113642","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3652250/685089269/d5a031d4ca9c8b112e3c94093ad6d7af03a926dc/1763904726/dash_h264.mpd?t=1764113642","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3652250/685089269/d5a031d4ca9c8b112e3c94093ad6d7af03a926dc/1763904726/hls_264_master.m3u8?t=1764113642","id":257236560,"name":"Nothmere Trailer #2","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257236560/8f961bd503c706c53d02a34a2b9f9bf66cfae016/movie_600x337.jpg?t=1764113642"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3652250/71237546/b17d4be21095017bf4e2c1dae22b488a08e3c6bc/1750414457/dash_av1.mpd?t=1747421621","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3652250/71237546/b17d4be21095017bf4e2c1dae22b488a08e3c6bc/1750414457/dash_h264.mpd?t=1747421621","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3652250/71237546/b17d4be21095017bf4e2c1dae22b488a08e3c6bc/1750414457/hls_264_master.m3u8?t=1747421621","id":257138884,"name":"Nothmere Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257138884/fd8d3060948ca20844f596fb95dfad8d4a306026/movie_600x337.jpg?t=1747421621"}],"name":"Nothmere","package_groups":[],"pc_requirements":{"minimu