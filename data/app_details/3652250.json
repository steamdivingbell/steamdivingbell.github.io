/b1f5c33b2e83135c003cee35d82e2b71742edfb5/ss_b1f5c33b2e83135c003cee35d82e2b71742edfb5.600x338.jpg?t=1764113644"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/94d67544a0488387ff210133a7b98537871fb366/ss_94d67544a0488387ff210133a7b98537871fb366.1920x1080.jpg?t=1764113644","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/94d67544a0488387ff210133a7b98537871fb366/ss_94d67544a0488387ff210133a7b98537871fb366.600x338.jpg?t=1764113644"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/138a586440cbd63787cfb19c005016ff0345a446/ss_138a586440cbd63787cfb19c005016ff0345a446.1920x1080.jpg?t=1764113644","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/138a586440cbd63787cfb19c005016ff0345a446/ss_138a586440cbd63787cfb19c005016ff0345a446.600x338.jpg?t=1764113644"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/f0c8a7095c9dfb7e0805088de67e23e9f1989a72/ss_f0c8a7095c9dfb7e0805088de67e23e9f1989a72.1920x1080.jpg?t=1764113644","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/f0c8a7095c9dfb7e0805088de67e23e9f1989a72/ss_f0c8a7095c9dfb7e0805088de67e23e9f1989a72.600x338.jpg?t=1764113644"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/c0ccf106f9fb85a572fd050dd1175bf51bd2975b/ss_c0ccf106f9fb85a572fd050dd1175bf51bd2975b.1920x1080.jpg?t=1764113644","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3652250/c0ccf106f9fb85a572fd050dd1175bf51bd2975b/ss_c0ccf106f9fb85a572fd050dd1175bf51bd2975b.600x338.jpg?t=1764113644"}],"short_description":"A medieval fantasy point-and-click adventure game RPG inspired by the Quest for Glory series. Investigate the mysterious town of Nothmere in order to discover how you got there, why you are there, and how to