/3947910/17e205fb0ba6b06a9cc9bb9c2df3942812f133f7/ss_17e205fb0ba6b06a9cc9bb9c2df3942812f133f7.1920x1080.jpg?t=1774621844","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3947910/17e205fb0ba6b06a9cc9bb9c2df3942812f133f7/ss_17e205fb0ba6b06a9cc9bb9c2df3942812f133f7.600x338.jpg?t=1774621844"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3947910/546ed851af189c1b34c0322a3abaeb65729b3759/ss_546ed851af189c1b34c0322a3abaeb65729b3759.1920x1080.jpg?t=1774621844","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3947910/546ed851af189c1b34c0322a3abaeb65729b3759/ss_546ed851af189c1b34c0322a3abaeb65729b3759.600x338.jpg?t=1774621844"}],"short_description":"Kuromaku | \u9ed2\u5e55 is an indie story driven first-person psychological thriller experienced through the perspective of a child left alone for three days. Complete everyday routines, uncover secrets, and endure unsettling encounters as your choices shape how the story unfolds Ahead.","steam_appid":3947910,"support_info":{"email":"bchopra2004@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}