span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700280/extras/a8cf16f059435441e32c3b0d1fedfcef.avif?t=1753784372\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700280/extras_big/a8cf16f059435441e32c3b0d1fedfcef.avif?t=1753784372 width=800 height=223 /></span></p><p class=\"bb_paragraph\" >These weird little guys are Ice Cream Souls.<br>They float through the Hyper Ice Cream Dimension, waiting for your guidance.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>And when all the souls scream together,the Ice Cream Big Bang will occur...</strong></p>","developers":["KAYAC Inc."],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700280/a0860d80b26b367f91e4e4400c284faa3db21347/header.jpg?t=1753784372","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3700280/44865654/377ba410d62c6b3f4aef6c6f5d516aff4928c9e5/1752227580/dash_av1.mpd?t=1752228812","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3700280/44865654/377ba410d62c6b3f4aef6c6f5d516aff4928c9e5/1752227580/dash_h264.mpd?t=1752228812","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3700280/44865654/377ba410d62c6b3f4aef6c6f5d516aff4928c9e5/1752227580/hls_264_master.m3u8?t=1752228812","id":257158111,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257158111/movie480.mp4?t=1752228812","max":"https://video.akamai.steamstatic.com/store_trailers/257158111/movie_max.mp4?t=1752228812"},"name":"teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257158111/43a22c99c8ea12af96b4dde08c248b8c5dcb63dc/movie_600x337.jpg?t=1752228812","webm":{"480":"https://video.akamai.ste