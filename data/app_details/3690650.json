ps/3690650/abdcfaf5bbe7ba1428050d3e4da06ffcc030af24/ss_abdcfaf5bbe7ba1428050d3e4da06ffcc030af24.1920x1080.jpg?t=1747546354","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3690650/abdcfaf5bbe7ba1428050d3e4da06ffcc030af24/ss_abdcfaf5bbe7ba1428050d3e4da06ffcc030af24.600x338.jpg?t=1747546354"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3690650/004171200552c16deb5067153e8e6253dc49fe56/ss_004171200552c16deb5067153e8e6253dc49fe56.1920x1080.jpg?t=1747546354","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3690650/004171200552c16deb5067153e8e6253dc49fe56/ss_004171200552c16deb5067153e8e6253dc49fe56.600x338.jpg?t=1747546354"}],"short_description":"&quot;Hitotsubashi Animal Chronicles&quot; is an adventure game where you lead an expedition to explore the mysterious Beast Island and discover a wide variety of animals. Enjoy the casual animal trivia shared by the expedition members and the story filled with conspiracies they get caught up in.","steam_appid":3690650,"support_info":{"email":"indiewataru@gmail.com","url":""},"supported_languages":"Japanese","type":"game","website":"https://indiewataru.wixsite.com/mysite"}