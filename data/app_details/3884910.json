ared.akamai.steamstatic.com/store_item_assets/steam/apps/3884910/8bc55765dd90d706d7fc72a69cca46cb7ef23411/ss_8bc55765dd90d706d7fc72a69cca46cb7ef23411.600x338.jpg?t=1767071313"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884910/1fc9074e87acc6b0c94a13ebc7670b9d6555798d/ss_1fc9074e87acc6b0c94a13ebc7670b9d6555798d.1920x1080.jpg?t=1767071313","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884910/1fc9074e87acc6b0c94a13ebc7670b9d6555798d/ss_1fc9074e87acc6b0c94a13ebc7670b9d6555798d.600x338.jpg?t=1767071313"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884910/85f2499b6f4759f78f1a4f3cd88c96259c74659f/ss_85f2499b6f4759f78f1a4f3cd88c96259c74659f.1920x1080.jpg?t=1767071313","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3884910/85f2499b6f4759f78f1a4f3cd88c96259c74659f/ss_85f2499b6f4759f78f1a4f3cd88c96259c74659f.600x338.jpg?t=1767071313"}],"short_description":"Kero Kero Cowboy is a cartoony western themed platformer developed for the Game Boy Color! Use your extendable tongue, trusty six-shooter, and wits to conquer the wildest outlaws of the west. Yeehaw!","steam_appid":3884910,"support_info":{"email":"mbedso@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}