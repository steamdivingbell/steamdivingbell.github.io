1"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260830/a70251fe563f5661ab49c1adebc6a3537acc1ac8/ss_a70251fe563f5661ab49c1adebc6a3537acc1ac8.1920x1080.jpg?t=1768750391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260830/a70251fe563f5661ab49c1adebc6a3537acc1ac8/ss_a70251fe563f5661ab49c1adebc6a3537acc1ac8.600x338.jpg?t=1768750391"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260830/a0655268fb91027fb33b59378942ce11058ef152/ss_a0655268fb91027fb33b59378942ce11058ef152.1920x1080.jpg?t=1768750391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260830/a0655268fb91027fb33b59378942ce11058ef152/ss_a0655268fb91027fb33b59378942ce11058ef152.600x338.jpg?t=1768750391"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260830/a4efb982a09b4f59dae4b9fa7be22c7de2df209a/ss_a4efb982a09b4f59dae4b9fa7be22c7de2df209a.1920x1080.jpg?t=1768750391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260830/a4efb982a09b4f59dae4b9fa7be22c7de2df209a/ss_a4efb982a09b4f59dae4b9fa7be22c7de2df209a.600x338.jpg?t=1768750391"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260830/17ad5eacf2de89a3528caf5152af7550186c23bc/ss_17ad5eacf2de89a3528caf5152af7550186c23bc.1920x1080.jpg?t=1768750391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260830/17ad5eacf2de89a3528caf5152af7550186c23bc/ss_17ad5eacf2de89a3528caf5152af7550186c23bc.600x338.jpg?t=1768750391"}],"short_description":"Buu finds themselves camping in a mysterious canyon after unexpected troubles. With a lantern in hand, he set off on an adventure, talking to passersby, observing their surroundings, and uncovering the secrets of the full moon night. And don\u2019t forget to fish, enjoy the scenery, and relax at camp!","steam_appid":3260830,"support_info":{"email":"info@doukutsupenguin.com","url":"https://doukutsupenguin.com/"},"supported_languages":"Japanese, English, Simplified Chinese, Korean","type":"game","website":"https://doukutsupenguin.com/"}