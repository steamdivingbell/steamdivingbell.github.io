steamstatic.com/store_item_assets/steam/apps/3085890/ss_e50295a6ff498a97feb7d0e1f694a22209f4fa2d.1920x1080.jpg?t=1771926566","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_e50295a6ff498a97feb7d0e1f694a22209f4fa2d.600x338.jpg?t=1771926566"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_db6e0d666489a1b0fb4a9ad6bb07b2213f7a0da8.1920x1080.jpg?t=1771926566","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_db6e0d666489a1b0fb4a9ad6bb07b2213f7a0da8.600x338.jpg?t=1771926566"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_3ee42ffca80564e74b9bb0abf4a3bfe7135e4acb.1920x1080.jpg?t=1771926566","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_3ee42ffca80564e74b9bb0abf4a3bfe7135e4acb.600x338.jpg?t=1771926566"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_75d0f41d489589bfcebf026ff940994c1bf02882.1920x1080.jpg?t=1771926566","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_75d0f41d489589bfcebf026ff940994c1bf02882.600x338.jpg?t=1771926566"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_8ff7fe09518c17c79640994217f6f5be3e01be79.1920x1080.jpg?t=1771926566","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_8ff7fe09518c17c79640994217f6f5be3e01be79.600x338.jpg?t=1771926566"},{"id":17,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_53785398161309226e657acfddcb8b8b7ae2b0f3.1920x1080.jpg?t=1771926566","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085890/ss_53785398161309226e657acfddcb8b8b7ae2b0f3.600x338.jpg?t=1771926566"}],"short_description":"Welcome to &quot;Land Of Idyllic Beauty&quot; a simulation management game that combines farming, store management, supply chain management, and romance elements. Experience the beauty of the idyllic life, starting from a small plot of farmland, gradually building your agricultural and commercial empire!","steam_appid":3085890,"support_info":{"email":"LandOfIdyllicBeauty@163.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese","type":"game","website":null}