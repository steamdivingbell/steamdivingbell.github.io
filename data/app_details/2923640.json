cb1fb85b95a.1920x1080.jpg?t=1755552313","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2923640/ss_eb8c3b01e5af4720dfeda73df3f58cb1fb85b95a.600x338.jpg?t=1755552313"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2923640/ss_b953086c553715665a3bfb29172e6d263bead4d2.1920x1080.jpg?t=1755552313","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2923640/ss_b953086c553715665a3bfb29172e6d263bead4d2.600x338.jpg?t=1755552313"}],"short_description":"Dragonfly fairies of the Sacred Swamp rely on the full moon to earn their wings, and insect spirits for their power. With the help of mother sages to guide them, they must rid their world of magic-wielding monsters.","steam_appid":2923640,"support_info":{"email":"help@dragenas.com","url":"https://dragenas.com/contact"},"supported_languages":"English, French, Portuguese - Brazil, Russian, Simplified Chinese, German, Japanese, Spanish - Latin America","type":"game","website":"https://dragenas.com/"}