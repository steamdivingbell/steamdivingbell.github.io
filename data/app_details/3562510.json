961de1/ss_f9c5763aeec298e0dbae132268085be15f961de1.600x338.jpg?t=1761791663"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3562510/7a4b55038b574dc5be337846533fd36dcc26518f/ss_7a4b55038b574dc5be337846533fd36dcc26518f.1920x1080.jpg?t=1761791663","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3562510/7a4b55038b574dc5be337846533fd36dcc26518f/ss_7a4b55038b574dc5be337846533fd36dcc26518f.600x338.jpg?t=1761791663"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3562510/1eb6aa004a3c40dd2d8d1148ac08536dae95600f/ss_1eb6aa004a3c40dd2d8d1148ac08536dae95600f.1920x1080.jpg?t=1761791663","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3562510/1eb6aa004a3c40dd2d8d1148ac08536dae95600f/ss_1eb6aa004a3c40dd2d8d1148ac08536dae95600f.600x338.jpg?t=1761791663"}],"short_description":"Rescue corrupted books from your library, harness their power and rally their forces to fight for you in this hexgrid tactics deckbuilder! Combine cards to create uniquely powerful spells. With thousands of permutations to explore every turn, no two battles will ever be the same.","steam_appid":3562510,"support_info":{"email":"unicursaldev@gmail.com","url":""},"supported_languages":"English, Italian, Japanese, French, German, Spanish - Spain, Russian, Ukrainian, Simplified Chinese","type":"game","website":null}