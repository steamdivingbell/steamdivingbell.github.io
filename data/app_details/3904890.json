533bc9b194427903e7e7110ca650faf323/ss_1def41533bc9b194427903e7e7110ca650faf323.1920x1080.jpg?t=1768640704","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3904890/1def41533bc9b194427903e7e7110ca650faf323/ss_1def41533bc9b194427903e7e7110ca650faf323.600x338.jpg?t=1768640704"}],"short_description":"A SAVE-EVERYONE type game where, just like a 911 operator, you make decisions based on the layout of the map or even based on past decisions. The deep psychological-horror story can only be uncovered by helping everyone. Should you save them all, the truth will finally come out...","steam_appid":3904890,"support_info":{"email":"bogdan.surcel123@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}