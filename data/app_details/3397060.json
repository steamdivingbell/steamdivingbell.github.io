ass=\"bb_paragraph\" >Massive army variety. Hard choices. No wasted moves.</p><p class=\"bb_paragraph\" >Choose your loadout. Upgrade your units. Spend your resources \u2014 and outplay everyone.</p>","developers":["John Corneloup"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3397060/0381643a8d7e5662e0c08798fb476b99c9b68571/header.jpg?t=1767055005","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 11 (Big Sur) or later<br></li><li><strong>Processor:</strong> Apple M1 or Intel Core i5 (Intel Only if no native support)<br></li><li><strong>Memory:</strong> 4096 MB RAM<br></li><li><strong>Graphics:</strong> Integrated GPU (e.g. M1 GPU or Intel Iris)<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 1000 MB available space<br></li><li><strong>Sound Card:</strong> Any<br></li><li><strong>Additional Notes:</strong> Runs well on entry-level Apple Silicon and older Intel Macs</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 12 (Monterey) or later<br></li><li><strong>Processor:</strong> Apple M1 or better (Universal build preferred)<br></li><li><strong>Memory:</strong> 8192 MB RAM<br></li><li><strong>Graphics:</strong> M1/M2 GPU or dedicated GPU<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 1500 MB available space<br></li><li><strong>Sound Card:</strong> Any<br></li><li><strong>Additional Notes:</strong> Native Apple Silicon build recommended for best performance</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3397060/447918351/21e81cd92e6b536c7ba7dc3f01f8100d6b483d42/1766529855/dash_av1.mpd?t=1766532190","dash_h2