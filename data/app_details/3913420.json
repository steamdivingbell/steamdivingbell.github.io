team/apps/3913420/a882ef317b896963f660639a1e523f5a5e5ead78/ss_a882ef317b896963f660639a1e523f5a5e5ead78.600x338.jpg?t=1772765423"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3913420/89f50fe790b2cf4716afaf4095b6f4cd0302f19e/ss_89f50fe790b2cf4716afaf4095b6f4cd0302f19e.1920x1080.jpg?t=1772765423","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3913420/89f50fe790b2cf4716afaf4095b6f4cd0302f19e/ss_89f50fe790b2cf4716afaf4095b6f4cd0302f19e.600x338.jpg?t=1772765423"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3913420/7b8b395136d22f0672bdbc18682dff2e76fe7c27/ss_7b8b395136d22f0672bdbc18682dff2e76fe7c27.1920x1080.jpg?t=1772765423","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3913420/7b8b395136d22f0672bdbc18682dff2e76fe7c27/ss_7b8b395136d22f0672bdbc18682dff2e76fe7c27.600x338.jpg?t=1772765423"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3913420/37ceb2b18e0d6756ec5fc0c22d13437411ff8c80/ss_37ceb2b18e0d6756ec5fc0c22d13437411ff8c80.1920x1080.jpg?t=1772765423","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3913420/37ceb2b18e0d6756ec5fc0c22d13437411ff8c80/ss_37ceb2b18e0d6756ec5fc0c22d13437411ff8c80.600x338.jpg?t=1772765423"}],"short_description":"It\u2019s just you, a deck of playing cards, and a knife that won\u2019t shut up. Stabjack is the roguelike, blackjack deckbuilder where you cheat to win. Tuck cards up your sleeve to use later, change your deck, and invoke supernatural items as you investigate a dark, devilish, comic-noir world.","steam_appid":3913420,"support_info":{"email":"ghelas@cosmiccog.com","url":""},"supported_languages":"English<strong>*</strong>, French<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Russian<strong>*</strong>, Spanish - Latin America<strong>*</strong><br><strong>*</strong>languages with full aud