rt_info":{"email":"ouroborosoft@gmail.com","url":"https://ouroborosoft.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://ouroborosoft.com/neo-tokyo-rush/"}