_item_assets/steam/apps/3499670/a0dcbfbee1f0eb8df49a341d97aaa7efcdb02173/ss_a0dcbfbee1f0eb8df49a341d97aaa7efcdb02173.600x338.jpg?t=1759507107"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499670/33b22ba415a675d6ce66a3a1beee9f9cc38218c0/ss_33b22ba415a675d6ce66a3a1beee9f9cc38218c0.1920x1080.jpg?t=1759507107","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499670/33b22ba415a675d6ce66a3a1beee9f9cc38218c0/ss_33b22ba415a675d6ce66a3a1beee9f9cc38218c0.600x338.jpg?t=1759507107"}],"short_description":"Escape zombies and chase coffees! Run to survive the horrific launch of a new pumpkin spice latte. Play as Joe the Duck, a mascot, who must outmaneuver and outwit the brainless mobs. Destroy the company town to win some peace with your morning cup.","steam_appid":3499670,"support_info":{"email":"contact@electricmonkmedia.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean, Polish, Russian, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.strangebrewthegame.com/"}