l costumes.\u00a0 Switch to the '68 Living Dead Mode to experience this apocalypse in black-and-white.<br><br>It was the end of civilization and there was no coffee. <br>There was no coffee and it was the end of civilization.</p><p class=\"bb_paragraph\" > </p>","developers":["Electric Monk Media"],"dlc":[4441080],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499670/f9435588f4484834daf590cff158856f3bcf3d69/header.jpg?t=1773885989","is_free":false,"legal_notice":"Copyright 2026 Electric Monk Media Ltd. All rights reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3499670/1555798901/f08d5849321010522242a389a9a97e4eac529187/1771474294/dash_av1.mpd?t=1771474855","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3499670/1555798901/f08d5849321010522242a389a9a97e4eac529187/1771474294/dash_h264.mpd?t=1771474855","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3499670/1555798901/f08d5849321010522242a389a9a97e4eac529187/1771474294/hls_264_master.m3u8?t=1771474855","id":257289849,"name":"Launch Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257289849/b04e3dae5cb94a7a9e28d5ef21e064402964c8c2/movie_600x337.jpg?t=1771474855"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3499670/222685480/ac77c2ba70d6bb11e3e13c9c56faee2073a4d3ba/1767880484/dash_av1.mpd?t=1767882278","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3