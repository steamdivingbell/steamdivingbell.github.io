bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583940/extras/EN003.gif?t=1745561857\" /></p><p class=\"bb_paragraph\"></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">Mini-game</p></li></ul><p class=\"bb_paragraph\">Simple and addictive mini-game that can be played with just the mouse.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583940/extras/EN004.gif?t=1745561857\" /></p><p class=\"bb_paragraph\"></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">Magical Abilities</p></li></ul><p class=\"bb_paragraph\">A variety of special abilities, free to mix and match, play in your own style.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583940/extras/EN005.gif?t=1745561857\" /></p>","developers":["NiniNana Studio"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3583940/b9ce47b864c536bef43491f448dc78ba0542f790/header.jpg?t=1745561857","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257128129,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257128129/movie480.mp4?t=1745128471","max":"http://video.akamai.steamstatic.com/store_trailers/257128129/movie_max.mp4?t=1745128471"},"name":"DemoPV_EN","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257128129/9578ef6cb