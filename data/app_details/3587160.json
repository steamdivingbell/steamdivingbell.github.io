160/47a6439179f3f664aa2f3da2b5042da4fb06b9fe/ss_47a6439179f3f664aa2f3da2b5042da4fb06b9fe.600x338.jpg?t=1748263232"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587160/2ba3c3eb67e78c90bc39adecfa87d8cca2e7dcc3/ss_2ba3c3eb67e78c90bc39adecfa87d8cca2e7dcc3.1920x1080.jpg?t=1748263232","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587160/2ba3c3eb67e78c90bc39adecfa87d8cca2e7dcc3/ss_2ba3c3eb67e78c90bc39adecfa87d8cca2e7dcc3.600x338.jpg?t=1748263232"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587160/c18874d40682affb2ff5d1b52afaadc7c49fa0b5/ss_c18874d40682affb2ff5d1b52afaadc7c49fa0b5.1920x1080.jpg?t=1748263232","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587160/c18874d40682affb2ff5d1b52afaadc7c49fa0b5/ss_c18874d40682affb2ff5d1b52afaadc7c49fa0b5.600x338.jpg?t=1748263232"}],"short_description":"You wake up in a deranged captor's dungeon, treated as a prized plaything. He subjects you to deadly games testing your worthiness\u2014failure means death, success could add you permanently to his collection. Your only chance is to escape, but beware: getting caught trying means certain doom.","steam_appid":3587160,"support_info":{"email":"support@bandaloop.at","url":""},"supported_languages":"English<strong>*</strong>, French<strong>*</strong>, German<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.bandaloop.at/plaything"}