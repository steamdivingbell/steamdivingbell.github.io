item_assets/steam/apps/3686580/extras/endless.gif?t=1746958507\" /></p><p class=\"bb_paragraph\">Survive 30 challenging waves and enter endless mode, testing the limits of your defenses! </p></li></ul>","developers":["RefinedBearGames"],"genres":[{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3686580/88a8729c2d74f5b593da2ebef9d7f5e6dadf89c7/header.jpg?t=1746958507","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 2 GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 200 MB available space</li></ul>"},"mac_requirements":[],"movies":[{"highlight":true,"id":257137627,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257137627/movie480.mp4?t=1746864185","max":"http://video.akamai.steamstatic.com/store_trailers/257137627/movie_max.mp4?t=1746864185"},"name":"Coming Soon","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257137627/f81bb668775985034e318e5546407cc003dac3b3/movie_600x337.jpg?t=1746864185","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257137627/movie480_vp9.webm?t=1746864185","max":"http://video.akamai.steamstatic.com/store_trailers/257137627/movie_max_vp9.webm?t=1746864185"}}],"name":"Repel The Rifts","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 2 GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 200 MB available space</li></ul>"},"platforms":{"linux":true,"mac":false,"windows":true},"publishers":["RefinedBearGames"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"10","rating_generated":"1","required_age":"10","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"re