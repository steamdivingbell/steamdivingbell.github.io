40/3db7887bb065e99251d9198f333a5691368820aa/ss_3db7887bb065e99251d9198f333a5691368820aa.1920x1080.jpg?t=1774697719","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950440/3db7887bb065e99251d9198f333a5691368820aa/ss_3db7887bb065e99251d9198f333a5691368820aa.600x338.jpg?t=1774697719"}],"short_description":"Lootbane is a minimalistic RPG of risk and reward where insatiable greed drives every decision. Explore shifting regions, build synergistic warbands, and descend into dangerous dungeons for legendary loot","steam_appid":3950440,"support_info":{"email":"milo@suprender.com","url":"https://suprender.com/"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese, Traditional Chinese, Portuguese - Portugal, Ukrainian<br><strong>*</strong>languages with full audio support","type":"game","website":"https://suprender.com/"}