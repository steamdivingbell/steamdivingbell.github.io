 loot, but enemies are stronger and death erases all. Your power spike is always one floor below.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950440/extras/e43fb950bc82451b985e37ddbe1a0f12.poster.avif?t=1759851812\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950440/extras/e43fb950bc82451b985e37ddbe1a0f12.webm?t=1759851812\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950440/extras/e43fb950bc82451b985e37ddbe1a0f12.mp4?t=1759851812\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Fortune Favors the Brave</h2><p class=\"bb_paragraph\" >Take risks. Build a legend or lose it all.</p>","developers":["Milo Panta"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3950440/beb89142d7ef962f308c9085922408f4bada6bc1/header.jpg?t=1759851812","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> 2 Ghz<br></li><li><strong>Graphics:</strong> 128MB, OpenGL 3+<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>"},"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3950440/1445521367/57b518c4c90ea4aaf7d646732d1cf6cd23799619/1758730413/dash_av1.mpd?t=1758734313","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3950440/1445521367/57b518c4c90ea4aaf7d646732d1cf6cd23799619/1758730413/dash_h264.mpd?t=1758734313","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3950440/1445521367/57b