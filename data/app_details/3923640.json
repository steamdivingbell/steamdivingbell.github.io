u69db\u76f4\u901a\u9ad8\u7aef\u5c40\uff01</strong></p></li></ul><p class=\"bb_paragraph\" >2\ufe0f\u20e3 <strong>\ud83d\udc8e \u8d44\u6e90\u72c2\u6492\u8282</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u9996\u7206\u9996\u6740\u5fc5\u5f97 <strong>\u767e\u4e07\u4f17\u795e\u5e01</strong> \ud83d\udcb0 + <strong>\u4e07\u5143\u771f\u5b9e\u5145\u503c</strong> \ud83d\udcb3\uff08\u514d\u8d39\u9886\uff01\uff09</p></li><li><p class=\"bb_paragraph\" ><strong>\u6253\u602a\u6389\u5145\u503c\uff0c\u96f6\u6c2a\u4e5f\u80fd\u5f53\u5927\u4f6c\uff01</strong></p></li></ul><p class=\"bb_paragraph\" >3\ufe0f\u20e3 <strong>\ud83d\udca5 \u7206\u7387\u6838\u7206\u7ea7</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4e13\u5c5e\u795e\u5668  \ud83d\udde1\ufe0f + \u70ab\u9177\u76ae\u80a4  \ud83d\udc79 <strong>\u5168\u5c4f\u7206\uff01</strong></p></li><li><p class=\"bb_paragraph\" ><strong>\u4e00\u520099999\uff0c\u88c5\u5907\u6361\u5230\u624b\u8f6f\uff01</strong></p></li></ul><p class=\"bb_paragraph\" >4\ufe0f\u20e3 <strong>\u2694\ufe0f \u516c\u5e73\u7ade\u6280\u573a</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >PK\u65e0\u79d2\u6740\u3001\u65e0\u4ed8\u8d39\u78be\u538b\uff01\ud83d\udeab\ud83d\udcb8</p></li><li><p class=\"bb_paragraph\" ><strong>\u6d41\u7545\u64cd\u4f5c+\u667a\u80fd\u5339\u914d\uff0c\u6563\u4eba\u4e5f\u80fd\u9006\u88ad\u7ec8\u6781\u6218\u795e\uff01</strong> \ud83c\udf1f</p></li></ul><h2 class=\"bb_tag\" ><strong>\u3010\u6838\u5fc3\u7279\u8272\uff1a\u8010\u73a9\u4e0d\u817b\uff0c\u6fc0\u60c5\u6c38\u7eed\u3011</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\ud83d\udee1\ufe0f \u65e0\u5957\u8def\u771f\u4f20\u5947</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u62d2\u7edd\u5f3a\u5236\u6d88\u8d39\uff01\u6240\u6709 <strong>\u8d27\u5e01\u3001\u88c5\u5907\u3001\u5145\u503c\u5168\u9760\u6253\uff01</strong> \ud83d\udcaf</p></li><li><p class=\"bb_paragraph\" ><strong>\u7206\u7387\u516c\u5f00\u900f\u660e\uff0c\u6563\u4eba\u5929\u5802\u5b9e\u81f3\u540d\u5f52\uff01</strong></p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\ud83e\uddd9\u2642\ufe0f \u4ed9\u672f\u5947\u9047\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >60+\u79cd\u9006\u5929\u4ed9\u672f\u81ea\u7531\u642d\u914d \ud83c\udf00 + 40+\u79cd\u5947\u9047BUFF\u968f\u673a\u89e6\u53d1 \u2728</p></li><li><p class=\"bb_paragraph\" ><strong>\u4e00\u5200\u65a9\u51fa\u201c\u5929\u96f7\u706d\u4e16\u201d\uff0c\u4e00\u6b65\u8e0f\u5165\u201c\u65f6\u7a7a\u88c2\u9699\u201d\uff01</strong></p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\ud83d\udde1\ufe0f \u4e13\u5c5e\u795e\u5668\u517b\u6210</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6b66\u9b42\u795e\u5668\u968f\u89d2\u8272\u6210\u957f \ud83c\udf31\uff0c\u541e\u566cBOSS\u9b42\u9b44\u8fdb\u5316 \ud83d\udc7b</p></li><li><p class=\"bb_paragraph\" ><strong>\u6700\u7ec8\u5f62\u6001\u6bc1\u5929\u706d\u5730\uff01</strong> \ud83d\udca5</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\ud83c\udfd7\ufe0f \u5341\u5e74\u5320\u5fc3\u54c1\u8d28</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u8017\u65f63650\u4e2a\u65e5\u591c</strong>\uff0c200+\u4eba\u56e2\u961f\u53cd\u590d\u6253\u78e8\uff01</p></li><li><p class=\"bb_paragraph\" >\u4ece\u6280\u80fd\u7279\u6548\u5230\u5730\u56fe\u8bbe\u8ba1\uff0c<strong>\u6bcf\u4e00\u5e27\u90fd\u662f\u827a\u672f\uff01</strong> \ud83c\udfa8</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\ud83d\udd25 \u4eba\u6c14\u6c38\u52a8\u673a</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5343\u4eba\u540c\u5c4f\u6c99\u5df4\u514b \ud83c\udff0\uff0c\u4e07\u4eba\u8de8\u670d\u6218\u4e0d\u505c\uff01</p></li><li><p class=\"bb_paragraph\" ><strong>24\u5c0f\u65f6\u6fc0\u60c5\u4e0d\u95f4\u65ad\uff0c\u544a\u522b\u9b3c\u670d\u5b64\u72ec\uff01</strong> \ud83c\udf89</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u3010\u6e38\u620f\u4eae\u70b9\uff1a\u4e00\u5207\u5168\u9760\u6253\uff0c\u6563\u4eba\u5c01\u795e\u8def\u3011</strong></h2><p class=\"bb_paragraph\" >\u2705 <strong>\ud83d\udcc8 \u516c\u5e73\u6210\u957f\u4f53\u7cfb</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u65f6\u95f4=\u5b9e\u529b\uff01</strong> \u96f6\u5145\u515a30\u5929\u5fc5\u5f97\u5168\u5957\u6bd5\u4e1a\u88c5 \ud83c\udf93</p></li><li><p class=\"bb_paragraph\" ><strong>\u62d2\u7edd\u201c\u6c2a\u91d1\u4e3a\u738b\u201d\uff01</strong> \ud83d\udeab\ud83d\udc8e</p></li></ul><p class=\"bb_paragraph\" >\u2705 <strong>\ud83d\udc7e BOSS\u72c2\u6b22\u76db\u5bb4</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >100+\u79cd\u4e13\u5c5eBOSS\u5168\u5929\u5237\u65b0 \ud83d\udc79\uff0c\u4ece\u201c\u65b0\u624b\u6751\u6076\u9738\u201d\u5230\u201c\u4e16\u754c\u7ec8\u6781BOSS\u201d \ud83c\udf0d</p></li><li><p class=\"bb_paragraph\" ><strong>\u6311\u6218\u65e0\u6781\u9650\uff01</strong> \ud83d\udcaa</p></li></ul><p class=\"bb_paragraph\" >\u2705 <strong>\ud83d\udcca \u4e09\u91cd\u6307\u6570\u7206\u8868</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\ud83c\udd95 \u521a\u73a9\u6307\u6570</strong>\uff1a\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\uff08\u4e0a\u624b\u96f6\u95e8\u69db\uff0c\u4e00\u5200\u5165\u9b42\uff01\uff09</p></li><li><p class=\"bb_paragraph\" ><strong>\ud83d\udd25 \u8d85\u723d\u6307\u6570</strong>\uff1a\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\uff08\u7206\u88c5+PK\uff0c\u53cc\u500d\u5feb\u4e50\uff01\uff09</p></li><li><p class=\"bb_paragraph\" ><strong>\ud83d\udc65 \u4eba\u6c14\u6307\u6570</strong>\uff1a\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\u2605\uff08\u5f00\u670d\u5373\u7206\u6ee1\uff0c\u6392\u961f\u8fdb\u670d\u6210\u5e38\u6001\uff01\uff09</p></li></ul><h2 class=\"bb_tag\" ><strong>\u3010\u5f00\u670d\u6d3b\u52a8\uff1a\u9650\u65f6\u72c2\u6b22\uff0c\u9519\u8fc7\u7b49\u5341\u5e74\u3011</strong>