ic.com/store_item_assets/steam/apps/1650810/ss_621ef17313b6c83c9b54fb64c08d4f56b353c683.1920x1080.jpg?t=1751566731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_621ef17313b6c83c9b54fb64c08d4f56b353c683.600x338.jpg?t=1751566731"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_6153c9e39c52c5da8a4d1a511349cadfb73857d9.1920x1080.jpg?t=1751566731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_6153c9e39c52c5da8a4d1a511349cadfb73857d9.600x338.jpg?t=1751566731"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_2959aa1f947797ed7dad95bcf3da265eaad05fc3.1920x1080.jpg?t=1751566731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_2959aa1f947797ed7dad95bcf3da265eaad05fc3.600x338.jpg?t=1751566731"}],"short_description":"Loopmancer is a 3D platformer roguelite action game with realistic graphics that takes place in a cyberpunk universe. Players play as a detective who comes back to life after an unexpected death, and battle in this lifelike and futuristic city of the east.","steam_appid":1650810,"support_info":{"email":"contact@yoorekastudio.com","url":"yoorekastudio.com"},"supported_languages":"English<strong>*</strong>, Simplified Chinese<strong>*</strong>, Traditional Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}