sens\u00edveis","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Selbstmord","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"recommendations":{"total":449},"release_date":{"coming_soon":false,"date":"13 Jul, 2022"},"required_age":0,"reviews":"\u201cLoopmancer is like a great cover of a classic song, in 2D action-platformer roguelite form. It may not be very creative, but it\u2019s excellent and highly replayable nonetheless.\u201d<br>8/10 \u2013 IGN<br><br>\u201cIf you\u2019re looking for a new Metroidvania, and you like your bosses big and your violence sweary, Loopmancer is an absolute treat.\u201d<br>8.5/10 \u2013 God Is A Geek<br><br>\u201cLoopmancer is a good game for gamers who want a very specific experience: a mix of action and rogue ideas that tells a cyberpunk-themed detective story.\u201d<br>8/10 \u2013 Softpedia<br>","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_0b55a05bd83af69e005bfd7d9364ee0b910309f0.1920x1080.jpg?t=1751566731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_0b55a05bd83af69e005bfd7d9364ee0b910309f0.600x338.jpg?t=1751566731"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_bdb38e34f8c442c160d1f5bf3c509c29979008d3.1920x1080.jpg?t=1751566731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_bdb38e34f8c442c160d1f5bf3c509c29979008d3.600x338.jpg?t=1751566731"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_f60b92f121b5486f137b4e2931cf2894c6388de7.1920x1080.jpg?t=1751566731","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1650810/ss_f60b92f121b5486f137b4e2931cf2894c6388de7.600x338.jpg?t=1751566731"},{"id":3,"path_full":"https://shared.akamai.s