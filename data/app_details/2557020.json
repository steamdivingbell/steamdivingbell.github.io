steamstatic.com/store_item_assets/steam/apps/2557020/ss_55b0c4f52c3ecb5b3ed8b8da05b2614e0438b315.1920x1080.jpg?t=1771625290","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557020/ss_55b0c4f52c3ecb5b3ed8b8da05b2614e0438b315.600x338.jpg?t=1771625290"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557020/ss_e2c9cfbf896b814309e570782f36d80bc663d5df.1920x1080.jpg?t=1771625290","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2557020/ss_e2c9cfbf896b814309e570782f36d80bc663d5df.600x338.jpg?t=1771625290"}],"short_description":"Eon Rush is a co-op ARPG with 20-minute competitive runs. Evolve your build mid-run, unleash decisive power spikes, and chain synergies to climb global leaderboards. No 100-hour grind required. Master Heroes from across the Eras and conquer brutal gauntlets and colossal bosses together.","steam_appid":2557020,"support_info":{"email":"info@eourush.com","url":"https://www.eonrush.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.eonrush.com/"}