n Twitter, Instagram, Facebook, YouTube, and TikTok, and even cast their vote for future content by visiting our website! All these links can be found in the game page to your right.</p>","developers":["AAAA Games"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3176720/699ea2e5b221901e0b5d3e6a4ce980234d86571c/header.jpg?t=1761624158","is_free":false,"legal_notice":"\u00a92021\u20132025. All Rights Reserved.","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3176720/14098795/0459ed9df4276c2c3c047de54685ae3acfc046ef/1757646339/dash_av1.mpd?t=1757704614","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3176720/14098795/0459ed9df4276c2c3c047de54685ae3acfc046ef/1757646339/dash_h264.mpd?t=1757704614","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3176720/14098795/0459ed9df4276c2c3c047de54685ae3acfc046ef/1757646339/hls_264_master.m3u8?t=1757704614","id":257196519,"name":"Royalty Free-For-All \u2014 Kickstarter Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257196519/b58845819e8069bc4c676d79bacd46aa13a08482/movie_600x337.jpg?t=1757704614"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3176720/139407220/7c98f67fbb0944d3edec59d8633fb5fccdbe936d/1751175650/dash_av1.mpd?t=1751258230","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3176720/139407220/7c98f67fbb0944d3edec59d8633fb5fccdbe936d/1751175650/dash_h264.mpd?t=1751258230","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3176720/139407220/7c98f67fbb0944d3edec59d8633fb5fccdbe936d/1751175650/hls_264_master.m3u8?t=1751258230","id":257162978,"name":"Royalty Free-For-All: Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/