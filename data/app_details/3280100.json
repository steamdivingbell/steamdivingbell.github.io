d.akamai.steamstatic.com/store_item_assets/steam/apps/3280100/0cc704cba455d7206002c7baed08f6ab94f1121c/ss_0cc704cba455d7206002c7baed08f6ab94f1121c.600x338.jpg?t=1747501161"}],"short_description":"Zoo Time is a Top-Down Animal &amp; Zoo Management Party Game. Core Gameplay revolves around physics-based interactions and successful task execution. Enjoy an Easy play with your kids or Challenging play with your friends!","steam_appid":3280100,"support_info":{"email":"support@purple-phobia.com","url":""},"supported_languages":"English","type":"game","website":null}