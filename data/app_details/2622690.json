018627.600x338.jpg?t=1771508089"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2622690/2a7319bbf6b8ef6344b9342f76366879f7f87bd4/ss_2a7319bbf6b8ef6344b9342f76366879f7f87bd4.1920x1080.jpg?t=1771508089","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2622690/2a7319bbf6b8ef6344b9342f76366879f7f87bd4/ss_2a7319bbf6b8ef6344b9342f76366879f7f87bd4.600x338.jpg?t=1771508089"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2622690/ss_e8c7ce09827dde4493c00ee33111f7eaddf3d2d1.1920x1080.jpg?t=1771508089","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2622690/ss_e8c7ce09827dde4493c00ee33111f7eaddf3d2d1.600x338.jpg?t=1771508089"}],"short_description":"Manage your own park facility in a huge open world in Park Ranger Simulator. Take on all the tasks that need to be completed as a park ranger - alone or together in cross-platform multiplayer! You have a variety of vehicles and equipment at your disposal to complete the challenges ahead!","steam_appid":2622690,"support_info":{"email":"https://helpdesk.aerosoft.com/portal/home","url":"https://helpdesk.aerosoft.com/portal/home"},"supported_languages":"English, French, Italian, German, Spanish - Spain","type":"game","website":null}