ts, and face ancient tree that demand blood to bear forbidden fruit.</p><p class=\"bb_paragraph\" ></p>","developers":["CanOpener"],"genres":[{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2798330/d261312249a66cb55857c791bd3fb65f44894542/header.jpg?t=1772546320","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2798330/141687885/3550c6606c04043a0f398b41f07acf6f5b4fcdc8/1772544858/dash_av1.mpd?t=1772546319","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2798330/141687885/3550c6606c04043a0f398b41f07acf6f5b4fcdc8/1772544858/dash_h264.mpd?t=1772546319","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2798330/141687885/3550c6606c04043a0f398b41f07acf6f5b4fcdc8/1772544858/hls_264_master.m3u8?t=1772546319","id":257297239,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257297239/00a82570d218ffd9f556f12feca2d483ae01ead5/movie_600x337.jpg?t=1772546319"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2798330/908219785/d2113b7ea2d43f9ed7717a0455269b31e539d293/1756830461/dash_av1.mpd?t=1756949978","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2798330/908219785/d2113b7ea2d43f9ed7717a0455269b31e539d293/1756830461/dash_h264.mpd?t=1756949978","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2798330/908219785/d2113b7ea2d43f9ed7717a0455269b31e539d293/1756830461/hls_264_master.m3u8?t=1756949978","id":257192284,"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257192284/ccfd9c6f0e74749cba7edeb498a699bbd0ab3b79/movie_600x337.jpg?t=1756949978"}],"name":"Dungeon Settlers","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"b