hanks to player creativity and dynamic tools.</p></li><li><p class=\"bb_paragraph\"><strong>Supports 5\u201315 Players</strong> \u2013 Ideal for parties, streams, or competitive hide-and-seek lovers.</p></li></ul>","developers":["Nightroot Interactive"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Massively Multiplayer","id":"29"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3768140/9b9bdb17e07abc8c7b9b5984d97ddab2514ea531/header.jpg?t=1749027472","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257149618,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257149618/movie480.mp4?t=1749027470","max":"http://video.akamai.steamstatic.com/store_trailers/257149618/movie_max.mp4?t=1749027470"},"name":"Teaser Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257149618/873eae9148bedc9fb314f6e7881772f79200145a/movie_600x337.jpg?t=1749027470","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257149618/movie480_vp9.webm?t=1749027470","max":"http://video.akamai.steamstatic.com/store_trailers/257149618/movie_max_vp9.webm?t=1749027470"}}],"name":"SeekOut","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10/11 (64-bit Operating System Required)<br></li><li><strong>Processor:</strong>  Intel Core i3, 2.4GHz<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li