x1080.jpg?t=1772707348","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2537470/ef55739d29263add49bb3ecc2b6cddc954135b0d/ss_ef55739d29263add49bb3ecc2b6cddc954135b0d.600x338.jpg?t=1772707348"}],"short_description":"VULTURES is a tactical turn-based survival horror, inspired by 90's survival horror classics. As an operative, scavenge the infested metropolis for materials and information that could cure the infection plaguing the world.","steam_appid":2537470,"support_info":{"email":"help@vulturesgame.com","url":"https://vulturesgame.com/"},"supported_languages":"English, Spanish - Latin America, Portuguese - Brazil, Simplified Chinese, Japanese, French, German, Russian, Ukrainian","type":"game","website":null}