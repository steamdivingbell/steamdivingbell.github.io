 type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" style=\"text-align: center\"><u>DISCOVERY &amp; EXPLORATION</u></h2><p class=\"bb_paragraph\" style=\"text-align: center\">Traverse interconnected world filled with hidden pathways, grand halls, and advanced yet enigmatic machines.</p><p class=\"bb_paragraph\" style=\"text-align: center\">Use your scanning abilities to detect glyphs, decode what was forgotten, and piece together a truth buried in time.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Studio Lifeforms"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2391940/eb64eee7ba9c572627e4be1b5f245d26717e5c3b/header.jpg?t=1762575981","is_free":false,"legal_notice":"\u00a9 2023 Created and developed by Lifeforms.io. All rights reserved.","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2391940/2064254944/21c8991d4f9c9c0ad8b9b2bf23bada765baa4d49/1756164408/dash_av1.mpd?t=1756183447","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2391940/2064254944/21c8991d4f9c9c0ad8b9b2bf23bada765baa4d49/1756164408/dash_h264.mpd?t=1756183447","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2391940/2064254944/21c8991d4f9c9c0ad8b9b2bf23bada765baa4d49/1756164408/hls_264_master.m3u8?t=1756183447","id":257188853,"name":"ETRE First Look","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257188853/2969b6c87d2e3c2eec614d9d659001c96ad66f94/movie_600x337.jpg?t=1756183447"}],"name":"ETRE","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 64-bit Windows 10<br></li><li><strong>Processor:</strong> Core i7-6700 or Ryzen 5 1600<br></li><li><strong>Memory:</strong> 12 GB RAM<br></li><li