ai.steamstatic.com/store_item_assets/steam/apps/3536380/24d74f32ce5cfe613cf31587bfe8fa1070021ae4/ss_24d74f32ce5cfe613cf31587bfe8fa1070021ae4.600x338.jpg?t=1751558280"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3536380/8e1b0ecab21f9aea300b645105d755f80fa8725f/ss_8e1b0ecab21f9aea300b645105d755f80fa8725f.1920x1080.jpg?t=1751558280","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3536380/8e1b0ecab21f9aea300b645105d755f80fa8725f/ss_8e1b0ecab21f9aea300b645105d755f80fa8725f.600x338.jpg?t=1751558280"}],"short_description":"Gridkeeper is an incremental game about managing &quot;Grids&quot; and using their power to run MineBots, research tech, and grow your mining empire by getting better Grids.","steam_appid":3536380,"support_info":{"email":"cindyfollows101@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}