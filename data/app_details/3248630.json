_a63afb65293d8bfb61fb1f3c41526d3ddf074085.600x338.jpg?t=1770041432"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3248630/ss_fec8d379bb4833bf529091b33ecbc8ba4cf2c828.1920x1080.jpg?t=1770041432","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3248630/ss_fec8d379bb4833bf529091b33ecbc8ba4cf2c828.600x338.jpg?t=1770041432"}],"short_description":"A first person, story-driven puzzle adventure inspired by the bests. You find yourself in an unknown world, where history and mythology are mixed and warped together.","steam_appid":3248630,"support_info":{"email":"theonewhoseesthings@outlook.com","url":""},"supported_languages":"English","type":"game","website":null}