?t=1757260064"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126200/e28e24e705a86084de437eee3c008682b9ba5d6d/ss_e28e24e705a86084de437eee3c008682b9ba5d6d.1920x1080.jpg?t=1757260064","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126200/e28e24e705a86084de437eee3c008682b9ba5d6d/ss_e28e24e705a86084de437eee3c008682b9ba5d6d.600x338.jpg?t=1757260064"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126200/096ab505e623edbcca9caa68cba96d7210569841/ss_096ab505e623edbcca9caa68cba96d7210569841.1920x1080.jpg?t=1757260064","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3126200/096ab505e623edbcca9caa68cba96d7210569841/ss_096ab505e623edbcca9caa68cba96d7210569841.600x338.jpg?t=1757260064"}],"short_description":"Divine Wish is a fast-paced roguelike shooter with various classes and special abilities. Find your play style, survive waves of enemies, and use artifacts to change the tides of the battle. Die, learn, adapt!","steam_appid":3126200,"support_info":{"email":"estelgamesua@gmail.com","url":""},"supported_languages":"English, Ukrainian, Russian, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Simplified Chinese, Traditional Chinese","type":"game","website":null}