ets to be the ultimate BMX video game experience, but we aren\u2019t stopping there\u2026 we can\u2019t wait to show you what we have in the pipeline. Look out for updates coming soon.</p><h2 class=\"bb_tag\" >Key Features</h2><p class=\"bb_paragraph\" >Physics Based BMX Riding</p><p class=\"bb_paragraph\" >Modern Control System</p><p class=\"bb_paragraph\" >Replay Editor</p><p class=\"bb_paragraph\" >Tweak System</p><p class=\"bb_paragraph\" >BMX Customization</p><p class=\"bb_paragraph\" >Pro Riders</p><p class=\"bb_paragraph\" >Multiple Maps</p><p class=\"bb_paragraph\" >Player Stats Menu</p><p class=\"bb_paragraph\" >Mod Support</p>","developers":["Mash Games"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Sports","id":"18"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/871540/8294fb36b4a4da708bc1a0fd9d738eb9ba036b8d/header.jpg?t=1769795771","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/871540/1356664629/685133f17bf78f3ea3e327460dcb74881d240b86/1759358018/dash_av1.mpd?t=1759503533","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/871540/1356664629/685133f17bf78f3ea3e327460dcb74881d240b86/1759358018/dash_h264.mpd?t=1759503533","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/871540/1356664629/685133f17bf78f3ea3e327460dcb74881d240b86/1759358018/hls_264_master.m3u8?t=1759503533","id":257210385,"name":"BMX Streets 2.0 Update Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257210385/34c69bbd7ebf04a2966d5d5fe96c7fb5923ace31/movie_600x337.jpg?t=1759503533"}],"name":"BMX Streets","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_licens