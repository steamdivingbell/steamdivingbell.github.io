20/extras/85831e40ef716d014154e8b3c2b9f5d6.avif?t=1761880142\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3756520/extras_big/85831e40ef716d014154e8b3c2b9f5d6.avif?t=1761880142 width=800 height=182 /></span></p><p class=\"bb_paragraph\" >From a regular school route to a school trip to Kyoto to a date spot with a gorgeous night view! Each area is packed with gimmicks and traps.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3756520/extras/e8a76359cf6ebf902cacf5c62a76002d.avif?t=1761880142\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3756520/extras_big/e8a76359cf6ebf902cacf5c62a76002d.avif?t=1761880142 width=800 height=532 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >*The screen is still in development and may differ from the final specifications.</p>","developers":["Clover Lab.,inc."],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3756520/2cfbd96019ff1fc33a04c95b010c6517760e0f8d/header.jpg?t=1761880142","is_free":false,"legal_notice":"\u00a9Xenotoon / clover Lab.,inc.","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3756520/1633192472/bdb66fa0de7ca14826dae0eeb0a1cc03c2574075/1761204523/dash_av1.mpd?t=1761205314","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3756520/1633192472/bdb66fa0de7ca14826dae0eeb0a1cc03c2574075/1761204523/dash_h264.mpd?t=1761205314","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3756520/1633192472/bdb66fa0de7ca14826dae0eeb0a1cc03c2574075/1761204523/hls_264_master.m3u8?t=1761205314","id":257180087,"name":"Official PV","thumbnail":"https://shared.akamai.steamstatic.com/store_it