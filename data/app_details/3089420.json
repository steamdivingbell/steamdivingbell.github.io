_assets/steam/apps/3089420/6d340bd59414cd21ca1ab93d9484bbba93797b5e/ss_6d340bd59414cd21ca1ab93d9484bbba93797b5e.600x338.jpg?t=1772143330"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3089420/2dd9d4d0501b30425a34ed4cf773b39ecf77ea31/ss_2dd9d4d0501b30425a34ed4cf773b39ecf77ea31.1920x1080.jpg?t=1772143330","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3089420/2dd9d4d0501b30425a34ed4cf773b39ecf77ea31/ss_2dd9d4d0501b30425a34ed4cf773b39ecf77ea31.600x338.jpg?t=1772143330"}],"short_description":"Prop Sumo is a party fighting game that pits ordinary props together in extraordinary battles! Beat up your friends and dominate the scoreboard!","steam_appid":3089420,"support_info":{"email":"Support@BarrelRollGames.com","url":""},"supported_languages":"English<strong>*</strong>, German<br><strong>*</strong>languages with full audio support","type":"game","website":null}