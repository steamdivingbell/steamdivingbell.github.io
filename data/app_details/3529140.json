_tag\"><strong>Combat</strong></h2><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3529140/extras/CombatGif.gif?t=1743794390\" /></p><p class=\"bb_paragraph\">Fight Enemies found in the Dream World using your combat skills and unlocked abilities from your bonds in the real world.</p><h2 class=\"bb_tag\"><strong>Dungeons</strong></h2><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3529140/extras/DungeonGif.gif?t=1743794390\" /></p><p class=\"bb_paragraph\">Help the residents of the Dream World by solving dungeons and uncovering their secrets. Figure out the significance of this new world.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3529140/extras/ShadowEndofPage.png?t=1743794390\" /></p>","developers":["Tumble Arts"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3529140/26b05d60f41c71693c8c7053f94df93837a716f4/header.jpg?t=1743794390","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257107219,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257107219/movie480.mp4?t=1741030387","max":"http://video.akamai.steamstatic.com/store_trailers/257107219/movie_max.mp4?t=1741030387"},"name":"No Rest for the Weary Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257107219/619061b7db70709f658d1c1fbfb58045f2ec49a1/movie_600x337.jpg?t=1741030387","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257107219/movie480_vp9.webm?t=1741030387","max":"http://video.akamai.steamstatic.com/store_trailers/257107219/movie_max_vp9.webm?t=1741030387"}}],"name":"No Rest for the Weary","package_groups":[],"pc_requirem