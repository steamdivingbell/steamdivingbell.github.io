s/steam/apps/3885370/43ff8d888c96735c0b27992a86655753a97cea31/ss_43ff8d888c96735c0b27992a86655753a97cea31.1920x1080.jpg?t=1753498601","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885370/43ff8d888c96735c0b27992a86655753a97cea31/ss_43ff8d888c96735c0b27992a86655753a97cea31.600x338.jpg?t=1753498601"}],"short_description":"Soul Balance is a light rogue-lite game featuring horror elements, collection, and action combat. Players take on the roles of characters with diverse combat styles, exploring a world overrun by monsters, strengthening their abilities, and engaging in deadly battles against mutated former friends.","steam_appid":3885370,"support_info":{"email":"null1728@qq.com","url":""},"supported_languages":"English, French, Italian, German, Russian, Japanese, Thai, Simplified Chinese, Traditional Chinese, Korean","type":"demo","website":null}