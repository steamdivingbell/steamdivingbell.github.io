 class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Reroll:</strong> Dice are just flexible cards. Reroll to the right ability for the job at the cost of Sanity.</p></li></ul>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/1227330?t=1768558968","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1227330/page_bg_raw.jpg?t=1768558968","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1227330/d4c2a77daeeb3ffede210dab0ab4904a709b168c/capsule_231x87.jpg?t=1768558968","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1227330/d4c2a77daeeb3ffede210dab0ab4904a709b168c/capsule_184x69.jpg?t=1768558968","categories":[{"description":"Single-player","id":2},{"description":"Multi-player","id":1},{"description":"PvP","id":49},{"description":"Shared/Split Screen PvP","id":37},{"description":"Shared/Split Screen","id":24},{"description":"Steam Achievements","id":22},{"description":"Steam Workshop","id":30},{"description":"Steam Cloud","id":23},{"description":"Steam Leaderboards","id":25},{"description":"Remote Play Together","id":44},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"demos":[{"appid":1432820,"description":"Sneak Peek"}],"detailed_description":"<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1227330/extras/4f360ef986d390006e3a0768bb3cb432.poster.avif?t=1768558968\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1227330/extras/4f360ef986d390006e3a0768bb3cb432.webm?t=1768558968\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1227330/extras/4f360ef986d390006e3a0768bb3cb432.mp4?t=1768558968\" type=\"video/m