m_assets/steam/apps/3669020/33a03230f15fcb55b2a3b776c5fa48186cc1b6da/ss_33a03230f15fcb55b2a3b776c5fa48186cc1b6da.1920x1080.jpg?t=1757245550","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3669020/33a03230f15fcb55b2a3b776c5fa48186cc1b6da/ss_33a03230f15fcb55b2a3b776c5fa48186cc1b6da.600x338.jpg?t=1757245550"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3669020/9db52cd97291d46ae335eb1270c0681c52d9a95f/ss_9db52cd97291d46ae335eb1270c0681c52d9a95f.1920x1080.jpg?t=1757245550","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3669020/9db52cd97291d46ae335eb1270c0681c52d9a95f/ss_9db52cd97291d46ae335eb1270c0681c52d9a95f.600x338.jpg?t=1757245550"}],"short_description":"A cozy idle creature collector that sits on your desktop as you go about your day. Grow crops, care for and level-up your companions and put them to the test in wild monster battles!","steam_appid":3669020,"support_info":{"email":"","url":"https://discord.gg/xFufUvx4je"},"supported_languages":"English","type":"game","website":null}