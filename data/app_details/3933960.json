tn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933960/extras/2ff80e5a780242cf77705936018cf623.poster.avif?t=1773814588\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933960/extras/2ff80e5a780242cf77705936018cf623.webm?t=1773814588\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933960/extras/2ff80e5a780242cf77705936018cf623.mp4?t=1773814588\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>80,000-word script and 5 endings to save you from all the unhappiness! 30+ delicate illustrations waiting for you to unlock!</strong></p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Please accept this challenge, my great detective!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>PS. The game supports four languages: English, Simplified Chinese, Traditional Chinese and Japanese, which can be freely set within the game system.</i></p><p class=\"bb_paragraph\" ><i>Each language has been adapted to the local culture, with jokes and humor infused to suit the language.</i></p><p class=\"bb_paragraph\" ><i>Playing through different languages twice or three times will double the fun!</i></p><p class=\"bb_paragraph\" ></p>","developers":["\u7a3b\u6b4c\u6e38\u620f\u5de5\u4f5c\u5ba4"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3933960/a12a22780a71967ba86f4a5df4d21219623692ab/header.jpg?t=1773814588","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<stron