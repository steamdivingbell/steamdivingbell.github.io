/steam/apps/3530160/e7d5730a720cdd147c3ebd6480ac628fb63548b7/ss_e7d5730a720cdd147c3ebd6480ac628fb63548b7.600x338.jpg?t=1773942730"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3530160/e43d06029e15fe7736663fd47507761c7b3274af/ss_e43d06029e15fe7736663fd47507761c7b3274af.1920x1080.jpg?t=1773942730","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3530160/e43d06029e15fe7736663fd47507761c7b3274af/ss_e43d06029e15fe7736663fd47507761c7b3274af.600x338.jpg?t=1773942730"}],"short_description":"Solve puzzles and hunt for hearts in an interactive picture book universe! Take a load off, with hand-drawn illustrations, adorable animations and gentle live-recorded piano music.","steam_appid":3530160,"support_info":{"email":"asaha.contact@gmail.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese","type":"game","website":"https://www.asaha.world"}