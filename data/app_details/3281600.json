38.jpg?t=1747240063"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281600/ss_cc52327ab519d3e10086fc9f729558f03dd43407.1920x1080.jpg?t=1747240063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281600/ss_cc52327ab519d3e10086fc9f729558f03dd43407.600x338.jpg?t=1747240063"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281600/ss_b006996878d6b70b4cd100908682cf168d5237e2.1920x1080.jpg?t=1747240063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281600/ss_b006996878d6b70b4cd100908682cf168d5237e2.600x338.jpg?t=1747240063"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281600/ss_bbc8b9ec82e929b3ad0fc2e927aba69ff0cc0011.1920x1080.jpg?t=1747240063","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281600/ss_bbc8b9ec82e929b3ad0fc2e927aba69ff0cc0011.600x338.jpg?t=1747240063"}],"short_description":"What do you think is the most important quest you can complete from the comfort of your couch? Saving the clumsy Yuki, and not just from the enemies, but from Yuki himself. Start this cooperative adventure with whoever you like. Collect materials, build turrets and experience absolute chaos.","steam_appid":3281600,"support_info":{"email":"atabeycreationsdevs@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://linktr.ee/atabey_creations"}