e_item_assets/steam/apps/1403940/b06aa178a6ff207f2159126cecdfb44dd0ad25ad/ss_b06aa178a6ff207f2159126cecdfb44dd0ad25ad.600x338.jpg?t=1763071007"}],"short_description":"GRIM is an Exclusive VR Multiplayer Survival game where you must immerse yourself, stranded on a secluded part of Earth. Survival is not just a choice but a grueling battle against nature and other players. Gather resources, craft, and build your base, all to stay alive.","steam_appid":1403940,"support_info":{"email":"support@combatwaffle.com","url":"https://combatwaffle.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://playgrimvr.com"}