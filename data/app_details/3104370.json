ai.steamstatic.com/store_item_assets/steam/apps/3104370/aed95c9e898ed5e45961ef2ad2795517c56bb6ca/ss_aed95c9e898ed5e45961ef2ad2795517c56bb6ca.600x338.jpg?t=1745430846"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/68b4ccff4039d4d55eb71a1a6044b9df1928f0be/ss_68b4ccff4039d4d55eb71a1a6044b9df1928f0be.1920x1080.jpg?t=1745430846","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/68b4ccff4039d4d55eb71a1a6044b9df1928f0be/ss_68b4ccff4039d4d55eb71a1a6044b9df1928f0be.600x338.jpg?t=1745430846"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/98db413aaa837d95966982008af9a5c9c2dd02d1/ss_98db413aaa837d95966982008af9a5c9c2dd02d1.1920x1080.jpg?t=1745430846","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/98db413aaa837d95966982008af9a5c9c2dd02d1/ss_98db413aaa837d95966982008af9a5c9c2dd02d1.600x338.jpg?t=1745430846"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/5470efe690b7fc34418a6f46529cedcf80df18e2/ss_5470efe690b7fc34418a6f46529cedcf80df18e2.1920x1080.jpg?t=1745430846","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/5470efe690b7fc34418a6f46529cedcf80df18e2/ss_5470efe690b7fc34418a6f46529cedcf80df18e2.600x338.jpg?t=1745430846"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/d2f819d6432c5106791e3965582645fa6e346dd9/ss_d2f819d6432c5106791e3965582645fa6e346dd9.1920x1080.jpg?t=1745430846","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/d2f819d6432c5106791e3965582645fa6e346dd9/ss_d2f819d6432c5106791e3965582645fa6e346dd9.600x338.jpg?t=1745430846"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104370/e69c8a4e3fd82297e1feb239ebe61c67697a09f1/ss_e69c8a4e3fd82297e1feb239ebe61c67697a