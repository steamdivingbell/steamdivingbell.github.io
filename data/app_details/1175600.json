s/steam/apps/1175600/extras/5e0ed0f4452792ff894f6e8e75826d63.webm?t=1769101199\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >Strap in for this turbulent ride through the dark corners, bright sunlight, and unlikely humour.</p><p class=\"bb_paragraph\" >Enjoy the world, puzzles, and mysteries of <strong>The Wilds of Dacrima: Field Notes from a Poorly Supervised Alchemist and his Unruly Robot Companion!</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1175600/extras/88c3224c9a333ebb7eae1ec499c16ca8.poster.avif?t=1769101199\" width=1170 height=304 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1175600/extras/88c3224c9a333ebb7eae1ec499c16ca8.webm?t=1769101199\" type=\"video/webm; codecs=vp9\"></video></span></p>","developers":["Antler Studios"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1175600/d6771fd2d47b2e30b574abba727b6219ae0e26ba/header.jpg?t=1769101199","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1175600/2083238605/4ab93ff5d1e6eb8d59d5c1422b71febda86cfee5/1767024894/dash_av1.mpd?t=1767960827","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1175600/2083238605/4ab93ff5d1e6eb8d59d5c1422b71febda86cfee5/1767024894/dash_h264.mpd?t=1767960827","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1175