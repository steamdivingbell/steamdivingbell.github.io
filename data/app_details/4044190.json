46fb094b50cde6215b0812/ss_9200ec478d0edc1bbc46fb094b50cde6215b0812.1920x1080.jpg?t=1772657132","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4044190/9200ec478d0edc1bbc46fb094b50cde6215b0812/ss_9200ec478d0edc1bbc46fb094b50cde6215b0812.600x338.jpg?t=1772657132"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4044190/76b0c2ee841be54c85b34f06032ab18cc71bf81f/ss_76b0c2ee841be54c85b34f06032ab18cc71bf81f.1920x1080.jpg?t=1772657132","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4044190/76b0c2ee841be54c85b34f06032ab18cc71bf81f/ss_76b0c2ee841be54c85b34f06032ab18cc71bf81f.600x338.jpg?t=1772657132"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4044190/30f65627b19de420e66bf4d11f09533788f15b25/ss_30f65627b19de420e66bf4d11f09533788f15b25.1920x1080.jpg?t=1772657132","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4044190/30f65627b19de420e66bf4d11f09533788f15b25/ss_30f65627b19de420e66bf4d11f09533788f15b25.600x338.jpg?t=1772657132"}],"short_description":"Welcome to Townslife - a game about living in a small town, surrounded by forests and the sea, with the local mine somewhere in the distance. Place stuff around, customize the interior of your house, mine, fight with hostile creatures, talk to the locals and more! All in a nice retro pixel package!","steam_appid":4044190,"support_info":{"email":"bartek1009x@gmail.com","url":""},"supported_languages":"English, Polish","type":"game","website":null}