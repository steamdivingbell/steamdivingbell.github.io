graph\" >\ud83c\udfd9\ufe0f <strong>A rich and varied city</strong> with over 100 buildings, including rural, industrial, and urban areas.</p></li><li><p class=\"bb_paragraph\" >\ud83d\udc65 <strong>NPCs with unique personalities</strong> and custom-crafted dialogue interactions.</p></li><li><p class=\"bb_paragraph\" >\ud83d\uddfa\ufe0f <strong>Top-down interactive map</strong> with free navigation between districts and landmarks.</p><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" >It\u2019s your first day on the job. The city is waiting. <br>Courier Bay \u2014 <strong>where every package has a story.</strong></p>","developers":["Arcadia"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3781940/a9155768e0063968493852296c68ad3295026932/header.jpg?t=1768528062","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3781940/1621051994/c75331f25c556568e9d3bea747677ca7a802c709/1758577927/dash_av1.mpd?t=1758578805","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3781940/1621051994/c75331f25c556568e9d3bea747677ca7a802c709/1758577927/dash_h264.mpd?t=1758578805","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3781940/1621051994/c75331f25c556568e9d3bea747677ca7a802c709/1758577927/hls_264_master.m3u8?t=1758578805","id":257147371,"name":"Courier Bay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257147371/601b80767a9b2407152cbaaeeab00529b6372805/movie_600x337.jpg?t=1758578805"}],"name":"Courier Bay","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_