ass=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3833100/extras/8fa96210ebe558f0ebcfcff3cbc7239a.poster.avif?t=1751801521\" media=\"(prefers-reduced-motion: reduce)\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3833100/extras/8fa96210ebe558f0ebcfcff3cbc7239a.webp?t=1751801521\" class=\"bb_img\" /></picture></div></p><p class=\"bb_paragraph\">We recommend playing the game with headphones</p><p class=\"bb_paragraph\">Hope you enjoy :)</p>","developers":["xoblins"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3833100/0aad40c696e16faec7d17b9566388e1ec630e117/header.jpg?t=1751801521","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257159235,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257159235/movie480.mp4?t=1751303509","max":"http://video.akamai.steamstatic.com/store_trailers/257159235/movie_max.mp4?t=1751303509"},"name":"trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257159235/0108bf656854a75fe31b969b65607f0aa6eef011/movie_600x337.jpg?t=1751303509","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257159235/movie480_vp9.webm?t=1751303509","max":"http://video.akamai.steamstatic.com/store_trailers/257159235/movie_max_vp9.webm?t=1751303509"}}],"name":"Hell's Kitchen","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7<br></li><li><strong>Processor:</strong> x86_32 CPU with SSE2 instructions, x86_64 CPU, ARMv8 CPU<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Integrated graphics with full Vulkan 1.0 support<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>"},"platforms":{"linux":false,"mac":fa