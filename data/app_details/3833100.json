/6e57a4c32fbb0d572f1ccd23e17bbcbe8e735f6c/ss_6e57a4c32fbb0d572f1ccd23e17bbcbe8e735f6c.600x338.jpg?t=1751801521"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3833100/e13d0d433c861da302f14e8ba76d51eb4ce182c7/ss_e13d0d433c861da302f14e8ba76d51eb4ce182c7.1920x1080.jpg?t=1751801521","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3833100/e13d0d433c861da302f14e8ba76d51eb4ce182c7/ss_e13d0d433c861da302f14e8ba76d51eb4ce182c7.600x338.jpg?t=1751801521"}],"short_description":"Cook disturbing meals before you become one! Use physics-based cooking to prepare gory dishes while keeping her distracted by scrolling the phone. Survive a surreal narrative across Story and Hardcore modes. The only culinary experience that redefines doomscrolling.","steam_appid":3833100,"support_info":{"email":"xoblinsgames@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://prosfabs.neocities.org/"}