990/extras/98f93ea51bf648232eef3be10121236b.webm?t=1765295539\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2637990/extras/98f93ea51bf648232eef3be10121236b.mp4?t=1765295539\" type=\"video/mp4\"></video></span></i></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2637990/extras/38c6d8df9c60f8556e1a65fe2e63c58a.webp?t=1765295539\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2637990/extras_big/38c6d8df9c60f8556e1a65fe2e63c58a.webp?t=1765295539 width=800 height=41 /></span><i> <br>Join the Duck Detective on his latest, greatest case:</i></p><p class=\"bb_paragraph\" ><i> </i></p><p class=\"bb_paragraph\" ><i>Inspect and interview suspects to learn their hidden secrets, then use the information you\u2019ve gathered (plus your own de-duck-tive reasoning) to locate the suspect and bust the case wide open!</i></p><p class=\"bb_paragraph\" ><i><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2637990/extras/3b8c8ce88eba9f737ac35754d4f9a855.poster.avif?t=1765295539\" width=600 height=198 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2637990/extras/3b8c8ce88eba9f737ac35754d4f9a855.webm?t=1765295539\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2637990/extras/3b8c8ce88eba9f737ac35754d4f9a855.mp4?t=1765295539\" type=\"video/mp4\"></video></span></i></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2637990/extras/6a944fdb9b1a77cf1f5cbfcdbd6fbdae.webp?t=1765295539\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2637990/extras_big/6a