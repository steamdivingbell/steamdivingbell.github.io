00/22f2a303a109ec7b0306df8b07182d7a22578ee9/ss_22f2a303a109ec7b0306df8b07182d7a22578ee9.600x338.jpg?t=1772072192"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2979500/1e46a503e38b25f004a27cee9792f0723ddb205d/ss_1e46a503e38b25f004a27cee9792f0723ddb205d.1920x1080.jpg?t=1772072192","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2979500/1e46a503e38b25f004a27cee9792f0723ddb205d/ss_1e46a503e38b25f004a27cee9792f0723ddb205d.600x338.jpg?t=1772072192"}],"short_description":"Something strange is happening in Bricktown, and Milo\u2019s on a mission to get to the bottom of it! Leave your home behind as you explore a series of dungeons with the help of your Anima - unusual creatures with unique personalities, abilities, and evolutions - to solve this mystery once and for all.","steam_appid":2979500,"support_info":{"email":"serialworld.contact@gmail.com","url":"https://serialworld.jp/"},"supported_languages":"English, Japanese, French, Italian, German, Spanish - Spain, Portuguese - Brazil, Russian, Simplified Chinese, Korean, Traditional Chinese","type":"game","website":"https://serialworld.jp/"}