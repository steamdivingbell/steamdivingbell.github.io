/apps/3518730/be009e135682d8c454c5872e68680b9e050bf309/ss_be009e135682d8c454c5872e68680b9e050bf309.600x338.jpg?t=1757519764"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3518730/98f2037caecabd54efd83d4befc4f77b722be28e/ss_98f2037caecabd54efd83d4befc4f77b722be28e.1920x1080.jpg?t=1757519764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3518730/98f2037caecabd54efd83d4befc4f77b722be28e/ss_98f2037caecabd54efd83d4befc4f77b722be28e.600x338.jpg?t=1757519764"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3518730/82af454396ac5cee557cdcaed6636d996201e949/ss_82af454396ac5cee557cdcaed6636d996201e949.1920x1080.jpg?t=1757519764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3518730/82af454396ac5cee557cdcaed6636d996201e949/ss_82af454396ac5cee557cdcaed6636d996201e949.600x338.jpg?t=1757519764"}],"short_description":"Become a space baron in the great 22nd-century Nuice rush! Manage your cash flow, discover buried treasures, capitalize on electromagnetic storms and launch attacks at your competitors to maximize your profits in this sci-fi management game.","steam_appid":3518730,"support_info":{"email":"contact.castlewind@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese, Traditional Chinese, Turkish, Czech, Hungarian, Polish","type":"game","website":null}