=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189820/extras/b5d325e88474e398f024ac774eae879b.mp4?t=1773079480\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>\u26cf Gather Resources</strong></h2><p class=\"bb_paragraph\" >Collect minerals, energy, and rare metals. Resources are essential for building and upgrading your towers.<br>Some planets hold special resources required to craft advanced technology.  </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189820/extras/024e5c660c40f7ad1a4b9ee3507a7115.poster.avif?t=1773079480\" width=1170 height=518 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189820/extras/024e5c660c40f7ad1a4b9ee3507a7115.webm?t=1773079480\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189820/extras/024e5c660c40f7ad1a4b9ee3507a7115.mp4?t=1773079480\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>\ud83d\udee1 Build and Upgrade Towers</strong></h2><p class=\"bb_paragraph\" >Construct a variety of towers and defenses, each with unique abilities. Place them strategically to maximize efficiency and save resources.</p><p class=\"bb_paragraph\" >Upgrade your towers with shields, extra ammo, or new abilities to tailor your defenses for every wave of enemies.</p><p class=\"bb_paragraph\" >  </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189820/extras/e86a72d0d7d30bcbdb13e0ec117c9f8d.poster.avif?t=1773079480\" width=1170 height=514 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189820/extras/e8