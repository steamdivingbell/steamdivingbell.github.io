ge.</p><p class=\"bb_paragraph\" ></p>","developers":["Ready2Run"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2875410/header.jpg?t=1763835221","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2875410/1632348638/64fe9329d05f4cabdaa65a7e6fa436cf09129ec5/1763819253/dash_av1.mpd?t=1763834836","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2875410/1632348638/64fe9329d05f4cabdaa65a7e6fa436cf09129ec5/1763819253/dash_h264.mpd?t=1763834836","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2875410/1632348638/64fe9329d05f4cabdaa65a7e6fa436cf09129ec5/1763819253/hls_264_master.m3u8?t=1763834836","id":257236301,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257236301/7666619a050613471c530dc8743ce960982a7870/movie_600x337.jpg?t=1763834836"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2875410/771705/66fa5a7fd4b78a0b780f18f725724af8fce425a3/1750949697/dash_av1.mpd?t=1763834843","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2875410/771705/66fa5a7fd4b78a0b780f18f725724af8fce425a3/1750949697/dash_h264.mpd?t=1763834843","highlight":false,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2875410/771705/66fa5a7fd4b78a0b780f18f725724af8fce425a3/1750949697/hls_264_master.m3u8?t=1763834843","id":257065007,"name":"Original Announcement Trailer (ENGLISH)","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257065007/3877b6