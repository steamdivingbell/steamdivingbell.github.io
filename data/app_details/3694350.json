801c8bfaf435f925b.1920x1080.jpg?t=1771074411","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694350/cb898900eb73d93d835f874801c8bfaf435f925b/ss_cb898900eb73d93d835f874801c8bfaf435f925b.600x338.jpg?t=1771074411"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694350/323550601a1a1e2fbec2534d5cc6a3dd953cbd47/ss_323550601a1a1e2fbec2534d5cc6a3dd953cbd47.1920x1080.jpg?t=1771074411","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694350/323550601a1a1e2fbec2534d5cc6a3dd953cbd47/ss_323550601a1a1e2fbec2534d5cc6a3dd953cbd47.600x338.jpg?t=1771074411"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694350/bb372fa132a9fb8b64e3d50adcfc6c5060023062/ss_bb372fa132a9fb8b64e3d50adcfc6c5060023062.1920x1080.jpg?t=1771074411","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694350/bb372fa132a9fb8b64e3d50adcfc6c5060023062/ss_bb372fa132a9fb8b64e3d50adcfc6c5060023062.600x338.jpg?t=1771074411"}],"short_description":"Deliver, or take it back. An observation-based horror game where you process packages while watching for subtle irregularities in the same apartment building. No correct answers are given. What remains are your decisions\u2014and the recorded \u201cvariations.\u201d","steam_appid":3694350,"support_info":{"email":"sidelake529@gmail.com","url":""},"supported_languages":"English, Japanese","type":"game","website":null}