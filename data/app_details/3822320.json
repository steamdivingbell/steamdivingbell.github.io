steam/apps/3822320/b7be2fadba77381b73d44cf5c4d97f5049f6403b/ss_b7be2fadba77381b73d44cf5c4d97f5049f6403b.1920x1080.jpg?t=1770764269","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822320/b7be2fadba77381b73d44cf5c4d97f5049f6403b/ss_b7be2fadba77381b73d44cf5c4d97f5049f6403b.600x338.jpg?t=1770764269"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822320/03a8c87d0c9f6bc9dd50de046afebce47d1a37e2/ss_03a8c87d0c9f6bc9dd50de046afebce47d1a37e2.1920x1080.jpg?t=1770764269","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3822320/03a8c87d0c9f6bc9dd50de046afebce47d1a37e2/ss_03a8c87d0c9f6bc9dd50de046afebce47d1a37e2.600x338.jpg?t=1770764269"}],"short_description":"A cozy-horror adventure game where choices matter. Manage your resources each day to delve deeper into an eerie storybook forest. Gather items, aid the frightened denizens, and make it back to your cottage before your RESOLVE runs out.","steam_appid":3822320,"support_info":{"email":"cupdragongames@gmail.com","url":"https://www.cupdragongames.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}