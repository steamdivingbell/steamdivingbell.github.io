e9f204f28c27e388.webm?t=1773076562\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330110/extras/43c6d0de9610a557e9f204f28c27e388.mp4?t=1773076562\" type=\"video/mp4\"></video></span></p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Tech Tree:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >After each battle, you can choose upgrades for your empire through various branches, each with its own strategy. This will allow you to grow stronger to face increasingly powerful enemies.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330110/extras/955a5ca56daa69a540cc866f5aec8bb2.poster.avif?t=1773076562\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330110/extras/955a5ca56daa69a540cc866f5aec8bb2.webm?t=1773076562\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330110/extras/955a5ca56daa69a540cc866f5aec8bb2.mp4?t=1773076562\" type=\"video/mp4\"></video></span></p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Equip your units:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Obtain items in combat, explore hidden locations on the map, or complete special challenges to acquire them.</p></li><li><p class=\"bb_paragraph\" >These items will improve the stats of the unit that carries them.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330110/extras/c68aa4108d663d144acec7ef3fbadec1.poster.avif?t=1773076562\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3330110/extra