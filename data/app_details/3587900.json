/steam/apps/3587900/5a00b41271c1d8c462bcc3f9c89957f0adf0ca01/ss_5a00b41271c1d8c462bcc3f9c89957f0adf0ca01.600x338.jpg?t=1745135764"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/9981d49bbb77e8b0561d4831fd0111129a1062c2/ss_9981d49bbb77e8b0561d4831fd0111129a1062c2.1920x1080.jpg?t=1745135764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/9981d49bbb77e8b0561d4831fd0111129a1062c2/ss_9981d49bbb77e8b0561d4831fd0111129a1062c2.600x338.jpg?t=1745135764"}],"short_description":"spellloom is a roguelike bullet-hell dungeon crawler with deep spell-building. Play as a Spellweaver\u2014an intrepid QA tester employed by a cynical Dungeon Architect\u2014and brave his chaotic creation. Prepare for fierce Combat, creative Spell Crafting, and perilous Exploration in the ever-shifting Void.","steam_appid":3587900,"support_info":{"email":"bytejazzgames@gmail.com","url":""},"supported_languages":"English, German, Spanish - Spain, Japanese, Russian, Simplified Chinese, Spanish - Latin America, Korean","type":"game","website":null}