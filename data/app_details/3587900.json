full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/7ce2da9e485a24e5102957a966384ff0042d3a6b/ss_7ce2da9e485a24e5102957a966384ff0042d3a6b.1920x1080.jpg?t=1745135764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/7ce2da9e485a24e5102957a966384ff0042d3a6b/ss_7ce2da9e485a24e5102957a966384ff0042d3a6b.600x338.jpg?t=1745135764"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/7a365b1da16c431f41370090d94efa6ce7210d2e/ss_7a365b1da16c431f41370090d94efa6ce7210d2e.1920x1080.jpg?t=1745135764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/7a365b1da16c431f41370090d94efa6ce7210d2e/ss_7a365b1da16c431f41370090d94efa6ce7210d2e.600x338.jpg?t=1745135764"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/130068fa817c16a2ac44b95aaa60260780b32484/ss_130068fa817c16a2ac44b95aaa60260780b32484.1920x1080.jpg?t=1745135764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/130068fa817c16a2ac44b95aaa60260780b32484/ss_130068fa817c16a2ac44b95aaa60260780b32484.600x338.jpg?t=1745135764"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/2a25d4a13ed271fda3b8d09d9b8be22bc332c671/ss_2a25d4a13ed271fda3b8d09d9b8be22bc332c671.1920x1080.jpg?t=1745135764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/2a25d4a13ed271fda3b8d09d9b8be22bc332c671/ss_2a25d4a13ed271fda3b8d09d9b8be22bc332c671.600x338.jpg?t=1745135764"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/f9ef89c76c7d4a6a595bc9acd9f9434112084a35/ss_f9ef89c76c7d4a6a595bc9acd9f9434112084a35.1920x1080.jpg?t=1745135764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3587900/f9ef89c76c7d4a6a595bc9acd9f9434112084a35/ss_f9ef89c76c7