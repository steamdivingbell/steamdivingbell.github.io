a1f840387db1625a510d943ace6b.1920x1080.jpg?t=1772784932","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2696010/a22ca903752da1f840387db1625a510d943ace6b/ss_a22ca903752da1f840387db1625a510d943ace6b.600x338.jpg?t=1772784932"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2696010/3432d3e93da5d0698ec333faac686badf12527cf/ss_3432d3e93da5d0698ec333faac686badf12527cf.1920x1080.jpg?t=1772784932","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2696010/3432d3e93da5d0698ec333faac686badf12527cf/ss_3432d3e93da5d0698ec333faac686badf12527cf.600x338.jpg?t=1772784932"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2696010/79d2fa3bd79a0e34cd3b1f5f2a037aed580094f3/ss_79d2fa3bd79a0e34cd3b1f5f2a037aed580094f3.1920x1080.jpg?t=1772784932","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2696010/79d2fa3bd79a0e34cd3b1f5f2a037aed580094f3/ss_79d2fa3bd79a0e34cd3b1f5f2a037aed580094f3.600x338.jpg?t=1772784932"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2696010/d701bb4b82b93721e6287c0aa986e68f2559ed63/ss_d701bb4b82b93721e6287c0aa986e68f2559ed63.1920x1080.jpg?t=1772784932","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2696010/d701bb4b82b93721e6287c0aa986e68f2559ed63/ss_d701bb4b82b93721e6287c0aa986e68f2559ed63.600x338.jpg?t=1772784932"}],"short_description":"\u201cMiners in the Mountain\u201d is a pixel card RPG with Tarkov-like survival. Fight, loot, and build bases in collapsing mines. Failure will cost you everything\u2014food, components, crew members, all vanishes. Meet allies and foes, build your expedition squad deck, dig deeper, and find the Mountain's Heart.","steam_appid":2696010,"support_info":{"email":"wen6.zhang@gmail.com","url":""},"supported_languages":"Simplified Chinese","type":"game","website":null}