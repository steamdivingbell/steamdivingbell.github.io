fd41aedb.600x338.jpg?t=1726234756"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1528120/ss_cf26f46ed731652912f72d74d53ed512cfea7930.1920x1080.jpg?t=1726234756","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1528120/ss_cf26f46ed731652912f72d74d53ed512cfea7930.600x338.jpg?t=1726234756"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1528120/ss_91159bbbd101087717845259cf55339379baa086.1920x1080.jpg?t=1726234756","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1528120/ss_91159bbbd101087717845259cf55339379baa086.600x338.jpg?t=1726234756"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1528120/ss_976c0f5f94877a11c2b248faebcfe5c71f9f80e8.1920x1080.jpg?t=1726234756","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1528120/ss_976c0f5f94877a11c2b248faebcfe5c71f9f80e8.600x338.jpg?t=1726234756"}],"short_description":"Design increasingly complex computation units powered by high pressure steam. From switches to steam based computers, all in a world of analogue pressure devices. Use previous designs to solve further challenges, unravel the mystery of the missing steam and discover a new field of science.","steam_appid":1528120,"support_info":{"email":"compressure@brej.org","url":"https://discord.gg/7ZVZgA7gkS"},"supported_languages":"English, Simplified Chinese, French, German, Spanish - Spain, Czech, Japanese, Russian, Traditional Chinese","type":"game","website":"https://discord.gg/7ZVZgA7gkS"}