ddb2798e633d2db6abeb67fbc61d32190f30b4de.600x338.jpg?t=1760257399"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3114280/b524ea469737ad3075770643c697a813a83338c9/ss_b524ea469737ad3075770643c697a813a83338c9.1920x1080.jpg?t=1760257399","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3114280/b524ea469737ad3075770643c697a813a83338c9/ss_b524ea469737ad3075770643c697a813a83338c9.600x338.jpg?t=1760257399"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3114280/64b3fc92324275587c50e82db8f7f2eb517700fa/ss_64b3fc92324275587c50e82db8f7f2eb517700fa.1920x1080.jpg?t=1760257399","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3114280/64b3fc92324275587c50e82db8f7f2eb517700fa/ss_64b3fc92324275587c50e82db8f7f2eb517700fa.600x338.jpg?t=1760257399"}],"short_description":"Eternal ONE is a visual novel game of futuristic fantasy genre, learning about secret of the city while resolving various request of Lucio City.","steam_appid":3114280,"support_info":{"email":"hoondahl@hoondahl.com","url":"https://www.hoondahl.com"},"supported_languages":"English, Korean<strong>*</strong>, Japanese<br><strong>*</strong>languages with full audio support","type":"game","website":"http://www.hoondahl.net"}