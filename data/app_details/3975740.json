9re the ultimate offroad rider</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3975740/extras/3fd2f0f0eee3a2391b7401e691adb06c.poster.avif?t=1769835322\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3975740/extras/3fd2f0f0eee3a2391b7401e691adb06c.webm?t=1769835322\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3975740/extras/3fd2f0f0eee3a2391b7401e691adb06c.mp4?t=1769835322\" type=\"video/mp4\"></video></span> </p><p class=\"bb_paragraph\" ></p>","developers":["Nitx Games"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Racing","id":"9"},{"description":"Sports","id":"18"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3975740/9b3c655fc872a51e4ee2c33bab5bc757e46345a9/header.jpg?t=1769835322","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3975740/1645632079/59b315dbab8354fefeb3a3b5df810e2ba99d38b2/1762518304/dash_av1.mpd?t=1762521191","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3975740/1645632079/59b315dbab8354fefeb3a3b5df810e2ba99d38b2/1762518304/dash_h264.mpd?t=1762521191","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3975740/1645632079/59b315dbab8354fefeb3a3b5df810e2ba99d38b2/1762518304/hls_264_master.m3u8?t=1762521191","id":257228211,"name":"MX Racing World Rainy","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257228211/721e9c31cd4ed0eece72de4eb947920b6a4245e5/movie_600x337.jpg?t=1762521191"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3975740/906264139/f69fd25ccf60ba28b202999a0d9526d38