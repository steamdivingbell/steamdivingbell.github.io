ork pays off!</p>","developers":["Greekuda"],"fullgame":{"appid":"3836220","name":"LetDeco"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3956100/63fbd384cfb6b274d68b2b59dd612afad3b662f3/header.jpg?t=1756202180","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257183034,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257183034/movie480.mp4?t=1755672091","max":"http://video.akamai.steamstatic.com/store_trailers/257183034/movie_max.mp4?t=1755672091"},"name":"LetDeco_Demo_Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257183034/971be4156c38a95fb4a0ddab181b3633b6fe9a2f/movie_600x337.jpg?t=1755672091","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257183034/movie480_vp9.webm?t=1755672091","max":"http://video.akamai.steamstatic.com/store_trailers/257183034/movie_max_vp9.webm?t=1755672091"}}],"name":"LetDeco Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> 2.2Ghz or faster Dual Core<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> 2GB Dedicated VRAM<br></li><li><strong>DirectX:</strong> Version 9.0<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"},"