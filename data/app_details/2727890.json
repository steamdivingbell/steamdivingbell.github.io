bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Quests and intriguing characters to meet</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2727890/extras/76ca99c3151c6333cf8bc013a12fa7f1.poster.avif?t=1756647085\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2727890/extras/76ca99c3151c6333cf8bc013a12fa7f1.webm?t=1756647085\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2727890/extras/76ca99c3151c6333cf8bc013a12fa7f1.mp4?t=1756647085\" type=\"video/mp4\"></video></span>You'll engage with diverse NPCs and have the opportunity to undertake various side missions.</p>","developers":["Super Tiny Studios Ltd"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2727890/5f246c9cc4e06de6f0010bf896964371894ad41c/header.jpg?t=1756647085","is_free":false,"legal_notice":"2024 Super Tiny Studios Ltd.","linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257172707,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257172707/movie480.mp4?t=1753287423","max":"http://video.akamai.steamstatic.com/store_trailers/257172707/movie_max.mp4?t=1753287423"},"name":"Gameplay & Features","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257172707/e7591f10b5e93d03445cb12e0339719bb63728cc/movie_600x337.jpg?t=1753287423","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257172707/movie480_vp9.webm?t=1753287423","max":"http://video.akamai.steamstatic.com/store_trailers/257172707/movie_max_vp9.webm?t=1753287423"}}],"name":"Dr. Alb's Prodigy","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimu