n</p></li></ul><h2 class=\"bb_tag\" ><strong>Can your teamwork light up the dawn?</strong></h2>","developers":["Team KPT"],"fullgame":{"appid":"3852890","name":"Nightfall Survivor"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3887740/d8025e4e9c7e3c1ff183696c12ec4fee6ecdc674/header.jpg?t=1755017021","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257175068,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257175068/movie480.mp4?t=1755016971","max":"http://video.akamai.steamstatic.com/store_trailers/257175068/movie_max.mp4?t=1755016971"},"name":"TrailerInit","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257175068/f002db063a5a8200bbcf21b7223169d624bbd50a/movie_600x337.jpg?t=1755016971","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257175068/movie480_vp9.webm?t=1755016971","max":"http://video.akamai.steamstatic.com/store_trailers/257175068/movie_max_vp9.webm?t=1755016971"}}],"name":"Nightfall Survivor Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 11<br></li><li><strong>Processor:</strong> Intel Core i5 4570<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> nVidia GTX 1050<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 3 GB available space<b