_assets/steam/apps/3056780/extras/faaa4f85fd709f81fec0c90d7cfabb05.mp4?t=1773087851\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Destructible Maps</h2><p class=\"bb_paragraph\" >All maps are physically simulated. Use your grenades to topple card castles and domino structures to corner or smoke out your opponents.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3056780/extras/c98b7f5415264ff3a2234bd0f47d755d.poster.avif?t=1773087851\" width=384 height=216 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3056780/extras/c98b7f5415264ff3a2234bd0f47d755d.webm?t=1773087851\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3056780/extras/c98b7f5415264ff3a2234bd0f47d755d.mp4?t=1773087851\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ></h2><h2 class=\"bb_tag\" >Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Private or public lobbies up to 6 players</p></li><li><p class=\"bb_paragraph\" >5 destructible maps and 4 background environments</p></li><li><p class=\"bb_paragraph\" >Card and table skins</p></li><li><p class=\"bb_paragraph\" >Alternative and customizable decks</p></li><li><p class=\"bb_paragraph\" >Hand cheat sheet for players new to poker</p></li><li><p class=\"bb_paragraph\" >Poker-only mode</p></li></ul>","developers":["Squires Systems"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3056780/568c0320937e5e113085eafc85829fa5f7a8252f/header.jpg?t=1773087851","is_free":false,"legal_notice":"copyright Squires Systems 2025","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_