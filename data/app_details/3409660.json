/apps/3409660/60f803c0b77a1c54323968071948c7789345f7dd/ss_60f803c0b77a1c54323968071948c7789345f7dd.600x338.jpg?t=1770797326"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3409660/5c3717ed36868f6a6b7173fc39da5863896c1f1d/ss_5c3717ed36868f6a6b7173fc39da5863896c1f1d.1920x1080.jpg?t=1770797326","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3409660/5c3717ed36868f6a6b7173fc39da5863896c1f1d/ss_5c3717ed36868f6a6b7173fc39da5863896c1f1d.600x338.jpg?t=1770797326"}],"short_description":"A dark arcade puzzle game where a Spinning Scarecrow faces deadly traps, grotesque minigames, and precision challenges in a fully hand-drawn world. Ready to spin?","steam_appid":3409660,"support_info":{"email":"ivan@ivproductions.it","url":"www.ivproductions.it"},"supported_languages":"English, Italian, French, German, Spanish - Spain, Simplified Chinese, Traditional Chinese, Japanese, Russian","type":"game","website":"https://power-up-team.com/spinning-scarecrow/"}