ps/2224120/extras/34867f35d46fa55d8ce48f4766163c5f.poster.avif?t=1763582130\" width=620 height=224 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2224120/extras/34867f35d46fa55d8ce48f4766163c5f.webm?t=1763582130\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2224120/extras/34867f35d46fa55d8ce48f4766163c5f.mp4?t=1763582130\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Build your Ship</h2><p class=\"bb_paragraph\" >Plow your way through a sea of zombies by equipping and upgrading ship parts and turrets.  Collect and unlock powerful upgrades that drastically alter the way you survive.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2224120/extras/f746777799642739fe0294fd3e8da862.poster.avif?t=1763582130\" width=620 height=224 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2224120/extras/f746777799642739fe0294fd3e8da862.webm?t=1763582130\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2224120/extras/f746777799642739fe0294fd3e8da862.mp4?t=1763582130\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Command your crew</h2><p class=\"bb_paragraph\" >Manage, rescue, and hire crew members with unique skills and abilities. Every role is important for the survival of the ship and assigning the right crew member with the right talents is key to survival.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2224120/extras/6cc77f853ea0d0228b910d5ad3758efe.poster.avif?t=1763582130\" width=620 height=224 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/ap