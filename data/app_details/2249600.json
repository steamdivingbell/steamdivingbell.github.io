=292 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2249600/extras/3ca90a16cf68570f33f23adcbc2e50c5.webm?t=1759190772\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2249600/extras/3ca90a16cf68570f33f23adcbc2e50c5.mp4?t=1759190772\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Daily rewards:</strong> Just log into the game and claim your prize.</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Blitz and Sprint:</strong> Complete daily missions that will earn you lots of in-game currency and experience.</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Scrapyard:</strong> Are you an experienced racer and know your cars? Then complete tasks collecting cars for the mechanic and earn reputation.</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Marketplace:</strong> Freely set any prices for your items, and buyers can bargain.</p></li></ul>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/2249600?t=1759190772","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2249600/page_bg_raw.jpg?t=1759190772","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2249600/00cce72488426c8ec815e12555db3f79b0af65e4/capsule_231x87.jpg?t=1759190772","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2249600/00cce72488426c8ec815e12555db3f79b0af65e4/capsule_184x69.jpg?t=1759190772","categories":[{"description":"Single-player","id":2},{"description":"Multi-player","id":1},{"description":"PvP","id":49},{"description":"Online PvP","id":36},{"description":"Co-op","id":9},{"description":"Online Co-op","id":38},{"description":"Cross-Platform Multiplayer","id":27},{"description":"In-App Purchases","id":35}],"content_descriptors":{"ids":[],"notes":null