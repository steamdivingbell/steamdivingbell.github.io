b897e8c322b9562.1920x1080.jpg?t=1760142003","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4085050/703e490a6fab0a74f6fbef649b897e8c322b9562/ss_703e490a6fab0a74f6fbef649b897e8c322b9562.600x338.jpg?t=1760142003"}],"short_description":"Jump of Icarus is a punishing 2D precision platformer where Greek mythology collides with absurd comedy and unsettling psychological horror. Survive impossible jumps, endure the gods\u2019 mockery, and descend into madness as you climb toward the sun.","steam_appid":4085050,"support_info":{"email":"23milstudio@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}