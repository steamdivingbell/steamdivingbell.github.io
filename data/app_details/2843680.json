9e7/ss_2bc7fa738c01336ecbcef1b11e62375f574419e7.1920x1080.jpg?t=1772527193","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2843680/2bc7fa738c01336ecbcef1b11e62375f574419e7/ss_2bc7fa738c01336ecbcef1b11e62375f574419e7.600x338.jpg?t=1772527193"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2843680/e191fdab2fe3446ceed7c9ee03d3b9e3a335626f/ss_e191fdab2fe3446ceed7c9ee03d3b9e3a335626f.1920x1080.jpg?t=1772527193","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2843680/e191fdab2fe3446ceed7c9ee03d3b9e3a335626f/ss_e191fdab2fe3446ceed7c9ee03d3b9e3a335626f.600x338.jpg?t=1772527193"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2843680/c66656cd998bad8368cc8c3e9e0fe2ad5bb34c9f/ss_c66656cd998bad8368cc8c3e9e0fe2ad5bb34c9f.1920x1080.jpg?t=1772527193","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2843680/c66656cd998bad8368cc8c3e9e0fe2ad5bb34c9f/ss_c66656cd998bad8368cc8c3e9e0fe2ad5bb34c9f.600x338.jpg?t=1772527193"}],"short_description":"Fight the nightmares of the city! Master a blend of third-person shooting, magic, and bullet hell to survive the fast-paced, ever-changing chaos that grips the streets. Change classes during combat, enter Bononia, and face your destiny.","steam_appid":2843680,"support_info":{"email":"info@power-up.team.com","url":""},"supported_languages":"English, Italian, Spanish - Spain, Simplified Chinese, Korean, Portuguese - Brazil, French, German","type":"game","website":"https://power-up-team.com/vespera-bononia/"}