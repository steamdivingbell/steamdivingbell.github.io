8c2368.600x338.jpg?t=1738358047"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2843680/ss_8c0566f56bf7870d45c22d721d812b4bfc6db52d.1920x1080.jpg?t=1738358047","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2843680/ss_8c0566f56bf7870d45c22d721d812b4bfc6db52d.600x338.jpg?t=1738358047"}],"short_description":"Vespera Bononia is a fast-paced action-roguelite set in an ever-changing city. Fight as nightmares come to life and switch classes as a shifting soul. Master a mix of third-person shooter, magic and bullet hell to survive.","steam_appid":2843680,"support_info":{"email":"info@power-up.team.com","url":""},"supported_languages":"English, Italian, Spanish - Spain, Simplified Chinese, Korean, Portuguese - Brazil","type":"game","website":"https://power-up-team.com/vespera-bononia/"}