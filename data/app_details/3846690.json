.jpg?t=1774601846"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846690/43ac070246e0a1b3e45b97151f968f00977afb69/ss_43ac070246e0a1b3e45b97151f968f00977afb69.1920x1080.jpg?t=1774601846","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846690/43ac070246e0a1b3e45b97151f968f00977afb69/ss_43ac070246e0a1b3e45b97151f968f00977afb69.600x338.jpg?t=1774601846"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846690/fc7d81262f6d7c37aaaa664da366ee9e470dbd4c/ss_fc7d81262f6d7c37aaaa664da366ee9e470dbd4c.1920x1080.jpg?t=1774601846","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846690/fc7d81262f6d7c37aaaa664da366ee9e470dbd4c/ss_fc7d81262f6d7c37aaaa664da366ee9e470dbd4c.600x338.jpg?t=1774601846"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846690/9c860b501a05b81b330e1787de1c4cb9bb606dd3/ss_9c860b501a05b81b330e1787de1c4cb9bb606dd3.1920x1080.jpg?t=1774601846","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3846690/9c860b501a05b81b330e1787de1c4cb9bb606dd3/ss_9c860b501a05b81b330e1787de1c4cb9bb606dd3.600x338.jpg?t=1774601846"}],"short_description":"Contact Protocol is a starship job simulator. When passing other ships on the way to Jupiter, you\u2019ll check their details against company records and facilitate safe passage, but be wary - there are corporate competitors, smugglers, and more in the space lanes\u2026","steam_appid":3846690,"support_info":{"email":"contactprotocolgame@gmail.com","url":""},"supported_languages":"English","type":"game","website":"http://coldzephyr.co.uk/"}