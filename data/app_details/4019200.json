19200/d2b41479478aab9651e9b3a2657e325daf955199/ss_d2b41479478aab9651e9b3a2657e325daf955199.600x338.jpg?t=1758049342"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4019200/2d0ce6b67e78ddea700e65a8495733879cb7a5e8/ss_2d0ce6b67e78ddea700e65a8495733879cb7a5e8.1920x1080.jpg?t=1758049342","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4019200/2d0ce6b67e78ddea700e65a8495733879cb7a5e8/ss_2d0ce6b67e78ddea700e65a8495733879cb7a5e8.600x338.jpg?t=1758049342"}],"short_description":"Graveyard Simulator is a simulation game focused on strategy, design, and moral choices as you transform an abandoned cemetery into a prestigious memorial site. Take on daily graveyard tasks and delve deep into humanity\u2019s relationship with death.","steam_appid":4019200,"support_info":{"email":"info@hollowcrowgames.com","url":"www.hollowcrowgames.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":null}