:"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/682c24abeabfa5c201b571aff1063a2f5d8d18f1/ss_682c24abeabfa5c201b571aff1063a2f5d8d18f1.1920x1080.jpg?t=1761349739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/682c24abeabfa5c201b571aff1063a2f5d8d18f1/ss_682c24abeabfa5c201b571aff1063a2f5d8d18f1.600x338.jpg?t=1761349739"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/9cf2b48bf63c9a2b8c9d9973b701232088045ba7/ss_9cf2b48bf63c9a2b8c9d9973b701232088045ba7.1920x1080.jpg?t=1761349739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/9cf2b48bf63c9a2b8c9d9973b701232088045ba7/ss_9cf2b48bf63c9a2b8c9d9973b701232088045ba7.600x338.jpg?t=1761349739"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/8ab4bf4601abe72b99fd84a521d7268befae4de9/ss_8ab4bf4601abe72b99fd84a521d7268befae4de9.1920x1080.jpg?t=1761349739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/8ab4bf4601abe72b99fd84a521d7268befae4de9/ss_8ab4bf4601abe72b99fd84a521d7268befae4de9.600x338.jpg?t=1761349739"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/38955ba2b1eb77e29432bb58c00c4311ff9e333c/ss_38955ba2b1eb77e29432bb58c00c4311ff9e333c.1920x1080.jpg?t=1761349739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/38955ba2b1eb77e29432bb58c00c4311ff9e333c/ss_38955ba2b1eb77e29432bb58c00c4311ff9e333c.600x338.jpg?t=1761349739"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/4305d1c4ae89e9d56eca4e6b601925b96d1bf92a/ss_4305d1c4ae89e9d56eca4e6b601925b96d1bf92a.1920x1080.jpg?t=1761349739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/4305d1c4ae89e9d56eca4e6b601925b96d1bf92a/ss_4305d1c4ae89e9d56eca4e6b601925b96d1bf92a.600x338.jpg?t=1761349739"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/19fbbc9351b6c4b29bd99a7637b84f576502b3f6/ss_19fbbc9351b6c4b29bd99a7637b84f576502b3f6.1920x1080.jpg?t=1761349739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/391670/19fbbc9351b6c4b29bd99a7637b84f576502b3f6/ss_19fbbc9351b6c4b29bd99a7637b84f576502b3f6.600x338.jpg?t=1761349739"}],"short_description":"An unforgettable journey of discovery, hope, and survival, as you strive to unlock the secrets of the universe and pave the way for humanity's destiny. By intertwining Exploration, Adaptive Gameplay, and Survival, ETERNITY offers a rich and immersive experience.","steam_appid":391670,"support_info":{"email":"http://info@gfiredrake.games/","url":"https://www.firedrake.games/contacts.html"},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Portuguese - Portugal, Simplified Chinese, Spanish - Latin America<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.firedrake.games/Eternity.html"}