oes reward attention.</p>","developers":["GhostRZZR"],"genres":[{"description":"Casual","id":"4"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4068780/cf8ee96ded3b49662be6a8837d9a3e1744228c20/header.jpg?t=1767588512","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> Intel\u00a0Core\u00a0i5\u20116600K / AMD\u00a0Ryzen\u00a03\u00a01200 or better<br></li><li><strong>Memory:</strong> 16 GB RAM</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> Intel\u00a0Core\u00a0i7\u20119750K / AMD Ryzen 9 9950X or better<br></li><li><strong>Memory:</strong> 16 GB RAM</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4068780/1609715879/bd8e2e17cc21f2fb26998e0ac76ba758635faeb1/1767327290/dash_av1.mpd?t=1767328875","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4068780/1609715879/bd8e2e17cc21f2fb26998e0ac76ba758635faeb1/1767327290/dash_h264.mpd?t=1767328875","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4068780/1609715879/bd8e2e17cc21f2fb26998e0ac76ba758635faeb1/1767327290/hls_264_master.m3u8?t=1767328875","id":257258049,"name":"Trailer Demo 2","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257258049/098d843ea7817b2983fd07a60624ac3a6654861e/movie_600x337.jpg?t=1767328875"}],"name":"The Neeblarium","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"The Neeblarium - $9.99 USD","packa