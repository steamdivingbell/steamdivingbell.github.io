6fcca.1920x1080.jpg?t=1767588512","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4068780/09bdedd2db127e17d8dd42d7970914658256fcca/ss_09bdedd2db127e17d8dd42d7970914658256fcca.600x338.jpg?t=1767588512"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4068780/a55d821183b29dc7a2c9cb58933c41a4fd243e5b/ss_a55d821183b29dc7a2c9cb58933c41a4fd243e5b.1920x1080.jpg?t=1767588512","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4068780/a55d821183b29dc7a2c9cb58933c41a4fd243e5b/ss_a55d821183b29dc7a2c9cb58933c41a4fd243e5b.600x338.jpg?t=1767588512"}],"short_description":"A calm artificial life simulation about cultivating tiny digital creatures and watching evolution unfold. You shape environments. Nature does the rest. Over time, families form. Lineages diverge. Rare traits appear. Some discoveries are fleeting. Others are worth saving.","steam_appid":4068780,"support_info":{"email":"help@neeblarium.com","url":"httpss://neeblarium.com"},"supported_languages":"English","type":"game","website":"https://neeblarium.com"}