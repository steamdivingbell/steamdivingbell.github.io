aline into your every step.</p></li></ul>","developers":["PopCorn Bunker"],"dlc":[3967900],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3341150/c147a106f7f167a1eb791bccfe0f199c65250bb3/header.jpg?t=1771046387","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3341150/57364537/09cf5c6cfa3076e59f3884cda1880d7ba971b609/1756235438/dash_av1.mpd?t=1756237463","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3341150/57364537/09cf5c6cfa3076e59f3884cda1880d7ba971b609/1756235438/dash_h264.mpd?t=1756237463","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3341150/57364537/09cf5c6cfa3076e59f3884cda1880d7ba971b609/1756235438/hls_264_master.m3u8?t=1756237463","id":257189286,"name":"The Last Prisoner | Release Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257189286/36bbaff7a32968e682d017220dc8a97c31b9cdf2/movie_600x337.jpg?t=1756237463"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3341150/806373/3ac2a1d0657fcbc92762dddef43d7cafbea0b389/1750841755/dash_av1.mpd?t=1735691878","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3341150/806373/3ac2a1d0657fcbc92762dddef43d7cafbea0b389/1750841755/dash_h264.mpd?t=1735691878","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3341150/806373/3ac2a1d0657fcbc92762dddef43d7cafbea0b389/1750841755/hls_264_master.m3u8?t=1735691878","id":257085781,"name":"The Last Prisoner | Announcement trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257085781/73a68ed262bfffb2743917f182efaf5f36162cb9/movie_600x337.jpg?t=1735691878"}],"name":"The Last Prisoner","package_groups":[{"description":"","display_type":0,"is_recurring_subscri