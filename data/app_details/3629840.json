re_item_assets/steam/apps/3629840/9daa08bf53bb6002b365c9cd70f5ac1d0e11af89/ss_9daa08bf53bb6002b365c9cd70f5ac1d0e11af89.1920x1080.jpg?t=1762810807","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629840/9daa08bf53bb6002b365c9cd70f5ac1d0e11af89/ss_9daa08bf53bb6002b365c9cd70f5ac1d0e11af89.600x338.jpg?t=1762810807"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629840/d9995e91fca94b9998a974e43c8e5b823ab41812/ss_d9995e91fca94b9998a974e43c8e5b823ab41812.1920x1080.jpg?t=1762810807","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629840/d9995e91fca94b9998a974e43c8e5b823ab41812/ss_d9995e91fca94b9998a974e43c8e5b823ab41812.600x338.jpg?t=1762810807"}],"short_description":"Ever played a difficult shmup wishing for just one more bomb? Blast to your heart\u2019s content in Blast Rush LS, a fresh explosive experience with infinite bombs, other powerful abilities, and extra challenges that demand more than just big booms. Escaping an exploding mothership isn't easy, after all!","steam_appid":3629840,"support_info":{"email":"support@indie.io","url":""},"supported_languages":"English","type":"game","website":"https://bipedal.dog/"}