d8e1c06.1920x1080.jpg?t=1760797959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4060780/53738d5ab4c334eda495fdbd7d659f02dd8e1c06/ss_53738d5ab4c334eda495fdbd7d659f02dd8e1c06.600x338.jpg?t=1760797959"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4060780/2a2e61cd748975cb7068e7dd0cbd35d7da5c2e2b/ss_2a2e61cd748975cb7068e7dd0cbd35d7da5c2e2b.1920x1080.jpg?t=1760797959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4060780/2a2e61cd748975cb7068e7dd0cbd35d7da5c2e2b/ss_2a2e61cd748975cb7068e7dd0cbd35d7da5c2e2b.600x338.jpg?t=1760797959"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4060780/937f10fdaa26eb1cbfca2672e6a541a2ce37dde8/ss_937f10fdaa26eb1cbfca2672e6a541a2ce37dde8.1920x1080.jpg?t=1760797959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4060780/937f10fdaa26eb1cbfca2672e6a541a2ce37dde8/ss_937f10fdaa26eb1cbfca2672e6a541a2ce37dde8.600x338.jpg?t=1760797959"}],"short_description":"Your house is gone, the surface swarms with monsters, and the only refuge is underground. Luckily, you\u2019re a pigeon with a forge. Peck into the depths and craft gear adventurers probably shouldn\u2019t trust. An idle adventure you can run in the corner of your screen while you pretend to work.","steam_appid":4060780,"support_info":{"email":"humblebrightstudio@gmail.com","url":"https://humblebright.net"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://humblebright.net/project/peckers"}