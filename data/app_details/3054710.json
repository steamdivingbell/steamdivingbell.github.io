1743943879"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3054710/47979db5b031a5da993d0eb21fe2402ac7c0e34e/ss_47979db5b031a5da993d0eb21fe2402ac7c0e34e.1920x1080.jpg?t=1743943879","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3054710/47979db5b031a5da993d0eb21fe2402ac7c0e34e/ss_47979db5b031a5da993d0eb21fe2402ac7c0e34e.600x338.jpg?t=1743943879"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3054710/c8493e7da752be1ef482149d5a49f75100508976/ss_c8493e7da752be1ef482149d5a49f75100508976.1920x1080.jpg?t=1743943879","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3054710/c8493e7da752be1ef482149d5a49f75100508976/ss_c8493e7da752be1ef482149d5a49f75100508976.600x338.jpg?t=1743943879"}],"short_description":"An ultimate high-end 3D tree simulator. Find out what it's like to be a tree and enjoy all the benefits of being a part of nature. In this simulator many possibilities are waiting for you to finally be a tree, you will be able to control every aspect. A treemendous adventure awaits you.","steam_appid":3054710,"support_info":{"email":"revampiteration@outlook.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Portuguese - Brazil, Bulgarian, Finnish, Indonesian, Japanese, Dutch, Norwegian, Polish, Portuguese - Portugal, Romanian, Russian, Swedish, Czech, Turkish, Ukrainian, Hungarian, Korean, Simplified Chinese","type":"game","website":null}