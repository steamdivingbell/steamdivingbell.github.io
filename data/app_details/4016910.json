ai.steamstatic.com/store_item_assets/steam/apps/4016910/dc61fb94629f9e9f473e0a93628404eadd9edb75/ss_dc61fb94629f9e9f473e0a93628404eadd9edb75.600x338.jpg?t=1759212254"}],"short_description":"A quest driven single-player adventure game set in mid-\u201990s urban South Asia about two best friends who love tinkering with toys and gadgets. Their friendship is tested when one of them has to move away, and it becomes a race against time to build a radio tower to stay in touch.","steam_appid":4016910,"support_info":{"email":"hello@auleek.com","url":""},"supported_languages":"English","type":"game","website":"https://auleek.com/over-and-out/"}