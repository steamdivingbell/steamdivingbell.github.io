.600x338.jpg?t=1772155901"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3077540/ss_a4b36e578bbc8ae22cbdc857ce0d1db6cfc1ae9e.1920x1080.jpg?t=1772155901","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3077540/ss_a4b36e578bbc8ae22cbdc857ce0d1db6cfc1ae9e.600x338.jpg?t=1772155901"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3077540/ss_94a0ade0aed0e2e9ec7b50687d8b17d8a6091fa9.1920x1080.jpg?t=1772155901","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3077540/ss_94a0ade0aed0e2e9ec7b50687d8b17d8a6091fa9.600x338.jpg?t=1772155901"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3077540/ss_b74d60ee95b5059cf45561b41f55507d10f5f383.1920x1080.jpg?t=1772155901","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3077540/ss_b74d60ee95b5059cf45561b41f55507d10f5f383.600x338.jpg?t=1772155901"}],"short_description":"An FMV interactive romantic comedy where your choices and timing shape the night. Try to impress Ay\u015fil at the bar and navigate a branching story that can lead to love\u2026 or total chaos.","steam_appid":3077540,"support_info":{"email":"support@snrinteractive.com","url":"https://snrinteractive.com/"},"supported_languages":"English<strong>*</strong>, French<strong>*</strong>, German<strong>*</strong>, Spanish - Spain<strong>*</strong>, Arabic<strong>*</strong>, Japanese<strong>*</strong>, Korean<strong>*</strong>, Russian<strong>*</strong>, Simplified Chinese<strong>*</strong>, Portuguese - Brazil<strong>*</strong>, Spanish - Latin America<strong>*</strong>, Turkish<strong>*</strong>, Italian, Bulgarian, Czech, Danish, Dutch, Finnish, Greek, Hungarian, Indonesian, Norwegian, Polish, Portuguese - Portugal, Romanian, Swedish, Thai, Traditional Chinese, Ukrainian, Vietnamese<br><strong>*</strong>languages with full audio support","type":"g