om/store_item_assets/steam/apps/3562630/da9d21553c8faa2f337f5ce4aa5df11277a12182/ss_da9d21553c8faa2f337f5ce4aa5df11277a12182.1920x1080.jpg?t=1773055804","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3562630/da9d21553c8faa2f337f5ce4aa5df11277a12182/ss_da9d21553c8faa2f337f5ce4aa5df11277a12182.600x338.jpg?t=1773055804"}],"short_description":"A 2D puzzle-platformer where you use your powers to place bubbles that launch you through the air to avoid hazards and reach new depths. You play a mushroom bubblemancer, on a journey through dangerous caves and ruins to save your village, in this punchy and kinetic platformer.","steam_appid":3562630,"support_info":{"email":"general@skypyre.com","url":"https://www.skypyre.com"},"supported_languages":"English, French, Spanish - Spain","type":"game","website":"https://www.skypyre.com/mushroam"}