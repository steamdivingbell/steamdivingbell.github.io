laysinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3837870/extras/aaa3d4f4006f27161da8c8b77ba2a692.poster.avif?t=1753900443\" aria-label=\"A duel among pirates. But who killed who and why?\" width=616 height=272 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3837870/extras/aaa3d4f4006f27161da8c8b77ba2a692.webm?t=1753900443\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3837870/extras/aaa3d4f4006f27161da8c8b77ba2a692.mp4?t=1753900443\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>KEY FEATURES</strong>\u00a0</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Prophetic Detective Puzzles:</strong> Solve murders through your visions.\u00a0\u00a0</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Interactive Murder Investigation:</strong> Inspect suspects, examine evidence, and read documents.\u00a0\u00a0</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Logical Deduction:</strong> Piece together the case from the clues to figure out what happened.\u00a0</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Dark Fantasy Underworld:</strong> Explore the subterranean world of scheming elves, ancient secrets, and forbidden magic.\u00a0</p></li></ul>","developers":["Meridian Malice"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3837870/c6dd43bc055f70b945032072f9931bc10a003579/header.jpg?t=1753900443","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3837870/2026459709/055dffa76e53484293ae5738bcd25c9a9df97423/1753449553/dash_av1.mpd?t=1753900442","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3837870/2026459709/055dffa76e534