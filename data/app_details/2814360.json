steamstatic.com/store_item_assets/steam/apps/2814360/extras/b932045b7ef19240d4f15771ec737f6f.poster.avif?t=1759434770\" width=800 height=332 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2814360/extras/b932045b7ef19240d4f15771ec737f6f.webm?t=1759434770\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2814360/extras/b932045b7ef19240d4f15771ec737f6f.mp4?t=1759434770\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>\u2726 CORE GAME FEATURES \u2726</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Supports Single Player and Online Co-Op (up to 4 players)</p></li><li><p class=\"bb_paragraph\" >Strategize and adapt in &quot;Tower Defense x Survival x Bullet Heaven&quot;</p></li><li><p class=\"bb_paragraph\" >Progress through the campaign to meet and unlock new alchemists</p></li><li><p class=\"bb_paragraph\" >Enjoy refreshing gameplay each run with roguelike meta progression</p></li><li><p class=\"bb_paragraph\" >Explore gorgeous worlds, combining hand-drawn and animated 2D and immersive 3D styles</p></li></ul>","developers":["Edenic Era LLC"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2814360/42211c7b4bf6d314dcf3f91467eb72a4d600eb3b/header.jpg?t=1759434770","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2814360/1823420857/809475f372cfde3aff698b9d1f4fb7a405