,{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4121650/95ec6bd1f7a8ca741ae7bab7f94d8691a43e18a8/ss_95ec6bd1f7a8ca741ae7bab7f94d8691a43e18a8.1920x1080.jpg?t=1769063752","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4121650/95ec6bd1f7a8ca741ae7bab7f94d8691a43e18a8/ss_95ec6bd1f7a8ca741ae7bab7f94d8691a43e18a8.600x338.jpg?t=1769063752"}],"short_description":"Explore the tombs beneath Egypt\u2019s desert in a first-person survival horror. Hide from the horrors that stalk the dark, scavenge and craft to progress, and manage your light, tools, and scarce supplies to stay alive.","steam_appid":4121650,"support_info":{"email":"contact@timebreakstudios.com","url":"https://www.timebreakstudios.com/"},"supported_languages":"English<strong>*</strong>, French<strong>*</strong>, Italian<strong>*</strong>, German<strong>*</strong>, Spanish - Spain<strong>*</strong>, Japanese<strong>*</strong>, Korean<strong>*</strong>, Russian<strong>*</strong>, Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}