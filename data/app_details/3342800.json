:"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3342800/479976c55bacf8d8afaae675f8326a9c41dbc7ac/ss_479976c55bacf8d8afaae675f8326a9c41dbc7ac.1920x1080.jpg?t=1744863350","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3342800/479976c55bacf8d8afaae675f8326a9c41dbc7ac/ss_479976c55bacf8d8afaae675f8326a9c41dbc7ac.600x338.jpg?t=1744863350"}],"short_description":"Become a ghostwriter and write on the behalf of others--everything from love letters to apologies! There's just one catch in this crazy adventure game: the most important words in your writings are decided by roulette.","steam_appid":3342800,"support_info":{"email":"support@wakuwakugames.com","url":""},"supported_languages":"Japanese","type":"game","website":null}