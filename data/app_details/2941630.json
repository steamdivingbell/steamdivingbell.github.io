es for your dungeon runs.\u00a0<br><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941630/extras/Build_HeaderDnDT.gif?t=1740105600\" /></p><p class=\"bb_paragraph\">Uncover a story about kindness, compassion and community by helping each of the townsfolk with their fear and insecurities and doing battle with their alter egos.\u00a0</p><p class=\"bb_paragraph\">Learn about the <strong>Town of Kindlerest, </strong>an old tailor named Percy, his adventuring buddies, and a spiky villain who really just needs a hug!\u00a0</p><h2 class=\"bb_tag\">Your perfect home is just a dungeon away!</h2><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941630/extras/AwakenAxolotl.png?t=1740105600\" /></p>","developers":["Catalyst Games Pty Ltd"],"genres":[{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941630/header.jpg?t=1740105600","is_free":false,"legal_notice":"\u00a9 Catalyst Games - All Rights Reserved","linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257060576,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257060576/movie480.mp4?t=1730106949","max":"http://video.akamai.steamstatic.com/store_trailers/257060576/movie_max.mp4?t=1730106949"},"name":"Gameplay Trailer | Dungeons and Dining Tables","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257060576/46a72e953e2314330b89d28567c3756a16158fde/movie_600x337.jpg?t=1730106949","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257060576/movie480_vp9.webm?t=1730106949","max":"http://video.akamai.steamstatic.com/store_trailers/257060576/movie_max_vp9.webm?t=1730106949"}}],"name":"Dungeons and Dining Tables","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><