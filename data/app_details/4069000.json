:4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4069000/528bb8fede5db84fad4995f03f9dfe124c515851/ss_528bb8fede5db84fad4995f03f9dfe124c515851.1920x1080.jpg?t=1772563762","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4069000/528bb8fede5db84fad4995f03f9dfe124c515851/ss_528bb8fede5db84fad4995f03f9dfe124c515851.600x338.jpg?t=1772563762"}],"short_description":"A solo-developed (by a non-technical designer using AI) fusion of merge mechanics, simulation management, and roguelike deck-building. Your goal: survive as long as possible through strategic piece placement, card synergy, and map exploration.","steam_appid":4069000,"support_info":{"email":"619292293@qq.com","url":""},"supported_languages":"English, Simplified Chinese","type":"game","website":null}