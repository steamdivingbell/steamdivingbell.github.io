{"about_the_game":"<p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1965380/extras/Store_Banner.png?t=1733951836\" /></p><p class=\"bb_paragraph\">Crazy Tanks is a Free to play game, Inspired from old schools tank games where you fight in a Free For all Round with up to 10 players to see who is the best one.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">In Crazy Tanks Bullets Bounce of walls, maps have movable crates, and there are Heal and shield Power-Ups.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">You can also Customize your Tank and Bullets with several skin that you can get just by playing.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Feedback is always welcome! Come have fun! </p>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/1965380?t=1733951836","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1965380/page_bg_raw.jpg?t=1733951836","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1965380/ee8e0969d7c09f63d78412549914e9bde5f630fa/capsule_231x87.jpg?t=1733951836","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1965380/ee8e0969d7c09f63d78412549914e9bde5f630fa/capsule_184x69.jpg?t=1733951836","categories":[{"description":"Multi-player","id":1},{"description":"PvP","id":49},{"description":"Online PvP","id":36},{"description":"Co-op","id":9},{"description":"Online Co-op","id":38},{"description":"Steam Achievements","id":22},{"description":"In-App Purchases","id":35},{"description":"Stats","id":15}],"content_descriptors":{"ids":[],"notes":null},"detailed_description":"<p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1965380/extras/Store_Banner.png?t=1733951836\" /></p><p class=\"bb_paragraph\">Crazy Tanks is a Free to play game, Inspired from old schools tank games where you fight in a Free For all Round with up to 10 players to see who is the best one.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">In Crazy Tanks Bullets Bounce of walls, maps have movable crates, and there are Heal and shield Power-Ups.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">You can also Customize your Tank and Bullets with several skin that you can get just by playing.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Feedback is always welcome! Come have fun! </p>","developers":["Studio Gygax"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1965380/header.jpg?t=1733951836","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 16.04+</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 10.12+</li></ul>"},"name":"Crazy Tanks","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> I3<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> 360 gtx<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"},"platforms":{"linux":true,"mac":false,"windows":true},"publishers":["Studio Gygax"],"ratings":{"dejus":{"descriptors":"Viol\u00eancia fantasiosa","rating":"l"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Coming soon"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1965380/ss_af4c84a45086d35adb86fe78