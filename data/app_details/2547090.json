0/a99248e47f173af4ad2f1d777d69bbddc0e28280/ss_a99248e47f173af4ad2f1d777d69bbddc0e28280.600x338.jpg?t=1758912712"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2547090/51129e0b5383349c0704c19de49fc67d9430047a/ss_51129e0b5383349c0704c19de49fc67d9430047a.1920x1080.jpg?t=1758912712","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2547090/51129e0b5383349c0704c19de49fc67d9430047a/ss_51129e0b5383349c0704c19de49fc67d9430047a.600x338.jpg?t=1758912712"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2547090/4a93ecbdc5923e7d2608232db139093df9d37b38/ss_4a93ecbdc5923e7d2608232db139093df9d37b38.1920x1080.jpg?t=1758912712","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2547090/4a93ecbdc5923e7d2608232db139093df9d37b38/ss_4a93ecbdc5923e7d2608232db139093df9d37b38.600x338.jpg?t=1758912712"}],"short_description":"The political drama set in a future that's too close for comfort. Become the first mayor of ARTEMIS: A Pioneering Lunar City. Navigate the future of lunar colonization, choose between independence and cooperation, shape policies for or against AI influence, and tackle interplanetary conspiracies.","steam_appid":2547090,"support_info":{"email":"novruzj@darts-games.com","url":""},"supported_languages":"English","type":"game","website":null}