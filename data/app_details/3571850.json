ss_c79e1aff8a5a6a2293ba20cdbf88f3e4fce3767a.1920x1080.jpg?t=1769690110","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3571850/c79e1aff8a5a6a2293ba20cdbf88f3e4fce3767a/ss_c79e1aff8a5a6a2293ba20cdbf88f3e4fce3767a.600x338.jpg?t=1769690110"}],"short_description":"Explore and discover colossal spirits. Perform music to influence them and unlock new paths. Collect the Mulong Cards to uncover who set you on this journey and why.","steam_appid":3571850,"support_info":{"email":"selvethegame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}