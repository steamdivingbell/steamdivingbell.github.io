\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3571850/extras/f66e694d401c9c738023e79b4f7655fc.poster.avif?t=1755715193\" width=478 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3571850/extras/f66e694d401c9c738023e79b4f7655fc.webm?t=1755715193\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3571850/extras/f66e694d401c9c738023e79b4f7655fc.mp4?t=1755715193\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Some characters will not cooperate with your mission, will you manipulate them using your musical powers?</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Customize your sound</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3571850/extras/57c6196738ac60305a0b769d03a3c7cf.poster.avif?t=1755715193\" width=478 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3571850/extras/57c6196738ac60305a0b769d03a3c7cf.webm?t=1755715193\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3571850/extras/57c6196738ac60305a0b769d03a3c7cf.mp4?t=1755715193\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Your voice in this game is a very customizable synthesizer, if you change different proportions of your body, your sound will be different.</p>","developers":["Nico Frois"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3571850/92e2443ced2d481ed87ab2c1290545419b16ea9f/header.jpg?t=1755715193","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257127026,"mp