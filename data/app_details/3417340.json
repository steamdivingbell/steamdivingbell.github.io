b6.600x338.jpg?t=1743687116"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3417340/6bbde9cbba90fabd7ef4f8ea93bc83d639446821/ss_6bbde9cbba90fabd7ef4f8ea93bc83d639446821.1920x1080.jpg?t=1743687116","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3417340/6bbde9cbba90fabd7ef4f8ea93bc83d639446821/ss_6bbde9cbba90fabd7ef4f8ea93bc83d639446821.600x338.jpg?t=1743687116"}],"short_description":"Face evil in this Roguelite Action RPG and find your way home. Darkness is engulfing the world, escape from the hand and don't get caught.","steam_appid":3417340,"support_info":{"email":"","url":"https://power-up-team.com/the-rogue-of-nexus/"},"supported_languages":"English, Italian, Spanish - Spain, Portuguese - Brazil, Portuguese - Portugal, Spanish - Latin America, French","type":"game","website":"https://power-up-team.com/the-rogue-of-nexus/"}