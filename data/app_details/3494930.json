71/ss_594b5a2668f1593e135bb2b7cc836766c4a69e71.1920x1080.jpg?t=1743534349","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494930/594b5a2668f1593e135bb2b7cc836766c4a69e71/ss_594b5a2668f1593e135bb2b7cc836766c4a69e71.600x338.jpg?t=1743534349"}],"short_description":"Build your factory from zero and produce high-tech products like drones, PC, robots and compete against thousands of players.","steam_appid":3494930,"support_info":{"email":"support@tafusoft.com","url":"https://www.tafusoft.com"},"supported_languages":"English","type":"game","website":"https://tafusoft.com"}