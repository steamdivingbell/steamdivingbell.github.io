u don\u2019t have to obey. It\u2019s dangerous, but you can freely explore the house.</p><p class=\"bb_paragraph\" ></p></li></ul>","developers":["VorhGames"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4081840/357a2f59ec1939f8d0025c0121e86b0f3dabf12c/header.jpg?t=1771446146","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4081840/1565079737/f9e9a6208011c80673dc8073707427ed62e01a38/1769801283/dash_av1.mpd?t=1769804728","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4081840/1565079737/f9e9a6208011c80673dc8073707427ed62e01a38/1769801283/dash_h264.mpd?t=1769804728","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4081840/1565079737/f9e9a6208011c80673dc8073707427ed62e01a38/1769801283/hls_264_master.m3u8?t=1769804728","id":257250878,"name":"Escape from Yandere Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257250878/d4598d4a88bbb69762f5b8ec33dbc1e8593ef956/movie_600x337.jpg?t=1769804728"}],"name":"Escape from Yandere","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"One Night with Yandere - $4.99 USD","packageid":1431003,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":499}],"title":"Buy Escape from Yandere"}],"packages":[14310