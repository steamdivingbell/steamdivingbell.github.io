/4137490/0b26d8e45a31ca7acb5e846acacbacc188c0e99b/ss_0b26d8e45a31ca7acb5e846acacbacc188c0e99b.600x338.jpg?t=1762329526"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4137490/123e8ae7f066b2d2c6157e01f98409abc583e664/ss_123e8ae7f066b2d2c6157e01f98409abc583e664.1920x1080.jpg?t=1762329526","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4137490/123e8ae7f066b2d2c6157e01f98409abc583e664/ss_123e8ae7f066b2d2c6157e01f98409abc583e664.600x338.jpg?t=1762329526"}],"short_description":"&quot;Tale of the Immortal Ring&quot;: A relaxed, top-down shooter. Use a mystical ring to journey between worlds. Battle monsters, gather resources, repair the ring, and grow stronger. Your final goal? Shatter the heavens and ascend to immortality.","steam_appid":4137490,"support_info":{"email":"xnytad@qq.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Russian, Japanese, Polish, Simplified Chinese, Traditional Chinese, Portuguese - Portugal, Korean","type":"demo","website":null}