ai.steamstatic.com/store_item_assets/steam/apps/3576410/d8022885a1648822591b55b3980642694c2e330d/ss_d8022885a1648822591b55b3980642694c2e330d.600x338.jpg?t=1771364609"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3576410/a791be8aee3be5286c3ab559a60cda764b464779/ss_a791be8aee3be5286c3ab559a60cda764b464779.1920x1080.jpg?t=1771364609","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3576410/a791be8aee3be5286c3ab559a60cda764b464779/ss_a791be8aee3be5286c3ab559a60cda764b464779.600x338.jpg?t=1771364609"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3576410/9ee25d1f1827365add3fe0d0039a666991245a3b/ss_9ee25d1f1827365add3fe0d0039a666991245a3b.1920x1080.jpg?t=1771364609","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3576410/9ee25d1f1827365add3fe0d0039a666991245a3b/ss_9ee25d1f1827365add3fe0d0039a666991245a3b.600x338.jpg?t=1771364609"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3576410/b05fc3d1f90e70e0f6f45aee24c510acf3443d31/ss_b05fc3d1f90e70e0f6f45aee24c510acf3443d31.1920x1080.jpg?t=1771364609","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3576410/b05fc3d1f90e70e0f6f45aee24c510acf3443d31/ss_b05fc3d1f90e70e0f6f45aee24c510acf3443d31.600x338.jpg?t=1771364609"}],"short_description":"In this 2D top-down action adventure, control John W. Beans and uncover the reptilian conspiracy. Sharpen your angle to hit your target. Use a revolver loaded with pea cans and other peculiar weapons. Ride down a river, explore arid landscapes, underground bases, and discover some secrets.","steam_appid":3576410,"support_info":{"email":"PabloDevStudio@gmail.com","url":""},"supported_languages":"English, Spanish - Spain","type":"game","website":null}