78c2b248325a81e2383d2/ss_0aff3d770f4addd536c78c2b248325a81e2383d2.1920x1080.jpg?t=1765124257","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3605090/0aff3d770f4addd536c78c2b248325a81e2383d2/ss_0aff3d770f4addd536c78c2b248325a81e2383d2.600x338.jpg?t=1765124257"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3605090/54ae808e3bbf3952a834294a4b99fdda1e6cae62/ss_54ae808e3bbf3952a834294a4b99fdda1e6cae62.1920x1080.jpg?t=1765124257","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3605090/54ae808e3bbf3952a834294a4b99fdda1e6cae62/ss_54ae808e3bbf3952a834294a4b99fdda1e6cae62.600x338.jpg?t=1765124257"}],"short_description":"NOT your ordinary horde slayer! Valor Hunters is a 1-4 player Co-Op survival roguelite with twin-stick combat and physics-defying hero kits. Grapple, slam and roll through 15-20 minute extraction runs, stacking absurd upgrades into hilariously OP builds as every escape becomes clutch chaos.","steam_appid":3605090,"support_info":{"email":"support@halegameworks.com","url":""},"supported_languages":"English","type":"game","website":null}