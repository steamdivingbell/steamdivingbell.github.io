//shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929590/f8cd612c71e5ad725c22b181a5851fd21ad17b2b/ss_f8cd612c71e5ad725c22b181a5851fd21ad17b2b.1920x1080.jpg?t=1773858175","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929590/f8cd612c71e5ad725c22b181a5851fd21ad17b2b/ss_f8cd612c71e5ad725c22b181a5851fd21ad17b2b.600x338.jpg?t=1773858175"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929590/871f1073aa90ba1165f0a7a7b9c16061f9d7d445/ss_871f1073aa90ba1165f0a7a7b9c16061f9d7d445.1920x1080.jpg?t=1773858175","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929590/871f1073aa90ba1165f0a7a7b9c16061f9d7d445/ss_871f1073aa90ba1165f0a7a7b9c16061f9d7d445.600x338.jpg?t=1773858175"}],"short_description":"Miyuki awakens in a frozen cryo chamber to find the space facility in chaos\u2014blood-smeared walls, blaring alarms, and undead roaming the halls. Alone, she must survive, solve puzzles, and uncover the truth behind a vanished experiment. In this nightmare, every choice matters.","steam_appid":3929590,"support_info":{"email":"zhang.hao.yu@foxmail.com","url":""},"supported_languages":"English, Simplified Chinese, Japanese, Korean, Traditional Chinese, French, German, Spanish - Spain, Ukrainian, Russian","type":"game","website":null}