table Text Size","id":64},{"description":"Camera Comfort","id":67},{"description":"Color Alternatives","id":66},{"description":"Custom Volume Controls","id":68},{"description":"Adjustable Difficulty","id":78},{"description":"Keyboard Only Option","id":75},{"description":"Mouse Only Option","id":76},{"description":"Narrated Game Menus","id":71},{"description":"Playable without Timed Input","id":74},{"description":"Stereo Sound","id":69},{"description":"Subtitle Options","id":65},{"description":"Surround Sound","id":70},{"description":"Steam Cloud","id":23},{"description":"Stats","id":15},{"description":"Steam Leaderboards","id":25},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[5],"notes":"There are fictional aspects of the underworld and references to Dante's Divine Comedy."},"controller_support":"full","detailed_description":"<h1>Collect and buff the legendary Arcanas to escape the Inferno</h1><p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2470790/extras/852f3a3bbd60a4445a1af5595ed05738.avif?t=1772512274\" width=616 height=100 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2470790/extras/bd77339cd5645d58b0c61a6ab2d6eebb.poster.avif?t=1772512274\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2470790/extras/bd77339cd5645d58b0c61a6ab2d6eebb.webm?t=1772512274\" type=\"video/webm; codecs=vp9\"></video></span>  </p></p><br><h1>About the Game</h1><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2470790/extras/18638fea96d1c3009296dda