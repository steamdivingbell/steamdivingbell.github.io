/extras/aeb464e295415776ea3b1d6a81d5ce3e.poster.avif?t=1756385656\" width=1600 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3285960/extras/aeb464e295415776ea3b1d6a81d5ce3e.webm?t=1756385656\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3285960/extras/aeb464e295415776ea3b1d6a81d5ce3e.mp4?t=1756385656\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" ><i><strong>The Initiative</strong></i> was a mysterious government outpost that rarely communicated with the outside world, but 60 years ago, communication stopped completely. Now, you've been tasked to dive back into the nightmare. Inside <strong><i>The Initiative</i></strong> is a spiralling maze of horrors. Deranged ramblings adorn the walls, loose papers are strewn across the floor, and the terrifying threats that caused this ruin are still in there with you. This place has a story to tell. Will you listen?</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3285960/extras/5e863f6db0de7e0a5452ae8b158d99fd.poster.avif?t=1756385656\" width=1600 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3285960/extras/5e863f6db0de7e0a5452ae8b158d99fd.webm?t=1756385656\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3285960/extras/5e863f6db0de7e0a5452ae8b158d99fd.mp4?t=1756385656\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >The Victor Initiative also features live action cutscenes and collectables, fleshing out the world and immersing you further into the story. The game will also feature audio logs and documents which tie everything together, with some audio logs featuring special cameo appearances from people who you might know! More details coming soon...</p>","developers":["Spacepiano Games"],"genres":[{"description":"Indie","id":"23"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3285960/header.jpg?t=1756385656","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257189403,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257189403/movie480.mp4?t=1756308614","max":"http://video.akamai.steamstatic.com/store_trailers/257189403/movie_max.mp4?t=1756308614"},"name":"Release Month Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257189403/8c392521dc9244a495bf0acee9f6d487155a2c58/movie_600x337.jpg?t=1756308614","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257189403/movie480_vp9.webm?t=1756308614","max":"http://video.akamai.steamstatic.com/store_trailers/257189403/movie_max_vp9.webm?t=1756308614"}},{"highlight":false,"id":257101488,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257101488/movie480.mp4?t=1756308616","max":"http://video.akamai.steamstatic.com/store_trailers/257101488/movie_max.mp4?t=1756308616"},"name":"New Demo Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257101488/f87ffebafeff6f7e97bd8fd7c8b16cefd4943763/movie_600x337.jpg?t=1756308616","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257101488/movie480_vp9.webm?t=1756308616","max":"http://video.akamai.steamstatic.com/store_trailers/257101488/movie_max_vp9.webm?t=1756308616"}}],"name":"The Victor Initiative","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Memory:</strong> 8 GB RAM</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Spacepiano Games"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia\nTemas sens\u00