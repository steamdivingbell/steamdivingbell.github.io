e wasteland's greatest mysteries: Why did Earth fall? What secrets lie in Robert's past?</p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3003050/extras/471BE8A68428001D19C4CF2EABB2FCF8.png?t=1749804135\" /></div></p>","developers":["Remrofsnart"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3003050/d28d7f7256142d0bf82d88d867acedf683ac1aa3/header.jpg?t=1749804135","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257024259,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257024259/movie480.mp4?t=1716895176","max":"http://video.akamai.steamstatic.com/store_trailers/257024259/movie_max.mp4?t=1716895176"},"name":"PV","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257024259/movie.293x165.jpg?t=1716895176","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257024259/movie480_vp9.webm?t=1716895176","max":"http://video.akamai.steamstatic.com/store_trailers/257024259/movie_max_vp9.webm?t=1716895176"}}],"name":"Robert on Earth","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3 Dual Core<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA Geforce GTS 450 / AMD Radeon HD 5570<br></li><li><strong>Storage:</str