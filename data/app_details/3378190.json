tatic.com/store_item_assets/steam/apps/3378190/ff22acc780bcecc8eece09d27abcdb989a60c625/ss_ff22acc780bcecc8eece09d27abcdb989a60c625.600x338.jpg?t=1752454251"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3378190/0f9566802e9e9a95c407caa4b1c50377ae955a21/ss_0f9566802e9e9a95c407caa4b1c50377ae955a21.1920x1080.jpg?t=1752454251","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3378190/0f9566802e9e9a95c407caa4b1c50377ae955a21/ss_0f9566802e9e9a95c407caa4b1c50377ae955a21.600x338.jpg?t=1752454251"}],"short_description":"Survive the wildest adventure of your life in Cartoon Survivor! Run, jump, and glide through a vibrant prehistoric world filled with dangerous creatures and crazy obstacles. Can you outlast the chaos and save the show? It\u2019s time to prove you\u2019ve got what it takes!","steam_appid":3378190,"support_info":{"email":"marketing@spungegames.com","url":"https://spungegames.com/connect"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}