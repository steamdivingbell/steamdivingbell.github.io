eam/apps/3435700/692c56f1c207d5c080c047da0940d0f14a310665/ss_692c56f1c207d5c080c047da0940d0f14a310665.600x338.jpg?t=1767696816"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3435700/097ae3688fb00fe9d5f5e1d51f9eb0ad09a1e003/ss_097ae3688fb00fe9d5f5e1d51f9eb0ad09a1e003.1920x1080.jpg?t=1767696816","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3435700/097ae3688fb00fe9d5f5e1d51f9eb0ad09a1e003/ss_097ae3688fb00fe9d5f5e1d51f9eb0ad09a1e003.600x338.jpg?t=1767696816"}],"short_description":"Evolized is an Evolution-Driven Action-Adventure RPG with a cycle-based structure. Evolve from cell to apex creature, customize powerful mutations, survive and adapt to hostile biomes, and uncover why the world keeps starting over.","steam_appid":3435700,"support_info":{"email":"","url":"https://www.infinitybranchstudios.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.infinitybranchstudios.com/"}