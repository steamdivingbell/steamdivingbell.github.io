.jpg?t=1758151765","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566730/7089a11a5c30863709e7fc5fa272e888b22ffc42/ss_7089a11a5c30863709e7fc5fa272e888b22ffc42.600x338.jpg?t=1758151765"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566730/f96a14cce1d4242afb8e98249f7303e49d28b583/ss_f96a14cce1d4242afb8e98249f7303e49d28b583.1920x1080.jpg?t=1758151765","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3566730/f96a14cce1d4242afb8e98249f7303e49d28b583/ss_f96a14cce1d4242afb8e98249f7303e49d28b583.600x338.jpg?t=1758151765"}],"short_description":"Naroike is a casual side-scrolling game that combines roguelite and hack-and-slash elements. Collect a wide variety of artifacts and use your skills to defeat enemies.","steam_appid":3566730,"support_info":{"email":"darkharvardvsyamitoudai@gmail.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese, Russian","type":"game","website":null}