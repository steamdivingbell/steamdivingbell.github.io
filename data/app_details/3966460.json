3966460/extras/8c51cad8cb76ebbcbae00371e43bef58.poster.avif?t=1765835309\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966460/extras/8c51cad8cb76ebbcbae00371e43bef58.webm?t=1765835309\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966460/extras/8c51cad8cb76ebbcbae00371e43bef58.mp4?t=1765835309\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><u><strong>Tech-savvy Terror</strong></u></h2><p class=\"bb_paragraph\" >Use your in-game laptop to check CCTV feeds, track grave locations, monitor upgrades, and stay one step ahead of the horror lurking in the shadows.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966460/extras/5b7522f63da8ee703ff5390a276502dd.poster.avif?t=1765835309\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966460/extras/5b7522f63da8ee703ff5390a276502dd.webm?t=1765835309\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966460/extras/5b7522f63da8ee703ff5390a276502dd.mp4?t=1765835309\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >\ud83d\udd6f\ufe0f Survive each night. Keep the cemetery clean. Uncover the secrets behind the paranormal. And most importantly... trust no one.</p>","developers":["Ragdoll Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3966460/390562ab56fc66f4bf641a8713c1a46c5f90f702/header.jpg?t=1765835309","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":