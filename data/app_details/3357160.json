akamai.steamstatic.com/store_item_assets/steam/apps/3357160/extras/f22be8feb0acd7c88af86a2dd2492c62.poster.avif?t=1770915635\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3357160/extras/f22be8feb0acd7c88af86a2dd2492c62.webm?t=1770915635\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3357160/extras/f22be8feb0acd7c88af86a2dd2492c62.mp4?t=1770915635\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3357160/extras/78239d62740f7a9541feb1585faee455.webp?t=1770915635\" width=326 height=40 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">With <strong><u>8 unique endings</u>\u00a0-</strong>\u00a0Choose your words carefully  some decisions cannot be undone. <br> <br> <br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3357160/extras/7dca3b935a10348beb2e52af65e8eb46.webp?t=1770915635\" width=414 height=42 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">A fully voiced narrative experience, delivered by a professional cast.  </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3357160/extras/6f165f7f17f2e3180d42042c61469153.webp?t=1770915635\" width=561 height=41 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">John &amp; Gwen's stories weave together in the past and present  as does the <strong>consequences</strong> of <span class=\"bb_strike\">their</span>\u00a0your decisions.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3357160/extras/7f625523fa644d60362ff8e51ee07391.webp?t=1770915635\" width=549 height=41 /></span></p><p class=\"bb_paragraph\" >Beautifully produced dark cello soundtrack supporting the game\u2019s themes of loss and memory, shifting between tension and sorrow, and rising to fear and action. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3357160/extras/d9da74293532ae893ae6dc8f1ce509ac.webp?t=1770915635\" width=350 height=41 /></span></p><p class=\"bb_paragraph\" >Hollow Mire is inspired by <strong>themes of mid-20th century, England,</strong>\u00a0at a time when the country was recovering from war. A time before computers, before cell phones. Food rationing was still in effect and many families were coming to terms with the idea that many of the soldiers who went to Europe were never coming home.\u00a0 \u00a0<strong> </strong>  <br>  <br><strong>In 1952 a large blizzard swept across England</strong>, particularly impacting the West Country where Hollow Mire is set. The dark, snowy Devonshire Countryside is a truly beautiful and equally atmospheric place. It's quiet, lonely, dark and remote.     <br>  <br> You'll return to Normandy on <strong>June 6th 1944 (D-Day),</strong> seen as the turning point of the second World War. Part of the 9th Parachute Battalion, dropping behind enemy lines ahead of the main landings, and later visiting the camps.\u00a0     <br>  <br>Players should expect Hollow Mire to visit <strong>mature themes</strong> in some of the <strong>most difficult times in human history</strong>.\u00a0  <br>  <br>All environments are hand-painted with a focus on realism, a blend of Victorian and Edwardian architecture.   <br>  <br>  </p><p class=\"bb_paragraph\" >  </p>","developers":["Mowlo Games"],"genres":[{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3357160/9b871fe4cb8b0119492c79ef0687e63b5cfcaa49/header.jpg?t=1770915635","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3357160/131134391/30887ed41c4487f91815496042328d76f59adfc4/1765471730/dash_av1.mpd?t=1770915631","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3357160/131134391/30887ed41c4487f91815496042328d76f59adfc4/1765471730/dash_h264.mpd?t=1770915631","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3357160/131134391/30887ed41c4487f91815496042328d76f59adfc4/1765471730/hls_264_master.m3u8?t=1770915631","id":257247593,"name":"Game Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257247593/171e958dd193cd2d04840bf3856cdc3d97cffe38/movie_600x337.jpg?t=1770915631"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3357160/2082450416/3d8454f7a963558cf4925fd54ddd5589935db1c2/1762544816/dash_av1.mpd?t=1770915632","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3357160/2082450416/3d8454f7a963558cf4925fd54ddd5589935db1c2/1762544816/dash_h264.mpd?t=1770915632","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3357160/2082450416/3d8454f7a963558cf4925fd54ddd5589935db1c2/1762544816/hls_264_master.m3u8?t=1770915632","id":257227153,"name":"Official Reveal Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257227153/171e958dd193cd2d04840bf3856cdc3d97cffe38/movie_600x337.jpg?t=1770915632"}],"name":"HOLLOW MIRE","package_groups":[],"pc_requirem