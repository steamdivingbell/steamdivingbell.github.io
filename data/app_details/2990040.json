40/61f6883b8993de5dcc1f15e13eb08b283dae7394/ss_61f6883b8993de5dcc1f15e13eb08b283dae7394.600x338.jpg?t=1744727113"}],"short_description":"Tailor your perfect backpack in the roguelite, spell-based, bullet heaven game. Explore further into the dungeons, weave spells, find magical artefacts and craft new ones. Do everything to survive and keep the flame of magic burning, in a world that seeks to snuff it out.","steam_appid":2990040,"support_info":{"email":"support@weirdjohnnystudio.com","url":"https://weirdjohnnystudio.com/en/"},"supported_languages":"English, Polish","type":"game","website":null}