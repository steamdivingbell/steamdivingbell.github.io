idea to let this game come out earlier, to accept criticism and accusations, and to help me, as a newcomer, to finish this work faster and better! </strong>","developers":["MK"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2904420/header.jpg?t=1744613690","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257011326,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257011326/movie480.mp4?t=1744613647","max":"http://video.akamai.steamstatic.com/store_trailers/257011326/movie_max.mp4?t=1744613647"},"name":"\u820c\u5c16\u4e0a\u7684\u9b54\u7d20\u5e08\u5ba3\u4f20\u7247","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257011326/33d03146923ef96d511d83591ab386b5f9293d2d/movie_600x337.jpg?t=1744613647","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257011326/movie480_vp9.webm?t=1744613647","max":"http://video.akamai.steamstatic.com/store_trailers/257011326/movie_max_vp9.webm?t=1744613647"}}],"name":"MagicCar of Delicious","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> windows 10\u4ee5\u4e0a<br></li><li><strong>Processor:</strong> i5<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> 1060\u4ee5\u4e0a<br></li><li><strong>Storage:</strong> 20 GB available space</li></ul>","recommended":"<strong>Recom