om/store_item_assets/steam/apps/1514400/721c99358fd5b1f05ab670b29a98e099b4580afd/ss_721c99358fd5b1f05ab670b29a98e099b4580afd.1920x1080.jpg?t=1759912164","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1514400/721c99358fd5b1f05ab670b29a98e099b4580afd/ss_721c99358fd5b1f05ab670b29a98e099b4580afd.600x338.jpg?t=1759912164"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1514400/8d8d46452d14c05f7b2d6eae5403d9dfc4fb2fe9/ss_8d8d46452d14c05f7b2d6eae5403d9dfc4fb2fe9.1920x1080.jpg?t=1759912164","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1514400/8d8d46452d14c05f7b2d6eae5403d9dfc4fb2fe9/ss_8d8d46452d14c05f7b2d6eae5403d9dfc4fb2fe9.600x338.jpg?t=1759912164"}],"short_description":"Grab your rod, bait and reels and get ready to fish! The Derby At Stillwater is a cozy deck-building fishing game where you take part in the annual Stillwater Cup. Build your deck, equip your boat and head out onto the lakes to win the Champion\u2019s Trophy, or just to fish for the love of the game!","steam_appid":1514400,"support_info":{"email":"hello@pixelbrush.io","url":"https://www.pixelbrush.io"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}