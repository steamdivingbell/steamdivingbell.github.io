ur inputs well to avoid dangers and collect as much cargo as possible. Master each level's timings to maximise your loot.</p><p class=\"bb_paragraph\" >The rails can get busy so you must keep an eye on multiple carts at once to ensure they all make it safely across each level. Some tracks are connected to the same input, so make sure it's the right decision before pulling that lever!</p>","developers":["Rootward Games"],"fullgame":{"appid":"3916040","name":"SwitchTrack"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3916970/eef81216f7525c907eb2cea75577ecbde71d5e8c/header.jpg?t=1758298444","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257199910,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257199910/movie480.mp4?t=1758119806","max":"http://video.akamai.steamstatic.com/store_trailers/257199910/movie_max.mp4?t=1758119806"},"name":"SwitchTrack Demo Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257199910/2ba1e6a837cf833084c281e3c450905162a5e99a/movie_600x337.jpg?t=1758119806","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257199910/movie480_vp9.webm?t=1758119806","max":"http://video.akamai.steamstatic.com/store_trailers/257199910/movie_max_vp9.webm?t=1758119806"}}],"name":"SwitchTrack Demo","package_groups":[],"pc_requirements":[],"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Rootward Games"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia fantasiosa","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"6","rating_generated":"1","required_age":"6","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Coming soon"},"required_age":0,"screenshots":[{"id":0,"p