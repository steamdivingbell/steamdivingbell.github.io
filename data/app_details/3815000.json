amstatic.com/store_item_assets/steam/apps/3815000/dc30884ae2baec04eaeced34a83c9f29df9ecc61/ss_dc30884ae2baec04eaeced34a83c9f29df9ecc61.1920x1080.jpg?t=1773781232","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/dc30884ae2baec04eaeced34a83c9f29df9ecc61/ss_dc30884ae2baec04eaeced34a83c9f29df9ecc61.600x338.jpg?t=1773781232"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/691eb698fa66a7d2d1a593eb307140e5eace2c9a/ss_691eb698fa66a7d2d1a593eb307140e5eace2c9a.1920x1080.jpg?t=1773781232","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/691eb698fa66a7d2d1a593eb307140e5eace2c9a/ss_691eb698fa66a7d2d1a593eb307140e5eace2c9a.600x338.jpg?t=1773781232"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/6abfab486be1d38bc8d3d49f96f57b193c869366/ss_6abfab486be1d38bc8d3d49f96f57b193c869366.1920x1080.jpg?t=1773781232","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/6abfab486be1d38bc8d3d49f96f57b193c869366/ss_6abfab486be1d38bc8d3d49f96f57b193c869366.600x338.jpg?t=1773781232"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/e2b4ac37e522e0d738606f4adda9c60563b70302/ss_e2b4ac37e522e0d738606f4adda9c60563b70302.1920x1080.jpg?t=1773781232","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/e2b4ac37e522e0d738606f4adda9c60563b70302/ss_e2b4ac37e522e0d738606f4adda9c60563b70302.600x338.jpg?t=1773781232"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/1288bb54a33122301f7454dddd0cb5fa6c88e021/ss_1288bb54a33122301f7454dddd0cb5fa6c88e021.1920x1080.jpg?t=1773781232","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/1288bb54a33122301f7454dddd0cb5fa6c88e021/ss_1288bb54a33122301f7454dddd0cb5fa6c88e021.600x338.jpg?t=1773781232"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/515f258e67d55c165dbf36d646ee7eff5f612b75/ss_515f258e67d55c165dbf36d646ee7eff5f612b75.1920x1080.jpg?t=1773781232","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3815000/515f258e67d55c165dbf36d646ee7eff5f612b75/ss_515f258e67d55c165dbf36d646ee7eff5f612b75.600x338.jpg?t=1773781232"}],"short_description":"A first-person investigative game set in a drowned village. Explore abandoned homes, speak with the last remaining locals, and capture through your lens the destruction left behind by the toxic sludge. Gather evidence, follow every clue, and uncover the truth hidden beneath silence and decay.","steam_appid":3815000,"support_info":{"email":"","url":"https://chainwolfgamedev.com/contact/"},"supported_languages":"English<strong>*</strong>, Romanian, Polish<br><strong>*</strong>languages with full audio support","type":"game","website":"https://chainwolfgamedev.com/geamana-village/"}