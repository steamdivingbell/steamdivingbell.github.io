ai.steamstatic.com/store_item_assets/steam/apps/3627210/7c8dd70563bf166261346a8deb313cdd47d98427/ss_7c8dd70563bf166261346a8deb313cdd47d98427.1920x1080.jpg?t=1758143503","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3627210/7c8dd70563bf166261346a8deb313cdd47d98427/ss_7c8dd70563bf166261346a8deb313cdd47d98427.600x338.jpg?t=1758143503"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3627210/80c69fe303141563b3ab926ed06e34bc67c32c4d/ss_80c69fe303141563b3ab926ed06e34bc67c32c4d.1920x1080.jpg?t=1758143503","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3627210/80c69fe303141563b3ab926ed06e34bc67c32c4d/ss_80c69fe303141563b3ab926ed06e34bc67c32c4d.600x338.jpg?t=1758143503"}],"short_description":"The Orchard Estate is Haunted! And It\u2019s up to you to uncover the clues and unmask the monsters prowling its halls! Investigate a cartoon mansion full of fiendish animatronics, dastardly traps, and zany suspects. But beware, the mansion appears to shift each case, and seems to hold deeper mysteries\u2026","steam_appid":3627210,"support_info":{"email":"","url":"https://mansionofamillionmonsters.com"},"supported_languages":"English","type":"game","website":"https://mansionofamillionmonsters.com"}