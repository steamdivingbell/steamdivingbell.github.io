.akamai.steamstatic.com/store_item_assets/steam/apps/3944010/84ec93e118b168d0d6c64a4a26ae6ec96cda4c2d/ss_84ec93e118b168d0d6c64a4a26ae6ec96cda4c2d.1920x1080.jpg?t=1760014579","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3944010/84ec93e118b168d0d6c64a4a26ae6ec96cda4c2d/ss_84ec93e118b168d0d6c64a4a26ae6ec96cda4c2d.600x338.jpg?t=1760014579"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3944010/1eb9b9ef029109f711a3b1262b81c734ef1420cb/ss_1eb9b9ef029109f711a3b1262b81c734ef1420cb.1920x1080.jpg?t=1760014579","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3944010/1eb9b9ef029109f711a3b1262b81c734ef1420cb/ss_1eb9b9ef029109f711a3b1262b81c734ef1420cb.600x338.jpg?t=1760014579"}],"short_description":"A psychological survival horror where you play as a disgraced journalist investigating the Royal Veil Hotel, where multiple people have gone missing. Desperate for one last chance to reclaim your life, you must uncover its secrets and confront your past.","steam_appid":3944010,"support_info":{"email":"craftzmystic@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}