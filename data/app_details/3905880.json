till \u201cus\u201d?</p>","developers":["DaYan Myriad"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3905880/f1059677a0010a5ae73764c074d4a024d3683fa5/header.jpg?t=1759978911","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3905880/770295498/c8d4d8de19a51b652a9efc069e20c3c8984b4016/1754042337/dash_av1.mpd?t=1759978910","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3905880/770295498/c8d4d8de19a51b652a9efc069e20c3c8984b4016/1754042337/dash_h264.mpd?t=1759978910","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3905880/770295498/c8d4d8de19a51b652a9efc069e20c3c8984b4016/1754042337/hls_264_master.m3u8?t=1759978910","id":257176726,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257176726/movie480.mp4?t=1759978910","max":"https://video.akamai.steamstatic.com/store_trailers/257176726/movie_max.mp4?t=1759978910"},"name":"POOL","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257176726/563046421dd1b666758b145a4560b048fc67fbef/movie_600x337.jpg?t=1759978910","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257176726/movie480_vp9.webm?t=1759978910","max":"https://video.akamai.steamstatic.com/store_trailers/257176726/movie_max_vp9.webm?t=1759978910"}}],"name":"POOL","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS *:</strong