nds, playful wildlife, and the freedom to create your perfect serene pond.</p>","developers":["Snowscape Studios"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3924840/97b87d295712383ef20f0772b485bb661c4598fd/header.jpg?t=1759138827","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3924840/137468067/81edec84d6776562ecf1ba67062186b1ebf7f40e/1755990572/dash_av1.mpd?t=1756039796","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3924840/137468067/81edec84d6776562ecf1ba67062186b1ebf7f40e/1755990572/dash_h264.mpd?t=1756039796","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3924840/137468067/81edec84d6776562ecf1ba67062186b1ebf7f40e/1755990572/hls_264_master.m3u8?t=1756039796","id":257187794,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257187794/movie480.mp4?t=1756039796","max":"https://video.akamai.steamstatic.com/store_trailers/257187794/movie_max.mp4?t=1756039796"},"name":"Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257187794/5b975533c8e86634a5ffeb54fa7cd7ce10e4472a/movie_600x337.jpg?t=1756039796","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257187794/movie480_vp9.webm?t=1756039796","max":"https://video.akamai.steamstatic.com/store_trailers/257187794/movie_max_vp9.webm?t=1756039796"}}],"name":"Serene Ponds","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Snowscape Studios"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_genera