ages/storepagebackground/app/1304530?t=1772875666","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304530/page_bg_raw.jpg?t=1772875666","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304530/capsule_231x87.jpg?t=1772875666","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304530/capsule_184x69.jpg?t=1772875666","categories":[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Full controller support","id":28},{"description":"Steam Cloud","id":23},{"description":"Stats","id":15},{"description":"Remote Play on TV","id":43},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"controller_support":"full","detailed_description":"<p class=\"bb_paragraph\" ><strong>Sling-A-Thing</strong> is a mind-boggling, laugh-out-loud, comedy action puzzler that will keep you entertained for hours. Dive into a whimsical world where you can transform into an incredible variety of cartoon characters and objects, all to find your way to the exit in the most creative ways possible.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304530/extras/d73183d0ccc25845acf2bbd9a5e7d523.poster.avif?t=1772875666\" width=500 height=290 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304530/extras/d73183d0ccc25845acf2bbd9a5e7d523.webm?t=1772875666\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304530/extras/d73183d0ccc25845acf2bbd9a5e7d523.mp4?t=1772875666\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Features:</h2><p class=\"bb_paragraph\" ><strong>Quirky, Surprising &amp; Satisfying Gameplay</strong></p><p class=\"bb_parag