":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2481810/591743a8db16bc49dd16ffbf33083dc7e641253e/ss_591743a8db16bc49dd16ffbf33083dc7e641253e.600x338.jpg?t=1767681046"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2481810/9864bd007606afaffeef7b11d571a4b6d31a555f/ss_9864bd007606afaffeef7b11d571a4b6d31a555f.1920x1080.jpg?t=1767681046","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2481810/9864bd007606afaffeef7b11d571a4b6d31a555f/ss_9864bd007606afaffeef7b11d571a4b6d31a555f.600x338.jpg?t=1767681046"}],"short_description":"In Meow Craft, you\u2019ll run your very own purr-fect blacksmith shop: from sniffing out raw materials, to paw-forging weapons, to meow-keting your shiny new gear. Trade with merchants, strike deals with adventurers, and build up your workshop from a tiny smithy into a legend!","steam_appid":2481810,"support_info":{"email":"support@2pgames.net","url":""},"supported_languages":"Simplified Chinese, English, Traditional Chinese, Japanese","type":"game","website":null}