s/2476690/f59efde55a28afd3038f67c948c1ac06a8beabe5/ss_f59efde55a28afd3038f67c948c1ac06a8beabe5.600x338.jpg?t=1763844446"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2476690/183edcfe8123dab60f80433e07d2aaa36ef5a9f3/ss_183edcfe8123dab60f80433e07d2aaa36ef5a9f3.1920x1080.jpg?t=1763844446","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2476690/183edcfe8123dab60f80433e07d2aaa36ef5a9f3/ss_183edcfe8123dab60f80433e07d2aaa36ef5a9f3.600x338.jpg?t=1763844446"}],"short_description":"ARIE: Moonprayer is a short anime-style exploration experience. Moon is falling, and the world is ending. You will travel across the last remaining island in the world to reach the island\u2019s peak, and play the Moonsongs that resonates with the departed, uncovering the beauty of the apocalyptic world.","steam_appid":2476690,"support_info":{"email":"support@phtworks.com","url":"https://phtworks.com/contact"},"supported_languages":"English, Japanese, Simplified Chinese<strong>*</strong>, Traditional Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://phtworks.com/arie-moonprayer"}