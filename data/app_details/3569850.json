teamstatic.com/store_item_assets/steam/apps/3569850/extras/02e9a93fa4b8e13dba52f623090e2584.poster.avif?t=1753080365\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3569850/extras/02e9a93fa4b8e13dba52f623090e2584.webm?t=1753080365\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3569850/extras/02e9a93fa4b8e13dba52f623090e2584.mp4?t=1753080365\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Get more cards!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Use your profits to open booster packs and collect more cards and enhancement effects. </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3569850/extras/7e544ff4a2a40b4d5d09255ce6402f84.poster.avif?t=1753080365\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3569850/extras/7e544ff4a2a40b4d5d09255ce6402f84.webm?t=1753080365\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3569850/extras/7e544ff4a2a40b4d5d09255ce6402f84.mp4?t=1753080365\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Prove yourself in battle!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Win card battles to change your deck's evaluation and silence player complaints.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Can you revive the card game and satisfy both the strict chairman and the demanding players?</p><p class=\"bb_paragraph\" ></p>","developers":["Shedin"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3569850/5