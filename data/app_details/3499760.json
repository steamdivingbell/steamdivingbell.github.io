6956"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499760/0759fe0f3f89408414456b8812efe9c3d837cf4d/ss_0759fe0f3f89408414456b8812efe9c3d837cf4d.1920x1080.jpg?t=1740696956","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3499760/0759fe0f3f89408414456b8812efe9c3d837cf4d/ss_0759fe0f3f89408414456b8812efe9c3d837cf4d.600x338.jpg?t=1740696956"}],"short_description":"Build a bubble-popping paradise! Automate your empire with adorable cats, or rack up explosive combos with satisfying click chains. Charming hand-drawn graphics meet strategic depth and addicting incremental progression. Will you idle peacefully or actively unleash a popping pandemonium?","steam_appid":3499760,"support_info":{"email":"mail@vittorioromeo.com","url":"https://vittorioromeo.com"},"supported_languages":"English","type":"game","website":null}