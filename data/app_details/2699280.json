n the full game</p></li><li><p class=\"bb_paragraph\" >50+ distinct enemies and 9 unique boss fights</p></li><li><p class=\"bb_paragraph\" >10 difficulty levels for escalating challenge</p></li><li><p class=\"bb_paragraph\" >\tController and Steam Deck support at launch</p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["Legacy Forge"],"genres":[{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2699280/2517d0a5f162d7bd97bba87f4f3178cff60fe8bd/header.jpg?t=1772094873","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2699280/1906355063/1dec56e6ec269dc951033dc87f5ae3e70c8cc0f5/1771253987/dash_av1.mpd?t=1771257796","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2699280/1906355063/1dec56e6ec269dc951033dc87f5ae3e70c8cc0f5/1771253987/dash_h264.mpd?t=1771257796","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2699280/1906355063/1dec56e6ec269dc951033dc87f5ae3e70c8cc0f5/1771253987/hls_264_master.m3u8?t=1771257796","id":257288165,"name":"Valor of Man - Date Reveal","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257288165/0acb8413039d6644c7e18f22563ddb2ecc3a8b5c/movie_600x337.jpg?t=1771257796"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2699280/1505743906/2a83eace009a87b7b30bb10364b41678c6f2cf69/1765964607/dash_av1.mpd?t=1765967413","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2699280/1505743906/2a83eace009a87b7b30bb10364b41678c6f2cf69/1765964607/das