decs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>Mesmerizing Music</i></h2><p class=\"bb_paragraph\" >Immerse yourself in this dystopian adventure with a live-recorded orchestral soundtrack that brings every moment to life. Feel the intensity and emotion as the music adapts to your journey, making each scene unforgettable.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>Key Features</i></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Story-Driven Gameplay</p></li><li><p class=\"bb_paragraph\" >Jump-n-Run</p></li><li><p class=\"bb_paragraph\" >Special Abilities like Teleportation or Doublejump to overcome obstacles</p></li><li><p class=\"bb_paragraph\" >Variety of different Puzzles</p></li><li><p class=\"bb_paragraph\" >Interact with the World to make your way</p></li><li><p class=\"bb_paragraph\" >Use Stealth and the Environment to evade different Enemies</p></li><li><p class=\"bb_paragraph\" >Enjoy the\u00a0live-recorded Orchestral Soundtrack adapting to your Gameplay</p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["Icegrim Softworks"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2900900/header.jpg?t=1757016370","is_free":false,"legal_notice":"\u00a92024-2025 Icegrim Softworks e.U.<br />\r\nMoony:Black_Lotus is a registered trademark of Icegrim Softworks. All Rights Reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257083318,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257083318/movie480.mp4?t=1756321515","max":"http://video.akamai.steamstatic.c