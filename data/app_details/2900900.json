0/1ed5a54cde0a39bbd067625aeebe199179d38516/ss_1ed5a54cde0a39bbd067625aeebe199179d38516.1920x1080.jpg?t=1757016370","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2900900/1ed5a54cde0a39bbd067625aeebe199179d38516/ss_1ed5a54cde0a39bbd067625aeebe199179d38516.600x338.jpg?t=1757016370"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2900900/ss_863810f755a2188c848d0f7f5e6f656905a2cbcc.1920x1080.jpg?t=1757016370","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2900900/ss_863810f755a2188c848d0f7f5e6f656905a2cbcc.600x338.jpg?t=1757016370"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2900900/0eb8ffed2f35c5c68aa917a06918a71014ff3947/ss_0eb8ffed2f35c5c68aa917a06918a71014ff3947.1920x1080.jpg?t=1757016370","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2900900/0eb8ffed2f35c5c68aa917a06918a71014ff3947/ss_0eb8ffed2f35c5c68aa917a06918a71014ff3947.600x338.jpg?t=1757016370"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2900900/815bbcbb1e429e6f47bb6daf9f42323ecfee99a6/ss_815bbcbb1e429e6f47bb6daf9f42323ecfee99a6.1920x1080.jpg?t=1757016370","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2900900/815bbcbb1e429e6f47bb6daf9f42323ecfee99a6/ss_815bbcbb1e429e6f47bb6daf9f42323ecfee99a6.600x338.jpg?t=1757016370"}],"short_description":"In a world of corrupted memories, you traverse the remains of a once flourishing city. Shadows flicker around you and metallic echoes pulse through your mind. Search for your father's legacy to regain your forgotten past. But beware! Each step takes you deeper into a waking nightmare.","steam_appid":2900900,"support_info":{"email":"support@icegrim.com","url":""},"supported_languages":"English, German, French, Italian, Spanish - Spain","type":"game","website":"https://icegrim.com/"}