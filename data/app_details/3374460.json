ps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/9047d06548f34a6af03481b70827e1c5e715dd65/ss_9047d06548f34a6af03481b70827e1c5e715dd65.600x338.jpg?t=1744387982"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/717ee1905c772e96c617e3d2a4d14939f2a76052/ss_717ee1905c772e96c617e3d2a4d14939f2a76052.1920x1080.jpg?t=1744387982","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/717ee1905c772e96c617e3d2a4d14939f2a76052/ss_717ee1905c772e96c617e3d2a4d14939f2a76052.600x338.jpg?t=1744387982"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/b0f63a43942937edb8a9a82f5d33a6456c08ef54/ss_b0f63a43942937edb8a9a82f5d33a6456c08ef54.1920x1080.jpg?t=1744387982","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/b0f63a43942937edb8a9a82f5d33a6456c08ef54/ss_b0f63a43942937edb8a9a82f5d33a6456c08ef54.600x338.jpg?t=1744387982"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/d70d462116289265bb28b47227d38a680ad043dd/ss_d70d462116289265bb28b47227d38a680ad043dd.1920x1080.jpg?t=1744387982","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/d70d462116289265bb28b47227d38a680ad043dd/ss_d70d462116289265bb28b47227d38a680ad043dd.600x338.jpg?t=1744387982"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/174126d574b0285cdafb85d31bb17d78f604ce98/ss_174126d574b0285cdafb85d31bb17d78f604ce98.1920x1080.jpg?t=1744387982","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3374460/174126d574b0285cdafb85d31bb17d78f604ce98/ss_174126d574b0285cdafb85d31bb17d78f604ce98.600x338.jpg?t=1744387982"}],"short_description":"Causal Loop is a narrative puzzler that blends mind-bending mechanics with a rich sci-fi story about time, consequence, and survival. Solve intricate puzzles by using the unique \u201cecho\u201d mechanic to record, replay, and interact with up to three versions of your past self. Can you break the loop?","steam_appid":3374460,"support_info":{"email":"","url":"https://www.mirebound.com"},"supported_languages":"English<strong>*</strong>, French, German<strong>*</strong>, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.mirebound.com/causal-loop/"}