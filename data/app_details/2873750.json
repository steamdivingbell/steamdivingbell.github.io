0d0840296aca0d8.1920x1080.jpg?t=1744639160","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2873750/ss_d96adc926b9bf749c87bda8620d0840296aca0d8.600x338.jpg?t=1744639160"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2873750/ss_eb7e11ee4c8264477fd4912e0cf3973b0460dbeb.1920x1080.jpg?t=1744639160","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2873750/ss_eb7e11ee4c8264477fd4912e0cf3973b0460dbeb.600x338.jpg?t=1744639160"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2873750/ss_9cee28d632cc5402dc096a1c51cee0c512d26052.1920x1080.jpg?t=1744639160","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2873750/ss_9cee28d632cc5402dc096a1c51cee0c512d26052.600x338.jpg?t=1744639160"}],"short_description":"A Lovecraftian roguelite pool. Shoot some balls. Unleash horrors from beyond. Go insane. Try again.","steam_appid":2873750,"support_info":{"email":"contact@bitgolemgames.com","url":"https://discord.gg/W5v6dCGafc"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Turkish, Ukrainian<br><strong>*</strong>languages with full audio support","type":"game","website":"http://bitgolemgames.com"}