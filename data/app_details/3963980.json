3980/extras/66a490bdb2e054abe4141ee66b19ed4d.webm?t=1773371274\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/66a490bdb2e054abe4141ee66b19ed4d.mp4?t=1773371274\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >You can also treat cleared blocks as <strong>currency</strong> in the <strong>Shop</strong> to buy easier <strong>standard pieces</strong>\u2014load them into shop slots for clutch saves at critical moments!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/424cb43d5fd48353ae569b418113d430.avif?t=1773371274\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras_big/424cb43d5fd48353ae569b418113d430.webp?t=1773371274 width=1560 height=877 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Each stage introduces different <strong>obstacles</strong>\u2014team up with your animal buddies and take on the challenge!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/e8d82fc7d5a5343607d97cec9a610381.poster.avif?t=1773371274\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/e8d82fc7d5a5343607d97cec9a610381.webm?t=1773371274\" type=\"video/webm; codecs=vp9\"><source src=\"https://sh