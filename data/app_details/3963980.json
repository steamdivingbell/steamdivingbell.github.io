3980/extras/21233782594b22cf3296c50dc6fcd208.webm?t=1762497249\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/21233782594b22cf3296c50dc6fcd208.mp4?t=1762497249\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >You can also treat cleared blocks as <strong>currency</strong> in the <strong>Shop</strong> to buy easier <strong>standard pieces</strong>\u2014load them into shop slots for clutch saves at critical moments!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/d02e4983956228921d469156421c14f5.poster.avif?t=1762497249\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/d02e4983956228921d469156421c14f5.webm?t=1762497249\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/d02e4983956228921d469156421c14f5.mp4?t=1762497249\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Each stage introduces different <strong>obstacles</strong>\u2014team up with your animal buddies and take on the challenge!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3963980/extras/b1cac4fed7ad63c55c3a0cc035393769.poster