40/b937c594adcffdd5bb7cddb5cd5925a3f7932c84/ss_b937c594adcffdd5bb7cddb5cd5925a3f7932c84.600x338.jpg?t=1768511459"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/ce1ce6850f7c2b8a34a1e89e3e1b810e91f2fd4d/ss_ce1ce6850f7c2b8a34a1e89e3e1b810e91f2fd4d.1920x1080.jpg?t=1768511459","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/ce1ce6850f7c2b8a34a1e89e3e1b810e91f2fd4d/ss_ce1ce6850f7c2b8a34a1e89e3e1b810e91f2fd4d.600x338.jpg?t=1768511459"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/06fb6afb5f1d84a02c92639c9ac2627a6fbc8282/ss_06fb6afb5f1d84a02c92639c9ac2627a6fbc8282.1920x1080.jpg?t=1768511459","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/06fb6afb5f1d84a02c92639c9ac2627a6fbc8282/ss_06fb6afb5f1d84a02c92639c9ac2627a6fbc8282.600x338.jpg?t=1768511459"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/523e28e92be67607ee5591dc29380b2e9a860554/ss_523e28e92be67607ee5591dc29380b2e9a860554.1920x1080.jpg?t=1768511459","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/523e28e92be67607ee5591dc29380b2e9a860554/ss_523e28e92be67607ee5591dc29380b2e9a860554.600x338.jpg?t=1768511459"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/5100f276ed3d348e2632c807c0c931cff9a1a6c9/ss_5100f276ed3d348e2632c807c0c931cff9a1a6c9.1920x1080.jpg?t=1768511459","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/5100f276ed3d348e2632c807c0c931cff9a1a6c9/ss_5100f276ed3d348e2632c807c0c931cff9a1a6c9.600x338.jpg?t=1768511459"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3619040/71b06dcd1345176cc0d6dc6e3de6a55e9812a887/ss_71b06dcd1345176cc0d6dc6e3de6a55e9812a887.1920x1080.jpg?t=1768511459","path_thumbnail":"ht