umbnails or posts here!\u00a0</strong></i></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" style=\"text-align: center\"><i><strong>impress.games/press-kit/third-eye-studios/ghost-ripper</strong></i></p>","developers":["Third Eye Interactive"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694230/bd6848387e3e2b64e0ae13fea71ec75d669cd64a/header.jpg?t=1774277112","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3694230/333136563/1053ea0c0589da6957b7aa0f22179cb5523d2a6d/1773588498/dash_av1.mpd?t=1773589860","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3694230/333136563/1053ea0c0589da6957b7aa0f22179cb5523d2a6d/1773588498/dash_h264.mpd?t=1773589860","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3694230/333136563/1053ea0c0589da6957b7aa0f22179cb5523d2a6d/1773588498/hls_264_master.m3u8?t=1773589860","id":257159483,"name":"Demo Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257159483/83d90e0236ddff9447709d753339a1e26f75db0c/movie_600x337.jpg?t=1773589860"}],"name":"Ghost Ripper","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3-2100 or AMD FX-6300<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 750 Ti or AMD Radeon HD 7850<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space<br></li><li><strong>Sound Card:</strong> Yes</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong>