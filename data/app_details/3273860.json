60/eee17ff54d1f6fc6e4ae1e95616a964eff660a07/ss_eee17ff54d1f6fc6e4ae1e95616a964eff660a07.600x338.jpg?t=1744883332"}],"short_description":"Play as a wolf detective, who is exploring his queer identity while working for a totalitarian regime. Solve cases using animal abilities. Sniff for clues. Listen to the wind. Lick everything. Fight your instincts or become an animal.","steam_appid":3273860,"support_info":{"email":"Zakroutil@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}