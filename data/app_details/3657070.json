/apps/3657070/12975bfd2b1cc2b6b76a2f363397bb9c22a349dc/ss_12975bfd2b1cc2b6b76a2f363397bb9c22a349dc.1920x1080.jpg?t=1756457560","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3657070/12975bfd2b1cc2b6b76a2f363397bb9c22a349dc/ss_12975bfd2b1cc2b6b76a2f363397bb9c22a349dc.600x338.jpg?t=1756457560"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3657070/da35291b3cc4a2405069901ff664333a3169f9e8/ss_da35291b3cc4a2405069901ff664333a3169f9e8.1920x1080.jpg?t=1756457560","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3657070/da35291b3cc4a2405069901ff664333a3169f9e8/ss_da35291b3cc4a2405069901ff664333a3169f9e8.600x338.jpg?t=1756457560"}],"short_description":"Quartermaster is a management strategy simulation in which you will build a top-secret agency to prepare elite spies for their missions! Research high-tech spy gadgets and run specialized training programs. Manage your staff and stay alert for double agents looking to sabotage your operation.","steam_appid":3657070,"support_info":{"email":"support@frozendistrict.com","url":""},"supported_languages":"English<strong>*</strong>, French, Italian, German, Spanish - Spain, Japanese, Polish, Russian, Simplified Chinese, Traditional Chinese, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":null}