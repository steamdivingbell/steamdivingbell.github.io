/shared.akamai.steamstatic.com/store_item_assets/steam/apps/4057180/852e4071f63f711b9a9e8bb83d40fde38a1e9586/ss_852e4071f63f711b9a9e8bb83d40fde38a1e9586.600x338.jpg?t=1760548385"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4057180/f7fd2aead8314a2faf29910f6461422992b4a5eb/ss_f7fd2aead8314a2faf29910f6461422992b4a5eb.1920x1080.jpg?t=1760548385","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4057180/f7fd2aead8314a2faf29910f6461422992b4a5eb/ss_f7fd2aead8314a2faf29910f6461422992b4a5eb.600x338.jpg?t=1760548385"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4057180/cfa48b72cce604f99b096e97d4305188c1a5d483/ss_cfa48b72cce604f99b096e97d4305188c1a5d483.1920x1080.jpg?t=1760548385","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4057180/cfa48b72cce604f99b096e97d4305188c1a5d483/ss_cfa48b72cce604f99b096e97d4305188c1a5d483.600x338.jpg?t=1760548385"}],"short_description":"You are the surgeon navigating patients' memories via crude, retro machinery, under the command of a strange, occult organization. Keep your patients alive long enough to uncover your exact role in this surreal mess of an operation.","steam_appid":4057180,"support_info":{"email":"brygdinteractive@gmail.com","url":""},"supported_languages":"English, Russian, Spanish - Latin America, Spanish - Spain","type":"game","website":null}