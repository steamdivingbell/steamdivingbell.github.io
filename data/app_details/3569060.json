ai.steamstatic.com/store_item_assets/steam/apps/3569060/9b9d6bc1f2eb0a5f656bfbf62bca9eef96b925a4/ss_9b9d6bc1f2eb0a5f656bfbf62bca9eef96b925a4.600x338.jpg?t=1745150716"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3569060/ddf9026cae49fcec8a3267142fb5a71ca2cc90f3/ss_ddf9026cae49fcec8a3267142fb5a71ca2cc90f3.1920x1080.jpg?t=1745150716","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3569060/ddf9026cae49fcec8a3267142fb5a71ca2cc90f3/ss_ddf9026cae49fcec8a3267142fb5a71ca2cc90f3.600x338.jpg?t=1745150716"}],"short_description":"Straight from the 90s, 90FX recreates the feel and experience of once revolutionary racing games of the early 90s. 90s Kids will remember this.","steam_appid":3569060,"support_info":{"email":"yaeko.games@gmail.com","url":"http://steamcommunity.com/app/3569060/discussions/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}