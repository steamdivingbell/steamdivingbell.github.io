eam/apps/1668970/extras/94bc22d3e0fa1d7776c5688dff4cf43d.mp4?t=1759002432\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Navigate the world as you desire, with the ability to hunt down specific tribes and event locations. Ferocious tribes, doom spires, glowing craters, breathing rifts, and so much more stand in your way - do you have what it takes to earn your freedom?</p>","developers":["Dale Turner"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1668970/66e8a6eb3d46a87e4e7ceebb79f746b41444bdc7/header.jpg?t=1759002432","is_free":false,"legal_notice":"\u00a9 Dale Turner Pty Ltd 2023. All rights reserved.","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1668970/538284/cc078e465217b25d31aaad9e977f354df969d84e/1751017261/dash_av1.mpd?t=1698737194","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1668970/538284/cc078e465217b25d31aaad9e977f354df969d84e/1751017261/dash_h264.mpd?t=1698737194","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1668970/538284/cc078e465217b25d31aaad9e977f354df969d84e/1751017261/hls_264_master.m3u8?t=1698737194","id":256930059,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/256930059/movie480.mp4?t=1698737194","max":"https://video.akamai.steamstatic.com/store_trailers/256930059/movie_max.mp4?t=1698737194"},"name":"Cinematic Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256930059/movie.293x165.jpg?t=1698737194","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/256930059/movie480_vp9.webm?t=1698737194","max":"https://video.akamai.steamstatic.com/store_trailers/256930059/movie_max_vp9.webm?t=1698737194"}}],