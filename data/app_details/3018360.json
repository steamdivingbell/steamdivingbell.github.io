/3018360/extras/94cc10a6d8b0416381b5652185a56841.poster.avif?t=1757605781\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/94cc10a6d8b0416381b5652185a56841.webm?t=1757605781\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/94cc10a6d8b0416381b5652185a56841.mp4?t=1757605781\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong><u>RESISTANCE GAME MODE</u></strong> <br>Resistance presents Tower Defense like game experience, where players defend their mining station against relentless waves of enemy assaults, strategically deploying towers. Players will gather valuable resources while defending their station as long as possible. The more mining the better farming. </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/4549a754c7d9cc3640802be0cb58427d.poster.avif?t=1757605781\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/4549a754c7d9cc3640802be0cb58427d.webm?t=1757605781\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/4549a754c7d9cc3640802be0cb58427d.mp4?t=1757605781\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/34cb8e58ad0a6d26bf9c9498b4e2021f.poster.avif?t=1757605781\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/34cb8e58ad0a6d26bf9c9498b4e2021f.webm?t=1757605781\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/34cb8e58ad0a6d26bf9c9498b4e2021f.mp4?t=1757605781\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong><u>EXPEDITION GAME MODE (Coming Soon)</u></strong> <br>Expedition mode throws you into unpredictable, ever-changing battlegrounds where every room is a new challenge. Fight through enemy-infested zones, tackle unique objectives  and decide whether to risk pushing forward or stock up at the trader. With escalating difficulty and endless mode, every expedition is a thrilling test of skill, strategy, and endurance. </p><h2 class=\"bb_tag\" ><strong><u>EVOLUTION, PROFICIENCY AND ASCENSION</u></strong></h2><p class=\"bb_paragraph\" >Players can evolve their favorite bug character, as well as upgrading their arsenal (weapons and abilities). Collect essence and resources, evolve your bug, make it stronger and embark on harder levels. Meanwhile upgrade your weapons and abilities, make your bug warrior unstoppable. Reveal legendary skills of your bug warrior.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/78aabfdac2f0260878eeb7f61e1c1128.poster.avif?t=1757605781\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/78aabfdac2f0260878eeb7f61e1c1128.webm?t=1757605781\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/78aabfdac2f0260878eeb7f61e1c1128.mp4?t=1757605781\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/fe58938544a7d58f1bb8298ff961efed.poster.avif?t=1757605781\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/fe58938544a7d58f1bb8298ff961efed.webm?t=1757605781\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/fe58938544a7d58f1bb8298ff961efed.mp4?t=1757605781\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>CHALLENGES &amp; ACHIEVEMENTS</strong></h2><p class=\"bb_paragraph\" >Are you eager for some hardcore? Then challenges are exactly for you! Complete tons of challenges and unlock new characters, maps, valuable resources and much more.\u00a0</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/bde906265522115b2782467dfed84ec7.poster.avif?t=1757605781\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/bde906265522115b2782467dfed84ec7.webm?t=1757605781\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/bde906265522115b2782467dfed84ec7.mp4?t=1757605781\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/extras/854bdf94e14574c407462c871a9237ff.avif?t=1757605781\" width=400 height=200 /></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>UPCOMING FEATURES</strong>:</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Expedition Game Mode</p></li><li><p class=\"bb_paragraph\" >New Modifications</p></li><li><p class=\"bb_paragraph\" >New Character Skins</p></li><li><p class=\"bb_paragraph\" >New Unique Bug Characters</p></li><li><p class=\"bb_paragraph\" >New Engaging Maps</p></li><li><p class=\"bb_paragraph\" >End-game Features </p></li></ul><p class=\"bb_paragraph\" >and more to be decided together with our great community</p>","developers":["Ent-Re Games"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018360/fb583a32d10f88f124185146c250b953aa790027/header.jpg?t=1757605781","is_free":false,"legal_notice":"\u00a9 2025 Ent-Re Games | All Rights Reserved","linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257179033,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257179033/movie480.mp4?t=1754480134","max":"http://video.akamai.steamstatic.com/store_trailers/257179033/movie_max.mp4?t=1754480134"},"name":"Teaser Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257179033/1e6369f4f0e2574b1ef89173f0bd7b8d213194c8/movie_600x337.jpg?t=1754480134","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257179033/movie480_vp9.webm?t=1754480134","max":"http://video.akamai.steamstatic.com/store_trailers/257179033/movie_max_vp9.webm?t=1754480134"}},{"highlight":true,"id":257045788,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257045788/movie480.mp4?t=1723545120","max":"http://video.akamai.steamstatic.com/store_trailers/257045788/movie_max.mp4?t=1723545120"},"name":"The Warfront Update trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257045788/movie.293x165.jpg?t=1723545120","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257045788/m