ai.steamstatic.com/store_item_assets/steam/apps/2767530/extras/3176e5328d0c92069f67cce633d46095.mp4?t=1763112388\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2767530/extras/b63847b283853840758c03ed6555d165.avif?t=1763112388\" width=850 height=80 /></span></p><p class=\"bb_paragraph\" >Gain experience by killing monsters, solving puzzles, and uncovering new locations. Level up to grow stronger, then shape your build with weapons, armor, and accessories that match your strategy and play style.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2767530/extras/6bced9832748879cea2bf7883465a4ce.poster.avif?t=1763112388\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2767530/extras/6bced9832748879cea2bf7883465a4ce.webm?t=1763112388\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2767530/extras/6bced9832748879cea2bf7883465a4ce.mp4?t=1763112388\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2767530/extras/b65c3edb6c3d6f3a24077134d9c6e56f.avif?t=1763112388\" width=850 height=80 /></span></p><p class=\"bb_paragraph\" >Survive in style with  50 unlockable costumes! All earned through exploration, challenges, and achievements.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2767530/extras/56ca7fb6fa26605ea1c2089effc7a4c3.avif?t=1763112388\" width=850 height=500 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared