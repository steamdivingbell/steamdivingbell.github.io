:"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Full controller support","id":28},{"description":"Camera Comfort","id":67},{"description":"Custom Volume Controls","id":68},{"description":"Keyboard Only Option","id":75},{"description":"Playable without Timed Input","id":74},{"description":"Stereo Sound","id":69},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"controller_support":"full","detailed_description":"<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/50d02925da1ce21bf87b574baf2aa245.poster.avif?t=1762196058\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/50d02925da1ce21bf87b574baf2aa245.webm?t=1762196058\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/50d02925da1ce21bf87b574baf2aa245.mp4?t=1762196058\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong><u>FEATURES</u></strong></p><p class=\"bb_paragraph\" ><strong>16 courses to race on!</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Standard Races - Race against your opponents and strive for 1st place</p></li><li><p class=\"bb_paragraph\" >Token Races - Collect all the tokens...AND also win the race</p></li><li><p class=\"bb_paragraph\" >Boss Races - Compete against several unique mechanical bosses in a 1v1 race</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/31b657620658362a3a97ff6f414eafdc.poster.avif?t=1762196058\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/31b657620658362a3a97ff6f414eafdc.webm?t=1762196058\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/31b657620658362a3a97ff6f414eafdc.mp4?t=1762196058\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Drifting / Boosting</strong> - Build up charge by drifting and release to boost</p><p class=\"bb_paragraph\" >Building up even more charge lets you use a super-boost!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/5de28ffae3dacd602666474447aa4b7d.poster.avif?t=1762196058\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/5de28ffae3dacd602666474447aa4b7d.webm?t=1762196058\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/5de28ffae3dacd602666474447aa4b7d.mp4?t=1762196058\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Items</strong> - Collect these to boost, attack, and lay hazards for your opponents</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/2aeae90cb5b146cc99abe138f4f388ff.poster.avif?t=1762196058\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/2aeae90cb5b146cc99abe138f4f388ff.webm?t=1762196058\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/2aeae90cb5b146cc99abe138f4f388ff.mp4?t=1762196058\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Hub World</strong> - Between races, you will explore a literal hub world -- Amusement Land itself! There are four unique areas, each with their own track entrances, as well as some secrets to uncover...</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/04c2d141d0c96b106c024515688a6650.poster.avif?t=1762196058\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/04c2d141d0c96b106c024515688a6650.webm?t=1762196058\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/extras/04c2d141d0c96b106c024515688a6650.mp4?t=1762196058\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong><u>STORY</u></strong></p><p class=\"bb_paragraph\" >Amusement Land is a rundown, abandoned theme park taken over by sentient animatronic creatures. In order to save Amusement Land, you (a mascot of the park) have to beat them all in a race to induce ego death in their core processing units. Along the way, you'll race with other mascots to train for dueling those mechanical baddies as well as explore the theme park itself.</p><p class=\"bb_paragraph\" ><strong><u>CONTROLS</u></strong></p><p class=\"bb_paragraph\" >The game is designed for controller input, but it is playable with a keyboard!</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Arrow Keys - Drive</p></li><li><p class=\"bb_paragraph\" >Space - Use Item / Boost</p></li><li><p class=\"bb_paragraph\" >Enter - Pause</p></li><li><p class=\"bb_paragraph\" >Z - Hop / Drift</p></li><li><p class=\"bb_paragraph\" >X - Accelerate</p></li><li><p class=\"bb_paragraph\" >C - Brake</p></li></ul><p class=\"bb_paragraph\" ><strong><u>OTHER INFO</u></strong></p><p class=\"bb_paragraph\" >This game was made entirely using free and open source software: Godot, Krita, Blender, and Aesprite! It's also heavily inspired by retro kart racers from the 90's and 2000's, if that's not already obvious enough.</p>","developers":["Doodle Donut"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Racing","id":"9"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3755680/a353109910ebd36eec7bf03d053dc7d0d829e783/header.jpg?t=1762196058","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Linux<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3755680/203504187/62f60e653d75b11751ca3664af1e7907c1cd4493/1759349829/dash_av1.mpd?t=1759948220","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3755680/203504187/62f60e653d75b11751ca3664af1e7907c1cd4493/1759349829/dash_h264.mpd?t=1759948220","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3755680/203504187/62f60e653d75b11751ca3664af1e7907c1cd4493/1759349829/hls_264_master.m3u8?t=1759948220","id":257210336,"name":"Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257210336/3f9df3eebaec10dabb08a25beffc5804994012b7/movie_600x337.jpg?t=1759948220"}],"name":"Critter Drifters","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Critter Drifters - <span class=\"discount_original_price\">$4.99</span> $2.49 USD","packageid":1321673,"percent_savings":0,"percent_savings_text":"-50% ","price_in_cents_with_discount":249}],"title":"Buy Critter Drifters"}],"packages":[1321673],"pc_requirements":{"minimum":"<strong>Minimum: