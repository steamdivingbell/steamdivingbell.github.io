c57fe7018.1920x1080.jpg?t=1761054582","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/ss_e86172e483aaa4a047bc600d6d9d97ec57fe7018.600x338.jpg?t=1761054582"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/ss_fbe18fd03f2e8027982c392e788dec0c53102b6a.1920x1080.jpg?t=1761054582","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/ss_fbe18fd03f2e8027982c392e788dec0c53102b6a.600x338.jpg?t=1761054582"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/ss_29bcbbb9b310173fd44f95199d247b9a73c737d6.1920x1080.jpg?t=1761054582","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/ss_29bcbbb9b310173fd44f95199d247b9a73c737d6.600x338.jpg?t=1761054582"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/ss_96422e85f7665b501d1ecb86ac2278ebdcaa5515.1920x1080.jpg?t=1761054582","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/ss_96422e85f7665b501d1ecb86ac2278ebdcaa5515.600x338.jpg?t=1761054582"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/c40223de42ed55489c82261af41ed5c7fa45c53e/ss_c40223de42ed55489c82261af41ed5c7fa45c53e.1920x1080.jpg?t=1761054582","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2126190/c40223de42ed55489c82261af41ed5c7fa45c53e/ss_c40223de42ed55489c82261af41ed5c7fa45c53e.600x338.jpg?t=1761054582"}],"short_description":"Rue Valley is a narrative RPG about a man trapped in a time loop, surrounded by a colorful cast with complex emotional stories, each hiding unexpected secrets. Dealing with mental challenges, the main character must rise from the depths, delving into the anomaly to uncover its enigmatic origins.","steam_appid":2126190,"support_info":{"email":"team@ruevalley.com","url":"https://ruevalley.com/"},"supported_languages":"English, French, German, Russian, Simplified Chinese","type":"game","website":"https://ruevalley.com/"}