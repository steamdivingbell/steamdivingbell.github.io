ival and death. When you die, your save file is wiped \u2014 no second chances.</p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853360/extras/62906de1d388ee67b978fbd2582d8a34.poster.avif?t=1752409656\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853360/extras/62906de1d388ee67b978fbd2582d8a34.webm?t=1752409656\" type=\"video/webm\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853360/extras/62906de1d388ee67b978fbd2582d8a34.mp4?t=1752409656\" type=\"video/mp4\"></video></div></p>","developers":["YOLO35GAMES PLT"],"fullgame":{"appid":"3435110","name":"Don't Freeze: A Winter Card Survival"},"genres":[{"description":"Adventure","id":"25"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3853360/fbc17b004346ef302419585a5086390670200982/header.jpg?t=1752409656","is_free":true,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 11 (Big Sur) or later<br></li><li><strong>Processor:</strong> Any Intel or Apple Silicon processor<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> 4 GB RAM</li></ul>"},"movies":[{"highlight":true,"id":257168082,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257168082/movie480.mp4?t=1752318472","max":"http://video.akamai.steamstatic.com/store_trailers/257168082/movie_max.mp4?t=1752318472"},"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257168082/b7d88653f095bac611fabe429e4a11bbd031af95/movie_600x337.jpg?t=1752318472","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257168082/movie480_vp9.webm?t=1752318472","max":"http: