5f0e538037d15f.1920x1080.jpg?t=1771943265","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3091140/c447c48d678726d36c11ea929b5f0e538037d15f/ss_c447c48d678726d36c11ea929b5f0e538037d15f.600x338.jpg?t=1771943265"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3091140/313270c000fec8f970b201f21816673bb6dc573e/ss_313270c000fec8f970b201f21816673bb6dc573e.1920x1080.jpg?t=1771943265","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3091140/313270c000fec8f970b201f21816673bb6dc573e/ss_313270c000fec8f970b201f21816673bb6dc573e.600x338.jpg?t=1771943265"}],"short_description":"Lootbound is a tactical loot management roguelike where you start solo and assemble your party as you go. Choose routes, risks, rewards, equip heroes and companions, and create a build to challenge the final boss. Turn-based combat, calculated risk, equipment synergies, and honest difficulty.","steam_appid":3091140,"support_info":{"email":"dmitry.komarov@games.artdock.studio","url":"https://games.artdock.studio/"},"supported_languages":"English, French, Spanish - Spain, Korean, Russian, Japanese, Portuguese - Brazil, Traditional Chinese, Simplified Chinese, Italian, German","type":"game","website":null}