9f6b5a62cecabd2ef/ss_31fecabc9bdc7fd07f1f10a9f6b5a62cecabd2ef.1920x1080.jpg?t=1756423873","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3971650/31fecabc9bdc7fd07f1f10a9f6b5a62cecabd2ef/ss_31fecabc9bdc7fd07f1f10a9f6b5a62cecabd2ef.600x338.jpg?t=1756423873"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3971650/7dbd31e8bf86e4344a38600d3bd961cd7dca1613/ss_7dbd31e8bf86e4344a38600d3bd961cd7dca1613.1920x1080.jpg?t=1756423873","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3971650/7dbd31e8bf86e4344a38600d3bd961cd7dca1613/ss_7dbd31e8bf86e4344a38600d3bd961cd7dca1613.600x338.jpg?t=1756423873"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3971650/5048f2a6725199803ade6e2e09a6f36413e7cf3a/ss_5048f2a6725199803ade6e2e09a6f36413e7cf3a.1920x1080.jpg?t=1756423873","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3971650/5048f2a6725199803ade6e2e09a6f36413e7cf3a/ss_5048f2a6725199803ade6e2e09a6f36413e7cf3a.600x338.jpg?t=1756423873"}],"short_description":"Factory builder and Rogue-lite are combined to new game. Summon familiars as worker and develop the production line on retro European style fantasy world. Stack synergy for mass production and repay the debt to win. In the hell ruled by capitalism, enjoy the amusing jokes exchanged by cute girls.","steam_appid":3971650,"support_info":{"email":"","url":"https://forms.gle/dz5NK1FrZZbq8VCM9"},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese, Korean, Russian","type":"game","website":"https://www.meltclock.co.jp/"}