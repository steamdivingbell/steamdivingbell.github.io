0/79422dc78738a7146e88dab468c89f0ffc2f03cf/ss_79422dc78738a7146e88dab468c89f0ffc2f03cf.1920x1080.jpg?t=1772744458","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4016010/79422dc78738a7146e88dab468c89f0ffc2f03cf/ss_79422dc78738a7146e88dab468c89f0ffc2f03cf.600x338.jpg?t=1772744458"}],"short_description":"Control one character with two players. One handles movement, the other handles actions. Precision, timing, and coordination are the only way to overcome challenging parkour platform levels.","steam_appid":4016010,"support_info":{"email":"contact@redaxegames.com","url":"https://redaxegames.com/"},"supported_languages":"English, French, Italian, German, Simplified Chinese, Japanese, Korean, Polish, Russian, Turkish","type":"game","website":null}