rn.</p><p class=\"bb_paragraph\" >Come and enjoy playing out your life!</p><p class=\"bb_paragraph\" >If you wish to contact us, you can join our QQ group: 817959767.</p>","developers":["ZZ Games"],"dlc":[4293420,3465770],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3393750/f13b6e8f844806c5cc25851d19751fdfe30ff11f/header.jpg?t=1770173333","is_free":false,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OS 10.17+<br></li><li><strong>Processor:</strong> <br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3393750/1586513750/dc2c1e581349f79bb29ca44994d2ffcf40354936/1769672574/dash_av1.mpd?t=1769673256","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3393750/1586513750/dc2c1e581349f79bb29ca44994d2ffcf40354936/1769672574/dash_h264.mpd?t=1769673256","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3393750/1586513750/dc2c1e581349f79bb29ca44994d2ffcf40354936/1769672574/hls_264_master.m3u8?t=1769673256","id":257080036,"name":"\u6211\u7684\u4eba\u751f\u5148\u5bfc\u7247","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257080036/5278dfe65eb830bd6593361a8c66aefc24b248e0/movie_600x337.jpg?t=1769673256"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3393750/1602767686/da1ed214aed6339df0e443dc12cbdefbfb30be3a/1769610618/dash_av1.mpd?t=1769670460","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3393750/1602767686/da1ed214aed6339df0e443dc12cbdefbfb30be3a/1769610618/dash_h264.mpd?t=1769670460","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/s