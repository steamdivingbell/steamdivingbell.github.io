 has it, it\u2019s all to raise awareness for <i>Amborettio</i>. Whatever the reason, your mission is clear: keep the pub buzzing, the customers smiling, and the orders flowing!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Music by Karl Casey @ White Bat Audio</p>","developers":["Wanech"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3958040/e206162ce85b68133050b98b72bbb8cbdf5a9fcc/header.jpg?t=1757492220","is_free":true,"legal_notice":"\u00a92025 Wanech","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3958040/219570508/9af86572efc65c9e9ea1bd7beccd1ac7321b6e22/1755457002/dash_av1.mpd?t=1755531863","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3958040/219570508/9af86572efc65c9e9ea1bd7beccd1ac7321b6e22/1755457002/dash_h264.mpd?t=1755531863","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3958040/219570508/9af86572efc65c9e9ea1bd7beccd1ac7321b6e22/1755457002/hls_264_master.m3u8?t=1755531863","id":257183341,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257183341/movie480.mp4?t=1755531863","max":"https://video.akamai.steamstatic.com/store_trailers/257183341/movie_max.mp4?t=1755531863"},"name":"Wanech's C.A.N. Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257183341/77bdb7719830c128fe2e255545d32c31ec867a6c/movie_600x337.jpg?t=1755531863","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257183341/movie480_vp9.webm?t=1755531863","max":"https://video.akamai.steamstatic.com/store_trailers/257183341/movie_max_vp9.webm?t=1755531863"}}],"name":"Wanech's C.A.N.","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li