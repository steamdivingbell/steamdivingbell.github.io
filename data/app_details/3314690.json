ai.steamstatic.com/store_item_assets/steam/apps/3314690/extras/200b453be81b3ee91039d85e3eaa4ec2.webm?t=1773077440\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3314690/extras/200b453be81b3ee91039d85e3eaa4ec2.mp4?t=1773077440\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Defend your Empire</h2><p class=\"bb_paragraph\" >Enemies are constantly threatening the empire. Collect defense and use it to fight them off.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3314690/extras/80decc2e7c218112f07267a931081892.poster.avif?t=1773077440\" width=610 height=370 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3314690/extras/80decc2e7c218112f07267a931081892.webm?t=1773077440\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3314690/extras/80decc2e7c218112f07267a931081892.mp4?t=1773077440\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Achieve Victory!</h2><p class=\"bb_paragraph\" >Choose your path to victory - Production, Defense, Wellness, Science, or Exploration. Each has a unique way to win.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3314690/extras/bc5cc8bef5ed5b262d9b2385238f8b47.poster.avif?t=1773077440\" width=800 height=398 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3314690/extras/bc5cc8bef5ed5b262d9b2385238f8b47.webm?t=1773077440\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3314690/extras/bc5cc8bef5ed5b262d9b2385238f8b47.mp4?t=1773077440\" type=\"video/mp4\"></video></span></p><h2 class