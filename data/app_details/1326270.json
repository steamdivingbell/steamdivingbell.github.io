4d0bb871f6c2774c6bf2406.poster.avif?t=1727971603\" width=600 height=114 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/29fe540fa4d0bb871f6c2774c6bf2406.webm?t=1727971603\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/29fe540fa4d0bb871f6c2774c6bf2406.mp4?t=1727971603\" type=\"video/mp4\"></video></span><br><br>With great contracts comes great responsibility. Sponsors might fund your dream production, but they come with high demands. Run your festival well to increase your reputation and get more funding the next time round! <br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/2c4edda249cbede8ffaa7d81da8484cd.poster.avif?t=1727971603\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/2c4edda249cbede8ffaa7d81da8484cd.webm?t=1727971603\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/2c4edda249cbede8ffaa7d81da8484cd.mp4?t=1727971603\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/f238eab29a6cfb7d13d4d23d7ddc89ac.poster.avif?t=1727971603\" width=600 height=114 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/f238eab29a6cfb7d13d4d23d7ddc89ac.webm?t=1727971603\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/f238eab29a6cfb7d13d4d23d7ddc89ac.mp4?t=1727971603\" type=\"video/mp4\"></video></span><br><br>Don\u2019t think you can relax once the show starts. From babysitting performers to picking up the trash, it\u2019s down to you to make sure everything runs perfectly!<br><br><strong>BUT THAT\u2019S NOT ALL\u2026!</strong><br><br><ul class=\"bb_ul\"><li>Design around themes like Halloween, Extreme Sports, or even a boozy Oktoberfest!<br></li><li>Micromanage your staff, hiring, firing, assigning tasks and setting patrol routes!<br></li><li>Use the Steam workshop to share and download other festivals from the community!<br></li><li>Choose from a range of biomes to create the perfect atmosphere for your festival!<br></li><li>And plenty more\u2026</li></ul><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/0c8c0fc9086ff411eced57b41e97b3c0.poster.avif?t=1727971603\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/0c8c0fc9086ff411eced57b41e97b3c0.webm?t=1727971603\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1326270/extras/0c8c0fc9086ff411eced57b41e97b3c0.mp4?t=1727971603\" type=\"video/mp4\"></video></span>","achievements":{"highlighted":[{"icon":"85cd1a0f736207b64ddf1af9d5bd3079e3cbeb83.jpg","localized_name":"Master of Puppets","name":"Master of Puppets","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/1326270/85cd1a0f736207b64ddf1af9d5bd3079e3cbeb83.jpg"},{"icon":"1dbae50098059f58968934d9daf1c6b7cd2a8415.jpg","localized_name":"Get In The Pit","name":"Get In The Pit","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/1326270/1dbae50098059f58968934d9daf1c6b7cd2a8415.jpg"},{"icon":"ac2a1c4966aab867fa7f9b2750bf84392bce16b3.jpg","localized_name":"MEEEETTTALLLL!!!!!","name":"MEEEETTTALLLL!!!!!","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/1326270/ac2a1c4966aab867fa7f9b2750bf84392bce16b3.jpg"},{"icon