49506301f0b6cc845ac4fe7/ss_9e910748c55d9c3fe49506301f0b6cc845ac4fe7.1920x1080.jpg?t=1749113212","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446840/9e910748c55d9c3fe49506301f0b6cc845ac4fe7/ss_9e910748c55d9c3fe49506301f0b6cc845ac4fe7.600x338.jpg?t=1749113212"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446840/211fc482824c8025dae2e01c7296e506bd2cd635/ss_211fc482824c8025dae2e01c7296e506bd2cd635.1920x1080.jpg?t=1749113212","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446840/211fc482824c8025dae2e01c7296e506bd2cd635/ss_211fc482824c8025dae2e01c7296e506bd2cd635.600x338.jpg?t=1749113212"}],"short_description":"RogueJack21 is a Blackjack-inspired deckbuilder where you build and upgrade your deck to battle your opponents. Navigate through procedurally generated casinos and take revenge on The House, the ruthless mafia ruling Noir City that stole everything from you.","steam_appid":3446840,"support_info":{"email":"zandboxstudio@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Spanish - Latin America, Traditional Chinese","type":"game","website":null}