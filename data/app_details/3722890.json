s://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3722890/e84fbdd700d38f4e7f90ef0e0620df457dfc7603/ss_e84fbdd700d38f4e7f90ef0e0620df457dfc7603.600x338.jpg?t=1773972126"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3722890/0d62043e90f013e7d096e36d8dde5c49f681ef31/ss_0d62043e90f013e7d096e36d8dde5c49f681ef31.1920x1080.jpg?t=1773972126","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3722890/0d62043e90f013e7d096e36d8dde5c49f681ef31/ss_0d62043e90f013e7d096e36d8dde5c49f681ef31.600x338.jpg?t=1773972126"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3722890/9caa63d15187665004e13c44fb180b0eb9a70a2f/ss_9caa63d15187665004e13c44fb180b0eb9a70a2f.1920x1080.jpg?t=1773972126","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3722890/9caa63d15187665004e13c44fb180b0eb9a70a2f/ss_9caa63d15187665004e13c44fb180b0eb9a70a2f.600x338.jpg?t=1773972126"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3722890/3bb778dfc5075c7113c018aa343a976c2f0b65ff/ss_3bb778dfc5075c7113c018aa343a976c2f0b65ff.1920x1080.jpg?t=1773972126","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3722890/3bb778dfc5075c7113c018aa343a976c2f0b65ff/ss_3bb778dfc5075c7113c018aa343a976c2f0b65ff.600x338.jpg?t=1773972126"}],"short_description":"In the beginning was the Void. Then came the Click. Forge reality across generators, upgrades, minigames, and infinite NG+ cycles. Draw cards, brew potions, unravel cosmic lore, and ascend through the creation itself. The Architects are watching.","steam_appid":3722890,"support_info":{"email":"jabranali721@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese, Polish, Turkish","type":"game","website":null}