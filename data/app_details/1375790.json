que environments.</p></li><li><p class=\"bb_paragraph\" ><strong>Steam Deck</strong><br>The game is the perfect relaxation game built for the steam deck and your favourite game controller but works beautifully with a mouse and keyboard too.</p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["Dried Lemons"],"genres":[{"description":"Casual","id":"4"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1375790/2ab13f5af75fb1a8feab42ddc953b392721e2daa/header.jpg?t=1769538356","is_free":false,"legal_notice":"Kakurenbo Neko \u00a9 All Rights Reserved.","linux_requirements":[],"mac_requirements":[],"name":"Kakurenbo Neko","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows<br></li><li><strong>Processor:</strong> Intel\u00ae 2 Core<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> DirectX 9<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Dried Lemons"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Q1 2027"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1375790/74f46d5c83d60225db0ae933e23665b1eedc17b8/ss_74f46d5c83d60225db0ae933e23665b1eedc17b8.1920x1080.jpg?t=1769538356","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1375790/74f46d5c83d60225db0ae933e23665b1eedc17b8/ss_74f46d5c83d60225db0ae933e23665b1eedc17b8.600x338.jpg?t=1769538356"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1375790/805edbfd89b96666b0be3385c42dcb853f01c9f1/ss_805e