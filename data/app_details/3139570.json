570/547d5ec2883a34d504fe94d3b44310def0a70fb2/ss_547d5ec2883a34d504fe94d3b44310def0a70fb2.600x338.jpg?t=1752687943"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3139570/d5d32e80c411c911de20dca3deba3d16b6953fce/ss_d5d32e80c411c911de20dca3deba3d16b6953fce.1920x1080.jpg?t=1752687943","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3139570/d5d32e80c411c911de20dca3deba3d16b6953fce/ss_d5d32e80c411c911de20dca3deba3d16b6953fce.600x338.jpg?t=1752687943"}],"short_description":"In this absurd co-op horror game you are medieval monks--and the only chefs who can prevent the apocalypse. Feed enormous monsters with a catapult, evade supernatural enemies, and navigate a reality-bending labyrinth with up to 4+ players!","steam_appid":3139570,"support_info":{"email":"press@strangescaffold.com","url":"https://discord.gg/dog-airport-game"},"supported_languages":"English","type":"game","website":"https://www.strangescaffold.com/"}