path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3019200/1d2075e073254b5a94e32b9e0e4670b94125b425/ss_1d2075e073254b5a94e32b9e0e4670b94125b425.600x338.jpg?t=1743209959"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3019200/678a33ce0b36ef01de9c686f76a3f772205b5e21/ss_678a33ce0b36ef01de9c686f76a3f772205b5e21.1920x1080.jpg?t=1743209959","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3019200/678a33ce0b36ef01de9c686f76a3f772205b5e21/ss_678a33ce0b36ef01de9c686f76a3f772205b5e21.600x338.jpg?t=1743209959"}],"short_description":"As the novice baker Lilia, you will immerse yourself in the warm town of MILKYWOOD. Gather ingredients in wilderness areas, interact with spirits, and hone your baking skills. Don't forget to open your bakery, and befriend the charming townsfolk! Everything is cozy &amp; relaxing. \ud83e\udd68\u2728","steam_appid":3019200,"support_info":{"email":"support@hippomonster.com","url":""},"supported_languages":"English, Simplified Chinese, Traditional Chinese","type":"game","website":null}