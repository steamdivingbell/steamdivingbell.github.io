ine redlining.</p>","developers":["FAS3 Estudios S.L."],"genres":[{"description":"Racing","id":"9"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3719540/ca188b427bd1c509c36ac8296053f314696fbab3/header.jpg?t=1751048692","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3719540/879754773/bf9094a5daf790ee83154b2fbe294b322fe49657/1750950780/dash_av1.mpd?t=1750954737","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3719540/879754773/bf9094a5daf790ee83154b2fbe294b322fe49657/1750950780/dash_h264.mpd?t=1750954737","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3719540/879754773/bf9094a5daf790ee83154b2fbe294b322fe49657/1750950780/hls_264_master.m3u8?t=1750954737","id":257161920,"name":"TOTAL DRIFTIN': Touge Dreams (Early access)","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257161920/3be7c4ab95237211f2d94e0b07d25fc29116d1a1/movie_600x337.jpg?t=1750954737"}],"name":"TOTAL DRIFTIN': Touge Dreams","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Total Driftin': Touge Dreams - <span class=\"discount_original_price\">$9.99</span> $1.99 USD","packageid":1309423,"percent_savings":0,"percent_savings_text":"-80% ","price_in_cents_with_discount":199}],"title":"Buy TOTAL DRIFTIN': Touge Dreams"}],"packages":[1309423],"pc_requirements":{"minimum":"<st