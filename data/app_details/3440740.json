://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3440740/ss_f84fbf2bd4e8de342e8af6c5561f26106d9f19e3.1920x1080.jpg?t=1773129616","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3440740/ss_f84fbf2bd4e8de342e8af6c5561f26106d9f19e3.600x338.jpg?t=1773129616"}],"short_description":"Embark on a grand adventure through a world full of mysteries, uncovering \u2018Discs\u2019 to collect your own party of creatures! Engage in strategic battles, enjoy an assortment of collectables, and meet unique characters along the way. A monster taming RPG with a blend of nostalgia and novelty!","steam_appid":3440740,"support_info":{"email":"support@phoenixx.ne.jp","url":"https://phoenixx.ne.jp/contactus/"},"supported_languages":"English, Japanese","type":"game","website":"https://picorinnesoft.main.jp/disc_creatures_world.html"}