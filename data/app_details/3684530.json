ai.steamstatic.com/store_item_assets/steam/apps/3684530/e98d80be48b97e3daf66fd8c407a3b449f349096/ss_e98d80be48b97e3daf66fd8c407a3b449f349096.600x338.jpg?t=1765221858"}],"short_description":"Falling balls, rare buffs, and steady upgrades unlock colorful, cozy stages and immersive environments.","steam_appid":3684530,"support_info":{"email":"bhg@black-heart.games","url":""},"supported_languages":"English, German, Japanese, Korean, Simplified Chinese, Thai, Traditional Chinese, Vietnamese, Russian, Spanish - Latin America","type":"game","website":"https://www.black-heart.games/plinkidle"}