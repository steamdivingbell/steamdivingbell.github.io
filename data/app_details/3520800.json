0800/extras/0c72071135742d1243d662dfdbd6e078.avif?t=1773501233\" width=800 height=346 /></span></p>","developers":["JDF GAMES"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3520800/cf843c82dd94525886c0436c7d198ec4e9161dc2/header.jpg?t=1773501233","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3520800/718470438/fe9147fe6f415ddeaf0d6d2505155d09eecdefb5/1750857822/dash_av1.mpd?t=1749072052","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3520800/718470438/fe9147fe6f415ddeaf0d6d2505155d09eecdefb5/1750857822/dash_h264.mpd?t=1749072052","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3520800/718470438/fe9147fe6f415ddeaf0d6d2505155d09eecdefb5/1750857822/hls_264_master.m3u8?t=1749072052","id":257124066,"name":"GraviTechTeaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257124066/07325f404995b048db4f874aa1b571a83c627963/movie_600x337.jpg?t=1749072052"}],"name":"GraviTech","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5-10300H<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GTX 1050 Ti<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["JDF GAMES"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"2026"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steam