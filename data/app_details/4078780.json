com/store_item_assets/steam/apps/4078780/32ed4a0a302d94af898bb7cb722ed3605c1976d1/ss_32ed4a0a302d94af898bb7cb722ed3605c1976d1.600x338.jpg?t=1760281690"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078780/704a17b37f3a3750bcd799695fb4ad384d18c8a3/ss_704a17b37f3a3750bcd799695fb4ad384d18c8a3.1920x1080.jpg?t=1760281690","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4078780/704a17b37f3a3750bcd799695fb4ad384d18c8a3/ss_704a17b37f3a3750bcd799695fb4ad384d18c8a3.600x338.jpg?t=1760281690"}],"short_description":"The world ended. Now the real nightmare begins. Deep underground, a child wakes in a infected facility. Minds are breaking. Bodies are changing. Crawl through vents, follow echoes, and escape before it\u2019s too late. Your mother is waiting.","steam_appid":4078780,"support_info":{"email":"dreamsproutgames@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"demo","website":null}