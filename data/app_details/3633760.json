m_assets/steam/apps/3633760/extras/fbc4ec36194e86e0e8eb9ad233cd07b4.poster.avif?t=1764941756\" width=1170 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3633760/extras/fbc4ec36194e86e0e8eb9ad233cd07b4.webm?t=1764941756\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3633760/extras/fbc4ec36194e86e0e8eb9ad233cd07b4.mp4?t=1764941756\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Your fast finger twitch reaction time deserves to be seen! Top the leader boards and share with your friends just how fast you are, and who knows, you might win special rewards now and then as one of the quickest fingers around.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Kalinarm"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3633760/23e57d565c70084a162c97f8f49b500e58576a18/header.jpg?t=1764941756","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3633760/1909274748/fb45d991d76c747c38ab0e03473f9898166b4852/1755534545/dash_av1.mpd?t=1755535285","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3633760/1909274748/fb45d991d76c747c38ab0e03473f9898166b4852/1755534545/dash_h264.mpd?t=1755535285","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3633760/1909274748/fb45d991d76c747c38ab0e03473f9898166b4852/1755534545/hls_264_master.m3u8?t=1755535285","id":257184945,"name":"Reveal Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257184945/c78dad7e31ed72d09a26d15f15f2567bdd708ff4/movie_600x337.jpg?t=1755535285"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3633760/118989705/8f48fefa88fb32df92b02b249