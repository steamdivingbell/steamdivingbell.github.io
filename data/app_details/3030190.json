civilization offers a fresh strategic experience.</p><p class=\"bb_paragraph\" ></p>","developers":["BetaLab"],"genres":[{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3030190/b3b54852dba026a8ca615d5eeee25c4188f65be4/header.jpg?t=1773208176","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3030190/1398289238/b5c08384612088118cf5a18b1804e0be39f2a0fd/1767680649/dash_av1.mpd?t=1767681186","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3030190/1398289238/b5c08384612088118cf5a18b1804e0be39f2a0fd/1767680649/dash_h264.mpd?t=1767681186","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3030190/1398289238/b5c08384612088118cf5a18b1804e0be39f2a0fd/1767680649/hls_264_master.m3u8?t=1767681186","id":257260370,"name":"PVEN","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257260370/3c962ab56f577c475d73160327f39de6c2c33823/movie_600x337.jpg?t=1767681186"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3030190/1220660556/cbc4a837f24c492e9906d0f46895f1659d6c2a8f/1753774080/dash_av1.mpd?t=1753784311","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3030190/1220660556/cbc4a837f24c492e9906d0f46895f1659d6c2a8f/1753774080/dash_h264.mpd?t=1753784311","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3030190/1220660556/cbc4a837f24c492e9906d0f46895f1659d6c2a8f/1753774080/hls_264_master.m3u8?t=1753784311","id":257175155,"name":"Gameplay video","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257175155/35a2953bea4e29b057ac3025739b37897a9e0011/movie_600x337.jpg?t=1753784311"}],"name":"Pandora's Toybox","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"