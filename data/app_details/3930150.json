-align: center\"><strong>Mr Toilet</strong> is not just about cleaning. It\u2019s a game of power in a place where no one wants to rule\u2026</h2>","developers":["Radikate"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3930150/2438adabb42f583a25c383420c540c495b1f4130/header.jpg?t=1771336654","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3930150/1931244288/14d0394f1e5c4dbfeb78d5d356494b88d5de680e/1771290365/dash_av1.mpd?t=1771332959","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3930150/1931244288/14d0394f1e5c4dbfeb78d5d356494b88d5de680e/1771290365/dash_h264.mpd?t=1771332959","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3930150/1931244288/14d0394f1e5c4dbfeb78d5d356494b88d5de680e/1771290365/hls_264_master.m3u8?t=1771332959","id":257281325,"name":"Demo Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257281325/7618c0ed7c8aa9c3dcb2793dd96a21c54a50a55f/movie_600x337.jpg?t=1771332959"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3930150/941414925/24dff36dc04f4e57d6ed362a625b5d7786d72d9d/1757930894/dash_av1.mpd?t=1758007068","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3930150/941414925/24dff36dc04f4e57d6ed362a625b5d7786d72d9d/1757930894/dash_h264.mpd?t=1758007068","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3930150/941414925/24dff36dc04f4e57d6ed362a625b5d7786d72d9d/1757930894/hls_264_master.m3u8?t=1758007068","id":257197947,"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257197947/68311b34d9d319ff17c69f91066577ea2b54f572/movie_600x337.jpg?t=1758007068"}],"name":"Mr Toilet","package_groups":[],"pc_re