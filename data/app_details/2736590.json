d0951c4ba83e68.1920x1080.jpg?t=1770902764","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2736590/fc273eac0fd1182efebc7cf208d0951c4ba83e68/ss_fc273eac0fd1182efebc7cf208d0951c4ba83e68.600x338.jpg?t=1770902764"}],"short_description":"Rebuild the world with Hexplorando, one hexagon at a time, creating wonderful landscapes. Unlock international landmarks and discover hidden gems in puzzle mode... and then use them all to reinvent the world in your creations!","steam_appid":2736590,"support_info":{"email":"hexplorando@gmail.com","url":""},"supported_languages":"English, Spanish - Spain","type":"game","website":null}