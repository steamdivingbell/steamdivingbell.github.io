/ss_da157eda66acf16cf5ef473c4d160ce0846a1bb1.1920x1080.jpg?t=1756508512","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2755280/da157eda66acf16cf5ef473c4d160ce0846a1bb1/ss_da157eda66acf16cf5ef473c4d160ce0846a1bb1.600x338.jpg?t=1756508512"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2755280/8716c56e8efba066fb4282db6f023d581c5314e6/ss_8716c56e8efba066fb4282db6f023d581c5314e6.1920x1080.jpg?t=1756508512","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2755280/8716c56e8efba066fb4282db6f023d581c5314e6/ss_8716c56e8efba066fb4282db6f023d581c5314e6.600x338.jpg?t=1756508512"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2755280/069c442e2050f87fb5893f7a163e3dfede9edeab/ss_069c442e2050f87fb5893f7a163e3dfede9edeab.1920x1080.jpg?t=1756508512","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2755280/069c442e2050f87fb5893f7a163e3dfede9edeab/ss_069c442e2050f87fb5893f7a163e3dfede9edeab.600x338.jpg?t=1756508512"}],"short_description":"Odor of Decay is an emotionally gripping first-person survival game set in the war-torn landscapes of Eastern Europe. As a citizen caught in the midst of an ongoing conflict, players must navigate the harrowing realities of war, making tough choices to survive amidst chaos and destruction.","steam_appid":2755280,"support_info":{"email":"iwanowskiwlodzimierz@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}