provide the creature with unique special abilities</p></li></ul><p class=\"bb_paragraph\">This results in millions of different ways to play the game!<br><br>Demo progress will carry over to the full release!</p>","developers":["SiRen Games"],"fullgame":{"appid":"1569240","name":"Evolve Lab"},"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3770570/f56e5c6fe8a4099387287bbf03fb35cd848a57ed/header.jpg?t=1748640353","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257145998,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257145998/movie480.mp4?t=1748446411","max":"http://video.akamai.steamstatic.com/store_trailers/257145998/movie_max.mp4?t=1748446411"},"name":"EvolveLabTrailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257145998/c161615a70f47fb92aa4f1564c6f8af5d5110071/movie_600x337.jpg?t=1748446411","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257145998/movie480_vp9.webm?t=1748446411","max":"http://video.akamai.steamstatic.com/store_trailers/257145998/movie_max_vp9.webm?t=1748446411"}}],"name":"Evolve Lab Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7, 8, 10 or 11<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> 128 MB<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["SiRen Games"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia","rating":"10","rating_generated":"1","required_age":"10","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"