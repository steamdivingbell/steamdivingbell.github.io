ice_overview":{"currency":"USD","discount_percent":0,"final":999,"final_formatted":"$9.99 USD","initial":999,"initial_formatted":""},"publishers":["Ikimasho"],"ratings":{"dejus":{"rating":"l"},"igrs":{"banned":"0","descriptors":"Kekerasan","rating":"13","rating_generated":"1","required_age":"13","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"6","rating_generated":"1","required_age":"6","use_age_gate":"0"}},"release_date":{"coming_soon":false,"date":"22 Oct, 2020"},"required_age":0,"reviews":"\u201cStunning visuals, fun gameplay, and groovy tunes combine to make this an instant favourite\u201d<br />\r\nVR Explorer<br />\r\n<br />\r\n\u201cI can definitely recommend the game to fans of Star Pirate Trainer or Pistol Whip.\u201d<br />\r\nPIXEL.DE<br />\r\n<br />\r\n\u201cIt\u2019s a brilliantly fluid approach to VR gunplay, swapping out the raw, often rigid intricacies of realistic weapon reloading for something with decided pace and groove.\u201d<br />\r\nUploadVR<br />\r\n","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1258580/ss_c1e47ea1df81f49e159c078724451af8270632a2.1920x1080.jpg?t=1634652463","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1258580/ss_c1e47ea1df81f49e159c078724451af8270632a2.600x338.jpg?t=1634652463"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1258580/ss_eeb6deb454f322611aeb5ddc452ca945fae9cae7.1920x1080.jpg?t=1634652463","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1258580/ss_eeb6deb454f322611aeb5ddc452ca945fae9cae7.600x338.jpg?t=1634652463"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1258580/ss_6300944bc74b5311f485a5823fe801f4aa20f584.1920x1080.jpg?t=1634652463","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1258580/ss_6300944bc74b5311f485a5823f