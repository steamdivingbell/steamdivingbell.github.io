mongst your population and use them to grow your dynasty, a strong dynasty is crucial for survival but be aware of those plotting against you.</p><p class=\"bb_paragraph\" ></p>","developers":["Nikous Studio"],"genres":[{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2849000/ce5e45e74d339d2e6138259c340bcb7284b52eac/header.jpg?t=1762113739","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2849000/1301186241/2ef32480941acc3c3baebb53ebc3c3c9c7783573/1760199705/dash_av1.mpd?t=1760203176","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2849000/1301186241/2ef32480941acc3c3baebb53ebc3c3c9c7783573/1760199705/dash_h264.mpd?t=1760203176","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2849000/1301186241/2ef32480941acc3c3baebb53ebc3c3c9c7783573/1760199705/hls_264_master.m3u8?t=1760203176","id":257093865,"name":"Ascendant Dawn Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257093865/9f9950e642014a850ca6772adf5a6924366b853e/movie_600x337.jpg?t=1760203176"}],"name":"Ascendant Dawn","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> i5<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GTX 660 / Radeon 370<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 5 GB availab