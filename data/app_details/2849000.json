a563ebc920b44f1ea20938dcb882ea25d4f054e.600x338.jpg?t=1762113739"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2849000/07595788a9ecc2b2c86c06850e00369da9b3a47b/ss_07595788a9ecc2b2c86c06850e00369da9b3a47b.1920x1080.jpg?t=1762113739","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2849000/07595788a9ecc2b2c86c06850e00369da9b3a47b/ss_07595788a9ecc2b2c86c06850e00369da9b3a47b.600x338.jpg?t=1762113739"}],"short_description":"Ascendant Dawn is a grand strategy game where you lead a nomadic tribe in a brutal bronze age world. Work your way up from a small clan to a great empire by founding cities and conquering your enemies.","steam_appid":2849000,"support_info":{"email":"AscendantDawn@proton.me","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}