ybe he needs your help more than you think!</p><p class=\"bb_paragraph\" ><strong>Add it to your Wishlist today and don\u2019t miss the release!</strong></p><p class=\"bb_paragraph\" ></p>","developers":["Gest.LT"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3273260/2ffe43be2003e0032a99980d6990183809bcca71/header.jpg?t=1763628425","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3273260/856674/664cbdf33ffd521d1013aa9492cca0f37c03c831/1750886602/dash_av1.mpd?t=1744278160","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3273260/856674/664cbdf33ffd521d1013aa9492cca0f37c03c831/1750886602/dash_h264.mpd?t=1744278160","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3273260/856674/664cbdf33ffd521d1013aa9492cca0f37c03c831/1750886602/hls_264_master.m3u8?t=1744278160","id":257117919,"name":"Lost Host - Early Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257117919/7c90a01ebd750803fc19c46759c6ca09381da938/movie_600x337.jpg?t=1744278160"}],"name":"Lost Host","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Ryzen 5 3600<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia GeForce GTX1050<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Ryzen 5 3600<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia GeForce RTX3060<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>"},"platforms":{"linux":false,"mac":