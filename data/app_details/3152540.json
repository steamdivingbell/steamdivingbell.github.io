ai.steamstatic.com/store_item_assets/steam/apps/3152540/ss_c90f5cadd6037e576ede12dbf6d10a6c5b01b8ea.600x338.jpg?t=1745324038"},{"id":19,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3152540/3e554dcc41f03f80b67fe80fc7141e372b99f44d/ss_3e554dcc41f03f80b67fe80fc7141e372b99f44d.1920x1080.jpg?t=1745324038","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3152540/3e554dcc41f03f80b67fe80fc7141e372b99f44d/ss_3e554dcc41f03f80b67fe80fc7141e372b99f44d.600x338.jpg?t=1745324038"}],"short_description":"Transform your passion into profit with hydroponics! Design, build, and manage your own sustainable farming and business system. Experiment with different plants and fish, customize your setup, supply the market needs, and harvest your success. Dive into the future of farming today!","steam_appid":3152540,"support_info":{"email":"contact@bewolba.com","url":"https://www.bewolba.com"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Dutch, Indonesian, Japanese, Korean, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Traditional Chinese, Hungarian, Polish, Turkish, Ukrainian","type":"game","website":"https://www.bewolba.com"}