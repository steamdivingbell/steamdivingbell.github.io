ight=877 /></span></p></li></ul><p class=\"bb_paragraph\" >Whether you want to test yourself by merging fruits against increasing difficulty, or relax as a merchant in a peaceful town full of fruits and animals, this game offers a unique and enjoyable experience.</p>","developers":["raevoxgame"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3977470/a79902e173ab952fe151415b1027e70f3abec23c/header.jpg?t=1758025665","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257193859,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257193859/movie480.mp4?t=1757125529","max":"http://video.akamai.steamstatic.com/store_trailers/257193859/movie_max.mp4?t=1757125529"},"name":"Mega Fruit Fragman","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257193859/8f517bd861d9551657aa3f74c8207709ae349b6e/movie_600x337.jpg?t=1757125529","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257193859/movie480_vp9.webm?t=1757125529","max":"http://video.akamai.steamstatic.com/store_trailers/257193859/movie_max_vp9.webm?t=1757125529"}}],"name":"Mega Fruit","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Mega Fruit - <span class=\"discount_original_price\">$2.99</span> $2.39 USD","packageid":1396405,"percent_savings":0,"percent_savings_text":"-20% ","price_in_cents_with_discount":239}],"title":"Buy Mega Fruit"}],"packages":[1396405],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><stron