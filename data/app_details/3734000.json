store_item_assets/steam/apps/3734000/ddf171eeea3b05ca6eb74d01a2ee0fdf227c8041/ss_ddf171eeea3b05ca6eb74d01a2ee0fdf227c8041.600x338.jpg?t=1748691475"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3734000/d2a374681cf120b0d5c04acd50d96aceb0e89748/ss_d2a374681cf120b0d5c04acd50d96aceb0e89748.1920x1080.jpg?t=1748691475","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3734000/d2a374681cf120b0d5c04acd50d96aceb0e89748/ss_d2a374681cf120b0d5c04acd50d96aceb0e89748.600x338.jpg?t=1748691475"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3734000/c939945774e1e73e309a75228980072b6f6c0600/ss_c939945774e1e73e309a75228980072b6f6c0600.1920x1080.jpg?t=1748691475","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3734000/c939945774e1e73e309a75228980072b6f6c0600/ss_c939945774e1e73e309a75228980072b6f6c0600.600x338.jpg?t=1748691475"}],"short_description":"Play as a brave little chicken defending the farm from zombie animals while the farmer\u2019s away! Build towers, grow crops, and stop a mad scientist's undead army in this chaotic, comedy-filled tower defense game.","steam_appid":3734000,"support_info":{"email":"bonesai.dev@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}