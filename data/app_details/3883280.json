395a52205151dc2907dbe319/ss_0a2406b525c942e1395a52205151dc2907dbe319.1920x1080.jpg?t=1759157321","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3883280/0a2406b525c942e1395a52205151dc2907dbe319/ss_0a2406b525c942e1395a52205151dc2907dbe319.600x338.jpg?t=1759157321"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3883280/fae2da7308b7734324e0d4c0824c79e23855af92/ss_fae2da7308b7734324e0d4c0824c79e23855af92.1920x1080.jpg?t=1759157321","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3883280/fae2da7308b7734324e0d4c0824c79e23855af92/ss_fae2da7308b7734324e0d4c0824c79e23855af92.600x338.jpg?t=1759157321"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3883280/38558c52d9ca39b82d58e9f9aff78f0d2304d7fe/ss_38558c52d9ca39b82d58e9f9aff78f0d2304d7fe.1920x1080.jpg?t=1759157321","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3883280/38558c52d9ca39b82d58e9f9aff78f0d2304d7fe/ss_38558c52d9ca39b82d58e9f9aff78f0d2304d7fe.600x338.jpg?t=1759157321"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3883280/1f1b26f0ac9afeff8ee7029f8e175b31c9b3dfb1/ss_1f1b26f0ac9afeff8ee7029f8e175b31c9b3dfb1.1920x1080.jpg?t=1759157321","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3883280/1f1b26f0ac9afeff8ee7029f8e175b31c9b3dfb1/ss_1f1b26f0ac9afeff8ee7029f8e175b31c9b3dfb1.600x338.jpg?t=1759157321"}],"short_description":"CO-OP TWINS \u2013 a two-player cooperative deck-building roguelike. Split-screen chaos. Two players, one rhythm, one deck. Total co-op mayhem. Rhythm action meets deck-building card play. Two players, one body. This is fusion co-op like you\u2019ve never seen.","steam_appid":3883280,"support_info":{"email":"team2twoplayer@gmail.com","url":"https://teamblens-octoraid.oopy.io/twoplayer"},"supported_languages":"English, Korean","type":"game","website":null}