d/ss_920799d3a0e6aaab5a7606093197b3162b0080ad.600x338.jpg?t=1772472634"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3776810/1cac921c123f095e2fb45fa676fef2e5e8952619/ss_1cac921c123f095e2fb45fa676fef2e5e8952619.1920x1080.jpg?t=1772472634","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3776810/1cac921c123f095e2fb45fa676fef2e5e8952619/ss_1cac921c123f095e2fb45fa676fef2e5e8952619.600x338.jpg?t=1772472634"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3776810/3e4073f370b33bd1e93cb11354cd5ba33248e302/ss_3e4073f370b33bd1e93cb11354cd5ba33248e302.1920x1080.jpg?t=1772472634","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3776810/3e4073f370b33bd1e93cb11354cd5ba33248e302/ss_3e4073f370b33bd1e93cb11354cd5ba33248e302.600x338.jpg?t=1772472634"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3776810/14c2eb0b088b0c70e2d788460de685f8c128f401/ss_14c2eb0b088b0c70e2d788460de685f8c128f401.1920x1080.jpg?t=1772472634","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3776810/14c2eb0b088b0c70e2d788460de685f8c128f401/ss_14c2eb0b088b0c70e2d788460de685f8c128f401.600x338.jpg?t=1772472634"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3776810/48d8a9afece5368d96b81c360e96076eb79d1218/ss_48d8a9afece5368d96b81c360e96076eb79d1218.1920x1080.jpg?t=1772472634","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3776810/48d8a9afece5368d96b81c360e96076eb79d1218/ss_48d8a9afece5368d96b81c360e96076eb79d1218.600x338.jpg?t=1772472634"}],"short_description":"Not Guilty! is a prison warden and executioner simulator. Become a scumbag: fabricate cases, spend the prison budget on your own whims, and EXECUTE PEOPLE IN DOZENS OF WAYS. Or try to stay human\u2026 if you can.","steam_appid":3776810,"support_info":{"email":"am@panacotagames.com","url":""},"supported_languages":"English<strong>*</strong>, Turkish, Norwegian, French, Italian, German, Spanish - Spain, Russian<strong>*</strong>, Simplified Chinese, Portuguese - Portugal<br><strong>*</strong>languages with full audio support","type":"game","website":null}