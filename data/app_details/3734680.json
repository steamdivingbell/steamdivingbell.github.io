4680/f4114c67e8a3a5ee5dcd02374c7c45b8de4cca99/ss_f4114c67e8a3a5ee5dcd02374c7c45b8de4cca99.600x338.jpg?t=1774281171"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3734680/d41166d1836e8eea4e241c4b93ffabcddfb4b7f3/ss_d41166d1836e8eea4e241c4b93ffabcddfb4b7f3.1920x1080.jpg?t=1774281171","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3734680/d41166d1836e8eea4e241c4b93ffabcddfb4b7f3/ss_d41166d1836e8eea4e241c4b93ffabcddfb4b7f3.600x338.jpg?t=1774281171"}],"short_description":"You are a playboy, fearless of bloody endings, whom even Casanova would envy: Once you get killed, time rewinds. Death may never defeat you, yet... fate prevails.","steam_appid":3734680,"support_info":{"email":"heartmansiongames@hotmail.com","url":""},"supported_languages":"Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}