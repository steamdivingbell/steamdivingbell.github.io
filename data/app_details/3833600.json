amai.steamstatic.com/store_item_assets/steam/apps/3833600/5a933cff7790f4aa8d1c09926ff6414af0d5cca2/ss_5a933cff7790f4aa8d1c09926ff6414af0d5cca2.600x338.jpg?t=1768943815"}],"short_description":"SIRO \u2014 As children, our dreams are pure and burning, yet fragile. Growing up brings compromise, and with each one, those dreams fade a little. As ordinary people, we are inevitably drawn into the fray.","steam_appid":3833600,"support_info":{"email":"yt@xsoftstudio.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Russian, Simplified Chinese, Traditional Chinese, Turkish","type":"game","website":null}