_assets/steam/apps/3879060/5407bed42df57b2e39ae7c00c7452e46a5569689/ss_5407bed42df57b2e39ae7c00c7452e46a5569689.1920x1080.jpg?t=1755389016","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879060/5407bed42df57b2e39ae7c00c7452e46a5569689/ss_5407bed42df57b2e39ae7c00c7452e46a5569689.600x338.jpg?t=1755389016"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879060/55d37accf0c76825191c859fe23475b0344f6831/ss_55d37accf0c76825191c859fe23475b0344f6831.1920x1080.jpg?t=1755389016","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879060/55d37accf0c76825191c859fe23475b0344f6831/ss_55d37accf0c76825191c859fe23475b0344f6831.600x338.jpg?t=1755389016"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879060/8b621c4a19b23ce5709818f193278fef7df036c3/ss_8b621c4a19b23ce5709818f193278fef7df036c3.1920x1080.jpg?t=1755389016","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3879060/8b621c4a19b23ce5709818f193278fef7df036c3/ss_8b621c4a19b23ce5709818f193278fef7df036c3.600x338.jpg?t=1755389016"}],"short_description":"In this roguelite horror, rescue survivors on a spaceship tainted by nightmares. Track an invisible foe through anomalies leaking into reality. Use the &quot;Dream Shader&quot; to reveal and fight the enemy. Scarce resources and split-second decisions will determine your survival.","steam_appid":3879060,"support_info":{"email":"","url":"encmails@gmail.com"},"supported_languages":"English, Japanese","type":"game","website":null}