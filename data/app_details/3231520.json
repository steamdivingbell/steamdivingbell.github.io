 allowing you to play as Edward, Juliet, and 4 of the game's bosses!</p></li></ul>","developers":["Cache of Bones"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3231520/header.jpg?t=1770746441","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3231520/1690410519/88b223f87e1bbfe6ff5aa1770761d55afe138dc3/1757102581/dash_av1.mpd?t=1757106999","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3231520/1690410519/88b223f87e1bbfe6ff5aa1770761d55afe138dc3/1757102581/dash_h264.mpd?t=1757106999","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3231520/1690410519/88b223f87e1bbfe6ff5aa1770761d55afe138dc3/1757102581/hls_264_master.m3u8?t=1757106999","id":257193806,"name":"Launch Trailer 01","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257193806/87a114631669a97ba921396657818b2fc47db2d0/movie_600x337.jpg?t=1757106999"}],"name":"The Bleakest Keep","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"The Bleakest Keep - $9.99 USD","packageid":1145548,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":999}],"title":"Buy The Bleakest Keep"}],"packages":[1145548],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7+<br></li><li><strong>Processor:</strong> 3.5 GHz<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> 4GB<br></li><li><strong>Storage:</strong> 298 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul 