ai.steamstatic.com/store_item_assets/steam/apps/3552520/9aa367e1528015dfb72bb5cd2a0957fce19c5e08/ss_9aa367e1528015dfb72bb5cd2a0957fce19c5e08.1920x1080.jpg?t=1762105942","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/9aa367e1528015dfb72bb5cd2a0957fce19c5e08/ss_9aa367e1528015dfb72bb5cd2a0957fce19c5e08.600x338.jpg?t=1762105942"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/d6cc954a4f6f999332d9b77f1d02bfa6f3a2b494/ss_d6cc954a4f6f999332d9b77f1d02bfa6f3a2b494.1920x1080.jpg?t=1762105942","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/d6cc954a4f6f999332d9b77f1d02bfa6f3a2b494/ss_d6cc954a4f6f999332d9b77f1d02bfa6f3a2b494.600x338.jpg?t=1762105942"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/14e323ccde66382ac45b12683f8e93731bee6788/ss_14e323ccde66382ac45b12683f8e93731bee6788.1920x1080.jpg?t=1762105942","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/14e323ccde66382ac45b12683f8e93731bee6788/ss_14e323ccde66382ac45b12683f8e93731bee6788.600x338.jpg?t=1762105942"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/68d1571d6b5a78c4930645c25b3c670799e0ca8d/ss_68d1571d6b5a78c4930645c25b3c670799e0ca8d.1920x1080.jpg?t=1762105942","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/68d1571d6b5a78c4930645c25b3c670799e0ca8d/ss_68d1571d6b5a78c4930645c25b3c670799e0ca8d.600x338.jpg?t=1762105942"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/98096ecdad3f75fcf3d321b0f69ee2e0681abcf6/ss_98096ecdad3f75fcf3d321b0f69ee2e0681abcf6.1920x1080.jpg?t=1762105942","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/98096ecdad3f75fcf3d321b0f69ee2e0681abcf6/ss_98096ecdad3f75fcf3d321b0f69ee2e0681abc