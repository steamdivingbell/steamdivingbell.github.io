8b6e7a939c766d620a5addb5bc2db4e90/ss_49ba0c38b6e7a939c766d620a5addb5bc2db4e90.600x338.jpg?t=1758934129"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/21d9780524872d83e2a83036181493bd331e47a5/ss_21d9780524872d83e2a83036181493bd331e47a5.1920x1080.jpg?t=1758934129","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/21d9780524872d83e2a83036181493bd331e47a5/ss_21d9780524872d83e2a83036181493bd331e47a5.600x338.jpg?t=1758934129"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/e5803813404bcbed99e264079c7efb71315a9976/ss_e5803813404bcbed99e264079c7efb71315a9976.1920x1080.jpg?t=1758934129","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/e5803813404bcbed99e264079c7efb71315a9976/ss_e5803813404bcbed99e264079c7efb71315a9976.600x338.jpg?t=1758934129"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/8559f81389fe212337510167260dde82a85bd0d5/ss_8559f81389fe212337510167260dde82a85bd0d5.1920x1080.jpg?t=1758934129","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552520/8559f81389fe212337510167260dde82a85bd0d5/ss_8559f81389fe212337510167260dde82a85bd0d5.600x338.jpg?t=1758934129"}],"short_description":"Raising simulation meets cute and cozy heroic fantasy. Learn awesome skills from classes. Train hard and fight enemies in turn based JRPG combat to get stronger. Go on adventures to complete missions assigned by her majesty. Featuring an anime art style, Live2D animation, and adorable enemies.","steam_appid":3552520,"support_info":{"email":"everdistantsky@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}