steam/apps/2846320/ss_9024134c768df8da0e58db95030af53261df0f2a.1920x1080.jpg?t=1760268365","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2846320/ss_9024134c768df8da0e58db95030af53261df0f2a.600x338.jpg?t=1760268365"}],"short_description":"Save your goddess Gaia from all incoming enemies by manipulating the earth around you!","steam_appid":2846320,"support_info":{"email":"imakumiindustries@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}