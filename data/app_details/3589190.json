71"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3589190/727c32e633750a618855d440c4c18d3e9f8f9426/ss_727c32e633750a618855d440c4c18d3e9f8f9426.1920x1080.jpg?t=1770008571","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3589190/727c32e633750a618855d440c4c18d3e9f8f9426/ss_727c32e633750a618855d440c4c18d3e9f8f9426.600x338.jpg?t=1770008571"}],"short_description":"COCOBOY is a 2D puzzle platformer within a 3D retro gaming simulation. Hack an \u201980s cult classic with modded abilities, decorate your bedroom with rare collectibles, and scour a 2005 gaming forum where a peculiar fandom takes root.","steam_appid":3589190,"support_info":{"email":"cocoteam.games@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}