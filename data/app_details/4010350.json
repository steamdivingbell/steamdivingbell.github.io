mstatic.com/store_item_assets/steam/apps/4010350/efd6b40ff0ba6c90140ba4b1974a838549675759/ss_efd6b40ff0ba6c90140ba4b1974a838549675759.1920x1080.jpg?t=1761747247","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4010350/efd6b40ff0ba6c90140ba4b1974a838549675759/ss_efd6b40ff0ba6c90140ba4b1974a838549675759.600x338.jpg?t=1761747247"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4010350/8592dd6496a9a89bd367f48612723be6f3fd14a1/ss_8592dd6496a9a89bd367f48612723be6f3fd14a1.1920x1080.jpg?t=1761747247","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4010350/8592dd6496a9a89bd367f48612723be6f3fd14a1/ss_8592dd6496a9a89bd367f48612723be6f3fd14a1.600x338.jpg?t=1761747247"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4010350/22476b5467ebc69568a589080640e1d5b5da6d84/ss_22476b5467ebc69568a589080640e1d5b5da6d84.1920x1080.jpg?t=1761747247","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4010350/22476b5467ebc69568a589080640e1d5b5da6d84/ss_22476b5467ebc69568a589080640e1d5b5da6d84.600x338.jpg?t=1761747247"}],"short_description":"IT LURKS is a survival horror game set in an infested sewer. Hunted by a relentless presence, you must recover scattered data tapes and piece together a way to transmit them topside. Every step brings you closer to escape\u2026 or into its grasp.","steam_appid":4010350,"support_info":{"email":"","url":"https://www.alexlemesurier.com/"},"supported_languages":"English","type":"game","website":null}