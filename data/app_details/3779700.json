assets/steam/apps/3779700/ed515b670b874854da5afafee6fdb260cea47a71/ss_ed515b670b874854da5afafee6fdb260cea47a71.1920x1080.jpg?t=1773575550","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3779700/ed515b670b874854da5afafee6fdb260cea47a71/ss_ed515b670b874854da5afafee6fdb260cea47a71.600x338.jpg?t=1773575550"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3779700/fc4f32fc8f088f8aa6f3d056a17fe20e1e822214/ss_fc4f32fc8f088f8aa6f3d056a17fe20e1e822214.1920x1080.jpg?t=1773575550","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3779700/fc4f32fc8f088f8aa6f3d056a17fe20e1e822214/ss_fc4f32fc8f088f8aa6f3d056a17fe20e1e822214.600x338.jpg?t=1773575550"}],"short_description":"A narrative walking experience through the real lives of women living under Islamic law in Iran. Their stories were never meant to be heard. Now you can walk through them.","steam_appid":3779700,"support_info":{"email":"WeRememberGames@proton.me","url":""},"supported_languages":"English","type":"game","website":null}