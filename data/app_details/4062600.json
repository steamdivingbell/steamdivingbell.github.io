.akamai.steamstatic.com/store_item_assets/steam/apps/4062600/a573d585a9b3c8ca1e120240b1fde2b0bf8d2ca6/ss_a573d585a9b3c8ca1e120240b1fde2b0bf8d2ca6.600x338.jpg?t=1773670412"}],"short_description":"A Week in Paradise is an interactive narrative mystery. Discover the unusual circumstances of your arrival to a bar called Paradise, and drink through the night with the bar's charismatic regular. Each night, unravel the threads holding back memories in your dreams.","steam_appid":4062600,"support_info":{"email":"WaifuTrashFamily@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}