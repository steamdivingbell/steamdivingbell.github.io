ared.akamai.steamstatic.com/store_item_assets/steam/apps/4006340/770cf1d8977903a941721d3e6ec538c7b6825d3e/ss_770cf1d8977903a941721d3e6ec538c7b6825d3e.1920x1080.jpg?t=1759246435","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4006340/770cf1d8977903a941721d3e6ec538c7b6825d3e/ss_770cf1d8977903a941721d3e6ec538c7b6825d3e.600x338.jpg?t=1759246435"}],"short_description":"Solve and construct sci-fi puzzle boxes into the First Moon of Mercury, a space station designed to study and deflect dangerous solar flares. Will you trust the right crew members to ensure the safety of humanity or will the saboteurs succeed?","steam_appid":4006340,"support_info":{"email":"contact@stitchmedia.ca","url":"http://firstmoonofmercury.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://firstmoonofmercury.com"}