eam/apps/2339000/e42da679b4811e77f63326abf8375672b7000b91/ss_e42da679b4811e77f63326abf8375672b7000b91.600x338.jpg?t=1772051020"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2339000/bf5fd53a922917716c435ca60a29f6aa37b57fbe/ss_bf5fd53a922917716c435ca60a29f6aa37b57fbe.1920x1080.jpg?t=1772051020","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2339000/bf5fd53a922917716c435ca60a29f6aa37b57fbe/ss_bf5fd53a922917716c435ca60a29f6aa37b57fbe.600x338.jpg?t=1772051020"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2339000/1ac13a675cf349077f3304eb428b3f9df571f3aa/ss_1ac13a675cf349077f3304eb428b3f9df571f3aa.1920x1080.jpg?t=1772051020","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2339000/1ac13a675cf349077f3304eb428b3f9df571f3aa/ss_1ac13a675cf349077f3304eb428b3f9df571f3aa.600x338.jpg?t=1772051020"}],"short_description":"Explore a whimsical island to find\u2026 pie recipes?! Bake them by gathering or growing ingredients, which may be the key to helping out your new found quirky friends leave the island! In this wholesome 3D platformer collectathon, you can enjoy discovering the world freely at your own pace.","steam_appid":2339000,"support_info":{"email":"support@letuscookgames.com","url":""},"supported_languages":"English, French","type":"game","website":"https://portabellowsgame.com/"}