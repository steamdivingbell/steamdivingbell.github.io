.jpg?t=1756810315","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/70ab1b38ef83c44e6ffdeaf58c0400723edd98f7/ss_70ab1b38ef83c44e6ffdeaf58c0400723edd98f7.600x338.jpg?t=1756810315"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/bca595fee0c1abb91ccc98e276a36862ab6b6e53/ss_bca595fee0c1abb91ccc98e276a36862ab6b6e53.1920x1080.jpg?t=1756810315","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/bca595fee0c1abb91ccc98e276a36862ab6b6e53/ss_bca595fee0c1abb91ccc98e276a36862ab6b6e53.600x338.jpg?t=1756810315"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/54e17e22dc83356e7c023ea7114c5a8896f89dfc/ss_54e17e22dc83356e7c023ea7114c5a8896f89dfc.1920x1080.jpg?t=1756810315","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/54e17e22dc83356e7c023ea7114c5a8896f89dfc/ss_54e17e22dc83356e7c023ea7114c5a8896f89dfc.600x338.jpg?t=1756810315"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/19141bff5e8512a7f068cdec2f7c091431acb2aa/ss_19141bff5e8512a7f068cdec2f7c091431acb2aa.1920x1080.jpg?t=1756810315","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/19141bff5e8512a7f068cdec2f7c091431acb2aa/ss_19141bff5e8512a7f068cdec2f7c091431acb2aa.600x338.jpg?t=1756810315"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/4478eece1d6ed070afcccd5d38af28b781da1442/ss_4478eece1d6ed070afcccd5d38af28b781da1442.1920x1080.jpg?t=1756810315","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/4478eece1d6ed070afcccd5d38af28b781da1442/ss_4478eece1d6ed070afcccd5d38af28b781da1442.600x338.jpg?t=1756810315"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/0f4f2f46d83af8088ea9a2e42f9ad5f0e98f5580/ss_0f4f2f46d83af8088ea9a2e42f9ad5f0e98f5580.1920x1080.jpg?t=1756810315","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2953520/0f4f2f46d83af8088ea9a2e42f9ad5f0e98f5580/ss_0f4f2f46d83af8088ea9a2e42f9ad5f0e98f5580.600x338.jpg?t=1756810315"}],"short_description":"A Strategy RPG where you live freely in a vast medieval feudal-simulated sandbox. Listen to the requests of the citizens, trade, plunder, serve, own a territory as a noble, usurp the throne, endless wars, and betrayal. The intertwining of your and numerous NPCs' intentions creates unique stories.","steam_appid":2953520,"support_info":{"email":"info.tatamibeya@gmail.com","url":""},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese","type":"game","website":"https://end-of-history.worldmap-game.com/"}