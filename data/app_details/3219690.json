 part of the bestiary, and try out the level 1 skill tree.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3219690/extras/small_banner_shop.jpg?t=1748232215\" /></p>","developers":["Stone Prods"],"fullgame":{"appid":"3168610","name":"Beats Of Un'sonia"},"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3219690/b8428c3b4e0f5fc03b91a73193fa507b81778a34/header.jpg?t=1748232215","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257144589,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257144589/movie480.mp4?t=1748053835","max":"http://video.akamai.steamstatic.com/store_trailers/257144589/movie_max.mp4?t=1748053835"},"name":"Gameplay Trailer EN","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257144589/130b893de2fc26769ab6642123ca37f3a9e1bf6e/movie_600x337.jpg?t=1748053835","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257144589/movie480_vp9.webm?t=1748053835","max":"http://video.akamai.steamstatic.com/store_trailers/257144589/movie_max_vp9.webm?t=1748053835"}}],"name":"Beats Of Un'sonia Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 x64bit<br></li><li><strong>Processor:</strong> Intel Core i5 or equal<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> DirectX 11 with at least 2GB of 