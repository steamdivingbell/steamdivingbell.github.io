il":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/adf1ce0ef2ced9b6c2b3efce93afde1107728cd9/ss_adf1ce0ef2ced9b6c2b3efce93afde1107728cd9.600x338.jpg?t=1761214466"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/82a59b211b96799f2ff9fe98ebcddbbf8719576f/ss_82a59b211b96799f2ff9fe98ebcddbbf8719576f.1920x1080.jpg?t=1761214466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/82a59b211b96799f2ff9fe98ebcddbbf8719576f/ss_82a59b211b96799f2ff9fe98ebcddbbf8719576f.600x338.jpg?t=1761214466"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/df71092594b9d3dc48d041c688c079175a792f7b/ss_df71092594b9d3dc48d041c688c079175a792f7b.1920x1080.jpg?t=1761214466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/df71092594b9d3dc48d041c688c079175a792f7b/ss_df71092594b9d3dc48d041c688c079175a792f7b.600x338.jpg?t=1761214466"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/ss_0e3b54845ae0b088d2ee524899ae85d4d605f43d.1920x1080.jpg?t=1761214466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/ss_0e3b54845ae0b088d2ee524899ae85d4d605f43d.600x338.jpg?t=1761214466"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/ss_8d5dfdb5a6d0f66927949408c6efab28133ad0eb.1920x1080.jpg?t=1761214466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/ss_8d5dfdb5a6d0f66927949408c6efab28133ad0eb.600x338.jpg?t=1761214466"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/b8f67f4b71918549b60d2548bb3a8ebb83f85eaa/ss_b8f67f4b71918549b60d2548bb3a8ebb83f85eaa.1920x1080.jpg?t=1761214466","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753500/b8f67f4b719185