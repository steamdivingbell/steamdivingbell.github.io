1765262648"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_ea36730c069962dd8853934aa7d799d3905ef4cf.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_ea36730c069962dd8853934aa7d799d3905ef4cf.600x338.jpg?t=1765262648"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_da35d03c7fa2d3429fcf0f36d05726cc995ed8d7.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_da35d03c7fa2d3429fcf0f36d05726cc995ed8d7.600x338.jpg?t=1765262648"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_9b7eea9301fa14a8f6cbdabad4e8c4c9b6aff09f.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_9b7eea9301fa14a8f6cbdabad4e8c4c9b6aff09f.600x338.jpg?t=1765262648"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_f2c8a3cbb720f1d3356ffedeb3c93ef2fc5eb18a.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_f2c8a3cbb720f1d3356ffedeb3c93ef2fc5eb18a.600x338.jpg?t=1765262648"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_590a54204d0cc0f075c27667f1b35fae597849d8.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_590a54204d0cc0f075c27667f1b35fae597849d8.600x338.jpg?t=1765262648"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_ba205ed4090bf38dfc11c97e4baa9a7b224ee126.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_ba205ed4090bf38dfc11c97e4baa9a7b224ee126.600x338.jpg?t=1765262648"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_046d85da9e1f5614ea6ed66c5889fb70300cd299.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_046d85da9e1f5614ea6ed66c5889fb70300cd299.600x338.jpg?t=1765262648"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_959598dbeb463b6b78041b69fa4a93c4f8c1624e.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_959598dbeb463b6b78041b69fa4a93c4f8c1624e.600x338.jpg?t=1765262648"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_1474ceae8c4973fc1fbe4aae6bae192012e430ae.1920x1080.jpg?t=1765262648","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1473060/ss_1474ceae8c4973fc1fbe4aae6bae192012e430ae.600x338.jpg?t=1765262648"}],"short_description":"Rewrite the universe! Break reality to change your fate, and use your powers to stop sinister forces from altering existence itself. Discover the origin of your new abilities in a fast-paced ARPG Loot Collection Roguelite where you will bend, break, and change the laws of the universe!","steam_appid":1473060,"support_info":{"email":"support@elementgamesonline.com","url":"http://www.elementgamesonline.com"},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese, Korean","type":"game","website":"https://www.elementgamesonline.com"}