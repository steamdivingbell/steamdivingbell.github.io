.akamai.steamstatic.com/store_item_assets/steam/apps/1962010/f0e3efc272f6842900470b680eb31aa8aee0a9ba/ss_f0e3efc272f6842900470b680eb31aa8aee0a9ba.600x338.jpg?t=1766012031"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1962010/697bf3b72c4a60224b5ac0941056588bd5458f6e/ss_697bf3b72c4a60224b5ac0941056588bd5458f6e.1920x1080.jpg?t=1766012031","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1962010/697bf3b72c4a60224b5ac0941056588bd5458f6e/ss_697bf3b72c4a60224b5ac0941056588bd5458f6e.600x338.jpg?t=1766012031"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1962010/4119e76220f8ebc1e9efd6f9ee16e852bbd25a79/ss_4119e76220f8ebc1e9efd6f9ee16e852bbd25a79.1920x1080.jpg?t=1766012031","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1962010/4119e76220f8ebc1e9efd6f9ee16e852bbd25a79/ss_4119e76220f8ebc1e9efd6f9ee16e852bbd25a79.600x338.jpg?t=1766012031"}],"short_description":"A fast-paced twin stick action roguelite packed with immersive environments, powerful weapons, and threatening alien enemies. Scavenge parts and materials to customize your ship and find amazing synergies to complete the galactic gauntlet!","steam_appid":1962010,"support_info":{"email":"contact@redcabingames.com","url":"https://www.spacescavenger.com"},"supported_languages":"English<strong>*</strong>, Swedish<br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.spacescavengergame.com/"}