},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3529380/ss_a4c31d37f19fedf1d2b0dffde6cc2c7d2f388634.1920x1080.jpg?t=1764316984","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3529380/ss_a4c31d37f19fedf1d2b0dffde6cc2c7d2f388634.600x338.jpg?t=1764316984"}],"short_description":"Carrotour, a grid-based puzzle game where you utilize various &quot;leaper&quot; movements to navigate around obstacles and grab delicious carrots. Be a horse, camel, elephant and more! Also, be prepared for intense boss battles featuring bullet hells!","steam_appid":3529380,"support_info":{"email":"studiolitr@gmail.com","url":"https://yowwowwow.github.io/Carrotour"},"supported_languages":"English, Simplified Chinese, Traditional Chinese","type":"game","website":"https://yowwowwow.github.io/Carrotour"}