2280/extras/eb3d8ffdf2986feb79c053fb2f7f8255.webm?t=1767964540\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3622280/extras/eb3d8ffdf2986feb79c053fb2f7f8255.mp4?t=1767964540\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Life Ticket Rule</strong></h2><p class=\"bb_paragraph\" >Got a ticket? Jump back into the fight anytime. Don't give up, keep at it!</p><p class=\"bb_paragraph\" >* Heads up! Strategically adapt your play style based on your remaining tickets to manage combat effectively.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3622280/extras/6cd64c303d3d9c6e1e37a1fdd7c49932.poster.avif?t=1767964540\" width=568 height=320 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3622280/extras/6cd64c303d3d9c6e1e37a1fdd7c49932.webm?t=1767964540\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3622280/extras/6cd64c303d3d9c6e1e37a1fdd7c49932.mp4?t=1767964540\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Cargo Rush</strong></h2><p class=\"bb_paragraph\" >Secure the cargo to claim your team's hard-earned loot. Fail, and you'll get nothing!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3622280/extras/5e490c15b7bbac2523fa05d8480b3bad.poster.avif?t=1767964540\" width=568 height=320 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3622280/extras/5e490c15b7bbac2523fa05d8480b3bad.webm?t=1767964540\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3622280/extras/5e490c15b7bbac2523fa05d8480b3bad