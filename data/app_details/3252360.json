i.steamstatic.com/store_item_assets/steam/apps/3252360/extras/c4ddc7084e317fba62fcd39aedd5be99.poster.avif?t=1773530125\" width=640 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3252360/extras/c4ddc7084e317fba62fcd39aedd5be99.webm?t=1773530125\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3252360/extras/c4ddc7084e317fba62fcd39aedd5be99.mp4?t=1773530125\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Story-driven</strong><br>Advance through your personal story. You survived the day? Then you can go to sleep. Something's calling you. You\u2019ll find an escape in your dreams. It\u2019s when you sleep that you are most alive. In fact, you can be anything in your dreams. A salaryman. A husband. A hero! <br><br>Until the alarm goes off again.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>","developers":["Samuel Lehikoinen"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3252360/header.jpg?t=1773530125","is_free":false,"legal_notice":"Unemployment Simulator 2018 \u00a92025, published by turbolento publishing, developed by Samuel Lehikoinen. All rights reserved.","linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> TBA<br></li><li><strong>Processor:</strong> TBA<br></li><li><strong>Graphics:</strong> TBA</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3252360/1140175020/89df34ed80c8fed64c2bb2fefa955fae04324a38/1750884824/dash_av1.mpd?t=1749887767","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3252360/1140175020/89df34ed80c8fed64c2bb2fefa955fae04324a38/1750884824/dash_h264.mpd?t=1749887767","hig