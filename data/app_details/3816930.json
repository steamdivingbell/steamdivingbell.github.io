2b0566276fdd415bf064b.1920x1080.jpg?t=1768748908","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3816930/31eab6d3f1eeb3960072b0566276fdd415bf064b/ss_31eab6d3f1eeb3960072b0566276fdd415bf064b.600x338.jpg?t=1768748908"}],"short_description":"Grind Survivors is a fast-paced action roguelike where demon hunters face endless hellspawn. Dodge, loot, and blast through brutal bullet-hell combat with dynamic builds and ever-changing weapons in a scorched, demon-ridden world.","steam_appid":3816930,"support_info":{"email":"support@assembleteam.com","url":""},"supported_languages":"English, German, Ukrainian, Japanese, Simplified Chinese, Korean, Portuguese - Brazil, Turkish, Spanish - Spain","type":"game","website":"https://www.grindsurvivors.com/"}