97f464/ss_ee7495fdcb12e1bc640af8e992eeac924e97f464.1920x1080.jpg?t=1773918127","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/ee7495fdcb12e1bc640af8e992eeac924e97f464/ss_ee7495fdcb12e1bc640af8e992eeac924e97f464.600x338.jpg?t=1773918127"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/41d7f49878dc366b03efdd6d0ef46e93b11091ac/ss_41d7f49878dc366b03efdd6d0ef46e93b11091ac.1920x1080.jpg?t=1773918127","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/41d7f49878dc366b03efdd6d0ef46e93b11091ac/ss_41d7f49878dc366b03efdd6d0ef46e93b11091ac.600x338.jpg?t=1773918127"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/e415945ae02c3ceb894b704955e45cc149080877/ss_e415945ae02c3ceb894b704955e45cc149080877.1920x1080.jpg?t=1773918127","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/e415945ae02c3ceb894b704955e45cc149080877/ss_e415945ae02c3ceb894b704955e45cc149080877.600x338.jpg?t=1773918127"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/1a99d9e840d084343a7fc3d74e61e0389c53317e/ss_1a99d9e840d084343a7fc3d74e61e0389c53317e.1920x1080.jpg?t=1773918127","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/1a99d9e840d084343a7fc3d74e61e0389c53317e/ss_1a99d9e840d084343a7fc3d74e61e0389c53317e.600x338.jpg?t=1773918127"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/d7b15a663a6a52960dba52531a5be6073809a333/ss_d7b15a663a6a52960dba52531a5be6073809a333.1920x1080.jpg?t=1773918127","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3711540/d7b15a663a6a52960dba52531a5be6073809a333/ss_d7b15a663a6a52960dba52531a5be6073809a333.600x338.jpg?t=1773918127"}],"short_description":"A turn-based roguelike where every attack is decided by a roll of the dice.\u00a0Know when to roll and when to hold to increase your attack and defeat powerful enemies. Craft your dice and seek out magical trinkets and powerful relics that will change the way you play!","steam_appid":3711540,"support_info":{"email":"betteralonegame@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}