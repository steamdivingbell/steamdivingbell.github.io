store_item_assets/steam/apps/1942240/ab6a71021fa6c245986631ce4e7dc3a8930955a8/ss_ab6a71021fa6c245986631ce4e7dc3a8930955a8.600x338.jpg?t=1771186124"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/0888358f1aeea7fae4b3cb5cc3dfd40953f020dc/ss_0888358f1aeea7fae4b3cb5cc3dfd40953f020dc.1920x1080.jpg?t=1771186124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/0888358f1aeea7fae4b3cb5cc3dfd40953f020dc/ss_0888358f1aeea7fae4b3cb5cc3dfd40953f020dc.600x338.jpg?t=1771186124"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/9f6eecfc6ed6666ed4f0eed2007d07d9527315c3/ss_9f6eecfc6ed6666ed4f0eed2007d07d9527315c3.1920x1080.jpg?t=1771186124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/9f6eecfc6ed6666ed4f0eed2007d07d9527315c3/ss_9f6eecfc6ed6666ed4f0eed2007d07d9527315c3.600x338.jpg?t=1771186124"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/237e4d6c5b9a32b81ed90d511f06e04d7a94d333/ss_237e4d6c5b9a32b81ed90d511f06e04d7a94d333.1920x1080.jpg?t=1771186124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/237e4d6c5b9a32b81ed90d511f06e04d7a94d333/ss_237e4d6c5b9a32b81ed90d511f06e04d7a94d333.600x338.jpg?t=1771186124"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/147ee21f13401f29f69ad43a430c80e09512dad5/ss_147ee21f13401f29f69ad43a430c80e09512dad5.1920x1080.jpg?t=1771186124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/147ee21f13401f29f69ad43a430c80e09512dad5/ss_147ee21f13401f29f69ad43a430c80e09512dad5.600x338.jpg?t=1771186124"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/a4df165dcd492699f8247dfe08ea3333a9700129/ss_a4df165dcd492699f8247dfe08ea3333a9700129.1920x1080.jpg?t=1771186124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/a4df165dcd492699f8247dfe08ea3333a9700129/ss_a4df165dcd492699f8247dfe08ea3333a9700129.600x338.jpg?t=1771186124"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/d95213e0a7e14154be63e9bddee3195d9d130ed3/ss_d95213e0a7e14154be63e9bddee3195d9d130ed3.1920x1080.jpg?t=1771186124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/d95213e0a7e14154be63e9bddee3195d9d130ed3/ss_d95213e0a7e14154be63e9bddee3195d9d130ed3.600x338.jpg?t=1771186124"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/1facf02a527bb7c33a3f38db2fea34b1cc9702cb/ss_1facf02a527bb7c33a3f38db2fea34b1cc9702cb.1920x1080.jpg?t=1771186124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/1facf02a527bb7c33a3f38db2fea34b1cc9702cb/ss_1facf02a527bb7c33a3f38db2fea34b1cc9702cb.600x338.jpg?t=1771186124"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/cabcf9a0c2efb8339d76c96a2b2591bb43ccb939/ss_cabcf9a0c2efb8339d76c96a2b2591bb43ccb939.1920x1080.jpg?t=1771186124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1942240/cabcf9a0c2efb8339d76c96a2b2591bb43ccb939/ss_cabcf9a0c2efb8339d76c96a2b2591bb43ccb939.600x338.jpg?t=1771186124"}],"short_description":"A dying island. A vanishing civilization. And a witness to the end of magic. Three Sunsets is an action roguelite chronicling the final days of a mythical land being torn apart by a supernatural storm. Craft powerful spells, solve ancient puzzles and find your way home before the island's final bow.","steam_appid":1942240,"support_info":{"email":"support@ludixgames.com","url":"https://ludixgames.com"},"supported_languages":"English","type":"game","website":"https://ludixgames.com/threesunsets/"}