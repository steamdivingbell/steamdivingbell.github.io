teamstatic.com/store_item_assets/steam/apps/3029180/b93dca7e3c7acb663bc109b671eb078533ba5ed1/ss_b93dca7e3c7acb663bc109b671eb078533ba5ed1.1920x1080.jpg?t=1755616281","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3029180/b93dca7e3c7acb663bc109b671eb078533ba5ed1/ss_b93dca7e3c7acb663bc109b671eb078533ba5ed1.600x338.jpg?t=1755616281"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3029180/a67ec23632b09a8ee2091feefc1371598fc21928/ss_a67ec23632b09a8ee2091feefc1371598fc21928.1920x1080.jpg?t=1755616281","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3029180/a67ec23632b09a8ee2091feefc1371598fc21928/ss_a67ec23632b09a8ee2091feefc1371598fc21928.600x338.jpg?t=1755616281"}],"short_description":"Place dominoes, strategically match terrains and build your Kingdom in this digital adaptation of the Spiel des Jahres, award-winning board game, Kingdomino! Collect crowns to outscore your opponents in quick games, perfect for solo play or multiplayer matches.","steam_appid":3029180,"support_info":{"email":"contact@meeplecorp.com","url":"www.meeplecorp.com/kingdomino"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Hungarian, Polish, Russian, Spanish - Latin America, Japanese, Simplified Chinese","type":"game","website":"https://meeplecorp.com/kingdomino/"}