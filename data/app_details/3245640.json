eam/apps/3245640/4292fa8d2e62ae02f934cbfa0f9a94f430986a99/ss_4292fa8d2e62ae02f934cbfa0f9a94f430986a99.600x338.jpg?t=1773324710"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3245640/fd48480e5c5c2f3b84eda566f790d56a2430b8d0/ss_fd48480e5c5c2f3b84eda566f790d56a2430b8d0.1920x1080.jpg?t=1773324710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3245640/fd48480e5c5c2f3b84eda566f790d56a2430b8d0/ss_fd48480e5c5c2f3b84eda566f790d56a2430b8d0.600x338.jpg?t=1773324710"}],"short_description":"Starfinder: Afterlight is a party-based RPG that brings Paizo's beloved science-fantasy universe to life. Battle across the Pact Worlds, lead a legendary crew where your choices shape their destiny, and well, save the galaxy while you're at it!","steam_appid":3245640,"support_info":{"email":"","url":"www.epictellers.com"},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Catalan, Russian, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}