1733aeed7ee704e173d77223de47d71f5af94239.600x338.jpg?t=1758503135"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3328210/ac82acf87a10c3f24b2307e7c90a72f2c0135052/ss_ac82acf87a10c3f24b2307e7c90a72f2c0135052.1920x1080.jpg?t=1758503135","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3328210/ac82acf87a10c3f24b2307e7c90a72f2c0135052/ss_ac82acf87a10c3f24b2307e7c90a72f2c0135052.600x338.jpg?t=1758503135"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3328210/6183bccef96b6b914eb1981963e6c14d1c736c8d/ss_6183bccef96b6b914eb1981963e6c14d1c736c8d.1920x1080.jpg?t=1758503135","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3328210/6183bccef96b6b914eb1981963e6c14d1c736c8d/ss_6183bccef96b6b914eb1981963e6c14d1c736c8d.600x338.jpg?t=1758503135"}],"short_description":"Establish a rhythm with your companion to guide heroes to their final confrontations with the sun.","steam_appid":3328210,"support_info":{"email":"commonopera@gmail.com","url":"https://www.commonopera.com/"},"supported_languages":"English, French, Italian, German, Japanese, Korean, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America","type":"game","website":"https://www.commonopera.com/waxwing"}