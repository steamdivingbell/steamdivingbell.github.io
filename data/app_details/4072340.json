e996813ff0ba2484924a78f960038a3812240568/ss_e996813ff0ba2484924a78f960038a3812240568.1920x1080.jpg?t=1774360186","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4072340/e996813ff0ba2484924a78f960038a3812240568/ss_e996813ff0ba2484924a78f960038a3812240568.600x338.jpg?t=1774360186"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4072340/3639b9c530fd7a2fd72baaf003ffba9ebdfdbcfd/ss_3639b9c530fd7a2fd72baaf003ffba9ebdfdbcfd.1920x1080.jpg?t=1774360186","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4072340/3639b9c530fd7a2fd72baaf003ffba9ebdfdbcfd/ss_3639b9c530fd7a2fd72baaf003ffba9ebdfdbcfd.600x338.jpg?t=1774360186"}],"short_description":"Help Capyshan and Capymay rebuild the Capyvarias empire. Everything is gone. Only these two brave capybaras remain, determined to raise their community from the ashes. Can you click your way to survival, growth, and a future among the stars?","steam_appid":4072340,"support_info":{"email":"support@piebox.net","url":""},"supported_languages":"English, French, Portuguese - Brazil","type":"game","website":null}