eaec40d22c9118395aaf9d70838.poster.avif?t=1775581391\" width=600 height=336 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/extras/047fceaec40d22c9118395aaf9d70838.webm?t=1775581391\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/extras/047fceaec40d22c9118395aaf9d70838.mp4?t=1775581391\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Partner with the city's guardian to prevent a cataclysm which threatens to merge past and future. Save the City of Desolus from annihilation.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/extras/4113b0966f9f6f88b91990e62efc4c1a.poster.avif?t=1775581391\" width=600 height=336 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/extras/4113b0966f9f6f88b91990e62efc4c1a.webm?t=1775581391\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/extras/4113b0966f9f6f88b91990e62efc4c1a.mp4?t=1775581391\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Desolus has been selected for several festivals, including an exhibit at the Smithsonian American Art Museum.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/extras/dfc3ea94ee04168839a53de3a70ca6c3.avif?t=1775581391\" width=600 height=338 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >As a very small indie team, every Steam Wishlist significantly helps. <strong>Please wishlist!</strong></p>","developers":["Mark J. Mayers"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/dab76d94723dfccca431844a1ee9c4967ef04cf6/header.jpg?t=1775581391","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1003460/818838647/199e13483c29c0ad3d62ddbd4cbe576b5981c682/1751174943/dash_av1.mpd?t=1747655013","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1003460/818838647/199e13483c29c0ad3d62ddbd4cbe576b5981c682/1751174943/dash_h264.mpd?t=1747655013","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1003460/818838647/199e13483c29c0ad3d62ddbd4cbe576b5981c682/1751174943/hls_264_master.m3u8?t=1747655013","id":257141041,"name":"DESOLUS Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257141041/4fa5a1e7da544cc2ca7a07a2cc2fb9ce9e99212d/movie_600x337.jpg?t=1747655013"}],"name":"DESOLUS","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 / 11<br></li><li><strong>Processor:</strong> AMD Ryzen 5 2600X / Intel\u00ae Core\u2122 i7-6800K<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> AMD Radeon RX 5700 / NVIDIA GeForce 1070<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 / 11<br></li><li><strong>Processor:</strong> AMD Ryzen 5 3600X / Intel\u00ae Core\u2122 i5-10600K<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> AMD Radeon RX 6800XT / NVIDIA RTX 2070<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["The Quantum Astrophysicists Guild"],"ratings":{"dejus":{"rating":"l"},"igrs":{"banned":"0","descriptors":"","rating":"3","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Coming soon"},"required_age":0,"reviews":"\u201cThe surreal visual elements combined with the classical soundtrack provided by Kyle Landry transport Desolus into a sort of dreamscape. The production value is astounding for an Indie team of one, and it\u2019s clear Mark Mayers has been pouring his heart and soul into this project since he began it in 2014.\u201d<br />\r\n- Indie Hangover<br />\r\n<br />\r\n\u201cIt\u2019s a ridiculously beautiful game.\u201d<br />\r\n- HardcoreGamer<br />\r\n<br />\r\n\u201cA clever and beautiful game that plays with FPS expectations and seeks to deliver something a great deal more cerebral.\u201d<br />\r\n- Boston Festival of Indie Games<br />\r\n","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_bac3471b82fd265696073e65e677b63d2902f5c2.1920x1080.jpg?t=1775581391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_bac3471b82fd265696073e65e677b63d2902f5c2.600x338.jpg?t=1775581391"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_b2652fc938349cab0cf85675af78a4e1cef92680.1920x1080.jpg?t=1775581391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_b2652fc938349cab0cf85675af78a4e1cef92680.600x338.jpg?t=1775581391"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_09671c1556ad984b783ac9336bc26ef93ea718d7.1920x1080.jpg?t=1775581391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_09671c1556ad984b783ac9336bc26ef93ea718d7.600x338.jpg?t=1775581391"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_5aa219f1b13ffd2f55fcf5c368f48063d3548f82.1920x1080.jpg?t=1775581391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_5aa219f1b13ffd2f55fcf5c368f48063d3548f82.600x338.jpg?t=1775581391"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_44634960f37370851f576e807fd6f4ce7c8afbd6.1920x1080.jpg?t=1775581391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_44634960f37370851f576e807fd6f4ce7c8afbd6.600x338.jpg?t=1775581391"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_24d72ab082659b27bc5521ad29598329dcff2cb3.1920x1080.jpg?t=1775581391","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1003460/ss_24d72ab082659b27bc5521ad29598329dcff2cb3.600x338.jpg?t=1775581391"}],"short_description":"Explore a city of Gothic architecture torn between past and future in Desolus, a first person puzzle game. Solve Escher-like puzzles through the use of black holes, traveling back and forth through time to make architecture whole again. Prevent a cataclysm which fractures reality, and save the city.","steam_appid":1003460,"support_info":{"email":"","url":"http://www.desolus.com/"},"supported_languages":"English<strong>*</strong>, French, Italian, German, Japanese, Russian, Simplified Chinese, Dutch, Korean, Spanish - Latin America, Traditional Chinese, Spanish - Spain, Portuguese - Brazil, Bulgarian, Czech, Danish, Finnish, Greek, Hungarian, Indonesian, Norwegian, Polish, Portuguese - Portugal, Romanian, Swedish, Thai, Turkish, Ukrainian, Vietnamese<br><strong>*</strong>languages with full audio support","type":"game","website":"http://www.desolus.com/"}