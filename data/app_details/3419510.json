338.jpg?t=1774028496"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3419510/ss_485b2f3967e30fbc2d9dcb892cede2cab2abfcac.1920x1080.jpg?t=1774028496","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3419510/ss_485b2f3967e30fbc2d9dcb892cede2cab2abfcac.600x338.jpg?t=1774028496"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3419510/ss_c7c25dc00f3a294cab26b072868c796e5aae583c.1920x1080.jpg?t=1774028496","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3419510/ss_c7c25dc00f3a294cab26b072868c796e5aae583c.600x338.jpg?t=1774028496"}],"short_description":"SE3 Protocol is a horror puzzle RPG set in an SCP-inspired world. An amnesiac girl wakes in the darkness\u2014frail, timid\u2026 but not alone nor defenseless. Face deadly entities: observe, evade, exploit\u2026 or simply eliminate them. Lead her through this surreal nightmare, and uncover the secret behind it.","steam_appid":3419510,"support_info":{"email":"metwoistaken@outlook.com","url":""},"supported_languages":"Simplified Chinese, English, Japanese, Russian, Traditional Chinese, Korean, French, German, Spanish - Spain, Portuguese - Brazil, Portuguese - Portugal, Spanish - Latin America","type":"game","website":null}