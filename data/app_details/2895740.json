ed.akamai.steamstatic.com/store_item_assets/steam/apps/2895740/0f68235d734b7397a75348acee1175acaa17436c/ss_0f68235d734b7397a75348acee1175acaa17436c.1920x1080.jpg?t=1772219344","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2895740/0f68235d734b7397a75348acee1175acaa17436c/ss_0f68235d734b7397a75348acee1175acaa17436c.600x338.jpg?t=1772219344"}],"short_description":"A fungi-fueled 'battle of nutrition!' Turn-based strategy inspired by mycelium networks and territory control. Produce fantastical mushrooms and expand to outgrow your rivals. Develop peacefully or parasitize your friends in multiplayer and solo play - may the fittest fungi survive!","steam_appid":2895740,"support_info":{"email":"sporebloomgame@gmail.com","url":"https://sporebloom.com/"},"supported_languages":"English","type":"game","website":"https://www.sporebloom.com"}