o/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1617010/extras/d5548f4f7a15124ab9b97dbe4d96d09f.mp4?t=1680250172\" type=\"video/mp4\"></video></span><br><br>Build example #2:<br>The Architect can have a rapid-fire playstyle by utilizing as many drones as possible. These drones are mini versions of the Architect and the more they can be generated, the more projectiles will be launched at your enemy. Strength in numbers is what this build is all about. It allows YOU to be the bullet hell.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1617010/extras/7236244574a56f0142fa4ab39e6b6d70.poster.avif?t=1680250172\" width=624 height=352 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1617010/extras/7236244574a56f0142fa4ab39e6b6d70.webm?t=1680250172\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1617010/extras/7236244574a56f0142fa4ab39e6b6d70.mp4?t=1680250172\" type=\"video/mp4\"></video></span>","developers":["Odime Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1617010/header.jpg?t=1680250172","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1617010/548134/b7c9ad107302b364a546f8b85ee98936f7e517a1/1751010247/dash_av1.mpd?t=1678823358","dash_h264":"https://vid