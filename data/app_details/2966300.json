39c.600x338.jpg?t=1743077981"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2966300/ss_1ff0954e6e02d7c4ffce5d37c556105eb54e60f6.1920x1080.jpg?t=1743077981","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2966300/ss_1ff0954e6e02d7c4ffce5d37c556105eb54e60f6.600x338.jpg?t=1743077981"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2966300/ss_f454fc3bff2c8371bb3da7084591fe2830730312.1920x1080.jpg?t=1743077981","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2966300/ss_f454fc3bff2c8371bb3da7084591fe2830730312.600x338.jpg?t=1743077981"}],"short_description":"Sliding Hero is a top-down puzzle Metroidvania where movement is key\u2014think carefully, as once you start sliding you won\u2019t stop until you hit something! Imprisoned in a sinister 1700s Venetian villa, explore a world of Carnival mystery, solve devious puzzles, uncover secrets, and unmask your fate.","steam_appid":2966300,"support_info":{"email":"info@silentchicken.net","url":""},"supported_languages":"English, Italian, French, Spanish - Spain, Japanese, Korean, Simplified Chinese","type":"game","website":null}