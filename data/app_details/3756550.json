ascal Str\u00e4hl, Luca W\u00fcest, Lukas Hofer, Adrian Hofer, Ben Weber, Silas Br\u00fcellhardt,\u00a0Ivo Gon\u00e7alves</p><p class=\"bb_paragraph\" ></p>","developers":["Cookies and Magic"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3756550/da0c3417621c898cdafe777b8d8435f2e71b5fcb/header.jpg?t=1754922799","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3756550/650664649/3f0d6e407a4aa27ce2fc9821a44f9e92371af220/1754922146/dash_av1.mpd?t=1754922797","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3756550/650664649/3f0d6e407a4aa27ce2fc9821a44f9e92371af220/1754922146/dash_h264.mpd?t=1754922797","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3756550/650664649/3f0d6e407a4aa27ce2fc9821a44f9e92371af220/1754922146/hls_264_master.m3u8?t=1754922797","id":257181590,"name":"Flowerbloom Cottage","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257181590/0d9f7bc391c3752cd4692dae5641819f9c3c528b/movie_600x337.jpg?t=1754922797"}],"name":"Flowerbloom Cottage","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 64-bit<br></li><li><strong>Processor:</strong> Intel Core i5-2500K or simiar<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong>  NVIDIA GeForce GTX 1080 or simil