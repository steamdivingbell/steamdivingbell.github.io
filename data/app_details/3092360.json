803d7a22ee52c.poster.avif?t=1772505921\" width=1068 height=600 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/0a18a14c51ff1883b58803d7a22ee52c.webm?t=1772505921\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/0a18a14c51ff1883b58803d7a22ee52c.mp4?t=1772505921\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/be6b735e9a252e210d379c686d99d00c.avif?t=1772505921\" width=600 height=185 /></span></p><h2 class=\"bb_tag\" style=\"text-align: center\">Battlefields &amp; Enemies</h2><p class=\"bb_paragraph\" >Utilize elemental offense to exploit weaknesses: Machines are vulnerable to electricity, and biological enemies fear fire. Gain combat advantage by using environmental objects!<strong>\u00a0</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/9820ef261b940340bf7ea632fc03ce19.poster.avif?t=1772505921\" width=1068 height=600 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/9820ef261b940340bf7ea632fc03ce19.webm?t=1772505921\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/9820ef261b940340bf7ea632fc03ce19.mp4?t=1772505921\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" style=\"text-align: center\">Boss Enemies</h2><p class=\"bb_paragraph\" >These powerful entities are equal in strength to the player characters. They can also accumulate energy and unleash Overdrive Burst attacks. To counter their powerful offensive, focus your attacks during the openings between their moves to break their 'Stance', interrupt their offense, and gain the upper hand!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/d5d01fc0b063aefea83642a579c2289a.poster.avif?t=1772505921\" width=1068 height=600 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/d5d01fc0b063aefea83642a579c2289a.webm?t=1772505921\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/d5d01fc0b063aefea83642a579c2289a.mp4?t=1772505921\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" style=\"text-align: center\"></h2><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/291db2978ce3d40377f77ae50d0489e5.avif?t=1772505921\" width=600 height=185 /></span></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>Rich Content &amp; Replayability</strong></h2><p class=\"bb_paragraph\" >\u2022 50+ Tech Arts and special actions per character</p><p class=\"bb_paragraph\" >\u2022 Customize performance via flexible Chip layouts \u2014 multi-air-jump / infinite energy / multiple HP layers, and more</p><p class=\"bb_paragraph\" >\u2022 Collect all Support allies to enhance tactical depth</p><p class=\"bb_paragraph\" >\u2022 Dozens of enemy types and diverse BOSS encounters</p><p class=\"bb_paragraph\" >\u2022 Battle Rush Mode includes hundreds of upgrades for destructive power escalation</p><p class=\"bb_paragraph\" >Whether playing solo or co-op, you\u2019ll enjoy fast-paced, thrilling action every time you start the game!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/4f2f5c7a7c3242bd535630162326fcf4.poster.avif?t=1772505921\" width=1068 height=600 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/4f2f5c7a7c3242bd535630162326fcf4.webm?t=1772505921\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/4f2f5c7a7c3242bd535630162326fcf4.mp4?t=1772505921\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/32e8d66f2f07031d0ddf0e2f7a289eda.poster.avif?t=1772505921\" width=1068 height=600 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/32e8d66f2f07031d0ddf0e2f7a289eda.webm?t=1772505921\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/extras/32e8d66f2f07031d0ddf0e2f7a289eda.mp4?t=1772505921\" type=\"video/mp4\"></video></span></p>","developers":["Alloy Mushroom"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Massively Multiplayer","id":"29"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"},{"description":"Sports","id":"18"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3092360/6db1fd0e78716d4be57c7438762a529d0f2ef41e/header.jpg?t=1772505921","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3092360/876494400/8fb2e8aac774f614315351b6c351749a86667960/1768469753/dash_av1.mpd?t=1769051200","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3092360/876494400/8fb2e8aac774f614315351b6c351749a8