{"about_the_game":"<p class=\"bb_paragraph\">\u201c\u9002\u5408\u559c\u597d\u6570\u636e\u6d41\u3001\u5237\u88c5\u5907\u3001\u8f7b\u5267\u60c5\uff0c\u4e0d\u53cd\u611f\u56de\u5408\u5236\u7684\u73a9\u5bb6\uff0c\u6e38\u620f\u8fc7\u7a0b\u4e2d\uff0c\u53ef\u4ee5\u9009\u62e9\u901a\u5173\u4e5f\u53ef\u4ee5\u8fdb\u884c\u65e0\u9650\u722c\u5854\u6311\u6218\u201d</p><p class=\"bb_paragraph\"><strong>\u6e38\u620f\u6838\u5fc3\u73a9\u6cd5\uff1a</strong>\u5347\u7ea7\u6253\u602a\u5237\u88c5\u5907\u3001\u5f3a\u5316\u88c5\u5907\u3001\u5f3a\u5316\u6280\u80fd\u3001\u5237\u79d8\u5883\u3001\u5237\u767b\u4ed9\u5854\u3001\u5176\u4ed6\u73a9\u5bb6\u955c\u50cf\u6311\u6218\u3001\u4f53\u9a8c\u5404\u79cd\u968f\u673a\u4e8b\u4ef6\u7b49</p><p class=\"bb_paragraph\"><strong>\u4e0e\u4f20\u7edf\u5237\u5b50\u6e38\u620f\u5bf9\u6bd4</strong>\uff1a<i>\u6b64\u4f5c\u4e5f\u8bb8\u5e76\u4e0d\u662f\u771f\u6b63\u5408\u683c\u7684&quot;\u5237\u5b50\u6e38\u620f&quot;\uff0c\u672c\u4f5c\u4e0d\u662f\u7279\u522b\u770b\u91cd\u914d\u88c5\u3001\u7279\u6548\uff0c\u867d\u7136\u53ef\u4ee5\u81ea\u884c\u914d\u88c5\u6210\u60f3\u8981\u7684\u98ce\u683c\u6216\u6d41\u6d3e\uff0c\u8fbe\u5230\u8d8a\u7ea7\u6740\u602a\u6548\u679c\u3002\u4f46\u5373\u4f7f\u65e0\u8111\u88c5\u5907\uff0c\u53ea\u8981\u5806\u6570\u503c\u4e5f\u4f1a\u53d8\u5f97\u5f88\u5f3a\u3002</i></p><p class=\"bb_paragraph\"><i>\u672c\u4f5c\u66f4\u6709\u70b9\u504f\u5411&quot;\u6302\u673a\u7c7b&quot;\u6e38\u620f\uff0c\u56e0\u4e3a\u53ea\u8981\u591a\u591a\u6253\u602a\u5c31\u4e00\u5b9a\u4f1a\u53d8\u5f3a\uff08\u81ea\u5e26\u6280\u80fd\u4e0e\u5b66\u9662\u4e60\u5f97\u7684\u6280\u80fd\u4f7f\u7528\u5373\u53ef\u4fbf\u5f3a\uff0c\u6253\u602a\u6389\u843d\u88c5\u5907\uff0c\u88c5\u5907\u53ef\u4ee5\u62ff\u6765\u7528\u4e5f\u53ef\u4ee5\u62ff\u53bb\u56de\u6536\u6362\u53d6\u6750\u6599\uff0c\u6750\u6599\u53ef\u4ee5\u5f3a\u5316\u88c5\u5907\uff09</i></p><p class=\"bb_paragraph\"><i>\uff08\u672c\u4f5c\u6682\u65f6\u53ef\u4ee5\u5728\u5c71\u6d1e\u6216\u8005\u79d8\u5883\u4e2d\u4f7f\u7528\u96ea\u9547\u4e95\u4e2d\u83b7\u5f97\u7684\u5524\u9b54\u7b1b\u6302\u673a\uff0c\u4e5f\u53ef\u4ee5\u5728\u83dc\u5355\u4e2d\u9009\u62e9\u81ea\u52a8\u526f\u672c\u6302\u673a\uff0c\u4e5f\u53ef\u4ee5\u4e0e\u7a3b\u8349\u4eba\u5bf9\u8bdd\u6302\u673a\uff0c\u540e\u671f\u4e5f\u53ef\u4ee5\u81ea\u52a8\u722c\u767b\u4ed9\u5854\uff0c\u4e5f\u53ef\u4ee5\u91cd\u7f6e\u767b\u4ed9\u5854\u7ea7\u522b\u7528\u6765\u6302\u673a\uff09</i></p><p class=\"bb_paragraph\"><i>\u672c\u4f5c\u88c5\u5907\u7684\u968f\u673a\u6027\u5f88\u5f3a\uff0c\u53ef\u80fd\u5f00\u5c40\u83b7\u5f97\u4e86\u9ad8\u653b\u9632\u88c5\u5907\uff0c\u77ac\u95f4\u964d\u4f4e\u96be\u5ea6\u5feb\u901f\u6536\u5272\u654c\u4eba\uff0c\u4e5f\u53ef\u80fd\u5f00\u5c40\u83b7\u5f97\u7684\u88c5\u5907\u5e76\u4e0d\u5b8c\u7f8e\uff0c\u6253\u5f97\u5f88\u8270\u96be\uff0c\u9700\u8981\u56de\u6536\u6210\u6750\u6599\uff0c\u5f3a\u5316\u4e00\u756a\u88c5\u5907\uff0c\u7136\u540e\u624d\u80fd\u6162\u6162\u6218\u80dc\u654c\u4eba\u3002</i></p><p class=\"bb_paragraph\"><i>\u6e38\u620f\u6ca1\u6709\u6240\u8c13\u7684\u9876\u7ea7\u88c5\u5907\uff0c\u56e0\u4e3a\u88c5\u5907\u5c5e\u6027\u5e76\u6ca1\u6709\u4e0a\u9650\uff0c\u540e\u9762\u9047\u5230\u7684\u88c5\u5907\u603b\u4f53\u8fd8\u662f\u4f1a\u6bd4\u524d\u9762\u6253\u51fa\u6765\u7684\u66f4\u597d\u3002\u6240\u8c13\u6311\u6218\u65e0\u6781\u9650\uff0c\u88c5\u5907\u4e5f\u65e0\u6781\u9650\uff0c\u4e00\u5207\u88c5\u5907\u90fd\u53ef\u770b\u4f5c\u662f\u8fc7\u6e21\u88c5\u5907\uff08\u6bd4\u5982\uff1a15\u7ea7\u84dd\u88c5\u6218\u529b\u8fdc\u8d85\u8fc75\u7ea7\u7d2b\u88c5\uff0c\u767b\u4ed9\u58541000\u5c42\u65f6\u5019\u76845\u7ea7\u84dd\u88c5\uff0c\u6218\u529b\u8fdc\u8d85\u767b\u4ed9\u58540\u5c42\u65f6\u5019\u768445\u7ea7\u7684\u7d2b\u88c5\uff09</i></p><p class=\"bb_paragraph\"><i>\u867d\u7136\u6e38\u620f\u7684\u8bbe\u5b9a\u4e0a\u6700\u7ec8\u62ef\u6551\u4e86\u5929\u9053\u5c31\u7b97\u662f\u5f7b\u5e95\u901a\u5173\u4e86\uff0c\u4f46\u60f3\u8981\u5237\u5230\u5929\u8352\u5730\u8001\uff0c\u770b\u770b\u5c5e\u6027\u7684\u6781\u9650\u5728\u54ea\u91cc\uff0c\u4e5f\u662f\u53ef\u4ee5\u7684\u3002</i></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><strong>\u6e38\u620f\u80cc\u666f\uff1a</strong></p><p class=\"bb_paragraph\">\u4e3b\u89d2\u662f\u6d2a\u8352\u5927\u9646\u7684\u4e00\u540d\u666e\u901a\u7684\u4fee\u4ed9\u8005\uff0c\u5728\u4e00\u6b21\u751f\u6b7b\u6218\u6597\u4e2d\u4e0d\u5c0f\u5fc3\u88ab\u5377\u5165\u4e86\u65f6\u7a7a\u4e71\u6d41\u5e76\u7a7f\u8d8a\u5230\u4e86\u5e7b\u60f3\u5f02\u4e16\u754c\u4e4b\u4e2d\uff0c\u8fd9\u4e2a\u4e16\u754c\u4e0d\u540c\u4e8e\u4fee\u4ed9\u4e16\u754c\uff0c\u662f\u4e00\u4e2a\u5145\u6ee1\u9b54\u6cd5\u4e0e\u9b54\u7269\u7684\u4e16\u754c\uff0c\u4e0d\u4ec5\u5982\u6b64\u5728\u8fd9\u91cc\u4f60\u53ef\u4ee5\u66f4\u5feb\u7684\u6210\u957f\uff01\u4f60\u7684\u6700\u7ec8\u76ee\u7684\u662f\u4e0d\u65ad\u5730\u8ba9\u81ea\u5df1\u5f3a\u5927\u8d77\u6765\uff0c\u540c\u65f6\u5e2e\u52a9\u5f02\u4e16\u754c\u6253\u8d25\u5f02\u4e16\u754c\u7684\u9b54\u738b\uff0c\u6700\u7ec8\u56de\u5230\u81ea\u5df1\u7684\u6d2a\u8352\u5927\u9646\u3002</p><p class=\"bb_paragraph\">\u5f00\u5c40\u8fdb\u5165\u6e38\u620f\u53ef\u4ee5\u9009\u62e9&quot;\u6b63\u5e38\u6a21\u5f0f\u201c\u4e0e\u201d\u7eaf\u5237\u6a21\u5f0f\u201d \uff08\u4f5c\u8005\u4e2a\u4eba\u8fd8\u662f\u66f4\u63a8\u8350\u4f7f\u7528\u6b63\u5e38\u6a21\u5f0f\uff09</p><p class=\"bb_paragraph\">\u7eaf\u5237\u6a21\u5f0f\uff1a\u4fee\u771f\u8005\u5b9d\u5e93\uff01\u53ef\u4ee5\u5feb\u901f\u7684\u5f00\u542f\u5237\u602a\u4f53\u9a8c\uff0c\u4e0d\u9700\u8981\u63a2\u7d22\u5730\u56fe\uff0c\u9700\u8981\u7684\u4e3b\u8981NPC\u90fd\u5728\u4e00\u4e2a\u623f\u95f4\u4e2d\u3002</p><p class=\"bb_paragraph\">\u6b63\u5e38\u6a21\u5f0f\uff1a\u4ece\u96f6\u5f00\u59cb\u7684\u5f02\u754c\u6cd5\u5219\u5f81\u670d\u4e4b\u8def\uff01\u9664\u4e86\u5305\u542b\u7eaf\u5237\u6a21\u5f0f\u7684\u5185\u5bb9\u5916\uff0c\u6709\u7740\u4f20\u7edf\u65e5\u5f0fRPG\u98ce\u683c\u7684\u7a7f\u8d8a\u8005\u5192\u9669\u5f00\u5c40\uff0c\u901a\u8fc7\u4e0eNPC\u7684\u5bf9\u8bdd\u5b8c\u6210\u4e3b\u7ebf\u4efb\u52a1\uff0c\u5728\u8fd9\u4e2a\u8fc7\u7a0b\u4e2d\u73a9\u5bb6\u4e5f\u4f1a\u4e0d\u65ad\u63a2\u7d22\u5730\u56fe\u8fdb\u5165\u4e0d\u540c\u573a\u666f\uff0c\u4e0d\u65ad\u62db\u52df\u5230\u66f4\u591a\u540c\u4f34\u4e0d\u65ad\u53d8\u5f3a\uff0c\u6700\u7ec8\u6253\u8d25\u5f02\u4e16\u754c\u9b54\u738bBOSS\u3002\u6253\u8d25\u9b54\u738bBOSS\u540e\u7b97\u662f\u5f00\u542f\u4e86\u771f\u6b63\u7684\u5237\u88c5\u5907\u4f53\u9a8c\u3002\u4e0e\u7eaf\u5237\u6a21\u5f0f\u76f8\u6bd4\uff0c\u6b63\u5e38\u6a21\u5f0f\u5728\u5927\u4e16\u754c\u5730\u56fe\u591a\u4e86\u4e00\u4e2a\u4e0d\u5b9a\u671f\u968f\u673a\u5237\u65b0\u9650\u65f6\u7cbe\u82f1\u602a\u7269\u7684\u73a9\u6cd5\uff08\u6b64\u6a21\u5f0f\u9700\u8981\u5b8c\u6210\u8ba8\u4f10\u72ec\u89d2\u517d\u4efb\u52a1\u540e\u81ea\u52a8\u5f00\u542f\uff09</p><p class=\"bb_paragraph\"><strong>\u6e38\u620f\u7684\u4e3b\u8981\u4ecb\u7ecd\uff1a</strong></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723350/extras/xinjieshao1.png?t=1749694052\" /></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723350/extras/xinjieshao2.png?t=1749694052\" /></p>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3723350?t=1749694052","background_raw":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3723350?t=1749694052","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723350/d0c5e635f9b5f75c62a6ac8b9dc76642650ddbe4/capsule_231x87.jpg?t=1749694052","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723350/d0c5e635f9b5f75c62a6ac8b9dc76642650ddbe4/capsule_184x69.jpg?t=1749694052","categories":[{"description":"Single-player","id":2},{"description":"Full controller support","id":28},{"description":"Color Alternatives","id":66},{"description":"Custom Volume Controls","id":68},{"description":"Adjustable Difficulty","id":78},{"description":"Keyboard Only Option","id":75},{"description":"Mouse Only Option","id":76},{"description":"Playable without Timed Input","id":74},{"description":"Save Anytime","id":79},{"description":"Stereo Sound","id":69},{"description":"Touch Only Option","id":77},{"description":"Remote Play on TV","id":43},{"description":"Family Sharing","id":62}],"content_descriptors":{"ids":[],"notes":null},"controller_support":"full","detailed_description":"<p class=\"bb_paragraph\">\u201c\u9002\u5408\u559c\u597d\u6570\u636e\u6d41\u3001\u5237\u88c5\u5907\u3001\u8f7b\u5267\u60c5\uff0c\u4e0d\u53cd\u611f\u56de\u5408\u5236\u7684\u73a9\u5bb6\uff0c\u6e38\u620f\u8fc7\u7a0b\u4e2d\uff0c\u53ef\u4ee5\u9009\u62e9\u901a\u5173\u4e5f\u53ef\u4ee5\u8fdb\u884c\u65e0\u9650\u722c\u5854\u6311\u6218\u201d</p><p class=\"bb_paragraph\"><strong>\u6e38\u620f\u6838\u5fc3\u73a9\u6cd5\uff1a</strong>\u5347\u7ea7\u6253\u602a\u5237\u88c5\u5907\u3001\u5f3a\u5316\u88c5\u5907\u3001\u5f3a\u5316\u6280\u80fd\u3001\u5237\u79d8\u5883\u3001\u5237\u767b\u4ed9\u5854\u3001\u5176\u4ed6\u73a9\u5bb6\u955c\u50cf\u6311\u6218\u3001\u4f53\u9a8c\u5404\u79cd\u968f\u673a\u4e8b\u4ef6\u7b49</p><p class=\"bb_paragraph\"><strong>\u4e0e\u4f20\u7edf\u5237\u5b50\u6e38\u620f\u5bf9\u6bd4</strong>\uff1a<i>\u6b64\u4f5c\u4e5f\u8bb8\u5e76\u4e0d\u662f\u771f\u6b63\u5408\u683c\u7684&quot;\u5237\u5b50\u6e38\u620f&quot;\uff0c\u672c\u4f5c\u4e0d\u662f\u7279\u522b\u770b\u91cd\u914d\u88c5\u3001\u7279\u6548\uff0c\u867d\u7136\u53ef\u4ee5\u81ea\u884c\u914d\u88c5\u6210\u60f3\u8981\u7684\u98ce\u683c\u6216\u6d41\u6d3e\uff0c\u8fbe\u5230\u8d8a\u7ea7\u6740\u602a\u6548\u679c\u3002\u4f46\u5373\u4f7f\u65e0\u8111\u88c5\u5907\uff0c\u53ea\u8981\u5806\u6570\u503c\u4e5f\u4f1a\u53d8\u5f97\u5f88\u5f3a\u3002</i></p><p class=\"bb_paragraph\"><i>\u672c\u4f5c\u66f4\u6709\u70b9\u504f\u5411&quot;\u6302\u673a\u7c7b&quot;\u6e38\u620f\uff0c\u56e0\u4e3a\u53ea\u8981\u591a\u591a\u6253\u602a\u5c31\u4e00\u5b9a\u4f1a\u53d8\u5f3a\uff08\u81ea\u5e26\u6280\u80fd\u4e0e\u5b66\u9662\u4e60\u5f97\u7684\u6280\u80fd\u4f7f\u7528\u5373\u53ef\u4fbf\u5f3a\uff0c\u6253\u602a\u6389\u843d\u88c5\u5907\uff0c\u88c5\u5907\u53ef\u4ee5\u62ff\u6765\u7528\u4e5f\u53ef\u4ee5\u62ff\u53bb\u56de\u6536\u6362\u53d6\u6750\u6599\uff0c\u6750\u6599\u53ef\u4ee5\u5f3a\u5316\u88c5\u5907\uff09</i></p><p class=\"bb_paragraph\"><i>\uff08\u672c\u4f5c\u6682\u65f6\u53ef\u4ee5\u5728\u5c71\u6d1e\u6216\u8005\u79d8\u5883\u4e2d\u4f7f\u7528\u96ea\u9547\u4e95\u4e2d\u83b7\u5f97\u7684\u5524\u9b54\u7b1b\u6302\u673a\uff0c\u4e5f\u53ef\u4ee5\u5728\u83dc\u5355\u4e2d\u9009\u62e9\u81ea\u52a8\u526f\u672c\u6302\u673a\uff0c\u4e5f\u53ef\u4ee5\u4e0e\u7a3b\u8349\u4eba\u5bf9\u8bdd\u6302\u673a\uff0c\u540e\u671f\u4e5f\u53ef\u4ee5\u81ea\u52a8\u722c\u767b\u4ed9\u5854\uff0c\u4e5f\u53ef\u4ee5\u91cd\u7f6e\u767b\u4ed9\u5854\u7ea7\u522b\u7528\u6765\u6302\u673a\uff09</i></p><p class=\"bb_paragraph\"><i>\u672c\u4f5c\u88c5\u5907\u7684\u968f\u673a\u6027\u5f88\u5f3a\uff0c\u53ef\u80fd\u5f00\u5c40\u83b7\u5f97\u4e86\u9ad8\u653b\u9632\u88c5\u5907\uff0c\u77ac\u95f4\u964d\u4f4e\u96be\u5ea6\u5feb\u901f\u6536\u5272\u654c\u4eba\uff0c\u4e5f\u53ef\u80fd\u5f00\u5c40\u83b7\u5f97\u7684\u88c5\u5907\u5e76\u4e0d\u5b8c\u7f8e\uff0c\u6253\u5f97\u5f88\u8270\u96be\uff0c\u9700\u8981\u56de\u6536\u6210\u6750\u6599\uff0c\u5f3a\u5316\u4e00\u756a\u88c5\u5907\uff0c\u7136\u540e\u624d\u80fd\u6162\u6162\u6218\u80dc\u654c\u4eba\u3002</i></p><p class=\"bb_paragraph\"><i>\u6e38\u620f\u6ca1\u6709\u6240\u8c13\u7684\u9876\u7ea7\u88c5\u5907\uff0c\u56e0\u4e3a\u88c5\u5907\u5c5e\u6027\u5e76\u6ca1\u6709\u4e0a\u9650\uff0c\u540e\u9762\u9047\u5230\u7684\u88c5\u5907\u603b\u4f53\u8fd8\u662f\u4f1a\u6bd4\u524d\u9762\u6253\u51fa\u6765\u7684\u66f4\u597d\u3002\u6240\u8c13\u6311\u6218\u65e0\u6781\u9650\uff0c\u88c5\u5907\u4e5f\u65e0\u6781\u9650\uff0c\u4e00\u5207\u88c5\u5907\u90fd\u53ef\u770b\u4f5c\u662f\u8fc7\u6e21\u88c5\u5907\uff08\u6bd4\u5982\uff1a15\u7ea7\u84dd\u88c5\u6218\u529b\u8fdc\u8d85\u8fc75\u7ea7\u7d2b\u88c5\uff0c\u767b\u4ed9\u58541000\u5c42\u65f6\u5019\u76845\u7ea7\u84dd\u88c5\uff0c\u6218\u529b\u8fdc\u8d85\u767b\u4ed9\u58540\u5c42\u65f6\u5019\u768445\u7ea7\u7684\u7d2b\u88c5\uff09</i></p><p class=\"bb_paragraph\"><i>\u867d\u7136\u6e38\u620f\u7684\u8bbe\u5b9a\u4e0a\u6700\u7ec8\u62ef\u6551\u4e86\u5929\u9053\u5c31\u7b97\u662f\u5f7b\u5e95\u901a\u5173\u4e86\uff0c\u4f46\u60f3\u8981\u5237\u5230\u5929\u8352\u5730\u8001\uff0c\u770b\u770b\u5c5e\u6027\u7684\u6781\u9650\u5728\u54ea\u91cc\uff0c\u4e5f\u662f\u53ef\u4ee5\u7684\u3002</i></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><strong>\u6e38\u620f\u80cc\u666f\uff1a</strong></p><p class=\"bb_paragraph\">\u4e3b\u89d2\u662f\u6d2a\u8352\u5927\u9646\u7684\u4e00\u540d\u666e\u901a\u7684\u4fee\u4ed9\u8005\uff0c\u5728\u4e00\u6b21\u751f\u6b7b\u6218\u6597\u4e2d\u4e0d\u5c0f\u5fc3\u88ab\u5377\u5165\u4e86\u65f6\u7a7a\u4e71\u6d41\u5e76\u7a7f\u8d8a\u5230\u4e86\u5e7b\u60f3\u5f02\u4e16\u754c\u4e4b\u4e2d\uff0c\u8fd9\u4e2a\u4e16\u754c\u4e0d\u540c\u4e8e\u4fee\u4ed9\u4e16\u754c\uff0c\u662f\u4e00\u4e2a\u5145\u6ee1\u9b54\u6cd5\u4e0e\u9b54\u7269\u7684\u4e16\u754c\uff0c\u4e0d\u4ec5\u5982\u6b64\u5728\u8fd9\u91cc\u4f60\u53ef\u4ee5\u66f4\u5feb\u7684\u6210\u957f\uff01\u4f60\u7684\u6700\u7ec8\u76ee\u7684\u662f\u4e0d\u65ad\u5730\u8ba9\u81ea\u5df1\u5f3a\u5927\u8d77\u6765\uff0c\u540c\u65f6\u5e2e\u52a9\u5f02\u4e16\u754c\u6253\u8d25\u5f02\u4e16\u754c\u7684\u9b54\u738b\uff0c\u6700\u7ec8\u56de\u5230\u81ea\u5df1\u7684\u6d2a\u8352\u5927\u9646\u3002</p><p class=\"bb_paragraph\">\u5f00\u5c40\u8fdb\u5165\u6e38\u620f\u53ef\u4ee5\u9009\u62e9&quot;\u6b63\u5e38\u6a21\u5f0f\u201c\u4e0e\u201d\u7eaf\u5237\u6a21\u5f0f\u201d \uff08\u4f5c\u8005\u4e2a\u4eba\u8fd8\u662f\u66f4\u63a8\u8350\u4f7f\u7528\u6b63\u5e38\u6a21\u5f0f\uff09</p><p class=\"bb_paragraph\">\u7eaf\u5237\u6a21\u5f0f\uff1a\u4fee\u771f\u8005\u5b9d\u5e93\uff01\u53ef\u4ee5\u5feb\u901f\u7684\u5f00\u542f\u5237\u602a\u4f53\u9a8c\uff0c\u4e0d\u9700\u8981\u63a2\u7d22\u5730\u56fe\uff0c\u9700\u8981\u7684\u4e3b\u8981NPC\u90fd\u5728\u4e00\u4e2a\u623f\u95f4\u4e2d\u3002</p><p class=\"bb_paragraph\">\u6b63\u5e38\u6a21\u5f0f\uf