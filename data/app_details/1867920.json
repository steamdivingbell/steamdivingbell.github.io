7920/ss_9b6d3bfb730e47e6c64ac621ea4488c9fb12263b.1920x1080.jpg?t=1754619223","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1867920/ss_9b6d3bfb730e47e6c64ac621ea4488c9fb12263b.600x338.jpg?t=1754619223"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1867920/ss_22059ffd9d98f14fe62a0c307637ff7876cd52ce.1920x1080.jpg?t=1754619223","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1867920/ss_22059ffd9d98f14fe62a0c307637ff7876cd52ce.600x338.jpg?t=1754619223"}],"short_description":"InternShip is a chaotic physics-based space survival game where interns swing, smash, and build their way to survival. Use rope mechanics to collect resources, battle enemies, and expand your space colony. Explore humorous cave biomes and survive absurd corporate tasks in deep space.","steam_appid":1867920,"support_info":{"email":"chicka@sweatychair.com","url":"http://www.sweatychair.com"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Portugal, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Latin America, Thai, Traditional Chinese, Turkish, Ukrainian, Vietnamese","type":"game","website":"https://www.sweatychair.com/"}