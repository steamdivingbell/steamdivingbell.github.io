hat shifts between calm moments and intense battles to heighten immersion.</p><p class=\"bb_paragraph\" ></p>","developers":["Mind Inside Games"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4006170/b9b7ac6ad7378ec0e235bef24e47269deb21a1e7/header.jpg?t=1767956356","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4006170/1619458453/38b539b485f222dadb2023ba3c5c2382eb3e0187/1763772884/dash_av1.mpd?t=1763774211","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4006170/1619458453/38b539b485f222dadb2023ba3c5c2382eb3e0187/1763772884/dash_h264.mpd?t=1763774211","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4006170/1619458453/38b539b485f222dadb2023ba3c5c2382eb3e0187/1763772884/hls_264_master.m3u8?t=1763774211","id":257236163,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257236163/e821f72a4343b3908f016b368317f0b1b5eec227/movie_600x337.jpg?t=1763774211"}],"name":"Medieval Siege","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Medieval Siege - $9.99 USD","packageid":1405752,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":999}],"title":"Buy Medieval Siege"}],"packages":[1405752],"pc_requirements":{"minimum":"<strong