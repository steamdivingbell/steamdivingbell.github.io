ozens of inspectable, collectable and even reactive objects that can alter your surroundings.</p></li></ul><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3611900/extras/parsonage01_tboai.jpg?t=1743717799\" /></p>","developers":["BakerTheGameMaker"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3611900/03b950f753ccc147e935c0db24a48b88396210d3/header.jpg?t=1743717799","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257118233,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257118233/movie480.mp4?t=1743717797","max":"http://video.akamai.steamstatic.com/store_trailers/257118233/movie_max.mp4?t=1743717797"},"name":"The Blessing of Airon Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257118233/66aefc842a4bb57d8a518e8aed30d7d61ddd6fc1/movie_600x337.jpg?t=1743717797","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257118233/movie480_vp9.webm?t=1743717797","max":"http://video.akamai.steamstatic.com/store_trailers/257118233/movie_max_vp9.webm?t=1743717797"}}],"name":"The Blessing of Airon","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows<br></li><li><strong>Processor:</strong> Intel<br></li><li><strong>Memory:</strong> 2048 MB RAM<br></li><li><strong>Graphics:</strong> Yes<br></li><li><strong>DirectX:</strong> Version 10<br></li><li><strong>Storage:</s