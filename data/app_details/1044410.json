sinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1044410/extras/8092de3a3d47dca96de0f4b774c1a65e.poster.avif?t=1769349871\" width=720 height=404 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1044410/extras/8092de3a3d47dca96de0f4b774c1a65e.webm?t=1769349871\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1044410/extras/8092de3a3d47dca96de0f4b774c1a65e.mp4?t=1769349871\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>A Deep Resonance Beyond Words</strong></h2><p class=\"bb_paragraph\" >No text or dialogue is required. Immerse yourself in a narrative conveyed entirely through environmental shifts, evocative music, and Nia\u2019s movements.</p>","achievements":{"highlighted":[{"name":"NEW_ACHIEVEMENT_NAME_2_0","path":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/apps/1044410/dce9455df652b5a641981583ce9497148232e220.jpg"}],"total":1},"background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/1044410?t=1769349871","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1044410/53aab9011b7f38f20fa6f3b1ebdc7c173c46ea63/page_bg_raw.jpg?t=1769349871","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1044410/aa749b569a394f4f80ec939c4c862e4e72d103fb/capsule_231x87.jpg?t=1769349871","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1044410/aa749b569a394f4f80ec939c4c862e4e72d103fb/capsule_184x69.jpg?t=1769349871","categories":[{"description":"Single-player","id":2},{"description":"Steam Achievements","id":22},{"description":"Full controller support","id":28},{"description":"Captions available","id":13},{"description":"Steam Workshop","id":30},{"description":"Stats","id":15},{"description":"Commentary available","id":14},{"description":"Family Sharing","id":62}],"content_descriptors":{"