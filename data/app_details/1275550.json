tion":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1275550/4aa2d0f9266c952f4ab252b0dc9931c5c244e552/header.jpg?t=1756358590","is_free":false,"legal_notice":"Arctic Awakening \u00a9 GoldFire Studios, Inc. 2025.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OS X 10.14+<br></li><li><strong>Processor:</strong> Apple M1 or Later<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Apple M1 or Later<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OS X 10.14+<br></li><li><strong>Processor:</strong> Apple M2<br></li><li><strong>Memory:</strong> 16 MB RAM<br></li><li><strong>Graphics:</strong> Apple M2<br></li><li><strong>Storage:</strong> 10 MB available space</li></ul>"},"movies":[{"highlight":true,"id":257182423,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257182423/movie480.mp4?t=1755183605","max":"http://video.akamai.steamstatic.com/store_trailers/257182423/movie_max.mp4?t=1755183605"},"name":"Release Date Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257182423/acd8a7f86f3107421699d0fd0aa06e380e7658d1/movie_600x337.jpg?t=1755183605","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257182423/movie480_vp9.webm?t=1755183605","max":"http://video.akamai.steamstatic.com/store_trailers/257182423/movie_max_vp9.webm?t=1755183605"}}],"name":"Arctic Awakening","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 / 11 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3-6100 / AMD FX 8350<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 1650 / AMD RX 570<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 / 11 (64-bit)<br></li><li><strong>Processor:</strong> Intel i5-9600K / Ryzen 5 3600<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA RTX 2060 / AMD RX 6600<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>"},"platforms":{"linux":false,"mac":true,"windows":true},"publishers":["GoldFire Studios"],"ratings":{"dejus":{"descriptors":"Linguagem impr\u00f3pria","rating":"12","required_age":"12","use_age_gate":"true"},"steam_germany":{"banned":"0","descriptors":"Gewalt\nSchimpfw\u00f6rte","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"18 Sep, 2025"},"required_age":0,"reviews":"\u201cArctic Awakening is one of those games where you instantly know it's going to hook you in..., and then an adorable robot pops up and you're sold.\u201d<br>GamesRadar<br><br>\u201cFirewatch meets The Thing in this game about a near-future plane crash in Alaska.\u201d<br>PC Gamer<br><br>\u201cI never knew how much I wanted a cross between Firewatch and The Long Dark.\u201d<br>Kotaku<br>","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1275550/26bb0ee6587d3a05634e17d5e9ce0c42228b8651/ss_26bb0ee6587d3a05634e17d5e9ce0c42228b8651.1920x1080.jpg?t=1756358590","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1275550/26bb0ee6587d3a05634e17d5e9ce0c42228b8651/ss_26bb0e