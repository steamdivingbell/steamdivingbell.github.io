om/store_item_assets/steam/apps/3763720/9785dff25e9905a893c68c585548ced30a71b3ed/ss_9785dff25e9905a893c68c585548ced30a71b3ed.600x338.jpg?t=1767884521"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3763720/75a42048f2f5ce248bac05baff9d555eec65a391/ss_75a42048f2f5ce248bac05baff9d555eec65a391.1920x1080.jpg?t=1767884521","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3763720/75a42048f2f5ce248bac05baff9d555eec65a391/ss_75a42048f2f5ce248bac05baff9d555eec65a391.600x338.jpg?t=1767884521"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3763720/0564f3fc9a0291795bac03c0adc389e1ca1cc0a5/ss_0564f3fc9a0291795bac03c0adc389e1ca1cc0a5.1920x1080.jpg?t=1767884521","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3763720/0564f3fc9a0291795bac03c0adc389e1ca1cc0a5/ss_0564f3fc9a0291795bac03c0adc389e1ca1cc0a5.600x338.jpg?t=1767884521"}],"short_description":"A traditional roguelike with 4 player classes, each with a suite of tactical skills. Outmaneuver hordes of monsters armed with daggers, fireballs, poisonous gummi rats and grenade launchers. Tactical thinking and planning are essential! Go Kill Satan!","steam_appid":3763720,"support_info":{"email":"wespaugh@100-rogues.com","url":"https://www.100-Rogues.com"},"supported_languages":"English","type":"game","website":"https://www.100-rogues.com"}