akamai.steamstatic.com/store_item_assets/steam/apps/4048930/extras/a607beeb0034a0489b9eaa7c223e1d6b.avif?t=1766539044\" width=616 height=286 /></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Endless Survival</strong></h2><p class=\"bb_paragraph\" >The enemy never stops coming. Waves grow stronger with time. The question is not whether you can win \u2014 it\u2019s\u00a0<strong>how long you can endure.</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4048930/extras/12193089e6f31f46571da2704633256e.poster.avif?t=1766539044\" width=616 height=346 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4048930/extras/12193089e6f31f46571da2704633256e.webm?t=1766539044\" type=\"video/webm; codecs=vp9\"></video></span></p>","developers":["KEYMAKER GAMES"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4048930/fa112586cb532f54b4049f4b54b366f01614c53b/header.jpg?t=1766539044","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/4048930/466721511/6e5036acf7adf31a8e48abdd34accc98142dd700/1759153667/dash_av1.mpd?t=1759365492","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/4048930/466721511/6e5036acf7adf31a8e48abdd34accc98142dd700/1759153667/dash_h264.mpd?t=1759365492","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/4048930/466721511/6e5036acf7adf31a8e48abdd34accc98142dd700/1759153667/hls_264_master.m3u8?t=1759365492","id":257208596,"name":"IronShadow_GamePlay","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257208596/ebf868fe47feed740c9be8171ab21b37d7644254/movie_600x337.jpg?t=1759