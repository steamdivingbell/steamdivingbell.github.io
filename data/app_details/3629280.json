f1de568efa56a4dbd23f937c9b.poster.avif?t=1768873724\" width=560 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/extras/7d715ff1de568efa56a4dbd23f937c9b.webm?t=1768873724\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/extras/7d715ff1de568efa56a4dbd23f937c9b.mp4?t=1768873724\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Featuring</strong>:</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Four unique biomes, with eight different Locations within the Biomes, one for Endless and one for Survival each! Traverse through a forest, a deadly trap-filled dungeon, sandy island beach, and the fiery pits of a volcano!</strong></p></li><li><p class=\"bb_paragraph\" ><strong>More than fifty different types of enemies - from Rats to Ghouls to Wizards and Floating Skulls!</strong></p></li><li><p class=\"bb_paragraph\" ><strong>More than six unique Bosses to overcome, with plenty of Unique Elite enemies to encounter along the way!</strong></p></li></ul><p class=\"bb_paragraph\" >Ascend to higher difficulties after completing the game, providing even more challenge with additional objectives, new enemies, and greater the challenge!</p><p class=\"bb_paragraph\" style=\"text-align: center\">\u00a0<span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/extras/a811443de6ce6901efc7899d8de1efad.poster.avif?t=1768873724\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/extras/a811443de6ce6901efc7899d8de1efad.webm?t=1768873724\" type=\"video/webm; codecs=vp9\"></video></span></p><h2 class=\"bb_tag\" >Think you're the best? Compete in the Leaderboards</h2><p class=\"bb_paragraph\" ><strong>Each biome contains an Endless map variant, where you can</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Battle for rank 1 on the leaderboards</p></li><li><p class=\"bb_paragraph\" >Check out what other players are building, maybe learn some new strategies!</p></li><li><p class=\"bb_paragraph\" >Try to survive as long as possible, activating unique<strong> Shrines</strong> and fighting an endless amount of bosses and enemies!</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/extras/c9a32f395826519246afd3e356cd9b17.avif?t=1768873724\" width=1560 height=836 /></span></p><h2 class=\"bb_tag\" >It doesn't always have to be violent...</h2><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>Take a break from the fighting, and enjoy some minigames at your hub!</strong> Take part in blacksmithing - improve your equipment for your next battles or be adventurous and try to catch your own fish!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/extras/f6e2743d7137c03c72fe844cb2d6cc5e.poster.avif?t=1768873724\" width=1064 height=602 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/extras/f6e2743d7137c03c72fe844cb2d6cc5e.webm?t=1768873724\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/extras/f6e2743d7137c03c72fe844cb2d6cc5e.mp4?t=1768873724\" type=\"video/mp4\"></video></span></p>","developers":["GreatColtini Industries"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3629280/8a8940ab1369a4332bf733cc3b28