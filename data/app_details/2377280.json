ily inspired by the Nordic cities of the 1900s.</p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2377280/extras/Eriksholm-world2-600x250.gif?t=1752669881\" /></div></p><p class=\"bb_paragraph\"> </p>","developers":["River End Games"],"dlc":[3829100],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2377280/header.jpg?t=1752669881","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"metacritic":{"score":78,"url":"https://www.metacritic.com/game/pc/eriksholm-the-stolen-dream?ftag=MCD-06-10aaa1f"},"movies":[{"highlight":true,"id":257169075,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257169075/movie480.mp4?t=1752587235","max":"http://video.akamai.steamstatic.com/store_trailers/257169075/movie_max.mp4?t=1752587235"},"name":"Launch trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257169075/ac77bc55a5ff388fe1acf6da59ce962386387a26/movie_600x337.jpg?t=1752587235","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257169075/movie480_vp9.webm?t=1752587235","max":"http://video.akamai.steamstatic.com/store_trailers/257169075/movie_max_vp9.webm?t=1752587235"}},{"highlight":true,"id":257081818,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257081818/movie480.mp4?t=1734084604","max":"http://video.akamai.steamstatic.com/store_trailers/257081818/movie_max.mp4?t=1734084604"},"name":"Extended gameplay EN","thumbnail":"https://shared.akamai.steamstatic.com/s