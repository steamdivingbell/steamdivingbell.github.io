e0/ss_7d04e6f6f0619ed5343abc59e612cd773c30d9e0.1920x1080.jpg?t=1764622614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3462240/7d04e6f6f0619ed5343abc59e612cd773c30d9e0/ss_7d04e6f6f0619ed5343abc59e612cd773c30d9e0.600x338.jpg?t=1764622614"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3462240/cb179d844b2fef8a3134fa6ce42d4fd10455fdfb/ss_cb179d844b2fef8a3134fa6ce42d4fd10455fdfb.1920x1080.jpg?t=1764622614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3462240/cb179d844b2fef8a3134fa6ce42d4fd10455fdfb/ss_cb179d844b2fef8a3134fa6ce42d4fd10455fdfb.600x338.jpg?t=1764622614"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3462240/29c13f1d3ef864c8a384184f324d912229e82c29/ss_29c13f1d3ef864c8a384184f324d912229e82c29.1920x1080.jpg?t=1764622614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3462240/29c13f1d3ef864c8a384184f324d912229e82c29/ss_29c13f1d3ef864c8a384184f324d912229e82c29.600x338.jpg?t=1764622614"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3462240/c97b64eca3e7630b911f6f1c930eec63d3182cb7/ss_c97b64eca3e7630b911f6f1c930eec63d3182cb7.1920x1080.jpg?t=1764622614","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3462240/c97b64eca3e7630b911f6f1c930eec63d3182cb7/ss_c97b64eca3e7630b911f6f1c930eec63d3182cb7.600x338.jpg?t=1764622614"}],"short_description":"Take charge of your own miniature store and create the ultimate spot for hobby! Paint and collect miniatures, buy and sell sets, and design your shop. Set prices, attract customers, follow trends, and grow your business step by step. Can you build the store that will be known by the whole community?","steam_appid":3462240,"support_info":{"email":"karolhulkawork@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}