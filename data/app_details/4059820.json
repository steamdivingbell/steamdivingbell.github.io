_item_assets/steam/apps/4059820/a54b19fd5e4c63b39310174eb1ef7a36ec811ffd/ss_a54b19fd5e4c63b39310174eb1ef7a36ec811ffd.1920x1080.jpg?t=1760156091","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/a54b19fd5e4c63b39310174eb1ef7a36ec811ffd/ss_a54b19fd5e4c63b39310174eb1ef7a36ec811ffd.600x338.jpg?t=1760156091"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/80aa3b08a9b5001fce79c1ddcf1908bb1ebe2287/ss_80aa3b08a9b5001fce79c1ddcf1908bb1ebe2287.1920x1080.jpg?t=1760156091","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/80aa3b08a9b5001fce79c1ddcf1908bb1ebe2287/ss_80aa3b08a9b5001fce79c1ddcf1908bb1ebe2287.600x338.jpg?t=1760156091"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/7d01a23a5d93f87bb7c616f0e8a09ce94f411b10/ss_7d01a23a5d93f87bb7c616f0e8a09ce94f411b10.1920x1080.jpg?t=1760156091","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/7d01a23a5d93f87bb7c616f0e8a09ce94f411b10/ss_7d01a23a5d93f87bb7c616f0e8a09ce94f411b10.600x338.jpg?t=1760156091"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/34639ffd33034c053fb77e212a78b3bf9dca45ef/ss_34639ffd33034c053fb77e212a78b3bf9dca45ef.1920x1080.jpg?t=1760156091","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/34639ffd33034c053fb77e212a78b3bf9dca45ef/ss_34639ffd33034c053fb77e212a78b3bf9dca45ef.600x338.jpg?t=1760156091"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/9e8b9fc64ee0012fe4006dede3b3171258a07002/ss_9e8b9fc64ee0012fe4006dede3b3171258a07002.1920x1080.jpg?t=1760156091","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4059820/9e8b9fc64ee0012fe4006dede3b3171258a07002/ss_9e8b9fc64ee0012fe4006dede3b3171258a07002.600x338.jpg?t=1760156