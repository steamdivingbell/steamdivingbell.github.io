32860/577b17b2b50f2fe41f6f394556fa6286a0db8614/ss_577b17b2b50f2fe41f6f394556fa6286a0db8614.1920x1080.jpg?t=1761053641","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2332860/577b17b2b50f2fe41f6f394556fa6286a0db8614/ss_577b17b2b50f2fe41f6f394556fa6286a0db8614.600x338.jpg?t=1761053641"}],"short_description":"Factoriant is a factory builder where you construct an underground ant factory. As a queen ant, dig tunnels, carry food, and hatch worker ants to automate your production. Defend your nest from threats like birds and humans, and build a subterranean ant colony.","steam_appid":2332860,"support_info":{"email":"marudice@gmail.com","url":"https://marudice.com/en"},"supported_languages":"English, Simplified Chinese, Traditional Chinese, Japanese","type":"game","website":null}