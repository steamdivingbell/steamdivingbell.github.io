steam/apps/1418180/extras/3d1ec02d751a2f0c994368dd505302cd.mp4?t=1748835223\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>The decisions you make throughout the game will lead you down one of five potential paths, each fully fleshed out with many hours of content delving into the consequences of each road taken.</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1418180/extras/f428ce42c0efc2cecc64ac024f47c85b.poster.avif?t=1748835223\" width=616 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1418180/extras/f428ce42c0efc2cecc64ac024f47c85b.webm?t=1748835223\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1418180/extras/f428ce42c0efc2cecc64ac024f47c85b.mp4?t=1748835223\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Aside from the protagonist Kei, all of the characters both major and minor are fully voiced throughout the story, bringing another layer of richness and depth.</strong></p></li></ul>","developers":["OVERDRIVE"],"dlc":[1665710,1665720],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1418180/8787a6314774467f1699ce88551ee2324f23c353/header.jpg?t=1748835223","is_free":false,"legal_notice":"OVERDRIVE/STUDIO 696 <br />\r\nMangaGamer","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1418180/2092579003/9ef727f14811b0b148998784fc83e7fa943c027b/1751235778/dash_av1.mpd?t=1747728051","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1418180/2092579003/9ef727f14811b0b148998784fc83e7fa943c027b/175123577