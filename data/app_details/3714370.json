13a05cb15e6bc70f28bc50c8952ab9/ss_4e7d024c8a13a05cb15e6bc70f28bc50c8952ab9.1920x1080.jpg?t=1759209241","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3714370/4e7d024c8a13a05cb15e6bc70f28bc50c8952ab9/ss_4e7d024c8a13a05cb15e6bc70f28bc50c8952ab9.600x338.jpg?t=1759209241"}],"short_description":"In NoSlack Pets: Lo-Fi Paws, Miino is your cozy desktop companion: focus with Pomodoro, lofi, and white noise; every 30 minutes brings a Gift Box; mix 600+ decorations with 300+ Headgear; join the online study room, unwind with mini-games, and use the Cat Bus to tidy your screen.","steam_appid":3714370,"support_info":{"email":"lynkpingame@outlook.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Russian, Japanese, Simplified Chinese, Traditional Chinese, Portuguese - Brazil, Korean, Italian, Turkish, Polish, Thai","type":"game","website":null}