tore_item_assets/steam/apps/3714370/3137e5d3921326e306ec074e6795a0edd21b6052/ss_3137e5d3921326e306ec074e6795a0edd21b6052.1920x1080.jpg?t=1757941125","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3714370/3137e5d3921326e306ec074e6795a0edd21b6052/ss_3137e5d3921326e306ec074e6795a0edd21b6052.600x338.jpg?t=1757941125"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3714370/a5d5d49a99375b48386f8d39db4ae815d0c1e1c1/ss_a5d5d49a99375b48386f8d39db4ae815d0c1e1c1.1920x1080.jpg?t=1757941125","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3714370/a5d5d49a99375b48386f8d39db4ae815d0c1e1c1/ss_a5d5d49a99375b48386f8d39db4ae815d0c1e1c1.600x338.jpg?t=1757941125"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3714370/4e7d024c8a13a05cb15e6bc70f28bc50c8952ab9/ss_4e7d024c8a13a05cb15e6bc70f28bc50c8952ab9.1920x1080.jpg?t=1757941125","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3714370/4e7d024c8a13a05cb15e6bc70f28bc50c8952ab9/ss_4e7d024c8a13a05cb15e6bc70f28bc50c8952ab9.600x338.jpg?t=1757941125"}],"short_description":"No Slack Pets is a desktop idle game where your cute cat companion joins your daily work, study, and chill time. Enjoy collecting over 300+ adorable headgears, customizing your DIY room, and focusing better with Lo-Fi white noise and a built-in Pomodoro timer\u2014fun, chill, and full of surprises!","steam_appid":3714370,"support_info":{"email":"lynkpingame@outlook.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Russian, Japanese, Simplified Chinese, Traditional Chinese, Portuguese - Brazil, Korean, Italian, Turkish, Polish, Thai","type":"game","website":null}