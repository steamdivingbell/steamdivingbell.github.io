g to restore contact with the outside world. His knowledge of communication devices and security systems is a vital lifeline.</p><p class=\"bb_paragraph\" ></p>","developers":["Erost Game79 Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3972990/6185d928f7fac7e0b663bab837556846e609d48a/header.jpg?t=1757499104","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Infected Love : The Fatal Experiment ","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows xp or higher<br></li><li><strong>Processor:</strong> Intel Core2Duo or higher/ AMD Athlon 64 or higher<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> DirectX 9 higher<br></li><li><strong>Storage:</strong> 300 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Erost Game79 Studio"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia\nMedo","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Horror","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"Coming soon"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3972990/9f031c0736930d16ad6daccb20a161267c0d785d/ss_9f031c0736930d16ad6daccb20a161267c0d785d.1920x1080.jpg?t=1757499104","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3972990/9f031c0736930d16ad6daccb20a161267c0d785d/ss_9f031c0736930d16ad6daccb20a161267c0d785d.600x338.jpg?t=1757499104"},{"id":1,"path_full":"https://