inful struggle of adult life</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\">Add <i>Nerd Simulator</i> to your wishlist and get ready for the weirdest adulthood simulation ever\u2026</h2><p class=\"bb_paragraph\" ></p>","developers":["Radikate"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3128220/7bfbf163b020bad9ffa5e6d5574f6975b992e2a3/header.jpg?t=1773311800","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3128220/1647245225/54e4039b26f78ecb093950d6f17be06e5a4eeac9/1765988978/dash_av1.mpd?t=1765990161","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3128220/1647245225/54e4039b26f78ecb093950d6f17be06e5a4eeac9/1765988978/dash_h264.mpd?t=1765990161","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3128220/1647245225/54e4039b26f78ecb093950d6f17be06e5a4eeac9/1765988978/hls_264_master.m3u8?t=1765990161","id":257251649,"name":"Winter Sale Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257251649/56aaaef7f5dbcc55809193190b961fe6340273d1/movie_600x337.jpg?t=1765990161"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3128220/631876618/9fdff4c2687652430e38bad7d5574b56b56f4d54/1761167905/dash_av1.mpd?t=1761169704","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3128220/631876618/9fd