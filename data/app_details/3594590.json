bnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594590/a1a1624d8e74cc8f5ee19f9935581736a74aba77/ss_a1a1624d8e74cc8f5ee19f9935581736a74aba77.600x338.jpg?t=1770277962"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594590/793ae3cf2d3e0a6802826009e687f70f3aef40e7/ss_793ae3cf2d3e0a6802826009e687f70f3aef40e7.1920x1080.jpg?t=1770277962","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3594590/793ae3cf2d3e0a6802826009e687f70f3aef40e7/ss_793ae3cf2d3e0a6802826009e687f70f3aef40e7.600x338.jpg?t=1770277962"}],"short_description":"[Powers Reconfiguration] is a turn-based roguelike game. In this game, you can seize your enemies' abilities, skills, and even followers lock, stock and barrel! Build your own power through plunder while disrupting your foes' abilities - now let's see who the real boss is!","steam_appid":3594590,"support_info":{"email":"1702514410@qq.com","url":""},"supported_languages":"Simplified Chinese, Japanese, English","type":"game","website":null}