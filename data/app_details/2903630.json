/store_item_assets/steam/apps/2903630/c59a7152c32895ed6157e1032213a144f8643a59/ss_c59a7152c32895ed6157e1032213a144f8643a59.1920x1080.jpg?t=1770980337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/c59a7152c32895ed6157e1032213a144f8643a59/ss_c59a7152c32895ed6157e1032213a144f8643a59.600x338.jpg?t=1770980337"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/37e94fbb3635c2c8e9390c4ea1a281aef5383539/ss_37e94fbb3635c2c8e9390c4ea1a281aef5383539.1920x1080.jpg?t=1770980337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/37e94fbb3635c2c8e9390c4ea1a281aef5383539/ss_37e94fbb3635c2c8e9390c4ea1a281aef5383539.600x338.jpg?t=1770980337"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/027d00b0fe0728836b67be3013327f74bbc3be2f/ss_027d00b0fe0728836b67be3013327f74bbc3be2f.1920x1080.jpg?t=1770980337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/027d00b0fe0728836b67be3013327f74bbc3be2f/ss_027d00b0fe0728836b67be3013327f74bbc3be2f.600x338.jpg?t=1770980337"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/69c7d138e3d269a576c105ab418e14c86be9ca01/ss_69c7d138e3d269a576c105ab418e14c86be9ca01.1920x1080.jpg?t=1770980337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/69c7d138e3d269a576c105ab418e14c86be9ca01/ss_69c7d138e3d269a576c105ab418e14c86be9ca01.600x338.jpg?t=1770980337"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/4c2e4d4dc149cb99910fa97da12cffdd7dc4cad1/ss_4c2e4d4dc149cb99910fa97da12cffdd7dc4cad1.1920x1080.jpg?t=1770980337","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2903630/4c2e4d4dc149cb99910fa97da12cffdd7dc4cad1/ss_4c2e4d4dc149cb99910fa97da12cffdd7dc4cad1.600x338.jpg?t=1770980337"}],"short_description":"&quot;Millennial Strategy&quot; is a real-time CCG deck-building game with Roguelike elements. Collect cards to refine your deck, boost your combat power with books, items, and equipment, defeat formidable foes, and avert looming crises\u2014while unraveling the thousand-year-old secrets of an antique shop.","steam_appid":2903630,"support_info":{"email":"MiMoGames@foxmail.com","url":""},"supported_languages":"Simplified Chinese<strong>*</strong>, Traditional Chinese<strong>*</strong>, English<br><strong>*</strong>languages with full audio support","type":"game","website":null}