c.com/store_item_assets/steam/apps/3453760/bb0672e42e71f565d839683671cbf6f9bdc1d317/ss_bb0672e42e71f565d839683671cbf6f9bdc1d317.1920x1080.jpg?t=1762267995","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3453760/bb0672e42e71f565d839683671cbf6f9bdc1d317/ss_bb0672e42e71f565d839683671cbf6f9bdc1d317.600x338.jpg?t=1762267995"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3453760/034f62de9a3505b7e657af14f78edaeec65258d5/ss_034f62de9a3505b7e657af14f78edaeec65258d5.1920x1080.jpg?t=1762267995","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3453760/034f62de9a3505b7e657af14f78edaeec65258d5/ss_034f62de9a3505b7e657af14f78edaeec65258d5.600x338.jpg?t=1762267995"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3453760/daadfdcdfc864aa92452b57b187a07a64d65ad0e/ss_daadfdcdfc864aa92452b57b187a07a64d65ad0e.1920x1080.jpg?t=1762267995","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3453760/daadfdcdfc864aa92452b57b187a07a64d65ad0e/ss_daadfdcdfc864aa92452b57b187a07a64d65ad0e.600x338.jpg?t=1762267995"}],"short_description":"Arcanum Nights\ub294 \ub450 \uc544\uc774\uc640 \uc2a4\uc2b9\ub2d8\uc758 \uc774\uc57c\uae30\ub85c \uc9c4\ud589\ub429\ub2c8\ub2e4. \ud638\uae30\uc2ec\uc774 \uac00\ub4dd\ud55c \ub450 \uc544\uc774\ub294 \uac01\uc790\uc758 \ubcc4\ubb34\ub9ac\uc5d0 \ub300\ud55c \uc815\ubcf4\ub97c \uacf5\uc720\ud558\uba70 \ud558\ub098\uc758 \ubcc4\uc790\ub9ac\ub97c \uc774\ud574\ud558\uace0 \uc644\uc131\ud574\uc57c \ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \ub450 \uc544\uc774\ub97c \uc870\uc791\ud558\uba70 \ucee4\ubba4\ub2c8\ucf00\uc774\uc158\uc744 \ud1b5\ud574 \ub2e8\uc11c\ub97c \uc804\ub2ec\ud558\uace0, \uc0c1\ub300\ubc29\uc774 \uc81c\uacf5\ud558\ub294 \ub2e8\uc11c\ub97c \ud1b5\ud574 \uac01\uc790 \ud37c\uc990\uc744 \ud480\uc5b4\ub0b4\uc57c \ud569\ub2c8\ub2e4. \ub450 \uc544\uc774\ub294 \uac19\uc740 \uacf5\uac04\uc5d0 \uc788\uc9c0\ub9cc \uc11c\ub85c \ub2e4\ub978 \ub808\uc774\uc544\uc6c3\uacfc \uc2dc\uc810\uc744 \uac00\uc9d1\ub2c8\ub2e4. \ud63c\uc790\uc11c\ub294 \ud480 \uc218 \uc5c6\ub294 \ubb38\uc81c\ub97c \uae34\ubc00\ud55c \ud611\uc5c5\uacfc \uc18c\ud1b5\uc73c\ub85c \uadf9\ubcf5\ud574 \ub098\uac00\uc57c \ud569\ub2c8\ub2e4. (\uc2f1\uae00 \ud50c\ub808\uc774\uc5d0\uc11c\ub294 \ub450 \uce90\ub9ad\ud130\ub97c \ubc88\uac08\uc544 \uc870\uc791\ud558\uba70 \ud37c\uc990 \ud480\uc774\ub97c \uc9c4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.)","steam_appid":3453760,"support_info":{"email":"dyun15min@gmail.com","url":""},"type":"game","website":null}