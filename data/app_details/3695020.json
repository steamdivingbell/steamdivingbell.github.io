red.akamai.steamstatic.com/store_item_assets/steam/apps/3695020/2908aea533f5d493db5b108cd2103f9b41320de2/ss_2908aea533f5d493db5b108cd2103f9b41320de2.1920x1080.jpg?t=1750463934","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3695020/2908aea533f5d493db5b108cd2103f9b41320de2/ss_2908aea533f5d493db5b108cd2103f9b41320de2.600x338.jpg?t=1750463934"}],"short_description":"Beat Dodger is a Rhythm game on rails where you need to dodge obstacles and stay on beat! With different obstacle-types, soar, dodge, and tap on beat across various worlds through their music! Go for the highest score in brutal difficulties or relax without worrying about score!","steam_appid":3695020,"support_info":{"email":"sunsealstudios@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}