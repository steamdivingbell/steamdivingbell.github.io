ents who adapt to their tactics and decisions.</p>","developers":["Abdelrahman Tarek"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3117620/eca6cd61d9c8a28b6fe8231fc53d1631255f2ffd/header.jpg?t=1758883077","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3117620/1798788244/56c0027bbc498bd21ec7a0c9579a8a877ffb8912/1758660266/dash_av1.mpd?t=1758681230","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3117620/1798788244/56c0027bbc498bd21ec7a0c9579a8a877ffb8912/1758660266/dash_h264.mpd?t=1758681230","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3117620/1798788244/56c0027bbc498bd21ec7a0c9579a8a877ffb8912/1758660266/hls_264_master.m3u8?t=1758681230","id":257204621,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257204621/movie480.mp4?t=1758681230","max":"https://video.akamai.steamstatic.com/store_trailers/257204621/movie_max.mp4?t=1758681230"},"name":"Robabekya Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257204621/983f7c7e05579259e2e79a320ac1dab8811ec0a4/movie_600x337.jpg?t=1758681230","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257204621/movie480_vp9.webm?t=1758681230","max":"https://video.akamai.steamstatic.com/store_trailers/257204621/movie_max_vp9.webm?t=1758681230"}}],"name":"Robabekya","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"defau