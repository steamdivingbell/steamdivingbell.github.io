0/587c2b31c3b0c3a0c14ecce6d5d333ad5ddf24a8/ss_587c2b31c3b0c3a0c14ecce6d5d333ad5ddf24a8.600x338.jpg?t=1772420383"}],"short_description":"Cathouse Club is a top down, point and-click RPG that blends detective storytelling with emotional skill checks and D20 style dice rolls. Explore a flooded, climate-ravaged New York City through the eyes of an AI reliving human memories.","steam_appid":2891080,"support_info":{"email":"alex@cathouse.club","url":""},"supported_languages":"English","type":"game","website":null}