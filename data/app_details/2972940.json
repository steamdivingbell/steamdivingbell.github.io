754","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2972940/ss_f59bf9cd11cb5031853227da77a9fb690fe08ad5.600x338.jpg?t=1752827754"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2972940/ss_47e51411afceccff6479f45578a10314e3e96767.1920x1080.jpg?t=1752827754","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2972940/ss_47e51411afceccff6479f45578a10314e3e96767.600x338.jpg?t=1752827754"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2972940/ss_6c1792b0ecc68fe577444efad45b75d3a8a74637.1920x1080.jpg?t=1752827754","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2972940/ss_6c1792b0ecc68fe577444efad45b75d3a8a74637.600x338.jpg?t=1752827754"}],"short_description":"Observe. Think. Decode.A first-person adventure game focused on code-breaking and puzzle-solving. Lost in a maze of memories, can you find the path to save the future?","steam_appid":2972940,"support_info":{"email":"wen_sx@teamveister.com","url":""},"supported_languages":"English, Simplified Chinese, Japanese","type":"game","website":null}