bb_paragraph\" >Your journey through this virtual metropolis of danger and opportunity won't be lonely! Meet hundreds of unique Animus characters: a dual-wielding Reaper carrying a mighty coffin, a punk genius Hacker, a metropolitan Empress who manipulates Soul Flames... Join forces to confront unknown threats and unveil the mysteries of this futuristic city.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2084970/extras/65e13532403d770e67402835edc829e0.avif?t=1761188299\" width=1560 height=878 /></span></p><p class=\"bb_paragraph\" ></p>","developers":["XD"],"genres":[{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2084970/header.jpg?t=1761188299","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2084970/351813237/be73e2ff6c052be9624653c377cf2762c7106028/1757914996/dash_av1.mpd?t=1757933941","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2084970/351813237/be73e2ff6c052be9624653c377cf2762c7106028/1757914996/dash_h264.mpd?t=1757933941","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2084970/351813237/be73e2ff6c052be9624653c377cf2762c7106028/1757914996/hls_264_master.m3u8?t=1757933941","id":257197859,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257197859/movie480.mp4?t=1757933941","max":"https://video.akamai.steamstatic.com/store_trailers/257197859/movie_max.mp4?t=1757933941"},"name":"Global Store Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257197859/07e00f50742aabebecccab16e439e97908cb3985/movie_600x337.jpg?t=1757933941","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/