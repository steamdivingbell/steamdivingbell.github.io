strong>The Creator's room awaits you!</strong></h2><p class=\"bb_paragraph\" >Build your own levels using a very simple and intuitive editor designed specifically so that anyone can express themselves.<br>Create the most difficult thing a player has ever seen or a level of unique beauty and share it with your friends or via Steamworks!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Enter a world that blends a unique and visceral atmosphere with a creative and emerging gameplay system, where every step forward deepens the mystery of your own existence.<br>Every encounter is an opportunity to evolve both externally and internally!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>The game is not recommended for individuals with epilepsy or epileptic seizures.</i></p>","developers":["IV Productions","Elan Manuguerra"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3560430/459535a5c47f81dd61eb97e8655e7b61808d7d6b/header.jpg?t=1773824067","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3560430/857730952/c27e5c4d7f92aaf0a6255f6b67cfe6b4287b26f1/1761322345/dash_av1.mpd?t=1761323450","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3560430/857730952/c27e5c4d7f92aaf0a6255f6b67cfe6b4287b26f1/1761322345/dash_h264.mpd?t=1761323450","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3560430/857730952/c27e5c4d7f92aaf0a6255f6b67cfe6b4287b26f1/1761322345/hls_264_master.m3u8?t=1761323450","id":257143545,"name":"Evolvania Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257143545/f46e7465d36f6bf5fd41e9c2e113fd09fd2b113d/movie_600x337.jpg?t=1761323450"}],"name":"Evolvania","package_groups":[],"pc_requirements":{"minimum":"