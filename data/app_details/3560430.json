amai.steamstatic.com/store_item_assets/steam/apps/3560430/cb583b7f969b0aa5314a544f042208dd84973245/ss_cb583b7f969b0aa5314a544f042208dd84973245.1920x1080.jpg?t=1773824067","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3560430/cb583b7f969b0aa5314a544f042208dd84973245/ss_cb583b7f969b0aa5314a544f042208dd84973245.600x338.jpg?t=1773824067"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3560430/2da1d48d06e2f6576eb6332048ded522a9b1cbd7/ss_2da1d48d06e2f6576eb6332048ded522a9b1cbd7.1920x1080.jpg?t=1773824067","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3560430/2da1d48d06e2f6576eb6332048ded522a9b1cbd7/ss_2da1d48d06e2f6576eb6332048ded522a9b1cbd7.600x338.jpg?t=1773824067"}],"short_description":"Explore a colossal creature by blending in with the environment and enemies. Evolve and gain new powers in this hand-drawn metroidvania where you can experience a unique adventure or create your own with a special level editor.","steam_appid":3560430,"support_info":{"email":"ivan@ivproductions.it","url":"www.ivproductions.it"},"supported_languages":"English, Italian, French, German, Simplified Chinese, Japanese","type":"game","website":"https://power-up-team.com/evolvania/"}