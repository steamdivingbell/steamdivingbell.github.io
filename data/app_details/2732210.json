, wield your favorite weapon, and get ready to smash through the sea in this bloodshed.<br> </p><p class=\"bb_paragraph\">Hopefully, you will manage to escape from this <strong><i>Hopeless Sea</i></strong>! </p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2732210/extras/wishlist_on_steam_20240730.png?t=1744722861\" /></p>","developers":["Potato Cat"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2732210/header.jpg?t=1744722861","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257098184,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257098184/movie480.mp4?t=1739556559","max":"http://video.akamai.steamstatic.com/store_trailers/257098184/movie_max.mp4?t=1739556559"},"name":"Demo_0.6_trailer_English","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257098184/1ac1c46588a2301f058d7e1b721b814f934bbee4/movie_600x337.jpg?t=1739556559","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257098184/movie480_vp9.webm?t=1739556559","max":"http://video.akamai.steamstatic.com/store_trailers/257098184/movie_max_vp9.webm?t=1739556559"}}],"name":"Hopeless Sea","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> 1.8 GHz<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> 256 MB RAM<br></li><li><strong>DirectX:</strong> Version 9.0<br></li><li><strong>Storage:</strong> 128 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Potato Cat"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia fantasiosa","rating":"l","rating_generated":"1","requir