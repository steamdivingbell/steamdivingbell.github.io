debc6bf4e8ed2fe8.1920x1080.jpg?t=1747087050","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3293260/8ec56d86fb95f1e0a552e514debc6bf4e8ed2fe8/ss_8ec56d86fb95f1e0a552e514debc6bf4e8ed2fe8.600x338.jpg?t=1747087050"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3293260/c727a2c0c0eb327682479d4d3c0eae873ab76e5b/ss_c727a2c0c0eb327682479d4d3c0eae873ab76e5b.1920x1080.jpg?t=1747087050","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3293260/c727a2c0c0eb327682479d4d3c0eae873ab76e5b/ss_c727a2c0c0eb327682479d4d3c0eae873ab76e5b.600x338.jpg?t=1747087050"}],"short_description":"Build and run your own waterpark. Design slides, send guests flying with ragdoll physics, manage staff, and fully customize your park. Turn total madness into a five-star empire!","steam_appid":3293260,"support_info":{"email":"support@cayplay.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}