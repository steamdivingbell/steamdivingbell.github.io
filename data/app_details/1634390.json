ffer gifts to the afterlife.<br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1634390/extras/ecdb5a5fb8ba6b230a2d25fd4548bc90.avif?t=1762362034\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1634390/extras_big/ecdb5a5fb8ba6b230a2d25fd4548bc90.avif?t=1762362034 width=1600 height=900 /></span></p><p class=\"bb_paragraph\" ></p>","developers":["Third Pie Studios"],"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1634390/6fe09311a47b40666b4e8a0d6df7a89cdb01032f/header.jpg?t=1762362034","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1634390/501205462/b283011b2e5044a292a7e70b15543e2f72cca9e4/1762020929/dash_av1.mpd?t=1762023032","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1634390/501205462/b283011b2e5044a292a7e70b15543e2f72cca9e4/1762020929/dash_h264.mpd?t=1762023032","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1634390/501205462/b283011b2e5044a292a7e70b15543e2f72cca9e4/1762020929/hls_264_master.m3u8?t=1762023032","id":256890382,"name":"Ages of Cataria Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256890382/27036981786d4dbff4b758181e057d87d874d48b/movie_600x337.jpg?t=1762023032"}],"name":"Ages of Cataria","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Ages of Cataria - $19.99 USD","packageid":580302,"percent_savings":0,"percen