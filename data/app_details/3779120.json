 class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3779120/extras/3727f5854376e5346ecc4d5464a74f83.poster.avif?t=1773149921\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3779120/extras/3727f5854376e5346ecc4d5464a74f83.webm?t=1773149921\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3779120/extras/3727f5854376e5346ecc4d5464a74f83.mp4?t=1773149921\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>","developers":["Howling Hamster Entertainment"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3779120/23c7e44918d8f983154574363f16dd576bd3f3e2/header.jpg?t=1773149921","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3779120/140072245/9580cb11129368c97414249d0ae3e1f6b3841e90/1765562209/dash_av1.mpd?t=1766409928","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3779120/140072245/9580cb11129368c97414249d0ae3e1f6b3841e90/1765562209/dash_h264.mpd?t=1766409928","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3779120/140072245/9580cb11129368c97414249d0ae3e1f6b3841e90/1765562209/hls_264_master.m3u8?t=1766409928","id":257248764,"name":"Official Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257248764/58902b359a41836d45c575edbcb0e991d16983cb/movie_600x337.jpg?t=1766409928"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3779120/1754483970/9c5bcb437f11ca0e648d3481b66b928899383208/1755014573/dash_av1.mpd?t=1755016149","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3779120/1754483970/9c5bcb437f11ca0e648d3481b66b928899383208/1755014573/dash_h264.mpd?t=1755016149","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3779120/1754483970/9c5bcb437f11ca0e648d3481b66b928899383208/1755014573/hls_264_master.m3u8?t=1755016149","id":257180870,"name":"Dive into Alien Infested Waters","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257180870/b91a78d8a1233783082312e15ddb404816080cb6/movie_600x337.jpg?t=1755016149"}],"name":"Sub-Species","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3 M380<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD 4000<br></li><li><strong>Storage:</strong> 8 GB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Howling Hamster Entertainment"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia fantasiosa","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Fantasy-Gewalt","rating":"6","rating_generated":"1","required_age":"6","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"reviews":"\u201cThe hook that jumps out right away is how Sub-Species blends the atmospheric tension of Subnautica with the aggressive arcade energy of Space Invaders.\u201d<br>Comicbook<br><br>\u201cThere is something inherently unsettling about the ocean\u2026 that specific brand of thalassophobia was solidified by Subnautica.\u201d<br>Total Apex Gaming<br><br>\u201cThe trailer, which you can watch below, definitely has our attention. We\u2019re big Ecco the Dolphin fans and while Ecco\u2019s arsenal was limited to headbutts and sonar attacks, we\u2019re always on the lookout for opportunities to explore