ore_item_assets/steam/apps/2140310/0d2c386233f6e09efb9e8482e0cb126d22e787ec/ss_0d2c386233f6e09efb9e8482e0cb126d22e787ec.1920x1080.jpg?t=1766051390","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2140310/0d2c386233f6e09efb9e8482e0cb126d22e787ec/ss_0d2c386233f6e09efb9e8482e0cb126d22e787ec.600x338.jpg?t=1766051390"}],"short_description":"Craft magical weapons. Uncover synergies. Unleash your creativity. A top-down weapon-building roguelite dungeon crawler. Jump into the Magic Well, gather powerful scrolls, build your magical weapon and fight unique ink monsters your way!","steam_appid":2140310,"support_info":{"email":"wishmewell.contact@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Simplified Chinese, Korean, Polish, Portuguese - Brazil, Russian, Japanese","type":"game","website":null}