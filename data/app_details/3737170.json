_b78d847008737666c46d5171354def7897f4c4a7.600x338.jpg?t=1767572407"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3737170/7acc7a198e3bcefad510e268dae5b39f4ba60cd4/ss_7acc7a198e3bcefad510e268dae5b39f4ba60cd4.1920x1080.jpg?t=1767572407","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3737170/7acc7a198e3bcefad510e268dae5b39f4ba60cd4/ss_7acc7a198e3bcefad510e268dae5b39f4ba60cd4.600x338.jpg?t=1767572407"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3737170/df72677ce946007e049ca9bf078ebe3867744c5e/ss_df72677ce946007e049ca9bf078ebe3867744c5e.1920x1080.jpg?t=1767572407","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3737170/df72677ce946007e049ca9bf078ebe3867744c5e/ss_df72677ce946007e049ca9bf078ebe3867744c5e.600x338.jpg?t=1767572407"}],"short_description":"Delve into this 2D sci-fi action roguelite and survive 8 procedurally generated planets each run. Explore, build defenses, and stack upgrades to stay ahead of the increasingly difficult waves of hostile aliens","steam_appid":3737170,"support_info":{"email":"nanolithicdigital+support@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.nanolithicdigital.com/"}