ps/3666000/f5a16f14902f29e36fc06e9869477b09d78467c6/ss_f5a16f14902f29e36fc06e9869477b09d78467c6.600x338.jpg?t=1770915508"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3666000/56b446bf8fa225ab358972fc577286963f8a40ff/ss_56b446bf8fa225ab358972fc577286963f8a40ff.1920x1080.jpg?t=1770915508","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3666000/56b446bf8fa225ab358972fc577286963f8a40ff/ss_56b446bf8fa225ab358972fc577286963f8a40ff.600x338.jpg?t=1770915508"}],"short_description":"Take care of a cursed chapel located in a forgotten corner of a small town. Maintain your daily routine, improvise with limited tools, and complete your tasks before nightfall in a surreal horror experience marked by maintenance and decay.","steam_appid":3666000,"support_info":{"email":"studiopaleopossum@gmail.com","url":""},"supported_languages":"English, Portuguese - Brazil, French, Italian, German, Spanish - Spain, Japanese, Korean, Russian, Simplified Chinese, Ukrainian, Spanish - Latin America","type":"game","website":null}