alter in the face of conflict.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/f23801996d35e7fb001756e470157763.poster.avif?t=1758062491\" width=1170 height=456 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/f23801996d35e7fb001756e470157763.webm?t=1758062491\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/f23801996d35e7fb001756e470157763.mp4?t=1758062491\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/906c28c2c4e6db31d26e3145a6985f37.poster.avif?t=1758062491\" width=1170 height=456 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/906c28c2c4e6db31d26e3145a6985f37.webm?t=1758062491\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/906c28c2c4e6db31d26e3145a6985f37.mp4?t=1758062491\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/6a70e4f760c8ab473a9e95d7d22cfbd9.poster.avif?t=1758062491\" width=1170 height=456 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/6a70e4f760c8ab473a9e95d7d22cfbd9.webm?t=1758062491\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4020450/extras/6a70e4f760c8ab473a9e95d7d22cfbd9.mp4?t=1758062491\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img