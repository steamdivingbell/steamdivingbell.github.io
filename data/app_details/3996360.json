bb_paragraph\" >1-3 hour experience designed to be finished in one sitting or replayed with new eyes</p></li><li><p class=\"bb_paragraph\" >Hand-drawn 2D art shifting between clean and cartoonish to stark and disturbing</p></li></ul>","developers":["DaeDreamery"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996360/42c40d0a853b28c4a39bc4bc33fe448da4280779/header.jpg?t=1758349612","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Ajar","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Microsoft\u00ae Windows 10<br></li><li><strong>Processor:</strong> 1.8 Ghz Processor<br></li><li><strong>Memory:</strong> 1 GB RAM</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["DaeDreamery"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia\nMedo\nDrogas l\u00edcitas","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Horror\nAlkohol / Tabak\nSexuelle Andeutungen","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996360/9e58834dc02043237aa8d091ac3afbc712d63ff4/ss_9e58834dc02043237aa8d091ac3afbc712d63ff4.1920x1080.jpg?t=1758349612","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996360/9e58834dc02043237aa8d091ac3afbc712d63ff4/ss_9e58834dc02043237aa8d091ac3afbc712d63ff4.600x338.jpg?t=1758349612"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3996360/08594c0a9a92311615f15dec8b26bba54548077f/ss_08594c0a9a92311615f15dec8b26bba54548077f.1920x1080.jpg?t=1758349612","path_thumbnail