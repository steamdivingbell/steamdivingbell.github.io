akamai.steamstatic.com/store_item_assets/steam/apps/4034540/b83d4871736dd45b36e6d6adbde0c45f442f4f8a/ss_b83d4871736dd45b36e6d6adbde0c45f442f4f8a.1920x1080.jpg?t=1772110124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/b83d4871736dd45b36e6d6adbde0c45f442f4f8a/ss_b83d4871736dd45b36e6d6adbde0c45f442f4f8a.600x338.jpg?t=1772110124"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/bb689fe49f613ff32f53db31085ef7075f7e95a9/ss_bb689fe49f613ff32f53db31085ef7075f7e95a9.1920x1080.jpg?t=1772110124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/bb689fe49f613ff32f53db31085ef7075f7e95a9/ss_bb689fe49f613ff32f53db31085ef7075f7e95a9.600x338.jpg?t=1772110124"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/e1f7562eec43c2107aca4d7a2fdbdf466b368cb9/ss_e1f7562eec43c2107aca4d7a2fdbdf466b368cb9.1920x1080.jpg?t=1772110124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/e1f7562eec43c2107aca4d7a2fdbdf466b368cb9/ss_e1f7562eec43c2107aca4d7a2fdbdf466b368cb9.600x338.jpg?t=1772110124"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/081120f3eea663690b4b08f4a2973cf44645f14a/ss_081120f3eea663690b4b08f4a2973cf44645f14a.1920x1080.jpg?t=1772110124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/081120f3eea663690b4b08f4a2973cf44645f14a/ss_081120f3eea663690b4b08f4a2973cf44645f14a.600x338.jpg?t=1772110124"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/298f9a536801580d1358cf5c4ff53db1deced9d4/ss_298f9a536801580d1358cf5c4ff53db1deced9d4.1920x1080.jpg?t=1772110124","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4034540/298f9a536801580d1358cf5c4ff53db1deced9d4/ss_298f9a536801580d1358cf5c4ff53db1deced9d4.600x338.jpg?t=1772110124"}],"short_description":"Lines We Draw is a 3D isometric narrative strategy game set at a tense Cold War border. Inspect documents, interrogate travelers, and manage a shifting checkpoint between rival states. Your stamp decides fates: Will you be a hero of the people, or a tool of the regime?","steam_appid":4034540,"support_info":{"email":"support@frostemberstudios.com","url":"https://frostemberstudios.com/"},"supported_languages":"English<strong>*</strong>, Czech<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://frostemberstudios.com/"}