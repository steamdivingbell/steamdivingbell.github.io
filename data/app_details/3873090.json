e_item_assets/steam/apps/3873090/1a279f3cfc012bd03f7d4316fba0f435d3ad0edd/ss_1a279f3cfc012bd03f7d4316fba0f435d3ad0edd.1920x1080.jpg?t=1753349921","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3873090/1a279f3cfc012bd03f7d4316fba0f435d3ad0edd/ss_1a279f3cfc012bd03f7d4316fba0f435d3ad0edd.600x338.jpg?t=1753349921"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3873090/7221b147a03536535f29c4641f05fd0bec8bb930/ss_7221b147a03536535f29c4641f05fd0bec8bb930.1920x1080.jpg?t=1753349921","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3873090/7221b147a03536535f29c4641f05fd0bec8bb930/ss_7221b147a03536535f29c4641f05fd0bec8bb930.600x338.jpg?t=1753349921"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3873090/d6a88b70890734ba94021a2ca522e6ce6e8af6ea/ss_d6a88b70890734ba94021a2ca522e6ce6e8af6ea.1920x1080.jpg?t=1753349921","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3873090/d6a88b70890734ba94021a2ca522e6ce6e8af6ea/ss_d6a88b70890734ba94021a2ca522e6ce6e8af6ea.600x338.jpg?t=1753349921"}],"short_description":"The Abbess Garden is a cozy and historical gardening game set in 17th-century France. Play as Agnes, a young peasant who is tasked to grow plants, find and identify new ones. Help uncover a spy plot, assist others in the local community, and find a lover.","steam_appid":3873090,"support_info":{"email":"abbessgarden@gmail.com","url":""},"supported_languages":"English","type":"demo","website":"https://profuse-clover-7f6.notion.site/The-Abbess-Garden-1a57d26db14d80d9a227ec61b1fcea61"}