h_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/f810bdcfb152867ca091d4edadd1525742fe3500/ss_f810bdcfb152867ca091d4edadd1525742fe3500.600x338.jpg?t=1773392322"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/efda3f25a55226aaca577eabdb7648efd17f36bd/ss_efda3f25a55226aaca577eabdb7648efd17f36bd.1920x1080.jpg?t=1773392322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/efda3f25a55226aaca577eabdb7648efd17f36bd/ss_efda3f25a55226aaca577eabdb7648efd17f36bd.600x338.jpg?t=1773392322"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/cc57eb0e72f83e387d9f97370dbcdd68b1761bb8/ss_cc57eb0e72f83e387d9f97370dbcdd68b1761bb8.1920x1080.jpg?t=1773392322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/cc57eb0e72f83e387d9f97370dbcdd68b1761bb8/ss_cc57eb0e72f83e387d9f97370dbcdd68b1761bb8.600x338.jpg?t=1773392322"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/102cc839290dfbd48da7b22705af48976a4ff55f/ss_102cc839290dfbd48da7b22705af48976a4ff55f.1920x1080.jpg?t=1773392322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/102cc839290dfbd48da7b22705af48976a4ff55f/ss_102cc839290dfbd48da7b22705af48976a4ff55f.600x338.jpg?t=1773392322"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/47aa89e28b199480058380140c48edb55e11b176/ss_47aa89e28b199480058380140c48edb55e11b176.1920x1080.jpg?t=1773392322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/47aa89e28b199480058380140c48edb55e11b176/ss_47aa89e28b199480058380140c48edb55e11b176.600x338.jpg?t=1773392322"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/af0472d6d9f6cbe41f4e7ed55ab600ff47f4ef70/ss_af0472d6d9f6cbe41f4e7ed55ab600ff47f4ef70.1920x1080.jpg?t=1773392322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/af0472d6d9f6cbe41f4e7ed55ab600ff47f4ef70/ss_af0472d6d9f6cbe41f4e7ed55ab600ff47f4ef70.600x338.jpg?t=1773392322"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/10ab024ec6dc45156487971cb603230b6b3afdc1/ss_10ab024ec6dc45156487971cb603230b6b3afdc1.1920x1080.jpg?t=1773392322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4022290/10ab024ec6dc45156487971cb603230b6b3afdc1/ss_10ab024ec6dc45156487971cb603230b6b3afdc1.600x338.jpg?t=1773392322"}],"short_description":"Immerse yourself in an alien ocean in this open-world survival game. Explore the biomechanical depths, tame alien creatures, pilot submarines, and uncover the mysteries of the alien entity known as Thalassa.","steam_appid":4022290,"support_info":{"email":"info@sanliuk.com","url":"https://www.sanliuk.com/ithalassa"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.sanliuk.com/ithalassa"}