d.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/46d3dabd98764314f72a2bbbf7997a2d64e94b61/ss_46d3dabd98764314f72a2bbbf7997a2d64e94b61.1920x1080.jpg?t=1772698909","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/46d3dabd98764314f72a2bbbf7997a2d64e94b61/ss_46d3dabd98764314f72a2bbbf7997a2d64e94b61.600x338.jpg?t=1772698909"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/3bbb335dc66d1eb7f835ff9e2b860be011325f1d/ss_3bbb335dc66d1eb7f835ff9e2b860be011325f1d.1920x1080.jpg?t=1772698909","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/3bbb335dc66d1eb7f835ff9e2b860be011325f1d/ss_3bbb335dc66d1eb7f835ff9e2b860be011325f1d.600x338.jpg?t=1772698909"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/e01dea40ba89adba15aeff2db3a1fe01e04b6359/ss_e01dea40ba89adba15aeff2db3a1fe01e04b6359.1920x1080.jpg?t=1772698909","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/e01dea40ba89adba15aeff2db3a1fe01e04b6359/ss_e01dea40ba89adba15aeff2db3a1fe01e04b6359.600x338.jpg?t=1772698909"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/bb9181277670f2865e6c8cde98a1a5e106bbf88d/ss_bb9181277670f2865e6c8cde98a1a5e106bbf88d.1920x1080.jpg?t=1772698909","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/bb9181277670f2865e6c8cde98a1a5e106bbf88d/ss_bb9181277670f2865e6c8cde98a1a5e106bbf88d.600x338.jpg?t=1772698909"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/c2675821472e10f92c725013456639c064732f3a/ss_c2675821472e10f92c725013456639c064732f3a.1920x1080.jpg?t=1772698909","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3897060/c2675821472e10f92c725013456639c064732f3a/ss_c2675821472e10f92c725013456639c0