842d02d51c.600x338.jpg?t=1759450851"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488620/f80dddfc5c2d78cb59fc9dbf4cc8e65096956088/ss_f80dddfc5c2d78cb59fc9dbf4cc8e65096956088.1920x1080.jpg?t=1759450851","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3488620/f80dddfc5c2d78cb59fc9dbf4cc8e65096956088/ss_f80dddfc5c2d78cb59fc9dbf4cc8e65096956088.600x338.jpg?t=1759450851"}],"short_description":"Birdoo: Feathered Fury is an indie action game were you assume the role of a bird embarking on a quest for revenge against the humans who wronged him. No longer will you tolerate being called a &quot;flying rat&quot; or being shooed away. It's time to exact your revenge!","steam_appid":3488620,"support_info":{"email":"contact@runnybirdproductions.com","url":"http://www.runnybirdproductions.com"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"http://www.runnybirdproductions.com"}