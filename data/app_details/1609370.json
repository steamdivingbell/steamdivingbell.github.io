9370/extras/bb67d2d8500e57275a066d11c94f3459.mp4?t=1770646605\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>FURNITURE CUSTOMIZATION</strong> \u2013 <strong>DESIGN YOUR LIVING SPACE</strong></p><p class=\"bb_paragraph\" >You can also customize the interior walls, floor, and ceiling of your caravan. </p><p class=\"bb_paragraph\" >Choose from wood, solid colors, or fabrics</p><p class=\"bb_paragraph\" >Seat selection </p><p class=\"bb_paragraph\" >Cabin selection </p><p class=\"bb_paragraph\" >Decor selection </p><p class=\"bb_paragraph\" >Curtain and fabric selection </p><p class=\"bb_paragraph\" >Fridge, grill, sink, toilet...\u00a0</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u2705<strong>DON\u2019T FORGET TO ADD TO YOUR WISHLIST!\u2705</strong></h2>","developers":["Akif Akdemir"],"dlc":[3755710],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Free To Play","id":"37"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1609370/1d5ee9689aa45220e424942177370aa0e6a7b094/header.jpg?t=1770646605","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1609370/1386566216/dedf09c80a7596bc0c89549ec101ef833931b33d/1754783367/dash_av1.mpd?t=1754789716","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1609370/1386566216/dedf09c80a7596bc0c89549ec101ef833931b33d/1754783367/dash_h264.mpd?t=1754789716","highlight":true,"hls_h264":"https://vide