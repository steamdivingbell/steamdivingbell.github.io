29b1d6cf9/ss_07bfc3fa81138be8887b485bc24a9b029b1d6cf9.600x338.jpg?t=1758042274"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/7047dcb27320ba8728bbe324ab96abf62bccee0c/ss_7047dcb27320ba8728bbe324ab96abf62bccee0c.1920x1080.jpg?t=1758042274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/7047dcb27320ba8728bbe324ab96abf62bccee0c/ss_7047dcb27320ba8728bbe324ab96abf62bccee0c.600x338.jpg?t=1758042274"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/b8e355755dc0aa50652c26a24b360ab02a8c5f85/ss_b8e355755dc0aa50652c26a24b360ab02a8c5f85.1920x1080.jpg?t=1758042274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/b8e355755dc0aa50652c26a24b360ab02a8c5f85/ss_b8e355755dc0aa50652c26a24b360ab02a8c5f85.600x338.jpg?t=1758042274"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/7413409d208860ef7c5cede217625e91a4acb0f5/ss_7413409d208860ef7c5cede217625e91a4acb0f5.1920x1080.jpg?t=1758042274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/7413409d208860ef7c5cede217625e91a4acb0f5/ss_7413409d208860ef7c5cede217625e91a4acb0f5.600x338.jpg?t=1758042274"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/8cb6540b55292fb32b3311d504298f15271451af/ss_8cb6540b55292fb32b3311d504298f15271451af.1920x1080.jpg?t=1758042274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/8cb6540b55292fb32b3311d504298f15271451af/ss_8cb6540b55292fb32b3311d504298f15271451af.600x338.jpg?t=1758042274"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/e993fef238ad8314fb343a9d66ad295e2a8818fb/ss_e993fef238ad8314fb343a9d66ad295e2a8818fb.1920x1080.jpg?t=1758042274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/e993fef238ad8314fb343a9d66ad295e2a8818fb/ss_e993fef238ad8314fb343a9d66ad295e2a8818fb.600x338.jpg?t=1758042274"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/8223a96479927815edf3f5db3673c96dd64ada2d/ss_8223a96479927815edf3f5db3673c96dd64ada2d.1920x1080.jpg?t=1758042274","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3973610/8223a96479927815edf3f5db3673c96dd64ada2d/ss_8223a96479927815edf3f5db3673c96dd64ada2d.600x338.jpg?t=1758042274"}],"short_description":"Who said being a Doctor was easy? In Prescribe and Pray, you are the Doctor! Check the patient's identity, diagnose their illness (often bizarre), and write their prescription. All without making a mistake! So, are you up for the challenge?","steam_appid":3973610,"support_info":{"email":"contact.nuclearrabbits@gmail.com","url":""},"supported_languages":"English, French","type":"demo","website":null}