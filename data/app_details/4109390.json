6d8d4ffd407de7c80bd6ed6ba95f798fcdbf557e.1920x1080.jpg?t=1768900674","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4109390/6d8d4ffd407de7c80bd6ed6ba95f798fcdbf557e/ss_6d8d4ffd407de7c80bd6ed6ba95f798fcdbf557e.600x338.jpg?t=1768900674"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4109390/9c1d0935da96b38046e2801de37d6e4981a58e85/ss_9c1d0935da96b38046e2801de37d6e4981a58e85.1920x1080.jpg?t=1768900674","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4109390/9c1d0935da96b38046e2801de37d6e4981a58e85/ss_9c1d0935da96b38046e2801de37d6e4981a58e85.600x338.jpg?t=1768900674"}],"short_description":"Based on the &quot;Akasha&quot; manga series, &quot;Akasha: Taliokata\u2019s Tomb&quot; is a hand-drawn 2D action platformer. Use the power of the elements to create combos and dodge enemy attacks as you explore Panfa \u2014 the realm of the god Earth\u2014 to uncover the truth behind the ancient divine beast, Taliokata.","steam_appid":4109390,"support_info":{"email":"akashatt.contact@gmail.com","url":""},"supported_languages":"English, Japanese","type":"game","website":null}