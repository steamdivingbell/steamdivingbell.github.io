ndless modes</p><p class=\"bb_paragraph\" >(The art resources of the game will be replaced in the official version)</p>","developers":["Xuan Kuiyuan"],"fullgame":{"appid":"3501560","name":"Sweep The Underworld"},"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3501590/75d937950b0d2e877fb72b507be95cc37ed84298/header.jpg?t=1763224943","is_free":true,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Big sur or newer<br></li><li><strong>Processor:</strong> Intel Core i5<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 470<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Big sur or newer<br></li><li><strong>Processor:</strong> Intel Core i5<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3501590/1526283596/9bb6b6ff97d0a7c053eded99c820b1fddabb3f33/1763223681/dash_av1.mpd?t=1763224942","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3501590/1526283596/9bb6b6ff97d0a7c053eded99c820b1fddabb3f33/1763223681/dash_h264.mpd?t=1763224942","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3501590/1526283596/9bb6b6ff97d0a7c053eded99c820b1fddabb3f33/1763223681/hls_264_master.m3u8?t=1763224942","id":257232340,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257232340/movie480.mp4?t=1763224942","max":"https://video.akamai.steamstatic.com/store_trailers/257232340/movie_max.mp4?t=1763224942"},"name":"sweep the underworld2","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/