.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/3433a588476cfb60c38b1f5d6a90b03495a62ab2/ss_3433a588476cfb60c38b1f5d6a90b03495a62ab2.600x338.jpg?t=1770321710"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/2c89b5674653cbcb8e60486b0aa8d6e6868ab19c/ss_2c89b5674653cbcb8e60486b0aa8d6e6868ab19c.1920x1080.jpg?t=1770321710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/2c89b5674653cbcb8e60486b0aa8d6e6868ab19c/ss_2c89b5674653cbcb8e60486b0aa8d6e6868ab19c.600x338.jpg?t=1770321710"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/ec7c35dae4f400ba80eeaa7f3034c9b82e5dc525/ss_ec7c35dae4f400ba80eeaa7f3034c9b82e5dc525.1920x1080.jpg?t=1770321710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/ec7c35dae4f400ba80eeaa7f3034c9b82e5dc525/ss_ec7c35dae4f400ba80eeaa7f3034c9b82e5dc525.600x338.jpg?t=1770321710"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/6558a70039e111f7b8b312abbb6165df9f23bdc9/ss_6558a70039e111f7b8b312abbb6165df9f23bdc9.1920x1080.jpg?t=1770321710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/6558a70039e111f7b8b312abbb6165df9f23bdc9/ss_6558a70039e111f7b8b312abbb6165df9f23bdc9.600x338.jpg?t=1770321710"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/2fe18713dec8d2bc55bfaf633b95d9f5b76d3e64/ss_2fe18713dec8d2bc55bfaf633b95d9f5b76d3e64.1920x1080.jpg?t=1770321710","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/2fe18713dec8d2bc55bfaf633b95d9f5b76d3e64/ss_2fe18713dec8d2bc55bfaf633b95d9f5b76d3e64.600x338.jpg?t=1770321710"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3538250/a7fc308469afba28eb326366ab55ebb2978bc542/ss_a7fc308469afba28eb326366ab55ebb