5c41970a71d1ac/ss_f230fdaf8133da5825d3fec61a5c41970a71d1ac.1920x1080.jpg?t=1744383636","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2679660/f230fdaf8133da5825d3fec61a5c41970a71d1ac/ss_f230fdaf8133da5825d3fec61a5c41970a71d1ac.600x338.jpg?t=1744383636"}],"short_description":"Wield your magical instrument and defy the mecha-goddesses of fate in this Song-Casting Story Driven Action-RPG. Explore a forbidden forest as Traveler. Help him reunite with his long lost love as you fight through abominations and solve mysterious puzzles, all while an ancient conflict unfolds.","steam_appid":2679660,"support_info":{"email":"support@indie.io","url":"https://www.redessencegames.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.redessencegames.com/"}