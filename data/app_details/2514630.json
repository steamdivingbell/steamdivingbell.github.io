i.steamstatic.com/store_item_assets/steam/apps/2514630/1ad7d77b1094943a3a1cb3fe43a8663cbc6eb399/ss_1ad7d77b1094943a3a1cb3fe43a8663cbc6eb399.600x338.jpg?t=1758254115"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2514630/7ee6e87e22abda80a242555c6777991ca83e6e3e/ss_7ee6e87e22abda80a242555c6777991ca83e6e3e.1920x1080.jpg?t=1758254115","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2514630/7ee6e87e22abda80a242555c6777991ca83e6e3e/ss_7ee6e87e22abda80a242555c6777991ca83e6e3e.600x338.jpg?t=1758254115"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2514630/d06066c25a0b74f6b1ccabd64254323201b3106d/ss_d06066c25a0b74f6b1ccabd64254323201b3106d.1920x1080.jpg?t=1758254115","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2514630/d06066c25a0b74f6b1ccabd64254323201b3106d/ss_d06066c25a0b74f6b1ccabd64254323201b3106d.600x338.jpg?t=1758254115"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2514630/2efec80f4c01b3aff842913c27345afe9bf04f79/ss_2efec80f4c01b3aff842913c27345afe9bf04f79.1920x1080.jpg?t=1758254115","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2514630/2efec80f4c01b3aff842913c27345afe9bf04f79/ss_2efec80f4c01b3aff842913c27345afe9bf04f79.600x338.jpg?t=1758254115"}],"short_description":"Marisa of Liartop Mountain is an adventure RPG where the player's choice and the dice will determine the path. Reimu ventures through a mysterious book, to find Marisa who disappeared... but Reimu is not alone. 4 girls will guide, help, and support Reimu on her journey... While having a blast!","steam_appid":2514630,"support_info":{"email":"support@alliance-arts.co.jp","url":""},"supported_languages":"English, Japanese<strong>*</strong>, Simplified Chinese, Traditional Chinese, Korean<br><strong>*</strong>languages with full audio support","type":"game","website":null}