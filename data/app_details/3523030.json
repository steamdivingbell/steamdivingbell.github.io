tic.com/store_item_assets/steam/apps/3523030/0a34d29f47b1c181e59d21b4446b6957e361a83f/ss_0a34d29f47b1c181e59d21b4446b6957e361a83f.1920x1080.jpg?t=1756255894","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3523030/0a34d29f47b1c181e59d21b4446b6957e361a83f/ss_0a34d29f47b1c181e59d21b4446b6957e361a83f.600x338.jpg?t=1756255894"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3523030/909ee7441aba2a59a9408ce6543175b41e2a4d7c/ss_909ee7441aba2a59a9408ce6543175b41e2a4d7c.1920x1080.jpg?t=1756255894","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3523030/909ee7441aba2a59a9408ce6543175b41e2a4d7c/ss_909ee7441aba2a59a9408ce6543175b41e2a4d7c.600x338.jpg?t=1756255894"}],"short_description":"Widlands Dominion is a turn-based tactical RPG where every choice shapes your survival. Build a team of warriors, each with unique classes and skills, and venture into treacherous dungeons. Adapt your strategy, overcome deadly foes, and put an end to the dark force threatening Widlands.","steam_appid":3523030,"support_info":{"email":"ludustacticsgames@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}