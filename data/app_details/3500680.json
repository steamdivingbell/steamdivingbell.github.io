57d70c602cf/ss_e6b8f5dd8d10a38fd9c389a8c9b9457d70c602cf.1920x1080.jpg?t=1771602216","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3500680/e6b8f5dd8d10a38fd9c389a8c9b9457d70c602cf/ss_e6b8f5dd8d10a38fd9c389a8c9b9457d70c602cf.600x338.jpg?t=1771602216"}],"short_description":"Plant, grow, and harvest in this farming roguelite deckbuilder. Craft a powerful deck of plants and combine quirky scarecrows with passive effects for wild synergies. Pay taxes. Strategic, satisfying, and delightfully wholesome.","steam_appid":3500680,"support_info":{"email":"madheadbump@gmail.com","url":""},"supported_languages":"English, Polish, Simplified Chinese","type":"game","website":"https://madheadbump.com/"}