ass=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1782590/extras/4e3e966d489e8fd84670e7136789b533.poster.avif?t=1770824449\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1782590/extras/4e3e966d489e8fd84670e7136789b533.webm?t=1770824449\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1782590/extras/4e3e966d489e8fd84670e7136789b533.mp4?t=1770824449\" type=\"video/mp4\"></video></span></p>","developers":["DEM Games"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1782590/42ba1ec3e5b090ac1c2065287962738f92e71c31/header.jpg?t=1770824449","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1782590/1777891617/515f144903f06f46e1d0e72e86a5a192a77b6838/1762059052/dash_av1.mpd?t=1762580238","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1782590/1777891617/515f144903f06f46e1d0e72e86a5a192a77b6838/1762059052/dash_h264.mpd?t=1762580238","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1782590/1777891617/515f144903f06f46e1d0e72e86a5a192a77b6838/1762059052/hls_264_master.m3u8?t=1762580238","id":257223942,"name":"gameplay_eng","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257223942/af6625acc7317566c5c31d1c0c4460c5930d1f2e/movie_600x337.jpg?t=1762580238"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1782590/466873/8e820f06fed414095cbfae698bc2a7d429ee88c2/1751030392/dash_av1.mpd?t=1762580240","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1782590/466873/8e