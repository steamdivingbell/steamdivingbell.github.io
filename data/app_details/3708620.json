re_item_assets/steam/apps/3708620/33c30bd9c61373ca39993e11d4549b49d94e2cae/ss_33c30bd9c61373ca39993e11d4549b49d94e2cae.1920x1080.jpg?t=1774131670","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3708620/33c30bd9c61373ca39993e11d4549b49d94e2cae/ss_33c30bd9c61373ca39993e11d4549b49d94e2cae.600x338.jpg?t=1774131670"}],"short_description":"A turn-based roguelite where battles take place on a field of numbers. Find pairs \u2014 either matching numbers or those that add up to 10 \u2014 to attack, defend, and overcome enemies in a world of magical medieval fantasy!","steam_appid":3708620,"support_info":{"email":"ostsergeyost@gmail.com","url":""},"supported_languages":"English, Russian, Italian, German, Simplified Chinese, Japanese","type":"game","website":null}