_assets/steam/apps/2256240/ss_f8f9a70990ecfbdd766c2e272f886efe3542311a.1920x1080.jpg?t=1771405603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2256240/ss_f8f9a70990ecfbdd766c2e272f886efe3542311a.600x338.jpg?t=1771405603"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2256240/ss_50cfb284c9bdca0459830f0a7f140957d11cd48a.1920x1080.jpg?t=1771405603","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2256240/ss_50cfb284c9bdca0459830f0a7f140957d11cd48a.600x338.jpg?t=1771405603"}],"short_description":"Dive into a cozy RPG with classic turn-based combat! Hear the Vivid Tale and let the cards guide you to Sklavinia, a land ruled by the chosen of the gods. Battle monsters, explore mysterious lands, and shape the fate of the continent!","steam_appid":2256240,"support_info":{"email":"lockonloc@gmail.com","url":""},"supported_languages":"English, Russian<strong>*</strong>, French, Polish, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":"https://vk.com/lockongames"}