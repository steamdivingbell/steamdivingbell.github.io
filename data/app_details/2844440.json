shared.akamai.steamstatic.com/store_item_assets/steam/apps/2844440/0bc990543df45413933a1d9d0d99a46b9d04ce5d/ss_0bc990543df45413933a1d9d0d99a46b9d04ce5d.1920x1080.jpg?t=1773113899","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2844440/0bc990543df45413933a1d9d0d99a46b9d04ce5d/ss_0bc990543df45413933a1d9d0d99a46b9d04ce5d.600x338.jpg?t=1773113899"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2844440/374f9c09d4b633638cc0ba4b60aad7290bfc69f2/ss_374f9c09d4b633638cc0ba4b60aad7290bfc69f2.1920x1080.jpg?t=1773113899","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2844440/374f9c09d4b633638cc0ba4b60aad7290bfc69f2/ss_374f9c09d4b633638cc0ba4b60aad7290bfc69f2.600x338.jpg?t=1773113899"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2844440/ss_b0fcdf2e1009edcde494b2b0afb9af1e3fd8061c.1920x1080.jpg?t=1773113899","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2844440/ss_b0fcdf2e1009edcde494b2b0afb9af1e3fd8061c.600x338.jpg?t=1773113899"}],"short_description":"Roguelite Turn Based Auto-Battler about little goblins rescuing their kidnapped tribe members. \ud83d\udc38 Smash. Evolve. Survive.","steam_appid":2844440,"support_info":{"email":"bunbun@bunkovsky.com","url":"https://bunkovsky.com"},"supported_languages":"English","type":"game","website":null}