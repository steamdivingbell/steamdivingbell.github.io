om/store_item_assets/steam/apps/3834060/34b3e8bd2fb4cb7e96eec6c787a941caaadd2d24/ss_34b3e8bd2fb4cb7e96eec6c787a941caaadd2d24.1920x1080.jpg?t=1766415597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3834060/34b3e8bd2fb4cb7e96eec6c787a941caaadd2d24/ss_34b3e8bd2fb4cb7e96eec6c787a941caaadd2d24.600x338.jpg?t=1766415597"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3834060/a5672feec5dad9b24495099fca11e49228c504ce/ss_a5672feec5dad9b24495099fca11e49228c504ce.1920x1080.jpg?t=1766415597","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3834060/a5672feec5dad9b24495099fca11e49228c504ce/ss_a5672feec5dad9b24495099fca11e49228c504ce.600x338.jpg?t=1766415597"}],"short_description":"Play a video game while it is being created and follow the adventures of its developer throughout the game's development process. The developer narrates. The world evolves. It's not a bug, it's a feature.","steam_appid":3834060,"support_info":{"email":"media@littlebigmonkey.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}