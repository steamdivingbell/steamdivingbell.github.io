if?t=1766415597\" width=616 height=100 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3834060/extras/14d6e6f56d5da7ae994c3abe821594f7.webm?t=1766415597\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3834060/extras/14d6e6f56d5da7ae994c3abe821594f7.mp4?t=1766415597\" type=\"video/mp4\"></video></span></p>","developers":["Little Big Monkey Studio"],"genres":[{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3834060/9e9c3b1fb671f86e6ac7b5b4d4739493df4ac8dd/header.jpg?t=1766415597","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3834060/140626703/48c3766286f0eeb39eee4a97064058bdec24bb3b/1752152247/dash_av1.mpd?t=1752260062","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3834060/140626703/48c3766286f0eeb39eee4a97064058bdec24bb3b/1752152247/dash_h264.mpd?t=1752260062","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3834060/140626703/48c3766286f0eeb39eee4a97064058bdec24bb3b/1752152247/hls_264_master.m3u8?t=1752260062","id":257167302,"name":"Beta Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257167302/234839f91a2dc3f0b6a506db7cb74015d822c005/movie_600x337.jpg?t=1752260062"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3834060/310615534/50387f96b5decc101e22e45c244433890b0b5221/1752153534/dash_av1.mpd?t=1752260066","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3834060/310615534/50387f96b5decc101e22e45c244433890b0b5221/1752153534/dash_h264.mpd?t=1752260066","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3834060/310615534/50387f96b5decc101e22e45c244433890b0b5221/1752153534/hls_264_master.m