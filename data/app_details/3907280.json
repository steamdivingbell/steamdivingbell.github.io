ai.steamstatic.com/store_item_assets/steam/apps/3907280/extras/c2e0501ad7063be5bc4896da4da9ba75.mp4?t=1769120015\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Every step counts.</strong> Explore carefully, move with <strong>stealth</strong>, <strong>distract</strong> them with objects, or make <strong>noise</strong> to draw their attention. And if all else fails, <strong>outsmart them</strong> by using your own strategy against their behavior.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907280/extras/c9a6a907e24046ab468d5c60a4e1117f.avif?t=1769120015\" width=616 height=35 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907280/extras/ba993696adbb63c65bb1d2e96b5ceb3c.poster.avif?t=1769120015\" width=620 height=166 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907280/extras/ba993696adbb63c65bb1d2e96b5ceb3c.webm?t=1769120015\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907280/extras/ba993696adbb63c65bb1d2e96b5ceb3c.mp4?t=1769120015\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Open doors</strong>, search for <strong>access cards</strong>, and activate <strong>generators</strong> to uncover new areas like <strong>warehouses</strong>, <strong>closed stores</strong>, or <strong>administrative zones</strong>. A massive place awaits your visit.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3907280/extras/a758c269092484c75f78b43d12267526.avif?t=1769120015\" width=616 height=35 /></span></p><p