x1080.jpg?t=1756383715","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370980/3bc04b79b8cd40f2544e4f5dc68b64301339605d/ss_3bc04b79b8cd40f2544e4f5dc68b64301339605d.600x338.jpg?t=1756383715"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370980/56a3eee8c9e0dd919c63fd098caab349b8858d87/ss_56a3eee8c9e0dd919c63fd098caab349b8858d87.1920x1080.jpg?t=1756383715","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370980/56a3eee8c9e0dd919c63fd098caab349b8858d87/ss_56a3eee8c9e0dd919c63fd098caab349b8858d87.600x338.jpg?t=1756383715"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370980/adb4191af169e3897e112e071410b8fb76e8d37b/ss_adb4191af169e3897e112e071410b8fb76e8d37b.1920x1080.jpg?t=1756383715","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370980/adb4191af169e3897e112e071410b8fb76e8d37b/ss_adb4191af169e3897e112e071410b8fb76e8d37b.600x338.jpg?t=1756383715"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370980/8902bc473d4550b5c09299b93e02bd59c9afff9a/ss_8902bc473d4550b5c09299b93e02bd59c9afff9a.1920x1080.jpg?t=1756383715","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3370980/8902bc473d4550b5c09299b93e02bd59c9afff9a/ss_8902bc473d4550b5c09299b93e02bd59c9afff9a.600x338.jpg?t=1756383715"}],"short_description":"Blast off as a rocket-powered bear in this hand-drawn 2D arcade shooter! Ram enemy planes, roast villains with jet flames, and roar them out of the sky. Unlock flair-packed hats, snack on atomic power-ups, and team up with Rifle Rat for couch co-op chaos!","steam_appid":3370980,"support_info":{"email":"atomicmills@aol.com","url":"https://atomicmills.com/bearplane"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://a