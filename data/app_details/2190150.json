ared.akamai.steamstatic.com/store_item_assets/steam/apps/2190150/ss_87fae84498d5f5f2e1737800250da34a33124992.600x338.jpg?t=1754978183"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2190150/ss_270eb466be52ca343796c82ea4a409f02c9797ef.1920x1080.jpg?t=1754978183","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2190150/ss_270eb466be52ca343796c82ea4a409f02c9797ef.600x338.jpg?t=1754978183"}],"short_description":"The Last Humble Bee is a cartoony survivors-like with a lot of heart. Explore a pixelated open world, cast bumble bee magic, and slash through demonic bugs to uncover what happened to all the bumble bees.","steam_appid":2190150,"support_info":{"email":"jacob@bassmonkeygame.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.yakobsoup.com/the-last-humble-bee"}