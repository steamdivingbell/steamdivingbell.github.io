uttony.teamfg@gmail.com","url":"https://discord.gg/HyFXY2f4a5"},"supported_languages":"English, Korean, French, German, Spanish - Spain, Russian, Japanese, Simplified Chinese, Portuguese - Brazil","type":"game","website":null}