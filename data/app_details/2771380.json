1380/7e99e1517b8637802c23ef9cf7a8e74e7a38b1d2/ss_7e99e1517b8637802c23ef9cf7a8e74e7a38b1d2.1920x1080.jpg?t=1750612282","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2771380/7e99e1517b8637802c23ef9cf7a8e74e7a38b1d2/ss_7e99e1517b8637802c23ef9cf7a8e74e7a38b1d2.600x338.jpg?t=1750612282"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2771380/d903f60f1614ef3b2c6795cf0178ae922e531a3c/ss_d903f60f1614ef3b2c6795cf0178ae922e531a3c.1920x1080.jpg?t=1750612282","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2771380/d903f60f1614ef3b2c6795cf0178ae922e531a3c/ss_d903f60f1614ef3b2c6795cf0178ae922e531a3c.600x338.jpg?t=1750612282"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2771380/7347a5f04ad1f96fbf6c2eeca25f11562852db36/ss_7347a5f04ad1f96fbf6c2eeca25f11562852db36.1920x1080.jpg?t=1750612282","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2771380/7347a5f04ad1f96fbf6c2eeca25f11562852db36/ss_7347a5f04ad1f96fbf6c2eeca25f11562852db36.600x338.jpg?t=1750612282"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2771380/83b26354ddf2a03b5539e0e3954fcf1aead50c48/ss_83b26354ddf2a03b5539e0e3954fcf1aead50c48.1920x1080.jpg?t=1750612282","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2771380/83b26354ddf2a03b5539e0e3954fcf1aead50c48/ss_83b26354ddf2a03b5539e0e3954fcf1aead50c48.600x338.jpg?t=1750612282"}],"short_description":"&quot;Wonderful Richman&quot; is a casual board game inspired by Monopoly, featuring a unique Paco Card Deck System, supporting eight-player co-op, introducing brand-new Building Layer Gameplay, offering 50+ randomized buildings, and including 30 distinct animals. Roll the fate dice and rule the field!","steam_appid":2771380,"support_info":{"email":"1597322925@qq.com","url":""},"supported_languages":"Simplified Chinese, English, Traditional Chinese","type":"game","website":null}