extras/a3d32d923a4cbf29912e85437585c821.poster.avif?t=1760871104\" width=608 height=174 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371180/extras/a3d32d923a4cbf29912e85437585c821.webm?t=1760871104\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371180/extras/a3d32d923a4cbf29912e85437585c821.mp4?t=1760871104\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Survive and train in Zombie mode</h2><p class=\"bb_paragraph\" >Train solo or co-op against waves of zombies.</p><p class=\"bb_paragraph\" >Face new types of zombies, such as robots, ghosts, or giants, to intensify and perfect your training.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371180/extras/e06feb5e88a66193f6e2965ec0f17b66.poster.avif?t=1760871104\" width=608 height=174 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371180/extras/e06feb5e88a66193f6e2965ec0f17b66.webm?t=1760871104\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371180/extras/e06feb5e88a66193f6e2965ec0f17b66.mp4?t=1760871104\" type=\"video/mp4\"></video></span></p>","developers":["Danisma"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Sports","id":"18"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3371180/e2d629757982211299cc9d1b18af14b528a7604e/header.jpg?t=1760871104","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"