static.com/store_item_assets/steam/apps/3735030/91bb27ae648dd77098fa6d5559e08063f128d066/ss_91bb27ae648dd77098fa6d5559e08063f128d066.1920x1080.jpg?t=1768872369","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735030/91bb27ae648dd77098fa6d5559e08063f128d066/ss_91bb27ae648dd77098fa6d5559e08063f128d066.600x338.jpg?t=1768872369"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735030/346a5af2955e800c4e18b1c37a84cf2ff1f101ac/ss_346a5af2955e800c4e18b1c37a84cf2ff1f101ac.1920x1080.jpg?t=1768872369","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3735030/346a5af2955e800c4e18b1c37a84cf2ff1f101ac/ss_346a5af2955e800c4e18b1c37a84cf2ff1f101ac.600x338.jpg?t=1768872369"}],"short_description":"Run a cozy medieval tavern... staffed by monsters from your basement! Grow and cook delicious things and serve them to your customers. Decorate and customize your place. Explore dark places, befriend and hire monsters, and sell your loot for a good price!","steam_appid":3735030,"support_info":{"email":"","url":"http://discord.nullmoongames.com"},"supported_languages":"English, French, German, Spanish - Spain, Japanese, Russian, Simplified Chinese","type":"game","website":null}