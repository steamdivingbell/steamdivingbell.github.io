98860/3145099d9523986ea699edd5d990240feece5812/ss_3145099d9523986ea699edd5d990240feece5812.1920x1080.jpg?t=1759907745","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/3145099d9523986ea699edd5d990240feece5812/ss_3145099d9523986ea699edd5d990240feece5812.600x338.jpg?t=1759907745"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/e462ad4a5240069279c0f1219a8f4ed9c7806b0a/ss_e462ad4a5240069279c0f1219a8f4ed9c7806b0a.1920x1080.jpg?t=1759907745","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/e462ad4a5240069279c0f1219a8f4ed9c7806b0a/ss_e462ad4a5240069279c0f1219a8f4ed9c7806b0a.600x338.jpg?t=1759907745"}],"short_description":"Examine a family's photo album to reveal signs of the paranormal, as the horror unfolds in the house around you. Their fate is in your hands.","steam_appid":3798860,"support_info":{"email":"armaan@frostwoodinteractive.com","url":"http://www.frostwoodinteractive.com/"},"supported_languages":"English","type":"game","website":"http://www.frostwoodinteractive.com/"}