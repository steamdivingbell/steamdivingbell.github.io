mai.steamstatic.com/store_item_assets/steam/apps/3798860/f40de429b5cba4e13855a0dc5f3446d6b90f3f8e/ss_f40de429b5cba4e13855a0dc5f3446d6b90f3f8e.600x338.jpg?t=1757323322"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/0fcda8c538b9b4ba2f734b836240d845cd375f41/ss_0fcda8c538b9b4ba2f734b836240d845cd375f41.1920x1080.jpg?t=1757323322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/0fcda8c538b9b4ba2f734b836240d845cd375f41/ss_0fcda8c538b9b4ba2f734b836240d845cd375f41.600x338.jpg?t=1757323322"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/d90a70e7a576542f9b9a136be13bb41dc3d467d5/ss_d90a70e7a576542f9b9a136be13bb41dc3d467d5.1920x1080.jpg?t=1757323322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/d90a70e7a576542f9b9a136be13bb41dc3d467d5/ss_d90a70e7a576542f9b9a136be13bb41dc3d467d5.600x338.jpg?t=1757323322"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/60d0cbedbe2cd9ebe05a4f584d6c5348dc8fccda/ss_60d0cbedbe2cd9ebe05a4f584d6c5348dc8fccda.1920x1080.jpg?t=1757323322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/60d0cbedbe2cd9ebe05a4f584d6c5348dc8fccda/ss_60d0cbedbe2cd9ebe05a4f584d6c5348dc8fccda.600x338.jpg?t=1757323322"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/a6f962529f6fd332b796afa3ee55a620a6b9d570/ss_a6f962529f6fd332b796afa3ee55a620a6b9d570.1920x1080.jpg?t=1757323322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/a6f962529f6fd332b796afa3ee55a620a6b9d570/ss_a6f962529f6fd332b796afa3ee55a620a6b9d570.600x338.jpg?t=1757323322"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/e462ad4a5240069279c0f1219a8f4ed9c7806b0a/ss_e462ad4a5240069279c0f1219a8f4ed9c7806b0a.1920x1080.jpg?t=1757323322","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3798860/e462ad4a5240069279c0f1219a8f4ed9c7806b0a/ss_e462ad4a5240069279c0f1219a8f4ed9c7806b0a.600x338.jpg?t=1757323322"}],"short_description":"Your friend is convinced his house is haunted. Examine his family's photo album to reveal signs of the paranormal, as the horror unfolds in the house around you. Their fate is in your hands.","steam_appid":3798860,"support_info":{"email":"armaan@frostwoodinteractive.com","url":"http://www.frostwoodinteractive.com/"},"supported_languages":"English","type":"game","website":"http://www.frostwoodinteractive.com/"}