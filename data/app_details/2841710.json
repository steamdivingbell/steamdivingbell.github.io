ideo></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >FEATURES:</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Scavenge for items</p></li><li><p class=\"bb_paragraph\" >Set traps and hunt creatures</p></li><li><p class=\"bb_paragraph\" >Your time is your most valuable resource</p></li><li><p class=\"bb_paragraph\" >Self defence is a last resort</p></li><li><p class=\"bb_paragraph\" >Mutations help you explore new areas</p></li><li><p class=\"bb_paragraph\" >The horrors of the night will find you</p></li><li><p class=\"bb_paragraph\" >Craft upgrades</p></li><li><p class=\"bb_paragraph\" >Trade creatures for items</p></li><li><p class=\"bb_paragraph\" >Explore 4 unique areas in this small open world</p></li><li><p class=\"bb_paragraph\" >Hope for death</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ></h2>","developers":["Wishbone Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2841710/fd3cc5a1eb7792a4fb6d6071cb9c1154fee797fe/header.jpg?t=1764869194","is_free":false,"linux_requirements":[],"mac_requirements":[],"name":"Vermin","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Storage:</strong> 400 MB available space</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Wishbone Games"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia\nMedo","rating":"14","rating_generated":"1","required_age":"14","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"Horror","rating":"16","rating_generated":"1","required_age":"16","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"To be announced"},"required_age":0,"screenshots":[{"id":0,"path_fu