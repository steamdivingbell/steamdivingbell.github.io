r recommended).</p><p class=\"bb_paragraph\" >Online: You can invite your friends via Steam Remote-Play-Together. There is no Quick-Play or Matchmaking-System.</p>","developers":["Andreas Metz"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2265950/header.jpg?t=1727201661","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2265950/759217/1fafd0afde6da730cdf4d7810b54753490a9f225/1751096557/dash_av1.mpd?t=1726933732","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2265950/759217/1fafd0afde6da730cdf4d7810b54753490a9f225/1751096557/dash_h264.mpd?t=1726933732","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2265950/759217/1fafd0afde6da730cdf4d7810b54753490a9f225/1751096557/hls_264_master.m3u8?t=1726933732","id":257057164,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257057164/movie.293x165.jpg?t=1726933732"}],"name":"Doggo Ninjas","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Doggo Ninjas - $3.99 USD","packageid":812916,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":399}],"title":"Buy Doggo Ninjas"}],"packages":[812916],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7<br></li><li><strong>Processor:</strong> i3 or equivalent<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GeForce 8800 GT / AMD HD 6850 / Intel HD Graphics 4400 or above<br></li><li><strong>DirectX:</strong> Version 10<br></li><li><strong>Storage:</strong>