":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757530/6fd5f39be58d51181662eee005707fdec41bacfd/ss_6fd5f39be58d51181662eee005707fdec41bacfd.600x338.jpg?t=1758365681"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757530/575e505fcc47350da3d24d4d71f8426cb7cdd696/ss_575e505fcc47350da3d24d4d71f8426cb7cdd696.1920x1080.jpg?t=1758365681","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757530/575e505fcc47350da3d24d4d71f8426cb7cdd696/ss_575e505fcc47350da3d24d4d71f8426cb7cdd696.600x338.jpg?t=1758365681"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757530/88c4a9db47594792e51fc8e75dd16e56d2b44921/ss_88c4a9db47594792e51fc8e75dd16e56d2b44921.1920x1080.jpg?t=1758365681","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3757530/88c4a9db47594792e51fc8e75dd16e56d2b44921/ss_88c4a9db47594792e51fc8e75dd16e56d2b44921.600x338.jpg?t=1758365681"}],"short_description":"Trapped in a shifting house lit only by candlelight, you must follow whispers, face your mind\u2019s decay, and survive the presence watching you. ANARIA is a solo-developed psychological horror built to haunt long after it ends.","steam_appid":3757530,"support_info":{"email":"catalintabica@gmail.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}