.com/store_item_assets/steam/apps/3512480/10fee5b1e5144715bcd14a889349040a46adcb1c/ss_10fee5b1e5144715bcd14a889349040a46adcb1c.600x338.jpg?t=1761936439"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/811918838236d800841b4945200e0ed2cef60c6f/ss_811918838236d800841b4945200e0ed2cef60c6f.1920x1080.jpg?t=1761936439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/811918838236d800841b4945200e0ed2cef60c6f/ss_811918838236d800841b4945200e0ed2cef60c6f.600x338.jpg?t=1761936439"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/8bcd9e65ab02f504e06107223e32f5986a29bf0f/ss_8bcd9e65ab02f504e06107223e32f5986a29bf0f.1920x1080.jpg?t=1761936439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/8bcd9e65ab02f504e06107223e32f5986a29bf0f/ss_8bcd9e65ab02f504e06107223e32f5986a29bf0f.600x338.jpg?t=1761936439"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/630529953c5461a8280ec8c0d1d89f2a5f691546/ss_630529953c5461a8280ec8c0d1d89f2a5f691546.1920x1080.jpg?t=1761936439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/630529953c5461a8280ec8c0d1d89f2a5f691546/ss_630529953c5461a8280ec8c0d1d89f2a5f691546.600x338.jpg?t=1761936439"},{"id":14,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/ba14a774aa40a2466622e92bcb1793d63095b8fe/ss_ba14a774aa40a2466622e92bcb1793d63095b8fe.1920x1080.jpg?t=1761936439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/ba14a774aa40a2466622e92bcb1793d63095b8fe/ss_ba14a774aa40a2466622e92bcb1793d63095b8fe.600x338.jpg?t=1761936439"},{"id":15,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/60f69e78b2b7692469bffbdf774f4ffcd2d56c22/ss_60f69e78b2b7692469bffbdf774f4ffcd2d56c22.1920x1080.jpg?t=1761936439","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3512480/60f69e78b2b7692469bffbdf774f4ffcd2d56c22/ss_60f69e78b2b7692469bffbdf774f4ffcd2d56c22.600x338.jpg?t=1761936439"}],"short_description":"Drownlight is a city-building survival simulator set in a flooded world. Build and expand your city around a lighthouse, manage resources, and make moral decisions that shape the fate of the survivors. Secrets lurk in the raging waters, and if the lighthouse goes out, the city may be lost forever.","steam_appid":3512480,"support_info":{"email":"wadessetx@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Simplified Chinese, Korean, Norwegian, Polish, Russian, Turkish, Swedish, Japanese","type":"game","website":null}