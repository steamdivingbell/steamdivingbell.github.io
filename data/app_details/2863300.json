952528ebac7929c26dd6dc1/ss_0fb2033e90f30fc62952528ebac7929c26dd6dc1.600x338.jpg?t=1757082144"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2863300/416065a2daa499ee200ee7ef99c39dc17da907f5/ss_416065a2daa499ee200ee7ef99c39dc17da907f5.1920x1080.jpg?t=1757082144","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2863300/416065a2daa499ee200ee7ef99c39dc17da907f5/ss_416065a2daa499ee200ee7ef99c39dc17da907f5.600x338.jpg?t=1757082144"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2863300/7016de6728df570ebd3f325a188c52200aab6f5b/ss_7016de6728df570ebd3f325a188c52200aab6f5b.1920x1080.jpg?t=1757082144","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2863300/7016de6728df570ebd3f325a188c52200aab6f5b/ss_7016de6728df570ebd3f325a188c52200aab6f5b.600x338.jpg?t=1757082144"}],"short_description":"Absym is a unique rogue-souls-like that challenges you to survive between two dimensions: the decaying Nihilor and the corrupted Absymalith. Fight, explore, and use Rift Dancing to shift between worlds in real time. Every choice draws you closer to redemption... or corruption.","steam_appid":2863300,"support_info":{"email":"experienceinfinity8@gmail.com","url":""},"supported_languages":"English, Italian","type":"game","website":"https://twitter.com/Absym_game"}