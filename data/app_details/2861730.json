/82e0b0a00d78079c06302002b9a2f04a704d9262/ss_82e0b0a00d78079c06302002b9a2f04a704d9262.600x338.jpg?t=1771330493"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/84c01a515192f331bdc9f709b36383b95d113828/ss_84c01a515192f331bdc9f709b36383b95d113828.1920x1080.jpg?t=1771330493","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/84c01a515192f331bdc9f709b36383b95d113828/ss_84c01a515192f331bdc9f709b36383b95d113828.600x338.jpg?t=1771330493"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/5ba683c37f092e3c1e8f3f83a8a9ca0aa287ecef/ss_5ba683c37f092e3c1e8f3f83a8a9ca0aa287ecef.1920x1080.jpg?t=1771330493","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/5ba683c37f092e3c1e8f3f83a8a9ca0aa287ecef/ss_5ba683c37f092e3c1e8f3f83a8a9ca0aa287ecef.600x338.jpg?t=1771330493"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/cd95c6e16a44a2d086320ecfb6a5a2a1a4df58af/ss_cd95c6e16a44a2d086320ecfb6a5a2a1a4df58af.1920x1080.jpg?t=1771330493","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/cd95c6e16a44a2d086320ecfb6a5a2a1a4df58af/ss_cd95c6e16a44a2d086320ecfb6a5a2a1a4df58af.600x338.jpg?t=1771330493"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/f306e8e8c81b82d877a077285d2959053cc10f5e/ss_f306e8e8c81b82d877a077285d2959053cc10f5e.1920x1080.jpg?t=1771330493","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/f306e8e8c81b82d877a077285d2959053cc10f5e/ss_f306e8e8c81b82d877a077285d2959053cc10f5e.600x338.jpg?t=1771330493"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/229bf835cd0b035767462e558560a86d9a81dfd4/ss_229bf835cd0b035767462e558560a86d9a81dfd4.1920x1080.jpg?t=1771330493","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/229bf835cd0b035767462e558560a86d9a81dfd4/ss_229bf835cd0b035767462e558560a86d9a81dfd4.600x338.jpg?t=1771330493"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/c29d98ebb8291fb6d30d080889c9f148e0164c8c/ss_c29d98ebb8291fb6d30d080889c9f148e0164c8c.1920x1080.jpg?t=1771330493","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/c29d98ebb8291fb6d30d080889c9f148e0164c8c/ss_c29d98ebb8291fb6d30d080889c9f148e0164c8c.600x338.jpg?t=1771330493"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/ae53d740d0b76112cd2ac5fe60ec28ddc90ee458/ss_ae53d740d0b76112cd2ac5fe60ec28ddc90ee458.1920x1080.jpg?t=1771330493","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2861730/ae53d740d0b76112cd2ac5fe60ec28ddc90ee458/ss_ae53d740d0b76112cd2ac5fe60ec28ddc90ee458.600x338.jpg?t=1771330493"}],"short_description":"You're the last chef in a post-apocalyptic world. Attract adventurers with monstrous food, make them sign contracts with the Food Devils and organize expeditions to collect wicked ingredients! Customize your characters, build the perfect restaurant and plan every move in this Tactics-RPG Roguelite.","steam_appid":2861730,"support_info":{"email":"feedback.studiodaimon@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Italian, Japanese, Simplified Chinese, German, Spanish - Spain, Russian, French, Indonesian, Korean, Portuguese - Brazil<br><strong>*</strong>languages with full audio support","type":"game","website":null}