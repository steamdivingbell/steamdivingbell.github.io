1773848024"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3644020/4b6b6579ed97c493948ae64f051083a8c9660639/ss_4b6b6579ed97c493948ae64f051083a8c9660639.1920x1080.jpg?t=1773848024","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3644020/4b6b6579ed97c493948ae64f051083a8c9660639/ss_4b6b6579ed97c493948ae64f051083a8c9660639.600x338.jpg?t=1773848024"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3644020/853dc57a1a0f63a5fda839eb42f02976b847ac5b/ss_853dc57a1a0f63a5fda839eb42f02976b847ac5b.1920x1080.jpg?t=1773848024","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3644020/853dc57a1a0f63a5fda839eb42f02976b847ac5b/ss_853dc57a1a0f63a5fda839eb42f02976b847ac5b.600x338.jpg?t=1773848024"}],"short_description":"Star Wipers, ready your mops! In an online co-op expedition for up to 4 players, use an arsenal of tools to clean up abandoned space stations, unexplored planets, and ruined restaurants across the cosmos. Start by tidying away the corpses of your predecessors.","steam_appid":3644020,"support_info":{"email":"wildflamestudio@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Japanese, Polish, Russian, Korean, Portuguese - Brazil, Simplified Chinese, Turkish<br><strong>*</strong>languages with full audio support","type":"game","website":null}