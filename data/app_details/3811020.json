6582\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3811020/extras/8d7f61252009ac5d796e27c53e79e5f0.mp4?t=1773986582\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >FEATURES:</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >single player retro arcade experience with frantic shoot-em-up gameplay</p></li><li><p class=\"bb_paragraph\" >30 stages of ever-increasing swarms of space monsters</p></li><li><p class=\"bb_paragraph\" >Roguelike style item system makes each play through unique</p></li><li><p class=\"bb_paragraph\" >Progression system makes player more powerful with every attempt</p></li><li><p class=\"bb_paragraph\" >Intense neon graphics (screenshake and other graphical effects are adjustable)</p></li></ul><p class=\"bb_paragraph\" ></p>","developers":["NeoGeeJoe"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3811020/91ea6e8e719c9fb057215d062b8828a51fe8b9c9/header.jpg?t=1773986582","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3811020/59850974/bb643c423df745c959c9601080158e522f4de5b3/1760316264/dash_av1.mpd?t=1760526797","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3811020/59850974/bb643c423df745c959c9601080158e522f4de5b3/1760316264/dash_h264.mpd?t=1760526797","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3811020/59850974/bb643c423df745c959c9601080158e522f4de5b3/1760316264/hls_264_master.m3u8?t=1760526797