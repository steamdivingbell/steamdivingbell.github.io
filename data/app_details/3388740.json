.com/store_item_assets/steam/apps/3388740/22c8200fc1e4045dd4602327b7c3802a385f7bba/ss_22c8200fc1e4045dd4602327b7c3802a385f7bba.1920x1080.jpg?t=1770940243","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/22c8200fc1e4045dd4602327b7c3802a385f7bba/ss_22c8200fc1e4045dd4602327b7c3802a385f7bba.600x338.jpg?t=1770940243"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/f3ac7cf8ef3fda4e1d5e51f3acce7193c08f708e/ss_f3ac7cf8ef3fda4e1d5e51f3acce7193c08f708e.1920x1080.jpg?t=1770940243","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/f3ac7cf8ef3fda4e1d5e51f3acce7193c08f708e/ss_f3ac7cf8ef3fda4e1d5e51f3acce7193c08f708e.600x338.jpg?t=1770940243"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/a95fdc93c7dd6be9d6427b3a2d9db4b1785f4af5/ss_a95fdc93c7dd6be9d6427b3a2d9db4b1785f4af5.1920x1080.jpg?t=1770940243","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/a95fdc93c7dd6be9d6427b3a2d9db4b1785f4af5/ss_a95fdc93c7dd6be9d6427b3a2d9db4b1785f4af5.600x338.jpg?t=1770940243"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/1fe6c665d9ac657c0e1df01c62557b5709adf78b/ss_1fe6c665d9ac657c0e1df01c62557b5709adf78b.1920x1080.jpg?t=1770940243","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/1fe6c665d9ac657c0e1df01c62557b5709adf78b/ss_1fe6c665d9ac657c0e1df01c62557b5709adf78b.600x338.jpg?t=1770940243"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/1910e941b27c533de91d4fc3991eff314f0c75e8/ss_1910e941b27c533de91d4fc3991eff314f0c75e8.1920x1080.jpg?t=1770940243","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3388740/1910e941b27c533de91d4fc3991eff314f0c75e8/ss_1910e941b27c533de91d4fc3991eff314f0c75e8.600x338.jpg?t=1770940243"}],"short_description":"Bedtime Stories is a wholesome 2D platformer with fun, forgiving combat where you play as the imaginary heroes in Cantonese and Indonesian fairytales. Face creatures inspired by Traditional Puppet Theatre, only to realise that the allies you form along the way are much more powerful.","steam_appid":3388740,"support_info":{"email":"social@liquidheart.studio","url":"https://liquidheart.studio/"},"supported_languages":"English, Indonesian, Japanese, Traditional Chinese","type":"game","website":"https://liquidheart.studio/"}