 a Checkpoint to cleanse both them and the corresponding section of The Garden.</p><h2 class=\"bb_tag\"><strong>Demo Features</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">One level to complete</p></li><li><p class=\"bb_paragraph\">3 enemies</p></li><li><p class=\"bb_paragraph\">Breakable objects</p></li><li><p class=\"bb_paragraph\">Corruption to clean</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3642480/extras/mcsticker.png?t=1744052411\" /></p>","developers":["Game One"],"fullgame":{"appid":"3365820","name":"Palette Cleanser"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3642480/1db13076d8f827d7e9a04d5291470849b9b668c6/header.jpg?t=1744052411","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257121847,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257121847/movie480.mp4?t=1744052409","max":"http://video.akamai.steamstatic.com/store_trailers/257121847/movie_max.mp4?t=1744052409"},"name":"Palette Cleanser demo video","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257121847/d7100a2a7d8bd87694508f630113fb7912220358/movie_600x337.jpg?t=1744052409","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257121847/movie480_vp9.webm?t=1744052409","max":"http://video.akamai.steamstatic.com/store_trailers/257121847/movie_max_vp9.webm?t=1744052409"}}],"name":"Palette Cleanse