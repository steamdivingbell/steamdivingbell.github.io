ees, demon-related injuries, psychological trauma, or spontaneous toadification. \ud83d\udc38</strong></i></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><strong><i>By reading this page, you have legally entered into a magical binding contract. Probably.\u00a0</i></strong></p>","developers":[" Bobik Studio"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Massively Multiplayer","id":"29"},{"description":"Simulation","id":"28"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3615800/1e7e88e297e868e5014804b092ba84e0ed96d5af/header.jpg?t=1744708314","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257125238,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257125238/movie480.mp4?t=1744708312","max":"http://video.akamai.steamstatic.com/store_trailers/257125238/movie_max.mp4?t=1744708312"},"name":"GAMEPLAY TEASER","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257125238/0bf23af01922d4f7bd1cfb093d728c054dc0c2df/movie_600x337.jpg?t=1744708312","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257125238/movie480_vp9.webm?t=1744708312","max":"http://video.akamai.steamstatic.com/store_trailers/257125238/movie_max_vp9.webm?t=1744708312"}}],"name":"Wand Mart: A Totally Normal Magical Store\u2122","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3<br></li><li><strong>Memory:</strong> 4  GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 660<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>