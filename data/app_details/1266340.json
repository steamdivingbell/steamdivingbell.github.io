gress even faster.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1266340/extras/fe6e5f913fa408305974bc6fb2f29612.poster.avif?t=1745589063\" width=616 height=266 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1266340/extras/fe6e5f913fa408305974bc6fb2f29612.webm?t=1745589063\" type=\"video/webm; codecs=vp9\"></video></span>","developers":["Black Mammoth Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Massively Multiplayer","id":"29"},{"description":"RPG","id":"3"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1266340/header.jpg?t=1745589063","is_free":false,"legal_notice":"Copyright \u00a92022 Black Mammoth Games, LLC. All rights reserved.","linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 12.04 LTS<br></li><li><strong>Processor:</strong> 2.0 Ghz<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> 128mb Video Memory, capable of OpenGL<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 1.73 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 18.04 LTS<br></li><li><strong>Processor:</strong> 2.0 Ghz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> 128mb Video Memory, capable of OpenGL<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 1.73 GB available space</li></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> OSX 10.11.6+<br></li><li><strong>Processo