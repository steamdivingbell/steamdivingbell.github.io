cbcbcd59bcd7a5377198abfeb8/ss_f40c9b13e2da2ecbcbcd59bcd7a5377198abfeb8.600x338.jpg?t=1767005266"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/663928331efbf0e32c6f2a0afeac84cb541c570b/ss_663928331efbf0e32c6f2a0afeac84cb541c570b.1920x1080.jpg?t=1767005266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/663928331efbf0e32c6f2a0afeac84cb541c570b/ss_663928331efbf0e32c6f2a0afeac84cb541c570b.600x338.jpg?t=1767005266"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/950bbff98f60e97f5527f74ac7713f586dac44fc/ss_950bbff98f60e97f5527f74ac7713f586dac44fc.1920x1080.jpg?t=1767005266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/950bbff98f60e97f5527f74ac7713f586dac44fc/ss_950bbff98f60e97f5527f74ac7713f586dac44fc.600x338.jpg?t=1767005266"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/ee99968038badc618d711bc99635d5f6e15963e8/ss_ee99968038badc618d711bc99635d5f6e15963e8.1920x1080.jpg?t=1767005266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/ee99968038badc618d711bc99635d5f6e15963e8/ss_ee99968038badc618d711bc99635d5f6e15963e8.600x338.jpg?t=1767005266"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/2db8931071a004a014b362250766c4534dd8bfa1/ss_2db8931071a004a014b362250766c4534dd8bfa1.1920x1080.jpg?t=1767005266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/2db8931071a004a014b362250766c4534dd8bfa1/ss_2db8931071a004a014b362250766c4534dd8bfa1.600x338.jpg?t=1767005266"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/32e7f84f113df3189a58157793dbbd61000b0028/ss_32e7f84f113df3189a58157793dbbd61000b0028.1920x1080.jpg?t=1767005266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/32e7f84f113df3189a58157793dbbd61000b0028/ss_32e7f84f113df3189a58157793dbbd61000b0028.600x338.jpg?t=1767005266"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/01399ccf0103a8652fac2c778a0994fd96407b57/ss_01399ccf0103a8652fac2c778a0994fd96407b57.1920x1080.jpg?t=1767005266","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3812620/01399ccf0103a8652fac2c778a0994fd96407b57/ss_01399ccf0103a8652fac2c778a0994fd96407b57.600x338.jpg?t=1767005266"}],"short_description":"Brain School is chill card-based deduction game. A set of playing cards are shown face down: \ud83c\udccf\ud83c\udccf\ud83c\udccf\ud83c\udccf\ud83c\udccf Solve the code by asking questions such as &quot;What is the sum of the face cards?&quot; or &quot;Where are cards with the same value?&quot; and unlock new items that will help solve increasingly harder rounds.","steam_appid":3812620,"support_info":{"email":"us@sokpop.co","url":"sokpop.co"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}