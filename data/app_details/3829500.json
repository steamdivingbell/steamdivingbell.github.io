item_assets/steam/apps/3829500/e9b617bbc5a859dc73dc05b237bad072b59c706f/ss_e9b617bbc5a859dc73dc05b237bad072b59c706f.600x338.jpg?t=1751644519"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3829500/fc682b0db7b06f6b20d58602c18586bb70ed8e16/ss_fc682b0db7b06f6b20d58602c18586bb70ed8e16.1920x1080.jpg?t=1751644519","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3829500/fc682b0db7b06f6b20d58602c18586bb70ed8e16/ss_fc682b0db7b06f6b20d58602c18586bb70ed8e16.600x338.jpg?t=1751644519"}],"short_description":"Find your home in this cozy isometric 3D adventure. Explore the world to gather elemental essence and cleanse crystals, restoring magic to the land. Bond with Robert the frog as he helps you build a peaceful home, all while relaxing in a mystical world.","steam_appid":3829500,"support_info":{"email":"","url":"https://snowscape-studios.carrd.co/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://snowscape-studios.carrd.co/"}