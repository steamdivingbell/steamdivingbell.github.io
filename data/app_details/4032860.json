01a16ac678a95e0e7d84a6c8a539/ss_f65c27072b0901a16ac678a95e0e7d84a6c8a539.1920x1080.jpg?t=1773650225","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4032860/f65c27072b0901a16ac678a95e0e7d84a6c8a539/ss_f65c27072b0901a16ac678a95e0e7d84a6c8a539.600x338.jpg?t=1773650225"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4032860/006cb0f3115479aa4e8cbd04fff22a67082e00e2/ss_006cb0f3115479aa4e8cbd04fff22a67082e00e2.1920x1080.jpg?t=1773650225","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4032860/006cb0f3115479aa4e8cbd04fff22a67082e00e2/ss_006cb0f3115479aa4e8cbd04fff22a67082e00e2.600x338.jpg?t=1773650225"}],"short_description":"Exquisite hand-drawn puzzle game. A lonely wanderer arrives in a desolate world, adrift and lost. Along his journey, he discovers and collects shimmering stars, each with a unique way to unlock. A journey that finds its quiet warmth.","steam_appid":4032860,"support_info":{"email":"3906961843@qq.com","url":""},"supported_languages":"English, Traditional Chinese, Simplified Chinese, French, German, Russian, Japanese, Italian, Portuguese - Brazil, Spanish - Latin America, Vietnamese, Korean","type":"game","website":null}