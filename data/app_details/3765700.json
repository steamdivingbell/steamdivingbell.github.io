 class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3765700/extras/bee81378825efdc97b329811653c1dc8.poster.avif?t=1756504813\" width=616 height=314 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3765700/extras/bee81378825efdc97b329811653c1dc8.webm?t=1756504813\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3765700/extras/bee81378825efdc97b329811653c1dc8.mp4?t=1756504813\" type=\"video/mp4\"></video></span></p>","developers":["Ghostie Games"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3765700/63a8ee18c0db32171c9116810bc6fb307adb5fdb/header.jpg?t=1756504813","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mint Cinnamon</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mint Cinnamon</li></ul>"},"mac_requirements":[],"movies":[{"highlight":true,"id":257147167,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257147167/movie480.mp4?t=1748624804","max":"http://video.akamai.steamstatic.com/store_trailers/257147167/movie_max.mp4?t=1748624804"},"name":"Reveal Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257147167/9bd8a4b1ab4441a519ccff20ed640c99fb6e4adb/movie_600x337.jpg?t=1748624804","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257147167/movie480_vp9.webm?t=1748624804","max":"http://video.akamai.steamstatic.com/store_trailers/257147167/movie_max_vp9.webm?t=1748624804"}}],"name":"Clown Camp","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>