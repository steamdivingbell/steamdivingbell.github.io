7c27ff53fe9561aa2.poster.avif?t=1762085624\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484690/extras/95669411c9b3b127c27ff53fe9561aa2.webm?t=1762085624\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484690/extras/95669411c9b3b127c27ff53fe9561aa2.mp4?t=1762085624\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Lock-on Card</strong></p><p class=\"bb_paragraph\" >When you activate the lock-on card, you can perform a two-stage lock-on. The first stage requires you to control the throttle. The second stage is the easiest\u2014just lock on, and the drone will go!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484690/extras/aa0cf85a5ff4911aa588f07fbb6e693c.poster.avif?t=1762085624\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484690/extras/aa0cf85a5ff4911aa588f07fbb6e693c.webm?t=1762085624\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484690/extras/aa0cf85a5ff4911aa588f07fbb6e693c.mp4?t=1762085624\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>","developers":["Loren"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Racing","id":"9"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3484690/d97a3de634e9f362794e7a76f41e67f9135eb82a/header.jpg?t=1762085624","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3484690/19362565/d79ddde51d4e596db9ccf1bac4396