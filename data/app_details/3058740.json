ared.akamai.steamstatic.com/store_item_assets/steam/apps/3058740/d16898ad83265273f382a3369e98566d09a6edcd/ss_d16898ad83265273f382a3369e98566d09a6edcd.600x338.jpg?t=1773223295"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3058740/107b4869aa4631c1a8eb115b51171b66a4a354d2/ss_107b4869aa4631c1a8eb115b51171b66a4a354d2.1920x1080.jpg?t=1773223295","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3058740/107b4869aa4631c1a8eb115b51171b66a4a354d2/ss_107b4869aa4631c1a8eb115b51171b66a4a354d2.600x338.jpg?t=1773223295"}],"short_description":"A tactical roguelite RPG where every roll matters. Fight on a strategic grid, shape your hero\u2019s path through dice-driven choices, and uncover a story-rich world inspired by tabletop adventures.","steam_appid":3058740,"support_info":{"email":"support@teammojo.games","url":""},"supported_languages":"English, French, Dutch, German, Portuguese - Brazil","type":"game","website":"https://www.oddschronicles.com"}