/3047560/6c87653d75e76ed5fe46327bde7b47071a47867f/ss_6c87653d75e76ed5fe46327bde7b47071a47867f.600x338.jpg?t=1773437355"}],"short_description":"Azhur is a Cyberpunk-themed Competitive Card Game that re-imagines the genre with innovative Hex mechanics. Build a deck with characters from an original world and fight for control over the floating city of Azhur.","steam_appid":3047560,"support_info":{"email":"","url":"https://discord.gg/vzpqNG6BYw"},"supported_languages":"English","type":"game","website":null}