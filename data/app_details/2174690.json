re_item_assets/steam/apps/2174690/ss_d153dab1c149a8535ff031445be6626c2645bf45.600x338.jpg?t=1767976941"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2174690/ss_1ba0680e2f654b13ab71aa0c55d3851df8771a9f.1920x1080.jpg?t=1767976941","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2174690/ss_1ba0680e2f654b13ab71aa0c55d3851df8771a9f.600x338.jpg?t=1767976941"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2174690/ss_bdc33a7f189e5f5e29838d5aab06ce9d0268c1ea.1920x1080.jpg?t=1767976941","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2174690/ss_bdc33a7f189e5f5e29838d5aab06ce9d0268c1ea.600x338.jpg?t=1767976941"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2174690/ss_974d50413ccf2088920f1cb2482e9df6cdbd8cc4.1920x1080.jpg?t=1767976941","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2174690/ss_974d50413ccf2088920f1cb2482e9df6cdbd8cc4.600x338.jpg?t=1767976941"}],"short_description":"Suck blood and hack monsters in this blend of stealth and action platforming.","steam_appid":2174690,"support_info":{"email":"berkman5@yahoo.com","url":""},"supported_languages":"English","type":"game","website":null}