ore_item_assets/steam/apps/3974320/a1f7eb046360649b4eaf0dc5a36966a8a513e135/ss_a1f7eb046360649b4eaf0dc5a36966a8a513e135.600x338.jpg?t=1757387473"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3974320/e3e3a85477d846c8fc53e099af72f1f7969dc626/ss_e3e3a85477d846c8fc53e099af72f1f7969dc626.1920x1080.jpg?t=1757387473","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3974320/e3e3a85477d846c8fc53e099af72f1f7969dc626/ss_e3e3a85477d846c8fc53e099af72f1f7969dc626.600x338.jpg?t=1757387473"}],"short_description":"A European priest serving in West Africa ventures deep into the jungle to aid a dying brother. Build poker hands, bend the rules with saints and relics, and unleash holy combos to save your travel companions from their sins, lest their souls be damned.","steam_appid":3974320,"support_info":{"email":"bisong@sainthoodgame.com","url":""},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}