ience.","steam_appid":3802610,"support_info":{"email":"info@dazardstudio.com","url":"https://dazardstudio.com/dazardgames/"},"supported_languages":"English, French, Italian, German, Spanish - Spain, Japanese, Korean, Portuguese - Portugal, Simplified Chinese, Spanish - Latin America","type":"game","website":"https://dazardstudio.com/dazardgames/pieceful/"}