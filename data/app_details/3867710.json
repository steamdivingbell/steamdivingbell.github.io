com/store_item_assets/steam/apps/3867710/02ff4aa8e4a6536565cf127b5781197dea8309ed/ss_02ff4aa8e4a6536565cf127b5781197dea8309ed.600x338.jpg?t=1756734765"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/437adcfa65f8e9a90421434a943c76c45cde20b5/ss_437adcfa65f8e9a90421434a943c76c45cde20b5.1920x1080.jpg?t=1756734765","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/437adcfa65f8e9a90421434a943c76c45cde20b5/ss_437adcfa65f8e9a90421434a943c76c45cde20b5.600x338.jpg?t=1756734765"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/c775b6454f7173da840160a6fd58e5601ce98e91/ss_c775b6454f7173da840160a6fd58e5601ce98e91.1920x1080.jpg?t=1756734765","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/c775b6454f7173da840160a6fd58e5601ce98e91/ss_c775b6454f7173da840160a6fd58e5601ce98e91.600x338.jpg?t=1756734765"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/ad91a67a8cda3bac1959900ab067405c97096722/ss_ad91a67a8cda3bac1959900ab067405c97096722.1920x1080.jpg?t=1756734765","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/ad91a67a8cda3bac1959900ab067405c97096722/ss_ad91a67a8cda3bac1959900ab067405c97096722.600x338.jpg?t=1756734765"}],"short_description":"Rage Tower is a pixel-art platformer full of traps and frustration. You play as a guy who got thrown to the top of a deadly tower. Now you have to jump, dodge, and survive as you make your way down. Every step hides a trick. Every jump might kill you. The game is very unfair \u2014 can you handle it?","steam_appid":3867710,"support_info":{"email":"ragetower.blablagames@gmail.com","url":""},"supported_languages":"English, Italian, Simplified Chinese","type":"game","website":null}