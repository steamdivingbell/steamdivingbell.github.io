647220"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/c775b6454f7173da840160a6fd58e5601ce98e91/ss_c775b6454f7173da840160a6fd58e5601ce98e91.1920x1080.jpg?t=1765647220","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/c775b6454f7173da840160a6fd58e5601ce98e91/ss_c775b6454f7173da840160a6fd58e5601ce98e91.600x338.jpg?t=1765647220"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/18caf93756a93c317a77be583abfd7f71b8ffd06/ss_18caf93756a93c317a77be583abfd7f71b8ffd06.1920x1080.jpg?t=1765647220","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3867710/18caf93756a93c317a77be583abfd7f71b8ffd06/ss_18caf93756a93c317a77be583abfd7f71b8ffd06.600x338.jpg?t=1765647220"}],"short_description":"Rage Tower is a pixel-art platformer full of traps and frustration. You play as a guy who got thrown to the top of a deadly tower. Now you have to jump, dodge, and survive as you make your way down. Every step hides a trick. Every jump might kill you. The game is very unfair \u2014 can you handle it?","steam_appid":3867710,"support_info":{"email":"ragetower.blablagames@gmail.com","url":""},"supported_languages":"English, Italian, Simplified Chinese, Traditional Chinese","type":"game","website":null}