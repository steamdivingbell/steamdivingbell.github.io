anding new tactics depending on their combinations.</p><p class=\"bb_paragraph\" style=\"text-align: center\">Challenge new builds with every run and enjoy your own distinctive combat style!</p><p class=\"bb_paragraph\" ></p>","developers":["ArmedPeseant"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3876950/d513c3ca881706064d78b10bd20852983cc2a777/header.jpg?t=1760365774","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3876950/1778200811/d515ea6a8462c4d0454b98891110a214e245ca7c/1760365065/dash_av1.mpd?t=1760365724","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3876950/1778200811/d515ea6a8462c4d0454b98891110a214e245ca7c/1760365065/dash_h264.mpd?t=1760365724","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3876950/1778200811/d515ea6a8462c4d0454b98891110a214e245ca7c/1760365065/hls_264_master.m3u8?t=1760365724","id":257217046,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257217046/movie480.mp4?t=1760365724","max":"https://video.akamai.steamstatic.com/store_trailers/257217046/movie_max.mp4?t=1760365724"},"name":"SAMUKID Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257217046/584990f75d101bca7af0350b289768f706c7b032/movie_600x337.jpg?t=1760365724","webm":{"480":"https://video.akamai.steamstatic.com/store_trailers/257217046/movie480.webm?t=1760365724","max":"https://video.akamai.steamstatic.com/store_trailers/257217046/movie_max.webm?t=1760365724"}}],"name":"SAMUKID","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3-3220 / AMD FX-4100<br></li>