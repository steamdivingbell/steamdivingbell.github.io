66ff2c6.1920x1080.jpg?t=1760365774","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3876950/d2c84174b3ec2ff47b869e2813a0391c866ff2c6/ss_d2c84174b3ec2ff47b869e2813a0391c866ff2c6.600x338.jpg?t=1760365774"}],"short_description":"SAMUKID is a unique strategic action roguelike deck-building game where combat and movement are separate roles. Build powerful synergies between dice-based battles and grid-based movement, and lead the blind samurai and his young companion on a legendary journey!","steam_appid":3876950,"support_info":{"email":"TTobing3@gmail.com","url":"https://x.com/ArmedPeseant"},"supported_languages":"English, Japanese, Korean, Simplified Chinese","type":"game","website":null}