static.com/store_item_assets/steam/apps/3595590/9fcdb0e8504b2231a3228efbbc5dfa24b80207a3/ss_9fcdb0e8504b2231a3228efbbc5dfa24b80207a3.600x338.jpg?t=1771782310"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/d361f94b14f3fe121c9804017c0cb23bd66899c1/ss_d361f94b14f3fe121c9804017c0cb23bd66899c1.1920x1080.jpg?t=1771782310","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/d361f94b14f3fe121c9804017c0cb23bd66899c1/ss_d361f94b14f3fe121c9804017c0cb23bd66899c1.600x338.jpg?t=1771782310"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/8a8ac6839cc1a8ea007bf36f6ecf5abdb0d0cde0/ss_8a8ac6839cc1a8ea007bf36f6ecf5abdb0d0cde0.1920x1080.jpg?t=1771782310","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/8a8ac6839cc1a8ea007bf36f6ecf5abdb0d0cde0/ss_8a8ac6839cc1a8ea007bf36f6ecf5abdb0d0cde0.600x338.jpg?t=1771782310"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/2eda55ba0151f1bc38034b80cb3f4c2eda32291d/ss_2eda55ba0151f1bc38034b80cb3f4c2eda32291d.1920x1080.jpg?t=1771782310","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/2eda55ba0151f1bc38034b80cb3f4c2eda32291d/ss_2eda55ba0151f1bc38034b80cb3f4c2eda32291d.600x338.jpg?t=1771782310"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/fe0eb87c5f1d890e5f42b267cbeba3dfea536a4a/ss_fe0eb87c5f1d890e5f42b267cbeba3dfea536a4a.1920x1080.jpg?t=1771782310","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/fe0eb87c5f1d890e5f42b267cbeba3dfea536a4a/ss_fe0eb87c5f1d890e5f42b267cbeba3dfea536a4a.600x338.jpg?t=1771782310"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3595590/19de5e807f0d32bfaed35d3a64a955725872f8bc/ss_19de5e807f0d32bfaed35d3a64a955725872f8bc.1