\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2790090/extras/27e6863f91a75fe1cafeb8f5c832e102.webm?t=1770067372\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2790090/extras/27e6863f91a75fe1cafeb8f5c832e102.mp4?t=1770067372\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>High Risk, High Reward</strong></h2><p class=\"bb_paragraph\" >Every Ability In Sirocco Is A Skill Shot.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Deep Strategy, Not Memorization</strong></h2><p class=\"bb_paragraph\" >Combine specialized weapons, ship abilities, and ability augmentations to develop your own way to play. </p><h2 class=\"bb_tag\" ><strong>Conquer The Five Seas with your Friends by Making New Ones</strong></h2><p class=\"bb_paragraph\" >In Sirocco, teams win, not individuals, so whether you are 10-0 or 0-10, our economic system ensures all your friends are critical to achieving victory.</p>","developers":["Lunchbox Entertainment Inc."],"genres":[{"description":"Action","id":"1"},{"description":"Strategy","id":"2"},{"description":"Free To Play","id":"37"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2790090/header.jpg?t=1770067372","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2790090/824842/81f6d9d2b9c141aded3ab82096a0bd0e03cfc8e3/1750900339/dash_av1.mpd?t=1745274009","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2790090/824842/81f6d9d2b9c141aded3ab82096a0bd0e03cfc8e3/1750900339/dash_h264.mpd?t=1745274009","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2790090/824842/81f6d9d2b9c141aded3ab82096a0bd0e03cfc8e3/1750900339/hls_264_master.m3u8?t=1745274009","id":257095711,"name":"Sirocco Cinematic Trail