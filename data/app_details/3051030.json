f485ec37458424b23adf09ecfe78e1ca9550fc.1920x1080.jpg?t=1773039419","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3051030/ss_f4f485ec37458424b23adf09ecfe78e1ca9550fc.600x338.jpg?t=1773039419"},{"id":16,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3051030/ss_248a3ef57810b3c1d46127235777f4fed8f8a0ba.1920x1080.jpg?t=1773039419","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3051030/ss_248a3ef57810b3c1d46127235777f4fed8f8a0ba.600x338.jpg?t=1773039419"}],"short_description":"You are an artaktikon named Ballin. Plucking up your courage, you decided to start fresh: move to the big city and get a job. You truly believed that the dark ages, when predators devoured herbivores, were long gone... Or so you thought, until recently.","steam_appid":3051030,"support_info":{"email":"sanyabazhen.game@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Polish, Russian, Ukrainian, Czech, Japanese, Kazakh, Simplified Chinese, Portuguese - Brazil, Korean, Turkish","type":"game","website":null}