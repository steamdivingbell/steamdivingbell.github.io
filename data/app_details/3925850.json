a94a580c242024fdef3fc484be7bceab82/ss_a7a600a94a580c242024fdef3fc484be7bceab82.600x338.jpg?t=1757487092"}],"short_description":"Explore a punishing abandoned mine in search of your missing brother. Establish camp, manage supplies and survive as you desperately search to discover a cure for the corruption that gnaws at you in the darkness.","steam_appid":3925850,"support_info":{"email":"support@itsmyfirstdaystudios.com","url":""},"supported_languages":"English","type":"game","website":null}