amai.steamstatic.com/store_item_assets/steam/apps/3925850/bb57642ff221a058a13f5cc68c49e80d9e02562b/ss_bb57642ff221a058a13f5cc68c49e80d9e02562b.1920x1080.jpg?t=1757487092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/bb57642ff221a058a13f5cc68c49e80d9e02562b/ss_bb57642ff221a058a13f5cc68c49e80d9e02562b.600x338.jpg?t=1757487092"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/99046c54a443654ef526e5fbdb1e4bdb97eb2201/ss_99046c54a443654ef526e5fbdb1e4bdb97eb2201.1920x1080.jpg?t=1757487092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/99046c54a443654ef526e5fbdb1e4bdb97eb2201/ss_99046c54a443654ef526e5fbdb1e4bdb97eb2201.600x338.jpg?t=1757487092"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/0268d74e9f13fc7aaf3feaeb1b99589377d1a842/ss_0268d74e9f13fc7aaf3feaeb1b99589377d1a842.1920x1080.jpg?t=1757487092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/0268d74e9f13fc7aaf3feaeb1b99589377d1a842/ss_0268d74e9f13fc7aaf3feaeb1b99589377d1a842.600x338.jpg?t=1757487092"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/2b6fb154ca574336c9ef0a02c290c9f585c6aafe/ss_2b6fb154ca574336c9ef0a02c290c9f585c6aafe.1920x1080.jpg?t=1757487092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/2b6fb154ca574336c9ef0a02c290c9f585c6aafe/ss_2b6fb154ca574336c9ef0a02c290c9f585c6aafe.600x338.jpg?t=1757487092"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/7463f17f06d86fb76ad4e2e7ea0f5eca133eecf8/ss_7463f17f06d86fb76ad4e2e7ea0f5eca133eecf8.1920x1080.jpg?t=1757487092","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3925850/7463f17f06d86fb76ad4e2e7ea0f5eca133eecf8/ss_7463f17f06d86fb76ad4e2e7ea0f5eca133e