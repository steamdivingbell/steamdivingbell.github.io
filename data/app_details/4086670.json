om/store_item_assets/steam/apps/4086670/4050183582437bdca3ecdfdc871532b61ed506d0/ss_4050183582437bdca3ecdfdc871532b61ed506d0.1920x1080.jpg?t=1768245375","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086670/4050183582437bdca3ecdfdc871532b61ed506d0/ss_4050183582437bdca3ecdfdc871532b61ed506d0.600x338.jpg?t=1768245375"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086670/1b976c4ac152a46ef7c8cf232511caa01dc1285d/ss_1b976c4ac152a46ef7c8cf232511caa01dc1285d.1920x1080.jpg?t=1768245375","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4086670/1b976c4ac152a46ef7c8cf232511caa01dc1285d/ss_1b976c4ac152a46ef7c8cf232511caa01dc1285d.600x338.jpg?t=1768245375"}],"short_description":"Drunk &amp; Damned is a goofy medieval cooking game where 2\u20138 players can team up in multiplayer co-op to cook, brawl, and compete between rival tavern. Two taverns. Two chaotic kitchen. Grab your beard and show everyone that your team can serve meat and madness better than the rest!","steam_appid":4086670,"support_info":{"email":"emresnyrk7@gmail.com","url":""},"supported_languages":"English, Turkish","type":"game","website":null}