 in the ways of our great motherland and its superior ideology.</p><p class=\"bb_paragraph\">Should the need arise, she will be there to help you with her Revolutionary Beam.</p><br><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2854440/extras/gif_steam_04.gif?t=1740406102\" /></p>","developers":["tiny cactus studio"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2854440/header.jpg?t=1740406102","is_free":false,"legal_notice":"\u00a92024 tiny cactus studio","linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257052235,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257052235/movie480.mp4?t=1740161952","max":"http://video.akamai.steamstatic.com/store_trailers/257052235/movie_max.mp4?t=1740161952"},"name":"1st Trailer | EN","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257052235/474df22aa6e1a64b3cbe992e07bf93b281d1942a/movie_600x337.jpg?t=1740161952","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257052235/movie480_vp9.webm?t=1740161952","max":"http://video.akamai.steamstatic.com/store_trailers/257052235/movie_max_vp9.webm?t=1740161952"}}],"name":"Red Rocket Defencism","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> windows 10<br></li><li><strong>Processor:</strong> Intel Core-i5<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 4000</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> windows 10 / 11<br></li><li><strong>Processor:</strong> Intel Core-i7<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong