d.akamai.steamstatic.com/store_item_assets/steam/apps/3732120/050b13c6907c4e593102ea85ba920e104ea51c85/ss_050b13c6907c4e593102ea85ba920e104ea51c85.600x338.jpg?t=1753425633"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3732120/6428b2a9b6185ceb23966f4833d08248a354b17f/ss_6428b2a9b6185ceb23966f4833d08248a354b17f.1920x1080.jpg?t=1753425633","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3732120/6428b2a9b6185ceb23966f4833d08248a354b17f/ss_6428b2a9b6185ceb23966f4833d08248a354b17f.600x338.jpg?t=1753425633"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3732120/b26fb58985596af67465419ff9afbe02a00e8435/ss_b26fb58985596af67465419ff9afbe02a00e8435.1920x1080.jpg?t=1753425633","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3732120/b26fb58985596af67465419ff9afbe02a00e8435/ss_b26fb58985596af67465419ff9afbe02a00e8435.600x338.jpg?t=1753425633"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3732120/707cca20ab04ac95b9a6e042ccaeb76893bd3c04/ss_707cca20ab04ac95b9a6e042ccaeb76893bd3c04.1920x1080.jpg?t=1753425633","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3732120/707cca20ab04ac95b9a6e042ccaeb76893bd3c04/ss_707cca20ab04ac95b9a6e042ccaeb76893bd3c04.600x338.jpg?t=1753425633"}],"short_description":"Control a sootball to hunt for the insatiable Abyssal Maw. Slay monsters, haul corpses with sootball, earn Corrupted Bone Shards. Trade for upgrades. Survive chaos challenges like lightning storms. As feeding escalates, mutations worsen\u2014balance risks to sustain your fragile survival loop.","steam_appid":3732120,"support_info":{"email":"vanxehus@gmail.com","url":""},"supported_languages":"English, Simplified Chinese","type":"game","website":null}