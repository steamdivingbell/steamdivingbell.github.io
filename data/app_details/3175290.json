ontrol lighting and electrical signals through network controls</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3175290/extras/Electrical.png?t=1745190268\" /></p></li><li><p class=\"bb_paragraph\">Automation - Link machines together with tubes and conveyer belts to create advanced recipes.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3175290/extras/Machinery.png?t=1745190268\" /></p><p class=\"bb_paragraph\"></p></li><li><p class=\"bb_paragraph\">Advanced town building features. Add buildings and assign them roles such as Blacksmith, Hospital, Forester and more!</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3175290/extras/Buildings.png?t=1745190268\" /></p></li></ul>","developers":["TBone Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3175290/2bd1d6d01e0cfb0aff302b5586a2b3bb382c4a4d/header.jpg?t=1745190268","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257092158,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257092158/movie480.mp4?t=1745190267","max":"http://video.akamai.steamstatic.com/store_trailers/257092158/movie_max.mp4?t=1745190267"},"name":"Announcement Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257092158/6ffc0fb6451027750b5b08d25fc6419ce0d3e409/movie_600x337.jpg?t=1745190267","webm":{"4