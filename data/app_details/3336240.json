75/hls_264_master.m3u8?t=1732349998","id":257075977,"name":"Walk The Frog - short gameplay puzzle","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257075977/d6eb5e88706b19aeb26c0132b0e48fee907f51ac/movie_600x337.jpg?t=1732349998"}],"name":"Walk The Frog","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel i3 Dual Core<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD 4000<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel i5 Dual Core<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD 4000</li></ul>"},"platforms":{"linux":false,"mac":true,"windows":true},"publishers":["Walk The Frog"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":true,"date":"2026"},"required_age":0,"reviews":"\u201c(Demo) A charming free demo that offers a relaxing taste of its quirky world, creative puzzles, and cozy atmosphere. Perfect if you want to try something light and fun.\u201d<br>10 \u2013 GameSpectrum<br><br>\u201c\u2014with heart, tea, and lots of coziness. Perfect for unwinding, puzzling, and making new friends. Simply cozy!\u201d<br>10 \u2013 Games Ground Berlin<br><br>\u201cReally cozy! Very calm and comfy and delivered exactly what i was wanting from this game when i saw it. The dialogue is silly and engaging to read, the puzzles are fun, its a near perfect game imo.\u201d<br>10 \u2013  An Evening With Dylan<br>","screenshots":[{"id":0,"path_full