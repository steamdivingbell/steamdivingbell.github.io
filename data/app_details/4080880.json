02a20a34e37/ss_106a95f4ee0f4dc87afb2193d141802a20a34e37.600x338.jpg?t=1762782958"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4080880/dfe22abb290259aae9bb44bde9f8141bc0114ed6/ss_dfe22abb290259aae9bb44bde9f8141bc0114ed6.1920x1080.jpg?t=1762782958","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4080880/dfe22abb290259aae9bb44bde9f8141bc0114ed6/ss_dfe22abb290259aae9bb44bde9f8141bc0114ed6.600x338.jpg?t=1762782958"}],"short_description":"A challenging and small dungeon crawler with a top-down perspective. Find the Gem of Protection to protect the village from evil spirits. Pick apart rocks, find some loot, sell gems, solve small puzzles and upgrade your stats.","steam_appid":4080880,"support_info":{"email":"zeroonepixels@outlook.de","url":""},"supported_languages":"English","type":"game","website":null}