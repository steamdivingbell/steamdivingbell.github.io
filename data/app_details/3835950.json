2b9.1920x1080.jpg?t=1774588207","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3835950/0bac69cd27374ac954fbc7921b79590692e1e2b9/ss_0bac69cd27374ac954fbc7921b79590692e1e2b9.600x338.jpg?t=1774588207"}],"short_description":"First-person leak-wrangling survival. Catch ceiling drops in containers, dump them into the drain, and don\u2019t drown. Chase high scores in the garage or survive a 4-room house run, with wizard boons between levels.","steam_appid":3835950,"support_info":{"email":"support@hackastan.com","url":"http://www.hackastan.com"},"supported_languages":"English","type":"game","website":"http://www.hackastan.com"}