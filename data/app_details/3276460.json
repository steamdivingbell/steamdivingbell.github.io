paragraph\"><strong>Your choice affects the plot.</strong> Passing the game, you will have to make decisions, the consequences of which can lead to unexpected turns of events. </p></li></ul><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3276460/extras/02_slide.png?t=1743782308\" /></p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3276460/extras/05_Wishlist_eng.png?t=1743782308\" /></p>","developers":["Kick Punch Games"],"fullgame":{"appid":"2481160","name":"The Hungry Town"},"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3276460/0ec29c78202fe6e1f5746c9de7db49da054a8da7/header.jpg?t=1743782308","is_free":true,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257066818,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257066818/movie480.mp4?t=1734989012","max":"http://video.akamai.steamstatic.com/store_trailers/257066818/movie_max.mp4?t=1734989012"},"name":"The Hungry Town | Gameplay footage","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257066818/415c790eef26cb07f4c94ffccd3791a4056c1caf/movie_600x337.jpg?t=1734989012","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257066818/movie480_vp9.webm?t=1734989012","max":"http://video.akamai.steamstatic.com/store_trailers/257066818/movie_max_vp9.webm?t=1734989012"}},{"highlight":true,"id":257061825,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257061825/movie480.mp4?t=17349