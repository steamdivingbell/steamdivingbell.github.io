cludes only the first area of the world and the associated upgrades within that area. There is a small second area included to wrap up the demo that is not in the final game.</i></p>","developers":["Jobblesack Games Inc."],"fullgame":{"appid":"3721660","name":"Cozy Crunch"},"genres":[{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920060/63c628d24b7a9c8236bddbfcdc264a9ab4a1d7a0/header.jpg?t=1754679244","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257176550,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257176550/movie480.mp4?t=1754423109","max":"http://video.akamai.steamstatic.com/store_trailers/257176550/movie_max.mp4?t=1754423109"},"name":"Cozy Crunch | Demo Trailer | A Relaxing Indie Cat Adventure Game","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257176550/6f27c65588dd643131e627c2b534f00d2403a373/movie_600x337.jpg?t=1754423109","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257176550/movie480_vp9.webm?t=1754423109","max":"http://video.akamai.steamstatic.com/store_trailers/257176550/movie_max_vp9.webm?t=1754423109"}}],"name":"Cozy Crunch Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Memory:</strong> 100 MB RAM</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Jobblesack Games Inc."],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_age":"0","use_age_gate":"0"}},"release_date":{"coming_soon":false,"date":"5 Aug, 2025"},"required_age":0,"screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3920060/6bb0adeab167fc92c9e9be