=\"bb_paragraph\">Earn unlimited points during sessions and spend them on unlocking visual content directly within the demo.</p></li><li><p class=\"bb_paragraph\"><strong>Relaxing Pause Atmosphere</strong></p><p class=\"bb_paragraph\">Breaks feature calm animations with drifting clouds and ambient motion to help you reset and recharge.</p></li></ul>","developers":["Mario Jacob"],"fullgame":{"appid":"3445000","name":"Sky Dreamer"},"genres":[{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3672070/5c767ec3466bb0d72ca7c28ac5737404bb8c0984/header.jpg?t=1745829584","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257127256,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127256/movie480.mp4?t=1745826581","max":"http://video.akamai.steamstatic.com/store_trailers/257127256/movie_max.mp4?t=1745826581"},"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257127256/4b4dfc34469c8ddfecec4593733f55ed3629abf5/movie_600x337.jpg?t=1745826581","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127256/movie480_vp9.webm?t=1745826581","max":"http://video.akamai.steamstatic.com/store_trailers/257127256/movie_max_vp9.webm?t=1745826581"}}],"name":"Sky Dreamer Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 64bit<br></li><li><strong>Processor:</strong> 64 bit architecture<br></li><li><strong>Memory:</strong> 8 GB RAM</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Mario Jacob"],"ratings":{"dejus":{"banned":"0","descriptors":"","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","required_