/ss_8629ed32e2b81d0968704d989dc6c227d642eecc.600x338.jpg?t=1761215371"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/d93d44a2c6ba5cd6af38e27863b9a3d1c59c9d81/ss_d93d44a2c6ba5cd6af38e27863b9a3d1c59c9d81.1920x1080.jpg?t=1761215371","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/d93d44a2c6ba5cd6af38e27863b9a3d1c59c9d81/ss_d93d44a2c6ba5cd6af38e27863b9a3d1c59c9d81.600x338.jpg?t=1761215371"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/764dda2e7cfe2589df5c7568bbfa1b9a17d03b6f/ss_764dda2e7cfe2589df5c7568bbfa1b9a17d03b6f.1920x1080.jpg?t=1761215371","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/764dda2e7cfe2589df5c7568bbfa1b9a17d03b6f/ss_764dda2e7cfe2589df5c7568bbfa1b9a17d03b6f.600x338.jpg?t=1761215371"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/cebaa65159306e1774dce902132d147e5a48d659/ss_cebaa65159306e1774dce902132d147e5a48d659.1920x1080.jpg?t=1761215371","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/cebaa65159306e1774dce902132d147e5a48d659/ss_cebaa65159306e1774dce902132d147e5a48d659.600x338.jpg?t=1761215371"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/1759507867a790975103887e805665da90d0778f/ss_1759507867a790975103887e805665da90d0778f.1920x1080.jpg?t=1761215371","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/1759507867a790975103887e805665da90d0778f/ss_1759507867a790975103887e805665da90d0778f.600x338.jpg?t=1761215371"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/b423029cf7a2bafa814b928f5ed47b344714fd99/ss_b423029cf7a2bafa814b928f5ed47b344714fd99.1920x1080.jpg?t=1761215371","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446060/b423029cf7a2bafa814b928f5ed47b344714fd99/ss_b423029cf7a2bafa814b928f5ed47b344714fd99.600x338.jpg?t=1761215371"}],"short_description":"Discover powerful items and unleash devastating spells, but remember - your backpack is your greatest weapon! Strategically arrange your inventory to boost bonuses, stack multipliers and then defeat the approaching dark forces in this Roguelike adventure.","steam_appid":3446060,"support_info":{"email":"thatfriendlydev@gmail.com","url":""},"supported_languages":"English, French, Italian, German, Spanish - Spain, Bulgarian, Polish, Russian, Ukrainian, Japanese, Simplified Chinese","type":"game","website":"https://impress.games/press-kit/thatfriendlydev/backpack-guardian"}