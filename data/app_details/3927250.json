amai.steamstatic.com/store_item_assets/steam/apps/3927250/8ac20a18ba1a8a868f8744fc35da4b0f1ff3d4ce/ss_8ac20a18ba1a8a868f8744fc35da4b0f1ff3d4ce.600x338.jpg?t=1770737763"}],"short_description":"Frog It Up is an incremental clicker game where you lure frogs to a pond and help them build their own cozy little city. As the pond grows, you\u2019ll decide which upgrades to unlock, shaping how the city expands over time and steering progress in the direction you prefer.","steam_appid":3927250,"support_info":{"email":"contact.starfallgames@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Spanish - Spain<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}