_assets/steam/apps/3009970/de9d72b31c7fa13794755babaca6aabc39d64ac2/ss_de9d72b31c7fa13794755babaca6aabc39d64ac2.600x338.jpg?t=1773076715"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3009970/8abe28403b35f03087edf33e5360c2551e5f5896/ss_8abe28403b35f03087edf33e5360c2551e5f5896.1920x1080.jpg?t=1773076715","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3009970/8abe28403b35f03087edf33e5360c2551e5f5896/ss_8abe28403b35f03087edf33e5360c2551e5f5896.600x338.jpg?t=1773076715"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3009970/4ab7bbcbf528a02fa6ca86f3d08a082442db4a69/ss_4ab7bbcbf528a02fa6ca86f3d08a082442db4a69.1920x1080.jpg?t=1773076715","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3009970/4ab7bbcbf528a02fa6ca86f3d08a082442db4a69/ss_4ab7bbcbf528a02fa6ca86f3d08a082442db4a69.600x338.jpg?t=1773076715"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3009970/b1a16d28f70f8afe8583f58529d449662b610664/ss_b1a16d28f70f8afe8583f58529d449662b610664.1920x1080.jpg?t=1773076715","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3009970/b1a16d28f70f8afe8583f58529d449662b610664/ss_b1a16d28f70f8afe8583f58529d449662b610664.600x338.jpg?t=1773076715"}],"short_description":"Haifa is a hidden object puzzle experience that tells a story about the emotional struggles of trying to maintain hopefulness in times of war. Help your characters keep their head up by finding small objects in their environment to lift their spirits, as they look for their lost friend.","steam_appid":3009970,"support_info":{"email":"Estermarshakatlas@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}