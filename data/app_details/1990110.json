pg?t=1746087542"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1990110/4100563037096a90f33c90f39dfc565bacae5615/ss_4100563037096a90f33c90f39dfc565bacae5615.1920x1080.jpg?t=1746087542","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1990110/4100563037096a90f33c90f39dfc565bacae5615/ss_4100563037096a90f33c90f39dfc565bacae5615.600x338.jpg?t=1746087542"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1990110/c2bbf9bf70426dc48601426e3378cb45e7615181/ss_c2bbf9bf70426dc48601426e3378cb45e7615181.1920x1080.jpg?t=1746087542","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1990110/c2bbf9bf70426dc48601426e3378cb45e7615181/ss_c2bbf9bf70426dc48601426e3378cb45e7615181.600x338.jpg?t=1746087542"}],"short_description":"SpellRogue is the ultimate tactical turn-based roguelike! Draft from over 350 powerful spells to assemble the perfect combination and crush your enemies in 70+ unique encounters. Face brutal choices, adapt to impossible odds, and strike back at the horrors that destroyed the world.","steam_appid":1990110,"support_info":{"email":"","url":"https://www.spellrogue.com/"},"supported_languages":"English, French, German, Spanish - Spain, Russian, Simplified Chinese, Japanese, Korean, Polish, Portuguese - Brazil, Traditional Chinese","type":"game","website":"https://www.spellrogue.com/"}