apps/1172350/extras/8c6bd50e24887aa2a308ec566eac9c04.poster.avif?t=1581863674\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1172350/extras/8c6bd50e24887aa2a308ec566eac9c04.webm?t=1581863674\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1172350/extras/8c6bd50e24887aa2a308ec566eac9c04.mp4?t=1581863674\" type=\"video/mp4\"></video></span><br><br>We update the demo every two weeks, so check back often to see all the new features!<h2 class=\"bb_tag\" >Support Us On Indiegogo!</h2><br>We've recently launched our Indiegogo campaign which has already received fantastic support and would be excited to have you join as well! If you'd like to support us or find out in detail the future plans for the game, click on the image below to reach the Indiegogo page! <br><br>","developers":["CaffeineWare"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1172350/header.jpg?t=1581863674","is_free":false,"legal_notice":"\u00a9 CaffeineWare 2019","linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1172350/250634/0c34720c309631f7d146f064243bd61846a1f729/1751198710/dash_av1.mpd?t=1572574836","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1172350/250634/0c34720c309631f7d146f064243bd61846a1f729/1751198710/dash_h264.mpd?t=1572574836","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1172350/250634/0c34720c309631f7d146f064243bd61846a1f729/1751198710/hls_264_master.m3u8?t=1572574836","id":256766048,"name":"Bot Net: Ramshackle Robotics Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256766048/movie.293x165.jpg?t=1572574836"}],"name":"Bot Net: Ramshackle Robotics","package_groups":[],"pc_requirements":{