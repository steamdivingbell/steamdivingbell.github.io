e sound</p><p class=\"bb_paragraph\">*Up to 5 levels of LOD</p><p class=\"bb_paragraph\">*Doors that open/close via Properties tab or when loading/unloading passengers plus sounds</p><p class=\"bb_paragraph\">*Disable Physics option</p><p class=\"bb_paragraph\">*Custom bogeysounds</p><p class=\"bb_paragraph\">*Interior &amp; exterior nightmode</p><p class=\"bb_paragraph\">*Editable destination boards with text fields for departure station, destination station, via station, train number</p>","developers":["i29tsro"],"fullgame":{"appid":"1784570","name":"Trainz Railroad Simulator 2022"},"genres":[{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3658750/66168d6e8cebb1cc9182a39bbf5c235f8a500600/header.jpg?t=1745476625","is_free":false,"legal_notice":"Published and developed by N3V Games Pty Ltd . N3V Games, Trainz and their respective logos are trademarks of N3V Games.  All other trademarks, logos and copyrights are property of their respective owners. All rights reserved.","linux_requirements":[],"mac_requirements":[],"name":"Trainz 2022 DLC - OBB Bmoz 21-70 002","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Trainz 2022 DLC - OBB Bmoz 21-70 002 - $5.99 USD","packageid":1289142,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":599}],"title":"Buy Trainz 2022 DLC - OBB Bmoz 21-70 002"}],"packages":[1289142],"pc_requirements":[],"platforms":{"linux":false,"mac":true,"windows":true},"price_overview":{"currency":"USD","discount_percent":0,"final":599,"final_formatted":"$5.99 USD","initial":599,"initial_formatted":""},"publishers":["N3V Games"],"ratings":{"dejus":{"rating":"l"},"steam_germany":{"banned":"0","descriptors":"","rating":"0","rating_generated":"1","r