amai.steamstatic.com/store_item_assets/steam/apps/3856460/1e915ec91f78ddd96cd61f8c0126897968ccd67e/ss_1e915ec91f78ddd96cd61f8c0126897968ccd67e.1920x1080.jpg?t=1768044772","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3856460/1e915ec91f78ddd96cd61f8c0126897968ccd67e/ss_1e915ec91f78ddd96cd61f8c0126897968ccd67e.600x338.jpg?t=1768044772"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3856460/b4171590e10f7bdf60e793f0eb8082979954abaa/ss_b4171590e10f7bdf60e793f0eb8082979954abaa.1920x1080.jpg?t=1768044772","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3856460/b4171590e10f7bdf60e793f0eb8082979954abaa/ss_b4171590e10f7bdf60e793f0eb8082979954abaa.600x338.jpg?t=1768044772"}],"short_description":"From letters to lunacy, Cursed Words is a roguelike chasing ever-stronger synergies. Start with simple words like BUY or THIS or GAME, then use game-altering combos to break the rules. Before long you\u2019ll be \u00bc\u2656\u2659K5XNG the \u2157H\u26574 out of these 83VK??7?!","steam_appid":3856460,"support_info":{"email":"someburiedthings@gmail.com","url":""},"supported_languages":"English","type":"game","website":null}