ai.steamstatic.com/store_item_assets/steam/apps/3983200/88a10584821f8b90068b88f6ac1093a172630f74/ss_88a10584821f8b90068b88f6ac1093a172630f74.1920x1080.jpg?t=1774238983","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3983200/88a10584821f8b90068b88f6ac1093a172630f74/ss_88a10584821f8b90068b88f6ac1093a172630f74.600x338.jpg?t=1774238983"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3983200/da5b7a6bb2db97e0658457fe394d44f9c520064e/ss_da5b7a6bb2db97e0658457fe394d44f9c520064e.1920x1080.jpg?t=1774238983","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3983200/da5b7a6bb2db97e0658457fe394d44f9c520064e/ss_da5b7a6bb2db97e0658457fe394d44f9c520064e.600x338.jpg?t=1774238983"}],"short_description":"FiresOut! is a chaotic co-op firefighting game for 1-4 players, playable in local or online multiplayer. As firefighting interns, you and your friends battle raging fires using a toilet goldfish, rescue victims, or somehow make everything worse. It\u2019s fine. Probably.","steam_appid":3983200,"support_info":{"email":"dreamonaut.studio@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, French, German, Spanish - Spain, Japanese, Russian, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"game","website":null}