_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3222130/f0370a5df5510e814c29eec0aa556f8f3fb0d2d6/ss_f0370a5df5510e814c29eec0aa556f8f3fb0d2d6.1920x1080.jpg?t=1771945587","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3222130/f0370a5df5510e814c29eec0aa556f8f3fb0d2d6/ss_f0370a5df5510e814c29eec0aa556f8f3fb0d2d6.600x338.jpg?t=1771945587"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3222130/8c3e8ab47593eb71efc48968f460b4ad2c30efb9/ss_8c3e8ab47593eb71efc48968f460b4ad2c30efb9.1920x1080.jpg?t=1771945587","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3222130/8c3e8ab47593eb71efc48968f460b4ad2c30efb9/ss_8c3e8ab47593eb71efc48968f460b4ad2c30efb9.600x338.jpg?t=1771945587"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3222130/03a33efa59eeec74bb301136a01807ba5b70bcb3/ss_03a33efa59eeec74bb301136a01807ba5b70bcb3.1920x1080.jpg?t=1771945587","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3222130/03a33efa59eeec74bb301136a01807ba5b70bcb3/ss_03a33efa59eeec74bb301136a01807ba5b70bcb3.600x338.jpg?t=1771945587"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3222130/92affee166cc1478315a2e6ea6c2459a72e30d23/ss_92affee166cc1478315a2e6ea6c2459a72e30d23.1920x1080.jpg?t=1771945587","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3222130/92affee166cc1478315a2e6ea6c2459a72e30d23/ss_92affee166cc1478315a2e6ea6c2459a72e30d23.600x338.jpg?t=1771945587"}],"short_description":"A social deduction game where crafted cards become spells. Protect allies, sabotage rivals, or prank everyone in a magical fight for survival.","steam_appid":3222130,"support_info":{"email":"info@kuixo.com","url":"https://www.kuixo.com/"},"supported_languages":"English","type":"game","website":"https://www.kuixo.com"}