.com/store_item_assets/steam/apps/2920120/d4d5182682e9d255337bbcf68f65708a5c8ac99e/ss_d4d5182682e9d255337bbcf68f65708a5c8ac99e.1920x1080.jpg?t=1764787863","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920120/d4d5182682e9d255337bbcf68f65708a5c8ac99e/ss_d4d5182682e9d255337bbcf68f65708a5c8ac99e.600x338.jpg?t=1764787863"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920120/453fb7f33f53b6ef32a5fe1582eb38e0a9e43ba9/ss_453fb7f33f53b6ef32a5fe1582eb38e0a9e43ba9.1920x1080.jpg?t=1764787863","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920120/453fb7f33f53b6ef32a5fe1582eb38e0a9e43ba9/ss_453fb7f33f53b6ef32a5fe1582eb38e0a9e43ba9.600x338.jpg?t=1764787863"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920120/9f1f4217f31c681a83029b5a48621aa1c983a95c/ss_9f1f4217f31c681a83029b5a48621aa1c983a95c.1920x1080.jpg?t=1764787863","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2920120/9f1f4217f31c681a83029b5a48621aa1c983a95c/ss_9f1f4217f31c681a83029b5a48621aa1c983a95c.600x338.jpg?t=1764787863"}],"short_description":"A quiet night turns to horror as strange lights fill the sky and Gleam City falls apart. Play as Sarah, an ex-soldier fighting to survive, searching for her missing father, and facing something the world wasn't meant to see.","steam_appid":2920120,"support_info":{"email":"horrawrindiegames@gmail.com","url":"https://www.facebook.com/horrawr/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":"https://www.facebook.com/horrawr/"}