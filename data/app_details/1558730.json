2430"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1558730/ss_1e996ac0cb35e879c0b69beb34352b4c0dfa281d.1920x1080.jpg?t=1753692430","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1558730/ss_1e996ac0cb35e879c0b69beb34352b4c0dfa281d.600x338.jpg?t=1753692430"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1558730/ss_8e3e655c52454266baae259bb5ee89434fc12f72.1920x1080.jpg?t=1753692430","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1558730/ss_8e3e655c52454266baae259bb5ee89434fc12f72.600x338.jpg?t=1753692430"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1558730/ss_a9614232140c407a517112cd89fb2440617d5073.1920x1080.jpg?t=1753692430","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1558730/ss_a9614232140c407a517112cd89fb2440617d5073.600x338.jpg?t=1753692430"}],"short_description":"This point-and-click game immerses you in a hand\u2011drawn world on a cold winter night in 1990s Ukraine. As Alexey, a young man locked out of his apartment, you embark on an unexpectedly heartfelt journey to reclaim your stolen TV. Along the way, uncover charming secrets in an atmospheric neighborhood.","steam_appid":1558730,"support_info":{"email":"trashcrasher@rocketmail.com","url":""},"supported_languages":"English, Russian, Ukrainian, German","type":"game","website":null}