.akamai.steamstatic.com/store_item_assets/steam/apps/3700660/extras/description_footsteps.png?t=1749604335\" /><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700660/extras/description_road.png?t=1749604335\" /></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">She doesn't know who this man is or where her father has gone.</p><p class=\"bb_paragraph\">Walk alongside her on this twisting, twisted path and see where it will lead her.</p><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700660/extras/tictactoe.gif?t=1749604335\" /></p>","developers":["TearyHand Studio"],"fullgame":{"appid":"3308870","name":"and Roger"},"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"},{"description":"Simulation","id":"28"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700660/81f597ee4867d3029210b3e0a7e2fe642d97c60d/header.jpg?t=1749604335","is_free":true,"linux_requirements":[],"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> macOS 10.15<br></li><li><strong>Processor:</strong> Apple M1 | intel Core M<br></li><li><strong>Memory:</strong> 8 MB RAM<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"},"movies":[{"highlight":true,"id":257130734,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257130734/movie480.mp4?t=1749451386","max":"http://video.akamai.steamstatic.com/store_trailers/257130734/movie_max.mp4?t=1749451386"},"name":"1st trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257130734/92caa4cfe73ac30c3f741db46ba46e7ae64c0719/movie_600x337.jpg?t=1749451386","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257130734/movie480_vp9.webm?t=1749451386","max":"http://video.akamai.steamstatic.com/store_trailers/257130734/movie_max_vp9.webm?t=17494513