s_ce4d740c72ba9af339ef14c9b967424518052fd7.1920x1080.jpg?t=1742475536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_ce4d740c72ba9af339ef14c9b967424518052fd7.600x338.jpg?t=1742475536"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_a3dfa28dd5538eef8d188f69243e82633cfc1697.1920x1080.jpg?t=1742475536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_a3dfa28dd5538eef8d188f69243e82633cfc1697.600x338.jpg?t=1742475536"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_6d464376cc3cc79d61db2727145c79a5c9ab9bd6.1920x1080.jpg?t=1742475536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_6d464376cc3cc79d61db2727145c79a5c9ab9bd6.600x338.jpg?t=1742475536"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_dc6f42b5d971441ad40b193c1e4aa0e7df1cfd94.1920x1080.jpg?t=1742475536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_dc6f42b5d971441ad40b193c1e4aa0e7df1cfd94.600x338.jpg?t=1742475536"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_812780deff7e757bb1e4ffc2170ad944fc4686ca.1920x1080.jpg?t=1742475536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_812780deff7e757bb1e4ffc2170ad944fc4686ca.600x338.jpg?t=1742475536"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_e4d50edac28472a64e1ee58f6310ceda43216dcb.1920x1080.jpg?t=1742475536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_e4d50edac28472a64e1ee58f6310ceda43216dcb.600x338.jpg?t=1742475536"},{"id":12,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_2225a01f0ba06a596b54527094df74b745e508a8.1920x1080.jpg?t=1742475536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_2225a01f0ba06a596b54527094df74b745e508a8.600x338.jpg?t=1742475536"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_be818c2b92bafb2e428d14dbbf8d73cd16938423.1920x1080.jpg?t=1742475536","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2464530/ss_be818c2b92bafb2e428d14dbbf8d73cd16938423.600x338.jpg?t=1742475536"}],"short_description":"Crafted by a solo developer, VOIN is a first-person hack-and-slash. Cleave through hordes of enemies in fast-paced combat. Explore dark fantasy realms filled with secrets and dangers. Discover powerful gear and weapons, and face menacing bosses in your quest to cleanse a broken world.","steam_appid":2464530,"support_info":{"email":"support@tinybuild.com","url":""},"supported_languages":"English, German, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Spain, French, Japanese, Korean, Polish, Ukrainian","type":"game","website":"https://www.vointhegame.com/"}