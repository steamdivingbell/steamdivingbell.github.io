tore_item_assets/steam/apps/3261050/51e3d3a5a730b458a40cda6f5cb53970d3812939/ss_51e3d3a5a730b458a40cda6f5cb53970d3812939.600x338.jpg?t=1770631984"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3261050/212ab7063a57076e62df73eafa6e7cae2fec88a7/ss_212ab7063a57076e62df73eafa6e7cae2fec88a7.1920x1080.jpg?t=1770631984","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3261050/212ab7063a57076e62df73eafa6e7cae2fec88a7/ss_212ab7063a57076e62df73eafa6e7cae2fec88a7.600x338.jpg?t=1770631984"}],"short_description":"Become a cardslinger in this roguelike deckbuilder with tactical elements. Fight, gather weapons and items, face unexpected events and upgrade your cards for hundreds of possibilities. Every run is unique and so are you, the best shot of the Far West looking for your upcoming revenge.","steam_appid":3261050,"support_info":{"email":"contact.hatsandguns@gmail.com","url":""},"supported_languages":"English, French","type":"game","website":null}