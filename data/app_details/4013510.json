/4013510/06e0517fc54500a3b9195e0459431361769aedc5/ss_06e0517fc54500a3b9195e0459431361769aedc5.600x338.jpg?t=1771515548"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4013510/5de1e10aedad6fe25c27a9c1178eb19dc1a44788/ss_5de1e10aedad6fe25c27a9c1178eb19dc1a44788.1920x1080.jpg?t=1771515548","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4013510/5de1e10aedad6fe25c27a9c1178eb19dc1a44788/ss_5de1e10aedad6fe25c27a9c1178eb19dc1a44788.600x338.jpg?t=1771515548"},{"id":10,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4013510/3444f164db27d199a7205d5c762626f86c6d518b/ss_3444f164db27d199a7205d5c762626f86c6d518b.1920x1080.jpg?t=1771515548","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4013510/3444f164db27d199a7205d5c762626f86c6d518b/ss_3444f164db27d199a7205d5c762626f86c6d518b.600x338.jpg?t=1771515548"}],"short_description":"Create unique creatures, use them to gather rare resources, and fuse them into even more powerful beings! This RPG combines classic exploration with a deep crafting system where your monsters are your ultimate tool for looting, combat, and discovery.","steam_appid":4013510,"support_info":{"email":"monsteralchemy@gmail.com","url":""},"supported_languages":"English, Spanish - Spain","type":"game","website":"https://discord.gg/CgdGgmdems"}