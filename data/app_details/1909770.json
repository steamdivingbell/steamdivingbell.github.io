/steam/apps/1909770/extras/183b692a48894b56f0a015c68a4a5e32.webm?t=1748990018\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/183b692a48894b56f0a015c68a4a5e32.mp4?t=1748990018\" type=\"video/mp4\"></video></span> <span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/1da8928ad01d65c8172f8a70e3ba969f.poster.avif?t=1748990018\" width=192 height=108 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/1da8928ad01d65c8172f8a70e3ba969f.webm?t=1748990018\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/1da8928ad01d65c8172f8a70e3ba969f.mp4?t=1748990018\" type=\"video/mp4\"></video></span><br>The higher you climb, the more difficult the &quot;targets&quot; become. tracking and holding aim, flicking aim,,<u>The thrill increases.</u><h2 class=\"bb_tag\" >If you happen to miss your aim, use the &quot;ascending skill&quot;. </h2><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/627aa89b9d6622790dc1df3ade5ccb1c.poster.avif?t=1748990018\" width=192 height=216 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/627aa89b9d6622790dc1df3ade5ccb1c.webm?t=1748990018\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/627aa89b9d6622790dc1df3ade5ccb1c.mp4?t=1748990018\" type=\"video/mp4\"></video></span> <span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/09becad5e56803a2a85244167eb3443a.poster.avif?t=1748990018\" width=192 height=216 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/09becad5e56803a2a85244167eb3443a.webm?t=1748990018\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/09becad5e56803a2a85244167eb3443a.mp4?t=1748990018\" type=\"video/mp4\"></video></span> <br><br>When the skill is used, the character <u>jumps slightly to buy time to adjust the aim.</u><br>This skill can also be <u>used effectively to increase the speed of ascent when you click on targets.</u> <strong>It is up to the player's discretion whether you can use it well or not.</strong><br><br><strong>\u25a0Three levels of difficulty</strong><br>There is a difficulty level for beginners who are not accustomed to mouse operation, a difficulty level for gamers who are accustomed to mouse operation, and a difficulty level for so-called masochistic gamers.<br>The highest difficulty level cannot be cleared with half-hearted determination.<br><br><strong>Cute dot pictures</strong><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/f7aa48ca4eb3f46047ba491ef4e66eb0.poster.avif?t=1748990018\" width=256 height=144 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/f7aa48ca4eb3f46047ba491ef4e66eb0.webm?t=1748990018\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/f7aa48ca4eb3f46047ba491ef4e66eb0.mp4?t=1748990018\" type=\"video/mp4\"></video></span>. <br><br><strong>\u25a0The scenery changes as you move up.</strong><br>Caves, forests, old cities, waterfalls, etc.<h2 class=\"bb_tag\" >Clearing the game involves a great deal of hard work. </h2><strong>However, let us guarantee an &quot;overwhelming sense of accomplishment&quot; for that.</strong><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/d1437266e65b103c1e0d6f9f49d7d31c.poster.avif?t=1748990018\" width=256 height=144 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/d1437266e65b103c1e0d6f9f49d7d31c.webm?t=1748990018\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/d1437266e65b103c1e0d6f9f49d7d31c.mp4?t=1748990018\" type=\"video/mp4\"></video></span>. <br><br><br><br>-Aim Climb-<br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/b742a5c6d0527468e6df991580a902a8.avif?t=1748990018\" width=442 height=248 /></span><br><i>In a dark, dark cave, there is a cat girl who dreams of the outside world.</i><h2 class=\"bb_tag\" >Your Aiming skill could change her fate.</h2>Your dominant hand, holding the PC mouse, becomes a &quot;magic gun&quot; that descends into her world to support her dreams.<br><br>You need to click on the magic stones scattered around to climb.<br>Clicking, climbing, clicking, climbing, clicking, climbing,,,,,,,,<br><br>And if you fail to aim, she falls.<br><br>No matter how many times she falls, she never gives up. Her eyes are always lit with glimmer of hope.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/13f802e7e7c145ca11caf0d41355ddba.poster.avif?t=1748990018\" width=256 height=144 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/13f802e7e7c145ca11caf0d41355ddba.webm?t=1748990018\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/13f802e7e7c145ca11caf0d41355ddba.mp4?t=1748990018\" type=\"video/mp4\"></video></span><br>Do you really see that? <br><br><strong>Can you take her to the outside world? And when you reach the top, what will the view be like?</strong><br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/extras/9799734ab78450ddec807da7fe2af4fe.avif?t=1748990018\" width=538 height=174 /></span>","developers":["YuLu"],"dlc":[1951100],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1909770/header.jpg?t=1748990018","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/1909770/443575/a8de6a2a0041a82822d669aea28487086dc0a2ae/1751046798/dash_av1.mpd?t=1646279287","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/1909770/443575/a8de6a2a0041a82822d669aea28487086dc0a2ae/1751046798/dash_h264.mpd?t=1646279287","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/1909770/443575/a8de6a2a0041a82822d669aea28487086dc0a2ae/1751046798/hls_264_master.m3u8?t=1646279287","id":256875918,"name":"aim climb","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256875918/movie.293x165.jpg?t=1646279287"}],"name":"Aim Climb","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"Aim Climb - $6.80 USD","packageid":687762,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":680}],"title":"Buy Aim Climb"}],"packages":[687762],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Processor:</strong> intel