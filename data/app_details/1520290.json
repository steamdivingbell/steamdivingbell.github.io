akamai.steamstatic.com/store_item_assets/steam/apps/1520290/63ccf46035a83b9b311b94edc48d6098418a7766/ss_63ccf46035a83b9b311b94edc48d6098418a7766.600x338.jpg?t=1745613080"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1520290/30966ef67a922af87b46ee6467e02f2ed0d0da38/ss_30966ef67a922af87b46ee6467e02f2ed0d0da38.1920x1080.jpg?t=1745613080","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1520290/30966ef67a922af87b46ee6467e02f2ed0d0da38/ss_30966ef67a922af87b46ee6467e02f2ed0d0da38.600x338.jpg?t=1745613080"}],"short_description":"Become a giant dinosaur and flatten entire cities before the City Defenders can stop you! Crumbling City is chaos and fun in a physics based destructible world. Rampage across cities as a colossal dinosaur and leave nothing standing! Nature\u2019s revenge has never been this fun!","steam_appid":1520290,"support_info":{"email":"daisygames.company@gmail.com","url":"http://daisygames.org/crumbling-city/support"},"supported_languages":"English, French, Italian, Bulgarian, Danish, Dutch, Japanese, Korean, Turkish","type":"game","website":"http://daisygames.org/crumbling-city"}