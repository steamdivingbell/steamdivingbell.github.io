3335430/extras/puzzling.gif?t=1746012709\" /></p>","developers":["MadMoa"],"fullgame":{"appid":"2500690","name":"Dumbriel: Magnificent Adventure in Hell"},"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3335430/0d9eb4d1ea21411876857b6883cce6db80fc5d2f/header.jpg?t=1746012709","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257127444,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127444/movie480.mp4?t=1746010504","max":"http://video.akamai.steamstatic.com/store_trailers/257127444/movie_max.mp4?t=1746010504"},"name":"Short Gameplay ","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257127444/cc0bc386f124ad21bc753efa297c7d8350e6efad/movie_600x337.jpg?t=1746010504","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257127444/movie480_vp9.webm?t=1746010504","max":"http://video.akamai.steamstatic.com/store_trailers/257127444/movie_max_vp9.webm?t=1746010504"}}],"name":"Dumbriel: Magnificent Adventure in Hell Demo","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> AMD Ryzen 3 | Intel i5 5th gen<br></li><li><strong>Memory:</strong> 12 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia GTX 1070 | AMD RX 570<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> AMD Ryzen 5 | Intel i7 7th gen<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia RTX 2070 | AMD Radeon 5700 XT<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>S