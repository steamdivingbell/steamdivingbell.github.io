//shared.akamai.steamstatic.com/store_item_assets/steam/apps/3528640/ss_7d94f61aaa0c107b43e8d01e95d0c50a0e45aa3e.600x338.jpg?t=1741682492"},{"id":11,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3528640/ss_50a51d1e39287b44ae341eaac6158b6546e5b0dc.1920x1080.jpg?t=1741682492","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3528640/ss_50a51d1e39287b44ae341eaac6158b6546e5b0dc.600x338.jpg?t=1741682492"}],"short_description":"The Valley is in trouble! It's infected by thrown out batteries. Plants are endangered by poisoned soil and hungry bugs munching on every leaf or branch they can find. Only young Plant Spirit can find the source of the harm. Fight bugs, collect and plant new seeds and seek allies to save the Valley!","steam_appid":3528640,"support_info":{"email":"greenrevivalgame@gmail.com","url":""},"supported_languages":"English, Russian","type":"game","website":null}