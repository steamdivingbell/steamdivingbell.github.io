elements","rating":"t"},"steam_germany":{"banned":"0","descriptors":"Gewalt","rating":"12","rating_generated":"1","required_age":"12","use_age_gate":"0"}},"recommendations":{"total":153},"release_date":{"coming_soon":false,"date":"4 Apr, 2025"},"required_age":0,"reviews":"\u201cIt was a remarkable game, and more remarkably still, its developers Holistic Design Inc. recently updated it with a major patch, 25 years after its original release.\u201d<br>Rock Paper Shotgun<br><br>\u201cEmperor of the Fading Suns radically changes the standard formula in several ways, so much so that there really isn\u2019t anything else like it today.\u201d<br>Strategy Front Gaming<br><br>\u201cEmperor of the Fading Suns does something that is getting increasingly hard to accomplish: It breathes life into the stagnating and repetitive genre of space-conquest games.\u201d<br>Gamespot<br>","screenshots":[{"id":0,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2799350/ss_ae76c35383738f3e0b3578c4a7c46b053b780c51.1920x1080.jpg?t=1767929691","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2799350/ss_ae76c35383738f3e0b3578c4a7c46b053b780c51.600x338.jpg?t=1767929691"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2799350/ss_d165928ee6d4e7a61d78bce32f1cc5e990bfb8da.1920x1080.jpg?t=1767929691","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2799350/ss_d165928ee6d4e7a61d78bce32f1cc5e990bfb8da.600x338.jpg?t=1767929691"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2799350/ss_2961ade0c7053be46fa6986c4b5f2a2c1fb07d85.1920x1080.jpg?t=1767929691","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2799350/ss_2961ade0c7053be46fa6986c4b5f2a2c1fb07d85.600x338.jpg?t=1767929691"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2799350/ss_b413009ece4