i.steamstatic.com/store_item_assets/steam/apps/3668060/4e536ad34f5e051cf74626a027e30a935d9d392e/ss_4e536ad34f5e051cf74626a027e30a935d9d392e.1920x1080.jpg?t=1753720666","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3668060/4e536ad34f5e051cf74626a027e30a935d9d392e/ss_4e536ad34f5e051cf74626a027e30a935d9d392e.600x338.jpg?t=1753720666"}],"short_description":"Strategic auto battler where you design a heavily-armed spaceship. Draft 200+ items, outfit your hull, and unleash it in async PvP. Blend captains and factions for absurd combos and galactic domination. Roll, buy, place, pray.","steam_appid":3668060,"support_info":{"email":"dev@ironanchorgames.com","url":""},"supported_languages":"English<strong>*</strong>, French, German, Simplified Chinese<br><strong>*</strong>languages with full audio support","type":"demo","website":"https://ironanchorgames.com"}