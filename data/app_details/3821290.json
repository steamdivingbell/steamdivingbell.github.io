d.akamai.steamstatic.com/store_item_assets/steam/apps/3821290/35892cf1ed1e36247714c4f8706ce19cb3421b82/ss_35892cf1ed1e36247714c4f8706ce19cb3421b82.1920x1080.jpg?t=1770488452","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3821290/35892cf1ed1e36247714c4f8706ce19cb3421b82/ss_35892cf1ed1e36247714c4f8706ce19cb3421b82.600x338.jpg?t=1770488452"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3821290/50d8c608cde79fb1d01628eb6a4384e70ef81e17/ss_50d8c608cde79fb1d01628eb6a4384e70ef81e17.1920x1080.jpg?t=1770488452","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3821290/50d8c608cde79fb1d01628eb6a4384e70ef81e17/ss_50d8c608cde79fb1d01628eb6a4384e70ef81e17.600x338.jpg?t=1770488452"},{"id":9,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3821290/af4d8c6e0389d553c3757ce2d0159da1d36f09bb/ss_af4d8c6e0389d553c3757ce2d0159da1d36f09bb.1920x1080.jpg?t=1770488452","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3821290/af4d8c6e0389d553c3757ce2d0159da1d36f09bb/ss_af4d8c6e0389d553c3757ce2d0159da1d36f09bb.600x338.jpg?t=1770488452"}],"short_description":"\u300aChain Letter\u300b is a grid-based control roguelite defense game. Unlock and combine friend skills with unique commands to build your own setup and hold back the oncoming demons.","steam_appid":3821290,"support_info":{"email":"tjddnsla1123@naver.com","url":"https://blog.naver.com/tjddnsla1123"},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese, Korean, French, German, Spanish - Spain, Portuguese - Brazil, Russian, Spanish - Latin America","type":"game","website":null}