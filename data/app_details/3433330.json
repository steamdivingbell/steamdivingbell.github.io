nd elements to conquer your foes.","steam_appid":3433330,"support_info":{"email":"support@clockdrivegames.com","url":""},"supported_languages":"English<strong>*</strong>, Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}