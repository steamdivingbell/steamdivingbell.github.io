tore_trailers/3273530/1697959798/ebe3f0576239331d13c6f1a4b2bc81507be010ca/1759812811/hls_264_master.m3u8?t=1759814394","id":257213347,"name":"1998: The Toll Keeper Story - Release Date Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257213347/064e62432f38021fe85c86261206031b1160d900/movie_600x337.jpg?t=1759814394"}],"name":"1998: The Toll Keeper Story","package_groups":[{"description":"","display_type":0,"is_recurring_subscription":"false","name":"default","save_text":"","selection_text":"Select a purchase option","subs":[{"can_get_free_license":"0","is_free_license":false,"option_description":"","option_text":"1998: The Toll Keeper Story - $11.99 USD","packageid":1159775,"percent_savings":0,"percent_savings_text":" ","price_in_cents_with_discount":1199}],"title":"Buy 1998: The Toll Keeper Story"}],"packages":[1159775],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS *:</strong> Windows 7 (SP1+), Windows 10 and Windows 11<br></li><li><strong>Processor:</strong> x86, x64 architecture with SSE2 instruction set support.<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> DX10, DX11, DX12 capable.<br></li><li><strong>Storage:</strong> 3 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"price_overview":{"currency":"USD","discount_percent":0,"final":1199,"final_formatted":"$11.99 USD","initial":1199,"initial_formatted":""},"publishers":["GameChanger Studio","CC_Games"],"ratings":{"dejus":{"banned":"0","descriptors":"Viol\u00eancia fantasiosa","rating":"l","rating_generated":"1","required_age":"0","use_age_gate":"0"},"igrs":{"banned":"0","descriptors":"Kekerasan","rating":"13","rating_generated":"1","required_age":"13","use_age_ga