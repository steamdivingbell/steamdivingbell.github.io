tatic.com/store_item_assets/steam/apps/3607840/1e5330b268762a587ddfdeb1921c9697fc525ffd/ss_1e5330b268762a587ddfdeb1921c9697fc525ffd.600x338.jpg?t=1745199473"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3607840/0f4a2c404aa9f4b68563bd9b0399bac085ba27f8/ss_0f4a2c404aa9f4b68563bd9b0399bac085ba27f8.1920x1080.jpg?t=1745199473","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3607840/0f4a2c404aa9f4b68563bd9b0399bac085ba27f8/ss_0f4a2c404aa9f4b68563bd9b0399bac085ba27f8.600x338.jpg?t=1745199473"}],"short_description":"TASU Bowl is a casual deck-building game that mixes bowling with roguelike elements. Use balls, pins, score frames, and items\u2014each with unique effects\u2014to take control of the game. It\u2019s not just about strikes and spares\u2014enjoy a whole new kind of bowling experience!","steam_appid":3607840,"support_info":{"email":"steam-info@kayac.com","url":""},"supported_languages":"English, Japanese","type":"game","website":null}