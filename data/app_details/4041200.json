8b71f764334529c1c52c055633fcae0e.600x338.jpg?t=1760374423"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4041200/0ef4d3b62777754f9c9b9e5eba04f55078fdc6bb/ss_0ef4d3b62777754f9c9b9e5eba04f55078fdc6bb.1920x1080.jpg?t=1760374423","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4041200/0ef4d3b62777754f9c9b9e5eba04f55078fdc6bb/ss_0ef4d3b62777754f9c9b9e5eba04f55078fdc6bb.600x338.jpg?t=1760374423"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4041200/01de68b03f3e79945be8f1142e6e366e838b611c/ss_01de68b03f3e79945be8f1142e6e366e838b611c.1920x1080.jpg?t=1760374423","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4041200/01de68b03f3e79945be8f1142e6e366e838b611c/ss_01de68b03f3e79945be8f1142e6e366e838b611c.600x338.jpg?t=1760374423"}],"short_description":"A genre-bending RPG inspired by the classic Paper Mario games! When a greedy megacorp from the real world starts taking over fairytales for their cheap labor, a newly-hired storybook hero must climb the corporate ladder, rally together other disgruntled employees, and fight back!","steam_appid":4041200,"support_info":{"email":"lw@hypetraindigital.com","url":""},"supported_languages":"English, Japanese, Russian, Portuguese - Brazil, Simplified Chinese","type":"demo","website":null}