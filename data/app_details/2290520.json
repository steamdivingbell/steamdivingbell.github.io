9f45b86e6bb5d734c722.1920x1080.jpg?t=1740780316","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2290520/ss_ea751c3041e88a6e3fcf9f45b86e6bb5d734c722.600x338.jpg?t=1740780316"}],"short_description":"Sneaky Pirates is a fast-paced online multiplayer social deduction game for 4 players. Hide among ships, steal from rivals, and use power-ups to escape or fight back. Play it safe or go all-in\u2014no winner is safe until the last second! Customize your ship and be the king of pirates! \ud83c\udff4\u200d\u2620\ufe0f","steam_appid":2290520,"support_info":{"email":"kotgminfo@gmail.com","url":""},"supported_languages":"English, Spanish - Spain","type":"game","website":null}