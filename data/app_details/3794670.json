ssets/steam/apps/3794670/32f7571dabab451d20ac75494caf75868e9b0501/ss_32f7571dabab451d20ac75494caf75868e9b0501.600x338.jpg?t=1774513448"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3794670/384561df379098618bf9f09a256aef06984b0335/ss_384561df379098618bf9f09a256aef06984b0335.1920x1080.jpg?t=1774513448","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3794670/384561df379098618bf9f09a256aef06984b0335/ss_384561df379098618bf9f09a256aef06984b0335.600x338.jpg?t=1774513448"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3794670/8f7a2e4effe3ce61bdb0c50faa48f1b1a3e194b5/ss_8f7a2e4effe3ce61bdb0c50faa48f1b1a3e194b5.1920x1080.jpg?t=1774513448","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3794670/8f7a2e4effe3ce61bdb0c50faa48f1b1a3e194b5/ss_8f7a2e4effe3ce61bdb0c50faa48f1b1a3e194b5.600x338.jpg?t=1774513448"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3794670/f652445ff8e2d5853ecea088c291d86056e50b84/ss_f652445ff8e2d5853ecea088c291d86056e50b84.1920x1080.jpg?t=1774513448","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3794670/f652445ff8e2d5853ecea088c291d86056e50b84/ss_f652445ff8e2d5853ecea088c291d86056e50b84.600x338.jpg?t=1774513448"}],"short_description":"tar Fire is a hand-drawn 2D boss rush bullet hell. You control the cat\u2011eared girl Eira as she ventures into the Star Compass, dodging, jumping, and weaving through bullets in stylish 1v1 duels against guardians trapped by what they cannot let go. Will she find what she\u2019s looking for?","steam_appid":3794670,"support_info":{"email":"243619756@qq.com","url":""},"supported_languages":"English, Simplified Chinese, French, Italian, German, Spanish - Spain, Russian, Japanese, Polish, Traditional Chinese, Portuguese - Brazil, Portuguese - Portugal, Spanish - Latin America, Korean, Indonesian, Thai, Vietnamese","type":"game","website":null}