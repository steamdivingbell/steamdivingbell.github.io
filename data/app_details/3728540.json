338.jpg?t=1772514194"},{"id":13,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728540/c39d2f2484cdc25e4cf8c01734c2f09cde0f35b7/ss_c39d2f2484cdc25e4cf8c01734c2f09cde0f35b7.1920x1080.jpg?t=1772514194","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3728540/c39d2f2484cdc25e4cf8c01734c2f09cde0f35b7/ss_c39d2f2484cdc25e4cf8c01734c2f09cde0f35b7.600x338.jpg?t=1772514194"}],"short_description":"&lt;The High Tower&gt; is a third-person, action-adventure game set in a post-apocalyptic world. After a global catastrophe, humanity builds a sky-piercing megastructure in search of hope. As the chosen one of the Church, you must ascend the tower, uncover hidden truths.","steam_appid":3728540,"support_info":{"email":"zhang_frank@hotmail.com","url":""},"supported_languages":"English, Simplified Chinese, German, Japanese, Traditional Chinese","type":"game","website":null}