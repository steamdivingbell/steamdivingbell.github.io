lass=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104410/extras/PURGE_-CRASH_-RERUN.png?t=1740710417\" /></h2><p class=\"bb_paragraph\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104410/extras/PURGE__CRASH__RERUN.gif?t=1740710417\" />\u25cf\u00a0No single run is the same. Create endless possible builds with each run.</p><p class=\"bb_paragraph\">\u25cf\u00a0The end is only the beginning. With every victory or defeat, you not only gain new insights, but also become progressively stronger.</p><p class=\"bb_paragraph\">\u25cf\u00a0Collect loot by the end of each dive to craft powerful new weapons and mods.</p>","developers":["Pew Pew Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"RPG","id":"3"},{"description":"Free To Play","id":"37"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3104410/1c70963ca7b21191c8c553323f505021dca3f7a5/header.jpg?t=1740710417","is_free":true,"linux_requirements":[],"mac_requirements":[],"movies":[{"highlight":true,"id":257107520,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257107520/movie480.mp4?t=1740625474","max":"http://video.akamai.steamstatic.com/store_trailers/257107520/movie_max.mp4?t=1740625474"},"name":"March Beta Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257107520/64182315de3f5bdbf441d0806879084e55751b28/movie_600x337.jpg?t=1740625474","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257107520/movie480_vp9.webm?t=1740625474","max":"http://video.akamai.steamstatic.com/store_trailers/257107520/movie_max_vp9.webm?t=1740625474"}}],"name":"Terminull Brigade\u2122","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10\uff0864bit\uff09<br></li><li><strong>Processor:</strong> Intel(R) Core(TM)