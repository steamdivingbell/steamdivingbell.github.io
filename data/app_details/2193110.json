bbca12add13.poster.avif?t=1759846486\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193110/extras/aba793259fe9ff1801ff8bbca12add13.webm?t=1759846486\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193110/extras/aba793259fe9ff1801ff8bbca12add13.mp4?t=1759846486\" type=\"video/mp4\"></video></span><br><br><br>Build your defenses and Repair your buildings to recapture the station.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193110/extras/8b1d2df77952986c53b5c54bb48a9eb1.poster.avif?t=1759846486\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193110/extras/8b1d2df77952986c53b5c54bb48a9eb1.webm?t=1759846486\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193110/extras/8b1d2df77952986c53b5c54bb48a9eb1.mp4?t=1759846486\" type=\"video/mp4\"></video></span><br><br><br>Construct, Rally, and Deploy your army of robots to fend off monster waves.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193110/extras/c7b4e119c34c3e99681f7ae732112254.poster.avif?t=1759846486\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193110/extras/c7b4e119c34c3e99681f7ae732112254.webm?t=1759846486\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193110/extras/c7b4e119c34c3e99681f7ae732112254.mp4?t=1759846486\" type=\"video/mp4\"></video></span><br><br><br>Locate and hunt down monster hives to finally rid the station of their control.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" au