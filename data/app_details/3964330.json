bm?t=1769242328\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3964330/extras/a6409f115248eac7f50f293e49ae911b.mp4?t=1769242328\" type=\"video/mp4\"></video></span></p>","developers":["KUKUKU GAMES"],"genres":[{"description":"Action","id":"1"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3964330/524f820ff405eaf5cce35f816e9deaacadc6530f/header.jpg?t=1769242328","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/3964330/635774470/4f90b466890bd07dde85d9c1bae62b2474ac3f86/1768976511/dash_av1.mpd?t=1768977257","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/3964330/635774470/4f90b466890bd07dde85d9c1bae62b2474ac3f86/1768976511/dash_h264.mpd?t=1768977257","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/3964330/635774470/4f90b466890bd07dde85d9c1bae62b2474ac3f86/1768976511/hls_264_master.m3u8?t=1768977257","id":257208342,"name":"Gameplay Teaser","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257208342/f9c4267ff9aaadf115e65fcb8fc3450f7293df1a/movie_600x337.jpg?t=1768977257"}],"name":"WALTO","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 64-bit<br></li><li><strong>Processor:</strong> Intel i3-6100 / AMD Ryzen 3 1200<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 750 Ti / AMD Radeon RX 460<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 4 GB available space<br></li><li><strong>Sound Card:</strong> DirectX compatible<br></li><li><strong>Additional Notes:</strong> Keyboard and mouse only (no controller support)</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>O