73814816cead73514da1/ss_3fbd4a070bf68103bab373814816cead73514da1.1920x1080.jpg?t=1771575393","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3606750/3fbd4a070bf68103bab373814816cead73514da1/ss_3fbd4a070bf68103bab373814816cead73514da1.600x338.jpg?t=1771575393"},{"id":8,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3606750/69b6163204f3996b02c1abb8f45a37f30cc6a843/ss_69b6163204f3996b02c1abb8f45a37f30cc6a843.1920x1080.jpg?t=1771575393","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3606750/69b6163204f3996b02c1abb8f45a37f30cc6a843/ss_69b6163204f3996b02c1abb8f45a37f30cc6a843.600x338.jpg?t=1771575393"}],"short_description":"In this turn-based RPG, play as Remuria, a kind-hearted succubus, who teams up with the half-elf Ariandelle in their shared goal to save the succubi village and free enslaved elves. It's a tale of tender friendship, personal growth, and passion set in a captivating, dark fantasy world.","steam_appid":3606750,"support_info":{"email":"","url":"https://saikeystudios.com"},"supported_languages":"English, Japanese, Simplified Chinese, Traditional Chinese","type":"game","website":"https://saikeystudios.com"}