:5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937070/2fe9b2fd7777dc8a6f43adc1c762d3f3b0f33500/ss_2fe9b2fd7777dc8a6f43adc1c762d3f3b0f33500.1920x1080.jpg?t=1771104773","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1937070/2fe9b2fd7777dc8a6f43adc1c762d3f3b0f33500/ss_2fe9b2fd7777dc8a6f43adc1c762d3f3b0f33500.600x338.jpg?t=1771104773"}],"short_description":"Engines of Destruction is a mech simulator. Take on the role of pilot, create your own custom mechs, fight in PvP or PvE battles, and control a fully interactive cockpit in VR or on desktop.","steam_appid":1937070,"support_info":{"email":"contactenginesofdestruction@gmail.com","url":"https://enginesofdestruction.com/"},"supported_languages":"English<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}