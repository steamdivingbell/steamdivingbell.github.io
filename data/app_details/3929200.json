456/ss_24cfffa4ee9cfbea90569dc269bf8b4c757b1456.600x338.jpg?t=1761722533"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929200/0e19cbfdbe171c60bd049e70f75df0c52a3a4775/ss_0e19cbfdbe171c60bd049e70f75df0c52a3a4775.1920x1080.jpg?t=1761722533","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3929200/0e19cbfdbe171c60bd049e70f75df0c52a3a4775/ss_0e19cbfdbe171c60bd049e70f75df0c52a3a4775.600x338.jpg?t=1761722533"}],"short_description":"Realistic waterfowl hunting simulator. Calls, decoys, a boat, and your hunting skills \u2014 everything you need to track down your prey in open hunting grounds. Feel the thrill of real hunting without leaving your home.","steam_appid":3929200,"support_info":{"email":"games@yaknet.com","url":""},"supported_languages":"English, French, German, Spanish - Spain, Simplified Chinese, Portuguese - Brazil, Russian","type":"game","website":null}