ec34d6590a2d4.webm?t=1771858064\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3046020/extras/770ca05354ad0af7e82ec34d6590a2d4.mp4?t=1771858064\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Unlimited combinations</strong></h2><p class=\"bb_paragraph\" >Fight across 10 different maps using your towers, enchants, spells, and artifacts in order to succeed. With over 50 artifacts, 100+ cards, and a combined total of 18 tier levels of towers, what synergies can you find?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3046020/extras/0e25c608919aeb27ce4f32989b3f3145.poster.avif?t=1771858064\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3046020/extras/0e25c608919aeb27ce4f32989b3f3145.webm?t=1771858064\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3046020/extras/0e25c608919aeb27ce4f32989b3f3145.mp4?t=1771858064\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >  </p><p class=\"bb_paragraph\" ></p>","background":"https://store.akamai.steamstatic.com/images/storepagebackground/app/3046020?t=1771858064","background_raw":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3046020/page_bg_raw.jpg?t=1771858064","capsule_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3046020/f06667e00f2ea96bdb64644357d8ce655bdbfd82/capsule_231x87.jpg?t=1771858064","capsule_imagev5":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3046020/f06667e00f2ea96bdb64644357d8ce655bdbfd82/capsule_184x69.jpg?t=1771858064","categories":[{"description":"Single-player","id":2},{"description":"Family Sharing","id":62}],