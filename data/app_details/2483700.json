g></h2><p class=\"bb_paragraph\" >If you seek pure combat and strategy beyond the story, challenge yourself in the Dimensional Rift mode.</p><p class=\"bb_paragraph\" >In this endlessly replayable mode, you will face relentless battles without cinematic storytelling.</p><p class=\"bb_paragraph\" >Take on ever-changing challenges and push your limits to the extreme.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2483700/extras/6cb4a57cfe06c43269063cdb53f6ef09.poster.webp?t=1755832461\" media=\"(prefers-reduced-motion: reduce)\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2483700/extras/6cb4a57cfe06c43269063cdb53f6ef09.webp?t=1755832461\" class=\"bb_img\" width=640 height=360 /></picture></span></p>","developers":["INDIRECT SHINE"],"genres":[{"description":"Indie","id":"23"},{"description":"Strategy","id":"2"},{"description":"Early Access","id":"70"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2483700/a47cd60278208c11f6b8face0a68e6c040e5065f/header.jpg?t=1755832461","is_free":false,"linux_requirements":[],"mac_requirements":[],"movies":[{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2483700/1208362135/b3799672492f0ba96a894436cf7071740bf7e85e/1750765089/dash_av1.mpd?t=1750780885","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2483700/1208362135/b3799672492f0ba96a894436cf7071740bf7e85e/1750765089/dash_h264.mpd?t=1750780885","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2483700/1208362135/b3799672492f0ba96a894436cf7071740bf7e85e/1750765089/hls_264_master.m3u8?t=1750780885","id":257160665,"mp4":{"480":"https://video.akamai.steamstatic.com/store_trailers/257160665/movie480.mp4?t=1750780885","max":"https://video.akamai.steamstatic.com/store_trailers/257160665/movie_max.mp4?t=1750780885"},"name":"Anno