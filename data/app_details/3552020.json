ic.com/store_item_assets/steam/apps/3552020/b43c7e4d1b815fa17ef7ae6bbb3b44abe61a7dae/ss_b43c7e4d1b815fa17ef7ae6bbb3b44abe61a7dae.1920x1080.jpg?t=1772744162","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/b43c7e4d1b815fa17ef7ae6bbb3b44abe61a7dae/ss_b43c7e4d1b815fa17ef7ae6bbb3b44abe61a7dae.600x338.jpg?t=1772744162"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/b3717043b573c6ed8405e29f946628d785fe45dc/ss_b3717043b573c6ed8405e29f946628d785fe45dc.1920x1080.jpg?t=1772744162","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/b3717043b573c6ed8405e29f946628d785fe45dc/ss_b3717043b573c6ed8405e29f946628d785fe45dc.600x338.jpg?t=1772744162"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/e6d4fbdf363fe99722dd5169d808d3cc2665de65/ss_e6d4fbdf363fe99722dd5169d808d3cc2665de65.1920x1080.jpg?t=1772744162","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/e6d4fbdf363fe99722dd5169d808d3cc2665de65/ss_e6d4fbdf363fe99722dd5169d808d3cc2665de65.600x338.jpg?t=1772744162"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/dc4c9737757175b94cf39d4456f0682e4f5fd954/ss_dc4c9737757175b94cf39d4456f0682e4f5fd954.1920x1080.jpg?t=1772744162","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/dc4c9737757175b94cf39d4456f0682e4f5fd954/ss_dc4c9737757175b94cf39d4456f0682e4f5fd954.600x338.jpg?t=1772744162"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/f8f260202107f43e1aa854c737f56024ff9b49ab/ss_f8f260202107f43e1aa854c737f56024ff9b49ab.1920x1080.jpg?t=1772744162","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/f8f260202107f43e1aa854c737f56024ff9b49ab/ss_f8f260202107f43e1aa854c737f56024ff9b49ab.600x338.jpg?t=1772744162"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/88639276f034df6f5179a4f8fd4c70fe747d102f/ss_88639276f034df6f5179a4f8fd4c70fe747d102f.1920x1080.jpg?t=1772744162","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3552020/88639276f034df6f5179a4f8fd4c70fe747d102f/ss_88639276f034df6f5179a4f8fd4c70fe747d102f.600x338.jpg?t=1772744162"}],"short_description":"You enter the most dangerous court in the Empire to uncover the truth of your fallen noble lineage, not to fall in love. In this manhwa-inspired dark fantasy romance, the men behind the princely masks are nothing like what they appear. And by the end, neither are you.","steam_appid":3552020,"support_info":{"email":"smallserenity@gmail.com","url":""},"supported_languages":"English","type":"game","website":"https://fatesmasquerade.carrd.co/"}