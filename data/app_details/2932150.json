ef - Turning Tides into Systems","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257265321/a11d99c4949961713de078df063b3c29bf40eea0/movie_600x337.jpg?t=1768492312"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2932150/44120605/02c42f680566d85f7ddaa4a2e10cce599f8b5977/1755695149/dash_av1.mpd?t=1755698339","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2932150/44120605/02c42f680566d85f7ddaa4a2e10cce599f8b5977/1755695149/dash_h264.mpd?t=1755698339","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2932150/44120605/02c42f680566d85f7ddaa4a2e10cce599f8b5977/1755695149/hls_264_master.m3u8?t=1755698339","id":257186034,"name":"Gameplay Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257186034/9e56fb61d91d5bc6c1fb029bd4ebbaf818622ebe/movie_600x337.jpg?t=1755698339"},{"dash_av1":"https://video.akamai.steamstatic.com/store_trailers/2932150/619095983/191f4b35c76bae70c0435623619a7e968e3607f7/1750890033/dash_av1.mpd?t=1748430106","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/2932150/619095983/191f4b35c76bae70c0435623619a7e968e3607f7/1750890033/dash_h264.mpd?t=1748430106","highlight":true,"hls_h264":"https://video.akamai.steamstatic.com/store_trailers/2932150/619095983/191f4b35c76bae70c0435623619a7e968e3607f7/1750890033/hls_264_master.m3u8?t=1748430106","id":257147075,"name":"Developer Introduction","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257147075/a90ff91971b5bfa5d5dd0f519ca420af98459fed/movie_600x337.jpg?t=1748430106"}],"name":"Life Below","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Additional Notes:</strong> TBC</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>Additional Notes:</strong> TBC</li></ul>"},"platforms":{"linux":false,"mac":false,"windows":true},"publishers":["Kas