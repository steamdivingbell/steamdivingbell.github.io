15128cef110747bd43501c99395aece1b51/ss_8d1c415128cef110747bd43501c99395aece1b51.600x338.jpg?t=1773826323"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4098930/bf71c6beaf20bde8cb3062a84d2e3bdfa3cc5673/ss_bf71c6beaf20bde8cb3062a84d2e3bdfa3cc5673.1920x1080.jpg?t=1773826323","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4098930/bf71c6beaf20bde8cb3062a84d2e3bdfa3cc5673/ss_bf71c6beaf20bde8cb3062a84d2e3bdfa3cc5673.600x338.jpg?t=1773826323"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4098930/8d5d525fb8d280f073f103771c11d593780bd87c/ss_8d5d525fb8d280f073f103771c11d593780bd87c.1920x1080.jpg?t=1773826323","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4098930/8d5d525fb8d280f073f103771c11d593780bd87c/ss_8d5d525fb8d280f073f103771c11d593780bd87c.600x338.jpg?t=1773826323"}],"short_description":"Craft your own weapons and carve your path in this fast-paced 3D roguelike action game. Defeat enemies, collect materials, and build powerful gear as you progress through a node-based world. Every run is a new challenge with randomized skills and endless crafting possibilities.","steam_appid":4098930,"support_info":{"email":"chronocrafter.alpha@gmail.com","url":""},"supported_languages":"Japanese","type":"game","website":null}