nail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3784610/c7de0c9039b6fc450921cdce19c404d3b17a39c6/ss_c7de0c9039b6fc450921cdce19c404d3b17a39c6.600x338.jpg?t=1774448948"},{"id":6,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3784610/be9770d93b499093d1b939c22e816491f56ea46b/ss_be9770d93b499093d1b939c22e816491f56ea46b.1920x1080.jpg?t=1774448948","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3784610/be9770d93b499093d1b939c22e816491f56ea46b/ss_be9770d93b499093d1b939c22e816491f56ea46b.600x338.jpg?t=1774448948"},{"id":7,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3784610/d38207526e9ef9d990eb5d6108fb030336cf356c/ss_d38207526e9ef9d990eb5d6108fb030336cf356c.1920x1080.jpg?t=1774448948","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3784610/d38207526e9ef9d990eb5d6108fb030336cf356c/ss_d38207526e9ef9d990eb5d6108fb030336cf356c.600x338.jpg?t=1774448948"}],"short_description":"Guide two troubled mages through a civil war-torn 12th-century England in this spellcasting RPG. Forge spells by combining conduits, trade favours with lords and serfs, watch the motions of the planets and keep your Humours in check as you help them find their purpose.","steam_appid":3784610,"support_info":{"email":"maypolegames@gmail.com","url":""},"supported_languages":"English<strong>*</strong>, Turkish<strong>*</strong><br><strong>*</strong>languages with full audio support","type":"game","website":null}