 and animations</p><p class=\"bb_paragraph\">\u25c6Free to build the island</p><p class=\"bb_paragraph\">\u25c6Hire workers to work for you</p><p class=\"bb_paragraph\">\u25c6Automate your workflow to increase your idle income</p><p class=\"bb_paragraph\">\u25c6Build your dream city on a deserted island</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">\u3010More\u3011</p><p class=\"bb_paragraph\">And..... more to come</p>","developers":[" RedboyGames"],"genres":[{"description":"Action","id":"1"},{"description":"Casual","id":"4"},{"description":"Indie","id":"23"},{"description":"RPG","id":"3"},{"description":"Simulation","id":"28"},{"description":"Strategy","id":"2"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3332040/header.jpg?t=1743991464","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257099564,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257099564/movie480.mp4?t=1739863824","max":"http://video.akamai.steamstatic.com/store_trailers/257099564/movie_max.mp4?t=1739863824"},"name":"V6","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257099564/fd5e89336533d81ffdffcb04ac9037a4e3c10139/movie_600x337.jpg?t=1739863824","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257099564/movie480_vp9.webm?t=1739863824","max":"http://video.akamai.steamstatic.com/store_trailers/257099564/movie_max_vp9.webm?t=1739863824"}}],"name":"Mushroom Island","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Win 10/11<br></