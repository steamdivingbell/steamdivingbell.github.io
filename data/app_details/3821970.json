7ee1e5004ffedcbd706728d3d6fce19ae/ss_7e9f13d7ee1e5004ffedcbd706728d3d6fce19ae.1920x1080.jpg?t=1768327045","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3821970/7e9f13d7ee1e5004ffedcbd706728d3d6fce19ae/ss_7e9f13d7ee1e5004ffedcbd706728d3d6fce19ae.600x338.jpg?t=1768327045"}],"short_description":"MOULD is an action shooter that tells the story of an unfulfilled Soviet dream. The Earth is gradually becoming uninhabitable, humanity is no longer there, and its place is taken by a monstrous life form capable of surviving in the planet's new conditions.","steam_appid":3821970,"support_info":{"email":"lsdifeatflow@gmail.com","url":""},"supported_languages":"English, Russian, Armenian","type":"game","website":null}