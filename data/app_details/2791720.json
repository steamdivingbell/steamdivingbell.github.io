m\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2791720/extras/d61635b04c93b11bac39d3c9cd4b5185.mp4?t=1753120213\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Too long without heat, and the cold kills you.</p><p class=\"bb_paragraph\">Out here, there are no second chances.</p><p class=\"bb_paragraph\">So\u2026 </p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2791720/extras/11f758d091449582b6937721ac734cbf.poster.avif?t=1753120213\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2791720/extras/11f758d091449582b6937721ac734cbf.webm?t=1753120213\" type=\"video/webm\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2791720/extras/11f758d091449582b6937721ac734cbf.mp4?t=1753120213\" type=\"video/mp4\"></video></div></p><h2 class=\"bb_tag\">What to expect</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">15\u201360 minutes (or longer, if you struggle to survive).</p></li><li><p class=\"bb_paragraph\">Voice acting.</p></li><li><p class=\"bb_paragraph\">No save points.</p></li><li><p class=\"bb_paragraph\">Reacts to real-life microphone input.</p></li><li><p class=\"bb_paragraph\">May contain jumpscares.</p></li></ul>","developers":["Mounpeak Games"],"genres":[{"description":"Action","id":"1"},{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2791720/9e737399bb30767c7a6bcb3b006cf40dffa718d7/header.jpg?t=1753120213","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","