aphics</p></li><li><p class=\"bb_paragraph\">A compelling experience with fear</p></li></ul>","developers":["Ember Wing Games"],"genres":[{"description":"Adventure","id":"25"},{"description":"Indie","id":"23"}],"header_image":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3603100/168923cbc1de7677430d84d81916da15aab48981/header.jpg?t=1743838787","is_free":false,"linux_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"mac_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"},"movies":[{"highlight":true,"id":257121500,"mp4":{"480":"http://video.akamai.steamstatic.com/store_trailers/257121500/movie480.mp4?t=1743838785","max":"http://video.akamai.steamstatic.com/store_trailers/257121500/movie_max.mp4?t=1743838785"},"name":"Lost Luminosity - Official Teaser Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257121500/8f2bf22c7c1bc407236251e2cd6a8f84ed8d0189/movie_600x337.jpg?t=1743838785","webm":{"480":"http://video.akamai.steamstatic.com/store_trailers/257121500/movie480_vp9.webm?t=1743838785","max":"http://video.akamai.steamstatic.com/store_trailers/257121500/movie_max_vp9.webm?t=1743838785"}}],"name":"Lost Luminosity","package_groups":[],"pc_requirements":{"minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10, 11 (64-BIT Required)<br></li><li><strong>Processor:</strong> Intel Core i5-4460 | AMD Ryzen 5 1400<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA\u00ae GeForce\u00ae GTX 1060 | AMD Radeon\u2122 RX 580<br></li><li><strong>Storage:</strong> 10 GB available space</li></ul>","recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires