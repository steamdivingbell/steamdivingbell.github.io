_assets/steam/apps/3549310/b0895c4d2d72fe44dba8ca86bc77d00f13ded170/ss_b0895c4d2d72fe44dba8ca86bc77d00f13ded170.600x338.jpg?t=1768399485"},{"id":1,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/5d92be7c4e60e3ff9053743191422da46f364307/ss_5d92be7c4e60e3ff9053743191422da46f364307.1920x1080.jpg?t=1768399485","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/5d92be7c4e60e3ff9053743191422da46f364307/ss_5d92be7c4e60e3ff9053743191422da46f364307.600x338.jpg?t=1768399485"},{"id":2,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/22a143afed6eed383c2ddde7307297e202407cb2/ss_22a143afed6eed383c2ddde7307297e202407cb2.1920x1080.jpg?t=1768399485","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/22a143afed6eed383c2ddde7307297e202407cb2/ss_22a143afed6eed383c2ddde7307297e202407cb2.600x338.jpg?t=1768399485"},{"id":3,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/65261838e49b80a22c9e34ec59e8f295a806ca3c/ss_65261838e49b80a22c9e34ec59e8f295a806ca3c.1920x1080.jpg?t=1768399485","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/65261838e49b80a22c9e34ec59e8f295a806ca3c/ss_65261838e49b80a22c9e34ec59e8f295a806ca3c.600x338.jpg?t=1768399485"},{"id":4,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/7badaf726a40360b5b642add6583a89a35a4b13d/ss_7badaf726a40360b5b642add6583a89a35a4b13d.1920x1080.jpg?t=1768399485","path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/7badaf726a40360b5b642add6583a89a35a4b13d/ss_7badaf726a40360b5b642add6583a89a35a4b13d.600x338.jpg?t=1768399485"},{"id":5,"path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3549310/0df326feeb3a38177f24851e865e899eec8c4f71/ss_0df326feeb3a38177f24851e865e899eec8c4f71.1920x1080.jpg?t=17683994